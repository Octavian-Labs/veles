# буфер — наращиваемый строковый буфер (строитель текстов, генератор .иск).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять память, стр

запись Буфер:
    данные *нат.старт
    длина нат.верх
    вмест нат.верх

функ буф_новый() *Буфер:
    б *Буфер = новый(Буфер)
    б.данные = выдели(256)
    б.длина = 0
    б.вмест = 256
    верни б

функ буф_место(б *Буфер, надо нат.верх):
    # гарантирует «надо» свободных байт, удваивая ёмкость
    если б.длина + надо <= б.вмест:
        верни
    нв := б.вмест * 2
    пока б.длина + надо > нв:
        нв = нв * 2
    новые *нат.старт = выдели(нв)
    скопируй(новые, б.данные, б.длина)
    освободи(б.данные)
    б.данные = новые
    б.вмест = нв

функ буф_сим(б *Буфер, с нат.старт):
    буф_место(б, 1)
    б.данные[б.длина] = с
    б.длина += 1

функ буф_добавь(б *Буфер, с стр):
    буф_место(б, с.длина)
    скопируй(б.данные + б.длина, с.данные, с.длина)
    б.длина += с.длина

функ буф_п16(б *Буфер, v нат.верх):
    # дописывает 2 байта little-endian
    буф_место(б, 2)
    б.данные[б.длина] = v как нат.старт
    б.данные[б.длина + 1] = (v >> 8) как нат.старт
    б.длина += 2

функ буф_п32(б *Буфер, v нат.верх):
    # дописывает 4 байта little-endian
    буф_место(б, 4)
    для i в 0..4:
        б.данные[б.длина + i] = (v >> (i * 8)) как нат.старт
    б.длина += 4

функ буф_п64(б *Буфер, v нат.верх):
    # дописывает 8 байт little-endian
    буф_место(б, 8)
    для i в 0..8:
        б.данные[б.длина + i] = (v >> (i * 8)) как нат.старт
    б.длина += 8

функ буф_нуль(б *Буфер, n нат.верх):
    # дописывает n нулевых байт
    буф_место(б, n)
    для i в 0..n:
        б.данные[б.длина + i] = 0
    б.длина += n

функ буф_уст32(б *Буфер, поз нат.верх, v нат.верх):
    # вписывает 4 байта little-endian в позицию (для RIP-патчей)
    для i в 0..4:
        б.данные[поз + i] = (v >> (i * 8)) как нат.старт

функ буф_стр(б *Буфер) стр:
    # отдаёт накопленное как стр (без копии — данные переходят строке);
    # буфер отсоединяется, буф_свободен после этого безопасен
    с := стр_собери(б.данные, б.длина)
    б.данные = пусто как *нат.старт
    б.длина = 0
    б.вмест = 0
    верни с

функ буф_свободен(б *Буфер):
    если б.данные != пусто:
        освободи(б.данные)
    освободи(б)
