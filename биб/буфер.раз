# буфер — наращиваемый строковый буфер (строитель текстов, генератор .иск).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять память, стр

открыто запись Буфер:
    данные *нат.старт
    длина размер
    вмест размер

открыто функ буф_новый() *Буфер:
    б *Буфер = новый(Буфер)
    б.данные = выдели(256)
    б.длина = 0
    б.вмест = 256
    верни б

открыто функ буф_место(б *Буфер, надо размер):
    # гарантирует «надо» свободных байт, удваивая ёмкость
    если б.длина + надо <= б.вмест:
        верни
    нв размер = б.вмест * 2
    пока б.длина + надо > нв:
        нв = нв * 2
    новые *нат.старт = выдели(нв)
    скопируй(новые, б.данные, б.длина)
    освободи(б.данные)
    б.данные = новые
    б.вмест = нв

открыто функ буф_сим(б *Буфер, с нат.старт):
    буф_место(б, 1)
    б.данные[б.длина] = с
    б.длина += 1

открыто функ буф_добавь(б *Буфер, с стр):
    буф_место(б, с.длина)
    скопируй(б.данные + б.длина, с.данные, с.длина)
    б.длина += с.длина

открыто функ буф_п16(б *Буфер, зн нат.верх):
    # дописывает 2 байта little-endian
    буф_место(б, 2)
    б.данные[б.длина] = зн как нат.старт
    б.данные[б.длина + 1] = (зн >> 8) как нат.старт
    б.длина += 2

открыто функ буф_п32(б *Буфер, зн нат.верх):
    # дописывает 4 байта little-endian
    буф_место(б, 4)
    для байт в 0..4:
        б.данные[б.длина + байт] = (зн >> (байт * 8)) как нат.старт
    б.длина += 4

открыто функ буф_п64(б *Буфер, зн нат.верх):
    # дописывает 8 байт little-endian
    буф_место(б, 8)
    для байт в 0..8:
        б.данные[б.длина + байт] = (зн >> (байт * 8)) как нат.старт
    б.длина += 8

открыто функ буф_нуль(б *Буфер, колво размер):
    # дописывает колво нулевых байт
    буф_место(б, колво)
    для байт в 0..колво:
        б.данные[б.длина + байт] = 0
    б.длина += колво

открыто функ буф_уст32(б *Буфер, поз размер, зн нат.верх):
    # вписывает 4 байта little-endian в позицию (для RIP-патчей)
    для байт в 0..4:
        б.данные[поз + байт] = (зн >> (байт * 8)) как нат.старт

открыто функ буф_стр(б *Буфер) стр:
    # отдаёт накопленное как стр (без копии — данные переходят строке);
    # буфер отсоединяется, буф_свободен после этого безопасен
    с стр = стр_собери(б.данные, б.длина)
    б.данные = пусто как *нат.старт
    б.длина = 0
    б.вмест = 0
    верни с

открыто функ буф_свободен(б *Буфер):
    если б.данные != пусто:
        освободи(б.данные)
    освободи(б)
