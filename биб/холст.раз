;развивается
# холст — программный буфер пикселей и примитивы рисования.
# Часть стандартной библиотеки ВЕЛЕС; работает на всех ОС без окон и GPU.
#
# Пиксель — нат.рост в формате 0xAARRGGBB (байты С,З,К,А в памяти
# little-endian — совместимо и с DIB, и с GL_BGRA). Координаты — цел.верх,
# отрицательные и выходящие за границы отсекаются.
# Верхний левый угол — (0,0), ось Y направлена вниз (растровый порядок).

взять память, стр, буфер, сист.файл

открыто конст ХОЛСТ_ЧЁРНЫЙ   = 0xFF000000
открыто конст ХОЛСТ_БЕЛЫЙ    = 0xFFFFFFFF
открыто конст ХОЛСТ_КРАСНЫЙ  = 0xFFFF0000
открыто конст ХОЛСТ_ЗЕЛЁНЫЙ  = 0xFF00FF00
открыто конст ХОЛСТ_СИНИЙ    = 0xFF0000FF
открыто конст ХОЛСТ_ЖЁЛТЫЙ   = 0xFFFFFF00
открыто конст ХОЛСТ_СЕРЫЙ    = 0xFF808080
открыто конст ХОЛСТ_ПУСТОЙ   = 0x00000000

открыто запись Холст:
    ширина размер
    высота размер
    пиксели *нат.рост        # ширина*высота значений 0xAARRGGBB

открыто функ цвет(кр нат.старт, зел нат.старт, син нат.старт) нат.рост:
    верни (0xFF000000 | ((кр как нат.рост) << 16) |
           ((зел как нат.рост) << 8) | (син как нат.рост))

открыто функ цвет_прозр(кр нат.старт, зел нат.старт, син нат.старт,
                        альфа нат.старт) нат.рост:
    верни (((альфа как нат.рост) << 24) | ((кр как нат.рост) << 16) |
           ((зел как нат.рост) << 8) | (син как нат.рост))

# «как нат.старт» меняет тип без усечения регистра — маска обязательна
открыто функ цвет_кр(ц нат.рост) нат.старт:
    верни ((ц >> 16) & 0xFF) как нат.старт

открыто функ цвет_зел(ц нат.рост) нат.старт:
    верни ((ц >> 8) & 0xFF) как нат.старт

открыто функ цвет_син(ц нат.рост) нат.старт:
    верни (ц & 0xFF) как нат.старт

открыто функ цвет_альфа(ц нат.рост) нат.старт:
    верни ((ц >> 24) & 0xFF) как нат.старт

открыто функ холст_новый(ширина размер, высота размер) *Холст:
    х *Холст = новый(Холст)
    х.ширина = ширина
    х.высота = высота
    х.пиксели = выдели(ширина * высота * 4) как *нат.рост
    холст_залей(х, ХОЛСТ_ЧЁРНЫЙ)
    верни х

открыто функ холст_свободен(х *Холст):
    освободи(х.пиксели)
    освободи(х)

открыто функ холст_залей(х *Холст, ц нат.рост):
    для инд в 0..х.ширина * х.высота:
        х.пиксели[инд] = ц

открыто функ холст_точка(х *Холст, пх цел.верх, пу цел.верх, ц нат.рост):
    если (пх < 0 или пу < 0 или пх >= (х.ширина как цел.верх)
            или пу >= (х.высота как цел.верх)):
        верни
    х.пиксели[(пу * (х.ширина как цел.верх) + пх) как размер] = ц

открыто функ холст_возьми(х *Холст, пх цел.верх, пу цел.верх) нат.рост:
    если (пх < 0 или пу < 0 или пх >= (х.ширина как цел.верх)
            или пу >= (х.высота как цел.верх)):
        верни ХОЛСТ_ПУСТОЙ
    верни х.пиксели[(пу * (х.ширина как цел.верх) + пх) как размер]

# Брезенхем: работает в любом направлении
открыто функ холст_линия(х *Холст, х0 цел.верх, у0 цел.верх,
                         х1 цел.верх, у1 цел.верх, ц нат.рост):
    дх цел.верх = х1 - х0
    если дх < 0:
        дх = -дх
    ду цел.верх = у1 - у0
    если ду < 0:
        ду = -ду
    шх цел.верх = 1
    если х0 > х1:
        шх = -1
    шу цел.верх = 1
    если у0 > у1:
        шу = -1
    ош цел.верх = дх - ду
    пока да:
        холст_точка(х, х0, у0, ц)
        если х0 == х1 и у0 == у1:
            хватит
        ош2 цел.верх = ош * 2
        если ош2 > -ду:
            ош -= ду
            х0 += шх
        если ош2 < дх:
            ош += дх
            у0 += шу

открыто функ холст_прямоуг(х *Холст, пх цел.верх, пу цел.верх,
                           шир цел.верх, выс цел.верх, ц нат.рост):
    холст_линия(х, пх, пу, пх + шир - 1, пу, ц)
    холст_линия(х, пх, пу + выс - 1, пх + шир - 1, пу + выс - 1, ц)
    холст_линия(х, пх, пу, пх, пу + выс - 1, ц)
    холст_линия(х, пх + шир - 1, пу, пх + шир - 1, пу + выс - 1, ц)

открыто функ холст_прямоуг_залей(х *Холст, пх цел.верх, пу цел.верх,
                                 шир цел.верх, выс цел.верх, ц нат.рост):
    для ду в 0..выс:
        для дх в 0..шир:
            холст_точка(х, пх + дх, пу + ду, ц)

# окружность средней точки — только контур
открыто функ холст_круг(х *Холст, цх цел.верх, цу цел.верх,
                        рад цел.верх, ц нат.рост):
    пх цел.верх = рад
    пу цел.верх = 0
    ош цел.верх = 1 - рад
    пока пх >= пу:
        холст_точка(х, цх + пх, цу + пу, ц)
        холст_точка(х, цх + пу, цу + пх, ц)
        холст_точка(х, цх - пу, цу + пх, ц)
        холст_точка(х, цх - пх, цу + пу, ц)
        холст_точка(х, цх - пх, цу - пу, ц)
        холст_точка(х, цх - пу, цу - пх, ц)
        холст_точка(х, цх + пу, цу - пх, ц)
        холст_точка(х, цх + пх, цу - пу, ц)
        пу += 1
        если ош < 0:
            ош += 2 * пу + 1
        иначе:
            пх -= 1
            ош += 2 * (пу - пх) + 1

открыто функ холст_круг_залей(х *Холст, цх цел.верх, цу цел.верх,
                              рад цел.верх, ц нат.рост):
    рад2 цел.верх = рад * рад
    сторона цел.верх = рад * 2 + 1
    для иу в 0..сторона:
        ду цел.верх = иу - рад
        для их в 0..сторона:
            дх цел.верх = их - рад
            если дх * дх + ду * ду <= рад2:
                холст_точка(х, цх + дх, цу + ду, ц)

# копирует видимую часть источника в позицию (пх,пу) приёмника
открыто функ холст_вставь(х *Холст, ист *Холст, пх цел.верх, пу цел.верх):
    для ряд в 0..(ист.высота как цел.верх):
        цель_у цел.верх = пу + ряд
        если цель_у < 0 или цель_у >= (х.высота как цел.верх):
            следующий
        для кол в 0..(ист.ширина как цел.верх):
            цель_х цел.верх = пх + кол
            если цель_х < 0 или цель_х >= (х.ширина как цел.верх):
                следующий
            х.пиксели[(цель_у * (х.ширина как цел.верх) + цель_х) как размер] = ист.пиксели[(ряд * (ист.ширина как цел.верх) + кол) как размер]

# --- экспорт ----------------------------------------------------------------

# P6 PPM (RGB, альфа отбрасывается) — для проверки без окон и обмена файлами
открыто функ холст_в_ppm(х *Холст) стр:
    б *Буфер = буф_новый()
    буф_добавь(б, стр_склей("P6 ", стр_склей(цел_в_стр(х.ширина как цел.верх),
        стр_склей(" ", стр_склей(цел_в_стр(х.высота как цел.верх),
        " 255\n")))))
    для инд в 0..х.ширина * х.высота:
        ц нат.рост = х.пиксели[инд]
        буф_сим(б, цвет_кр(ц))
        буф_сим(б, цвет_зел(ц))
        буф_сим(б, цвет_син(ц))
    верни буф_стр(б)

открыто функ холст_сохрани_ppm(х *Холст, путь стр) лог:
    верни файл_запиши(путь, холст_в_ppm(х))
