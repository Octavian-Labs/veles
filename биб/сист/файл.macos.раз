;стабильно
# файл — чтение и запись файлов (macOS: BSD syscalls 0x2000000+N).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.
# файл_прочти возвращает пусто при ошибке — проверяйте «если с == пусто».
# Ошибка syscall — флаг переноса (АКК = errno); нормализуем в -1.

взять стр

открыто функ файл_прочти(путь стр) стр:
    п *нат.старт = стр_в_нуль(путь)
    фд цел.верх = 0
    искра:
        ПЕР ПРМ, п          ; путь ASCIIZ
        ПЕР ИСТ, 0          ; O_RDONLY
        ПЕР ДАН, 0
        ПЕР АКК, 0x2000005  ; sys_open
        СИСВЫЗОВ
        НЕПЕРЕНОС м_файл_откр
        ПЕР АКК, -1
        м_файл_откр:
        ПЕР фд, АКК
    если фд < 0:
        верни пусто как стр
    разм смещение = 0
    искра:
        ПЕР ПРМ, фд
        ПЕР ИСТ, 0
        ПЕР ДАН, 2          ; SEEK_END
        ПЕР АКК, 0x20000C7  ; sys_lseek
        СИСВЫЗОВ
        НЕПЕРЕНОС м_файл_лсик
        ПЕР АКК, -1
        м_файл_лсик:
        ПЕР разм, АКК
    если разм <= 0:
        искра:
            ПЕР ПРМ, фд
            ПЕР АКК, 0x2000006  ; sys_close
            СИСВЫЗОВ
        верни пусто как стр
    буф *нат.старт = выдели(разм + 1)
    искра:
        ПЕР ПРМ, фд         ; перемотка в начало
        ПЕР ИСТ, 0
        ПЕР ДАН, 0          ; SEEK_SET
        ПЕР АКК, 0x20000C7
        СИСВЫЗОВ
        ПЕР ПРМ, фд
        ПЕР ИСТ, буф
        ПЕР ДАН, разм
        ПЕР АКК, 0x2000003  ; sys_read
        СИСВЫЗОВ
        ПЕР ПРМ, фд
        ПЕР АКК, 0x2000006  ; sys_close
        СИСВЫЗОВ
    буф[разм] = 0
    верни стр_собери(буф, разм как размер)

открыто функ файл_запиши(путь стр, данные стр) лог:
    п *нат.старт = стр_в_нуль(путь)
    фд цел.верх = 0
    искра:
        ПЕР ПРМ, п
        ПЕР ИСТ, 0x601      ; O_WRONLY|O_CREAT|O_TRUNC (macOS)
        ПЕР ДАН, 420        ; 0644
        ПЕР АКК, 0x2000005  ; sys_open
        СИСВЫЗОВ
        НЕПЕРЕНОС м_файл_зап_откр
        ПЕР АКК, -1
        м_файл_зап_откр:
        ПЕР фд, АКК
    если фд < 0:
        верни нет
    записано смещение = 0
    искра:
        ПЕР ПРМ, фд
        ПЕР ИСТ, данные     ; стр — указатель на пару
        ПЕР ИСТ, [ИСТ]      ; .данные
        ПЕР ДАН, данные
        ПЕР ДАН, [ДАН+8]    ; .длина
        ПЕР АКК, 0x2000004  ; sys_write
        СИСВЫЗОВ
        НЕПЕРЕНОС м_файл_зап_ок
        ПЕР АКК, -1
        м_файл_зап_ок:
        ПЕР записано, АКК
        ПЕР ПРМ, фд
        ПЕР АКК, 0x2000006  ; sys_close
        СИСВЫЗОВ
    верни записано == (данные.длина как смещение)
