# файл — чтение и запись файлов (Windows: WinAPI).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.
# файл_прочти возвращает пусто при ошибке — проверяйте «если с == пусто».

взять стр

внеш "kernel32" функ CreateFileW(имя *нат.шаг, доступ нат.рост,
                                 раздел нат.рост, сек *пусто,
                                 режим нат.рост, флаги нат.рост,
                                 шаблон нат.верх) нат.верх
внеш "kernel32" функ GetFileSize(хендл нат.верх, старш *нат.рост) нат.рост
внеш "kernel32" функ ReadFile(хендл нат.верх, буф *нат.старт, колво нат.рост,
                              прочитано *нат.рост, овер *пусто) цел.рост
внеш "kernel32" функ WriteFile(хендл нат.верх, буф *нат.старт, колво нат.рост,
                               записано *нат.рост, овер *пусто) цел.рост
внеш "kernel32" функ CloseHandle(хендл нат.верх) цел.рост
внеш "kernel32" функ MultiByteToWideChar(кодст нат.рост, флаги нат.рост,
                                         мнб *нат.старт, мнколво цел.рост,
                                         шир *нат.шаг, ширколво цел.рост) цел.рост

конст ЧИТАТЬ = 0x80000000      # GENERIC_READ
конст ПИСАТЬ = 0x40000000      # GENERIC_WRITE
конст ОТКРЫТЬ = 3              # OPEN_EXISTING
конст СОЗДАТЬ = 2              # CREATE_ALWAYS
конст НЕВЕРНЫЙ = 0xFFFFFFFFFFFFFFFF  # INVALID_HANDLE_VALUE

функ стр_в_шир(с стр) *нат.шаг:
    # UTF-8 -> UTF-16LE с нулём (для W-версий WinAPI: CreateFileW и др.)
    буф *нат.шаг = выдели((с.длина + 1) * 4) как *нат.шаг
    дл цел.рост = MultiByteToWideChar(65001, 0, с.данные, (с.длина как цел.рост),
                                      буф, (с.длина + 1) как цел.рост)
    буф[дл] = 0
    верни буф

функ файл_прочти(путь стр) стр:
    п *нат.шаг = стр_в_шир(путь)
    х нат.верх = CreateFileW(п, ЧИТАТЬ, 1, пусто, ОТКРЫТЬ, 0x80, пусто)
    если х == НЕВЕРНЫЙ:
        верни пусто как стр
    разм нат.рост = GetFileSize(х, пусто)
    буф *нат.старт = выдели((разм как нат.верх) + 1)
    прочитано нат.рост = 0
    ReadFile(х, буф, разм, &прочитано, пусто)
    CloseHandle(х)
    буф[разм] = 0
    верни стр_собери(буф, прочитано как нат.верх)

функ файл_запиши(путь стр, данные стр) лог:
    п *нат.шаг = стр_в_шир(путь)
    х нат.верх = CreateFileW(п, ПИСАТЬ, 0, пусто, СОЗДАТЬ, 0x80, пусто)
    если х == НЕВЕРНЫЙ:
        верни нет
    записано нат.рост = 0
    WriteFile(х, данные.данные, данные.длина как нат.рост, &записано, пусто)
    CloseHandle(х)
    верни записано == (данные.длина как нат.рост)
