# стр — операции со строками: {данные *нат.старт, длина нат.верх}.
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять память

# Служебная запись с разметкой, совпадающей с представлением стр.
запись _стрпара:
    данные *нат.старт
    длина нат.верх

функ стр_собери(байты *нат.старт, длина нат.верх) стр:
    пара *_стрпара = новый(_стрпара)
    пара.данные = байты
    пара.длина = длина
    верни пара как стр

функ стр_равны(первая стр, вторая стр) лог:
    если первая.длина != вторая.длина:
        верни нет
    верни равна_память(первая.данные, вторая.данные, первая.длина)

функ стр_начинается(строка стр, префикс стр) лог:
    # истина, если строка начинается с префикса (сравнение по байтам UTF-8)
    если строка.длина < префикс.длина:
        верни нет
    верни равна_память(строка.данные, префикс.данные, префикс.длина)

функ _ниж1(байт нат.старт) нат.старт:
    # одиночный ASCII-байт в нижний регистр
    если байт >= 'A' и байт <= 'Z':
        верни байт + 32
    верни байт

функ _ниж2(байт1 нат.старт, байт2 нат.старт, байты *нат.старт):
    # двухбайтовая кириллица UTF-8 в нижний регистр
    если байт1 == 0xD0 и байт2 == 0x81:
        байты[0] = 0xD1
        байты[1] = 0x91
        верни
    если байт1 == 0xD0 и байт2 >= 0x90 и байт2 <= 0x9F:
        байты[0] = байт1
        байты[1] = байт2 + 0x20
        верни
    если байт1 == 0xD0 и байт2 >= 0xA0 и байт2 <= 0xAF:
        байты[0] = 0xD1
        байты[1] = байт2 - 0x20
        верни
    байты[0] = байт1
    байты[1] = байт2

функ стр_равны_нр(первая стр, вторая стр) лог:
    # регистронезависимое сравнение (ASCII + кириллица UTF-8)
    если первая.длина != вторая.длина:
        верни нет
    врем *нат.старт = выдели(2)
    поз нат.верх = 0
    пока поз < первая.длина:
        байт1 нат.старт = первая.данные[поз]
        байт2 нат.старт = вторая.данные[поз]
        если байт1 >= 0x80 и байт2 >= 0x80 и поз + 1 < первая.длина:
            _ниж2(байт1, первая.данные[поз + 1], врем)
            ниж1_б нат.старт = врем[0]
            ниж2_б нат.старт = врем[1]
            _ниж2(байт2, вторая.данные[поз + 1], врем)
            если ниж1_б != врем[0] или ниж2_б != врем[1]:
                освободи(врем)
                верни нет
            поз += 2
        иначе:
            если _ниж1(байт1) != _ниж1(байт2):
                освободи(врем)
                верни нет
            поз += 1
    освободи(врем)
    верни да

функ стр_вниз(строка стр) стр:
    # нижний регистр: ASCII A-Z и кириллица А-Я/Ё (UTF-8, 2 байта)
    байты *нат.старт = выдели(строка.длина)
    поз нат.верх = 0
    пока поз < строка.длина:
        байт нат.старт = строка.данные[поз]
        если байт >= 'A' и байт <= 'Z':
            байты[поз] = байт + 32
            поз += 1
        а если байт == 0xD0 и поз + 1 < строка.длина:
            байт2 нат.старт = строка.данные[поз + 1]
            если байт2 == 0x81:
                # Ё -> ё
                байты[поз] = 0xD1
                байты[поз + 1] = 0x91
            а если байт2 >= 0x90 и байт2 <= 0x9F:
                # А-П -> а-п
                байты[поз] = байт
                байты[поз + 1] = байт2 + 0x20
            а если байт2 >= 0xA0 и байт2 <= 0xAF:
                # Р-Я -> р-я
                байты[поз] = 0xD1
                байты[поз + 1] = байт2 - 0x20
            иначе:
                байты[поз] = байт
                байты[поз + 1] = байт2
            поз += 2
        иначе:
            байты[поз] = байт
            поз += 1
    верни стр_собери(байты, строка.длина)

функ стр_срез(строка стр, от нат.верх, по нат.верх) стр:
    # полуоткрытый диапазон [с_ч, по); данные разделяются с исходной строкой
    верни стр_собери(строка.данные + от, по - от)

функ стр_склей(первая стр, вторая стр) стр:
    буф *нат.старт = выдели(первая.длина + вторая.длина)
    скопируй(буф, первая.данные, первая.длина)
    скопируй(буф + первая.длина, вторая.данные, вторая.длина)
    верни стр_собери(буф, первая.длина + вторая.длина)

функ цел_в_стр(число цел.верх) стр:
    # десятичное представление; буфер 24 байта хватает на цел.верх со знаком
    буф *нат.старт = выдели(24)
    поз цел.верх = 24
    минус лог = нет
    если число < 0:
        минус = да
        число = -число
    если число == 0:
        поз = поз - 1
        буф[поз] = 48
    пока число > 0:
        поз = поз - 1
        буф[поз] = (48 + число % 10) как нат.старт
        число = число / 10
    если минус:
        поз = поз - 1
        буф[поз] = 45
    верни стр_собери(буф + поз, (24 - поз) как нат.верх)

функ без_в_стр(число нат.верх) стр:
    # десятичное представление беззнакового нат.верх (до 20 цифр)
    буф *нат.старт = выдели(24)
    поз цел.верх = 24
    если число == 0:
        поз = поз - 1
        буф[поз] = 48
    пока число > 0:
        поз = поз - 1
        буф[поз] = (48 + число % 10) как нат.старт
        число = число / 10
    верни стр_собери(буф + поз, (24 - поз) как нат.верх)

функ утф8_код(байты *нат.старт, длина нат.верх) цел.верх:
    # декодирует один кодпоинт UTF-8 (1..4 байта); -1 при неверной форме
    если длина == 0 или длина > 4:
        верни -1
    байт0 нат.верх = байты[0] как нат.верх
    если длина == 1:
        если байт0 >= 0x80:
            верни -1
        верни байт0 как цел.верх
    если длина == 2:
        если байт0 < 0xC0 или байт0 >= 0xE0:
            верни -1
        верни (((байт0 & 0x1F) << 6) | ((байты[1] как нат.верх) & 0x3F)) как цел.верх
    если длина == 3:
        если байт0 < 0xE0 или байт0 >= 0xF0:
            верни -1
        верни (((байт0 & 0x0F) << 12) | (((байты[1] как нат.верх) & 0x3F) << 6) |
               ((байты[2] как нат.верх) & 0x3F)) как цел.верх
    если байт0 < 0xF0:
        верни -1
    верни (((байт0 & 0x07) << 18) | (((байты[1] как нат.верх) & 0x3F) << 12) |
           (((байты[2] как нат.верх) & 0x3F) << 6) | ((байты[3] как нат.верх) & 0x3F)) как цел.верх

функ стр_в_нуль(строка стр) *нат.старт:
    # копия строки с завершающим нулём — для вызовов WinAPI (ASCIIZ)
    буф *нат.старт = выдели(строка.длина + 1)
    скопируй(буф, строка.данные, строка.длина)
    буф[строка.длина] = 0
    верни буф

функ стр_найди(строка стр, под стр) цел.верх:
    # индекс первого вхождения или -1
    если под.длина == 0:
        верни 0
    если под.длина > строка.длина:
        верни -1
    поз нат.верх = 0
    пока поз <= строка.длина - под.длина:
        если равна_память(строка.данные + поз, под.данные, под.длина):
            верни поз как цел.верх
        поз += 1
    верни -1

функ стр_число(строка стр) цел.верх:
    # разбор десятичного числа (atoi)
    поз нат.верх = 0
    минус лог = нет
    если строка.длина > 0 и строка.данные[0] == 45:
        минус = да
        поз = 1
    число цел.верх = 0
    пока поз < строка.длина:
        байт нат.старт = строка.данные[поз]
        если байт < 48 или байт > 57:
            хватит
        число = число * 10 + (байт - 48)
        поз += 1
    если минус:
        верни -число
    верни число

# --- предикаты символов (байты; UTF-8 ведущие байты >= 128) -------------------

функ это_цифра(байт нат.старт) лог:
    верни байт >= 48 и байт <= 57

функ это_пробел(байт нат.старт) лог:
    верни байт == 32 или байт == 9 или байт == 10 или байт == 13

функ это_буква(байт нат.старт) лог:
    # латиница + любой байт >= 128 (кириллица в UTF-8)
    верни (байт >= 65 и байт <= 90) или (байт >= 97 и байт <= 122) или байт >= 128

