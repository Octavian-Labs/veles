# стр — операции со строками: {данные *нат.старт, длина нат.верх}.
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять память

# Служебная запись с разметкой, совпадающей с представлением стр.
запись _стрпара:
    данные *нат.старт
    длина нат.верх

функ стр_собери(д *нат.старт, дл нат.верх) стр:
    п *_стрпара = новый(_стрпара)
    п.данные = д
    п.длина = дл
    верни п как стр

функ стр_равны(а стр, б стр) лог:
    если а.длина != б.длина:
        верни нет
    верни равна_память(а.данные, б.данные, а.длина)

функ стр_начинается(с стр, преф стр) лог:
    # истина, если строка начинается с префикса (сравнение по байтам UTF-8)
    если с.длина < преф.длина:
        верни нет
    верни равна_память(с.данные, преф.данные, преф.длина)

функ _ниж1(б нат.старт) нат.старт:
    # одиночный ASCII-байт в нижний регистр
    если б >= 'A' и б <= 'Z':
        верни б + 32
    верни б

функ _ниж2(б1 нат.старт, б2 нат.старт, д *нат.старт):
    # двухбайтовая кириллица UTF-8 в нижний регистр
    если б1 == 0xD0 и б2 == 0x81:
        д[0] = 0xD1
        д[1] = 0x91
        верни
    если б1 == 0xD0 и б2 >= 0x90 и б2 <= 0x9F:
        д[0] = б1
        д[1] = б2 + 0x20
        верни
    если б1 == 0xD0 и б2 >= 0xA0 и б2 <= 0xAF:
        д[0] = 0xD1
        д[1] = б2 - 0x20
        верни
    д[0] = б1
    д[1] = б2

функ стр_равны_нр(а стр, б стр) лог:
    # регистронезависимое сравнение (ASCII + кириллица UTF-8)
    если а.длина != б.длина:
        верни нет
    tmp *нат.старт = выдели(2)
    поз нат.верх = 0
    пока поз < а.длина:
        б1 нат.старт = а.данные[поз]
        б2 нат.старт = б.данные[поз]
        если б1 >= 0x80 и б2 >= 0x80 и поз + 1 < а.длина:
            _ниж2(б1, а.данные[поз + 1], tmp)
            в1 нат.старт = tmp[0]
            в1б нат.старт = tmp[1]
            _ниж2(б2, б.данные[поз + 1], tmp)
            если в1 != tmp[0] или в1б != tmp[1]:
                освободи(tmp)
                верни нет
            поз += 2
        иначе:
            если _ниж1(б1) != _ниж1(б2):
                освободи(tmp)
                верни нет
            поз += 1
    освободи(tmp)
    верни да

функ стр_вниз(с стр) стр:
    # нижний регистр: ASCII A-Z и кириллица А-Я/Ё (UTF-8, 2 байта)
    д *нат.старт = выдели(с.длина)
    поз нат.верх = 0
    пока поз < с.длина:
        б нат.старт = с.данные[поз]
        если б >= 'A' и б <= 'Z':
            д[поз] = б + 32
            поз += 1
        а если б == 0xD0 и поз + 1 < с.длина:
            б2 нат.старт = с.данные[поз + 1]
            если б2 == 0x81:
                # Ё -> ё
                д[поз] = 0xD1
                д[поз + 1] = 0x91
            а если б2 >= 0x90 и б2 <= 0x9F:
                # А-П -> а-п
                д[поз] = б
                д[поз + 1] = б2 + 0x20
            а если б2 >= 0xA0 и б2 <= 0xAF:
                # Р-Я -> р-я
                д[поз] = 0xD1
                д[поз + 1] = б2 - 0x20
            иначе:
                д[поз] = б
                д[поз + 1] = б2
            поз += 2
        иначе:
            д[поз] = б
            поз += 1
    верни стр_собери(д, с.длина)

функ стр_срез(с стр, с_ч нат.верх, по нат.верх) стр:
    # полуоткрытый диапазон [с_ч, по); данные разделяются с исходной строкой
    верни стр_собери(с.данные + с_ч, по - с_ч)

функ стр_склей(а стр, б стр) стр:
    буф *нат.старт = выдели(а.длина + б.длина)
    скопируй(буф, а.данные, а.длина)
    скопируй(буф + а.длина, б.данные, б.длина)
    верни стр_собери(буф, а.длина + б.длина)

функ цел_в_стр(ч цел.верх) стр:
    # десятичное представление; буфер 24 байта хватает на цел.верх со знаком
    буф *нат.старт = выдели(24)
    поз цел.верх = 24
    минус лог = нет
    если ч < 0:
        минус = да
        ч = -ч
    если ч == 0:
        поз = поз - 1
        буф[поз] = 48
    пока ч > 0:
        поз = поз - 1
        буф[поз] = (48 + ч % 10) как нат.старт
        ч = ч / 10
    если минус:
        поз = поз - 1
        буф[поз] = 45
    верни стр_собери(буф + поз, (24 - поз) как нат.верх)

функ без_в_стр(ч нат.верх) стр:
    # десятичное представление беззнакового нат.верх (до 20 цифр)
    буф *нат.старт = выдели(24)
    поз цел.верх = 24
    если ч == 0:
        поз = поз - 1
        буф[поз] = 48
    пока ч > 0:
        поз = поз - 1
        буф[поз] = (48 + ч % 10) как нат.старт
        ч = ч / 10
    верни стр_собери(буф + поз, (24 - поз) как нат.верх)

функ утф8_код(д *нат.старт, дл нат.верх) цел.верх:
    # декодирует один кодпоинт UTF-8 (1..4 байта); -1 при неверной форме
    если дл == 0 или дл > 4:
        верни -1
    б0 нат.верх = д[0] как нат.верх
    если дл == 1:
        если б0 >= 0x80:
            верни -1
        верни б0 как цел.верх
    если дл == 2:
        если б0 < 0xC0 или б0 >= 0xE0:
            верни -1
        верни (((б0 & 0x1F) << 6) | ((д[1] как нат.верх) & 0x3F)) как цел.верх
    если дл == 3:
        если б0 < 0xE0 или б0 >= 0xF0:
            верни -1
        верни (((б0 & 0x0F) << 12) | (((д[1] как нат.верх) & 0x3F) << 6) |
               ((д[2] как нат.верх) & 0x3F)) как цел.верх
    если б0 < 0xF0:
        верни -1
    верни (((б0 & 0x07) << 18) | (((д[1] как нат.верх) & 0x3F) << 12) |
           (((д[2] как нат.верх) & 0x3F) << 6) | ((д[3] как нат.верх) & 0x3F)) как цел.верх

функ стр_в_нуль(с стр) *нат.старт:
    # копия строки с завершающим нулём — для вызовов WinAPI (ASCIIZ)
    буф *нат.старт = выдели(с.длина + 1)
    скопируй(буф, с.данные, с.длина)
    буф[с.длина] = 0
    верни буф

функ стр_найди(с стр, под стр) цел.верх:
    # индекс первого вхождения или -1
    если под.длина == 0:
        верни 0
    если под.длина > с.длина:
        верни -1
    поз нат.верх = 0
    пока поз <= с.длина - под.длина:
        если равна_память(с.данные + поз, под.данные, под.длина):
            верни поз как цел.верх
        поз += 1
    верни -1

функ стр_число(с стр) цел.верх:
    # разбор десятичного числа (atoi)
    поз нат.верх = 0
    минус лог = нет
    если с.длина > 0 и с.данные[0] == 45:
        минус = да
        поз = 1
    ч цел.верх = 0
    пока поз < с.длина:
        б нат.старт = с.данные[поз]
        если б < 48 или б > 57:
            хватит
        ч = ч * 10 + (б - 48)
        поз += 1
    если минус:
        верни -ч
    верни ч

# --- предикаты символов (байты; UTF-8 ведущие байты >= 128) -------------------

функ это_цифра(б нат.старт) лог:
    верни б >= 48 и б <= 57

функ это_пробел(б нат.старт) лог:
    верни б == 32 или б == 9 или б == 10 или б == 13

функ это_буква(б нат.старт) лог:
    # латиница + любой байт >= 128 (кириллица в UTF-8)
    верни (б >= 65 и б <= 90) или (б >= 97 и б <= 122) или б >= 128

