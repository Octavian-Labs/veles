;развивается
# окл — заглушка для Linux: OpenCL требует libOpenCL (динамическая
# библиотека), а эмиттер ELF пока поддерживает только системные вызовы
# без ИМПОРТов. API совпадает с окл.windows — окл_начни сообщает
# и возвращает пусто.

взять стр, память, консоль

открыто конст ОКЛ_УСТР_ПРОЦ   = 2
открыто конст ОКЛ_УСТР_ГПУ   = 4
открыто конст ОКЛ_УСТР_ЛЮБОЕ = 0xFFFFFFFF
открыто конст ОКЛ_ЧТ_ЗП      = 1
открыто конст ОКЛ_ЗП         = 2
открыто конст ОКЛ_ЧТ         = 4
открыто конст ОКЛ_КОПИРУЙ    = 0x20
открыто конст ОКЛ_ИМЯ_ПЛАТ   = 0x0902
открыто конст ОКЛ_ИМЯ_УСТР   = 0x102B
открыто конст ОКЛ_ЖУРНАЛ     = 0x1183

открыто запись Окл:
    платформа нат.верх
    устройство нат.верх
    контекст нат.верх
    очередь нат.верх

открыто функ окл_начни() *Окл:
    печать_ош("окл: цель linux пока не поддерживается (нет ИМПОРТов в ELF)\n")
    верни пусто

открыто функ окл_конец(ок *Окл):
    если ок != пусто:
        освободи(ок)

открыто функ окл_имя_платформы(ок *Окл) стр:
    верни ""

открыто функ окл_имя_устройства(ок *Окл) стр:
    верни ""

открыто функ окл_буфер(ок *Окл, флаги нат.верх, байты размер) нат.верх:
    верни 0

открыто функ окл_запиши(ок *Окл, буф нат.верх, данные *нат.старт,
                        байты размер) лог:
    верни нет

открыто функ окл_прочти(ок *Окл, буф нат.верх, данные *нат.старт,
                        байты размер) лог:
    верни нет

открыто функ окл_освободи_буфер(буф нат.верх):
    верни

открыто функ окл_программа(ок *Окл, исходник стр) нат.верх:
    верни 0

открыто функ окл_ядро(прог нат.верх, имя стр) нат.верх:
    верни 0

открыто функ окл_освободи_прог(прог нат.верх):
    верни

открыто функ окл_освободи_ядро(ядро нат.верх):
    верни

открыто функ окл_арг_буй(ядро нат.верх, инд нат.рост, буф нат.верх) лог:
