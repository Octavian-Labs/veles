# система — завершение процесса и доступ к ОС (Linux).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять файл, буфер

открыто функ выход(код цел.верх):
    искра:
        ПЕР ПРМ, код        ; код выхода
        ПЕР АКК, 60         ; sys_exit
        СИСВЫЗОВ

# Командная строка процесса (аргументы разделены NUL).
# /proc — виртуальная ФС: lseek/размер не работают, читаем до EOF.
# Возвращает пусто при ошибке открытия.
открыто функ аргументы() стр:
    путь *нат.старт = стр_в_нуль("/proc/self/cmdline")
    фд цел.верх = 0
    искра:
        ПЕР ПРМ, путь          ; путь ASCIIZ
        ПЕР ИСТ, 0          ; O_RDONLY
        ПЕР ДАН, 0
        ПЕР АКК, 2          ; sys_open
        СИСВЫЗОВ
        ПЕР фд, АКК
    если фд < 0:
        верни пусто как стр
    буф *Буфер = буф_новый()
    кусок *нат.старт = выдели(4096)
    прочитано смещение = 1
    пока прочитано > 0:
        искра:
            ПЕР ПРМ, фд
            ПЕР ИСТ, кусок
            ПЕР ДАН, 4096
            ПЕР АКК, 0      ; sys_read
            СИСВЫЗОВ
            ПЕР прочитано, АКК
        если прочитано > 0:
            буф_место(буф, прочитано как размер)
            скопируй(буф.данные + буф.длина, кусок, прочитано как размер)
            буф.длина += прочитано как размер
    освободи(кусок)
    искра:
        ПЕР ПРМ, фд
        ПЕР АКК, 3          ; sys_close
        СИСВЫЗОВ
    # /proc/self/cmdline отдаёт argv через NUL — приводим к строке
    # с пробелами, как GetCommandLineW на Windows
    поз размер = 0
    пока поз < буф.длина:
        если буф.данные[поз] == 0:
            буф.данные[поз] = ' '
        поз += 1
    верни буф_стр(буф)
