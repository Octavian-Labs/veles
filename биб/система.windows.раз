# система — завершение процесса и доступ к ОС (Windows).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять стр

внеш "kernel32" функ ExitProcess(код нат.рост)
внеш "kernel32" функ GetCommandLineW() *нат.шаг
внеш "kernel32" функ WideCharToMultiByte(кодст нат.рост, флаги нат.рост,
    шир *нат.шаг, шир_дл цел.рост, узк *нат.старт, узк_дл цел.рост,
    умолч *нат.старт, исп *нат.рост) цел.рост

функ выход(код цел.верх):
    ExitProcess(код как нат.рост)

# Командная строка процесса целиком в UTF-8.
функ аргументы() стр:
    шир *нат.шаг = GetCommandLineW()
    длин цел.рост = WideCharToMultiByte(65001, 0, шир, -1, пусто, 0, пусто, пусто)
    буф *нат.старт = выдели(длин как размер) как *нат.старт
    WideCharToMultiByte(65001, 0, шир, -1, буф, длин, пусто, пусто)
    верни стр_собери(буф, (длин - 1) как размер)
