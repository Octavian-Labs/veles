# --- строки и расширения -------------------------------------------------------

# стр → нуль-терминированная копия (для wglGetProcAddress и строк API)
функ _стр_в_с(с стр) *нат.старт:
    указ *нат.старт = выдели(с.длина + 1)
    скопируй(указ, с.данные, с.длина)
    указ[с.длина] = 0
    верни указ

# длина нуль-терминированной строки
функ _с_длина(указ *нат.старт) размер:
    дл размер = 0
    пока указ[дл] != 0:
        дл += 1
    верни дл

# адрес функции OpenGL по имени (wglGetProcAddress); 0 — функции нет.
# Приведение к конкретному типу: ф = гл_функ("glGenBuffers") как функ(...)
открыто функ гл_функ(имя стр) нат.верх:
    имя_с *нат.старт = _стр_в_с(имя)
    ад нат.верх = wglGetProcAddress(имя_с)
    освободи(имя_с)
    верни ад

открыто функ гл_строка(имя нат.рост) стр:
    указ *нат.старт = glGetString(имя)
    если указ == пусто:
        верни ""
    верни стр_собери(указ, _с_длина(указ))

открыто функ гл_версия() стр:
    верни гл_строка(ГЛ_ВЕРСИЯ)

открыто функ гл_произв() стр:
