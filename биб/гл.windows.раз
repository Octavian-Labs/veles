# создаёт GL-контекст в уже созданном окне; пусто — не удалось
открыто функ гл_начни(о *Окно) *Гл:
    пфд *нат.старт = выдели(40)           # PIXELFORMATDESCRIPTOR
    заполни(пфд, 0, 40)
    пфд16 *нат.шаг = пфд как *нат.шаг
    пфд16[0] = 40                         # nSize
    пфд16[1] = 1                          # nVersion
    пфд32 *нат.рост = пфд как *нат.рост
    пфд32[1] = 0x00000025                 # DRAW_TO_WINDOW|OPENGL|DOUBLEBUFFER
    пфд[9] = 32                           # cColorBits
    пфд[23] = 24                          # cDepthBits
    фмт цел.рост = ChoosePixelFormat(о.дц, пфд)
    если фмт == 0:
        освободи(пфд)
        верни пусто
    если SetPixelFormat(о.дц, фмт, пфд) == 0:
        освободи(пфд)
        верни пусто
    освободи(пфд)
    ктх нат.верх = wglCreateContext(о.дц)
    если ктх == 0:
        верни пусто
    если wglMakeCurrent(о.дц, ктх) == 0:
        wglDeleteContext(ктх)
        верни пусто
    г *Гл = новый(Гл)
    г.окно = о
    г.ктх = ктх
    верни г

открыто функ гл_конец(г *Гл):
    wglMakeCurrent(пусто, пусто)
    wglDeleteContext(г.ктх)
    освободи(г)

