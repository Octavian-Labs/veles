# выводит холст в буфер кадра GPU (glDrawPixels, формат BGRA совпадает)
открыто функ гл_покажи(г *Гл, х *Холст):
    гл_матрица(ГЛ_ПРОЕКЦИЯ)
    гл_единица()
    гл_орто_экран(г.окно.ширина как цел.рост, г.окно.высота как цел.рост)
    гл_матрица(ГЛ_МОДЕЛЬ)
    гл_единица()
    glPixelZoom(1.0, -1.0)                # ряды холста идут сверху вниз
    glRasterPos2i(0, 0)
    glDrawPixels(х.ширина как цел.рост, х.высота как цел.рост,
        ГЛ_БГРА, ГЛ_БАЙТ, х.пиксели)
    glPixelZoom(1.0, 1.0)
    гл_обмен(г)
