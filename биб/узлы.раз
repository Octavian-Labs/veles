открыто функ узел(вид нат.верх, строка размер) *Узел:
    у *Узел = новый(Узел)
    у.вид = вид
    у.текст = пусто как стр
    у.текст2 = пусто как стр
    у.знач = 0
    у.знач2 = 0
    у.а = пусто как *Узел
    у.б = пусто как *Узел
    у.в = пусто как *Узел
    у.г = пусто как *Узел
    у.дети = пусто как *Список
    у.дети2 = пусто как *Список
    у.строка = строка
    у.столб = 0
    у.мод = пусто как стр
    у.отк = 0
    верни у

