запись Узел:
    вид нат.верх
    текст стр
    текст2 стр
    знач нат.верх
    знач2 нат.верх
    а *Узел
    б *Узел
    в *Узел
    г *Узел
    дети *Список
    дети2 *Список
    строка нат.верх
    столб нат.верх         # позиция в строке (0 = неизвестно)

функ узел(вид нат.верх, строка нат.верх) *Узел:
    у *Узел = новый(Узел)
    у.вид = вид
    у.текст = пусто как стр
    у.текст2 = пусто как стр
    у.знач = 0
    у.знач2 = 0
    у.а = пусто как *Узел
    у.б = пусто как *Узел
    у.в = пусто как *Узел
    у.г = пусто как *Узел
    у.дети = пусто как *Список
    у.дети2 = пусто как *Список
    у.строка = строка
    у.столб = 0
    верни у

функ у_имя(текст стр, строка нат.верх) *Узел:
    у *Узел = узел(У_ИМЯ, строка)
    у.текст = текст
    верни у

функ у_бин(оп стр, а *Узел, б *Узел, строка нат.верх) *Узел:
    у *Узел = узел(У_БИН, строка)
    у.текст = оп
    у.а = а
    у.б = б
    верни у

функ у_добавь(у *Узел, д *Узел):
    если у.дети == пусто:
        у.дети = список_новый()
    список_добавь(у.дети, д как нат.верх)

функ у_добавь2(у *Узел, д *Узел):
    если у.дети2 == пусто:
        у.дети2 = список_новый()
    список_добавь(у.дети2, д как нат.верх)
