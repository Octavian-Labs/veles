# процесс — запуск дочерних процессов с перенаправлением потоков (Windows).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.
# запусти ждёт завершения и возвращает код выхода (-1 — не запустился).

взять стр, память, файл

внеш "kernel32" функ CreateProcessW(прил *нат.шаг, кстр *нат.шаг,
    па *пусто, та *пусто, наслед цел.рост, флаги нат.рост,
    среда *пусто, кат *нат.шаг, си *нат.старт, пи *нат.старт) цел.рост
внеш "kernel32" функ WaitForSingleObject(хендл нат.верх, мс нат.рост) нат.рост
внеш "kernel32" функ GetExitCodeProcess(проц нат.верх, код *нат.рост) цел.рост
внеш "kernel32" функ DeleteFileW(имя *нат.шаг) цел.рост
внеш "kernel32" функ CloseHandle(хендл нат.верх) цел.рост
внеш "kernel32" функ GetStdHandle(деск нат.рост) нат.верх

конст ЖДИ_ВЕЧНО = 0xFFFFFFFF    # INFINITE
конст СТД_ФЛАГ = 0x100          # STARTF_USESTDHANDLES
конст ЧИТАТЬ = 0x80000000       # GENERIC_READ
конст ПИСАТЬ = 0x40000000       # GENERIC_WRITE
конст ОТКРЫТЬ = 3               # OPEN_EXISTING
конст СОЗДАТЬ = 2               # CREATE_ALWAYS
конст НЕВЕРНЫЙ = 0xFFFFFFFFFFFFFFFF  # INVALID_HANDLE_VALUE

