# процесс — запуск дочерних процессов с перенаправлением потоков (Windows).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.
# запусти ждёт завершения и возвращает код выхода (-1 — не запустился).

взять стр, память, файл

открыто внеш "kernel32" функ CreateProcessW(прил *нат.шаг, кстр *нат.шаг,
    па *пусто, та *пусто, наслед цел.рост, флаги нат.рост,
    среда *пусто, кат *нат.шаг, си *нат.старт, пи *нат.старт) цел.рост
открыто внеш "kernel32" функ WaitForSingleObject(хендл нат.верх, мс нат.рост) нат.рост
открыто внеш "kernel32" функ GetExitCodeProcess(проц нат.верх, код *нат.рост) цел.рост
открыто внеш "kernel32" функ DeleteFileW(имя *нат.шаг) цел.рост
открыто внеш "kernel32" функ CloseHandle(хендл нат.верх) цел.рост
открыто внеш "kernel32" функ GetStdHandle(деск нат.рост) нат.верх

открыто конст ЖДИ_ВЕЧНО = 0xFFFFFFFF    # INFINITE
открыто конст СТД_ФЛАГ = 0x100          # STARTF_USESTDHANDLES
открыто конст ЧИТАТЬ = 0x80000000       # GENERIC_READ
открыто конст ПИСАТЬ = 0x40000000       # GENERIC_WRITE
открыто конст ОТКРЫТЬ = 3               # OPEN_EXISTING
открыто конст СОЗДАТЬ = 2               # CREATE_ALWAYS
открыто конст НЕВЕРНЫЙ = 0xFFFFFFFFFFFFFFFF  # INVALID_HANDLE_VALUE

