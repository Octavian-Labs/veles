# --- файлы и процессы ---------------------------------------------------------

функ файл_удали(путь стр) лог:
    верни DeleteFileW(стр_в_шир(путь)) != 0

# наследуемый дочерним процессом файловый хендл
функ _наслед_файл(путь стр, доступ нат.рост, режим нат.рост) нат.верх:
    са *нат.верх = выдели(24) как *нат.верх
    са[0] = 24                  # SECURITY_ATTRIBUTES.nLength
    са[1] = 0                   # lpSecurityDescriptor
    са32 *нат.рост = са как *нат.рост
    са32[4] = 1                 # bInheritHandle
    верни CreateFileW(стр_в_шир(путь), доступ, 3, са как *пусто,
                      режим, 0x80, пусто)

# запускает «прог арг» со stdin=вход, stdout=вых (пути к файлам),
# stderr наследуется от родителя — предупреждения не портят вывод;
# ждёт завершения, возвращает код выхода или -1 при ошибке запуска
функ запусти(прог стр, арг стр, вход стр, вых стр) цел.верх:
    вх := _наслед_файл(вход, ЧИТАТЬ, ОТКРЫТЬ)
    выхф := _наслед_файл(вых, ПИСАТЬ, СОЗДАТЬ)
    если вх == НЕВЕРНЫЙ или выхф == НЕВЕРНЫЙ:
        верни -1
    си *нат.старт = выдели(104)      # STARTUPINFOW
    заполни(си, 0, 104)
    си32 *нат.рост = си как *нат.рост
    си32[0] = 104               # cb
    си32[15] = СТД_ФЛАГ         # dwFlags @60
    си64 *нат.верх = си как *нат.верх
    си64[10] = вх               # hStdInput @80
    си64[11] = выхф             # hStdOutput @88
    си64[12] = GetStdHandle(0xFFFFFFF4)   # hStdError @96 — stderr родителя
    пи *нат.старт = выдели(24)       # PROCESS_INFORMATION
    заполни(пи, 0, 24)
    кстр := стр_в_шир(стр_склей("\"",
        стр_склей(прог, стр_склей("\" ", арг))))
    ок := CreateProcessW(пусто, кстр, пусто, пусто, 1, 0,
                         пусто, пусто, си, пи)
    если ок == 0:
        CloseHandle(вх)
        CloseHandle(выхф)
        верни -1
    пи64 *нат.верх = пи как *нат.верх
    WaitForSingleObject(пи64[0], ЖДИ_ВЕЧНО)
    код нат.рост = 0
    GetExitCodeProcess(пи64[0], &код)
    CloseHandle(пи64[0])
    CloseHandle(пи64[1])
    CloseHandle(вх)
    CloseHandle(выхф)
    верни код как цел.верх
