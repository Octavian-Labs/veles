# процесс — запуск дочерних процессов с перенаправлением потоков (Linux).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.
# fork + dup2 + execve + wait4 через СИСВЫЗОВ; код выхода или -1.

взять стр, память

# --- пути toolchain и платформенные мелочи -----------------------------------

открыто функ путь_разум() стр:
    верни "./raz/разум"

открыто функ путь_искра() стр:
    верни "./искра"

открыто функ флаг_цели() стр:
    верни "--цель linux"

открыто функ экзе_путь(имя стр) стр:
    верни стр_склей("./", имя)

открыто функ хост_не_вин() лог:
    верни да

открыто функ исполняемый(путь стр):
    п *нат.старт = стр_в_нуль(путь)
    искра:
        ПЕР ПРМ, п          ; путь ASCIIZ
        ПЕР ИСТ, 493        ; 0755
        ПЕР АКК, 90         ; sys_chmod
        СИСВЫЗОВ

# --- файлы и процессы ---------------------------------------------------------

открыто функ файл_удали(путь стр) лог:
    п *нат.старт = стр_в_нуль(путь)
    р цел.верх = 0
    искра:
        ПЕР ПРМ, п
        ПЕР АКК, 87         ; sys_unlink
        СИСВЫЗОВ
        ПЕР р, АКК
    верни р == 0

открыто функ _открой(путь стр, флаги цел.верх) цел.верх:
    п *нат.старт = стр_в_нуль(путь)
    фд цел.верх = -1
    искра:
        ПЕР ПРМ, п
        ПЕР ИСТ, флаги
        ПЕР ДАН, 420        ; 0644 на случай создания
        ПЕР АКК, 2          ; sys_open
        СИСВЫЗОВ
        ПЕР фд, АКК
    верни фд

# запускает «прог арг» со stdin=вход, stdout=вых (пути к файлам),
# stderr наследуется от родителя — предупреждения не портят вывод;
# ждёт завершения, возвращает код выхода, -(128+сигнал) при гибели или -1
открыто функ запусти(прог стр, арг стр, вход стр, вых стр) цел.верх:
    верни _запусти(прог, арг, вход, вых, нет)

# как запусти, но stderr ребёнка тоже идёт в вых — для проверки
# предупреждений и диагностики компилятора
открыто функ запусти_слей(прог стр, арг стр, вход стр, вых стр) цел.верх:
    верни _запусти(прог, арг, вход, вых, да)

открыто функ _запусти(прог стр, арг стр, вход стр, вых стр, слей лог) цел.верх:
    пид цел.верх = 0
    искра:
        ПЕР АКК, 57         ; sys_fork
        СИСВЫЗОВ
        ПЕР пид, АКК
    если пид < 0:
        верни -1
    если пид == 0:
        # ребёнок: stdin <- вход, stdout -> вых (и stderr при слей), execve
        вх цел.верх = _открой(вход, 0)
        если вх >= 0:
            искра:
                ПЕР ПРМ, вх
                ПЕР ИСТ, 0
                ПЕР АКК, 33     ; sys_dup2
                СИСВЫЗОВ
                ПЕР ПРМ, вх
                ПЕР АКК, 3      ; sys_close
                СИСВЫЗОВ
        вф цел.верх = _открой(вых, 577) ; O_WRONLY|O_CREAT|O_TRUNC
        если вф >= 0:
            искра:
                ПЕР ПРМ, вф
                ПЕР ИСТ, 1          ; stdout
                ПЕР АКК, 33
                СИСВЫЗОВ
            если слей:
                искра:
                    ПЕР ПРМ, вф
                    ПЕР ИСТ, 2      ; stderr сливается в тот же файл
                    ПЕР АКК, 33
                    СИСВЫЗОВ
            искра:
                ПЕР ПРМ, вф
                ПЕР АКК, 3
                СИСВЫЗОВ
        аргв *размер = выдели(24) как *размер
        аргв[0] = стр_в_нуль(прог) как размер
        если арг.длина > 0:
            аргв[1] = стр_в_нуль(арг) как размер
            аргв[2] = 0
        иначе:
            аргв[1] = 0
        пп *нат.старт = стр_в_нуль(прог)
        искра:
            ПЕР ПРМ, пп
            ПЕР ИСТ, аргв
            ПЕР ДАН, 0          ; пустое окружение
            ПЕР АКК, 59         ; sys_execve
            СИСВЫЗОВ
            ПЕР ПРМ, 127        ; execve вернулся — запуск не вышел
            ПЕР АКК, 60         ; sys_exit
            СИСВЫЗОВ
    # родитель: ждём и разбираем статус
    статус цел.верх = 0
    рез цел.верх = 0
    искра:
        ПЕР ПРМ, пид
        АДР ИСТ, статус
        ПЕР ДАН, 0
        ПЕР Р10, 0
        ПЕР АКК, 61         ; sys_wait4
        СИСВЫЗОВ
        ПЕР рез, АКК
    если рез < 0:
        верни -1
    сиг цел.верх = статус % 128     # WTERMSIG — младшие 7 бит
    если сиг != 0:
        верни -(сиг + 128)
    верни (статус / 256) % 256   # WEXITSTATUS
