;развивается
# окно — заглушка для Linux: окна требуют динамических библиотек (X11/Wayland),
# а эмиттер ELF пока поддерживает только системные вызовы без ИМПОРТов.
# API совпадает с окно.windows — окно_создай сообщает об ограничении
# и возвращает пусто.

взять стр, память, холст, консоль

открыто конст ОКНО_СТИЛЬ = 0
открыто конст ОКНО_УМОЛЧ = 0x80000000

открыто запись Окно:
    хендл нат.верх
    дц нат.верх
    ширина размер
    высота размер
    живо лог
    клавиша нат.рост
    мышь_х цел.верх
    мышь_у цел.верх
    мышь_левая лог
    мышь_правая лог

открыто функ окно_создай(заголовок стр, ширина размер, высота размер) *Окно:
    печать_ош("окно: цель linux пока не поддерживается (нет ИМПОРТов в ELF)\n")
    верни пусто

открыто функ окно_покажи(о *Окно, х *Холст):
    верни

открыто функ окно_опрос(о *Окно) лог:
    верни нет

открыто функ окно_событие(о *Окно) лог:
    верни нет

открыто функ окно_цикл(о *Окно):
    верни

открыто функ окно_заголовок(о *Окно, заголовок стр):
    верни

открыто функ время_мс() нат.верх:
    верни 0

открыто функ окно_спи(мс нат.рост):
    верни

открыто функ окно_закрой(о *Окно):
    если о != пусто:
        освободи(о)
