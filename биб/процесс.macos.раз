# процесс — запуск дочерних процессов с перенаправлением потоков (macOS).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.
# fork + dup2 + execve + wait4 через СИСВЫЗОВ (BSD 0x2000000+N);
# код выхода или -1. Ошибка syscall — флаг переноса (АКК = errno).

взять стр, память

# --- пути toolchain и платформенные мелочи -----------------------------------

открыто функ путь_разум() стр:
    верни "./raz/разум_мак"

открыто функ путь_искра() стр:
    верни "./искра_мак"

открыто функ флаг_цели() стр:
    верни "--цель macos"

открыто функ экзе_путь(имя стр) стр:
    верни стр_склей("./", имя)

открыто функ хост_не_вин() лог:
    верни да

# Делает файл запускаемым. На Apple Silicon ядро требует подпись кода
# у каждого исполняемого — иначе exec оканчивается SIGKILL («Killed: 9»),
# поэтому после chmod вызываем ad-hoc подпись: codesign -s - <путь>.
открыто функ _подпиши(путь стр) цел.верх:
    пид цел.верх = 0
    искра:
        ПЕР АКК, 0x2000002  ; sys_fork
        СИСВЫЗОВ
        НЕПЕРЕНОС м_проц_подп_ок
        ПЕР АКК, -1
        ПЕР пид, АКК
        ПРЫГ м_проц_подп_гот
        м_проц_подп_ок:
        ; ядро возвращает rax=пид обоим процессам; ребёнка выдаёт rdx=1
        СРАВ ДАН, 0
        НЕРАВНО м_проц_подп_дитя
        ПЕР пид, АКК
        ПРЫГ м_проц_подп_гот
        м_проц_подп_дитя:
        ПЕР АКК, 0
        ПЕР пид, АКК
        м_проц_подп_гот:
    если пид < 0:
        верни -1
    если пид == 0:
        кп *нат.старт = стр_в_нуль("/usr/bin/codesign")
        аргв *размер = выдели(40) как *размер
        аргв[0] = кп как размер
        аргв[1] = стр_в_нуль("-s") как размер
        аргв[2] = стр_в_нуль("-") как размер
        аргв[3] = стр_в_нуль(путь) как размер
        аргв[4] = 0
        искра:
            ПЕР ПРМ, кп
            ПЕР ИСТ, аргв
            ПЕР ДАН, 0
            ПЕР АКК, 0x200003B  ; sys_execve
            СИСВЫЗОВ
            ПЕР ПРМ, 127
            ПЕР АКК, 0x2000001  ; sys_exit
            СИСВЫЗОВ
    статус цел.верх = 0
    рез цел.верх = 0
    искра:
        ПЕР ПРМ, пид
        АДР ИСТ, статус
        ПЕР ДАН, 0
        ПЕР Р10, 0
        ПЕР АКК, 0x2000007  ; sys_wait4
        СИСВЫЗОВ
        НЕПЕРЕНОС м_проц_подпж_ок
        ПЕР АКК, -1
        м_проц_подпж_ок:
        ПЕР рез, АКК
    если рез < 0:
        верни -1
    верни (статус / 256) % 256

открыто функ исполняемый(путь стр):
    п *нат.старт = стр_в_нуль(путь)
    искра:
        ПЕР ПРМ, п          ; путь ASCIIZ
        ПЕР ИСТ, 493        ; 0755
        ПЕР АКК, 0x200000F  ; sys_chmod
        СИСВЫЗОВ
    _подпиши(путь)

# --- файлы и процессы ---------------------------------------------------------

открыто функ файл_удали(путь стр) лог:
    п *нат.старт = стр_в_нуль(путь)
    р цел.верх = 0
    искра:
        ПЕР ПРМ, п
        ПЕР АКК, 0x200000A  ; sys_unlink
        СИСВЫЗОВ
        НЕПЕРЕНОС м_проц_удал_ок
        ПЕР АКК, -1
        м_проц_удал_ок:
        ПЕР р, АКК
    верни р == 0

открыто функ _открой(путь стр, флаги цел.верх) цел.верх:
    п *нат.старт = стр_в_нуль(путь)
    фд цел.верх = -1
    искра:
        ПЕР ПРМ, п
        ПЕР ИСТ, флаги
        ПЕР ДАН, 420        ; 0644 на случай создания
        ПЕР АКК, 0x2000005  ; sys_open
        СИСВЫЗОВ
        НЕПЕРЕНОС м_проц_откр_ок
        ПЕР АКК, -1
        м_проц_откр_ок:
        ПЕР фд, АКК
    верни фд

# запускает «прог арг» со stdin=вход, stdout=вых (пути к файлам),
# stderr наследуется от родителя — предупреждения не портят вывод;
# ждёт завершения, возвращает код выхода, -(128+сигнал) при гибели или -1
открыто функ запусти(прог стр, арг стр, вход стр, вых стр) цел.верх:
    пид цел.верх = 0
    искра:
        ПЕР АКК, 0x2000002  ; sys_fork
        СИСВЫЗОВ
        НЕПЕРЕНОС м_проц_форк_ок
        ПЕР АКК, -1
        ПЕР пид, АКК
        ПРЫГ м_проц_форк_гот
        м_проц_форк_ок:
        ; ядро возвращает rax=пид обоим процессам; ребёнка выдаёт rdx=1
        СРАВ ДАН, 0
        НЕРАВНО м_проц_форк_дитя
        ПЕР пид, АКК
        ПРЫГ м_проц_форк_гот
        м_проц_форк_дитя:
        ПЕР АКК, 0
        ПЕР пид, АКК
        м_проц_форк_гот:
    если пид < 0:
        верни -1
    если пид == 0:
        # ребёнок: stdin <- вход, stdout -> вых (stderr наследуется), execve
        вх цел.верх = _открой(вход, 0)
        если вх >= 0:
            искра:
                ПЕР ПРМ, вх
                ПЕР ИСТ, 0
                ПЕР АКК, 0x200005A  ; sys_dup2
                СИСВЫЗОВ
                ПЕР ПРМ, вх
                ПЕР АКК, 0x2000006  ; sys_close
                СИСВЫЗОВ
        вф цел.верх = _открой(вых, 0x601)   ; O_WRONLY|O_CREAT|O_TRUNC (macOS)
        если вф >= 0:
            искра:
                ПЕР ПРМ, вф
                ПЕР ИСТ, 1          ; только stdout; stderr наследуется
                ПЕР АКК, 0x200005A
                СИСВЫЗОВ
                ПЕР ПРМ, вф
                ПЕР АКК, 0x2000006
                СИСВЫЗОВ
        аргв *размер = выдели(24) как *размер
        аргв[0] = стр_в_нуль(прог) как размер
        если арг.длина > 0:
            аргв[1] = стр_в_нуль(арг) как размер
            аргв[2] = 0
        иначе:
            аргв[1] = 0
        пп *нат.старт = стр_в_нуль(прог)
        искра:
            ПЕР ПРМ, пп
            ПЕР ИСТ, аргв
            ПЕР ДАН, 0          ; пустое окружение
            ПЕР АКК, 0x200003B  ; sys_execve
            СИСВЫЗОВ
            ПЕР ПРМ, 127        ; execve вернулся — запуск не вышел
            ПЕР АКК, 0x2000001  ; sys_exit
            СИСВЫЗОВ
    # родитель: ждём и разбираем статус
    статус цел.верх = 0
    рез цел.верх = 0
    искра:
        ПЕР ПРМ, пид
        АДР ИСТ, статус
        ПЕР ДАН, 0
        ПЕР Р10, 0
        ПЕР АКК, 0x2000007  ; sys_wait4
        СИСВЫЗОВ
        НЕПЕРЕНОС м_проц_жди_ок
        ПЕР АКК, -1
        м_проц_жди_ок:
        ПЕР рез, АКК
    если рез < 0:
        верни -1
    сиг цел.верх = статус % 128     # WTERMSIG — младшие 7 бит
    если сиг != 0:
        верни -(сиг + 128)
    верни (статус / 256) % 256   # WEXITSTATUS
