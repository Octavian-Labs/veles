# память — примитивы работы с сырой памятью.
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

функ заполни(указ *нат.старт, б нат.старт, n нат.верх):
    i нат.верх = 0
    пока i < n:
        указ[i] = б
        i += 1

функ скопируй(куда *нат.старт, откуда *нат.старт, n нат.верх):
    i нат.верх = 0
    пока i < n:
        куда[i] = откуда[i]
        i += 1

функ равна_память(а *нат.старт, б *нат.старт, n нат.верх) лог:
    i нат.верх = 0
    пока i < n:
        если а[i] != б[i]:
            верни нет
        i += 1
    верни да
