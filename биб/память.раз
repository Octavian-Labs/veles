# память — примитивы работы с сырой памятью.
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

открыто функ заполни(указ *нат.старт, б нат.старт, колво размер):
    инд размер = 0
    пока инд < колво:
        указ[инд] = б
        инд += 1

открыто функ скопируй(куда *нат.старт, откуда *нат.старт, колво размер):
    инд размер = 0
    пока инд < колво:
        куда[инд] = откуда[инд]
        инд += 1

открыто функ равна_память(а *нат.старт, б *нат.старт, колво размер) лог:
    инд размер = 0
    пока инд < колво:
        если а[инд] != б[инд]:
            верни нет
        инд += 1
    верни да
