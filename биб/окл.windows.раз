# стр → нуль-терминированная копия
функ _стр_в_с(с стр) *нат.старт:
    указ *нат.старт = выдели(с.длина + 1)
    скопируй(указ, с.данные, с.длина)
    указ[с.длина] = 0
    верни указ

# нуль-терминированный буфер → стр (завершающий нуль отрезается)
функ _с_в_стр(указ *нат.старт, дл размер) стр:
    если дл > 0 и указ[дл - 1] == 0:
        дл -= 1
    верни стр_собери(указ, дл)

# первая платформа и первое GPU-устройство (иначе любое) + контекст и очередь
открыто функ окл_начни() *Окл:
    плат нат.верх = 0
    сколько нат.рост = 0
    если clGetPlatformIDs(1, &плат, &сколько) != 0 или сколько == 0:
        верни пусто
    ус нат.верх = 0
    если (clGetDeviceIDs(плат, ОКЛ_УСТР_ГПУ, 1, &ус, &сколько) != 0
            или сколько == 0):
        если (clGetDeviceIDs(плат, ОКЛ_УСТР_ЛЮБОЕ, 1, &ус, &сколько) != 0
                или сколько == 0):
            верни пусто
    ош цел.рост = 0
    ктх нат.верх = clCreateContext(пусто, 1, &ус, пусто, пусто, &ош)
    если ктх == 0:
        верни пусто
    оче нат.верх = clCreateCommandQueue(ктх, ус, 0, &ош)
    если оче == 0:
        clReleaseContext(ктх)
        верни пусто
    ок *Окл = новый(Окл)
    ок.платформа = плат
    ок.устройство = ус
    ок.контекст = ктх
    ок.очередь = оче
    верни ок

открыто функ окл_конец(ок *Окл):
    clReleaseCommandQueue(ок.очередь)
    clReleaseContext(ок.контекст)
    освободи(ок)

