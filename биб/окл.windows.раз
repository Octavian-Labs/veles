# --- программы и ядра ------------------------------------------------------------

# собирает программу из исходника OpenCL C; при ошибке сборки печатает
# журнал в stderr и возвращает 0
открыто функ окл_программа(ок *Окл, исходник стр) нат.верх:
    ош цел.рост = 0
    строки **нат.старт = выдели(8) как **нат.старт
    строки[0] = исходник.данные
    длины *размер = выдели(8) как *размер
    длины[0] = исходник.длина
    прог нат.верх = clCreateProgramWithSource(ок.контекст, 1, строки,
        длины, &ош)
    освободи(строки)
    освободи(длины)
    если прог == 0:
        верни 0
    если clBuildProgram(прог, 1, &ок.устройство, пусто, пусто, пусто) != 0:
        _окл_журнал(ок, прог)
        clReleaseProgram(прог)
        верни 0
    верни прог

функ _окл_журнал(ок *Окл, прог нат.верх):
    реальный размер = 0
    clGetProgramBuildInfo(прог, ок.устройство, ОКЛ_ЖУРНАЛ, 0, пусто,
        &реальный)
    если реальный == 0:
        верни
    указ *нат.старт = выдели(реальный)
    clGetProgramBuildInfo(прог, ок.устройство, ОКЛ_ЖУРНАЛ, реальный, указ,
        пусто)
    печать_ош(_с_в_стр(указ, реальный))
    освободи(указ)

открыто функ окл_ядро(прог нат.верх, имя стр) нат.верх:
    имя_с *нат.старт = _стр_в_с(имя)
    ош цел.рост = 0
    ядро нат.верх = clCreateKernel(прог, имя_с, &ош)
    освободи(имя_с)
    верни ядро

открыто функ окл_освободи_прог(прог нат.верх):
