;развивается
# уй — элементарный интерфейс поверх холста: растровый шрифт 5x7
# (цифры, знаки, кириллица А-Я), текст, кнопки, полосы, панели и
# проверка попадания мыши. Часть стандартной библиотеки ВЕЛЕС.
#
# Глиф — нат.верх, 7 рядов по 5 бит (ряд*5 + кол, кол=0 — левый,
# бит читается как (г >> (ряд*5 + 4 - кол)) & 1). Контекст Уй
# держит таблицы в куче; создаётся уй_начни, освобождается уй_конец.

взять стр, память, холст

открыто запись Уй:
    таб *нат.верх      # 128 глифов ASCII
    табк *нат.верх     # 32 глифа кириллицы А-Я (0x410-0x42F)

открыто функ уй_начни() *Уй:
    у *Уй = новый(Уй)
