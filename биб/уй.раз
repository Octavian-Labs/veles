открыто функ уй_конец(у *Уй):
    освободи(у.таб)
    освободи(у.табк)
    освободи(у)

# глиф по юникод-коду; а-я и ё отображаются на А-Я и Е
открыто функ уй_глиф(у *Уй, код цел.верх) нат.верх:
    если код >= 0x430 и код <= 0x44F:
        код = код - 0x20
    если код == 0x401 или код == 0x451:
        код = 0x415
    если код >= 0x410 и код <= 0x42F:
        верни у.табк[код - 0x410]
    если код >= 0 и код < 128:
        верни у.таб[код]
    верни 0

# один символ, масштаб — целый множитель пикселя
открыто функ уй_сим(х *Холст, у *Уй, пх цел.верх, пу цел.верх,
                    код цел.верх, масштаб цел.верх, ц нат.рост):
    г нат.верх = уй_глиф(у, код)
    если г == 0:
        верни
    для ряд в 0..7:
        для кол в 0..5:
            если ((г >> ((ряд * 5 + 4 - кол) как нат.верх)) & 1) != 0:
                холст_прямоуг_залей(х, пх + кол*масштаб, пу + ряд*масштаб,
                                    масштаб, масштаб, ц)

# строка UTF-8 слева направо; шаг 6*масштаб
открыто функ уй_текст(х *Холст, у *Уй, пх цел.верх, пу цел.верх,
                      с стр, масштаб цел.верх, ц нат.рост) цел.верх:
    п цел.верх = пх
    и размер = 0
    пока и < с.длина:
        б нат.старт = с.данные[и]
        код цел.верх = б как цел.верх
        и += 1
        если б >= 0xC0:
            код = ((б как цел.верх) & 0x1F) << 6
            код = код | ((с.данные[и] как цел.верх) & 0x3F)
            и += 1
        уй_сим(х, у, п, пу, код, масштаб, ц)
        п += 6 * масштаб
    верни п - пх

# целое число текстом; возвращает ширину вывода
открыто функ уй_число(х *Холст, у *Уй, пх цел.верх, пу цел.верх,
                      число цел.верх, масштаб цел.верх, ц нат.рост) цел.верх:
    верни уй_текст(х, у, пх, пу, цел_в_стр(число), масштаб, ц)

# вещественное с 3 знаками после точки
открыто функ уй_вещ(х *Холст, у *Уй, пх цел.верх, пу цел.верх,
                    знач вещ.рост, масштаб цел.верх, ц нат.рост):
    отр лог = знач < 0.0
    если отр:
        знач = 0.0 - знач
    целая цел.верх = знач как цел.верх
    дробь цел.верх = ((знач - (целая как вещ.рост)) * 1000.0 + 0.5) как цел.верх
    если дробь >= 1000:
        целая += 1
        дробь = 0
    п цел.верх = пх
    если отр:
        уй_сим(х, у, п, пу, 45, масштаб, ц)
        п += 6 * масштаб
    п += уй_число(х, у, п, пу, целая, масштаб, ц)
    уй_сим(х, у, п, пу, 46, масштаб, ц)
    п += 6 * масштаб
    если дробь < 10:
        уй_сим(х, у, п, пу, 48, масштаб, ц)
        п += 6 * масштаб
    если дробь < 100:
        уй_сим(х, у, п, пу, 48, масштаб, ц)
        п += 6 * масштаб
    уй_число(х, у, п, пу, дробь, масштаб, ц)

# кнопка: рамка + подпись; включена — другой фон
открыто функ уй_кнопка(х *Холст, у *Уй, пх цел.верх, пу цел.верх,
                       шир цел.верх, выс цел.верх, надпись стр,
                       включена лог):
    если включена:
        холст_прямоуг_залей(х, пх, пу, шир, выс, цвет(35, 70, 90))
    иначе:
        холст_прямоуг_залей(х, пх, пу, шир, выс, цвет(20, 28, 42))
    холст_прямоуг(х, пх, пу, шир, выс, цвет(70, 110, 140))
    уй_текст(х, у, пх + 6, пу + (выс - 7) / 2, надпись, 1,
             цвет(190, 220, 240))

# панель с заголовком
открыто функ уй_панель(х *Холст, у *Уй, пх цел.верх, пу цел.верх,
                       шир цел.верх, выс цел.верх, заголовок стр):
    холст_прямоуг_залей(х, пх, пу, шир, выс, цвет(12, 16, 26))
    холст_прямоуг(х, пх, пу, шир, выс, цвет(50, 70, 100))
    если заголовок.длина > 0:
        уй_текст(х, у, пх + 6, пу + 5, заголовок, 1, цвет(120, 160, 200))

# горизонтальная полоса значения 0..1
открыто функ уй_полоса(х *Холст, пх цел.верх, пу цел.верх, шир цел.верх,
                       выс цел.верх, знач вещ.рост, ц нат.рост):
    если знач < 0.0:
        знач = 0.0
    если знач > 1.0:
        знач = 1.0
    холст_прямоуг(х, пх, пу, шир, выс, цвет(50, 70, 100))
    зап цел.верх = (знач * ((шир - 2) как вещ.рост)) как цел.верх
    если зап > 0:
        холст_прямоуг_залей(х, пх + 1, пу + 1, зап, выс - 2, ц)

# попадание точки мыши в прямоугольную зону
открыто функ уй_зона(мх цел.верх, му цел.верх, пх цел.верх, пу цел.верх,
                     шир цел.верх, выс цел.верх) лог:
    верни мх >= пх и мх < пх + шир и му >= пу и му < пу + выс
