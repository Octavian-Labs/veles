открыто конст ОКНО_СТИЛЬ = 0x00CF0000       # WS_OVERLAPPEDWINDOW
открыто конст ОКНО_УМОЛЧ = 0x80000000       # CW_USEDEFAULT

открыто запись Окно:
    хендл нат.верх
    дц нат.верх               # контекст устройства окна
    ширина размер
    высота размер
    живо лог                  # нет после WM_DESTROY
    клавиша нат.рост          # виртуальный код последней клавиши
    мышь_х цел.верх
    мышь_у цел.верх
    мышь_левая лог
    мышь_правая лог

# оконная процедура — вызывается Windows по Win64-ABI, оно совпадает с ABI
# РАЗУМА (СЧТ,ДАН,Р8,Р9 → АКК); указатель на Окно лежит в GWLP_USERDATA
функ _обр(хендл нат.верх, сооб нат.рост, вп нат.верх, лп нат.верх) нат.верх:
    если сооб == 0x0081:                  # WM_NCCREATE
        сз *размер = лп как *размер       # CREATESTRUCTW.lpCreateParams
        SetWindowLongPtrW(хендл, -21, сз[0])
        верни DefWindowProcW(хендл, сооб, вп, лп)
    о *Окно = GetWindowLongPtrW(хендл, -21) как *Окно
    если сооб == 0x0002:                  # WM_DESTROY
        если о != пусто:
            о.живо = нет
        PostQuitMessage(0)
        верни 0
    если о == пусто:
        верни DefWindowProcW(хендл, сооб, вп, лп)
    если сооб == 0x0100:                  # WM_KEYDOWN
        о.клавиша = вп как нат.рост
    а если сооб == 0x0200:                # WM_MOUSEMOVE
        пзх цел.верх = (лп & 0xFFFF) как цел.верх
        пзу цел.верх = ((лп >> 16) & 0xFFFF) как цел.верх
        если пзх >= 32768:
            пзх -= 65536
        если пзу >= 32768:
            пзу -= 65536
        о.мышь_х = пзх
        о.мышь_у = пзу
    а если сооб == 0x0201:                # WM_LBUTTONDOWN
        о.мышь_левая = да
    а если сооб == 0x0202:                # WM_LBUTTONUP
        о.мышь_левая = нет
    а если сооб == 0x0204:                # WM_RBUTTONDOWN
        о.мышь_правая = да
    а если сооб == 0x0205:                # WM_RBUTTONUP
        о.мышь_правая = нет
    верни DefWindowProcW(хендл, сооб, вп, лп)

открыто функ окно_создай(заголовок стр, ширина размер, высота размер) *Окно:
    о *Окно = новый(Окно)
    о.хендл = 0
    о.дц = 0
    о.ширина = ширина
    о.высота = высота
    о.живо = да
    о.клавиша = 0
    о.мышь_х = 0
    о.мышь_у = 0
    о.мышь_левая = нет
    о.мышь_правая = нет
    обр нат.верх = GetModuleHandleW(пусто)
    # WNDCLASSEXW — 80 байт; повторная регистрация безвредна (класс уже есть)
    кл *нат.старт = выдели(80)
    заполни(кл, 0, 80)
    кл32 *нат.рост = кл как *нат.рост
    кл32[0] = 80                          # cbSize
    кл32[1] = 0x0003                      # CS_HREDRAW | CS_VREDRAW
    кл64 *размер = кл как *размер
    кл64[1] = _обр как размер             # lpfnWndProc
    кл64[3] = обр                         # hInstance
    кл64[5] = LoadCursorW(пусто, 32512)   # IDC_ARROW
    имя_кл *нат.шаг = стр_в_шир("ВЕЛЕС.окно")
    кл64[8] = имя_кл как размер           # lpszClassName
    RegisterClassExW(кл)
    освободи(кл)
    # подгонка внешних размеров под клиентскую область (RECT = 4 x цел.рост)
    пр *нат.старт = выдели(16)
    заполни(пр, 0, 16)
    прц *цел.рост = пр как *цел.рост
    прц[2] = ширина как цел.рост          # right
    прц[3] = высота как цел.рост          # bottom
    AdjustWindowRect(пр, ОКНО_СТИЛЬ, 0)
    о.хендл = CreateWindowExW(0, имя_кл, стр_в_шир(заголовок),
        ОКНО_СТИЛЬ, ОКНО_УМОЛЧ, ОКНО_УМОЛЧ, прц[2] - прц[0], прц[3] - прц[1],
        пусто, пусто, обр, о как *пусто)
    освободи(пр)
    если о.хендл == 0:
        освободи(о)
        верни пусто
    ShowWindow(о.хендл, 5)                # SW_SHOW
    UpdateWindow(о.хендл)
    о.дц = GetDC(о.хендл)
    верни о

# выводит холст в клиентскую область окна без растяжения (SRCCOPY)
открыто функ окно_покажи(о *Окно, х *Холст):
    бм *нат.старт = выдели(40)            # BITMAPINFOHEADER
    заполни(бм, 0, 40)
    бм32 *нат.рост = бм как *нат.рост
    бм32[0] = 40                          # biSize
    бмц *цел.рост = бм как *цел.рост
    бмц[1] = х.ширина как цел.рост        # biWidth
    бмц[2] = -(х.высота как цел.рост)     # biHeight < 0 — растр сверху вниз
    бм16 *нат.шаг = бм как *нат.шаг
    бм16[6] = 1                           # biPlanes (смещение 12)
    бм16[7] = 32                          # biBitCount (смещение 14)
    StretchDIBits(о.дц, 0, 0, о.ширина как цел.рост, о.высота как цел.рост,
        0, 0, х.ширина как цел.рост, х.высота как цел.рост,
        х.пиксели, бм, 0, 0x00CC0020)     # DIB_RGB_COLORS, SRCCOPY
    освободи(бм)

# разбирает накопившиеся сообщения без ожидания; нет — окно закрыто
открыто функ окно_опрос(о *Окно) лог:
    сооб *нат.старт = выдели(56)          # MSG = 48 байт, с запасом
    пока PeekMessageW(сооб, пусто, 0, 0, 1) != 0:
        если (сооб как *нат.рост)[2] == 0x0012:   # WM_QUIT
            о.живо = нет
            следующий
        TranslateMessage(сооб)
        DispatchMessageW(сооб)
    освободи(сооб)
    верни о.живо

# ждёт следующего сообщения (блокируется); нет — окно закрыто
открыто функ окно_событие(о *Окно) лог:
    сооб *нат.старт = выдели(56)
    код цел.рост = GetMessageW(сооб, пусто, 0, 0)
    если код > 0:
        TranslateMessage(сооб)
        DispatchMessageW(сооб)
    а если код <= 0:
        о.живо = нет
    освободи(сооб)
    верни о.живо

# главный цикл: опрос сообщений с коротким сном, пока окно живо
открыто функ окно_цикл(о *Окно):
    пока о.живо:
        окно_опрос(о)
        Sleep(1)

открыто функ окно_заголовок(о *Окно, заголовок стр):
    SetWindowTextW(о.хендл, стр_в_шир(заголовок))

# миллисекунды от старта системы — для кадров и анимации
открыто функ время_мс() нат.верх:
    верни GetTickCount64()

открыто функ окно_спи(мс нат.рост):
    Sleep(мс)

открыто функ окно_закрой(о *Окно):
    если о.хендл != 0:
        если о.дц != 0:
            ReleaseDC(о.хендл, о.дц)
            о.дц = 0
        DestroyWindow(о.хендл)
        о.хендл = 0
        о.живо = нет
    освободи(о)
