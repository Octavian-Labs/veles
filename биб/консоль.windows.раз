# консоль — вывод в stdout (Windows: WinAPI WriteFile).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять стр, память, буфер

внеш "kernel32" функ GetStdHandle(деск нат.рост) нат.верх
внеш "kernel32" функ WriteFile(хендл нат.верх, буф *нат.старт,
                               колво нат.рост, записано *нат.рост,
                               овер *пусто) цел.рост

функ печать(с стр):
    записано нат.рост = 0
    х нат.верх = GetStdHandle(0xFFFFFFF5)   # STD_OUTPUT_HANDLE
    WriteFile(х, с.данные, с.длина как нат.рост, &записано, пусто)

функ печать_ош(с стр):
    записано нат.рост = 0
    х нат.верх = GetStdHandle(0xFFFFFFF4)   # STD_ERROR_HANDLE
    WriteFile(х, с.данные, с.длина как нат.рост, &записано, пусто)

функ печатьстр(с стр):
    печать(с)
    печать("\r\n")

функ печатьцел(ч цел.верх):
    печать(цел_в_стр(ч))

внеш "kernel32" функ ReadFile(хендл нат.верх, буф *нат.старт, колво нат.рост,
                              прочитано *нат.рост, овер *пусто) цел.рост

функ ввод() стр:
    # читает весь stdin до EOF порциями по 64 КиБ
    х нат.верх = GetStdHandle(0xFFFFFFF6)   # STD_INPUT_HANDLE
    б *Буфер = буф_новый()
    кусок *нат.старт = выдели(65536)
    прочитано нат.рост = 0
    пока да:
        ок цел.рост = ReadFile(х, кусок, 65536, &прочитано, пусто)
        если ок == 0 или прочитано == 0:
            хватит
        буф_место(б, прочитано как нат.верх)
        скопируй(б.данные + б.длина, кусок, прочитано как нат.верх)
        б.длина += прочитано как нат.верх
    освободи(кусок)
    верни буф_стр(б)
