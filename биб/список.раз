# список — динамический массив машинных слов (указателей и чисел).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.
# Хранит размер (машинное слово); указатели приводятся через «как размер» / «как *Т».

взять память

запись Список:
    данные *размер
    длина размер
    вмест размер          ; вместимость в элементах

функ список_новый() *Список:
    с *Список = новый(Список)
    с.данные = выдели(8 * 8) как *размер
    с.длина = 0
    с.вмест = 8
    верни с

функ список_добавь(с *Список, э размер):
    если с.длина == с.вмест:
        новая *размер = выдели(с.вмест * 16) как *размер
        скопируй(новая как *нат.старт, с.данные как *нат.старт, с.вмест * 8)
        освободи(с.данные)
        с.данные = новая
        с.вмест = с.вмест * 2
    с.данные[с.длина] = э
    с.длина += 1

функ список_получи(с *Список, инд размер) размер:
    верни с.данные[инд]

функ список_свободен(с *Список):
    освободи(с.данные)
    освободи(с)
