# эльф — эмиттер ELF64 для Linux.
#
# Статический исполняемый файл без библиотек: один сегмент PT_LOAD (RWE)
# отображает весь файл по базе 0x400000, поэтому
# виртуальный адрес = 0x400000 + смещение в файле.
# Системные вызовы — инструкция СИСВЫЗОВ; ИМПОРТ не поддерживается.

взять основа
взять сборщик      # План, уст*, выров

конст Э_БАЗА = 0x400000
конст Э_ЗГЛ = 64        # размер ELF-заголовка
конст Э_ПЗГЛ = 56       # размер программного заголовка
конст Э_ЗГЛВСЕ = 120    # 64 + 56

функ эльф_план(разм_код размер, разм_дан размер, импорты *Список,
               вход_смещ размер) *План:
    # назначает адреса секций: vaddr = БАЗА + смещение в файле
    если импорты.длина > 0:
        иск_ош("ИМПОРТ не поддерживается для цели linux — используйте СИСВЫЗОВ",
               0, 0)
    пл *План = новый(План)
    пл.иат = список_новый()
    пл.блобы = список_новый()
    пл.код_ва = (Э_БАЗА + Э_ЗГЛВСЕ)как размер
    пл.дан_ва = пл.код_ва + разм_код
    пл.вход_ва = пл.код_ва + вход_смещ
    верни пл

функ эльф_строй(пл *План, код стр, дан стр) стр:
    # ELF64: заголовок, один программный заголовок, код, данные
    введи разм_файл = Э_ЗГЛВСЕ + код.длина + дан.длина
    вых *Буфер = буф_новый()
    буф_нуль(вых, Э_ЗГЛ)
    вых.данные[0] = 0x7F
    вых.данные[1] = 'E'
    вых.данные[2] = 'L'
    вых.данные[3] = 'F'
    вых.данные[4] = 2                # класс: 64 бита
    вых.данные[5] = 1                # little-endian
    вых.данные[6] = 1                # версия ELF
    вых.данные[7] = 0                # OS/ABI: System V
    уст16(вых.данные, 16, 2)         # e_type: EXEC
    уст16(вых.данные, 18, 0x3E)      # e_machine: x86-64
    уст32(вых.данные, 20, 1)         # e_version
    уст64(вых.данные, 24, пл.вход_ва)
    уст64(вых.данные, 32, Э_ЗГЛ)     # e_phoff
    уст64(вых.данные, 40, 0)         # e_shoff
    уст16(вых.данные, 52, Э_ЗГЛ)     # e_ehsize
    уст16(вых.данные, 54, Э_ПЗГЛ)    # e_phentsize
    уст16(вых.данные, 56, 1)         # e_phnum
    уст16(вых.данные, 58, 64)        # e_shentsize
    # программный заголовок PT_LOAD
    пзаг *Буфер = буф_новый()
    буф_нуль(пзаг, Э_ПЗГЛ)
    уст32(пзаг.данные, 0, 1)           # p_type: PT_LOAD
    уст32(пзаг.данные, 4, 7)           # p_flags: RWE
    уст64(пзаг.данные, 8, 0)           # p_offset
    уст64(пзаг.данные, 16, Э_БАЗА)     # p_vaddr
    уст64(пзаг.данные, 24, Э_БАЗА)     # p_paddr
    уст64(пзаг.данные, 32, разм_файл)  # p_filesz
    уст64(пзаг.данные, 40, разм_файл)  # p_memsz
    уст64(пзаг.данные, 48, 0x1000)     # p_align
    буф_добавь(вых, буф_стр(пзаг))
    буф_добавь(вых, код)
    буф_добавь(вых, дан)
    верни буф_стр(вых)
