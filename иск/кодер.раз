# кодер — кодировка инструкций x86-64 для ИСКРЫ.
#
# REX-префиксы, ModRM/SIB, RIP-относительная адресация,
# относительные переходы, вызовы импортов через IAT.
# Размер инструкции зависит только от видов операндов —
# двухпроходное ассемблирование корректно.

взять основа
взять узлы
взять выраж
взять парсер       # Опер, О_*, И_*

# --- таблицы мнемоник --------------------------------------------------------

функ _код_биноп(м стр) цел64:
    # бинарные арифметико-логические: мнемоника -> код группы (-1 = нет)
    если стр_равны_нр(м, "ДОБ"):
        верни 0
    если стр_равны_нр(м, "ИЛИ"):
        верни 1
    если стр_равны_нр(м, "ДОБП"):
        верни 2
    если стр_равны_нр(м, "ВЫЧП"):
        верни 3
    если стр_равны_нр(м, "И"):
        верни 4
    если стр_равны_нр(м, "ВЫЧ"):
        верни 5
    если стр_равны_нр(м, "ИИЛИ"):
        верни 6
    если стр_равны_нр(м, "СРАВ"):
        верни 7
    верни -1

функ _код_унар(м стр) цел64:
    # унарные F7/F6: мнемоника -> поле reg в ModRM (-1 = нет)
    если стр_равны_нр(м, "НЕ"):
        верни 2
    если стр_равны_нр(м, "ОТР"):
        верни 3
    если стр_равны_нр(м, "УМНБ"):
        верни 4
    если стр_равны_нр(м, "ДЕЛБ"):
        верни 6
    если стр_равны_нр(м, "ДЕЛ"):
        верни 7
    верни -1

функ _код_сдвиг(м стр) цел64:
    # сдвиги и циклические: мнемоника -> поле reg (-1 = нет)
    если стр_равны_нр(м, "ВРЛ"):
        верни 0
    если стр_равны_нр(м, "ВРП"):
        верни 1
    если стр_равны_нр(м, "СДЛ"):
        верни 4
    если стр_равны_нр(м, "СДП"):
        верни 5
    если стр_равны_нр(м, "СДПА"):
        верни 7
    верни -1

функ _код_усл(м стр) цел64:
    # условные переходы/УСТ: мнемоника -> код условия (-1 = нет)
    если стр_равны_нр(м, "ПЕРЕПОЛН"):
        верни 0
    если стр_равны_нр(м, "НЕПЕРЕПОЛН"):
        верни 1
    если стр_равны_нр(м, "НИЖЕ") или стр_равны_нр(м, "ПЕРЕНОС"):
        верни 2
    если (стр_равны_нр(м, "НЕНИЖЕ") или стр_равны_нр(м, "ВЫШРАВ") или
          стр_равны_нр(м, "НЕПЕРЕНОС")):
        верни 3
    если стр_равны_нр(м, "РАВНО") или стр_равны_нр(м, "НОЛЬ"):
        верни 4
    если стр_равны_нр(м, "НЕРАВНО") или стр_равны_нр(м, "НЕНОЛЬ"):
        верни 5
    если стр_равны_нр(м, "НИЖРАВ") или стр_равны_нр(м, "НЕВЫШЕ"):
        верни 6
    если стр_равны_нр(м, "ВЫШЕ") или стр_равны_нр(м, "НЕНИЖРАВ"):
        верни 7
    если стр_равны_нр(м, "ЗНАК"):
        верни 8
    если стр_равны_нр(м, "НЕЗНАК"):
        верни 9
    если стр_равны_нр(м, "ЧЁТ") или стр_равны_нр(м, "ЧЕТ"):
        верни 0xA
    если стр_равны_нр(м, "НЕЧЁТ") или стр_равны_нр(м, "НЕЧЕТ"):
        верни 0xB
    если стр_равны_нр(м, "МЕНЬШЕ"):
        верни 0xC
    если стр_равны_нр(м, "БОЛРАВ") или стр_равны_нр(м, "НЕМЕНЬШЕ"):
        верни 0xD
    если стр_равны_нр(м, "МЕНРАВ") или стр_равны_нр(м, "НЕБОЛЬШЕ"):
        верни 0xE
    если стр_равны_нр(м, "БОЛЬШЕ") или стр_равны_нр(м, "НЕМЕНРАВ"):
        верни 0xF
    верни -1

функ _код_нулев(м стр) стр:
    # инструкции без операндов: мнемоника -> байты (пусто = нет)
    если стр_равны_нр(м, "НОП"):
        верни _байт1(0x90)
    если стр_равны_нр(м, "СТОП"):
        верни _байт1(0xF4)
    если стр_равны_нр(м, "ПРЕРЫВ"):
        верни _байт1(0xCC)
    если стр_равны_нр(м, "СИСВЫЗОВ"):
        верни _байт2(0x0F, 0x05)
    если стр_равны_нр(м, "ПОКИНЬ"):
        верни _байт1(0xC9)
    если стр_равны_нр(м, "РАСШ"):
        верни _байт2(0x48, 0x99)
    если стр_равны_нр(м, "РАСШД"):
        верни _байт1(0x99)
    верни пусто как стр

# --- помощники кодирования ---------------------------------------------------

функ _диап(v цел64, бит без64, знак бул, строка без64):
    # проверяет, что значение помещается в заданную разрядность
    если бит >= 64:
        верни                     # любое цел64 помещается в 64 бита
    если знак:
        если (v < 0 - ((1 как цел64) << (бит - 1)) или
              v > ((1 как цел64) << (бит - 1)) - 1):
            иск_ош("значение не помещается в разрядность", строка, 0)
    иначе:
        если v < 0 или (v как без64) > ((1 как без64) << бит) - 1:
            иск_ош("значение не помещается в разрядность", строка, 0)

функ _гибк(v цел64, бит без64, строка без64):
    # гибкая проверка: знаковое или беззнаковое (сравнение знаковое —
    # отрицательные v не превращаем в огромные без64)
    если бит >= 64:
        верни
    если (v < 0 - ((1 как цел64) << (бит - 1)) или
          v > ((1 как цел64) << бит) - 1):
        иск_ош("значение не помещается в разрядность", строка, 0)

функ _имм(б *Буфер, v цел64, n без64):
    # непосредственное значение little-endian (по модулю 2^(8n))
    uv := v как без64
    если n == 1:
        буф_сим(б, uv как без8)
    а если n == 2:
        буф_п16(б, uv)
    а если n == 4:
        буф_п32(б, uv)
    иначе:
        буф_п64(б, uv)

функ _рекс(w без64, r без64, x без64, б без64, форс бул) цел64:
    # байт REX-префикса; -1 — префикс не нужен
    v := (0x40 | (w << 3) | (r << 2) | (x << 1) | б) как без64
    если v == 0x40 и не форс:
        верни -1
    верни v как цел64

функ _шиб(масш без64, инд без64, база без64) без8:
    # байт SIB
    код := 0 как без64
    если масш == 2:
        код = 1
    а если масш == 4:
        код = 2
    а если масш == 8:
        код = 3
    верни ((код << 6) | ((инд & 7) << 3) | (база & 7)) как без8

# --- состояние кодирования одной инструкции ----------------------------------

запись Патч:
    поз без64           # позиция в хвосте для disp32 (RIP-относит.)
    выр *Узел           # выражение цели

запись Код:
    ктх *Ктх
    строка без64
    столб без64
    патчи *Список       # *Патч

функ _код_новый(ктх *Ктх, строка без64, столб без64) *Код:
    к *Код = новый(Код)
    к.ктх = ктх
    к.строка = строка
    к.столб = столб
    к.патчи = список_новый()
    верни к

функ _рип_патч(к *Код, хвост *Буфер, выр *Узел):
    # запоминает место disp32 для RIP-относительной адресации
    п *Патч = новый(Патч)
    п.поз = хвост.длина
    п.выр = выр
    список_добавь(к.патчи, п как без64)
    буф_нуль(хвост, 4)

функ _рм(к *Код, хвост *Буфер, оп *Опер, регf без64) без64:
    # кодирует операнд r/m (регистр или память) в хвост;
    # возвращает rex_x | rex_b<<8 — расширенные биты для REX
    если оп.вид == О_РЕГ:
        буф_сим(хвост, (0xC0 | (регf << 3) | (оп.ном & 7)) как без8)
        верни ((оп.ном >> 3) & 1) << 8
    # память
    если оп.инд != пусто и (оп.инд.ном & 7) == 4:
        иск_ош("УКС/rsp/r12 не может быть индексным регистром", к.строка, к.столб)
    база := -1 как цел64
    инд := -1 как цел64
    если оп.база != пусто:
        база = оп.база.ном как цел64
    если оп.инд != пусто:
        инд = оп.инд.ном как цел64
    если база < 0 и инд < 0:
        # RIP-относительная: [метка] — только смещение с символом
        если оп.выр != пусто и в_есть_сим(оп.выр):
            буф_сим(хвост, ((регf << 3) | 0x05) как без8)
            _рип_патч(к, хвост, оп.выр)
            верни 0
        д := 0 как цел64
        если оп.выр != пусто:
            д = в_вычисли(оп.выр, к.ктх)
        буф_сим(хвост, ((регf << 3) | 0x04) как без8)
        буф_сим(хвост, _шиб(1, 4, 5))
        _имм(хвост, д, 4)
        верни 0
    если база < 0:
        # [индекс*масштаб + disp32]
        д = 0 как цел64
        если оп.выр != пусто:
            д = в_вычисли(оп.выр, к.ктх)
        буф_сим(хвост, ((регf << 3) | 0x04) как без8)
        буф_сим(хвост, _шиб(оп.масш, инд как без64, 5))
        _имм(хвост, д, 4)
        верни ((инд >> 3) & 1) как без64
    # есть базовый регистр
    д = 0 как цел64
    есть_д бул = нет
    если оп.выр != пусто:
        д = в_вычисли(оп.выр, к.ктх)
        есть_д = да
        если в_есть_сим(оп.выр):
            иск_ош("метку нельзя складывать с регистром в адресе", к.строка, к.столб)
    нужен_шиб := (база & 7) == 4 или инд >= 0
    мод := 0 как без64
    дисп := 0 как цел64
    др := 0 как без64
    если не есть_д:
        если (база & 7) == 5:
            # rbp/r13 без смещения недоступны
            мод = 1
            др = 1
        иначе:
            мод = 0
    а если д >= -128 и д <= 127:
        мод = 1
        дисп = д
        др = 1
    иначе:
        мод = 2
        дисп = д
        др = 4
    если нужен_шиб:
        буф_сим(хвост, ((мод << 6) | (регf << 3) | 4) как без8)
        иб := 4 как без64
        если инд >= 0:
            иб = инд как без64
        буф_сим(хвост, _шиб(оп.масш, иб, база как без64))
    иначе:
        буф_сим(хвост, ((мод << 6) | (регf << 3) | (база & 7)) как без8)
    если др > 0:
        _имм(хвост, дисп, др)
    x := 0 как без64
    если инд >= 0:
        x = ((инд >> 3) & 1) как без64
    верни x | (((база >> 3) & 1) << 8) как без64

функ _разм_оп(опы *Список, строка без64) без64:
    # размер операции по операндам
    для i в 0..опы.длина:
        о := список_получи(опы, i) как *Опер
        если о.вид == О_РЕГ:
            верни о.разм
        если о.вид == О_ПАМ и о.разм != 0:
            верни о.разм
    иск_ош("не удаётся определить размер — укажите БАЙТ/СЛОВО/ДВСЛОВО/КВАД",
           строка, 0)
    верни 0

функ _рекс8(оп *Опер) бул:
    # нужен ли REX для 8-битного регистра (spl/bpl/sil/dil/r8b+)
    верни оп.вид == О_РЕГ и оп.разм == 1 и оп.рекс

функ _финиш(к *Код, ин *Узел, пр66 бул, рекс цел64,
            опкод стр, хвост *Буфер, имм *Буфер) *Буфер:
    # собирает инструкцию и заполняет RIP-относительные смещения
    вых *Буфер = буф_новый()
    если пр66:
        буф_сим(вых, 0x66)
    если рекс >= 0:
        буф_сим(вых, рекс как без8)
    буф_добавь(вых, опкод)
    база := вых.длина
    буф_место(вых, хвост.длина)
    скопируй(вых.данные + вых.длина, хвост.данные, хвост.длина)
    вых.длина += хвост.длина
    если имм != пусто:
        буф_место(вых, имм.длина)
        скопируй(вых.данные + вых.длина, имм.данные, имм.длина)
        вых.длина += имм.длина
    для i в 0..к.патчи.длина:
        п := список_получи(к.патчи, i) как *Патч
        цель := в_вычисли(п.выр, к.ктх)
        дисп := цель - (к.ктх.ва как цел64) - (вых.длина как цел64)
        _диап(дисп, 32, да, ин.строка)
        буф_уст32(вых, база + п.поз, дисп как без64)
    верни вых

функ _рм_рег(к *Код, ин *Узел, опкод стр, рм *Опер, рег *Опер,
             имм *Буфер) *Буфер:
    # форма «r/m, reg» или «reg, r/m» (opcode /r)
    хвост *Буфер = буф_новый()
    xb := _рм(к, хвост, рм, рег.ном & 7)
    разм := рег.разм
    w := 0 как без64
    если разм == 8:
        w = 1
    рекс := _рекс(w, рег.ном >> 3, xb & 0xFF, xb >> 8,
                  _рекс8(рм) или _рекс8(рег))
    верни _финиш(к, ин, разм == 2, рекс, опкод, хвост, имм)

функ _пустой() *Буфер:
    верни буф_новый()

# --- формы инструкций ---------------------------------------------------------

функ _к_биноп(к *Код, ин *Узел, код цел64) *Буфер:
    # бинарные арифметико-логические (add..cmp)
    а := список_получи(ин.дети, 0) как *Опер
    б := список_получи(ин.дети, 1) как *Опер
    если а.вид == О_РЕГ и (б.вид == О_РЕГ или б.вид == О_ПАМ):
        если б.вид == О_РЕГ и а.разм != б.разм:
            иск_ош("размеры регистров не совпадают", ин.строка, ин.столб)
        opc := код * 8 + 2
        если а.разм == 1:
            opc = код * 8 + 2
        иначе:
            opc = код * 8 + 3
        верни _рм_рег(к, ин, _байт1(opc), б, а, пусто как *Буфер)
    если а.вид == О_ПАМ и б.вид == О_РЕГ:
        разм := б.разм
        если а.разм != 0 и а.разм != разм:
            иск_ош("размер памяти не совпадает с регистром", ин.строка, ин.столб)
        opc = код * 8
        если разм != 1:
            opc = код * 8 + 1
        верни _рм_рег(к, ин, _байт1(opc), а, б, пусто как *Буфер)
    если (а.вид == О_РЕГ или а.вид == О_ПАМ) и б.вид == О_ИММ:
        разм = а.разм
        если а.вид == О_ПАМ:
            разм = _разм_оп(ин.дети, ин.строка)
        v := в_вычисли(б.выр, к.ктх)
        opc = 0 как цел64
        им *Буфер = буф_новый()
        если разм == 1:
            _диап(v, 8, да, ин.строка)
            opc = 0x80
            _имм(им, v, 1)
        иначе:
            _диап(v, 32, да, ин.строка)
            opc = 0x81
            _имм(им, v, 4)
        хвост *Буфер = буф_новый()
        xb := _рм(к, хвост, а, код как без64)
        w := 0 как без64
        если разм == 8:
            w = 1
        рекс := _рекс(w, 0, xb & 0xFF, xb >> 8, _рекс8(а))
        верни _финиш(к, ин, разм == 2, рекс, _байт1(opc), хвост, им)
    иск_ош("недопустимое сочетание операндов", ин.строка, ин.столб)
    верни пусто как *Буфер

функ _байт1(v цел64) стр:
    # один байт опкода как строка-байт
    б *Буфер = буф_новый()
    буф_сим(б, v как без8)
    верни буф_стр(б)

функ _байт2(v1 цел64, v2 цел64) стр:
    б *Буфер = буф_новый()
    буф_сим(б, v1 как без8)
    буф_сим(б, v2 как без8)
    верни буф_стр(б)

функ _к_пер(к *Код, ин *Узел) *Буфер:
    # ПЕР (mov)
    а := список_получи(ин.дети, 0) как *Опер
    б := список_получи(ин.дети, 1) как *Опер
    если а.вид == О_РЕГ и (б.вид == О_РЕГ или б.вид == О_ПАМ):
        если б.вид == О_РЕГ и а.разм != б.разм:
            иск_ош("размеры регистров не совпадают", ин.строка, ин.столб)
        opc := 0x8A
        если а.разм != 1:
            opc = 0x8B
        верни _рм_рег(к, ин, _байт1(opc), б, а, пусто как *Буфер)
    если а.вид == О_ПАМ и б.вид == О_РЕГ:
        opc = 0x88
        если б.разм != 1:
            opc = 0x89
        верни _рм_рег(к, ин, _байт1(opc), а, б, пусто как *Буфер)
    если а.вид == О_РЕГ и б.вид == О_ИММ:
        # решение о кодировке — по типу выражения (символ?), значение
        # вычисляется всегда: на первом проходе символы дают 0
        сим := в_есть_сим(б.выр)
        v := в_вычисли(б.выр, к.ктх)
        если а.разм == 1:
            _гибк(v, 8, ин.строка)
            им *Буфер = буф_новый()
            _имм(им, v, 1)
            рекс := _рекс(0, 0, 0, а.ном >> 3, _рекс8(а))
            верни _финиш(к, ин, нет, рекс, _байт1(0xB0 + (а.ном & 7) как цел64),
                         _пустой(), им)
        если (а.разм == 8 и (сим или в_большое(б.выр) или
             не (v >= -0x80000000 и v <= 0x7FFFFFFF))):
            # полное 64-битное значение: B8+r с imm64
            им = буф_новый()
            _имм(им, v, 8)
            рекс = _рекс(1, 0, 0, а.ном >> 3, нет)
            верни _финиш(к, ин, нет, рекс, _байт1(0xB8 + (а.ном & 7) как цел64),
                         _пустой(), им)
        # 16/32 бита или знакорасширяемое imm32: C7 /0
        если а.разм == 2:
            _гибк(v, 16, ин.строка)
        а если а.разм == 4:
            _гибк(v, 32, ин.строка)
        иначе:
            _диап(v, 32, да, ин.строка)
        хвост *Буфер = буф_новый()
        xb := _рм(к, хвост, а, 0)
        w := 0 как без64
        если а.разм == 8:
            w = 1
        рекс = _рекс(w, 0, xb & 0xFF, xb >> 8, нет)
        им = буф_новый()
        если а.разм == 2:
            _имм(им, v, 2)
        иначе:
            _имм(им, v, 4)
        верни _финиш(к, ин, а.разм == 2, рекс, _байт1(0xC7), хвост, им)
    если а.вид == О_ПАМ и б.вид == О_ИММ:
        разм := _разм_оп(ин.дети, ин.строка)
        v = в_вычисли(б.выр, к.ктх)
        если разм == 8:
            _диап(v, 32, да, ин.строка)   # imm32 знакорасширяется
        иначе:
            бв := разм * 8
            если разм == 1:
                бв = 8
            _гибк(v, бв, ин.строка)
        хвост = буф_новый()
        xb = _рм(к, хвост, а, 0)
        w = 0 как без64
        если разм == 8:
            w = 1
        рекс = _рекс(w, 0, xb & 0xFF, xb >> 8, нет)
        opc = 0xC6
        если разм != 1:
            opc = 0xC7
        им = буф_новый()
        если разм == 1:
            _имм(им, v, 1)
        а если разм == 2:
            _имм(им, v, 2)
        иначе:
            _имм(им, v, 4)
        верни _финиш(к, ин, разм == 2, рекс, _байт1(opc), хвост, им)
    иск_ош("ПЕР: недопустимое сочетание операндов", ин.строка, ин.столб)
    верни пусто как *Буфер

функ _к_унар(к *Код, ин *Узел, код цел64) *Буфер:
    # унарные инструкции группы F7/F6 (НЕ, ОТР, ДЕЛ и др.)
    а := список_получи(ин.дети, 0) как *Опер
    если а.вид != О_РЕГ и а.вид != О_ПАМ:
        иск_ош("ожидался регистр или память", ин.строка, ин.столб)
    разм := а.разм
    если а.вид == О_ПАМ:
        разм = _разм_оп(ин.дети, ин.строка)
    opc := 0xF6
    если разм != 1:
        opc = 0xF7
    хвост *Буфер = буф_новый()
    xb := _рм(к, хвост, а, код как без64)
    w := 0 как без64
    если разм == 8:
        w = 1
    рекс := _рекс(w, 0, xb & 0xFF, xb >> 8, _рекс8(а))
    верни _финиш(к, ин, разм == 2, рекс, _байт1(opc), хвост,
                 пусто как *Буфер)

функ _к_умн(к *Код, ин *Узел) *Буфер:
    # УМН (imul): 1, 2 или 3 операнда
    n := ин.дети.длина
    если n == 1:
        верни _к_унар(к, ин, 5)
    если n == 2:
        а := список_получи(ин.дети, 0) как *Опер
        б := список_получи(ин.дети, 1) как *Опер
        если а.вид == О_РЕГ и (б.вид == О_РЕГ или б.вид == О_ПАМ):
            хвост *Буфер = буф_новый()
            xb := _рм(к, хвост, б, а.ном & 7)
            w := 0 как без64
            если а.разм == 8:
                w = 1
            рекс := _рекс(w, а.ном >> 3, xb & 0xFF, xb >> 8, нет)
            верни _финиш(к, ин, а.разм == 2, рекс, _байт2(0x0F, 0xAF), хвост,
                         пусто как *Буфер)
    если n == 3:
        а = список_получи(ин.дети, 0) как *Опер
        б = список_получи(ин.дети, 1) как *Опер
        в := список_получи(ин.дети, 2) как *Опер
        если (а.вид == О_РЕГ и (б.вид == О_РЕГ или б.вид == О_ПАМ) и
              в.вид == О_ИММ):
            v := в_вычисли(в.выр, к.ктх)
            _диап(v, 32, да, ин.строка)
            хвост = буф_новый()
            xb = _рм(к, хвост, б, а.ном & 7)
            w = 0 как без64
            если а.разм == 8:
                w = 1
            рекс = _рекс(w, а.ном >> 3, xb & 0xFF, xb >> 8, нет)
            им *Буфер = буф_новый()
            если а.разм == 2:
                _имм(им, v, 2)
            иначе:
                _имм(им, v, 4)
            верни _финиш(к, ин, а.разм == 2, рекс, _байт1(0x69), хвост, им)
    иск_ош("УМН: недопустимое сочетание операндов", ин.строка, ин.столб)
    верни пусто как *Буфер

функ _к_сдвиг(к *Код, ин *Узел, код цел64) *Буфер:
    # сдвиги: по числу или по СЧТБ (cl)
    а := список_получи(ин.дети, 0) как *Опер
    б := список_получи(ин.дети, 1) как *Опер
    если а.вид != О_РЕГ и а.вид != О_ПАМ:
        иск_ош("первый операнд — регистр или память", ин.строка, ин.столб)
    разм := а.разм
    если а.вид == О_ПАМ:
        разм = _разм_оп(ин.дети, ин.строка)
    хвост *Буфер = буф_новый()
    xb := _рм(к, хвост, а, код как без64)
    w := 0 как без64
    если разм == 8:
        w = 1
    рекс := _рекс(w, 0, xb & 0xFF, xb >> 8, _рекс8(а))
    если б.вид == О_ИММ:
        v := в_вычисли(б.выр, к.ктх)
        _диап(v, 8, нет, ин.строка)
        opc := 0xC0
        если разм != 1:
            opc = 0xC1
        им *Буфер = буф_новый()
        _имм(им, v, 1)
        верни _финиш(к, ин, разм == 2, рекс, _байт1(opc), хвост, им)
    если б.вид == О_РЕГ и б.ном == 1 и б.разм == 1:
        # cl / СЧТБ
        opc = 0xD2
        если разм != 1:
            opc = 0xD3
        верни _финиш(к, ин, разм == 2, рекс, _байт1(opc), хвост,
                     пусто как *Буфер)
    иск_ош("счётчик — число или СЧТБ (cl)", ин.строка, ин.столб)
    верни пусто как *Буфер

функ _к_увум(к *Код, ин *Узел, код цел64) *Буфер:
    # УВЕЛ (inc, /0) и УМЕН (dec, /1)
    а := список_получи(ин.дети, 0) как *Опер
    если а.вид != О_РЕГ и а.вид != О_ПАМ:
        иск_ош("ожидался регистр или память", ин.строка, ин.столб)
    разм := а.разм
    если а.вид == О_ПАМ:
        разм = _разм_оп(ин.дети, ин.строка)
    opc := 0xFE
    если разм != 1:
        opc = 0xFF
    хвост *Буфер = буф_новый()
    xb := _рм(к, хвост, а, код как без64)
    w := 0 как без64
    если разм == 8:
        w = 1
    рекс := _рекс(w, 0, xb & 0xFF, xb >> 8, _рекс8(а))
    верни _финиш(к, ин, разм == 2, рекс, _байт1(opc), хвост,
                 пусто как *Буфер)

функ _к_встек(к *Код, ин *Узел) *Буфер:
    # ВСТЕК (push): регистр, память или число
    а := список_получи(ин.дети, 0) как *Опер
    если а.вид == О_РЕГ:
        если а.разм == 2:
            верни _финиш(к, ин, да, _рекс(0, 0, 0, а.ном >> 3, нет),
                         _байт1(0x50 + (а.ном & 7) как цел64), _пустой(),
                         пусто как *Буфер)
        если а.разм != 8:
            иск_ош("ВСТЕК: регистр должен быть 16- или 64-битным", ин.строка, ин.столб)
        верни _финиш(к, ин, нет, _рекс(0, 0, 0, а.ном >> 3, нет),
                     _байт1(0x50 + (а.ном & 7) как цел64), _пустой(),
                     пусто как *Буфер)
    если а.вид == О_ПАМ:
        хвост *Буфер = буф_новый()
        xb := _рм(к, хвост, а, 6)
        верни _финиш(к, ин, нет, _рекс(0, 0, xb & 0xFF, xb >> 8, нет),
                     _байт1(0xFF), хвост, пусто как *Буфер)
    если а.вид == О_ИММ:
        v := в_вычисли(а.выр, к.ктх)
        _диап(v, 32, да, ин.строка)
        им *Буфер = буф_новый()
        _имм(им, v, 4)
        верни _финиш(к, ин, нет, -1, _байт1(0x68), _пустой(), им)
    иск_ош("ВСТЕК: недопустимый операнд", ин.строка, ин.столб)
    верни пусто как *Буфер

функ _к_изстека(к *Код, ин *Узел) *Буфер:
    # ИЗСТЕКА (pop): регистр или память
    а := список_получи(ин.дети, 0) как *Опер
    если а.вид == О_РЕГ:
        если а.разм != 2 и а.разм != 8:
            иск_ош("ИЗСТЕКА: регистр должен быть 16- или 64-битным", ин.строка, ин.столб)
        верни _финиш(к, ин, а.разм == 2, _рекс(0, 0, 0, а.ном >> 3, нет),
                     _байт1(0x58 + (а.ном & 7) как цел64), _пустой(),
                     пусто как *Буфер)
    если а.вид == О_ПАМ:
        хвост *Буфер = буф_новый()
        xb := _рм(к, хвост, а, 0)
        верни _финиш(к, ин, нет, _рекс(0, 0, xb & 0xFF, xb >> 8, нет),
                     _байт1(0x8F), хвост, пусто как *Буфер)
    иск_ош("ИЗСТЕКА: недопустимый операнд", ин.строка, ин.столб)
    верни пусто как *Буфер

функ _к_вызов(к *Код, ин *Узел) *Буфер:
    # ВЫЗОВ (call): метка, импорт, регистр или память
    а := список_получи(ин.дети, 0) как *Опер
    если а.вид == О_ИММ:
        если а.выр.вид == В_СИМ и к_импорт(к.ктх, а.выр.текст):
            # вызов импортированной функции: call [rip + IAT]
            хвост *Буфер = буф_новый()
            буф_сим(хвост, (2 << 3 | 0x05) как без8)
            ив := узел(В_ИАТ, ин.строка)
            ив.текст = а.выр.текст
            _рип_патч(к, хвост, ив)
            верни _финиш(к, ин, нет, -1, _байт1(0xFF), хвост,
                         пусто как *Буфер)
        хвост = буф_новый()
        _рип_патч(к, хвост, а.выр)
        верни _финиш(к, ин, нет, -1, _байт1(0xE8), хвост, пусто как *Буфер)
    если а.вид == О_РЕГ или а.вид == О_ПАМ:
        хвост = буф_новый()
        xb := _рм(к, хвост, а, 2)
        верни _финиш(к, ин, нет, _рекс(0, 0, xb & 0xFF, xb >> 8, нет),
                     _байт1(0xFF), хвост, пусто как *Буфер)
    иск_ош("ВЫЗОВ: недопустимый операнд", ин.строка, ин.столб)
    верни пусто как *Буфер

функ _к_прыг(к *Код, ин *Узел) *Буфер:
    # ПРЫГ (jmp): метка, регистр или память
    а := список_получи(ин.дети, 0) как *Опер
    если а.вид == О_ИММ:
        хвост *Буфер = буф_новый()
        _рип_патч(к, хвост, а.выр)
        верни _финиш(к, ин, нет, -1, _байт1(0xE9), хвост, пусто как *Буфер)
    если а.вид == О_РЕГ или а.вид == О_ПАМ:
        хвост = буф_новый()
        xb := _рм(к, хвост, а, 4)
        верни _финиш(к, ин, нет, _рекс(0, 0, xb & 0xFF, xb >> 8, нет),
                     _байт1(0xFF), хвост, пусто как *Буфер)
    иск_ош("ПРЫГ: недопустимый операнд", ин.строка, ин.столб)
    верни пусто как *Буфер

функ _к_усл(к *Код, ин *Узел, усл цел64) *Буфер:
    # условный переход (0F 8x rel32)
    а := список_получи(ин.дети, 0) как *Опер
    если а.вид != О_ИММ:
        иск_ош("ожидалась метка", ин.строка, ин.столб)
    хвост *Буфер = буф_новый()
    _рип_патч(к, хвост, а.выр)
    верни _финиш(к, ин, нет, -1, _байт2(0x0F, 0x80 + усл), хвост,
                 пусто как *Буфер)

функ _к_возврат(к *Код, ин *Узел) *Буфер:
    # ВОЗВРАТ (ret), с необязательным числом байт стека
    вых *Буфер = буф_новый()
    если ин.дети.длина == 0:
        буф_сим(вых, 0xC3)
        верни вых
    а := список_получи(ин.дети, 0) как *Опер
    если а.вид != О_ИММ:
        иск_ош("ВОЗВРАТ: ожидалось число", ин.строка, ин.столб)
    v := в_вычисли(а.выр, к.ктх)
    _диап(v, 16, нет, ин.строка)
    буф_сим(вых, 0xC2)
    _имм(вых, v, 2)
    верни вых

функ _к_адр(к *Код, ин *Узел) *Буфер:
    # АДР (lea): регистр <- адрес памяти
    а := список_получи(ин.дети, 0) как *Опер
    б := список_получи(ин.дети, 1) как *Опер
    если а.вид != О_РЕГ или б.вид != О_ПАМ:
        иск_ош("АДР: ожидалось «регистр, [адрес]»", ин.строка, ин.столб)
    верни _рм_рег(к, ин, _байт1(0x8D), б, а, пусто как *Буфер)

функ _к_обмен(к *Код, ин *Узел) *Буфер:
    # ОБМЕН (xchg)
    а := список_получи(ин.дети, 0) как *Опер
    б := список_получи(ин.дети, 1) как *Опер
    если а.вид == О_РЕГ и (б.вид == О_РЕГ или б.вид == О_ПАМ):
        если б.вид == О_РЕГ и а.разм != б.разм:
            иск_ош("размеры регистров не совпадают", ин.строка, ин.столб)
        opc := 0x86
        если а.разм != 1:
            opc = 0x87
        верни _рм_рег(к, ин, _байт1(opc), б, а, пусто как *Буфер)
    если а.вид == О_ПАМ и б.вид == О_РЕГ:
        opc = 0x86
        если б.разм != 1:
            opc = 0x87
        верни _рм_рег(к, ин, _байт1(opc), а, б, пусто как *Буфер)
    иск_ош("ОБМЕН: недопустимое сочетание операндов", ин.строка, ин.столб)
    верни пусто как *Буфер

функ _к_пров(к *Код, ин *Узел) *Буфер:
    # ПРОВ (test)
    а := список_получи(ин.дети, 0) как *Опер
    б := список_получи(ин.дети, 1) как *Опер
    если (а.вид == О_РЕГ или а.вид == О_ПАМ) и б.вид == О_РЕГ:
        opc := 0x84
        если б.разм != 1:
            opc = 0x85
        верни _рм_рег(к, ин, _байт1(opc), а, б, пусто как *Буфер)
    если (а.вид == О_РЕГ или а.вид == О_ПАМ) и б.вид == О_ИММ:
        разм := а.разм
        если а.вид == О_ПАМ:
            разм = _разм_оп(ин.дети, ин.строка)
        v := в_вычисли(б.выр, к.ктх)
        бв := 32 как без64
        если разм == 1:
            бв = 8
        _диап(v, бв, да, ин.строка)
        хвост *Буфер = буф_новый()
        xb := _рм(к, хвост, а, 0)
        w := 0 как без64
        если разм == 8:
            w = 1
        рекс := _рекс(w, 0, xb & 0xFF, xb >> 8, _рекс8(а))
        opc = 0xF6
        если разм != 1:
            opc = 0xF7
        им *Буфер = буф_новый()
        если разм == 1:
            _имм(им, v, 1)
        а если разм == 2:
            _имм(им, v, 2)
        иначе:
            _имм(им, v, 4)
        верни _финиш(к, ин, разм == 2, рекс, _байт1(opc), хвост, им)
    иск_ош("ПРОВ: недопустимое сочетание операндов", ин.строка, ин.столб)
    верни пусто как *Буфер

функ _к_уст(к *Код, ин *Узел, усл цел64) *Буфер:
    # УСТ<усл> (setcc): байт <- 1 если условие истинно
    а := список_получи(ин.дети, 0) как *Опер
    если а.вид != О_РЕГ и а.вид != О_ПАМ:
        иск_ош("ожидался регистр/байт", ин.строка, ин.столб)
    разм := а.разм
    если а.вид == О_ПАМ:
        разм = _разм_оп(ин.дети, ин.строка)
    если разм != 1:
        иск_ош("операнд должен быть байтом", ин.строка, ин.столб)
    хвост *Буфер = буф_новый()
    xb := _рм(к, хвост, а, 0)
    рекс := _рекс(0, 0, xb & 0xFF, xb >> 8, _рекс8(а))
    верни _финиш(к, ин, нет, рекс, _байт2(0x0F, 0x90 + усл), хвост,
                 пусто как *Буфер)

функ _к_расш(к *Код, ин *Узел, знак бул) *Буфер:
    # ЗНАКРАСШ (movsx) / БЕЗРАСШ (movzx): расширение 8/16 -> 16/32/64
    а := список_получи(ин.дети, 0) как *Опер
    б := список_получи(ин.дети, 1) как *Опер
    если а.вид != О_РЕГ или (б.вид != О_РЕГ и б.вид != О_ПАМ):
        иск_ош("ожидалось «регистр, источник»", ин.строка, ин.столб)
    сразм := б.разм
    если б.вид == О_ПАМ и сразм == 0:
        иск_ош("не удаётся определить размер — укажите БАЙТ/СЛОВО/ДВСЛОВО/КВАД",
               ин.строка, ин.столб)
    opc := 0 как цел64
    если сразм == 1:
        если знак:
            opc = 0xBE
        иначе:
            opc = 0xB6
    а если сразм == 2:
        если знак:
            opc = 0xBF
        иначе:
            opc = 0xB7
    иначе:
        иск_ош("источник — 8 или 16 бит", ин.строка, ин.столб)
    если а.разм <= сразм:
        иск_ош("приёмник должен быть шире источника", ин.строка, ин.столб)
    верни _рм_рег(к, ин, _байт2(0x0F, opc), б, а, пусто как *Буфер)

функ _к_расшд(к *Код, ин *Узел) *Буфер:
    # ЗНАКРАСШД (movsxd): знаковое расширение 32 -> 64
    а := список_получи(ин.дети, 0) как *Опер
    б := список_получи(ин.дети, 1) как *Опер
    если а.вид != О_РЕГ или (б.вид != О_РЕГ и б.вид != О_ПАМ):
        иск_ош("ЗНАКРАСШД: ожидалось «рег64, источник32»", ин.строка, ин.столб)
    сразм := б.разм
    если б.вид == О_ПАМ и сразм == 0:
        иск_ош("не удаётся определить размер — укажите БАЙТ/СЛОВО/ДВСЛОВО/КВАД",
               ин.строка, ин.столб)
    если а.разм != 8 или сразм != 4:
        иск_ош("ЗНАКРАСШД: приёмник 64 бита, источник 32", ин.строка, ин.столб)
    верни _рм_рег(к, ин, _байт1(0x63), б, а, пусто как *Буфер)

