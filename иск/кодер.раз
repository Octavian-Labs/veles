        если ист.разм != 1:
            опкод = 0x85
        верни _рм_рег(сост, инс, _байт1(опкод), приём, ист, пусто как *Буфер)
    если (приём.вид == О_РЕГ или приём.вид == О_ПАМ) и ист.вид == О_ИММ:
        разм размер = приём.разм
        если приём.вид == О_ПАМ:
            разм = _разм_оп(инс.дети, инс.строка)
        знач цел.верх = в_вычисли(ист.выр, сост.ктх)
        разряд размер = 32
        если разм == 1:
            разряд = 8
        _диап(знач, разряд, да, инс.строка)
        хвост *Буфер = буф_новый()
        байт_мр нат.верх = _рм(сост, хвост, приём, 0)
        рекс_w нат.верх = 0
        если разм == 8:
            рекс_w = 1
        рекс цел.верх = _рекс(рекс_w, 0, байт_мр & 0xFF, байт_мр >> 8, _рекс8(приём))
        опкод = 0xF6
        если разм != 1:
            опкод = 0xF7
        имм *Буфер = буф_новый()
        если разм == 1:
            _имм(имм, знач, 1)
        а если разм == 2:
            _имм(имм, знач, 2)
        иначе:
            _имм(имм, знач, 4)
        верни _финиш(сост, инс, разм == 2, рекс, _байт1(опкод), хвост, имм)
    иск_ош("ПРОВ: недопустимое сочетание операндов", инс.строка, инс.столб)
    верни пусто как *Буфер

открыто функ _к_уст(сост *Код, инс *Узел, усл цел.верх) *Буфер:
    # УСТ<усл> (setcc): байт <- 1 если условие истинно
    приём *Опер = список_получи(инс.дети, 0) как *Опер
    если приём.вид != О_РЕГ и приём.вид != О_ПАМ:
        иск_ош("ожидался регистр/байт", инс.строка, инс.столб)
    разм размер = приём.разм
    если приём.вид == О_ПАМ:
        разм = _разм_оп(инс.дети, инс.строка)
    если разм != 1:
        иск_ош("операнд должен быть байтом", инс.строка, инс.столб)
    хвост *Буфер = буф_новый()
    байт_мр нат.верх = _рм(сост, хвост, приём, 0)
    рекс цел.верх = _рекс(0, 0, байт_мр & 0xFF, байт_мр >> 8, _рекс8(приём))
    верни _финиш(сост, инс, нет, рекс, _байт2(0x0F, 0x90 + усл), хвост,
                 пусто как *Буфер)

открыто функ _к_расш(сост *Код, инс *Узел, знак лог) *Буфер:
    # ЗНАКРАСШ (movsx) / БЕЗРАСШ (movzx): расширение 8/16 -> 16/32/64
    приём *Опер = список_получи(инс.дети, 0) как *Опер
    ист *Опер = список_получи(инс.дети, 1) как *Опер
    если приём.вид != О_РЕГ или (ист.вид != О_РЕГ и ист.вид != О_ПАМ):
        иск_ош("ожидалось «регистр, источник»", инс.строка, инс.столб)
    разм_ист размер = ист.разм
    если ист.вид == О_ПАМ и разм_ист == 0:
        иск_ош("не удаётся определить размер — укажите БАЙТ/СЛОВО/ДВСЛОВО/КВАД",
               инс.строка, инс.столб)
    опкод цел.верх = 0
    если разм_ист == 1:
        если знак:
            опкод = 0xBE
        иначе:
            опкод = 0xB6
    а если разм_ист == 2:
        если знак:
            опкод = 0xBF
        иначе:
            опкод = 0xB7
    иначе:
        иск_ош("источник — 8 или 16 бит", инс.строка, инс.столб)
    если приём.разм <= разм_ист:
        иск_ош("приёмник должен быть шире источника", инс.строка, инс.столб)
    верни _рм_рег(сост, инс, _байт2(0x0F, опкод), ист, приём, пусто как *Буфер)

открыто функ _к_расшд(сост *Код, инс *Узел) *Буфер:
    # ЗНАКРАСШД (movsxd): знаковое расширение 32 -> 64
    приём *Опер = список_получи(инс.дети, 0) как *Опер
    ист *Опер = список_получи(инс.дети, 1) как *Опер
    если приём.вид != О_РЕГ или (ист.вид != О_РЕГ и ист.вид != О_ПАМ):
        иск_ош("ЗНАКРАСШД: ожидалось «рег64, источник32»", инс.строка, инс.столб)
    разм_ист размер = ист.разм
    если ист.вид == О_ПАМ и разм_ист == 0:
        иск_ош("не удаётся определить размер — укажите БАЙТ/СЛОВО/ДВСЛОВО/КВАД",
               инс.строка, инс.столб)
    если приём.разм != 8 или разм_ист != 4:
        иск_ош("ЗНАКРАСШД: приёмник 64 бита, источник 32", инс.строка, инс.столб)
    верни _рм_рег(сост, инс, _байт1(0x63), ист, приём, пусто как *Буфер)

