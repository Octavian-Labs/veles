открыто функ кодируй(инс *Узел, ктх *Ктх) *Буфер:
    # кодирует одну инструкцию в байты машинного кода;
    # ктх.ва — адрес инструкции; на «сухом» проходе символы дают 0
    сост *Код = _код_новый(ктх, инс.строка, инс.столб)
    мнем стр = инс.текст
    детей размер = инс.дети.длина
    нул стр = _код_нулев(мнем)
    если нул != пусто:
        если детей != 0:
            иск_ош("операнды не нужны", инс.строка, инс.столб)
        буф *Буфер = буф_новый()
        буф_добавь(буф, нул)
        верни буф
    код цел.верх = _код_биноп(мнем)
    если код >= 0:
        если детей != 2:
            иск_ош("нужно два операнда", инс.строка, инс.столб)
        верни _к_биноп(сост, инс, код)
    если стр_равны_нр(мнем, "ПЕР"):
        если детей != 2:
            иск_ош("ПЕР: нужно два операнда", инс.строка, инс.столб)
        верни _к_пер(сост, инс)
    код = _код_унар(мнем)
    если код >= 0:
        если детей != 1:
            иск_ош("нужен один операнд", инс.строка, инс.столб)
        верни _к_унар(сост, инс, код)
    если стр_равны_нр(мнем, "УМН"):
        верни _к_умн(сост, инс)
    код = _код_сдвиг(мнем)
    если код >= 0:
        если детей != 2:
            иск_ош("нужно два операнда", инс.строка, инс.столб)
        верни _к_сдвиг(сост, инс, код)
    если стр_равны_нр(мнем, "УВЕЛ"):
        если детей != 1:
            иск_ош("УВЕЛ: нужен один операнд", инс.строка, инс.столб)
        верни _к_увум(сост, инс, 0)
    если стр_равны_нр(мнем, "УМЕН"):
        если детей != 1:
            иск_ош("УМЕН: нужен один операнд", инс.строка, инс.столб)
        верни _к_увум(сост, инс, 1)
    если стр_равны_нр(мнем, "ВСТЕК"):
        если детей != 1:
            иск_ош("ВСТЕК: нужен один операнд", инс.строка, инс.столб)
        верни _к_встек(сост, инс)
    если стр_равны_нр(мнем, "ИЗСТЕКА"):
        если детей != 1:
            иск_ош("ИЗСТЕКА: нужен один операнд", инс.строка, инс.столб)
        верни _к_изстека(сост, инс)
    если стр_равны_нр(мнем, "ВЫЗОВ"):
        если детей != 1:
            иск_ош("ВЫЗОВ: нужен один операнд", инс.строка, инс.столб)
        верни _к_вызов(сост, инс)
    если стр_равны_нр(мнем, "ВОЗВРАТ"):
        верни _к_возврат(сост, инс)
    если стр_равны_нр(мнем, "ПРЫГ"):
        если детей != 1:
            иск_ош("ПРЫГ: нужен один операнд", инс.строка, инс.столб)
        верни _к_прыг(сост, инс)
    усл цел.верх = _код_усл(мнем)
    если усл >= 0:
        если детей != 1:
            иск_ош("нужен один операнд (метка)", инс.строка, инс.столб)
        верни _к_усл(сост, инс, усл)
    если стр_равны_нр(мнем, "АДР"):
        если детей != 2:
            иск_ош("АДР: нужно два операнда", инс.строка, инс.столб)
        верни _к_адр(сост, инс)
    если стр_равны_нр(мнем, "ОБМЕН"):
        если детей != 2:
            иск_ош("ОБМЕН: нужно два операнда", инс.строка, инс.столб)
        верни _к_обмен(сост, инс)
    если стр_равны_нр(мнем, "ПРОВ"):
        если детей != 2:
            иск_ош("ПРОВ: нужно два операнда", инс.строка, инс.столб)
        верни _к_пров(сост, инс)
    если мнем.длина > 6 и стр_равны_нр(стр_срез(мнем, 0, 6), "УСТ"):
        усл2 цел.верх = _код_усл(стр_срез(мнем, 6, мнем.длина))
        если усл2 >= 0:
            если детей != 1:
                иск_ош("нужен один операнд", инс.строка, инс.столб)
            верни _к_уст(сост, инс, усл2)
    если стр_равны_нр(мнем, "ЗНАКРАСШ") или стр_равны_нр(мнем, "БЕЗРАСШ"):
        если детей != 2:
            иск_ош("нужно два операнда", инс.строка, инс.столб)
        верни _к_расш(сост, инс, стр_равны_нр(мнем, "ЗНАКРАСШ"))
    если стр_равны_нр(мнем, "ЗНАКРАСШД"):
        если детей != 2:
            иск_ош("ЗНАКРАСШД: нужно два операнда", инс.строка, инс.столб)
        верни _к_расшд(сост, инс)
    иск_ош("неизвестная мнемоника", инс.строка, инс.столб)
    верни пусто как *Буфер
