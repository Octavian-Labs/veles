# кодер — кодировка инструкций x86-64 для ИСКРЫ.
#
# REX-префиксы, ModRM/SIB, RIP-относительная адресация,
# относительные переходы, вызовы импортов через IAT.
# Размер инструкции зависит только от видов операндов —
# двухпроходное ассемблирование корректно.

взять основа
взять узлы
взять выраж
взять парсер       # Опер, О_*, И_*

# --- таблицы мнемоник --------------------------------------------------------

открыто функ _код_биноп(мнем стр) цел.верх:
    # бинарные арифметико-логические: мнемоника -> код группы (-1 = нет)
    если стр_равны_нр(мнем, "ДОБ"):
        верни 0
    если стр_равны_нр(мнем, "ИЛИ"):
        верни 1
    если стр_равны_нр(мнем, "ДОБП"):
        верни 2
    если стр_равны_нр(мнем, "ВЫЧП"):
        верни 3
    если стр_равны_нр(мнем, "И"):
        верни 4
    если стр_равны_нр(мнем, "ВЫЧ"):
        верни 5
    если стр_равны_нр(мнем, "ИИЛИ"):
        верни 6
    если стр_равны_нр(мнем, "СРАВ"):
        верни 7
    верни -1

открыто функ _код_унар(мнем стр) цел.верх:
    # унарные F7/F6: мнемоника -> поле reg в ModRM (-1 = нет)
    если стр_равны_нр(мнем, "НЕ"):
        верни 2
    если стр_равны_нр(мнем, "ОТР"):
        верни 3
    если стр_равны_нр(мнем, "УМНБ"):
        верни 4
    если стр_равны_нр(мнем, "ДЕЛБ"):
        верни 6
    если стр_равны_нр(мнем, "ДЕЛ"):
        верни 7
    верни -1

открыто функ _код_сдвиг(мнем стр) цел.верх:
    # сдвиги и циклические: мнемоника -> поле reg (-1 = нет)
    если стр_равны_нр(мнем, "ВРЛ"):
        верни 0
    если стр_равны_нр(мнем, "ВРП"):
        верни 1
    если стр_равны_нр(мнем, "СДЛ"):
        верни 4
    если стр_равны_нр(мнем, "СДП"):
        верни 5
    если стр_равны_нр(мнем, "СДПА"):
        верни 7
    верни -1

открыто функ _код_усл(мнем стр) цел.верх:
    # условные переходы/УСТ: мнемоника -> код условия (-1 = нет)
    если стр_равны_нр(мнем, "ПЕРЕПОЛН"):
        верни 0
    если стр_равны_нр(мнем, "НЕПЕРЕПОЛН"):
        верни 1
    если стр_равны_нр(мнем, "НИЖЕ") или стр_равны_нр(мнем, "ПЕРЕНОС"):
        верни 2
    если (стр_равны_нр(мнем, "НЕНИЖЕ") или стр_равны_нр(мнем, "ВЫШРАВ") или
          стр_равны_нр(мнем, "НЕПЕРЕНОС")):
        верни 3
    если стр_равны_нр(мнем, "РАВНО") или стр_равны_нр(мнем, "НОЛЬ"):
        верни 4
    если стр_равны_нр(мнем, "НЕРАВНО") или стр_равны_нр(мнем, "НЕНОЛЬ"):
        верни 5
    если стр_равны_нр(мнем, "НИЖРАВ") или стр_равны_нр(мнем, "НЕВЫШЕ"):
        верни 6
    если стр_равны_нр(мнем, "ВЫШЕ") или стр_равны_нр(мнем, "НЕНИЖРАВ"):
        верни 7
    если стр_равны_нр(мнем, "ЗНАК"):
        верни 8
    если стр_равны_нр(мнем, "НЕЗНАК"):
        верни 9
    если стр_равны_нр(мнем, "ЧЁТ") или стр_равны_нр(мнем, "ЧЕТ"):
        верни 0xA
    если стр_равны_нр(мнем, "НЕЧЁТ") или стр_равны_нр(мнем, "НЕЧЕТ"):
        верни 0xB
    если стр_равны_нр(мнем, "МЕНЬШЕ"):
        верни 0xC
    если стр_равны_нр(мнем, "БОЛРАВ") или стр_равны_нр(мнем, "НЕМЕНЬШЕ"):
        верни 0xD
    если стр_равны_нр(мнем, "МЕНРАВ") или стр_равны_нр(мнем, "НЕБОЛЬШЕ"):
        верни 0xE
    если стр_равны_нр(мнем, "БОЛЬШЕ") или стр_равны_нр(мнем, "НЕМЕНРАВ"):
        верни 0xF
    верни -1

открыто функ _код_нулев(мнем стр) стр:
    # инструкции без операндов: мнемоника -> байты (пусто = нет)
    если стр_равны_нр(мнем, "НОП"):
        верни _байт1(0x90)
    если стр_равны_нр(мнем, "СТОП"):
        верни _байт1(0xF4)
    если стр_равны_нр(мнем, "ПРЕРЫВ"):
        верни _байт1(0xCC)
    если стр_равны_нр(мнем, "СИСВЫЗОВ"):
        верни _байт2(0x0F, 0x05)
    если стр_равны_нр(мнем, "ПОКИНЬ"):
        верни _байт1(0xC9)
    если стр_равны_нр(мнем, "РАСШ"):
        верни _байт2(0x48, 0x99)
    если стр_равны_нр(мнем, "РАСШД"):
        верни _байт1(0x99)
    верни пусто как стр

# --- помощники кодирования ---------------------------------------------------

открыто функ _диап(знач цел.верх, бит размер, знак лог, строка размер):
    # проверяет, что значение помещается в заданную разрядность
    если бит >= 64:
        верни                     # любое цел.верх помещается в 64 бита
    если знак:
        если (знач < 0 - ((1 как цел.верх) << (бит - 1)) или
              знач > ((1 как цел.верх) << (бит - 1)) - 1):
            иск_ош("значение не помещается в разрядность", строка, 0)
    иначе:
        если знач < 0 или (знач как нат.верх) > ((1 как нат.верх) << бит) - 1:
            иск_ош("значение не помещается в разрядность", строка, 0)

открыто функ _гибк(знач цел.верх, бит размер, строка размер):
    # гибкая проверка: знаковое или беззнаковое (сравнение знаковое —
    # отрицательные v не превращаем в огромные нат.верх)
    если бит >= 64:
        верни
    если (знач < 0 - ((1 как цел.верх) << (бит - 1)) или
          знач > ((1 как цел.верх) << бит) - 1):
        иск_ош("значение не помещается в разрядность", строка, 0)

открыто функ _имм(буф *Буфер, знач цел.верх, дл размер):
    # непосредственное значение little-endian (по модулю 2^(8n))
    беззн нат.верх = знач как нат.верх
    если дл == 1:
        буф_сим(буф, беззн как нат.старт)
    а если дл == 2:
        буф_п16(буф, беззн)
    а если дл == 4:
        буф_п32(буф, беззн)
    иначе:
        буф_п64(буф, беззн)

открыто функ _рекс(w нат.верх, r нат.верх, x нат.верх, б нат.верх, форс лог) цел.верх:
    # байт REX-префикса; -1 — префикс не нужен
    # биты REX: W R X B
    байт нат.верх = (0x40 | (w << 3) | (r << 2) | (x << 1) | б) как нат.верх
    если байт == 0x40 и не форс:
        верни -1
    верни байт как цел.верх

открыто функ _сиб(масш размер, инд размер, база размер) нат.старт:
    # байт SIB
    код нат.верх = 0
    если масш == 2:
        код = 1
    а если масш == 4:
        код = 2
    а если масш == 8:
        код = 3
    верни ((код << 6) | ((инд & 7) << 3) | (база & 7)) как нат.старт

# --- состояние кодирования одной инструкции ----------------------------------

открыто запись Патч:
    поз размер           # позиция в хвосте для disp32 (RIP-относит.)
    выр *Узел           # выражение цели

открыто запись Код:
    ктх *Ктх
    строка размер
    столб размер
    патчи *Список       # *Патч

открыто функ _код_новый(ктх *Ктх, строка размер, столб размер) *Код:
    сост *Код = новый(Код)
    сост.ктх = ктх
    сост.строка = строка
    сост.столб = столб
    сост.патчи = список_новый()
    верни сост

открыто функ _рип_патч(сост *Код, хвост *Буфер, выр *Узел):
    # запоминает место disp32 для RIP-относительной адресации
    патч *Патч = новый(Патч)
    патч.поз = хвост.длина
    патч.выр = выр
    список_добавь(сост.патчи, патч как размер)
    буф_нуль(хвост, 4)

открыто функ _рм(сост *Код, хвост *Буфер, опер *Опер, поле размер) нат.верх:
    # кодирует операнд r/m (регистр или память) в хвост;
    # возвращает rex_x | rex_b<<8 — расширенные биты REX для ModRM/SIB
    если опер.вид == О_РЕГ:
        буф_сим(хвост, (0xC0 | (поле << 3) | (опер.ном & 7)) как нат.старт)
        верни ((опер.ном >> 3) & 1) << 8
    # память
    если опер.инд != пусто и (опер.инд.ном & 7) == 4:
        иск_ош("УКС/rsp/r12 не может быть индексным регистром", сост.строка, сост.столб)
    база смещение = -1
    инд смещение = -1
    если опер.база != пусто:
        база = опер.база.ном как цел.верх
    если опер.инд != пусто:
        инд = опер.инд.ном как цел.верх
    если база < 0 и инд < 0:
        # RIP-относительная: [метка] — только смещение с символом
        если опер.выр != пусто и в_есть_сим(опер.выр):
            буф_сим(хвост, ((поле << 3) | 0x05) как нат.старт)
            _рип_патч(сост, хвост, опер.выр)
            верни 0
        смещ смещение = 0
        если опер.выр != пусто:
            смещ = в_вычисли(опер.выр, сост.ктх)
        буф_сим(хвост, ((поле << 3) | 0x04) как нат.старт)
        буф_сим(хвост, _сиб(1, 4, 5))
        _имм(хвост, смещ, 4)
        верни 0
    если база < 0:
        # [индекс*масштаб + disp32]
        смещ = 0 как смещение
        если опер.выр != пусто:
            смещ = в_вычисли(опер.выр, сост.ктх)
        буф_сим(хвост, ((поле << 3) | 0x04) как нат.старт)
        буф_сим(хвост, _сиб(опер.масш, инд как размер, 5))
        _имм(хвост, смещ, 4)
        верни ((инд >> 3) & 1) как нат.верх
    # есть базовый регистр
    смещ = 0 как смещение
    есть_смещ лог = нет
    если опер.выр != пусто:
        смещ = в_вычисли(опер.выр, сост.ктх)
        есть_смещ = да
        если в_есть_сим(опер.выр):
            иск_ош("метку нельзя складывать с регистром в адресе", сост.строка, сост.столб)
    нужен_сиб лог = (база & 7) == 4 или инд >= 0
    мод размер = 0
    дисп смещение = 0
    дл_смещ размер = 0
    если не есть_смещ:
        если (база & 7) == 5:
            # rbp/r13 без смещения недоступны
            мод = 1
            дл_смещ = 1
        иначе:
            мод = 0
    а если смещ >= -128 и смещ <= 127:
        мод = 1
        дисп = смещ
        дл_смещ = 1
    иначе:
        мод = 2
        дисп = смещ
        дл_смещ = 4
    если нужен_сиб:
        буф_сим(хвост, ((мод << 6) | (поле << 3) | 4) как нат.старт)
        индб размер = 4
        если инд >= 0:
            индб = инд как размер
        буф_сим(хвост, _сиб(опер.масш, индб, база как размер))
    иначе:
        буф_сим(хвост, ((мод << 6) | (поле << 3) | (база & 7)) как нат.старт)
    если дл_смещ > 0:
        _имм(хвост, дисп, дл_смещ)
    рекс_x размер = 0
    если инд >= 0:
        рекс_x = ((инд >> 3) & 1) как нат.верх
    верни рекс_x | (((база >> 3) & 1) << 8) как нат.верх

открыто функ _разм_оп(опы *Список, строка размер) размер:
    # размер операции по операндам
    для инд в 0..опы.длина:
        опер *Опер = список_получи(опы, инд) как *Опер
        если опер.вид == О_РЕГ:
            верни опер.разм
        если опер.вид == О_ПАМ и опер.разм != 0:
            верни опер.разм
    иск_ош("не удаётся определить размер — укажите БАЙТ/СЛОВО/ДВСЛОВО/КВАД",
           строка, 0)
    верни 0

открыто функ _рекс8(опер *Опер) лог:
    # нужен ли REX для 8-битного регистра (spl/bpl/sil/dil/r8b+)
    верни опер.вид == О_РЕГ и опер.разм == 1 и опер.рекс

открыто функ _финиш(сост *Код, инс *Узел, преф66 лог, рекс цел.верх,
            опкод стр, хвост *Буфер, имм *Буфер) *Буфер:
    # собирает инструкцию и заполняет RIP-относительные смещения
    вых *Буфер = буф_новый()
    если преф66:
        буф_сим(вых, 0x66)
    если рекс >= 0:
        буф_сим(вых, рекс как нат.старт)
    буф_добавь(вых, опкод)
    база размер = вых.длина
    буф_место(вых, хвост.длина)
    скопируй(вых.данные + вых.длина, хвост.данные, хвост.длина)
    вых.длина += хвост.длина
    если имм != пусто:
        буф_место(вых, имм.длина)
        скопируй(вых.данные + вых.длина, имм.данные, имм.длина)
        вых.длина += имм.длина
    для инд в 0..сост.патчи.длина:
        патч *Патч = список_получи(сост.патчи, инд) как *Патч
        цель цел.верх = в_вычисли(патч.выр, сост.ктх)
        дисп смещение = цель - (сост.ктх.ва как цел.верх) - (вых.длина как цел.верх)
        _диап(дисп, 32, да, инс.строка)
        буф_уст32(вых, база + патч.поз, дисп как нат.верх)
    верни вых

открыто функ _рм_рег(сост *Код, инс *Узел, опкод стр, рм *Опер, рег *Опер,
             имм *Буфер) *Буфер:
    # форма «r/m, reg» или «reg, r/m» (opcode /r)
    хвост *Буфер = буф_новый()
    байт_мр нат.верх = _рм(сост, хвост, рм, рег.ном & 7)
    разм размер = рег.разм
    рекс_w нат.верх = 0
    если разм == 8:
        рекс_w = 1
    рекс цел.верх = _рекс(рекс_w, рег.ном >> 3, байт_мр & 0xFF, байт_мр >> 8,
                          _рекс8(рм) или _рекс8(рег))
    верни _финиш(сост, инс, разм == 2, рекс, опкод, хвост, имм)

открыто функ _пустой() *Буфер:
    верни буф_новый()

# --- формы инструкций ---------------------------------------------------------

открыто функ _к_биноп(сост *Код, инс *Узел, код цел.верх) *Буфер:
    # бинарные арифметико-логические (add..cmp)
    приём *Опер = список_получи(инс.дети, 0) как *Опер
    ист *Опер = список_получи(инс.дети, 1) как *Опер
    если приём.вид == О_РЕГ и (ист.вид == О_РЕГ или ист.вид == О_ПАМ):
        если ист.вид == О_РЕГ и приём.разм != ист.разм:
            иск_ош("размеры регистров не совпадают", инс.строка, инс.столб)
        опкод цел.верх = код * 8 + 2
        если приём.разм == 1:
            опкод = код * 8 + 2
        иначе:
            опкод = код * 8 + 3
        верни _рм_рег(сост, инс, _байт1(опкод), ист, приём, пусто как *Буфер)
    если приём.вид == О_ПАМ и ист.вид == О_РЕГ:
        разм размер = ист.разм
        если приём.разм != 0 и приём.разм != разм:
            иск_ош("размер памяти не совпадает с регистром", инс.строка, инс.столб)
        опкод = код * 8
        если разм != 1:
            опкод = код * 8 + 1
        верни _рм_рег(сост, инс, _байт1(опкод), приём, ист, пусто как *Буфер)
    если (приём.вид == О_РЕГ или приём.вид == О_ПАМ) и ист.вид == О_ИММ:
        разм = приём.разм
        если приём.вид == О_ПАМ:
            разм = _разм_оп(инс.дети, инс.строка)
        знач цел.верх = в_вычисли(ист.выр, сост.ктх)
        опкод = 0 как цел.верх
        имм *Буфер = буф_новый()
        если разм == 1:
            _диап(знач, 8, да, инс.строка)
            опкод = 0x80
            _имм(имм, знач, 1)
        иначе:
            _диап(знач, 32, да, инс.строка)
            опкод = 0x81
            _имм(имм, знач, 4)
        хвост *Буфер = буф_новый()
        байт_мр нат.верх = _рм(сост, хвост, приём, код как нат.верх)
        рекс_w нат.верх = 0
        если разм == 8:
            рекс_w = 1
        рекс цел.верх = _рекс(рекс_w, 0, байт_мр & 0xFF, байт_мр >> 8, _рекс8(приём))
        верни _финиш(сост, инс, разм == 2, рекс, _байт1(опкод), хвост, имм)
    иск_ош("недопустимое сочетание операндов", инс.строка, инс.столб)
    верни пусто как *Буфер

открыто функ _байт1(знач цел.верх) стр:
    # один байт опкода как строка-байт
    буф *Буфер = буф_новый()
    буф_сим(буф, знач как нат.старт)
    верни буф_стр(буф)

открыто функ _байт2(зн1 цел.верх, зн2 цел.верх) стр:
    буф *Буфер = буф_новый()
    буф_сим(буф, зн1 как нат.старт)
    буф_сим(буф, зн2 как нат.старт)
    верни буф_стр(буф)

открыто функ _к_пер(сост *Код, инс *Узел) *Буфер:
    # ПЕР (mov)
    приём *Опер = список_получи(инс.дети, 0) как *Опер
    ист *Опер = список_получи(инс.дети, 1) как *Опер
    если приём.вид == О_РЕГ и (ист.вид == О_РЕГ или ист.вид == О_ПАМ):
        если ист.вид == О_РЕГ и приём.разм != ист.разм:
            иск_ош("размеры регистров не совпадают", инс.строка, инс.столб)
        опкод цел.верх = 0x8A
        если приём.разм != 1:
            опкод = 0x8B
        верни _рм_рег(сост, инс, _байт1(опкод), ист, приём, пусто как *Буфер)
    если приём.вид == О_ПАМ и ист.вид == О_РЕГ:
        опкод = 0x88
        если ист.разм != 1:
            опкод = 0x89
        верни _рм_рег(сост, инс, _байт1(опкод), приём, ист, пусто как *Буфер)
    если приём.вид == О_РЕГ и ист.вид == О_ИММ:
        # решение о кодировке — по типу выражения (символ?), значение
        # вычисляется всегда: на первом проходе символы дают 0
        есть_сим лог = в_есть_сим(ист.выр)
        знач цел.верх = в_вычисли(ист.выр, сост.ктх)
        если приём.разм == 1:
            _гибк(знач, 8, инс.строка)
            имм *Буфер = буф_новый()
            _имм(имм, знач, 1)
            рекс цел.верх = _рекс(0, 0, 0, приём.ном >> 3, _рекс8(приём))
            верни _финиш(сост, инс, нет, рекс, _байт1(0xB0 + (приём.ном & 7) как цел.верх),
                         _пустой(), имм)
        если (приём.разм == 8 и (есть_сим или в_большое(ист.выр) или
             не (знач >= -0x80000000 и знач <= 0x7FFFFFFF))):
            # полное 64-битное значение: B8+r с imm64
            имм = буф_новый()
            _имм(имм, знач, 8)
            рекс = _рекс(1, 0, 0, приём.ном >> 3, нет)
            верни _финиш(сост, инс, нет, рекс, _байт1(0xB8 + (приём.ном & 7) как цел.верх),
                         _пустой(), имм)
        # 16/32 бита или знакорасширяемое imm32: C7 /0
        если приём.разм == 2:
            _гибк(знач, 16, инс.строка)
        а если приём.разм == 4:
            _гибк(знач, 32, инс.строка)
        иначе:
            _диап(знач, 32, да, инс.строка)
        хвост *Буфер = буф_новый()
        байт_мр нат.верх = _рм(сост, хвост, приём, 0)
        рекс_w нат.верх = 0
        если приём.разм == 8:
            рекс_w = 1
        рекс = _рекс(рекс_w, 0, байт_мр & 0xFF, байт_мр >> 8, нет)
        имм = буф_новый()
        если приём.разм == 2:
            _имм(имм, знач, 2)
        иначе:
            _имм(имм, знач, 4)
        верни _финиш(сост, инс, приём.разм == 2, рекс, _байт1(0xC7), хвост, имм)
    если приём.вид == О_ПАМ и ист.вид == О_ИММ:
        разм размер = _разм_оп(инс.дети, инс.строка)
        знач = в_вычисли(ист.выр, сост.ктх)
        если разм == 8:
            _диап(знач, 32, да, инс.строка)   # imm32 знакорасширяется
        иначе:
            разряд размер = разм * 8
            если разм == 1:
                разряд = 8
            _гибк(знач, разряд, инс.строка)
        хвост = буф_новый()
        байт_мр = _рм(сост, хвост, приём, 0)
        рекс_w = 0 как нат.верх
        если разм == 8:
            рекс_w = 1
        рекс = _рекс(рекс_w, 0, байт_мр & 0xFF, байт_мр >> 8, нет)
        опкод = 0xC6
        если разм != 1:
            опкод = 0xC7
        имм = буф_новый()
        если разм == 1:
            _имм(имм, знач, 1)
        а если разм == 2:
            _имм(имм, знач, 2)
        иначе:
            _имм(имм, знач, 4)
        верни _финиш(сост, инс, разм == 2, рекс, _байт1(опкод), хвост, имм)
    иск_ош("ПЕР: недопустимое сочетание операндов", инс.строка, инс.столб)
    верни пусто как *Буфер

