функ кодируй(ин *Узел, ктх *Ктх) *Буфер:
    # кодирует одну инструкцию в байты машинного кода;
    # ктх.ва — адрес инструкции; на «сухом» проходе символы дают 0
    к := _код_новый(ктх, ин.строка, ин.столб)
    м := ин.текст
    n := ин.дети.длина
    нул := _код_нулев(м)
    если нул != пусто:
        если n != 0:
            иск_ош("операнды не нужны", ин.строка, ин.столб)
        б *Буфер = буф_новый()
        буф_добавь(б, нул)
        верни б
    код := _код_биноп(м)
    если код >= 0:
        если n != 2:
            иск_ош("нужно два операнда", ин.строка, ин.столб)
        верни _к_биноп(к, ин, код)
    если стр_равны_нр(м, "ПЕР"):
        если n != 2:
            иск_ош("ПЕР: нужно два операнда", ин.строка, ин.столб)
        верни _к_пер(к, ин)
    код = _код_унар(м)
    если код >= 0:
        если n != 1:
            иск_ош("нужен один операнд", ин.строка, ин.столб)
        верни _к_унар(к, ин, код)
    если стр_равны_нр(м, "УМН"):
        верни _к_умн(к, ин)
    код = _код_сдвиг(м)
    если код >= 0:
        если n != 2:
            иск_ош("нужно два операнда", ин.строка, ин.столб)
        верни _к_сдвиг(к, ин, код)
    если стр_равны_нр(м, "УВЕЛ"):
        если n != 1:
            иск_ош("УВЕЛ: нужен один операнд", ин.строка, ин.столб)
        верни _к_увум(к, ин, 0)
    если стр_равны_нр(м, "УМЕН"):
        если n != 1:
            иск_ош("УМЕН: нужен один операнд", ин.строка, ин.столб)
        верни _к_увум(к, ин, 1)
    если стр_равны_нр(м, "ВСТЕК"):
        если n != 1:
            иск_ош("ВСТЕК: нужен один операнд", ин.строка, ин.столб)
        верни _к_встек(к, ин)
    если стр_равны_нр(м, "ИЗСТЕКА"):
        если n != 1:
            иск_ош("ИЗСТЕКА: нужен один операнд", ин.строка, ин.столб)
        верни _к_изстека(к, ин)
    если стр_равны_нр(м, "ВЫЗОВ"):
        если n != 1:
            иск_ош("ВЫЗОВ: нужен один операнд", ин.строка, ин.столб)
        верни _к_вызов(к, ин)
    если стр_равны_нр(м, "ВОЗВРАТ"):
        верни _к_возврат(к, ин)
    если стр_равны_нр(м, "ПРЫГ"):
        если n != 1:
            иск_ош("ПРЫГ: нужен один операнд", ин.строка, ин.столб)
        верни _к_прыг(к, ин)
    усл := _код_усл(м)
    если усл >= 0:
        если n != 1:
            иск_ош("нужен один операнд (метка)", ин.строка, ин.столб)
        верни _к_усл(к, ин, усл)
    если стр_равны_нр(м, "АДР"):
        если n != 2:
            иск_ош("АДР: нужно два операнда", ин.строка, ин.столб)
        верни _к_адр(к, ин)
    если стр_равны_нр(м, "ОБМЕН"):
        если n != 2:
            иск_ош("ОБМЕН: нужно два операнда", ин.строка, ин.столб)
        верни _к_обмен(к, ин)
    если стр_равны_нр(м, "ПРОВ"):
        если n != 2:
            иск_ош("ПРОВ: нужно два операнда", ин.строка, ин.столб)
        верни _к_пров(к, ин)
    если м.длина > 6 и стр_равны_нр(стр_срез(м, 0, 6), "УСТ"):
        усл2 := _код_усл(стр_срез(м, 6, м.длина))
        если усл2 >= 0:
            если n != 1:
                иск_ош("нужен один операнд", ин.строка, ин.столб)
            верни _к_уст(к, ин, усл2)
    если стр_равны_нр(м, "ЗНАКРАСШ") или стр_равны_нр(м, "БЕЗРАСШ"):
        если n != 2:
            иск_ош("нужно два операнда", ин.строка, ин.столб)
        верни _к_расш(к, ин, стр_равны_нр(м, "ЗНАКРАСШ"))
    если стр_равны_нр(м, "ЗНАКРАСШД"):
        если n != 2:
            иск_ош("ЗНАКРАСШД: нужно два операнда", ин.строка, ин.столб)
        верни _к_расшд(к, ин)
    иск_ош("неизвестная мнемоника", ин.строка, ин.столб)
    верни пусто как *Буфер
