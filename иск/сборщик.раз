# сборщик — двухпроходный ассемблер ИСКРЫ.
#
# Проход 1: размеры инструкций и смещения меток внутри секций.
# Планировка: эмиттер назначает адреса секций и ячеек IAT.
# Проход 2: окончательное кодирование с реальными адресами.

взять основа
взять узлы
взять выраж
взять парсер
взять кодер

# секции
конст СЕК_КОД = 0
конст СЕК_ДАН = 1

запись МеткаЗ:
    имя стр
    сек нат.верх
    смещ нат.верх

запись КонстЗ:
    имя стр
    выр *Узел
    сек нат.верх
    смещ нат.верх

запись ИмпЗ:
    длл стр
    функы *Список        # стр — имена функций

запись Разм:
    оператор *Узел       # оператор (И_ИНСТР/И_ДИР)
    сек нат.верх
    смещ нат.верх
    разм нат.верх

запись ИмпЯч:
    имя стр
    ва нат.верх             # VA ячейки IAT

запись Блоб:
    смещ нат.верх
    данные стр

запись Прог:
    размещённые *Список  # *Разм
    метки *Список        # *МеткаЗ
    консты *Список       # *КонстЗ
    импорты *Список      # *ИмпЗ
    вход стр
    разм_код нат.верх
    разм_дан нат.верх
    занято *Список       # стр — константы в процессе вычисления
    кэш *Список          # *КэшЗ — вычисленные константы

запись КэшЗ:
    имя стр
    знач цел.верх

# план компоновки — общий для PE и ELF
запись План:
    код_ва нат.верх         # VA секции кода
    дан_ва нат.верх         # VA секции данных
    вход_ва нат.верх        # VA точки входа
    иат *Список          # *ИмпЯч
    блобы *Список        # *Блоб — вставки в данные (таблицы импортов)
    # дополнительные поля PE
    дан_рва нат.верх
    есть_дан лог
    разм_дан нат.верх
    деск_рва нат.верх
    деск_разм нат.верх
    иат_рва нат.верх
    иат_разм нат.верх
    вход_рва нат.верх

# --- строки в списках (стр — запись, в списке храним *_стрпара) --------------

функ _схр(исх стр) нат.верх:
    пара *_стрпара = новый(_стрпара)
    пара.данные = исх.данные
    пара.длина = исх.длина
    верни пара как нат.верх

функ _встр(знач нат.верх) стр:
    пара *_стрпара = знач как *_стрпара
    верни стр_собери(пара.данные, пара.длина)

# --- контекстные операции для выраж.раз --------------------------------------

функ _метка_ищи(пр *Прог, имя стр) *МеткаЗ:
    для инд в 0..пр.метки.длина:
        метка *МеткаЗ = список_получи(пр.метки, инд) как *МеткаЗ
        если стр_равны(метка.имя, имя):
            верни метка
    верни пусто как *МеткаЗ

функ _конст_ищи(пр *Прог, имя стр) *КонстЗ:
    для инд в 0..пр.консты.длина:
        кз *КонстЗ = список_получи(пр.консты, инд) как *КонстЗ
        если стр_равны(кз.имя, имя):
            верни кз
    верни пусто как *КонстЗ

функ _сек_ва(ктх *Ктх, сек нат.верх) нат.верх:
    пл *План = ктх.план как *План
    если сек == СЕК_КОД:
        верни пл.код_ва
    верни пл.дан_ва

функ к_символ(ктх *Ктх, имя стр) цел.верх:
    # адрес метки или значение константы
    если ктх.сухой:
        верни 0
    пр *Прог = ктх.прог как *Прог
    метка *МеткаЗ = _метка_ищи(пр, имя)
    если метка != пусто:
        верни (_сек_ва(ктх, метка.сек) + метка.смещ) как цел.верх
    кз *КонстЗ = _конст_ищи(пр, имя)
    если кз != пусто:
        для инд в 0..пр.кэш.длина:
            кэз *КэшЗ = список_получи(пр.кэш, инд) как *КэшЗ
            если стр_равны(кэз.имя, имя):
                верни кэз.знач
        для инд в 0..пр.занято.длина:
            если стр_равны(_встр(список_получи(пр.занято, инд)), имя):
                иск_ош("циклическая константа", 0, 0)
        список_добавь(пр.занято, _схр(имя))
        подктх *Ктх = новый(Ктх)
        подктх.ва = ктх.ва
        подктх.здесь = _сек_ва(ктх, кз.сек) + кз.смещ
        подктх.прог = ктх.прог
        подктх.план = ктх.план
        подктх.сухой = нет
        знач цел.верх = в_вычисли(кз.выр, подктх)
        пр.занято.длина = пр.занято.длина - 1
        кэз = новый(КэшЗ)
        кэз.имя = имя
        кэз.знач = знач
        список_добавь(пр.кэш, кэз как нат.верх)
        верни знач
    иск_ош("неизвестный символ", 0, 0)
    верни 0

функ к_иат(ктх *Ктх, имя стр) цел.верх:
    если ктх.сухой:
        верни 0
    пл *План = ктх.план как *План
    для инд в 0..пл.иат.длина:
        яч *ИмпЯч = список_получи(пл.иат, инд) как *ИмпЯч
        если стр_равны(яч.имя, имя):
            верни яч.ва как цел.верх
    иск_ош("не объявлено в ИМПОРТ", 0, 0)
    верни 0

функ к_импорт(ктх *Ктх, имя стр) лог:
    пр *Прог = ктх.прог как *Прог
    если пр == пусто:
        верни нет
    для инд в 0..пр.импорты.длина:
        импз *ИмпЗ = список_получи(пр.импорты, инд) как *ИмпЗ
        для инд2 в 0..импз.функы.длина:
            если стр_равны(_встр(список_получи(импз.функы, инд2)), имя):
                верни да
    верни нет

# --- размеры данных ------------------------------------------------------------

функ _имя_секции(имя стр) нат.верх:
    # каноническая секция: код/данные (-1 — неизвестная)
    если (стр_равны_нр(имя, "код") или стр_равны_нр(имя, "text") или
          стр_равны_нр(имя, "code") или стр_равны_нр(имя, ".text") или
          стр_равны_нр(имя, ".код")):
        верни СЕК_КОД
    если (стр_равны_нр(имя, "данные") или стр_равны_нр(имя, "data") или
          стр_равны_нр(имя, ".data") или стр_равны_нр(имя, ".данные")):
        верни СЕК_ДАН
    верни 0xFFFFFFFFFFFFFFFF

функ _разм_данных(дир *Узел, ктх *Ктх) нат.верх:
    # размер директивы данных в байтах
    имя стр = дир.текст
    если стр_равны(имя, "БАЙТ"):
        итог нат.верх = 0
        для инд в 0..дир.дети.длина:
            арг *Узел = список_получи(дир.дети, инд) как *Узел
            если арг.вид == У_СТР:
                итог += арг.текст.длина
            иначе:
                итог += 1
        верни итог
    если стр_равны(имя, "СЛОВО"):
        верни 2 * дир.дети.длина
    если стр_равны(имя, "ДВСЛОВО"):
        верни 4 * дир.дети.длина
    если стр_равны(имя, "КВАД"):
        верни 8 * дир.дети.длина
    если стр_равны(имя, "РЕЗЕРВ"):
        арг = список_получи(дир.дети, 0) как *Узел
        верни в_вычисли(арг, ктх) как нат.верх
    верни 0

функ _код_данных(дир *Узел, ктх *Ктх, буф *Буфер):
    # кодирует директиву данных в байты (дописывает в буфер)
    имя стр = дир.текст
    если стр_равны(имя, "БАЙТ"):
        для инд в 0..дир.дети.длина:
            арг *Узел = список_получи(дир.дети, инд) как *Узел
            если арг.вид == У_СТР:
                буф_добавь(буф, арг.текст)
            иначе:
                _имм(буф, в_вычисли(арг, ктх), 1)
        верни
    если (стр_равны(имя, "СЛОВО") или стр_равны(имя, "ДВСЛОВО") или
          стр_равны(имя, "КВАД")):
        разм нат.верх = 2
        если стр_равны(имя, "ДВСЛОВО"):
            разм = 4
        иначе:
            если стр_равны(имя, "КВАД"):
                разм = 8
        для инд в 0..дир.дети.длина:
            арг = список_получи(дир.дети, инд) как *Узел
            если арг.вид == У_СТР:
                иск_ош("строки допустимы только в БАЙТ", дир.строка, дир.столб)
            _имм(буф, в_вычисли(арг, ктх), разм)
        верни
    если стр_равны(имя, "РЕЗЕРВ"):
        арг = список_получи(дир.дети, 0) как *Узел
        буф_нуль(буф, в_вычисли(арг, ктх) как нат.верх)
        верни
    иск_ош("директива не порождает данных", дир.строка, дир.столб)

# --- первый проход -------------------------------------------------------------

функ _прог_новый() *Прог:
    пр *Прог = новый(Прог)
    пр.размещённые = список_новый()
    пр.метки = список_новый()
    пр.консты = список_новый()
    пр.импорты = список_новый()
    пр.вход = пусто как стр
    пр.разм_код = 0
    пр.разм_дан = 0
    пр.занято = список_новый()
    пр.кэш = список_новый()
    верни пр

функ _есть_имя(пр *Прог, имя стр) лог:
    верни _метка_ищи(пр, имя) != пусто или _конст_ищи(пр, имя) != пусто

функ проход1(инструкции *Список) *Прог:
    # метки, константы, импорты, смещения, размеры секций
    пр *Прог = _прог_новый()
    # предсканирование импортов: от них зависит длина ВЫЗОВ
    для инд в 0..инструкции.длина:
        узел *Узел = список_получи(инструкции, инд) как *Узел
        если узел.вид == И_ДИР и стр_равны(узел.текст, "ИМПОРТ"):
            если узел.дети.длина < 2:
                иск_ош("ИМПОРТ: нет функций", узел.строка, узел.столб)
            импз *ИмпЗ = новый(ИмпЗ)
            арг0 *Узел = список_получи(узел.дети, 0) как *Узел
            импз.длл = арг0.текст
            импз.функы = список_новый()
            для инд2 в 1..узел.дети.длина:
                арг *Узел = список_получи(узел.дети, инд2) как *Узел
                список_добавь(импз.функы, _схр(арг.текст))
            список_добавь(пр.импорты, импз как нат.верх)
    сух *Ктх = новый(Ктх)
    сух.ва = 0
    сух.здесь = 0
    сух.прог = пр как нат.верх
    сух.план = пусто как нат.верх
    сух.сухой = да
    тек нат.верх = СЕК_КОД как нат.верх
    смещк нат.верх = 0
    смещд нат.верх = 0
    для инд в 0..инструкции.длина:
        узел = список_получи(инструкции, инд) как *Узел
        если узел.вид == И_МЕТКА:
            если _есть_имя(пр, узел.текст):
                иск_ош("повторное имя", узел.строка, узел.столб)
            метка *МеткаЗ = новый(МеткаЗ)
            метка.имя = узел.текст
            метка.сек = тек
            если тек == СЕК_КОД:
                метка.смещ = смещк
            иначе:
                метка.смещ = смещд
            список_добавь(пр.метки, метка как нат.верх)
        а если узел.вид == И_РАВНО:
            если _есть_имя(пр, узел.текст):
                иск_ош("повторное имя", узел.строка, узел.столб)
            кз *КонстЗ = новый(КонстЗ)
            кз.имя = узел.текст
            кз.выр = узел.а
            кз.сек = тек
            если тек == СЕК_КОД:
                кз.смещ = смещк
            иначе:
                кз.смещ = смещд
            список_добавь(пр.консты, кз как нат.верх)
        а если узел.вид == И_ДИР:
            имя стр = узел.текст
            если стр_равны(имя, "СЕКЦИЯ"):
                арг = список_получи(узел.дети, 0) как *Узел
                ключ нат.верх = _имя_секции(арг.текст)
                если ключ == 0xFFFFFFFFFFFFFFFF:
                    иск_ош("неизвестная секция (код/данные)", узел.строка, узел.столб)
                тек = ключ
            а если стр_равны(имя, "ИМПОРТ"):
                # уже собраны при предсканировании
                тек = тек
            а если стр_равны(имя, "ВХОД"):
                арг = список_получи(узел.дети, 0) как *Узел
                если арг.вид != В_СИМ:
                    иск_ош("ВХОД: ожидалась метка", узел.строка, узел.столб)
                пр.вход = арг.текст
            а если стр_равны(имя, "ВЫРОВНЯТЬ"):
                арг = список_получи(узел.дети, 0) как *Узел
                гран цел.верх = в_вычисли(арг, сух)
                если гран <= 0 или (гран & (гран - 1)) != 0:
                    иск_ош("ВЫРОВНЯТЬ: степень двойки", узел.строка, узел.столб)
                нач нат.верх = смещк
                если тек == СЕК_ДАН:
                    нач = смещд
                добив нат.верх = ((0 - (нач как цел.верх)) % гран) как нат.верх
                размещ *Разм = новый(Разм)
                размещ.оператор = узел
                размещ.сек = тек
                размещ.смещ = нач
                размещ.разм = добив
                список_добавь(пр.размещённые, размещ как нат.верх)
                если тек == СЕК_КОД:
                    смещк += добив
                иначе:
                    смещд += добив
            иначе:
                если (стр_равны(имя, "БАЙТ") или стр_равны(имя, "СЛОВО") или
                      стр_равны(имя, "ДВСЛОВО") или стр_равны(имя, "КВАД") или
                      стр_равны(имя, "РЕЗЕРВ")):
                    разм нат.верх = _разм_данных(узел, сух)
                    размещ = новый(Разм)
                    размещ.оператор = узел
                    размещ.сек = тек
                    если тек == СЕК_КОД:
                        размещ.смещ = смещк
                        смещк += разм
                    иначе:
                        размещ.смещ = смещд
                        смещд += разм
                    размещ.разм = разм
                    список_добавь(пр.размещённые, размещ как нат.верх)
                иначе:
                    иск_ош("директива не поддержана", узел.строка, узел.столб)
        а если узел.вид == И_ИНСТР:
            буф *Буфер = кодируй(узел, сух)
            размещ = новый(Разм)
            размещ.оператор = узел
            размещ.сек = тек
            размещ.разм = буф.длина
            если тек == СЕК_КОД:
                размещ.смещ = смещк
                смещк += буф.длина
            иначе:
                размещ.смещ = смещд
                смещд += буф.длина
            список_добавь(пр.размещённые, размещ как нат.верх)
    пр.разм_код = смещк
    пр.разм_дан = смещд
    если пр.вход.длина == 0:
        пр.вход = "старт"
    если _метка_ищи(пр, пр.вход) == пусто:
        иск_ош("точка входа не найдена", 0, 0)
    верни пр

функ вход_смещ(пр *Прог) нат.верх:
    # смещение точки входа в секции кода (с проверкой)
    вх *МеткаЗ = _метка_ищи(пр, пр.вход)
    если вх.сек != СЕК_КОД:
        иск_ош("точка входа должна быть в секции кода", 0, 0)
    верни вх.смещ

# --- общие хелперы записи little-endian по смещению --------------------------

функ выров(знач нат.верх, гран нат.верх) нат.верх:
    # выравнивание вверх до степени двойки
    верни (знач + гран - 1) & (0 - гран)

функ уст16(куда *нат.старт, поз нат.верх, знач нат.верх):
    куда[поз] = знач как нат.старт
    куда[поз + 1] = (знач >> 8) как нат.старт

функ уст32(куда *нат.старт, поз нат.верх, знач нат.верх):
    для инд в 0..4:
        куда[поз + инд] = (знач >> (инд * 8)) как нат.старт

функ уст64(куда *нат.старт, поз нат.верх, знач нат.верх):
    для инд в 0..8:
        куда[поз + инд] = (знач >> (инд * 8)) как нат.старт

# --- второй проход -------------------------------------------------------------

запись Дво:
    код стр
    дан стр

функ проход2(пр *Прог, пл *План) *Дво:
    # окончательное кодирование с реальными адресами из плана
    ктх *Ктх = новый(Ктх)
    ктх.прог = пр как нат.верх
    ктх.план = пл как нат.верх
    ктх.сухой = нет
    кодб *Буфер = буф_новый()
    буф_нуль(кодб, пр.разм_код)
    данб *Буфер = буф_новый()
    буф_нуль(данб, пр.разм_дан)
    для инд в 0..пр.размещённые.длина:
        размещ *Разм = список_получи(пр.размещённые, инд) как *Разм
        узел *Узел = размещ.оператор
        ктх.ва = _сек_ва(ктх, размещ.сек) + размещ.смещ
        ктх.здесь = ктх.ва
        времен *Буфер = буф_новый()
        если узел.вид == И_ИНСТР:
            времен = кодируй(узел, ктх)
        а если узел.вид == И_ДИР и стр_равны(узел.текст, "ВЫРОВНЯТЬ"):
            буф_нуль(времен, размещ.разм)
        иначе:
            _код_данных(узел, ктх, времен)
        если времен.длина != размещ.разм:
            иск_ош("внутренняя ошибка: размер изменился", узел.строка, узел.столб)
        куда *нат.старт = кодб.данные + размещ.смещ
        если размещ.сек == СЕК_ДАН:
            куда = данб.данные + размещ.смещ
        скопируй(куда, времен.данные, времен.длина)
    итог *Дво = новый(Дво)
    итог.код = стр_собери(кодб.данные, кодб.длина)
    итог.дан = стр_собери(данб.данные, данб.длина)
    верни итог
