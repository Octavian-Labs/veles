функ проход2(пр *Прог, пл *План) *Дво:
    # окончательное кодирование с реальными адресами из плана
    к *Ктх = новый(Ктх)
    к.прог = пр как без64
    к.план = пл как без64
    к.сухой = нет
    кодб *Буфер = буф_новый()
    буф_нуль(кодб, пр.разм_код)
    данб *Буфер = буф_новый()
    буф_нуль(данб, пр.разм_дан)
    для i в 0..пр.placed.длина:
        р := список_получи(пр.placed, i) как *Разм
        s := р.оп
        к.ва = _сек_ва(к, р.сек) + р.смещ
        к.здесь = к.ва
        времен *Буфер = буф_новый()
        если s.вид == И_ИНСТР:
            времен = кодируй(s, к)
        а если s.вид == И_ДИР и стр_равны(s.текст, "ВЫРОВНЯТЬ"):
            буф_нуль(времен, р.разм)
        иначе:
            _код_данных(s, к, времен)
        если времен.длина != р.разм:
            иск_ош("внутренняя ошибка: размер изменился", s.строка)
        куда := кодб.данные + р.смещ
        если р.сек == СЕК_ДАН:
            куда = данб.данные + р.смещ
        скопируй(куда, времен.данные, времен.длина)
    д *Дво = новый(Дво)
    д.код = стр_собери(кодб.данные, кодб.длина)
    д.дан = стр_собери(данб.данные, данб.длина)
    верни д
