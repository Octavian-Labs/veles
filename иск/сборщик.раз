# --- строки в списках (стр — запись, в списке храним *_стрпара) --------------

функ _схр(с стр) без64:
    з := новый(_стрпара)
    з.данные = с.данные
    з.длина = с.длина
    верни з как без64

функ _встр(v без64) стр:
    з := v как *_стрпара
    верни стр_собери(з.данные, з.длина)

# --- контекстные операции для выраж.раз --------------------------------------

функ _метка_ищи(пр *Прог, имя стр) *МеткаЗ:
    для i в 0..пр.метки.длина:
        м := список_получи(пр.метки, i) как *МеткаЗ
        если стр_равны(м.имя, имя):
            верни м
    верни пусто как *МеткаЗ

функ _конст_ищи(пр *Прог, имя стр) *КонстЗ:
    для i в 0..пр.консты.длина:
        к := список_получи(пр.консты, i) как *КонстЗ
        если стр_равны(к.имя, имя):
            верни к
    верни пусто как *КонстЗ

функ _сек_ва(к *Ктх, сек без64) без64:
    пл := к.план как *План
    если сек == СЕК_КОД:
        верни пл.код_ва
    верни пл.дан_ва

функ к_символ(к *Ктх, имя стр) цел64:
    # адрес метки или значение константы
    если к.сухой:
        верни 0
    пр := к.прог как *Прог
    м := _метка_ищи(пр, имя)
    если м != пусто:
        верни (_сек_ва(к, м.сек) + м.смещ) как цел64
    кз := _конст_ищи(пр, имя)
    если кз != пусто:
        для i в 0..пр.кэш.длина:
            кэ := список_получи(пр.кэш, i) как *КэшЗ
            если стр_равны(кэ.имя, имя):
                верни кэ.знач
        для i в 0..пр.занято.длина:
            если стр_равны(_встр(список_получи(пр.занято, i)), имя):
                иск_ош("циклическая константа", 0)
        список_добавь(пр.занято, _схр(имя))
        под *Ктх = новый(Ктх)
        под.ва = к.ва
        под.здесь = _сек_ва(к, кз.сек) + кз.смещ
        под.прог = к.прог
        под.план = к.план
        под.сухой = нет
        v := в_вычисли(кз.выр, под)
        пр.занято.длина = пр.занято.длина - 1
        кэ *КэшЗ = новый(КэшЗ)
        кэ.имя = имя
        кэ.знач = v
        список_добавь(пр.кэш, кэ как без64)
        верни v
    иск_ош("неизвестный символ", 0)
    верни 0

функ к_иат(к *Ктх, имя стр) цел64:
    если к.сухой:
        верни 0
    пл := к.план как *План
    для i в 0..пл.иат.длина:
        я := список_получи(пл.иат, i) как *ИмпЯч
        если стр_равны(я.имя, имя):
            верни я.ва как цел64
    иск_ош("не объявлено в ИМПОРТ", 0)
    верни 0

функ к_импорт(к *Ктх, имя стр) бул:
    пр := к.прог как *Прог
    если пр == пусто:
        верни нет
    для i в 0..пр.импорты.длина:
        з := список_получи(пр.импорты, i) как *ИмпЗ
        для j в 0..з.функы.длина:
            если стр_равны(_встр(список_получи(з.функы, j)), имя):
                верни да
    верни нет

# --- размеры данных ------------------------------------------------------------

функ _имя_секции(имя стр) без64:
    # каноническая секция: код/данные (-1 — неизвестная)
    если (стр_равны_нр(имя, "код") или стр_равны_нр(имя, "text") или
          стр_равны_нр(имя, "code") или стр_равны_нр(имя, ".text") или
          стр_равны_нр(имя, ".код")):
        верни СЕК_КОД
    если (стр_равны_нр(имя, "данные") или стр_равны_нр(имя, "data") или
          стр_равны_нр(имя, ".data") или стр_равны_нр(имя, ".данные")):
        верни СЕК_ДАН
    верни 0xFFFFFFFFFFFFFFFF

функ _разм_данных(д *Узел, к *Ктх) без64:
    # размер директивы данных в байтах
    имя := д.текст
    если стр_равны(имя, "БАЙТ"):
        n := 0 как без64
        для i в 0..д.дети.длина:
            а := список_получи(д.дети, i) как *Узел
            если а.вид == У_СТР:
                n += а.текст.длина
            иначе:
                n += 1
        верни n
    если стр_равны(имя, "СЛОВО"):
        верни 2 * д.дети.длина
    если стр_равны(имя, "ДВСЛОВО"):
        верни 4 * д.дети.длина
    если стр_равны(имя, "КВАД"):
        верни 8 * д.дети.длина
    если стр_равны(имя, "РЕЗЕРВ"):
        а := список_получи(д.дети, 0) как *Узел
        верни в_вычисли(а, к) как без64
    верни 0

функ _код_данных(д *Узел, к *Ктх, б *Буфер):
    # кодирует директиву данных в байты (дописывает в буфер)
    имя := д.текст
    если стр_равны(имя, "БАЙТ"):
        для i в 0..д.дети.длина:
            а := список_получи(д.дети, i) как *Узел
            если а.вид == У_СТР:
                буф_добавь(б, а.текст)
            иначе:
                _имм(б, в_вычисли(а, к), 1)
        верни
    если (стр_равны(имя, "СЛОВО") или стр_равны(имя, "ДВСЛОВО") или
          стр_равны(имя, "КВАД")):
        sz := 2 как без64
        если стр_равны(имя, "ДВСЛОВО"):
            sz = 4
        иначе:
            если стр_равны(имя, "КВАД"):
                sz = 8
        для i в 0..д.дети.длина:
            а := список_получи(д.дети, i) как *Узел
            если а.вид == У_СТР:
                иск_ош("строки допустимы только в БАЙТ", д.строка)
            _имм(б, в_вычисли(а, к), sz)
        верни
    если стр_равны(имя, "РЕЗЕРВ"):
        а := список_получи(д.дети, 0) как *Узел
        буф_нуль(б, в_вычисли(а, к) как без64)
        верни
    иск_ош("директива не порождает данных", д.строка)

# --- первый проход -------------------------------------------------------------

функ _прог_новый() *Прог:
    пр *Прог = новый(Прог)
    пр.placed = список_новый()
    пр.метки = список_новый()
    пр.консты = список_новый()
    пр.импорты = список_новый()
    пр.вход = пусто как стр
    пр.разм_код = 0
    пр.разм_дан = 0
    пр.занято = список_новый()
    пр.кэш = список_новый()
    верни пр

функ _есть_имя(пр *Прог, имя стр) бул:
    верни _метка_ищи(пр, имя) != пусто или _конст_ищи(пр, имя) != пусто

функ проход1(stmts *Список) *Прог:
    # метки, константы, импорты, смещения, размеры секций
    пр := _прог_новый()
    # предсканирование импортов: от них зависит длина ВЫЗОВ
    для i в 0..stmts.длина:
        s := список_получи(stmts, i) как *Узел
        если s.вид == И_ДИР и стр_равны(s.текст, "ИМПОРТ"):
            если s.дети.длина < 2:
                иск_ош("ИМПОРТ: нет функций", s.строка)
            з *ИмпЗ = новый(ИмпЗ)
            а0 := список_получи(s.дети, 0) как *Узел
            з.длл = а0.текст
            з.функы = список_новый()
            для j в 1..s.дети.длина:
                а := список_получи(s.дети, j) как *Узел
                список_добавь(з.функы, _схр(а.текст))
            список_добавь(пр.импорты, з как без64)
    сух *Ктх = новый(Ктх)
    сух.ва = 0
    сух.здесь = 0
    сух.прог = пр как без64
    сух.план = пусто как без64
    сух.сухой = да
    тек := СЕК_КОД как без64
    смещк := 0 как без64
    смещд := 0 как без64
    для i в 0..stmts.длина:
        s := список_получи(stmts, i) как *Узел
        если s.вид == И_МЕТКА:
            если _есть_имя(пр, s.текст):
                иск_ош("повторное имя", s.строка)
            м *МеткаЗ = новый(МеткаЗ)
            м.имя = s.текст
            м.сек = тек
            если тек == СЕК_КОД:
                м.смещ = смещк
            иначе:
                м.смещ = смещд
            список_добавь(пр.метки, м как без64)
        а если s.вид == И_РАВНО:
            если _есть_имя(пр, s.текст):
                иск_ош("повторное имя", s.строка)
            кз *КонстЗ = новый(КонстЗ)
            кз.имя = s.текст
            кз.выр = s.а
            кз.сек = тек
            если тек == СЕК_КОД:
                кз.смещ = смещк
            иначе:
                кз.смещ = смещд
            список_добавь(пр.консты, кз как без64)
        а если s.вид == И_ДИР:
            имя := s.текст
            если стр_равны(имя, "СЕКЦИЯ"):
                а := список_получи(s.дети, 0) как *Узел
                ключ := _имя_секции(а.текст)
                если ключ == 0xFFFFFFFFFFFFFFFF:
                    иск_ош("неизвестная секция (код/данные)", s.строка)
                тек = ключ
            а если стр_равны(имя, "ИМПОРТ"):
                # уже собраны при предсканировании
                тек = тек
            а если стр_равны(имя, "ВХОД"):
                а := список_получи(s.дети, 0) как *Узел
                если а.вид != В_СИМ:
                    иск_ош("ВХОД: ожидалась метка", s.строка)
                пр.вход = а.текст
            а если стр_равны(имя, "ВЫРОВНЯТЬ"):
                а := список_получи(s.дети, 0) как *Узел
                ал := в_вычисли(а, сух)
                если ал <= 0 или (ал & (ал - 1)) != 0:
                    иск_ош("ВЫРОВНЯТЬ: степень двойки", s.строка)
                оф := смещк
                если тек == СЕК_ДАН:
                    оф = смещд
                пад := ((0 - (оф как цел64)) % ал) как без64
                р *Разм = новый(Разм)
                р.оп = s
                р.сек = тек
                р.смещ = оф
                р.разм = пад
                список_добавь(пр.placed, р как без64)
                если тек == СЕК_КОД:
                    смещк += пад
                иначе:
                    смещд += пад
            иначе:
                если (стр_равны(имя, "БАЙТ") или стр_равны(имя, "СЛОВО") или
                      стр_равны(имя, "ДВСЛОВО") или стр_равны(имя, "КВАД") или
                      стр_равны(имя, "РЕЗЕРВ")):
                    разм := _разм_данных(s, сух)
                    р *Разм = новый(Разм)
                    р.оп = s
                    р.сек = тек
                    если тек == СЕК_КОД:
                        р.смещ = смещк
                        смещк += разм
                    иначе:
                        р.смещ = смещд
                        смещд += разм
                    р.разм = разм
                    список_добавь(пр.placed, р как без64)
                иначе:
                    иск_ош("директива не поддержана", s.строка)
        а если s.вид == И_ИНСТР:
            б := кодируй(s, сух)
            р *Разм = новый(Разм)
            р.оп = s
            р.сек = тек
            р.разм = б.длина
            если тек == СЕК_КОД:
                р.смещ = смещк
                смещк += б.длина
            иначе:
                р.смещ = смещд
                смещд += б.длина
            список_добавь(пр.placed, р как без64)
    пр.разм_код = смещк
    пр.разм_дан = смещд
    если пр.вход.длина == 0:
        пр.вход = "старт"
    если _метка_ищи(пр, пр.вход) == пусто:
        иск_ош("точка входа не найдена", 0)
    верни пр

функ вход_смещ(пр *Прог) без64:
    # смещение точки входа в секции кода (с проверкой)
    вх := _метка_ищи(пр, пр.вход)
    если вх.сек != СЕК_КОД:
        иск_ош("точка входа должна быть в секции кода", 0)
    верни вх.смещ

# --- общие хелперы записи little-endian по смещению --------------------------

функ выров(v без64, а без64) без64:
    # выравнивание вверх до степени двойки
    верни (v + а - 1) & (0 - а)

функ уст16(д *без8, поз без64, v без64):
    д[поз] = v как без8
    д[поз + 1] = (v >> 8) как без8

функ уст32(д *без8, поз без64, v без64):
    для i в 0..4:
        д[поз + i] = (v >> (i * 8)) как без8

функ уст64(д *без8, поз без64, v без64):
    для i в 0..8:
        д[поз + i] = (v >> (i * 8)) как без8

