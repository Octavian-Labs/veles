# сборщик — двухпроходный ассемблер ИСКРЫ.
#
# Проход 1: размеры инструкций и смещения меток внутри секций.
# Планировка: эмиттер назначает адреса секций и ячеек IAT.
# Проход 2: окончательное кодирование с реальными адресами.

взять основа
взять узлы
взять выраж
взять парсер
взять кодер

# секции
конст СЕК_КОД = 0
конст СЕК_ДАН = 1

запись МеткаЗ:
    имя стр
    сек нат.верх
    смещ нат.верх

запись КонстЗ:
    имя стр
    выр *Узел
    сек нат.верх
    смещ нат.верх

запись ИмпЗ:
    длл стр
    функы *Список        # стр — имена функций

запись Разм:
    оп *Узел             # оператор (И_ИНСТР/И_ДИР)
    сек нат.верх
    смещ нат.верх
    разм нат.верх

запись ИмпЯч:
    имя стр
    ва нат.верх             # VA ячейки IAT

запись Блоб:
    смещ нат.верх
    данные стр

запись Прог:
    placed *Список       # *Разм
    метки *Список        # *МеткаЗ
    консты *Список       # *КонстЗ
    импорты *Список      # *ИмпЗ
    вход стр
    разм_код нат.верх
    разм_дан нат.верх
    занято *Список       # стр — константы в процессе вычисления
    кэш *Список          # *КэшЗ — вычисленные константы

запись КэшЗ:
    имя стр
    знач цел.верх

# план компоновки — общий для PE и ELF
запись План:
    код_ва нат.верх         # VA секции кода
    дан_ва нат.верх         # VA секции данных
    вход_ва нат.верх        # VA точки входа
    иат *Список          # *ИмпЯч
    блобы *Список        # *Блоб — вставки в данные (таблицы импортов)
    # дополнительные поля PE
    дан_рва нат.верх
    есть_дан лог
    разм_дан нат.верх
    деск_рва нат.верх
    деск_разм нат.верх
    иат_рва нат.верх
    иат_разм нат.верх
    вход_рва нат.верх

# --- строки в списках (стр — запись, в списке храним *_стрпара) --------------

функ _схр(с стр) нат.верх:
    з *_стрпара = новый(_стрпара)
    з.данные = с.данные
    з.длина = с.длина
    верни з как нат.верх

функ _встр(v нат.верх) стр:
    з *_стрпара = v как *_стрпара
    верни стр_собери(з.данные, з.длина)

# --- контекстные операции для выраж.раз --------------------------------------

функ _метка_ищи(пр *Прог, имя стр) *МеткаЗ:
    для инд в 0..пр.метки.длина:
        м *МеткаЗ = список_получи(пр.метки, инд) как *МеткаЗ
        если стр_равны(м.имя, имя):
            верни м
    верни пусто как *МеткаЗ

функ _конст_ищи(пр *Прог, имя стр) *КонстЗ:
    для инд в 0..пр.консты.длина:
        к *КонстЗ = список_получи(пр.консты, инд) как *КонстЗ
        если стр_равны(к.имя, имя):
            верни к
    верни пусто как *КонстЗ

функ _сек_ва(к *Ктх, сек нат.верх) нат.верх:
    пл *План = к.план как *План
    если сек == СЕК_КОД:
        верни пл.код_ва
    верни пл.дан_ва

функ к_символ(к *Ктх, имя стр) цел.верх:
    # адрес метки или значение константы
    если к.сухой:
        верни 0
    пр *Прог = к.прог как *Прог
    м *МеткаЗ = _метка_ищи(пр, имя)
    если м != пусто:
        верни (_сек_ва(к, м.сек) + м.смещ) как цел.верх
    кз *КонстЗ = _конст_ищи(пр, имя)
    если кз != пусто:
        для инд в 0..пр.кэш.длина:
            кэ *КэшЗ = список_получи(пр.кэш, инд) как *КэшЗ
            если стр_равны(кэ.имя, имя):
                верни кэ.знач
        для инд в 0..пр.занято.длина:
            если стр_равны(_встр(список_получи(пр.занято, инд)), имя):
                иск_ош("циклическая константа", 0, 0)
        список_добавь(пр.занято, _схр(имя))
        под *Ктх = новый(Ктх)
        под.ва = к.ва
        под.здесь = _сек_ва(к, кз.сек) + кз.смещ
        под.прог = к.прог
        под.план = к.план
        под.сухой = нет
        v цел.верх = в_вычисли(кз.выр, под)
        пр.занято.длина = пр.занято.длина - 1
        кэ = новый(КэшЗ)
        кэ.имя = имя
        кэ.знач = v
        список_добавь(пр.кэш, кэ как нат.верх)
        верни v
    иск_ош("неизвестный символ", 0, 0)
    верни 0

функ к_иат(к *Ктх, имя стр) цел.верх:
    если к.сухой:
        верни 0
    пл *План = к.план как *План
    для инд в 0..пл.иат.длина:
        я *ИмпЯч = список_получи(пл.иат, инд) как *ИмпЯч
        если стр_равны(я.имя, имя):
            верни я.ва как цел.верх
    иск_ош("не объявлено в ИМПОРТ", 0, 0)
    верни 0

функ к_импорт(к *Ктх, имя стр) лог:
    пр *Прог = к.прог как *Прог
    если пр == пусто:
        верни нет
    для инд в 0..пр.импорты.длина:
        з *ИмпЗ = список_получи(пр.импорты, инд) как *ИмпЗ
        для инд2 в 0..з.функы.длина:
            если стр_равны(_встр(список_получи(з.функы, инд2)), имя):
                верни да
    верни нет

# --- размеры данных ------------------------------------------------------------

функ _имя_секции(имя стр) нат.верх:
    # каноническая секция: код/данные (-1 — неизвестная)
    если (стр_равны_нр(имя, "код") или стр_равны_нр(имя, "text") или
          стр_равны_нр(имя, "code") или стр_равны_нр(имя, ".text") или
          стр_равны_нр(имя, ".код")):
        верни СЕК_КОД
    если (стр_равны_нр(имя, "данные") или стр_равны_нр(имя, "data") или
          стр_равны_нр(имя, ".data") или стр_равны_нр(имя, ".данные")):
        верни СЕК_ДАН
    верни 0xFFFFFFFFFFFFFFFF

функ _разм_данных(д *Узел, к *Ктх) нат.верх:
    # размер директивы данных в байтах
    имя стр = д.текст
    если стр_равны(имя, "БАЙТ"):
        n нат.верх = 0
        для инд в 0..д.дети.длина:
            а *Узел = список_получи(д.дети, инд) как *Узел
            если а.вид == У_СТР:
                n += а.текст.длина
            иначе:
                n += 1
        верни n
    если стр_равны(имя, "СЛОВО"):
        верни 2 * д.дети.длина
    если стр_равны(имя, "ДВСЛОВО"):
        верни 4 * д.дети.длина
    если стр_равны(имя, "КВАД"):
        верни 8 * д.дети.длина
    если стр_равны(имя, "РЕЗЕРВ"):
        а = список_получи(д.дети, 0) как *Узел
        верни в_вычисли(а, к) как нат.верх
    верни 0

функ _код_данных(д *Узел, к *Ктх, б *Буфер):
    # кодирует директиву данных в байты (дописывает в буфер)
    имя стр = д.текст
    если стр_равны(имя, "БАЙТ"):
        для инд в 0..д.дети.длина:
            а *Узел = список_получи(д.дети, инд) как *Узел
            если а.вид == У_СТР:
                буф_добавь(б, а.текст)
            иначе:
                _имм(б, в_вычисли(а, к), 1)
        верни
    если (стр_равны(имя, "СЛОВО") или стр_равны(имя, "ДВСЛОВО") или
          стр_равны(имя, "КВАД")):
        sz нат.верх = 2
        если стр_равны(имя, "ДВСЛОВО"):
            sz = 4
        иначе:
            если стр_равны(имя, "КВАД"):
                sz = 8
        для инд в 0..д.дети.длина:
            а = список_получи(д.дети, инд) как *Узел
            если а.вид == У_СТР:
                иск_ош("строки допустимы только в БАЙТ", д.строка, д.столб)
            _имм(б, в_вычисли(а, к), sz)
        верни
    если стр_равны(имя, "РЕЗЕРВ"):
        а = список_получи(д.дети, 0) как *Узел
        буф_нуль(б, в_вычисли(а, к) как нат.верх)
        верни
    иск_ош("директива не порождает данных", д.строка, д.столб)

# --- первый проход -------------------------------------------------------------

функ _прог_новый() *Прог:
    пр *Прог = новый(Прог)
    пр.placed = список_новый()
    пр.метки = список_новый()
    пр.консты = список_новый()
    пр.импорты = список_новый()
    пр.вход = пусто как стр
    пр.разм_код = 0
    пр.разм_дан = 0
    пр.занято = список_новый()
    пр.кэш = список_новый()
    верни пр

функ _есть_имя(пр *Прог, имя стр) лог:
    верни _метка_ищи(пр, имя) != пусто или _конст_ищи(пр, имя) != пусто

функ проход1(stmts *Список) *Прог:
    # метки, константы, импорты, смещения, размеры секций
    пр *Прог = _прог_новый()
    # предсканирование импортов: от них зависит длина ВЫЗОВ
    для инд в 0..stmts.длина:
        s *Узел = список_получи(stmts, инд) как *Узел
        если s.вид == И_ДИР и стр_равны(s.текст, "ИМПОРТ"):
            если s.дети.длина < 2:
                иск_ош("ИМПОРТ: нет функций", s.строка, s.столб)
            з *ИмпЗ = новый(ИмпЗ)
            а0 *Узел = список_получи(s.дети, 0) как *Узел
            з.длл = а0.текст
            з.функы = список_новый()
            для инд2 в 1..s.дети.длина:
                а *Узел = список_получи(s.дети, инд2) как *Узел
                список_добавь(з.функы, _схр(а.текст))
            список_добавь(пр.импорты, з как нат.верх)
    сух *Ктх = новый(Ктх)
    сух.ва = 0
    сух.здесь = 0
    сух.прог = пр как нат.верх
    сух.план = пусто как нат.верх
    сух.сухой = да
    тек нат.верх = СЕК_КОД как нат.верх
    смещк нат.верх = 0
    смещд нат.верх = 0
    для инд в 0..stmts.длина:
        s = список_получи(stmts, инд) как *Узел
        если s.вид == И_МЕТКА:
            если _есть_имя(пр, s.текст):
                иск_ош("повторное имя", s.строка, s.столб)
            м *МеткаЗ = новый(МеткаЗ)
            м.имя = s.текст
            м.сек = тек
            если тек == СЕК_КОД:
                м.смещ = смещк
            иначе:
                м.смещ = смещд
            список_добавь(пр.метки, м как нат.верх)
        а если s.вид == И_РАВНО:
            если _есть_имя(пр, s.текст):
                иск_ош("повторное имя", s.строка, s.столб)
            кз *КонстЗ = новый(КонстЗ)
            кз.имя = s.текст
            кз.выр = s.а
            кз.сек = тек
            если тек == СЕК_КОД:
                кз.смещ = смещк
            иначе:
                кз.смещ = смещд
            список_добавь(пр.консты, кз как нат.верх)
        а если s.вид == И_ДИР:
            имя стр = s.текст
            если стр_равны(имя, "СЕКЦИЯ"):
                а = список_получи(s.дети, 0) как *Узел
                ключ нат.верх = _имя_секции(а.текст)
                если ключ == 0xFFFFFFFFFFFFFFFF:
                    иск_ош("неизвестная секция (код/данные)", s.строка, s.столб)
                тек = ключ
            а если стр_равны(имя, "ИМПОРТ"):
                # уже собраны при предсканировании
                тек = тек
            а если стр_равны(имя, "ВХОД"):
                а = список_получи(s.дети, 0) как *Узел
                если а.вид != В_СИМ:
                    иск_ош("ВХОД: ожидалась метка", s.строка, s.столб)
                пр.вход = а.текст
            а если стр_равны(имя, "ВЫРОВНЯТЬ"):
                а = список_получи(s.дети, 0) как *Узел
                ал цел.верх = в_вычисли(а, сух)
                если ал <= 0 или (ал & (ал - 1)) != 0:
                    иск_ош("ВЫРОВНЯТЬ: степень двойки", s.строка, s.столб)
                оф нат.верх = смещк
                если тек == СЕК_ДАН:
                    оф = смещд
                пад нат.верх = ((0 - (оф как цел.верх)) % ал) как нат.верх
                р *Разм = новый(Разм)
                р.оп = s
                р.сек = тек
                р.смещ = оф
                р.разм = пад
                список_добавь(пр.placed, р как нат.верх)
                если тек == СЕК_КОД:
                    смещк += пад
                иначе:
                    смещд += пад
            иначе:
                если (стр_равны(имя, "БАЙТ") или стр_равны(имя, "СЛОВО") или
                      стр_равны(имя, "ДВСЛОВО") или стр_равны(имя, "КВАД") или
                      стр_равны(имя, "РЕЗЕРВ")):
                    разм нат.верх = _разм_данных(s, сух)
                    р = новый(Разм)
                    р.оп = s
                    р.сек = тек
                    если тек == СЕК_КОД:
                        р.смещ = смещк
                        смещк += разм
                    иначе:
                        р.смещ = смещд
                        смещд += разм
                    р.разм = разм
                    список_добавь(пр.placed, р как нат.верх)
                иначе:
                    иск_ош("директива не поддержана", s.строка, s.столб)
        а если s.вид == И_ИНСТР:
            б *Буфер = кодируй(s, сух)
            р = новый(Разм)
            р.оп = s
            р.сек = тек
            р.разм = б.длина
            если тек == СЕК_КОД:
                р.смещ = смещк
                смещк += б.длина
            иначе:
                р.смещ = смещд
                смещд += б.длина
            список_добавь(пр.placed, р как нат.верх)
    пр.разм_код = смещк
    пр.разм_дан = смещд
    если пр.вход.длина == 0:
        пр.вход = "старт"
    если _метка_ищи(пр, пр.вход) == пусто:
        иск_ош("точка входа не найдена", 0, 0)
    верни пр

функ вход_смещ(пр *Прог) нат.верх:
    # смещение точки входа в секции кода (с проверкой)
    вх *МеткаЗ = _метка_ищи(пр, пр.вход)
    если вх.сек != СЕК_КОД:
        иск_ош("точка входа должна быть в секции кода", 0, 0)
    верни вх.смещ

# --- общие хелперы записи little-endian по смещению --------------------------

функ выров(v нат.верх, а нат.верх) нат.верх:
    # выравнивание вверх до степени двойки
    верни (v + а - 1) & (0 - а)

функ уст16(д *нат.старт, поз нат.верх, v нат.верх):
    д[поз] = v как нат.старт
    д[поз + 1] = (v >> 8) как нат.старт

функ уст32(д *нат.старт, поз нат.верх, v нат.верх):
    для инд в 0..4:
        д[поз + инд] = (v >> (инд * 8)) как нат.старт

функ уст64(д *нат.старт, поз нат.верх, v нат.верх):
    для инд в 0..8:
        д[поз + инд] = (v >> (инд * 8)) как нат.старт

# --- второй проход -------------------------------------------------------------

запись Дво:
    код стр
    дан стр

функ проход2(пр *Прог, пл *План) *Дво:
    # окончательное кодирование с реальными адресами из плана
    к *Ктх = новый(Ктх)
    к.прог = пр как нат.верх
    к.план = пл как нат.верх
    к.сухой = нет
    кодб *Буфер = буф_новый()
    буф_нуль(кодб, пр.разм_код)
    данб *Буфер = буф_новый()
    буф_нуль(данб, пр.разм_дан)
    для инд в 0..пр.placed.длина:
        р *Разм = список_получи(пр.placed, инд) как *Разм
        s *Узел = р.оп
        к.ва = _сек_ва(к, р.сек) + р.смещ
        к.здесь = к.ва
        времен *Буфер = буф_новый()
        если s.вид == И_ИНСТР:
            времен = кодируй(s, к)
        а если s.вид == И_ДИР и стр_равны(s.текст, "ВЫРОВНЯТЬ"):
            буф_нуль(времен, р.разм)
        иначе:
            _код_данных(s, к, времен)
        если времен.длина != р.разм:
            иск_ош("внутренняя ошибка: размер изменился", s.строка, s.столб)
        куда *нат.старт = кодб.данные + р.смещ
        если р.сек == СЕК_ДАН:
            куда = данб.данные + р.смещ
        скопируй(куда, времен.данные, времен.длина)
    д *Дво = новый(Дво)
    д.код = стр_собери(кодб.данные, кодб.длина)
    д.дан = стр_собери(данб.данные, данб.длина)
    верни д
