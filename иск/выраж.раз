# выраж — выражения ассемблера ИСКРА.
# Числа, символы (метки/константы), $ / ЗДЕСЬ, арифметика, ~ и -.
# Выражения вычисляются на втором проходе, когда адреса меток известны.

взять основа
взять узлы

# виды узлов-выражений (диапазон 100+, чтобы не пересекаться с У_*)
конст В_ЧИСЛО = 100     # знач = число
конст В_СИМ = 101       # текст = имя метки/константы
конст В_ЗДЕСЬ = 102     # текущий адрес ($, ЗДЕСЬ)
конст В_БИН = 103       # текст = оп, а = лево, б = право
конст В_ОТР = 104       # а = выр (унарный минус)
конст В_НЕ = 105        # а = выр (побитовое НЕ ~)
конст В_ИАТ = 106       # текст = имя импорта (адрес ячейки IAT; кодер)

# контекст вычисления: заполняется сборщиком
запись Ктх:
    ва без64            # виртуальный адрес текущей инструкции
    здесь без64         # адрес точки определения (для $ в константах)
    прог без64          # *Прог сборщика
    план без64          # *План эмиттера
    сухой бул           # первый проход: символы дают 0 (размеры не зависят)

функ в_узел(вид без64) *Узел:
    верни узел(вид, 0)

# --- контекстные операции (реализация — в сборщик.раз) ----------------------
# к_символ(к, имя) -> цел64   — адрес метки / значение константы
# к_иат(к, имя) -> цел64      — VA ячейки IAT импорта
# к_импорт(к, имя) -> бул     — имя объявлено в ИМПОРТ

функ в_вычисли(у *Узел, к *Ктх) цел64:
    v := у.вид
    если v == В_ЧИСЛО:
        верни у.знач как цел64
    если v == В_СИМ:
        верни к_символ(к, у.текст)
    если v == В_ЗДЕСЬ:
        верни к.здесь как цел64
    если v == В_ИАТ:
        верни к_иат(к, у.текст)
    если v == В_ОТР:
        верни 0 - в_вычисли(у.а, к)
    если v == В_НЕ:
        верни 0 - в_вычисли(у.а, к) - 1
    если v == В_БИН:
        а := в_вычисли(у.а, к)
        б := в_вычисли(у.б, к)
        оп := у.текст
        если стр_равны(оп, "+"):
            верни а + б
        если стр_равны(оп, "-"):
            верни а - б
        если стр_равны(оп, "*"):
            верни а * б
        если стр_равны(оп, "/"):
            если б == 0:
                иск_ош("деление на ноль в выражении", у.строка, у.столб)
            верни а / б
        если стр_равны(оп, "%"):
            если б == 0:
                иск_ош("деление на ноль в выражении", у.строка, у.столб)
            верни а % б
        если стр_равны(оп, "<<"):
            верни а << б
        если стр_равны(оп, ">>"):
            верни а >> б
        если стр_равны(оп, "&"):
            верни а & б
        если стр_равны(оп, "|"):
            верни а | б
        если стр_равны(оп, "^"):
            верни а ^ б
        иск_ош("неизвестная операция в выражении", у.строка, у.столб)
    иск_ош("некорректное выражение", у.строка, у.столб)
    верни 0

функ в_есть_сим(у *Узел) бул:
    # истина, если выражение содержит символ (метку/константу/$/ИАТ)
    если у == пусто:
        верни нет
    v := у.вид
    если v == В_СИМ или v == В_ЗДЕСЬ или v == В_ИАТ:
        верни да
    если v == В_ОТР или v == В_НЕ:
        верни в_есть_сим(у.а)
    если v == В_БИН:
        верни в_есть_сим(у.а) или в_есть_сим(у.б)
    верни нет

функ в_большое(у *Узел) бул:
    # «большое» выражение: результат ≥ 2^63 или < -2^63, т.е. не помещается
    # в знаковый imm32 по модулю — нужен imm64 (B8+r).
    # В цел64 такие значения заворачиваются в отрицательные, поэтому флаг
    # хранится отдельно (знач2 у литерала).
    если у == пусто:
        верни нет
    v := у.вид
    если v == В_ЧИСЛО:
        верни у.знач2 != 0
    если v == В_СИМ или v == В_ЗДЕСЬ или v == В_ИАТ:
        верни нет
    если v == В_ОТР:
        # -(большое) — очень отрицательное: тоже не влезает в imm32
        верни в_большое(у.а)
    если v == В_НЕ:
        верни в_большое(у.а)
    если v == В_БИН:
        оп := у.текст
        если (стр_равны(оп, "&") или стр_равны(оп, "%") или
              стр_равны(оп, "/") или стр_равны(оп, ">>")):
            # операции, уменьшающие результат
            верни в_большое(у.а) и в_большое(у.б)
        верни в_большое(у.а) или в_большое(у.б)
    верни нет

функ иск_ош(сооб стр, строка без64, столб без64):
    # ошибка ассемблирования: «искра: строка N:M: сообщение»
    печать("искра: строка ")
    печать(цел_в_стр(строка как цел64))
    если столб > 0:
        печать(":")
        печать(цел_в_стр(столб как цел64))
    печать(": ")
    печать(сооб)
    печать("\n")
    выход(1)
