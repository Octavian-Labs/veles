# выраж — выражения ассемблера ИСКРА.
# Числа, символы (метки/константы), $ / ЗДЕСЬ, арифметика, ~ и -.
# Выражения вычисляются на втором проходе, когда адреса меток известны.

взять основа
взять узлы

# виды узлов-выражений (диапазон 100+, чтобы не пересекаться с У_*)
конст В_ЧИСЛО = 100     # знач = число
конст В_СИМ = 101       # текст = имя метки/константы
конст В_ЗДЕСЬ = 102     # текущий адрес ($, ЗДЕСЬ)
конст В_БИН = 103       # текст = оп, а = лево, б = право
конст В_ОТР = 104       # а = выр (унарный минус)
конст В_НЕ = 105        # а = выр (побитовое НЕ ~)
конст В_ИАТ = 106       # текст = имя импорта (адрес ячейки IAT; кодер)

# контекст вычисления: заполняется сборщиком
запись Ктх:
    ва размер            # виртуальный адрес текущей инструкции
    здесь размер         # адрес точки определения (для $ в константах)
    прог размер          # *Прог сборщика
    план размер          # *План эмиттера
    сухой лог           # первый проход: символы дают 0 (размеры не зависят)

функ в_узел(вид нат.верх) *Узел:
    верни узел(вид, 0)

# --- контекстные операции (реализация — в сборщик.раз) ----------------------
# к_символ(к, имя) -> цел.верх   — адрес метки / значение константы
# к_иат(к, имя) -> цел.верх      — VA ячейки IAT импорта
# к_импорт(к, имя) -> лог     — имя объявлено в ИМПОРТ

функ в_вычисли(уз *Узел, ктх *Ктх) цел.верх:
    вид нат.верх = уз.вид
    если вид == В_ЧИСЛО:
        верни уз.знач как цел.верх
    если вид == В_СИМ:
        верни к_символ(ктх, уз.текст)
    если вид == В_ЗДЕСЬ:
        верни ктх.здесь как цел.верх
    если вид == В_ИАТ:
        верни к_иат(ктх, уз.текст)
    если вид == В_ОТР:
        верни 0 - в_вычисли(уз.а, ктх)
    если вид == В_НЕ:
        верни 0 - в_вычисли(уз.а, ктх) - 1
    если вид == В_БИН:
        лев цел.верх = в_вычисли(уз.а, ктх)
        прав цел.верх = в_вычисли(уз.б, ктх)
        операция стр = уз.текст
        если стр_равны(операция, "+"):
            верни лев + прав
        если стр_равны(операция, "-"):
            верни лев - прав
        если стр_равны(операция, "*"):
            верни лев * прав
        если стр_равны(операция, "/"):
            если прав == 0:
                иск_ош("деление на ноль в выражении", уз.строка, уз.столб)
            верни лев / прав
        если стр_равны(операция, "%"):
            если прав == 0:
                иск_ош("деление на ноль в выражении", уз.строка, уз.столб)
            верни лев % прав
        если стр_равны(операция, "<<"):
            верни лев << прав
        если стр_равны(операция, ">>"):
            верни лев >> прав
        если стр_равны(операция, "&"):
            верни лев & прав
        если стр_равны(операция, "|"):
            верни лев | прав
        если стр_равны(операция, "^"):
            верни лев ^ прав
        иск_ош("неизвестная операция в выражении", уз.строка, уз.столб)
    иск_ош("некорректное выражение", уз.строка, уз.столб)
    верни 0

функ в_есть_сим(уз *Узел) лог:
    # истина, если выражение содержит символ (метку/константу/$/ИАТ)
    если уз == пусто:
        верни нет
    вид нат.верх = уз.вид
    если вид == В_СИМ или вид == В_ЗДЕСЬ или вид == В_ИАТ:
        верни да
    если вид == В_ОТР или вид == В_НЕ:
        верни в_есть_сим(уз.а)
    если вид == В_БИН:
        верни в_есть_сим(уз.а) или в_есть_сим(уз.б)
    верни нет

функ в_большое(уз *Узел) лог:
    # «большое» выражение: результат ≥ 2^63 или < -2^63, т.е. не помещается
    # в знаковый imm32 по модулю — нужен imm64 (B8+r).
    # В цел.верх такие значения заворачиваются в отрицательные, поэтому флаг
    # хранится отдельно (знач2 у литерала).
    если уз == пусто:
        верни нет
    вид нат.верх = уз.вид
    если вид == В_ЧИСЛО:
        верни уз.знач2 != 0
    если вид == В_СИМ или вид == В_ЗДЕСЬ или вид == В_ИАТ:
        верни нет
    если вид == В_ОТР:
        # -(большое) — очень отрицательное: тоже не влезает в imm32
        верни в_большое(уз.а)
    если вид == В_НЕ:
        верни в_большое(уз.а)
    если вид == В_БИН:
        операция стр = уз.текст
        если (стр_равны(операция, "&") или стр_равны(операция, "%") или
              стр_равны(операция, "/") или стр_равны(операция, ">>")):
            # операции, уменьшающие результат
            верни в_большое(уз.а) и в_большое(уз.б)
        верни в_большое(уз.а) или в_большое(уз.б)
    верни нет

функ иск_ош(сооб стр, строка размер, столб размер):
    # ошибка ассемблирования: «искра: строка N:M: сообщение»
    печать("искра: строка ")
    печать(цел_в_стр(строка как цел.верх))
    если столб > 0:
        печать(":")
        печать(цел_в_стр(столб как цел.верх))
    печать(": ")
    печать(сооб)
    печать("\n")
    выход(1)
