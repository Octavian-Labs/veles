# ипп — интерфейс программного пайплайна ИСКРЫ (фасад).
# Единая точка входа: текст/узлы → *Прог → *План → *Дво → байты образа.
# Искра.exe и разум.exe — тонкие драйверы над этим модулем (дизайн:
# docs/06-пайплайн.md). Цель задаётся явно или прагмой «;цель» в шапке.

взять основа
взять узлы
взять выраж, лексер, парсер, кодер, сборщик, пе, эльф, махо

открыто конст ИСКРА_ВЕРСИЯ = 1   # актуальная версия канона ИСКРЫ (канон §11)

открыто запись Прагмы:
    цель стр                 # windows|linux|macos
    версия размер            # «;версия N» или ИСКРА_ВЕРСИЯ

функ _строка_n(исх стр, нужная размер) стр:
    # строка номер нужная (с 1) без хвостового \r; пустая, если её нет
    ном размер = 1
    нач размер = 0
    поз размер = 0
    пока поз <= исх.длина:
        если поз == исх.длина или исх.данные[поз] == 10:
            если ном == нужная:
                кон размер = поз
                если кон > нач и исх.данные[кон - 1] == 13:
                    кон -= 1
                верни стр_срез(исх, нач, кон)
            ном += 1
            нач = поз + 1
        поз += 1
    верни стр_срез(исх, 0, 0)

функ _пробел(симв нат.старт) лог:
    верни симв == ' ' или симв == 9 или симв == 13

функ _проп_пробелы(строка стр, поз размер) размер:
    пока поз < строка.длина и _пробел(строка.данные[поз]):
        поз += 1
    верни поз

функ _слово(строка стр, нач размер) стр:
    # слово из позиции нач до пробела/конца
    конец размер = нач
    пока конец < строка.длина и не _пробел(строка.данные[конец]) и строка.данные[конец] != ';':
        конец += 1
    верни стр_срез(строка, нач, конец)

открыто функ ипп_прагмы(исх стр) *Прагмы:
    # ведущий блок «;»-строк: прагмы «;слово» без пробела после «;»;
    # «; комментарий» с пробелом — обычный комментарий, пропускаем.
    # Неизвестные прагмы игнорируются — совместимость вперёд.
    праг *Прагмы = новый(Прагмы)
    праг.цель = "windows"
    праг.версия = ИСКРА_ВЕРСИЯ
    ном размер = 1
    вечно:
        строка стр = _строка_n(исх, ном)
        поз размер = _проп_пробелы(строка, 0)
        если поз >= строка.длина или строка.данные[поз] != ';':
            хватит
        пока поз < строка.длина:
            если строка.данные[поз] != ';':
                поз += 1
                следующий
            поз += 1
            если поз >= строка.длина или _пробел(строка.данные[поз]):
                следующий
            имя стр = _слово(строка, поз)
            поз += имя.длина
            если стр_равны_нр(имя, "цель"):
                поз = _проп_пробелы(строка, поз)
                тг стр = _слово(строка, поз)
                если стр_равны_нр(тг, "linux"):
                    праг.цель = "linux"
                а если стр_равны_нр(тг, "macos"):
                    праг.цель = "macos"
                иначе:
                    праг.цель = "windows"
            а если стр_равны_нр(имя, "версия"):
                поз = _проп_пробелы(строка, поз)
                нач размер = поз
                пока поз < строка.длина и строка.данные[поз] >= '0' и строка.данные[поз] <= '9':
                    поз += 1
                если поз == нач:
                    иск_ош("прагма «;версия» требует номер: «;версия N»", ном, 0)
                вер размер = стр_число(стр_срез(строка, нач, поз)) как размер
                если вер == 0:
                    иск_ош("«;версия 0» недопустима — нумерация канона с 1", ном, 0)
                если вер > ИСКРА_ВЕРСИЯ:
                    иск_ош(стр_склей(стр_склей("«;версия ", без_в_стр(вер)),
                        "» новее канона искры — обновите искру"), ном, 0)
                праг.версия = вер
        ном += 1
    верни праг

открыто функ ипп_план(пр *Прог, цель стр) *План:
    # раскладка файла: VA секций, IAT, смещения — по целевой ОС
    смещ_вход размер = вход_смещ(пр)
    пл *План = пусто как *План
    если стр_равны(цель, "macos"):
        пл = махо_план(пр.разм_код, пр.разм_дан, пр.импорты, смещ_вход)
    а если стр_равны(цель, "linux"):
        пл = эльф_план(пр.разм_код, пр.разм_дан, пр.импорты, смещ_вход)
    иначе:
        пл = пе_план(пр.разм_код, пр.разм_дан, пр.импорты, смещ_вход)
    пл.вид = ПЛАН_ФАЙЛ
    верни пл

открыто функ ипп_образ(пл *План, дво *Дво, цель стр) стр:
    # байты исполняемого файла по плану и секциям
    если стр_равны(цель, "macos"):
        верни махо_строй(пл, дво.код, дво.дан)
    если стр_равны(цель, "linux"):
        верни эльф_строй(пл, дво.код, дво.дан)
    верни пе_строй(пл, дво.код, дво.дан)

открыто запись ИппСбор:
    прог *Прог              # раскладка: метки, импорты, секции
    план *План              # план цели (файл | память)
    дво *Дво                # секции кода и данных

открыто функ ипп_конвей(инструкции *Список, цель стр) *ИппСбор:
    # узлы → прог + план + дво; полный результат для файла и JIT
    сб *ИппСбор = новый(ИппСбор)
    сб.прог = проход1(инструкции)
    сб.план = ипп_план(сб.прог, цель)
    сб.дво = проход2(сб.прог, сб.план)
    верни сб

открыто функ ипп_собери_узлы(инструкции *Список, цель стр) стр:
    # узлы → байты исполняемого образа
    сб *ИппСбор = ипп_конвей(инструкции, цель)
    верни ипп_образ(сб.план, сб.дво, цель)

открыто функ ипп_собери(исх стр, цель стр) стр:
    # текст .иск → байты исполняемого образа;
    # пустая цель — из прагмы «;цель» (умолчание windows)
    тг стр = цель
    если тг.длина == 0:
        тг = ипп_прагмы(исх).цель
    верни ипп_собери_узлы(ип_разбери(исх), тг)
