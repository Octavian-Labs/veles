# иб — билдер эмиссии ИСКРЫ: шов «фронтенд → бэкенд» (docs/06-пайплайн.md).
#
# Режим чистого текста (позиции = нет): иб_эми/иб_метка дают байт-в-байт
# тот же .иск, что и раньше. Режим позиций (позиции = да): перед строкой
# при смене позиции вставляется комментарий-маркер «;раз <модуль>|<строка>»;
# парсер забирает его в узел.исх_файл/исх_строка — так машинные инструкции
# узнают своё место в исходнике .раз (диагностика, карта отладки СЛЕДа).
#
# Маркеры — комментарии: текстовый вывод разума и .рми-фрагменты остаются
# совместимыми; оптимизатор видит их как барьер-строки (не инструкции).

взять основа
взять буфер
взять стр

открыто запись Иб:
    буф *Буфер
    позиции лог         # эмитить маркеры «;раз»
    файл стр            # модуль текущей позиции
    строка размер       # строка текущей позиции в .раз
    пом_файл стр        # позиция последнего эмитированного маркера
    пом_строка размер

открыто функ иб_новый(буф *Буфер, позиции лог) *Иб:
    иб *Иб = новый(Иб)
    иб.буф = буф
    иб.позиции = позиции
    иб.файл = ""
    иб.строка = 0
    иб.пом_файл = ""
    иб.пом_строка = 0
    верни иб

открыто функ (иб *Иб) иб_поз(файл стр, строка размер):
    # сменить текущую исходную позицию (вызывает фронтенд на операторе)
    иб.файл = файл
    иб.строка = строка

открыто функ (иб *Иб) иб_маркер():
    если не иб.позиции или иб.строка == 0:
        верни
    если иб.строка == иб.пом_строка и стр_равны(иб.файл, иб.пом_файл):
        верни
    иб.пом_файл = иб.файл
    иб.пом_строка = иб.строка
    буф_добавь(иб.буф, ";раз ")
    буф_добавь(иб.буф, иб.файл)
    буф_сим(иб.буф, '|')
    буф_добавь(иб.буф, без_в_стр(иб.строка))
    буф_сим(иб.буф, 10)

открыто функ (иб *Иб) иб_эми(текст стр):
    # инструкция с каноническим отступом
    иб.иб_маркер()
    буф_добавь(иб.буф, "    ")
    буф_добавь(иб.буф, текст)
    буф_сим(иб.буф, 10)

открыто функ (иб *Иб) иб_метка(имя стр):
    иб.иб_маркер()
    буф_добавь(иб.буф, имя)
    буф_добавь(иб.буф, ":\n")

открыто функ (иб *Иб) иб_сырой(текст стр):
    # строка как есть, без отступа и маркера (шапки, директивы секций)
    буф_добавь(иб.буф, текст)
    буф_сим(иб.буф, 10)
