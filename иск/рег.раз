# рег — таблица регистров x86-64 с русскими псевдонимами.
#
#   АКК — rax (аккумулятор)      УКС — rsp (указатель стека)
#   СЧТ — rcx (счётчик)          УКК — rbp (указатель кадра)
#   ДАН — rdx (данные)           ИСТ — rsi (источник)
#   БАЗ — rbx (база)             ПРМ — rdi (приёмник)
#   Р8..Р15 — r8..r15
#
# Суффиксы размера для русских имён: без суффикса — 64 бита,
# М — 32 бита (младший), П — 16 бит (половина), Б — 8 бит (байт).
# Латинские имена: rax/../al.. + r8..r15 с суффиксами d/w/b.

взять основа

запись РегЗап:
    имя стр             # имя в нижнем регистре
    ном нат.верх           # номер регистра 0..15
    разм нат.верх          # размер в байтах: 1, 2, 4, 8
    рекс лог            # требуется REX даже без расширенных бит

функ _рз(т *Список, имя стр, ном нат.верх, разм нат.верх, рекс лог):
    з *РегЗап = новый(РегЗап)
    з.имя = имя
    з.ном = ном
    з.разм = разм
    з.рекс = рекс
    список_добавь(т, з как нат.верх)

функ _суфф(база стр, разм нат.верх) стр:
    если разм == 8:
        верни база
    если разм == 4:
        верни стр_склей(база, "м")
    если разм == 2:
        верни стр_склей(база, "п")
    верни стр_склей(база, "б")

функ рег_таб() *Список:
    # строит полную таблицу регистров (список *РегЗап)
    т *Список = список_новый()
    # латинские канонические имена rax..rdi по размерам
    лат8 *Список = список_новый()
    список_добавь(лат8, "rax" как нат.верх)
    список_добавь(лат8, "rcx" как нат.верх)
    список_добавь(лат8, "rdx" как нат.верх)
    список_добавь(лат8, "rbx" как нат.верх)
    список_добавь(лат8, "rsp" как нат.верх)
    список_добавь(лат8, "rbp" как нат.верх)
    список_добавь(лат8, "rsi" как нат.верх)
    список_добавь(лат8, "rdi" как нат.верх)
    лат4 *Список = список_новый()
    список_добавь(лат4, "eax" как нат.верх)
    список_добавь(лат4, "ecx" как нат.верх)
    список_добавь(лат4, "edx" как нат.верх)
    список_добавь(лат4, "ebx" как нат.верх)
    список_добавь(лат4, "esp" как нат.верх)
    список_добавь(лат4, "ebp" как нат.верх)
    список_добавь(лат4, "esi" как нат.верх)
    список_добавь(лат4, "edi" как нат.верх)
    лат2 *Список = список_новый()
    список_добавь(лат2, "ax" как нат.верх)
    список_добавь(лат2, "cx" как нат.верх)
    список_добавь(лат2, "dx" как нат.верх)
    список_добавь(лат2, "bx" как нат.верх)
    список_добавь(лат2, "sp" как нат.верх)
    список_добавь(лат2, "bp" как нат.верх)
    список_добавь(лат2, "si" как нат.верх)
    список_добавь(лат2, "di" как нат.верх)
    лат1 *Список = список_новый()
    список_добавь(лат1, "al" как нат.верх)
    список_добавь(лат1, "cl" как нат.верх)
    список_добавь(лат1, "dl" как нат.верх)
    список_добавь(лат1, "bl" как нат.верх)
    список_добавь(лат1, "spl" как нат.верх)
    список_добавь(лат1, "bpl" как нат.верх)
    список_добавь(лат1, "sil" как нат.верх)
    список_добавь(лат1, "dil" как нат.верх)
    для ном в 0..8:
        _рз(т, список_получи(лат8, ном) как стр, ном, 8, нет)
        _рз(т, список_получи(лат4, ном) как стр, ном, 4, нет)
        _рз(т, список_получи(лат2, ном) как стр, ном, 2, нет)
        # spl/bpl/sil/dil требуют байта REX даже без расширенных бит
        _рз(т, список_получи(лат1, ном) как стр, ном, 1, ном >= 4)
    для ном в 8..16:
        б стр = стр_склей("r", цел_в_стр(ном как цел.верх))
        _рз(т, б, ном, 8, нет)
        _рз(т, стр_склей(б, "d"), ном, 4, нет)
        _рз(т, стр_склей(б, "w"), ном, 2, нет)
        _рз(т, стр_склей(б, "b"), ном, 1, да)
    # русские псевдонимы rax..rdi (имена храним в нижнем регистре)
    рус *Список = список_новый()
    список_добавь(рус, "акк" как нат.верх)
    список_добавь(рус, "счт" как нат.верх)
    список_добавь(рус, "дан" как нат.верх)
    список_добавь(рус, "баз" как нат.верх)
    список_добавь(рус, "укс" как нат.верх)
    список_добавь(рус, "укк" как нат.верх)
    список_добавь(рус, "ист" как нат.верх)
    список_добавь(рус, "прм" как нат.верх)
    для ном в 0..8:
        а стр = список_получи(рус, ном) как стр
        _рз(т, а, ном, 8, нет)
        _рз(т, _суфф(а, 4), ном, 4, нет)
        _рз(т, _суфф(а, 2), ном, 2, нет)
        _рз(т, _суфф(а, 1), ном, 1, ном >= 4)
    для ном в 8..16:
        а = стр_склей("р", цел_в_стр(ном как цел.верх))
        _рз(т, а, ном, 8, нет)
        _рз(т, _суфф(а, 4), ном, 4, да)
        _рз(т, _суфф(а, 2), ном, 2, да)
        _рз(т, _суфф(а, 1), ном, 1, да)
    верни т

функ рег_ищи(т *Список, имя стр) *РегЗап:
    # находит регистр по имени (регистронезависимо); пусто — не регистр
    ниж стр = стр_вниз(имя)
    для инд в 0..т.длина:
        з *РегЗап = список_получи(т, инд) как *РегЗап
        если стр_равны(з.имя, ниж):
            верни з
    верни пусто как *РегЗап
