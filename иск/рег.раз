# рег — таблица регистров x86-64 с русскими псевдонимами.
#
#   АКК — rax (аккумулятор)      УКС — rsp (указатель стека)
#   СЧТ — rcx (счётчик)          УКК — rbp (указатель кадра)
#   ДАН — rdx (данные)           ИСТ — rsi (источник)
#   БАЗ — rbx (база)             ПРМ — rdi (приёмник)
#   Р8..Р15 — r8..r15
#   ПЛАВ0..ПЛАВ15 — xmm0..xmm15 (медиа-регистры, 128 бит)
#
# Суффиксы размера для русских имён: без суффикса — 64 бита,
# М — 32 бита (младший), П — 16 бит (половина), Б — 8 бит (байт).
# Латинские имена: rax/../al.. + r8..r15 с суффиксами d/w/b.
# У ПЛАВ/xmm суффиксов размера нет: разм = 16 — признак класса xmm.

взять основа

открыто запись РегЗап:
    имя стр             # имя в нижнем регистре
    ном размер           # номер регистра 0..15
    разм размер          # размер в байтах: 1, 2, 4, 8; 16 — xmm
    рекс лог            # требуется REX даже без расширенных бит

открыто функ _рз(таб *Список, имя стр, ном размер, разм размер, рекс лог):
    зап *РегЗап = новый(РегЗап)
    зап.имя = имя
    зап.ном = ном
    зап.разм = разм
    зап.рекс = рекс
    список_добавь(таб, зап как размер)

открыто функ _суфф(база стр, разм размер) стр:
    если разм == 8:
        верни база
    если разм == 4:
        верни стр_склей(база, "м")
    если разм == 2:
        верни стр_склей(база, "п")
    верни стр_склей(база, "б")

открыто функ рег_таб() *Список:
    # строит полную таблицу регистров (список *РегЗап)
    таб *Список = список_новый()
    # латинские канонические имена rax..rdi по размерам
    лат8 *Список = список_новый()
    список_добавь(лат8, "rax" как размер)
    список_добавь(лат8, "rcx" как размер)
    список_добавь(лат8, "rdx" как размер)
    список_добавь(лат8, "rbx" как размер)
    список_добавь(лат8, "rsp" как размер)
    список_добавь(лат8, "rbp" как размер)
    список_добавь(лат8, "rsi" как размер)
    список_добавь(лат8, "rdi" как размер)
    лат4 *Список = список_новый()
    список_добавь(лат4, "eax" как размер)
    список_добавь(лат4, "ecx" как размер)
    список_добавь(лат4, "edx" как размер)
    список_добавь(лат4, "ebx" как размер)
    список_добавь(лат4, "esp" как размер)
    список_добавь(лат4, "ebp" как размер)
    список_добавь(лат4, "esi" как размер)
    список_добавь(лат4, "edi" как размер)
    лат2 *Список = список_новый()
    список_добавь(лат2, "ax" как размер)
    список_добавь(лат2, "cx" как размер)
    список_добавь(лат2, "dx" как размер)
    список_добавь(лат2, "bx" как размер)
    список_добавь(лат2, "sp" как размер)
    список_добавь(лат2, "bp" как размер)
    список_добавь(лат2, "si" как размер)
    список_добавь(лат2, "di" как размер)
    лат1 *Список = список_новый()
    список_добавь(лат1, "al" как размер)
    список_добавь(лат1, "cl" как размер)
    список_добавь(лат1, "dl" как размер)
    список_добавь(лат1, "bl" как размер)
    список_добавь(лат1, "spl" как размер)
    список_добавь(лат1, "bpl" как размер)
    список_добавь(лат1, "sil" как размер)
    список_добавь(лат1, "dil" как размер)
    для ном в 0..8:
        _рз(таб, список_получи(лат8, ном) как стр, ном, 8, нет)
        _рз(таб, список_получи(лат4, ном) как стр, ном, 4, нет)
        _рз(таб, список_получи(лат2, ном) как стр, ном, 2, нет)
        # spl/bpl/sil/dil требуют байта REX даже без расширенных бит
        _рз(таб, список_получи(лат1, ном) как стр, ном, 1, ном >= 4)
    для ном в 8..16:
        лат стр = стр_склей("r", цел_в_стр(ном как цел.верх))
        _рз(таб, лат, ном, 8, нет)
        _рз(таб, стр_склей(лат, "d"), ном, 4, нет)
        _рз(таб, стр_склей(лат, "w"), ном, 2, нет)
        _рз(таб, стр_склей(лат, "b"), ном, 1, да)
    # русские псевдонимы rax..rdi (имена храним в нижнем регистре)
    рус *Список = список_новый()
    список_добавь(рус, "акк" как размер)
    список_добавь(рус, "счт" как размер)
    список_добавь(рус, "дан" как размер)
    список_добавь(рус, "баз" как размер)
    список_добавь(рус, "укс" как размер)
    список_добавь(рус, "укк" как размер)
    список_добавь(рус, "ист" как размер)
    список_добавь(рус, "прм" как размер)
    для ном в 0..8:
        псевд стр = список_получи(рус, ном) как стр
        _рз(таб, псевд, ном, 8, нет)
        _рз(таб, _суфф(псевд, 4), ном, 4, нет)
        _рз(таб, _суфф(псевд, 2), ном, 2, нет)
        _рз(таб, _суфф(псевд, 1), ном, 1, ном >= 4)
    для ном в 8..16:
        псевд = стр_склей("р", цел_в_стр(ном как цел.верх))
        _рз(таб, псевд, ном, 8, нет)
        _рз(таб, _суфф(псевд, 4), ном, 4, да)
        _рз(таб, _суфф(псевд, 2), ном, 2, да)
        _рз(таб, _суфф(псевд, 1), ном, 1, да)
    # медиа-регистры xmm0..xmm15: разм = 16 — признак класса xmm
    для ном в 0..16:
        _рз(таб, стр_склей("xmm", цел_в_стр(ном как цел.верх)), ном, 16, нет)
        _рз(таб, стр_склей("плав", цел_в_стр(ном как цел.верх)), ном, 16, нет)
    верни таб

открыто функ рег_ищи(таб *Список, имя стр) *РегЗап:
    # находит регистр по имени (регистронезависимо); пусто — не регистр
    ниж стр = стр_вниз(имя)
    для инд в 0..таб.длина:
        зап *РегЗап = список_получи(таб, инд) как *РегЗап
        если стр_равны(зап.имя, ниж):
            верни зап
    верни пусто как *РегЗап
