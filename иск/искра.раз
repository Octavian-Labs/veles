# искра — ассемблер ИСКРА, написанный на РАЗУМЕ.
# Использование: искра.exe < исход.иск > выход.exe
# Цель задаётся прагмой в первой строке исходника: «;цель linux».
# По умолчанию — windows.

взять основа
взять выраж, лексер, парсер, кодер, сборщик, пе, эльф, махо

функ _первая_строка(исх стр) стр:
    n нат.верх = исх.длина
    для поз в 0..n:
        если исх.данные[поз] == 10:
            верни стр_срез(исх, 0, поз)
    верни исх

функ _пробел(б нат.старт) лог:
    верни б == ' ' или б == 9 или б == 13

функ _слово(с стр, i нат.верх) стр:
    # слово из позиции i до пробела/конца
    кон нат.верх = i
    пока кон < с.длина и не _пробел(с.данные[кон]) и с.данные[кон] != ';':
        кон += 1
    верни стр_срез(с, i, кон)

функ _цель_из(исх стр) стр:
    # разбирает прагму «;цель <имя>» в первой строке; иначе windows
    с стр = _первая_строка(исх)
    поз нат.верх = 0
    пока поз < с.длина и _пробел(с.данные[поз]):
        поз += 1
    если поз >= с.длина или с.данные[поз] != ';':
        верни "windows"
    поз += 1
    пока поз < с.длина и _пробел(с.данные[поз]):
        поз += 1
    если не стр_равны_нр(_слово(с, поз), "цель"):
        верни "windows"
    поз += 8                              # длина «цель» в байтах UTF-8
    пока поз < с.длина и _пробел(с.данные[поз]):
        поз += 1
    имя стр = _слово(с, поз)
    если стр_равны_нр(имя, "linux"):
        верни "linux"
    если стр_равны_нр(имя, "macos"):
        верни "macos"
    верни "windows"

функ главная() цел.верх:
    исх стр = ввод()
    цель стр = _цель_из(исх)
    stmts *Список = ип_разбери(исх)
    пр *Прог = проход1(stmts)
    есм нат.верх = вход_смещ(пр)
    пл *План = пусто как *План
    если стр_равны(цель, "windows"):
        пл = пе_план(пр.разм_код, пр.разм_дан, пр.импорты, есм)
    а если стр_равны(цель, "macos"):
        пл = махо_план(пр.разм_код, пр.разм_дан, пр.импорты, есм)
    иначе:
        пл = эльф_план(пр.разм_код, пр.разм_дан, пр.импорты, есм)
    д *Дво = проход2(пр, пл)
    если стр_равны(цель, "windows"):
        печать(пе_строй(пл, д.код, д.дан))
    а если стр_равны(цель, "macos"):
        печать(махо_строй(пл, д.код, д.дан))
    иначе:
        печать(эльф_строй(пл, д.код, д.дан))
    верни 0
