# искра — ассемблер ИСКРА, написанный на РАЗУМЕ.
# Использование: искра.exe < исход.иск > выход.exe
# Цель задаётся прагмой в первой строке исходника: «;цель linux».
# По умолчанию — windows.

взять основа
взять выраж, лексер, парсер, кодер, сборщик, пе, эльф, махо

функ _первая_строка(исх стр) стр:
    дл размер = исх.длина
    для поз в 0..дл:
        если исх.данные[поз] == 10:
            верни стр_срез(исх, 0, поз)
    верни исх

функ _пробел(симв нат.старт) лог:
    верни симв == ' ' или симв == 9 или симв == 13

функ _слово(строка стр, нач размер) стр:
    # слово из позиции нач до пробела/конца
    конец размер = нач
    пока конец < строка.длина и не _пробел(строка.данные[конец]) и строка.данные[конец] != ';':
        конец += 1
    верни стр_срез(строка, нач, конец)

функ _цель_из(исх стр) стр:
    # разбирает прагму «;цель <имя>» в первой строке; иначе windows
    строка стр = _первая_строка(исх)
    поз размер = 0
    пока поз < строка.длина и _пробел(строка.данные[поз]):
        поз += 1
    если поз >= строка.длина или строка.данные[поз] != ';':
        верни "windows"
    поз += 1
    пока поз < строка.длина и _пробел(строка.данные[поз]):
        поз += 1
    если не стр_равны_нр(_слово(строка, поз), "цель"):
        верни "windows"
    поз += 8                              # длина «цель» в байтах UTF-8
    пока поз < строка.длина и _пробел(строка.данные[поз]):
        поз += 1
    имя стр = _слово(строка, поз)
    если стр_равны_нр(имя, "linux"):
        верни "linux"
    если стр_равны_нр(имя, "macos"):
        верни "macos"
    верни "windows"

функ главная() цел.верх:
    исх стр = ввод()
    цель стр = _цель_из(исх)
    инструкции *Список = ип_разбери(исх)
    пр *Прог = проход1(инструкции)
    смещ_вход размер = вход_смещ(пр)
    пл *План = пусто как *План
    если стр_равны(цель, "windows"):
        пл = пе_план(пр.разм_код, пр.разм_дан, пр.импорты, смещ_вход)
    а если стр_равны(цель, "macos"):
        пл = махо_план(пр.разм_код, пр.разм_дан, пр.импорты, смещ_вход)
    иначе:
        пл = эльф_план(пр.разм_код, пр.разм_дан, пр.импорты, смещ_вход)
    дво *Дво = проход2(пр, пл)
    если стр_равны(цель, "windows"):
        печать(пе_строй(пл, дво.код, дво.дан))
    а если стр_равны(цель, "macos"):
        печать(махо_строй(пл, дво.код, дво.дан))
    иначе:
        печать(эльф_строй(пл, дво.код, дво.дан))
    верни 0
