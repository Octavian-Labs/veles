            ктх.ва = 0
            ктх.здесь = 0
            ктх.прог = 0
            ктх.план = 0
            ктх.сухой = да
            знач цел.верх = в_вычисли(опер2.выр, ктх)
            печать("T3 v=")
            печать(цел_в_стр(знач))
            печать("\n")
            буф *Буфер = кодируй(инс, ктх)
            печать("T4 len=")
            печать(цел_в_стр(буф.длина как цел.верх))
