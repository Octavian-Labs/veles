# отладка — бисект внутри кодирования ПЕР: в_есть_сим / в_вычисли.

взять основа
взять выраж, лексер, парсер, кодер, сборщик, пе, эльф

функ главная() цел.верх:
    исх := ввод()
    stmts := ип_разбери(исх)
    для i в 0..stmts.длина:
        s := список_получи(stmts, i) как *Узел
        если s.вид == 110:
            б := список_получи(s.дети, 1) как *Опер
            печать("T1\n")
            сим := в_есть_сим(б.выр)
            печать("T2 сим=")
            печать(цел_в_стр(сим как цел.верх))
            печать("\n")
            к *Ктх = новый(Ктх)
            к.ва = 0
            к.здесь = 0
            к.прог = 0
            к.план = 0
            к.сухой = да
            v := в_вычисли(б.выр, к)
            печать("T3 v=")
            печать(цел_в_стр(v))
            печать("\n")
            бб := кодируй(s, к)
            печать("T4 len=")
            печать(цел_в_стр(бб.длина как цел.верх))
            печать("\n")
    верни 0
