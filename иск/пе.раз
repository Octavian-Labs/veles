# пе — эмиттер PE64 для Windows.
#
# Формат: PE32+ (x86-64). База образа 0x140000000,
# выравнивание секций 0x1000, выравнивание в файле 0x200.
# Импорты в .data: дескрипторы -> ILT -> IAT -> hint/name -> имена DLL.

взять основа
взять сборщик      # План, Блоб, ИмпЯч, ИмпЗ, уст*, выров

конст ПЕ_ФВЫР = 0x200
конст ПЕ_СВЫР = 0x1000
конст ПЕ_БАЗА = 0x140000000
конст ПЕ_ТЕКСТ = 0x1000
конст ПЕ_ЛФАНЬЮ = 0x80

функ пе_план(разм_код нат.верх, разм_дан нат.верх, импорты *Список,
             вход_смещ нат.верх) *План:
    # назначает RVA секций и ячеек IAT
    пл *План = новый(План)
    пл.иат = список_новый()
    пл.блобы = список_новый()
    пл.код_ва = (ПЕ_БАЗА + ПЕ_ТЕКСТ) как нат.верх
    пл.есть_дан = разм_дан > 0 или импорты.длина > 0
    пл.дан_рва = 0
    если пл.есть_дан:
        макс нат.верх = разм_код
        если макс == 0:
            макс = 1
        пл.дан_рва = (ПЕ_ТЕКСТ + выров(макс, ПЕ_СВЫР)) как нат.верх
    пл.дан_ва = (ПЕ_БАЗА как нат.верх) + пл.дан_рва
    пл.разм_дан = разм_дан
    пл.деск_рва = 0
    пл.деск_разм = 0
    пл.иат_рва = 0
    пл.иат_разм = 0
    пл.вход_рва = (ПЕ_ТЕКСТ + вход_смещ) как нат.верх
    если импорты.длина == 0:
        верни пл
    поз нат.верх = выров(разм_дан, 8)
    # дескрипторы: по одному на DLL + нулевой терминатор
    деск_смещ нат.верх = поз
    поз += (импорты.длина + 1) * 20
    # смещения таблиц ILT и IAT
    илт *Список = список_новый()
    иат *Список = список_новый()
    для инд в 0..импорты.длина:
        имп *ИмпЗ = список_получи(импорты, инд) как *ИмпЗ
        список_добавь(илт, поз)
        поз += (имп.функы.длина + 1) * 8
    для инд в 0..импорты.длина:
        имп = список_получи(импорты, инд) как *ИмпЗ
        список_добавь(иат, поз)
        поз += (имп.функы.длина + 1) * 8
    # hint/name записи и имена DLL
    хинт *Список = список_новый()     # *ИмпЯч: имя -> RVA записи
    имена *Список = список_новый()    # RVA имени каждой DLL
    для инд в 0..импорты.длина:
        имп = список_получи(импорты, инд) как *ИмпЗ
        для инд2 в 0..имп.функы.длина:
            функ стр = _встр(список_получи(имп.функы, инд2))
            яч *ИмпЯч = новый(ИмпЯч)
            яч.имя = функ
            яч.ва = пл.дан_рва + поз
            список_добавь(хинт, яч как нат.верх)
            буф *Буфер = буф_новый()
            буф_п16(буф, 0)            # hint = 0
            буф_добавь(буф, функ)
            буф_сим(буф, 0)
            блоб *Блоб = новый(Блоб)
            блоб.смещ = поз
            блоб.данные = буф_стр(буф)
            список_добавь(пл.блобы, блоб как нат.верх)
            поз += выров(блоб.данные.длина, 2)
    для инд в 0..импорты.длина:
        имп = список_получи(импорты, инд) как *ИмпЗ
        список_добавь(имена, пл.дан_рва + поз)
        буф = буф_новый()
        буф_добавь(буф, имп.длл)
        буф_сим(буф, 0)
        блоб = новый(Блоб)
        блоб.смещ = поз
        блоб.данные = буф_стр(буф)
        список_добавь(пл.блобы, блоб как нат.верх)
        поз += блоб.данные.длина
    # дескрипторы импорта (по 20 байт + терминатор)
    дескб *Буфер = буф_новый()
    для инд в 0..импорты.длина:
        буф_п32(дескб, пл.дан_рва + список_получи(илт, инд))   # OriginalFirstThunk
        буф_п32(дескб, 0)
        буф_п32(дескб, 0)
        буф_п32(дескб, список_получи(имена, инд))             # Name
        буф_п32(дескб, пл.дан_рва + список_получи(иат, инд))  # FirstThunk
    буф_нуль(дескб, 20)
    блоб = новый(Блоб)
    блоб.смещ = деск_смещ
    блоб.данные = буф_стр(дескб)
    список_добавь(пл.блобы, блоб как нат.верх)
    # ILT и IAT: элементы — RVA hint/name записей
    для инд в 0..импорты.длина:
        имп = список_получи(импорты, инд) как *ИмпЗ
        таб *Буфер = буф_новый()
        для инд2 в 0..имп.функы.длина:
            функ = _встр(список_получи(имп.функы, инд2))
            буф_п64(таб, _хинт(хинт, функ))
        буф_нуль(таб, 8)
        блоб = новый(Блоб)
        блоб.смещ = список_получи(илт, инд)
        блоб.данные = буф_стр(таб)
        список_добавь(пл.блобы, блоб как нат.верх)
    для инд в 0..импорты.длина:
        имп = список_получи(импорты, инд) как *ИмпЗ
        таб = буф_новый()
        для инд2 в 0..имп.функы.длина:
            функ = _встр(список_получи(имп.функы, инд2))
            буф_п64(таб, _хинт(хинт, функ))
        буф_нуль(таб, 8)
        блоб = новый(Блоб)
        блоб.смещ = список_получи(иат, инд)
        блоб.данные = буф_стр(таб)
        список_добавь(пл.блобы, блоб как нат.верх)
        для инд2 в 0..имп.функы.длина:
            # в карте IAT — абсолютные VA, нужные кодировщику
            функ = _встр(список_получи(имп.функы, инд2))
            яч = новый(ИмпЯч)
            яч.имя = функ
            яч.ва = ((ПЕ_БАЗА как нат.верх) + пл.дан_рва +
                    список_получи(иат, инд) + ((инд2 * 8) как нат.верх))
            список_добавь(пл.иат, яч как нат.верх)
    пл.деск_рва = пл.дан_рва + деск_смещ
    пл.деск_разм = (импорты.длина + 1) * 20
    пл.иат_рва = пл.дан_рва + список_получи(иат, 0)
    всех нат.верх = 0
    для инд в 0..импорты.длина:
        имп = список_получи(импорты, инд) как *ИмпЗ
        всех += имп.функы.длина + 1
    пл.иат_разм = всех * 8
    пл.разм_дан = поз
    верни пл

функ _хинт(хинт *Список, имя стр) нат.верх:
    для инд в 0..хинт.длина:
        яч *ИмпЯч = список_получи(хинт, инд) как *ИмпЯч
        если стр_равны(яч.имя, имя):
            верни яч.ва
    иск_ош("внутренняя ошибка: нет hint/name записи", 0, 0)
    верни 0

функ _секция(имя стр, вразм нат.верх, рва нат.верх, фразм нат.верх, фсмещ нат.верх,
             флаги нат.верх) стр:
    # заголовок секции PE (40 байт)
    буф *Буфер = буф_новый()
    буф_нуль(буф, 8)
    дл нат.верх = имя.длина
    если дл > 8:
        дл = 8
    скопируй(буф.данные, имя.данные, дл)
    буф_п32(буф, вразм)
    буф_п32(буф, рва)
    буф_п32(буф, фразм)
    буф_п32(буф, фсмещ)
    буф_п32(буф, 0)
    буф_п32(буф, 0)
    буф_п16(буф, 0)
    буф_п16(буф, 0)
    буф_п32(буф, флаги)
    верни буф_стр(буф)

функ пе_строй(пл *План, код стр, дан стр) стр:
    # собирает полный PE64-файл из закодированных секций
    # данные + блобы импортов
    данб *Буфер = буф_новый()
    буф_добавь(данб, дан)
    если данб.длина < пл.разм_дан:
        буф_нуль(данб, пл.разм_дан - данб.длина)
    для инд в 0..пл.блобы.длина:
        блоб *Блоб = список_получи(пл.блобы, инд) как *Блоб
        скопируй(данб.данные + блоб.смещ, блоб.данные.данные, блоб.данные.длина)
    число_сек нат.верх = 1
    если пл.есть_дан:
        число_сек = 2
    зг_разм нат.верх = выров(ПЕ_ЛФАНЬЮ + 4 + 20 + 240 + 40 * число_сек, ПЕ_ФВЫР)
    текст_файл нат.верх = зг_разм
    дан_файл нат.верх = текст_файл + выров(код.длина, ПЕ_ФВЫР)
    разм_обр нат.верх = выров(ПЕ_ТЕКСТ + выров(код.длина, ПЕ_СВЫР), ПЕ_СВЫР)
    если пл.есть_дан:
        дл_дан нат.верх = данб.длина
        если дл_дан == 0:
            дл_дан = 1
        разм_обр = пл.дан_рва + выров(дл_дан, ПЕ_СВЫР)
    вых *Буфер = буф_новый()
    # --- DOS-заголовок и стаб ---
    дос *Буфер = буф_новый()
    буф_нуль(дос, ПЕ_ЛФАНЬЮ)
    дос.данные[0] = 'M'
    дос.данные[1] = 'Z'
    стаб стр = "This program cannot be run in DOS mode.\r\r\n$"
    скопируй(дос.данные + 0x40, стаб.данные, стаб.длина)
    уст32(дос.данные, 0x3C, ПЕ_ЛФАНЬЮ)
    буф_добавь(вых, буф_стр(дос))
    # --- PE-сигнатура и заголовок файла ---
    буф_добавь(вых, "PE\x00\x00")
    буф_п16(вых, 0x8664)          # машина: x86-64
    буф_п16(вых, число_сек)
    буф_п32(вых, 0)
    буф_п32(вых, 0)
    буф_п32(вых, 0)
    буф_п16(вых, 240)             # размер опционального заголовка
    буф_п16(вых, 0x0002 | 0x0020) # EXECUTABLE_IMAGE|LARGE_ADDRESS_AWARE
    # --- опциональный заголовок PE32+ (240 байт) ---
    опц *Буфер = буф_новый()
    буф_нуль(опц, 240)
    уст16(опц.данные, 0, 0x20B)                # Magic: PE32+
    опц.данные[2] = 14
    уст32(опц.данные, 4, выров(код.длина, ПЕ_ФВЫР))
    уст32(опц.данные, 8, выров(данб.длина, ПЕ_ФВЫР))
    уст32(опц.данные, 16, пл.вход_рва)         # AddressOfEntryPoint
    уст32(опц.данные, 20, ПЕ_ТЕКСТ)            # BaseOfCode
    уст64(опц.данные, 24, ПЕ_БАЗА)             # ImageBase
    уст32(опц.данные, 32, ПЕ_СВЫР)
    уст32(опц.данные, 36, ПЕ_ФВЫР)
    уст16(опц.данные, 40, 6)                   # MajorOSVersion
    уст16(опц.данные, 48, 6)                   # MajorSubsystemVersion
    уст32(опц.данные, 56, разм_обр)            # SizeOfImage
    уст32(опц.данные, 60, зг_разм)             # SizeOfHeaders
    уст16(опц.данные, 68, 3)                   # Subsystem: консоль
    уст64(опц.данные, 72, 0x100000)            # SizeOfStackReserve
    уст64(опц.данные, 80, 0x1000)              # SizeOfStackCommit
    уст64(опц.данные, 88, 0x100000)            # SizeOfHeapReserve
    уст64(опц.данные, 96, 0x1000)              # SizeOfHeapCommit
    уст32(опц.данные, 108, 16)                 # NumberOfRvaAndSizes
    уст32(опц.данные, 112 + 8, пл.деск_рва)    # каталог [1]: импорт
    уст32(опц.данные, 112 + 12, пл.деск_разм)
    уст32(опц.данные, 112 + 96, пл.иат_рва)    # каталог [12]: IAT
    уст32(опц.данные, 112 + 100, пл.иат_разм)
    буф_добавь(вых, буф_стр(опц))
    # --- заголовки секций ---
    буф_добавь(вых, _секция(".text", код.длина, ПЕ_ТЕКСТ,
        выров(код.длина, ПЕ_ФВЫР), текст_файл, 0x60000020))
    если пл.есть_дан:
        буф_добавь(вых, _секция(".data", данб.длина, пл.дан_рва,
            выров(данб.длина, ПЕ_ФВЫР), дан_файл, 0xC0000040))
    буф_нуль(вых, зг_разм - вых.длина)
    # --- тела секций ---
    буф_добавь(вых, код)
    буф_нуль(вых, выров(код.длина, ПЕ_ФВЫР) - код.длина)
    если пл.есть_дан:
        дл нат.верх = данб.длина
        буф_добавь(вых, буф_стр(данб))
        буф_нуль(вых, выров(дл, ПЕ_ФВЫР) - дл)
    верни буф_стр(вых)
