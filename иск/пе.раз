# пе — эмиттер PE64 для Windows (порт src/iskra/emit_pe.py).
#
# Формат: PE32+ (x86-64). База образа 0x140000000,
# выравнивание секций 0x1000, выравнивание в файле 0x200.
# Импорты в .data: дескрипторы -> ILT -> IAT -> hint/name -> имена DLL.

взять основа
взять сборщик      # План, Блоб, ИмпЯч, ИмпЗ, уст*, выров

конст ПЕ_ФВЫР = 0x200
конст ПЕ_СВЫР = 0x1000
конст ПЕ_БАЗА = 0x140000000
конст ПЕ_ТЕКСТ = 0x1000
конст ПЕ_ЛФАНЬЮ = 0x80

функ пе_план(разм_код без64, разм_дан без64, импорты *Список,
             вход_смещ без64) *План:
    # назначает RVA секций и ячеек IAT
    пл *План = новый(План)
    пл.иат = список_новый()
    пл.блобы = список_новый()
    пл.код_ва = (ПЕ_БАЗА + ПЕ_ТЕКСТ) как без64
    пл.есть_дан = разм_дан > 0 или импорты.длина > 0
    пл.дан_рва = 0
    если пл.есть_дан:
        макс := разм_код
        если макс == 0:
            макс = 1
        пл.дан_рва = (ПЕ_ТЕКСТ + выров(макс, ПЕ_СВЫР)) как без64
    пл.дан_ва = (ПЕ_БАЗА как без64) + пл.дан_рва
    пл.разм_дан = разм_дан
    пл.деск_рва = 0
    пл.деск_разм = 0
    пл.иат_рва = 0
    пл.иат_разм = 0
    пл.вход_рва = (ПЕ_ТЕКСТ + вход_смещ) как без64
    если импорты.длина == 0:
        верни пл
    поз := выров(разм_дан, 8)
    # дескрипторы: по одному на DLL + нулевой терминатор
    деск_оф := поз
    поз += (импорты.длина + 1) * 20
    # смещения таблиц ILT и IAT
    ilt *Список = список_новый()
    iat *Список = список_новый()
    для i в 0..импорты.длина:
        з := список_получи(импорты, i) как *ИмпЗ
        список_добавь(ilt, поз)
        поз += (з.функы.длина + 1) * 8
    для i в 0..импорты.длина:
        з := список_получи(импорты, i) как *ИмпЗ
        список_добавь(iat, поз)
        поз += (з.функы.длина + 1) * 8
    # hint/name записи и имена DLL
    хинт *Список = список_новый()     # *ИмпЯч: имя -> RVA записи
    имена *Список = список_новый()    # RVA имени каждой DLL
    для i в 0..импорты.длина:
        з := список_получи(импорты, i) как *ИмпЗ
        для j в 0..з.функы.длина:
            ф := _встр(список_получи(з.функы, j))
            я *ИмпЯч = новый(ИмпЯч)
            я.имя = ф
            я.ва = пл.дан_рва + поз
            список_добавь(хинт, я как без64)
            б *Буфер = буф_новый()
            буф_п16(б, 0)              # hint = 0
            буф_добавь(б, ф)
            буф_сим(б, 0)
            бл *Блоб = новый(Блоб)
            бл.смещ = поз
            бл.данные = буф_стр(б)
            список_добавь(пл.блобы, бл как без64)
            поз += выров(бл.данные.длина, 2)
    для i в 0..импорты.длина:
        з := список_получи(импорты, i) как *ИмпЗ
        список_добавь(имена, пл.дан_рва + поз)
        б *Буфер = буф_новый()
        буф_добавь(б, з.длл)
        буф_сим(б, 0)
        бл *Блоб = новый(Блоб)
        бл.смещ = поз
        бл.данные = буф_стр(б)
        список_добавь(пл.блобы, бл как без64)
        поз += бл.данные.длина
    # дескрипторы импорта (по 20 байт + терминатор)
    дб *Буфер = буф_новый()
    для i в 0..импорты.длина:
        буф_п32(дб, пл.дан_рва + список_получи(ilt, i))   # OriginalFirstThunk
        буф_п32(дб, 0)
        буф_п32(дб, 0)
        буф_п32(дб, список_получи(имена, i))             # Name
        буф_п32(дб, пл.дан_рва + список_получи(iat, i))  # FirstThunk
    буф_нуль(дб, 20)
    бл *Блоб = новый(Блоб)
    бл.смещ = деск_оф
    бл.данные = буф_стр(дб)
    список_добавь(пл.блобы, бл как без64)
    # ILT и IAT: элементы — RVA hint/name записей
    для i в 0..импорты.длина:
        з := список_получи(импорты, i) как *ИмпЗ
        тб *Буфер = буф_новый()
        для j в 0..з.функы.длина:
            ф := _встр(список_получи(з.функы, j))
            буф_п64(тб, _хинт(хинт, ф))
        буф_нуль(тб, 8)
        бл *Блоб = новый(Блоб)
        бл.смещ = список_получи(ilt, i)
        бл.данные = буф_стр(тб)
        список_добавь(пл.блобы, бл как без64)
    для i в 0..импорты.длина:
        з := список_получи(импорты, i) как *ИмпЗ
        тб *Буфер = буф_новый()
        для j в 0..з.функы.длина:
            ф := _встр(список_получи(з.функы, j))
            буф_п64(тб, _хинт(хинт, ф))
        буф_нуль(тб, 8)
        бл *Блоб = новый(Блоб)
        бл.смещ = список_получи(iat, i)
        бл.данные = буф_стр(тб)
        список_добавь(пл.блобы, бл как без64)
        для j в 0..з.функы.длина:
            # в карте IAT — абсолютные VA, нужные кодировщику
            ф := _встр(список_получи(з.функы, j))
            я *ИмпЯч = новый(ИмпЯч)
            я.имя = ф
            я.ва = ((ПЕ_БАЗА как без64) + пл.дан_рва +
                    список_получи(iat, i) + ((j * 8) как без64))
            список_добавь(пл.иат, я как без64)
    пл.деск_рва = пл.дан_рва + деск_оф
    пл.деск_разм = (импорты.длина + 1) * 20
    пл.иат_рва = пл.дан_рва + список_получи(iat, 0)
    всех := 0 как без64
    для i в 0..импорты.длина:
        з := список_получи(импорты, i) как *ИмпЗ
        всех += з.функы.длина + 1
    пл.иат_разм = всех * 8
    пл.разм_дан = поз
    верни пл

функ _хинт(хинт *Список, имя стр) без64:
    для i в 0..хинт.длина:
        я := список_получи(хинт, i) как *ИмпЯч
        если стр_равны(я.имя, имя):
            верни я.ва
    иск_ош("внутренняя ошибка: нет hint/name записи", 0, 0)
    верни 0

функ _секция(имя стр, вс без64, рва без64, рразм без64, руказ без64,
             флаги без64) стр:
    # заголовок секции PE (40 байт)
    б *Буфер = буф_новый()
    буф_нуль(б, 8)
    n := имя.длина
    если n > 8:
        n = 8
    скопируй(б.данные, имя.данные, n)
    буф_п32(б, вс)
    буф_п32(б, рва)
    буф_п32(б, рразм)
    буф_п32(б, руказ)
    буф_п32(б, 0)
    буф_п32(б, 0)
    буф_п16(б, 0)
    буф_п16(б, 0)
    буф_п32(б, флаги)
    верни буф_стр(б)

функ пе_строй(пл *План, код стр, дан стр) стр:
    # собирает полный PE64-файл из закодированных секций
    # данные + блобы импортов
    дб *Буфер = буф_новый()
    буф_добавь(дб, дан)
    если дб.длина < пл.разм_дан:
        буф_нуль(дб, пл.разм_дан - дб.длина)
    для i в 0..пл.блобы.длина:
        бл := список_получи(пл.блобы, i) как *Блоб
        скопируй(дб.данные + бл.смещ, бл.данные.данные, бл.данные.длина)
    нсек := 1 как без64
    если пл.есть_дан:
        нсек = 2
    зг_разм := выров(ПЕ_ЛФАНЬЮ + 4 + 20 + 240 + 40 * нсек, ПЕ_ФВЫР)
    текст_файл := зг_разм
    дан_файл := текст_файл + выров(код.длина, ПЕ_ФВЫР)
    разм_обр := выров(ПЕ_ТЕКСТ + выров(код.длина, ПЕ_СВЫР), ПЕ_СВЫР)
    если пл.есть_дан:
        дм := дб.длина
        если дм == 0:
            дм = 1
        разм_обр = пл.дан_рва + выров(дм, ПЕ_СВЫР)
    вых *Буфер = буф_новый()
    # --- DOS-заголовок и стаб ---
    дос *Буфер = буф_новый()
    буф_нуль(дос, ПЕ_ЛФАНЬЮ)
    дос.данные[0] = 'M'
    дос.данные[1] = 'Z'
    стаб := "This program cannot be run in DOS mode.\r\r\n$"
    скопируй(дос.данные + 0x40, стаб.данные, стаб.длина)
    уст32(дос.данные, 0x3C, ПЕ_ЛФАНЬЮ)
    буф_добавь(вых, буф_стр(дос))
    # --- PE-сигнатура и заголовок файла ---
    буф_добавь(вых, "PE\x00\x00")
    буф_п16(вых, 0x8664)          # машина: x86-64
    буф_п16(вых, нсек)
    буф_п32(вых, 0)
    буф_п32(вых, 0)
    буф_п32(вых, 0)
    буф_п16(вых, 240)             # размер опционального заголовка
    буф_п16(вых, 0x0002 | 0x0020) # EXECUTABLE_IMAGE|LARGE_ADDRESS_AWARE
    # --- опциональный заголовок PE32+ (240 байт) ---
    оп *Буфер = буф_новый()
    буф_нуль(оп, 240)
    уст16(оп.данные, 0, 0x20B)                 # Magic: PE32+
    оп.данные[2] = 14
    уст32(оп.данные, 4, выров(код.длина, ПЕ_ФВЫР))
    уст32(оп.данные, 8, выров(дб.длина, ПЕ_ФВЫР))
    уст32(оп.данные, 16, пл.вход_рва)          # AddressOfEntryPoint
    уст32(оп.данные, 20, ПЕ_ТЕКСТ)             # BaseOfCode
    уст64(оп.данные, 24, ПЕ_БАЗА)              # ImageBase
    уст32(оп.данные, 32, ПЕ_СВЫР)
    уст32(оп.данные, 36, ПЕ_ФВЫР)
    уст16(оп.данные, 40, 6)                    # MajorOSVersion
    уст16(оп.данные, 48, 6)                    # MajorSubsystemVersion
    уст32(оп.данные, 56, разм_обр)             # SizeOfImage
    уст32(оп.данные, 60, зг_разм)              # SizeOfHeaders
    уст16(оп.данные, 68, 3)                    # Subsystem: консоль
    уст64(оп.данные, 72, 0x100000)             # SizeOfStackReserve
    уст64(оп.данные, 80, 0x1000)               # SizeOfStackCommit
    уст64(оп.данные, 88, 0x100000)             # SizeOfHeapReserve
    уст64(оп.данные, 96, 0x1000)               # SizeOfHeapCommit
    уст32(оп.данные, 108, 16)                  # NumberOfRvaAndSizes
    уст32(оп.данные, 112 + 8, пл.деск_рва)     # каталог [1]: импорт
    уст32(оп.данные, 112 + 12, пл.деск_разм)
    уст32(оп.данные, 112 + 96, пл.иат_рва)     # каталог [12]: IAT
    уст32(оп.данные, 112 + 100, пл.иат_разм)
    буф_добавь(вых, буф_стр(оп))
    # --- заголовки секций ---
    буф_добавь(вых, _секция(".text", код.длина, ПЕ_ТЕКСТ,
        выров(код.длина, ПЕ_ФВЫР), текст_файл, 0x60000020))
    если пл.есть_дан:
        буф_добавь(вых, _секция(".data", дб.длина, пл.дан_рва,
            выров(дб.длина, ПЕ_ФВЫР), дан_файл, 0xC0000040))
    буф_нуль(вых, зг_разм - вых.длина)
    # --- тела секций ---
    буф_добавь(вых, код)
    буф_нуль(вых, выров(код.длина, ПЕ_ФВЫР) - код.длина)
    если пл.есть_дан:
        дл := дб.длина
        буф_добавь(вых, буф_стр(дб))
        буф_нуль(вых, выров(дл, ПЕ_ФВЫР) - дл)
    верни буф_стр(вых)
