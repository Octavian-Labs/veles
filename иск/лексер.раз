# лексер — разбивает строки исходника ИСКРЫ на токены.
#
# Идентификаторы: кириллица/латиница, _, точка. Числа: десятичные,
# 0x.., 0b.., 0o.., '_' как разделитель. Строки в ".." и '..'.
# Комментарий: ';' до конца строки.

взять основа
взять выраж        # ради иск_ош

конст ИТ_ИМЯ = 1
конст ИТ_ЧИСЛО = 2
конст ИТ_СТР = 3
конст ИТ_ЗНАК = 4      # текст = знак (",", "[", "<<", ...)

запись ИТок:
    вид нат.верх
    текст стр          # для ИМЯ/СТР/ЗНАК
    знач нат.верх         # для ЧИСЛО
    знач2 нат.верх        # для ЧИСЛО: 1 = литерал с установленным битом 63
    строка нат.верх
    столб нат.верх        # позиция в строке, 1-начало

функ _ит(вид нат.верх, текст стр, знач нат.верх, строка нат.верх,
         столб нат.верх) *ИТок:
    ток *ИТок = новый(ИТок)
    ток.вид = вид
    ток.текст = текст
    ток.знач = знач
    ток.строка = строка
    ток.столб = столб
    верни ток

функ _ил_идент_нач(симв нат.старт) лог:
    # первый символ идентификатора: буква (вкл. байты UTF-8 >= 0x80), _ или .
    верни ((симв >= 'a' и симв <= 'z') или (симв >= 'A' и симв <= 'Z') или
           симв >= 0x80 или симв == '_' или симв == '.')

функ _ил_идент(симв нат.старт) лог:
    # символ внутри идентификатора: буква, цифра, _ или .
    верни _ил_идент_нач(симв) или (симв >= '0' и симв <= '9')

функ _ил_знак(симв нат.старт) лог:
    верни (симв == ',' или симв == ':' или симв == '[' или симв == ']' или
           симв == '(' или симв == ')' или симв == '+' или симв == '-' или
           симв == '*' или симв == '/' или симв == '%' или симв == '$' или
           симв == '=' или симв == '&' или симв == '|' или симв == '^' или
           симв == '~' или симв == '<' или симв == '>')

функ _ил_пробел(симв нат.старт) лог:
    верни симв == ' ' или симв == 9 или симв == 13 или симв == 10 или симв == 11 или симв == 12

функ _ил_число(текст стр, нач нат.верх, конец нат.верх, строка нат.верх,
               токи *Список) нат.верх:
    # столб = нач + 1 (позиция первой цифры)
    # разбирает слово-число: 0x/0b/0o/десятичное, '_' разделитель;
    # кладёт ИТ_ЧИСЛО в токи; возвращает позицию за словом
    конец_сл нат.верх = нач
    пока конец_сл < конец и (_ил_идент(текст.данные[конец_сл]) или текст.данные[конец_сл] == '_'):
        конец_сл += 1
    знач нат.верх = 0
    ок лог = да
    поз нат.верх = нач
    база нат.верх = 10
    если конец_сл - нач > 2:
        буква нат.старт = текст.данные[нач + 1]
        если буква == 'x' или буква == 'X':
            база = 16
            поз = нач + 2
        а если буква == 'b' или буква == 'B':
            база = 2
            поз = нач + 2
        а если буква == 'o' или буква == 'O':
            база = 8
            поз = нач + 2
    пока поз < конец_сл:
        симв нат.старт = текст.данные[поз]
        если симв == '_':
            поз += 1
        иначе:
            цифра цел.верх = -1
            если симв >= '0' и симв <= '9':
                цифра = (симв - '0') как цел.верх
            а если симв >= 'a' и симв <= 'f':
                цифра = (симв - 'a' + 10) как цел.верх
            а если симв >= 'A' и симв <= 'F':
                цифра = (симв - 'A' + 10) как цел.верх
            если цифра < 0 или цифра >= (база как цел.верх):
                ок = нет
                поз = конец_сл
            иначе:
                знач = знач * база + цифра как нат.верх
                поз += 1
    если не ок:
        иск_ош("некорректное число", строка, нач + 1)
    ток *ИТок = _ит(ИТ_ЧИСЛО, пусто как стр, знач, строка, нач + 1)
    # литерал с установленным битом 63 — «большой»
    # (0x8000000000000000+), он не помещается в знаковый imm32
    ток.знач2 = (знач >> 63) & 1
    список_добавь(токи, ток как нат.верх)
    верни конец_сл

функ _ил_строка(текст стр, нач нат.верх, конец нат.верх, строка нат.верх,
                токи *Список) нат.верх:
    # строковый литерал ".." или '..': экраны \n \t \r \0, прочее — как есть
    кав нат.старт = текст.данные[нач]
    буф *Буфер = буф_новый()
    поз нат.верх = нач + 1
    пока поз < конец и текст.данные[поз] != кав:
        если текст.данные[поз] == '\\' и поз + 1 < конец:
            зн нат.старт = текст.данные[поз + 1]
            если зн == 'n':
                буф_сим(буф, 10)
            а если зн == 't':
                буф_сим(буф, 9)
            а если зн == 'r':
                буф_сим(буф, 13)
            а если зн == '0':
                буф_сим(буф, 0)
            иначе:
                буф_сим(буф, зн)
            поз += 2
        иначе:
            буф_сим(буф, текст.данные[поз])
            поз += 1
    если поз >= конец:
        иск_ош("незакрытая строка", строка, нач + 1)
    список_добавь(токи,
        _ит(ИТ_СТР, буф_стр(буф), 0, строка, нач + 1) как нат.верх)
    буф_свободен(буф)
    верни поз + 1

функ ил_строку(текст стр, строка нат.верх) *Список:
    # разбивает одну строку на токены
    токи *Список = список_новый()
    поз нат.верх = 0
    дл нат.верх = текст.длина
    пока поз < дл:
        симв нат.старт = текст.данные[поз]
        если симв == ';':
            верни токи
        если _ил_пробел(симв):
            поз += 1
        а если симв == '"' или симв == 39:
            поз = _ил_строка(текст, поз, дл, строка, токи)
        а если симв >= '0' и симв <= '9':
            поз = _ил_число(текст, поз, дл, строка, токи)
        а если _ил_идент_нач(симв):
            конец нат.верх = поз
            пока конец < дл и _ил_идент(текст.данные[конец]):
                конец += 1
            список_добавь(токи,
                _ит(ИТ_ИМЯ, стр_срез(текст, поз, конец), 0, строка, поз + 1) как нат.верх)
            поз = конец
        а если ((симв == '<' или симв == '>') и поз + 1 < дл и
                текст.данные[поз + 1] == симв):
            список_добавь(токи,
                _ит(ИТ_ЗНАК, стр_срез(текст, поз, поз + 2), 0, строка, поз + 1) как нат.верх)
            поз += 2
        а если _ил_знак(симв):
            список_добавь(токи,
                _ит(ИТ_ЗНАК, стр_срез(текст, поз, поз + 1), 0, строка, поз + 1) как нат.верх)
            поз += 1
        иначе:
            иск_ош("неожиданный символ", строка, поз + 1)
    верни токи

функ ил_разбери(исх стр) *Список:
    # разбивает весь исходник: список строк, каждая — список токенов
    строки *Список = список_новый()
    нач нат.верх = 0
    ном нат.верх = 1
    дл нат.верх = исх.длина
    для поз в 0..дл:
        если исх.данные[поз] == 10:
            список_добавь(строки,
                ил_строку(стр_срез(исх, нач, поз), ном) как нат.верх)
            нач = (поз + 1) как нат.верх
            ном += 1
    если нач < дл:
        список_добавь(строки,
            ил_строку(стр_срез(исх, нач, дл), ном) как нат.верх)
    верни строки
