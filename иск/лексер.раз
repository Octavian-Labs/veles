# лексер — разбивает строки исходника ИСКРЫ на токены.
#
# Идентификаторы: кириллица/латиница, _, точка. Числа: десятичные,
# 0x.., 0b.., 0o.., '_' как разделитель. Строки в ".." и '..'.
# Комментарий: ';' до конца строки.

взять основа
взять выраж        # ради иск_ош

конст ИТ_ИМЯ = 1
конст ИТ_ЧИСЛО = 2
конст ИТ_СТР = 3
конст ИТ_ЗНАК = 4      # текст = знак (",", "[", "<<", ...)

запись ИТок:
    вид нат.верх
    текст стр          # для ИМЯ/СТР/ЗНАК
    знач нат.верх         # для ЧИСЛО
    знач2 нат.верх        # для ЧИСЛО: 1 = литерал с установленным битом 63
    строка нат.верх
    столб нат.верх        # позиция в строке, 1-начало

функ _ит(вид нат.верх, текст стр, знач нат.верх, строка нат.верх,
         столб нат.верх) *ИТок:
    т *ИТок = новый(ИТок)
    т.вид = вид
    т.текст = текст
    т.знач = знач
    т.строка = строка
    т.столб = столб
    верни т

функ _ил_идент_нач(б нат.старт) лог:
    # первый символ идентификатора: буква (вкл. байты UTF-8 >= 0x80), _ или .
    верни ((б >= 'a' и б <= 'z') или (б >= 'A' и б <= 'Z') или
           б >= 0x80 или б == '_' или б == '.')

функ _ил_идент(б нат.старт) лог:
    # символ внутри идентификатора: буква, цифра, _ или .
    верни _ил_идент_нач(б) или (б >= '0' и б <= '9')

функ _ил_знак(б нат.старт) лог:
    верни (б == ',' или б == ':' или б == '[' или б == ']' или
           б == '(' или б == ')' или б == '+' или б == '-' или
           б == '*' или б == '/' или б == '%' или б == '$' или
           б == '=' или б == '&' или б == '|' или б == '^' или
           б == '~' или б == '<' или б == '>')

функ _ил_пробел(б нат.старт) лог:
    верни б == ' ' или б == 9 или б == 13 или б == 10 или б == 11 или б == 12

функ _ил_число(с стр, k нат.верх, конец нат.верх, строка нат.верх,
               токи *Список) нат.верх:
    # столб = k + 1 (позиция первой цифры)
    # разбирает слово-число: 0x/0b/0o/десятичное, '_' разделитель;
    # кладёт ИТ_ЧИСЛО в токи; возвращает позицию за словом
    кон нат.верх = k
    пока кон < конец и (_ил_идент(с.данные[кон]) или с.данные[кон] == '_'):
        кон += 1
    знач нат.верх = 0
    ок лог = да
    поз нат.верх = k
    база нат.верх = 10
    если кон - k > 2:
        в нат.старт = с.данные[k + 1]
        если в == 'x' или в == 'X':
            база = 16
            поз = k + 2
        а если в == 'b' или в == 'B':
            база = 2
            поз = k + 2
        а если в == 'o' или в == 'O':
            база = 8
            поз = k + 2
    пока поз < кон:
        б нат.старт = с.данные[поз]
        если б == '_':
            поз += 1
        иначе:
            ц цел.верх = -1
            если б >= '0' и б <= '9':
                ц = (б - '0') как цел.верх
            а если б >= 'a' и б <= 'f':
                ц = (б - 'a' + 10) как цел.верх
            а если б >= 'A' и б <= 'F':
                ц = (б - 'A' + 10) как цел.верх
            если ц < 0 или ц >= база как цел.верх:
                ок = нет
                поз = кон
            иначе:
                знач = знач * база + ц как нат.верх
                поз += 1
    если не ок:
        иск_ош("некорректное число", строка, k + 1)
    т *ИТок = _ит(ИТ_ЧИСЛО, пусто как стр, знач, строка, k + 1)
    # литерал с установленным битом 63 — «большой»
    # (0x8000000000000000+), он не помещается в знаковый imm32
    т.знач2 = (знач >> 63) & 1
    список_добавь(токи, т как нат.верх)
    верни кон

функ _ил_строка(с стр, k нат.верх, конец нат.верх, строка нат.верх,
                токи *Список) нат.верх:
    # строковый литерал ".." или '..': экраны \n \t \r \0, прочее — как есть
    кав нат.старт = с.данные[k]
    б *Буфер = буф_новый()
    поз нат.верх = k + 1
    пока поз < конец и с.данные[поз] != кав:
        если с.данные[поз] == '\\' и поз + 1 < конец:
            e нат.старт = с.данные[поз + 1]
            если e == 'n':
                буф_сим(б, 10)
            а если e == 't':
                буф_сим(б, 9)
            а если e == 'r':
                буф_сим(б, 13)
            а если e == '0':
                буф_сим(б, 0)
            иначе:
                буф_сим(б, e)
            поз += 2
        иначе:
            буф_сим(б, с.данные[поз])
            поз += 1
    если поз >= конец:
        иск_ош("незакрытая строка", строка, k + 1)
    список_добавь(токи,
        _ит(ИТ_СТР, буф_стр(б), 0, строка, k + 1) как нат.верх)
    буф_свободен(б)
    верни поз + 1

функ ил_строку(с стр, строка нат.верх) *Список:
    # разбивает одну строку на токены
    токи *Список = список_новый()
    поз нат.верх = 0
    n нат.верх = с.длина
    пока поз < n:
        б нат.старт = с.данные[поз]
        если б == ';':
            верни токи
        если _ил_пробел(б):
            поз += 1
        а если б == '"' или б == 39:
            поз = _ил_строка(с, поз, n, строка, токи)
        а если б >= '0' и б <= '9':
            поз = _ил_число(с, поз, n, строка, токи)
        а если _ил_идент_нач(б):
            кон нат.верх = поз
            пока кон < n и _ил_идент(с.данные[кон]):
                кон += 1
            список_добавь(токи,
                _ит(ИТ_ИМЯ, стр_срез(с, поз, кон), 0, строка, поз + 1) как нат.верх)
            поз = кон
        а если ((б == '<' или б == '>') и поз + 1 < n и
                с.данные[поз + 1] == б):
            список_добавь(токи,
                _ит(ИТ_ЗНАК, стр_срез(с, поз, поз + 2), 0, строка, поз + 1) как нат.верх)
            поз += 2
        а если _ил_знак(б):
            список_добавь(токи,
                _ит(ИТ_ЗНАК, стр_срез(с, поз, поз + 1), 0, строка, поз + 1) как нат.верх)
            поз += 1
        иначе:
            иск_ош("неожиданный символ", строка, поз + 1)
    верни токи

функ ил_разбери(исх стр) *Список:
    # разбивает весь исходник: список строк, каждая — список токенов
    строки *Список = список_новый()
    нач нат.верх = 0
    но нат.верх = 1
    n нат.верх = исх.длина
    для поз в 0..n:
        если исх.данные[поз] == 10:
            список_добавь(строки,
                ил_строку(стр_срез(исх, нач, поз), но) как нат.верх)
            нач = (поз + 1) как нат.верх
            но += 1
    если нач < n:
        список_добавь(строки,
            ил_строку(стр_срез(исх, нач, n), но) как нат.верх)
    верни строки
