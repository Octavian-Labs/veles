    верни "ВХОД"

функ ип_разбери(исх стр) *Список:
    # разбивает весь исходник в плоский список операторов
    регт := рег_таб()
    stmts *Список = список_новый()
    строки := ил_разбери(исх)
    для i в 0..строки.длина:
        токи := список_получи(строки, i) как *Список
        части := ип_строку(токи, регт)
        для j в 0..части.длина:
            список_добавь(stmts, список_получи(части, j))
    верни stmts
