# парсер — токены ИСКРЫ -> операторы.
#
# Грамматика строки:
#   [метка:] [МНЕМОНИКА оп1, оп2, ...] [; комментарий]
#   [метка:] ДИРЕКТИВА аргументы
#   имя РАВНО выражение

взять основа
взять узлы
взять выраж
взять лексер
взять рег

# виды операторов (Узел)
конст И_ИНСТР = 110     # текст=мнемоника, дети=список *Опер
конст И_ДИР = 111       # текст=имя директивы, дети=аргументы (*Узел)
конст И_МЕТКА = 112     # текст=имя
конст И_РАВНО = 113     # текст=имя, а=выражение

# виды операндов
конст О_РЕГ = 1         # ном, разм, рекс
конст О_ИММ = 2         # выр
конст О_ПАМ = 3         # база, инд, масш, выр(смещение), разм (0=не задан)

запись Опер:
    вид нат.верх
    ном нат.верх           # О_РЕГ: номер регистра
    разм нат.верх          # О_РЕГ: размер; О_ПАМ: явный размер (БАЙТ/СЛОВО/..)
    рекс лог            # О_РЕГ: нужен ли REX для 8-бит
    выр *Узел           # О_ИММ: выражение; О_ПАМ: смещение (пусто=нет)
    база *Опер          # О_ПАМ: базовый регистр
    инд *Опер           # О_ПАМ: индексный регистр
    масш нат.верх          # О_ПАМ: масштаб индекса

функ _опер(вид нат.верх) *Опер:
    опер *Опер = новый(Опер)
    опер.вид = вид
    опер.ном = 0
    опер.разм = 0
    опер.рекс = нет
    опер.выр = пусто как *Узел
    опер.база = пусто как *Опер
    опер.инд = пусто как *Опер
    опер.масш = 1
    верни опер

функ _регоп(регт *Список, имя стр) *Опер:
    # операнд-регистр по имени (для псевдоинструкций)
    зап *РегЗап = рег_ищи(регт, имя)
    опер *Опер = _опер(О_РЕГ)
    опер.ном = зап.ном
    опер.разм = зап.разм
    опер.рекс = зап.рекс
    верни опер

функ _инстр(мнем стр, опер1 *Опер, опер2 *Опер, строка нат.верх, столб нат.верх) *Узел:
    инс *Узел = узел(И_ИНСТР, строка)
    инс.текст = мнем
    инс.столб = столб
    инс.дети = список_новый()
    если опер1 != пусто:
        список_добавь(инс.дети, опер1 как нат.верх)
    если опер2 != пусто:
        список_добавь(инс.дети, опер2 как нат.верх)
    верни инс

# --- поток токенов одной строки ----------------------------------------------

запись ПотокИ:
    токи *Список
    поз нат.верх
    строка нат.верх

функ _пот(токи *Список, строка нат.верх) *ПотокИ:
    поток *ПотокИ = новый(ПотокИ)
    поток.токи = токи
    поток.поз = 0
    поток.строка = строка
    верни поток

функ _пстолб(поток *ПотокИ) нат.верх:
    ток *ИТок = _пзагляни(поток)
    если ток != пусто:
        верни ток.столб
    верни 0

функ _пзагляни(поток *ПотокИ) *ИТок:
    если поток.поз < поток.токи.длина:
        верни список_получи(поток.токи, поток.поз) как *ИТок
    верни пусто как *ИТок

функ _пзагляни2(поток *ПотокИ, смещ нат.верх) *ИТок:
    если поток.поз + смещ < поток.токи.длина:
        верни список_получи(поток.токи, поток.поз + смещ) как *ИТок
    верни пусто как *ИТок

функ _пдалее(поток *ПотокИ) *ИТок:
    ток *ИТок = _пзагляни(поток)
    если ток != пусто:
        поток.поз += 1
    верни ток

функ _пожидай(поток *ПотокИ, знак стр):
    ток *ИТок = _пдалее(поток)
    если ток == пусто или ток.вид != ИТ_ЗНАК или не стр_равны(ток.текст, знак):
        иск_ош("ожидался символ", поток.строка, _пстолб(поток))

функ _пконец(поток *ПотокИ) лог:
    верни поток.поз >= поток.токи.длина

# --- выражения ---------------------------------------------------------------

функ _пвыр(поток *ПотокИ) *Узел:
    верни _пили(поток)

функ _пили(поток *ПотокИ) *Узел:
    лев *Узел = _пискл(поток)
    пока да:
        ток *ИТок = _пзагляни(поток)
        если ток == пусто или ток.вид != ИТ_ЗНАК или не стр_равны(ток.текст, "|"):
            верни лев
        поток.поз += 1
        лев = _бину("|", лев, _пискл(поток), ток.строка)
    верни лев

функ _пискл(поток *ПотокИ) *Узел:
    лев *Узел = _пи(поток)
    пока да:
        ток *ИТок = _пзагляни(поток)
        если ток == пусто или ток.вид != ИТ_ЗНАК или не стр_равны(ток.текст, "^"):
            верни лев
        поток.поз += 1
        лев = _бину("^", лев, _пи(поток), ток.строка)
    верни лев

функ _пи(поток *ПотокИ) *Узел:
    лев *Узел = _псдвиг(поток)
    пока да:
        ток *ИТок = _пзагляни(поток)
        если ток == пусто или ток.вид != ИТ_ЗНАК или не стр_равны(ток.текст, "&"):
            верни лев
        поток.поз += 1
        лев = _бину("&", лев, _псдвиг(поток), ток.строка)
    верни лев

функ _псдвиг(поток *ПотокИ) *Узел:
    лев *Узел = _псум(поток)
    пока да:
        ток *ИТок = _пзагляни(поток)
        если (ток == пусто или ток.вид != ИТ_ЗНАК или
              не стр_равны(ток.текст, "<<") и не стр_равны(ток.текст, ">>")):
            верни лев
        поток.поз += 1
        лев = _бину(ток.текст, лев, _псум(поток), ток.строка)
    верни лев

функ _псум(поток *ПотокИ) *Узел:
    лев *Узел = _пумн(поток)
    пока да:
        ток *ИТок = _пзагляни(поток)
        если (ток == пусто или ток.вид != ИТ_ЗНАК или
              не стр_равны(ток.текст, "+") и не стр_равны(ток.текст, "-")):
            верни лев
        поток.поз += 1
        лев = _бину(ток.текст, лев, _пумн(поток), ток.строка)
    верни лев

функ _пумн(поток *ПотокИ) *Узел:
    лев *Узел = _пунар(поток)
    пока да:
        ток *ИТок = _пзагляни(поток)
        если (ток == пусто или ток.вид != ИТ_ЗНАК или
              (не стр_равны(ток.текст, "*") и не стр_равны(ток.текст, "/") и
               не стр_равны(ток.текст, "%"))):
            верни лев
        поток.поз += 1
        лев = _бину(ток.текст, лев, _пунар(поток), ток.строка)
    верни лев

функ _бину(операция стр, лев *Узел, прав *Узел, строка нат.верх) *Узел:
    уз *Узел = узел(В_БИН, строка)
    уз.текст = операция
    уз.а = лев
    уз.б = прав
    верни уз

функ _пунар(поток *ПотокИ) *Узел:
    ток *ИТок = _пзагляни(поток)
    если ток != пусто и ток.вид == ИТ_ЗНАК:
        если стр_равны(ток.текст, "-"):
            поток.поз += 1
            уз *Узел = узел(В_ОТР, ток.строка)
            уз.а = _пунар(поток)
            верни уз
        если стр_равны(ток.текст, "~"):
            поток.поз += 1
            уз = узел(В_НЕ, ток.строка)
            уз.а = _пунар(поток)
            верни уз
        если стр_равны(ток.текст, "+"):
            поток.поз += 1
            верни _пунар(поток)
    верни _патом(поток)

функ _патом(поток *ПотокИ) *Узел:
    ток *ИТок = _пдалее(поток)
    если ток == пусто:
        иск_ош("неожиданный конец выражения", поток.строка, _пстолб(поток))
    если ток.вид == ИТ_ЧИСЛО:
        уз *Узел = узел(В_ЧИСЛО, ток.строка)
        уз.знач = ток.знач
        уз.знач2 = ток.знач2
        уз.столб = ток.столб
        верни уз
    если ток.вид == ИТ_ИМЯ:
        если стр_равны_нр(ток.текст, "ЗДЕСЬ"):
            верни узел(В_ЗДЕСЬ, ток.строка)
        уз = узел(В_СИМ, ток.строка)
        уз.текст = ток.текст
        уз.столб = ток.столб
        верни уз
    если ток.вид == ИТ_СТР:
        # символьный литерал — ровно один кодпоинт UTF-8
        кп цел.верх = утф8_код(ток.текст.данные, ток.текст.длина)
        если кп < 0:
            иск_ош("неожиданный токен в выражении", поток.строка, _пстолб(поток))
        уз = узел(В_ЧИСЛО, ток.строка)
        уз.знач = кп как нат.верх
        уз.столб = ток.столб
        верни уз
    если ток.вид == ИТ_ЗНАК:
        если стр_равны(ток.текст, "$"):
            верни узел(В_ЗДЕСЬ, ток.строка)
        если стр_равны(ток.текст, "("):
            уз = _пвыр(поток)
            _пожидай(поток, ")")
            верни уз
    иск_ош("неожиданный токен в выражении", поток.строка, _пстолб(поток))
    верни пусто как *Узел

# --- операнды ----------------------------------------------------------------

запись Слаг:
    знак цел.верх
    токи *Список

функ _члены(поток *ПотокИ) *Список:
    # делит [...] на слагаемые по + и - верхнего уровня
    члены *Список = список_новый()
    знак цел.верх = 1
    тек *Список = список_новый()
    глуб цел.верх = 0
    пока да:
        ток *ИТок = _пзагляни(поток)
        если ток == пусто:
            хватит
        если ток.вид == ИТ_ЗНАК и стр_равны(ток.текст, "]") и глуб == 0:
            хватит
        поток.поз += 1
        если ток.вид == ИТ_ЗНАК и стр_равны(ток.текст, "("):
            глуб += 1
        иначе:
            если ток.вид == ИТ_ЗНАК и стр_равны(ток.текст, ")"):
                глуб -= 1
        если (ток.вид == ИТ_ЗНАК и (стр_равны(ток.текст, "+") или
            стр_равны(ток.текст, "-"))) и глуб == 0:
            слаг *Слаг = новый(Слаг)
            слаг.знак = знак
            слаг.токи = тек
            список_добавь(члены, слаг как нат.верх)
            тек = список_новый()
            если стр_равны(ток.текст, "+"):
                знак = 1
            иначе:
                знак = -1
        иначе:
            список_добавь(тек, ток как нат.верх)
    слаг = новый(Слаг)
    слаг.знак = знак
    слаг.токи = тек
    список_добавь(члены, слаг как нат.верх)
    верни члены

функ _рег_из(ток *ИТок, регт *Список) *Опер:
    # если токен-имя — регистр, вернуть Опер О_РЕГ; иначе пусто
    зап *РегЗап = рег_ищи(регт, ток.текст)
    если зап == пусто:
        верни пусто как *Опер
    опер *Опер = _опер(О_РЕГ)
    опер.ном = зап.ном
    опер.разм = зап.разм
    опер.рекс = зап.рекс
    верни опер

функ _память(поток *ПотокИ, разм нат.верх, регт *Список) *Опер:
    # разбирает адресный операнд после '['
    пам *Опер = _опер(О_ПАМ)
    пам.разм = разм
    члены *Список = _члены(поток)
    смещ *Список = список_новый()
    для инд в 0..члены.длина:
        слаг *Слаг = список_получи(члены, инд) как *Слаг
        токи *Список = слаг.токи
        рег *Опер = пусто как *Опер
        масш нат.верх = 1
        остаток нат.верх = 0         # сколько токенов «лишних» после регистра
        если токи.длина >= 1:
            ток0 *ИТок = список_получи(токи, 0) как *ИТок
            если ток0.вид == ИТ_ИМЯ:
                рег = _рег_из(ток0, регт)
        если рег != пусто:
            # РЕГ или РЕГ*N
            если токи.длина == 3:
                ток1 *ИТок = список_получи(токи, 1) как *ИТок
                ток2 *ИТок = список_получи(токи, 2) как *ИТок
                если (ток1.вид == ИТ_ЗНАК и стр_равны(ток1.текст, "*") и
                      ток2.вид == ИТ_ЧИСЛО):
                    масш = ток2.знач
                иначе:
                    остаток = 1
            а если токи.длина > 1:
                остаток = 1
        иначе:
            # N*РЕГ
            если токи.длина == 3:
                ток0 = список_получи(токи, 0) как *ИТок
                ток1 = список_получи(токи, 1) как *ИТок
                ток2 = список_получи(токи, 2) как *ИТок
                если (ток0.вид == ИТ_ЧИСЛО и ток1.вид == ИТ_ЗНАК и
                      стр_равны(ток1.текст, "*") и ток2.вид == ИТ_ИМЯ):
                    рег = _рег_из(ток2, регт)
                    если рег != пусто:
                        масш = ток0.знач
        если рег != пусто и остаток == 0:
            если масш != 1 или пам.база != пусто:
                если пам.инд != пусто:
                    иск_ош("лишний индексный регистр в адресе", поток.строка, _пстолб(поток))
                пам.инд = рег
                пам.масш = масш
            иначе:
                пам.база = рег
            если слаг.знак < 0:
                иск_ош("регистр в адресе нельзя вычитать", поток.строка, _пстолб(поток))
        иначе:
            список_добавь(смещ, слаг как нат.верх)
    _пожидай(поток, "]")
    если смещ.длина > 0:
        выр *Узел = пусто как *Узел
        для инд в 0..смещ.длина:
            слаг = список_получи(смещ, инд) как *Слаг
            подпоток *ПотокИ = _пот(слаг.токи, поток.строка)
            часть *Узел = _пвыр(подпоток)
            если не _пконец(подпоток):
                иск_ош("лишние токены в смещении адреса", поток.строка, _пстолб(поток))
            если слаг.знак < 0:
                отриц *Узел = узел(В_ОТР, поток.строка)
                отриц.а = часть
                часть = отриц
            если выр == пусто:
                выр = часть
            иначе:
                выр = _бину("+", выр, часть, поток.строка)
        пам.выр = выр
    если пам.база == пусто и пам.инд == пусто и пам.выр == пусто:
        иск_ош("пустой адресный операнд []", поток.строка, _пстолб(поток))
    верни пам

функ _слово_разм(имя стр) нат.верх:
    # БАЙТ/СЛОВО/ДВСЛОВО/КВАД -> 1/2/4/8, иначе 0
    если стр_равны_нр(имя, "БАЙТ"):
        верни 1
    если стр_равны_нр(имя, "СЛОВО"):
        верни 2
    если стр_равны_нр(имя, "ДВСЛОВО"):
        верни 4
    если стр_равны_нр(имя, "КВАД"):
        верни 8
    верни 0

функ _поперанд(поток *ПотокИ, регт *Список) *Опер:
    # один операнд: регистр, [адрес], размер [адрес] или выражение
    ток *ИТок = _пзагляни(поток)
    если ток != пусто и ток.вид == ИТ_ИМЯ:
        разм нат.верх = _слово_разм(ток.текст)
        если разм != 0:
            ток2 *ИТок = _пзагляни2(поток, 1)
            если (ток2 != пусто и ток2.вид == ИТ_ЗНАК и
                  стр_равны(ток2.текст, "[")):
                поток.поз += 2
                верни _память(поток, разм, регт)
        рег *Опер = _рег_из(ток, регт)
        если рег != пусто:
            поток.поз += 1
            верни рег
    если ток != пусто и ток.вид == ИТ_ЗНАК и стр_равны(ток.текст, "["):
        поток.поз += 1
        верни _память(поток, 0, регт)
    опер *Опер = _опер(О_ИММ)
    опер.выр = _пвыр(поток)
    верни опер

# --- строки ------------------------------------------------------------------

функ _это_директива(имя стр) лог:
    верни (стр_равны_нр(имя, "СЕКЦИЯ") или стр_равны_нр(имя, "БАЙТ") или
           стр_равны_нр(имя, "СЛОВО") или стр_равны_нр(имя, "ДВСЛОВО") или
           стр_равны_нр(имя, "КВАД") или стр_равны_нр(имя, "ВЫРОВНЯТЬ") или
           стр_равны_нр(имя, "РЕЗЕРВ") или стр_равны_нр(имя, "ИМПОРТ") или
           стр_равны_нр(имя, "ВХОД"))

функ _пдиректива(поток *ПотокИ, имя стр, строка нат.верх) *Узел:
    # аргументы директивы; имя уже в каноническом виде (верхний регистр)
    дир *Узел = узел(И_ДИР, строка)
    дир.текст = имя
    дир.дети = список_новый()
    если стр_равны(имя, "СЕКЦИЯ"):
        ток *ИТок = _пдалее(поток)
        если ток == пусто или (ток.вид != ИТ_ИМЯ и ток.вид != ИТ_СТР):
            иск_ош("СЕКЦИЯ: ожидалось имя секции", строка, 0)
        арг *Узел = узел(У_СТР, строка)
        арг.текст = ток.текст
        список_добавь(дир.дети, арг как нат.верх)
        верни дир
    если стр_равны(имя, "ИМПОРТ"):
        ток = _пдалее(поток)
        если ток == пусто или ток.вид != ИТ_СТР:
            иск_ош("ИМПОРТ: ожидалось имя DLL в кавычках", строка, 0)
        арг = узел(У_СТР, строка)
        арг.текст = ток.текст
        список_добавь(дир.дети, арг как нат.верх)
        пока не _пконец(поток):
            ток = _пдалее(поток)
            если ток.вид == ИТ_ИМЯ:
                арг = узел(У_СТР, строка)
                арг.текст = ток.текст
                список_добавь(дир.дети, арг как нат.верх)
            а если ток.вид == ИТ_ЗНАК и стр_равны(ток.текст, ","):
                # разделитель
                поток.поз = поток.поз
            иначе:
                иск_ош("ИМПОРТ: неожиданный токен", строка, 0)
        верни дир
    если (стр_равны(имя, "ВХОД") или стр_равны(имя, "ВЫРОВНЯТЬ") или
          стр_равны(имя, "РЕЗЕРВ")):
        список_добавь(дир.дети, _пвыр(поток) как нат.верх)
    иначе:
        если (стр_равны(имя, "БАЙТ") или стр_равны(имя, "СЛОВО") или
              стр_равны(имя, "ДВСЛОВО") или стр_равны(имя, "КВАД")):
            пока не _пконец(поток):
                ток = _пзагляни(поток)
                если ток.вид == ИТ_СТР и стр_равны(имя, "БАЙТ"):
                    поток.поз += 1
                    арг = узел(У_СТР, строка)
                    арг.текст = ток.текст
                    список_добавь(дир.дети, арг как нат.верх)
                иначе:
                    список_добавь(дир.дети, _пвыр(поток) как нат.верх)
                ток = _пзагляни(поток)
                если ток != пусто:
                    если ток.вид == ИТ_ЗНАК и стр_равны(ток.текст, ","):
                        поток.поз += 1
                    иначе:
                        иск_ош("ожидалась запятая в данных", строка, 0)
        иначе:
            иск_ош("неизвестная директива", строка, 0)
    если не _пконец(поток):
        иск_ош("лишние токены в директиве", строка, 0)
    верни дир

функ ип_строку(токи *Список, регт *Список) *Список:
    # разбивает одну строку токенов в список операторов
    вых *Список = список_новый()
    если токи.длина == 0:
        верни вых
    ток0 *ИТок = список_получи(токи, 0) как *ИТок
    строка нат.верх = ток0.строка
    поток *ПотокИ = _пот(токи, строка)
    # метка в начале строки: ИМЯ ':'
    ток *ИТок = _пзагляни(поток)
    ток2 *ИТок = _пзагляни2(поток, 1)
    если (ток != пусто и ток.вид == ИТ_ИМЯ и ток2 != пусто и
          ток2.вид == ИТ_ЗНАК и стр_равны(ток2.текст, ":")):
        метка *Узел = узел(И_МЕТКА, строка)
        метка.текст = ток.текст
        метка.столб = ток.столб
        список_добавь(вых, метка как нат.верх)
        поток.поз += 2
    если _пконец(поток):
        верни вых
    ток = _пдалее(поток)
    если ток == пусто или ток.вид != ИТ_ИМЯ:
        иск_ош("ожидалась мнемоника или директива", строка, 0)
    имя стр = ток.текст
    # константа: ИМЯ РАВНО выражение
    ток2 = _пзагляни(поток)
    если ток2 != пусто и ток2.вид == ИТ_ИМЯ и стр_равны_нр(ток2.текст, "РАВНО"):
        поток.поз += 1
        равно *Узел = узел(И_РАВНО, строка)
        равно.текст = имя
        равно.столб = ток.столб
        равно.а = _пвыр(поток)
        список_добавь(вых, равно как нат.верх)
        если не _пконец(поток):
            иск_ош("лишние токены после РАВНО", строка, 0)
        верни вых
    # директива
    если _это_директива(имя):
        дир *Узел = _пдиректива(поток, _канон(имя), строка)
        дир.столб = ток.столб
        список_добавь(вых, дир как нат.верх)
        верни вых
    # псевдоинструкции кадра (канон: docs/05-канон.md)
    если стр_равны_нр(имя, "ВЫХОДКАДРА"):
        список_добавь(вых, _инстр("ПОКИНЬ", пусто как *Опер,
                                  пусто как *Опер, строка, ток.столб) как нат.верх)
        верни вых
    если стр_равны_нр(имя, "ВХОДКАДРА"):
        # ВСТЕК УКК; ПЕР УКК, УКС; ВЫЧ УКС, <размер>
        арг *Опер = _поперанд(поток, регт)
        если не _пконец(поток):
            иск_ош("лишние токены после ВХОДКАДРА", строка, 0)
        список_добавь(вых, _инстр("ВСТЕК", _регоп(регт, "УКК"),
                                  пусто как *Опер, строка, ток.столб) как нат.верх)
        список_добавь(вых, _инстр("ПЕР", _регоп(регт, "УКК"),
                                  _регоп(регт, "УКС"), строка, ток.столб) как нат.верх)
        список_добавь(вых, _инстр("ВЫЧ", _регоп(регт, "УКС"),
                                  арг, строка, ток.столб) как нат.верх)
        верни вых
    # обычная инструкция
    инс *Узел = узел(И_ИНСТР, строка)
    инс.текст = имя
    инс.столб = ток.столб
    инс.дети = список_новый()
    пока не _пконец(поток):
        список_добавь(инс.дети, _поперанд(поток, регт) как нат.верх)
        ток3 *ИТок = _пзагляни(поток)
        если ток3 != пусто:
            если ток3.вид == ИТ_ЗНАК и стр_равны(ток3.текст, ","):
                поток.поз += 1
            иначе:
                иск_ош("ожидалась запятая", строка, 0)
    список_добавь(вых, инс как нат.верх)
    верни вых

функ _канон(имя стр) стр:
    # имя директивы в каноническом верхнем регистре
    для инд в 0..9:
        канон стр = _дир_имя(инд)
        если стр_равны_нр(имя, канон):
            верни канон
    верни имя

функ _дир_имя(инд нат.верх) стр:
    если инд == 0:
        верни "СЕКЦИЯ"
    если инд == 1:
        верни "БАЙТ"
    если инд == 2:
        верни "СЛОВО"
    если инд == 3:
        верни "ДВСЛОВО"
    если инд == 4:
        верни "КВАД"
    если инд == 5:
        верни "ВЫРОВНЯТЬ"
    если инд == 6:
        верни "РЕЗЕРВ"
    если инд == 7:
        верни "ИМПОРТ"
    верни "ВХОД"

функ ип_разбери(исх стр) *Список:
    # разбивает весь исходник в плоский список операторов
    регт *Список = рег_таб()
    инструкции *Список = список_новый()
    строки *Список = ил_разбери(исх)
    для инд в 0..строки.длина:
        токи *Список = список_получи(строки, инд) как *Список
        части *Список = ип_строку(токи, регт)
        для инд2 в 0..части.длина:
            список_добавь(инструкции, список_получи(части, инд2))
    верни инструкции
