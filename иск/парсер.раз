# парсер — токены ИСКРЫ -> операторы (порт src/iskra/parser.py).
#
# Грамматика строки:
#   [метка:] [МНЕМОНИКА оп1, оп2, ...] [; комментарий]
#   [метка:] ДИРЕКТИВА аргументы
#   имя РАВНО выражение

взять основа
взять узлы
взять выраж
взять лексер
взять рег

# виды операторов (Узел)
конст И_ИНСТР = 110     # текст=мнемоника, дети=список *Опер
конст И_ДИР = 111       # текст=имя директивы, дети=аргументы (*Узел)
конст И_МЕТКА = 112     # текст=имя
конст И_РАВНО = 113     # текст=имя, а=выражение

# виды операндов
конст О_РЕГ = 1         # ном, разм, рекс
конст О_ИММ = 2         # выр
конст О_ПАМ = 3         # база, инд, масш, выр(смещение), разм (0=не задан)

запись Опер:
    вид без64
    ном без64           # О_РЕГ: номер регистра
    разм без64          # О_РЕГ: размер; О_ПАМ: явный размер (БАЙТ/СЛОВО/..)
    рекс бул            # О_РЕГ: нужен ли REX для 8-бит
    выр *Узел           # О_ИММ: выражение; О_ПАМ: смещение (пусто=нет)
    база *Опер          # О_ПАМ: базовый регистр
    инд *Опер           # О_ПАМ: индексный регистр
    масш без64          # О_ПАМ: масштаб индекса

функ _опер(вид без64) *Опер:
    о *Опер = новый(Опер)
    о.вид = вид
    о.ном = 0
    о.разм = 0
    о.рекс = нет
    о.выр = пусто как *Узел
    о.база = пусто как *Опер
    о.инд = пусто как *Опер
    о.масш = 1
    верни о

# --- поток токенов одной строки ----------------------------------------------

запись ПотокИ:
    токи *Список
    i без64
    строка без64

функ _пот(токи *Список, строка без64) *ПотокИ:
    п *ПотокИ = новый(ПотокИ)
    п.токи = токи
    п.i = 0
    п.строка = строка
    верни п

функ _пзагляни(п *ПотокИ) *ИТок:
    если п.i < п.токи.длина:
        верни список_получи(п.токи, п.i) как *ИТок
    верни пусто как *ИТок

функ _пзагляни2(п *ПотокИ, смещ без64) *ИТок:
    если п.i + смещ < п.токи.длина:
        верни список_получи(п.токи, п.i + смещ) как *ИТок
    верни пусто как *ИТок

функ _пдалее(п *ПотокИ) *ИТок:
    т := _пзагляни(п)
    если т != пусто:
        п.i += 1
    верни т

функ _пожидай(п *ПотокИ, знак стр):
    т := _пдалее(п)
    если т == пусто или т.вид != ИТ_ЗНАК или не стр_равны(т.текст, знак):
        иск_ош("ожидался символ", п.строка)

функ _пконец(п *ПотокИ) бул:
    верни п.i >= п.токи.длина

# --- выражения ---------------------------------------------------------------

функ _пвыр(п *ПотокИ) *Узел:
    верни _пили(п)

функ _пили(п *ПотокИ) *Узел:
    лев := _пискл(п)
    пока да:
        т := _пзагляни(п)
        если т == пусто или т.вид != ИТ_ЗНАК или не стр_равны(т.текст, "|"):
            верни лев
        п.i += 1
        лев = _бину("|", лев, _пискл(п), т.строка)
    верни лев

функ _пискл(п *ПотокИ) *Узел:
    лев := _пи(п)
    пока да:
        т := _пзагляни(п)
        если т == пусто или т.вид != ИТ_ЗНАК или не стр_равны(т.текст, "^"):
            верни лев
        п.i += 1
        лев = _бину("^", лев, _пи(п), т.строка)
    верни лев

функ _пи(п *ПотокИ) *Узел:
    лев := _псдвиг(п)
    пока да:
        т := _пзагляни(п)
        если т == пусто или т.вид != ИТ_ЗНАК или не стр_равны(т.текст, "&"):
            верни лев
        п.i += 1
        лев = _бину("&", лев, _псдвиг(п), т.строка)
    верни лев

функ _псдвиг(п *ПотокИ) *Узел:
    лев := _псум(п)
    пока да:
        т := _пзагляни(п)
        если (т == пусто или т.вид != ИТ_ЗНАК или
              не стр_равны(т.текст, "<<") и не стр_равны(т.текст, ">>")):
            верни лев
        п.i += 1
        лев = _бину(т.текст, лев, _псум(п), т.строка)
    верни лев

функ _псум(п *ПотокИ) *Узел:
    лев := _пумн(п)
    пока да:
        т := _пзагляни(п)
        если (т == пусто или т.вид != ИТ_ЗНАК или
              не стр_равны(т.текст, "+") и не стр_равны(т.текст, "-")):
            верни лев
        п.i += 1
        лев = _бину(т.текст, лев, _пумн(п), т.строка)
    верни лев

функ _пумн(п *ПотокИ) *Узел:
    лев := _пунар(п)
    пока да:
        т := _пзагляни(п)
        если (т == пусто или т.вид != ИТ_ЗНАК или
              (не стр_равны(т.текст, "*") и не стр_равны(т.текст, "/") и
               не стр_равны(т.текст, "%"))):
            верни лев
        п.i += 1
        лев = _бину(т.текст, лев, _пунар(п), т.строка)
    верни лев

функ _бину(оп стр, а *Узел, б *Узел, строка без64) *Узел:
    у := узел(В_БИН, строка)
    у.текст = оп
    у.а = а
    у.б = б
    верни у

функ _пунар(п *ПотокИ) *Узел:
    т := _пзагляни(п)
    если т != пусто и т.вид == ИТ_ЗНАК:
        если стр_равны(т.текст, "-"):
            п.i += 1
            у := узел(В_ОТР, т.строка)
            у.а = _пунар(п)
            верни у
        если стр_равны(т.текст, "~"):
            п.i += 1
            у := узел(В_НЕ, т.строка)
            у.а = _пунар(п)
            верни у
        если стр_равны(т.текст, "+"):
            п.i += 1
            верни _пунар(п)
    верни _патом(п)

функ _патом(п *ПотокИ) *Узел:
    т := _пдалее(п)
    если т == пусто:
        иск_ош("неожиданный конец выражения", п.строка)
    если т.вид == ИТ_ЧИСЛО:
        у := узел(В_ЧИСЛО, т.строка)
        у.знач = т.знач
        у.знач2 = т.знач2
        верни у
    если т.вид == ИТ_ИМЯ:
        если стр_равны_нр(т.текст, "ЗДЕСЬ"):
            верни узел(В_ЗДЕСЬ, т.строка)
        у := узел(В_СИМ, т.строка)
        у.текст = т.текст
        верни у
    если т.вид == ИТ_СТР:
        # символьный литерал — один кодпоинт UTF-8 (как ord() в Python)
        кп := утф8_код(т.текст.данные, т.текст.длина)
        если кп < 0:
            иск_ош("неожиданный токен в выражении", п.строка)
        у := узел(В_ЧИСЛО, т.строка)
        у.знач = кп как без64
        верни у
    если т.вид == ИТ_ЗНАК:
        если стр_равны(т.текст, "$"):
            верни узел(В_ЗДЕСЬ, т.строка)
        если стр_равны(т.текст, "("):
            у := _пвыр(п)
            _пожидай(п, ")")
            верни у
    иск_ош("неожиданный токен в выражении", п.строка)
    верни пусто как *Узел

# --- операнды ----------------------------------------------------------------

запись Слаг:
    знак цел64
    токи *Список

функ _члены(п *ПотокИ) *Список:
    # делит [...] на слагаемые по + и - верхнего уровня
    члены *Список = список_новый()
    знак := 1 как цел64
    тек *Список = список_новый()
    глуб := 0 как цел64
    пока да:
        т := _пзагляни(п)
        если т == пусто:
            хватит
        если т.вид == ИТ_ЗНАК и стр_равны(т.текст, "]") и глуб == 0:
            хватит
        п.i += 1
        если т.вид == ИТ_ЗНАК и стр_равны(т.текст, "("):
            глуб += 1
        иначе:
            если т.вид == ИТ_ЗНАК и стр_равны(т.текст, ")"):
                глуб -= 1
        если (т.вид == ИТ_ЗНАК и (стр_равны(т.текст, "+") или
            стр_равны(т.текст, "-"))) и глуб == 0:
            с *Слаг = новый(Слаг)
            с.знак = знак
            с.токи = тек
            список_добавь(члены, с как без64)
            тек = список_новый()
            если стр_равны(т.текст, "+"):
                знак = 1
            иначе:
                знак = -1
        иначе:
            список_добавь(тек, т как без64)
    с *Слаг = новый(Слаг)
    с.знак = знак
    с.токи = тек
    список_добавь(члены, с как без64)
    верни члены

функ _рег_из(т *ИТок, регт *Список) *Опер:
    # если токен-имя — регистр, вернуть Опер О_РЕГ; иначе пусто
    з := рег_ищи(регт, т.текст)
    если з == пусто:
        верни пусто как *Опер
    о := _опер(О_РЕГ)
    о.ном = з.ном
    о.разм = з.разм
    о.рекс = з.рекс
    верни о

функ _память(п *ПотокИ, разм без64, регт *Список) *Опер:
    # разбирает адресный операнд после '['
    м := _опер(О_ПАМ)
    м.разм = разм
    члены := _члены(п)
    смещ *Список = список_новый()
    для ci в 0..члены.длина:
        с := список_получи(члены, ci) как *Слаг
        токи := с.токи
        рег *Опер = пусто как *Опер
        масш := 1 как без64
        остаток := 0 как без64    # сколько токенов «лишних» после регистра
        если токи.длина >= 1:
            т0 := список_получи(токи, 0) как *ИТок
            если т0.вид == ИТ_ИМЯ:
                рег = _рег_из(т0, регт)
        если рег != пусто:
            # РЕГ или РЕГ*N
            если токи.длина == 3:
                т1 := список_получи(токи, 1) как *ИТок
                т2 := список_получи(токи, 2) как *ИТок
                если (т1.вид == ИТ_ЗНАК и стр_равны(т1.текст, "*") и
                      т2.вид == ИТ_ЧИСЛО):
                    масш = т2.знач
                иначе:
                    остаток = 1
            а если токи.длина > 1:
                остаток = 1
        иначе:
            # N*РЕГ
            если токи.длина == 3:
                т0 := список_получи(токи, 0) как *ИТок
                т1 := список_получи(токи, 1) как *ИТок
                т2 := список_получи(токи, 2) как *ИТок
                если (т0.вид == ИТ_ЧИСЛО и т1.вид == ИТ_ЗНАК и
                      стр_равны(т1.текст, "*") и т2.вид == ИТ_ИМЯ):
                    рег = _рег_из(т2, регт)
                    если рег != пусто:
                        масш = т0.знач
        если рег != пусто и остаток == 0:
            если масш != 1 или м.база != пусто:
                если м.инд != пусто:
                    иск_ош("лишний индексный регистр в адресе", п.строка)
                м.инд = рег
                м.масш = масш
            иначе:
                м.база = рег
            если с.знак < 0:
                иск_ош("регистр в адресе нельзя вычитать", п.строка)
        иначе:
            список_добавь(смещ, с как без64)
    _пожидай(п, "]")
    если смещ.длина > 0:
        выр *Узел = пусто как *Узел
        для ci в 0..смещ.длина:
            с := список_получи(смещ, ci) как *Слаг
            под := _пот(с.токи, п.строка)
            часть := _пвыр(под)
            если не _пконец(под):
                иск_ош("лишние токены в смещении адреса", п.строка)
            если с.знак < 0:
                нг := узел(В_ОТР, п.строка)
                нг.а = часть
                часть = нг
            если выр == пусто:
                выр = часть
            иначе:
                выр = _бину("+", выр, часть, п.строка)
        м.выр = выр
    если м.база == пусто и м.инд == пусто и м.выр == пусто:
        иск_ош("пустой адресный операнд []", п.строка)
    верни м

функ _слово_разм(имя стр) без64:
    # БАЙТ/СЛОВО/ДВСЛОВО/КВАД -> 1/2/4/8, иначе 0
    если стр_равны_нр(имя, "БАЙТ"):
        верни 1
    если стр_равны_нр(имя, "СЛОВО"):
        верни 2
    если стр_равны_нр(имя, "ДВСЛОВО"):
        верни 4
    если стр_равны_нр(имя, "КВАД"):
        верни 8
    верни 0

функ _поперанд(п *ПотокИ, регт *Список) *Опер:
    # один операнд: регистр, [адрес], размер [адрес] или выражение
    т := _пзагляни(п)
    если т != пусто и т.вид == ИТ_ИМЯ:
        sz := _слово_разм(т.текст)
        если sz != 0:
            т2 := _пзагляни2(п, 1)
            если (т2 != пусто и т2.вид == ИТ_ЗНАК и
                  стр_равны(т2.текст, "[")):
                п.i += 2
                верни _память(п, sz, регт)
        рег := _рег_из(т, регт)
        если рег != пусто:
            п.i += 1
            верни рег
    если т != пусто и т.вид == ИТ_ЗНАК и стр_равны(т.текст, "["):
        п.i += 1
        верни _память(п, 0, регт)
    о := _опер(О_ИММ)
    о.выр = _пвыр(п)
    верни о

# --- строки ------------------------------------------------------------------

функ _это_директива(имя стр) бул:
    верни (стр_равны_нр(имя, "СЕКЦИЯ") или стр_равны_нр(имя, "БАЙТ") или
           стр_равны_нр(имя, "СЛОВО") или стр_равны_нр(имя, "ДВСЛОВО") или
           стр_равны_нр(имя, "КВАД") или стр_равны_нр(имя, "ВЫРОВНЯТЬ") или
           стр_равны_нр(имя, "РЕЗЕРВ") или стр_равны_нр(имя, "ИМПОРТ") или
           стр_равны_нр(имя, "ВХОД"))

функ _пдиректива(п *ПотокИ, имя стр, строка без64) *Узел:
    # аргументы директивы; имя уже в каноническом виде (верхний регистр)
    д := узел(И_ДИР, строка)
    д.текст = имя
    д.дети = список_новый()
    если стр_равны(имя, "СЕКЦИЯ"):
        т := _пдалее(п)
        если т == пусто или (т.вид != ИТ_ИМЯ и т.вид != ИТ_СТР):
            иск_ош("СЕКЦИЯ: ожидалось имя секции", строка)
        а := узел(У_СТР, строка)
        а.текст = т.текст
        список_добавь(д.дети, а как без64)
        верни д
    если стр_равны(имя, "ИМПОРТ"):
        т := _пдалее(п)
        если т == пусто или т.вид != ИТ_СТР:
            иск_ош("ИМПОРТ: ожидалось имя DLL в кавычках", строка)
        а := узел(У_СТР, строка)
        а.текст = т.текст
        список_добавь(д.дети, а как без64)
        пока не _пконец(п):
            т = _пдалее(п)
            если т.вид == ИТ_ИМЯ:
                а := узел(У_СТР, строка)
                а.текст = т.текст
                список_добавь(д.дети, а как без64)
            а если т.вид == ИТ_ЗНАК и стр_равны(т.текст, ","):
                # разделитель
                п.i = п.i
            иначе:
                иск_ош("ИМПОРТ: неожиданный токен", строка)
        верни д
    если (стр_равны(имя, "ВХОД") или стр_равны(имя, "ВЫРОВНЯТЬ") или
          стр_равны(имя, "РЕЗЕРВ")):
        список_добавь(д.дети, _пвыр(п) как без64)
    иначе:
        если (стр_равны(имя, "БАЙТ") или стр_равны(имя, "СЛОВО") или
              стр_равны(имя, "ДВСЛОВО") или стр_равны(имя, "КВАД")):
            пока не _пконец(п):
                т := _пзагляни(п)
                если т.вид == ИТ_СТР и стр_равны(имя, "БАЙТ"):
                    п.i += 1
                    а := узел(У_СТР, строка)
                    а.текст = т.текст
                    список_добавь(д.дети, а как без64)
                иначе:
                    список_добавь(д.дети, _пвыр(п) как без64)
                т = _пзагляни(п)
                если т != пусто:
                    если т.вид == ИТ_ЗНАК и стр_равны(т.текст, ","):
                        п.i += 1
                    иначе:
                        иск_ош("ожидалась запятая в данных", строка)
        иначе:
            иск_ош("неизвестная директива", строка)
    если не _пконец(п):
        иск_ош("лишние токены в директиве", строка)
    верни д

функ ип_строку(токи *Список, регт *Список) *Список:
    # разбивает одну строку токенов в список операторов
    вых *Список = список_новый()
    если токи.длина == 0:
        верни вых
    т0 := список_получи(токи, 0) как *ИТок
    строка := т0.строка
    п := _пот(токи, строка)
    # метка в начале строки: ИМЯ ':'
    т := _пзагляни(п)
    т2 := _пзагляни2(п, 1)
    если (т != пусто и т.вид == ИТ_ИМЯ и т2 != пусто и
          т2.вид == ИТ_ЗНАК и стр_равны(т2.текст, ":")):
        м := узел(И_МЕТКА, строка)
        м.текст = т.текст
        список_добавь(вых, м как без64)
        п.i += 2
    если _пконец(п):
        верни вых
    т = _пдалее(п)
    если т == пусто или т.вид != ИТ_ИМЯ:
        иск_ош("ожидалась мнемоника или директива", строка)
    имя := т.текст
    # константа: ИМЯ РАВНО выражение
    т2 = _пзагляни(п)
    если т2 != пусто и т2.вид == ИТ_ИМЯ и стр_равны_нр(т2.текст, "РАВНО"):
        п.i += 1
        у := узел(И_РАВНО, строка)
        у.текст = имя
        у.а = _пвыр(п)
        список_добавь(вых, у как без64)
        если не _пконец(п):
            иск_ош("лишние токены после РАВНО", строка)
        верни вых
    # директива
    если _это_директива(имя):
        список_добавь(вых, _пдиректива(п, _канон(имя), строка) как без64)
        верни вых
    # обычная инструкция
    ин := узел(И_ИНСТР, строка)
    ин.текст = имя
    ин.дети = список_новый()
    пока не _пконец(п):
        список_добавь(ин.дети, _поперанд(п, регт) как без64)
        т3 := _пзагляни(п)
        если т3 != пусто:
            если т3.вид == ИТ_ЗНАК и стр_равны(т3.текст, ","):
                п.i += 1
            иначе:
                иск_ош("ожидалась запятая", строка)
    список_добавь(вых, ин как без64)
    верни вых

функ _канон(имя стр) стр:
    # имя директивы в каноническом верхнем регистре
    для i в 0..9:
        д := _дир_имя(i)
        если стр_равны_нр(имя, д):
            верни д
    верни имя

функ _дир_имя(i без64) стр:
    если i == 0:
