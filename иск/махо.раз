# махо — эмиттер Mach-O для macOS (x86-64).
#
# Исполняемый файл, загружаемый через dyld (MH_DYLDLINK, без PIE —
# адресация 1:1: виртуальный адрес = М_БАЗА + смещение в файле).
# Команды загрузки: __PAGEZERO (обязателен на современной macOS —
# без него parse_machfile возвращает LOAD_BADMACHO и процесс гибнет
# по SIGKILL), __TEXT (R-X) с заголовками и __text, __DATA (RW-),
# __LINKEDIT (R--; codesign дописывает подпись сюда), пустой
# LC_DYLD_INFO_ONLY, пустые LC_SYMTAB/LC_DYSYMTAB, LC_LOAD_DYLINKER
# (/usr/lib/dyld), LC_UUID, LC_BUILD_VERSION и LC_MAIN.
# Импорты не используются — системные вызовы идут через СИСВЫЗОВ
# (BSD-номера 0x2000000+N), динамических символов нет.

взять основа
взять сборщик      # План, уст*, выров

конст М_БАЗА = 0x100000000   # типичная база amd64-исполняемого
конст М_ЗГЛ = 32             # mach_header_64
конст М_СЕГ = 72             # segment_command_64 без секций
конст М_СЕК = 80             # section_64
конст М_ДИНФ = 48            # dyld_info_command
конст М_СИМТ = 24            # symtab_command
конст М_ДСИМ = 80            # dysymtab_command
конст М_ДЛИНК = 32           # dylinker_command (имя "/usr/lib/dyld")
конст М_УУИД = 24            # uuid_command
конст М_ВЕРС = 24            # LC_BUILD_VERSION
конст М_ВХОДК = 24           # LC_MAIN
конст М_ЗАПАС = 64           # резерв команд под LC_CODE_SIGNATURE —
                           # codesign вписывает команду туда без сдвига
                           # секций (аналог ld -headerpad); без него
                           # подпись ломает файл — SEGV при запуске

конст М_КОДСЕГ = 0x19        # LC_SEGMENT_64
конст М_КДИНФ = 0x80000022   # LC_DYLD_INFO_ONLY
конст М_КСИМТ = 0x2          # LC_SYMTAB
конст М_КДСИМ = 0xB          # LC_DYSYMTAB
конст М_КДЛИНК = 0xE         # LC_LOAD_DYLINKER
конст М_КУУИД = 0x1B         # LC_UUID
конст М_КВЕРС = 0x32         # LC_BUILD_VERSION
конст М_ВХОД = 0x80000028    # LC_MAIN

функ _м_заг(разм_дан нат.верх) нат.верх:
    # размер mach_header_64 + всех команд загрузки
    з нат.верх = (М_ЗГЛ + М_СЕГ + М_СЕГ + М_СЕК + М_СЕГ + М_ДИНФ + М_СИМТ +
                  М_ДСИМ + М_ДЛИНК + М_УУИД + М_ВЕРС + М_ВХОДК) как нат.верх
    если разм_дан > 0:
        з = з + (М_СЕГ + М_СЕК) как нат.верх
    верни з

функ махо_план(разм_код нат.верх, разм_дан нат.верх, импорты *Список,
               вход_смещ нат.верх) *План:
    # назначает адреса секций: vaddr = БАЗА + смещение в файле
    если импорты.длина > 0:
        иск_ош("ИМПОРТ не поддерживается для цели macos — используйте СИСВЫЗОВ",
               0, 0)
    пл *План = новый(План)
    пл.иат = список_новый()
    пл.блобы = список_новый()
    код_оф нат.верх = выров(_м_заг(разм_дан) + М_ЗАПАС, 16)
    пл.код_ва = (М_БАЗА + код_оф) как нат.верх
    пл.дан_ва = (М_БАЗА + выров(код_оф + разм_код, 0x1000)) как нат.верх
    пл.вход_ва = пл.код_ва + вход_смещ
    верни пл

функ _м_имя(б *Буфер, имя стр):
    # поле имени сегмента/секции: 16 байт, добитое нулями
    буф_добавь(б, имя)
    буф_нуль(б, 16 - имя.длина)

функ _м_секция(б *Буфер, сек стр, сег стр, адр нат.верх, разм нат.верх,
               оф нат.верх, флаги нат.верх):
    # section_64 (80 байт)
    _м_имя(б, сек)               # sectname
    _м_имя(б, сег)               # segname
    поз нат.верх = б.длина
    буф_нуль(б, М_СЕК - 32)
    уст64(б.данные, поз, адр)
    уст64(б.данные, поз + 8, разм)
    уст32(б.данные, поз + 16, оф)
    уст32(б.данные, поз + 20, 4)      # align = 2^4
    уст32(б.данные, поз + 32, флаги)  # reloff/nreloc между 24..31 — нули

функ _м_сегмент(б *Буфер, имя стр, ва нат.верх, вразм нат.верх,
                оф нат.верх, фразм нат.верх, макс нат.верх,
                нач нат.верх, нсек нат.верх):
    # segment_command_64; при нсек=1 секция пишется следом отдельно
    поз нат.верх = б.длина
    буф_нуль(б, М_СЕГ)
    уст32(б.данные, поз, М_КОДСЕГ)
    уст32(б.данные, поз + 4, (М_СЕГ + М_СЕК * нсек) как нат.верх)
    для инд в 0..имя.длина:
        б.данные[поз + 8 + инд] = имя.данные[инд]
    уст64(б.данные, поз + 24, ва)
    уст64(б.данные, поз + 32, вразм)
    уст64(б.данные, поз + 40, оф)
    уст64(б.данные, поз + 48, фразм)
    уст32(б.данные, поз + 56, макс)
    уст32(б.данные, поз + 60, нач)
    уст32(б.данные, поз + 64, нсек)
    # flags = 0 — нули от буф_нуль

функ _м_ком(б *Буфер, кд нат.верх, разм нат.верх) нат.верх:
    # команда загрузки из одних нулей; возвращает позицию для заполнения
    поз нат.верх = б.длина
    буф_нуль(б, разм)
    уст32(б.данные, поз, кд)
    уст32(б.данные, поз + 4, разм)
    верни поз

функ махо_строй(пл *План, код стр, дан стр) стр:
    # Mach-O x86-64 под dyld: заголовок, команды, код, данные, __LINKEDIT
    есть_дан лог = дан.длина > 0
    нкмд нат.верх = 10
    если есть_дан:
        нкмд = 11
    заг нат.верх = _м_заг(дан.длина)
    код_оф нат.верх = (пл.код_ва - М_БАЗА) как нат.верх
    дан_оф нат.верх = 0
    если есть_дан:
        дан_оф = (пл.дан_ва - М_БАЗА) как нат.верх
    вход_оф нат.верх = (пл.вход_ва - М_БАЗА) как нат.верх
    # хвост файла — начало __LINKEDIT; filesize сегментов страничный —
    # требование строгой проверки codesign; 16 байт хвоста — таблица
    # строк (один нуль) пустого LC_SYMTAB
    хвост нат.верх = выров(код_оф + код.длина, 0x1000)
    если есть_дан:
        хвост = дан_оф + выров(дан.длина, 0x1000)

    вых *Буфер = буф_новый()
    # mach_header_64
    буф_нуль(вых, М_ЗГЛ)
    уст32(вых.данные, 0, 0xFEEDFACF)  # MH_MAGIC_64
    уст32(вых.данные, 4, 0x01000007)  # CPU_TYPE_X86_64
    уст32(вых.данные, 8, 0x80000003)  # CPU_SUBTYPE_X86_64_ALL|LIB64
    уст32(вых.данные, 12, 2)          # MH_EXECUTE
    уст32(вых.данные, 16, нкмд)
    уст32(вых.данные, 20, заг - М_ЗГЛ)  # sizeofcmds
    уст32(вых.данные, 24, 7)          # MH_NOUNDEFS|MH_TWOLEVEL|MH_DYLDLINK
    уст32(вых.данные, 28, 0)          # reserved
    # __PAGEZERO: 4 ГиБ недоступной памяти от нуля — обязателен в XNU
    _м_сегмент(вых, "__PAGEZERO", 0, М_БАЗА, 0, 0, 0, 0, 0)
    # __TEXT: заголовки + код; maxprot RWX, initprot R-X
    _м_сегмент(вых, "__TEXT", М_БАЗА, выров(код_оф + код.длина, 0x1000),
               0, выров(код_оф + код.длина, 0x1000), 7, 5, 1)
    _м_секция(вых, "__text", "__TEXT", пл.код_ва, код.длина, код_оф,
              0x80000400)             # PURE_INSTRUCTIONS|SOME_INSTRUCTIONS
    # __DATA
    если есть_дан:
        _м_сегмент(вых, "__DATA", пл.дан_ва, выров(дан.длина, 0x1000),
                   дан_оф, выров(дан.длина, 0x1000), 3, 3, 1)
        _м_секция(вых, "__data", "__DATA", пл.дан_ва, дан.длина,
                  дан_оф, 0)
    # __LINKEDIT: таблица строк + место под подпись codesign
    _м_сегмент(вых, "__LINKEDIT", (М_БАЗА + хвост) как нат.верх,
               0x1000, хвост, 16, 1, 1, 0)
    # LC_DYLD_INFO_ONLY: пустой — ни перебазировок, ни связей
    _м_ком(вых, М_КДИНФ, М_ДИНФ)
    # LC_SYMTAB: символов нет; таблица строк — один нуль в __LINKEDIT
    поз нат.верх = _м_ком(вых, М_КСИМТ, М_СИМТ)
    уст32(вых.данные, поз + 8, хвост)    # symoff
    уст32(вых.данные, поз + 16, хвост)   # stroff
    уст32(вых.данные, поз + 20, 1)       # strsize
    # LC_DYSYMTAB: пустой
    _м_ком(вых, М_КДСИМ, М_ДСИМ)
    # LC_LOAD_DYLINKER: /usr/lib/dyld
    поз = _м_ком(вых, М_КДЛИНК, М_ДЛИНК)
    уст32(вых.данные, поз + 8, 12)       # имя со смещения 12
    дл стр = "/usr/lib/dyld"
    для инд в 0..дл.длина:
        вых.данные[поз + 12 + инд] = дл.данные[инд]
    # LC_UUID: идентификатор образа (постоянный)
    поз = _м_ком(вых, М_КУУИД, М_УУИД)
    уу стр = "ВЕЛЕС"
    для инд в 0..5:
        вых.данные[поз + 8 + инд] = уу.данные[инд]
    # LC_BUILD_VERSION: без платформенной метки ядро на Apple Silicon
    # убивает процесс при exec (Killed: 9)
    поз = _м_ком(вых, М_КВЕРС, М_ВЕРС)
    уст32(вых.данные, поз + 8, 1)            # PLATFORM_MACOS
    уст32(вых.данные, поз + 12, 0x000A0F00)  # minos = 10.15.0
    # LC_MAIN: entryoff — смещение входа в файле
    поз = _м_ком(вых, М_ВХОД, М_ВХОДК)
    уст64(вых.данные, поз + 8, вход_оф)
    # тело файла: код, данные, страничная подбивка, 16 нулей __LINKEDIT
    буф_нуль(вых, код_оф - вых.длина)
    буф_добавь(вых, код)
    если есть_дан:
        буф_нуль(вых, дан_оф - вых.длина)
        буф_добавь(вых, дан)
    буф_нуль(вых, хвост + 16 - вых.длина)
    верни буф_стр(вых)
