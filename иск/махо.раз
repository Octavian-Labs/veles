# махо — эмиттер Mach-O для macOS (x86-64).
#
# Исполняемый файл, загружаемый через dyld (MH_DYLDLINK, без PIE —
# адресация 1:1: виртуальный адрес = М_БАЗА + смещение в файле).
# Команды загрузки: __PAGEZERO (обязателен на современной macOS —
# без него parse_machfile возвращает LOAD_BADMACHO и процесс гибнет
# по SIGKILL), __TEXT (R-X) с заголовками и __text, __DATA (RW-),
# __LINKEDIT (R--; codesign дописывает подпись сюда), пустой
# LC_DYLD_INFO_ONLY, пустые LC_SYMTAB/LC_DYSYMTAB, LC_LOAD_DYLINKER
# (/usr/lib/dyld), LC_UUID, LC_BUILD_VERSION и LC_MAIN.
# Импорты не используются — системные вызовы идут через СИСВЫЗОВ
# (BSD-номера 0x2000000+N), динамических символов нет.

взять основа
взять сборщик      # План, уст*, выров

открыто конст М_БАЗА = 0x100000000   # типичная база amd64-исполняемого
открыто конст М_ЗГЛ = 32             # mach_header_64
открыто конст М_СЕГ = 72             # segment_command_64 без секций
открыто конст М_СЕК = 80             # section_64
открыто конст М_ДИНФ = 48            # dyld_info_command
открыто конст М_СИМТ = 24            # symtab_command
открыто конст М_ДСИМ = 80            # dysymtab_command
открыто конст М_ДЛИНК = 32           # dylinker_command (имя "/usr/lib/dyld")
открыто конст М_УУИД = 24            # uuid_command
открыто конст М_ВЕРС = 24            # LC_BUILD_VERSION
открыто конст М_ВХОДК = 24           # LC_MAIN
открыто конст М_ЗАПАС = 64           # резерв команд под LC_CODE_SIGNATURE —
                           # codesign вписывает команду туда без сдвига
                           # секций (аналог ld -headerpad); без него
                           # подпись ломает файл — SEGV при запуске

открыто конст М_КОДСЕГ = 0x19        # LC_SEGMENT_64
открыто конст М_КДИНФ = 0x80000022   # LC_DYLD_INFO_ONLY
открыто конст М_КСИМТ = 0x2          # LC_SYMTAB
открыто конст М_КДСИМ = 0xB          # LC_DYSYMTAB
открыто конст М_КДЛИНК = 0xE         # LC_LOAD_DYLINKER
открыто конст М_КУУИД = 0x1B         # LC_UUID
открыто конст М_КВЕРС = 0x32         # LC_BUILD_VERSION
открыто конст М_ВХОД = 0x80000028    # LC_MAIN

открыто функ _м_заг(разм_дан размер) размер:
    # размер mach_header_64 + всех команд загрузки
    разм размер = (М_ЗГЛ + М_СЕГ + М_СЕГ + М_СЕК + М_СЕГ + М_ДИНФ + М_СИМТ +
                  М_ДСИМ + М_ДЛИНК + М_УУИД + М_ВЕРС + М_ВХОДК) как размер
    если разм_дан > 0:
        разм = разм + (М_СЕГ + М_СЕК) как размер
    верни разм

открыто функ махо_план(разм_код размер, разм_дан размер, импорты *Список,
               вход_смещ размер) *План:
    # назначает адреса секций: vaddr = БАЗА + смещение в файле
    если импорты.длина > 0:
        иск_ош("ИМПОРТ не поддерживается для цели macos — используйте СИСВЫЗОВ",
               0, 0)
    пл *План = новый(План)
    пл.иат = список_новый()
    пл.блобы = список_новый()
    код_смещ размер = выров(_м_заг(разм_дан) + М_ЗАПАС, 16)
    пл.код_ва = (М_БАЗА + код_смещ) как размер
    пл.дан_ва = (М_БАЗА + выров(код_смещ + разм_код, 0x1000)) как размер
    пл.вход_ва = пл.код_ва + вход_смещ
    верни пл

открыто функ _м_имя(буф *Буфер, имя стр):
    # поле имени сегмента/секции: 16 байт, добитое нулями
    буф_добавь(буф, имя)
    буф_нуль(буф, 16 - имя.длина)

открыто функ _м_секция(буф *Буфер, сек стр, сег стр, адр размер, разм размер,
               смещ размер, флаги нат.верх):
    # section_64 (80 байт)
    _м_имя(буф, сек)             # sectname
    _м_имя(буф, сег)             # segname
    поз размер = буф.длина
    буф_нуль(буф, М_СЕК - 32)
    уст64(буф.данные, поз, адр)
    уст64(буф.данные, поз + 8, разм)
    уст32(буф.данные, поз + 16, смещ)
    уст32(буф.данные, поз + 20, 4)      # align = 2^4
    уст32(буф.данные, поз + 32, флаги)  # reloff/nreloc между 24..31 — нули

открыто функ _м_сегмент(буф *Буфер, имя стр, ва размер, вразм размер,
                смещ размер, фразм размер, макс нат.верх,
                нач размер, число_сек размер):
    # segment_command_64; при число_сек=1 секция пишется следом отдельно
    поз размер = буф.длина
    буф_нуль(буф, М_СЕГ)
    уст32(буф.данные, поз, М_КОДСЕГ)
    уст32(буф.данные, поз + 4, (М_СЕГ + М_СЕК * число_сек) как нат.верх)
    для инд в 0..имя.длина:
        буф.данные[поз + 8 + инд] = имя.данные[инд]
    уст64(буф.данные, поз + 24, ва)
    уст64(буф.данные, поз + 32, вразм)
    уст64(буф.данные, поз + 40, смещ)
    уст64(буф.данные, поз + 48, фразм)
    уст32(буф.данные, поз + 56, макс)
    уст32(буф.данные, поз + 60, нач)
    уст32(буф.данные, поз + 64, число_сек)
    # flags = 0 — нули от буф_нуль

открыто функ _м_ком(буф *Буфер, кмд нат.верх, разм размер) размер:
    # команда загрузки из одних нулей; возвращает позицию для заполнения
    поз размер = буф.длина
    буф_нуль(буф, разм)
    уст32(буф.данные, поз, кмд)
    уст32(буф.данные, поз + 4, разм)
    верни поз

открыто функ махо_строй(пл *План, код стр, дан стр) стр:
    # Mach-O x86-64 под dyld: заголовок, команды, код, данные, __LINKEDIT
    есть_дан лог = дан.длина > 0
    число_кмд размер = 10
    если есть_дан:
        число_кмд = 11
    разм_заг размер = _м_заг(дан.длина)
    код_смещ размер = (пл.код_ва - М_БАЗА) как размер
    дан_смещ размер = 0
    если есть_дан:
        дан_смещ = (пл.дан_ва - М_БАЗА) как размер
    вход_смещ размер = (пл.вход_ва - М_БАЗА) как размер
    # хвост файла — начало __LINKEDIT; filesize сегментов страничный —
    # требование строгой проверки codesign; 16 байт хвоста — таблица
    # строк (один нуль) пустого LC_SYMTAB
    хвост размер = выров(код_смещ + код.длина, 0x1000)
    если есть_дан:
        хвост = дан_смещ + выров(дан.длина, 0x1000)

    вых *Буфер = буф_новый()
    # mach_header_64
    буф_нуль(вых, М_ЗГЛ)
    уст32(вых.данные, 0, 0xFEEDFACF)  # MH_MAGIC_64
    уст32(вых.данные, 4, 0x01000007)  # CPU_TYPE_X86_64
    уст32(вых.данные, 8, 0x80000003)  # CPU_SUBTYPE_X86_64_ALL|LIB64
    уст32(вых.данные, 12, 2)          # MH_EXECUTE
    уст32(вых.данные, 16, число_кмд)
    уст32(вых.данные, 20, разм_заг - М_ЗГЛ)  # sizeofcmds
    уст32(вых.данные, 24, 7)          # MH_NOUNDEFS|MH_TWOLEVEL|MH_DYLDLINK
    уст32(вых.данные, 28, 0)          # reserved
    # __PAGEZERO: 4 ГиБ недоступной памяти от нуля — обязателен в XNU
    _м_сегмент(вых, "__PAGEZERO", 0, М_БАЗА, 0, 0, 0, 0, 0)
    # __TEXT: заголовки + код; maxprot RWX, initprot R-X
    _м_сегмент(вых, "__TEXT", М_БАЗА, выров(код_смещ + код.длина, 0x1000),
               0, выров(код_смещ + код.длина, 0x1000), 7, 5, 1)
    _м_секция(вых, "__text", "__TEXT", пл.код_ва, код.длина, код_смещ,
              0x80000400)             # PURE_INSTRUCTIONS|SOME_INSTRUCTIONS
    # __DATA
    если есть_дан:
        _м_сегмент(вых, "__DATA", пл.дан_ва, выров(дан.длина, 0x1000),
                   дан_смещ, выров(дан.длина, 0x1000), 3, 3, 1)
        _м_секция(вых, "__data", "__DATA", пл.дан_ва, дан.длина,
                  дан_смещ, 0)
    # __LINKEDIT: таблица строк + место под подпись codesign
    _м_сегмент(вых, "__LINKEDIT", (М_БАЗА + хвост) как размер,
               0x1000, хвост, 16, 1, 1, 0)
    # LC_DYLD_INFO_ONLY: пустой — ни перебазировок, ни связей
    _м_ком(вых, М_КДИНФ, М_ДИНФ)
    # LC_SYMTAB: символов нет; таблица строк — один нуль в __LINKEDIT
    поз размер = _м_ком(вых, М_КСИМТ, М_СИМТ)
    уст32(вых.данные, поз + 8, хвост)    # symoff
    уст32(вых.данные, поз + 16, хвост)   # stroff
    уст32(вых.данные, поз + 20, 1)       # strsize
    # LC_DYSYMTAB: пустой
    _м_ком(вых, М_КДСИМ, М_ДСИМ)
    # LC_LOAD_DYLINKER: /usr/lib/dyld
    поз = _м_ком(вых, М_КДЛИНК, М_ДЛИНК)
    уст32(вых.данные, поз + 8, 12)       # имя со смещения 12
    длинк стр = "/usr/lib/dyld"
    для инд в 0..длинк.длина:
        вых.данные[поз + 12 + инд] = длинк.данные[инд]
    # LC_UUID: идентификатор образа (постоянный)
    поз = _м_ком(вых, М_КУУИД, М_УУИД)
    уид стр = "ВЕЛЕС"
    для инд в 0..5:
        вых.данные[поз + 8 + инд] = уид.данные[инд]
    # LC_BUILD_VERSION: без платформенной метки ядро на Apple Silicon
    # убивает процесс при exec (Killed: 9)
    поз = _м_ком(вых, М_КВЕРС, М_ВЕРС)
    уст32(вых.данные, поз + 8, 1)            # PLATFORM_MACOS
    уст32(вых.данные, поз + 12, 0x000A0F00)  # minos = 10.15.0
    # LC_MAIN: entryoff — смещение входа в файле
    поз = _м_ком(вых, М_ВХОД, М_ВХОДК)
    уст64(вых.данные, поз + 8, вход_смещ)
    # тело файла: код, данные, страничная подбивка, 16 нулей __LINKEDIT
    буф_нуль(вых, код_смещ - вых.длина)
    буф_добавь(вых, код)
    если есть_дан:
        буф_нуль(вых, дан_смещ - вых.длина)
        буф_добавь(вых, дан)
    буф_нуль(вых, хвост + 16 - вых.длина)
    верни буф_стр(вых)
