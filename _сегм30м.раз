функ лог_нат(х вещ.рост) вещ.рост:
    если х <= 0.0:
        верни -20.0
    м вещ.рост = х
    корр вещ.рост = 0.0
    пока м > 1.4:
        м = м / 2.0
        корр += 0.6931472
    пока м < 0.7:
        м = м * 2.0
        корр -= 0.6931472
    у вещ.рост = (м - 1.0) / (м + 1.0)
    у2 вещ.рост = у * у
    член вещ.рост = у
    сумма вещ.рост = 0.0
    для порядок в 0..12:
        сумма += член / ((порядок*2 + 1) как вещ.рост)
        член = член * у2
    верни сумма * 2.0 + корр

функ печать_вещ(знач вещ.рост):
    если знач < 0.0:
        печать("-")
        знач = 0.0 - знач
    целая цел.верх = знач как цел.верх
    дробь цел.верх = ((знач - (целая как вещ.рост)) * 1000.0 + 0.5) как цел.верх
    если дробь >= 1000:
        целая += 1
        дробь = 0
    печать(цел_в_стр(целая))
    печать(".")
    если дробь < 10:
        печать("00")
    а если дробь < 100:
        печать("0")
    печать(цел_в_стр(дробь))

