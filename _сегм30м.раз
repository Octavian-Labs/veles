функ запиши_pgm(путь стр, данные *вещ.рост, смещение цел.верх):
    буфер *Буфер = буф_новый()
    буф_добавь(буфер, "P2\n64 64\n255\n")
    для ряд в 0..64:
        для столбец в 0..64:
            значение вещ.рост = данные[смещение + ряд*64 + столбец]
            пиксель цел.верх = (значение * 255.0) как цел.верх
            если пиксель < 0: пиксель = 0
            если пиксель > 255: пиксель = 255
            буф_добавь(буфер, цел_в_стр(пиксель))
            буф_сим(буфер, ' ')
        буф_сим(буфер, 10)
    файл_запиши(путь, буф_стр(буфер))
    буф_свободен(буфер)

