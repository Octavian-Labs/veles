функ класс_пикселя(выход *век вещ.рост х 4, маски *вещ.рост,
                    индекс цел.верх) цел.верх:
    целевых цел.верх = 0
    предсказано цел.верх = 0
    попаданий цел.верх = 0
    для класс в 0..4:
        целевой лог = маски[класс*4096 + индекс] > 0.5
        предсказ лог = выход[индекс][класс] > 0.5
        если целевой: целевых += 1
        если предсказ: предсказано += 1
        если целевой и предсказ: попаданий += 1
    если целевых == 0 и предсказано == 0:
        верни 0
    если целевых == 0:
        верни 1
    если предсказано == 0:
        верни 4
    если попаданий == целевых и предсказано == целевых:
        верни 3
    если попаданий > 0:
        верни 2
    верни 4

