            предсказано лог = выход[пиксель][класс] > 0.5
            целевой лог = маски[класс*4096 + пиксель] > 0.5
            если предсказано и целевой:
                пересечение += 1
            если предсказано или целевой:
                объединение += 1
        если объединение > 0:
            iou вещ.рост = (пересечение как вещ.рост) / (объединение как вещ.рост)
            печать("IoU")
            печать(цел_в_стр(класс))
            печать("=")
            печать_вещ(iou)
            печать(" ")
    печатьстр("")
    печать("средний IoU: ")
