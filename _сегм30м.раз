                        вых_ряд цел.верх = ряд*2 + часть_у
                        вых_столбец цел.верх = столбец*2 + часть_х
                        выход[(вых_ряд*вых_шир + вых_столбец)*выход_блоков + выход_блок] = релу4(накоп)

