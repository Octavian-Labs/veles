функ потеря_bce(выход *век вещ.рост х 4, маски *вещ.рост) вещ.рост:
    потеря вещ.рост = 0.0
    для пиксель в 0..4096:
        для класс в 0..4:
            цель вещ.рост = маски[класс*4096 + пиксель]
            п вещ.рост = выход[пиксель][класс]
            если п < 0.0000001:
                п = 0.0000001
            если п > 0.9999999:
                п = 0.9999999
            потеря -= цель * лог_нат(п) + (1.0 - цель) * лог_нат(1.0 - п)
    верни потеря / 16384.0

функ iou_масок(выход *век вещ.рост х 4, маски *вещ.рост) вещ.рост:
    средний вещ.рост = 0.0
    присутствует цел.верх = 0
    для класс в 0..4:
        пересечение цел.верх = 0
        объединение цел.верх = 0
        для пиксель в 0..4096:
            предсказано лог = выход[пиксель][класс] > 0.5
            целевой лог = маски[класс*4096 + пиксель] > 0.5
            если предсказано и целевой:
                пересечение += 1
            если предсказано или целевой:
                объединение += 1
        если объединение > 0:
            присутствует += 1
            средний += (пересечение как вещ.рост) / (объединение как вещ.рост)
    если присутствует == 0:
        верни 1.0
    верни средний / (присутствует как вещ.рост)

функ релу_гр4(д4 век вещ.рост х 4, акт4 век вещ.рост х 4) век вещ.рост х 4:
    # д4 там, где акт4 > 0: маска сравнения & д4
    верни д4 & (акт4 > повтор(0.0 как вещ.рост))

функ вклад4(веса *век вещ.рост х 4, инд цел.верх, шаг цел.верх,
             д4 век вещ.рост х 4) век вещ.рост х 4:
    верни век вещ.рост х 4{сумма(веса[инд] * д4),
                            сумма(веса[инд + шаг] * д4),
                            сумма(веса[инд + шаг*2] * д4),
                            сумма(веса[инд + шаг*3] * д4)}

функ взять_если(д вещ.рост, поб цел.верх, поз цел.верх) вещ.рост:
    если поб == поз: верни д
    верни 0.0

функ гр_свертка(вход *век вещ.рост х 4, акт_вых *век вещ.рост х 4,
                 д_вых *век вещ.рост х 4,
                 ширина цел.верх, высота цел.верх,
                 вход_блоков цел.верх, выход_блоков цел.верх,
                 веса *век вещ.рост х 4,
                 гвеса *век вещ.рост х 4, гсмещ *век вещ.рост х 4,
                 д_вх *век вещ.рост х 4):
    для ряд в 0..высота:
        для столбец в 0..ширина:
            пиксель цел.верх = ряд*ширина + столбец
            пвб цел.верх = пиксель*выход_блоков
            для выход_блок в 0..выход_блоков:
                д4 век вещ.рост х 4 = релу_гр4(д_вых[пвб + выход_блок],
                                              акт_вых[пвб + выход_блок])
                гсмещ[выход_блок] += д4
                для ядро_у в 0..3:
                    вход_у цел.верх = ряд + ядро_у - 1
                    если вход_у >= 0 и вход_у < высота:
                        для ядро_х в 0..3:
                            вход_х цел.верх = столбец + ядро_х - 1
                            если вход_х >= 0 и вход_х < ширина:
                                вх_база цел.верх = (вход_у*ширина + вход_х)*вход_блоков
                                вес_осн цел.верх = (ядро_у*3 + ядро_х)*вход_блоков*4*выход_блоков + выход_блок
                                для вход_блок в 0..вход_блоков:
                                    значение4 век вещ.рост х 4 = вход[вх_база + вход_блок]
                                    инд0 цел.верх = вес_осн + вход_блок*4*выход_блоков
                                    д_вх[вх_база + вход_блок] += вклад4(веса, инд0, выход_блоков, д4)
                                    для лейн в 0..4:
                                        гвеса[инд0 + лейн*выход_блоков] += д4 * повтор(значение4[лейн])

функ гр_свертка_1_32(вход *вещ.рост, акт_вых *век вещ.рост х 4,
                      д_вых *век вещ.рост х 4,
                      гвеса *век вещ.рост х 4, гсмещ *век вещ.рост х 4):
    для ряд в 0..64:
        ряд64 цел.верх = ряд*64
        для столбец в 0..64:
            п8 цел.верх = (ряд64 + столбец)*8
            для блок в 0..8:
                д4 век вещ.рост х 4 = релу_гр4(д_вых[п8 + блок],
                                              акт_вых[п8 + блок])
                гсмещ[блок] += д4
                для ядро_у в 0..3:
                    вход_у цел.верх = ряд + ядро_у - 1
                    если вход_у >= 0 и вход_у < 64:
                        вх_осн цел.верх = вход_у*64 + столбец - 1
                        гвес_осн цел.верх = ядро_у*24 + блок
                        для ядро_х в 0..3:
                            вход_х цел.верх = столбец + ядро_х - 1
                            если вход_х >= 0 и вход_х < 64:
                                гвеса[гвес_осн + ядро_х*8] += д4 * повтор(вход[вх_осн + ядро_х])

функ гр_макс_пул2(вход *век вещ.рост х 4, д_вых *век вещ.рост х 4,
                   ширина цел.верх, высота цел.верх, блоков цел.верх,
                   д_вх *век вещ.рост х 4):
    вых_шир цел.верх = ширина / 2
    шб цел.верх = ширина * блоков
    для ряд в 0..высота/2:
        ряд2шб цел.верх = ряд*2 * шб
        вых_ряд цел.верх = ряд * вых_шир
        для столбец в 0..ширина/2:
            ст2б цел.верх = столбец*2 * блоков
            для блок в 0..блоков:
                база0 цел.верх = ряд2шб + ст2б + блок
                база1 цел.верх = база0 + шб
                д4 век вещ.рост х 4 = д_вых[(вых_ряд + столбец)*блоков + блок]
                # четыре соседа загружаются один раз, а не по лейну
                в0 век вещ.рост х 4 = вход[база0]
                в1 век вещ.рост х 4 = вход[база0 + блоков]
                в2 век вещ.рост х 4 = вход[база1]
                в3 век вещ.рост х 4 = вход[база1 + блоков]
                поб0 цел.верх = 0
                поб1 цел.верх = 0
                поб2 цел.верх = 0
                поб3 цел.верх = 0
                для лейн в 0..4:
                    макс вещ.рост = в0[лейн]
                    поб цел.верх = 0
                    если в1[лейн] > макс:
                        макс = в1[лейн]
                        поб = 1
                    если в2[лейн] > макс:
                        макс = в2[лейн]
                        поб = 2
                    если в3[лейн] > макс:
                        поб = 3
                    если лейн == 0: поб0 = поб
                    если лейн == 1: поб1 = поб
                    если лейн == 2: поб2 = поб
                    если лейн == 3: поб3 = поб
                д_вх[база0] += век вещ.рост х 4{взять_если(д4[0], поб0, 0),
                    взять_если(д4[1], поб1, 0), взять_если(д4[2], поб2, 0),
                    взять_если(д4[3], поб3, 0)}
                д_вх[база0 + блоков] += век вещ.рост х 4{взять_если(д4[0], поб0, 1),
                    взять_если(д4[1], поб1, 1), взять_если(д4[2], поб2, 1),
                    взять_если(д4[3], поб3, 1)}
                д_вх[база1] += век вещ.рост х 4{взять_если(д4[0], поб0, 2),
                    взять_если(д4[1], поб1, 2), взять_если(д4[2], поб2, 2),
                    взять_если(д4[3], поб3, 2)}
                д_вх[база1 + блоков] += век вещ.рост х 4{взять_если(д4[0], поб0, 3),
                    взять_если(д4[1], поб1, 3), взять_если(д4[2], поб2, 3),
                    взять_если(д4[3], поб3, 3)}

функ гр_соедини(д_вых *век вещ.рост х 4, левых цел.верх,
                 правых цел.верх, пикселей цел.верх,
                 д_лев *век вещ.рост х 4, д_прав *век вещ.рост х 4):
    всего цел.верх = левых + правых
    для пиксель в 0..пикселей:
        пв цел.верх = пиксель*всего
        пл цел.верх = пиксель*левых
        пп цел.верх = пиксель*правых
        для блок в 0..левых:
            д_лев[пл + блок] += д_вых[пв + блок]
        для блок в 0..правых:
            д_прав[пп + блок] += д_вых[пв + левых + блок]

функ гр_вверх2(вход *век вещ.рост х 4, акт_вых *век вещ.рост х 4,
                д_вых *век вещ.рост х 4,
                ширина цел.верх, высота цел.верх,
                вход_блоков цел.верх, выход_блоков цел.верх,
                веса *век вещ.рост х 4,
                гвеса *век вещ.рост х 4, гсмещ *век вещ.рост х 4,
                д_вх *век вещ.рост х 4):
    вых_шир цел.верх = ширина * 2
    для ряд в 0..высота:
        рядш цел.верх = ряд*ширина
        для столбец в 0..ширина:
            пиксель цел.верх = рядш + столбец
            пвх цел.верх = пиксель*вход_блоков
            для часть_у в 0..2:
                для часть_х в 0..2:
                    часть цел.верх = часть_у*2 + часть_х
                    вых_пикс цел.верх = (ряд*2 + часть_у)*вых_шир + столбец*2 + часть_х
                    вв цел.верх = вых_пикс*выход_блоков
                    вес_осн цел.верх = часть*вход_блоков*4*выход_блоков
                    для выход_блок в 0..выход_блоков:
                        д4 век вещ.рост х 4 = релу_гр4(д_вых[вв + выход_блок],
                                                      акт_вых[вв + выход_блок])
                        гсмещ[выход_блок] += д4
                        вес_вых цел.верх = вес_осн + выход_блок
                        для вход_блок в 0..вход_блоков:
                            значение4 век вещ.рост х 4 = вход[пвх + вход_блок]
                            инд0 цел.верх = вес_вых + вход_блок*4*выход_блоков
                            д_вх[пвх + вход_блок] += вклад4(веса, инд0, выход_блоков, д4)
                            для лейн в 0..4:
                                гвеса[инд0 + лейн*выход_блоков] += д4 * повтор(значение4[лейн])

функ гр_выход_масок(вход *век вещ.рост х 4, выход *век вещ.рост х 4,
                     маски *вещ.рост, пикселей цел.верх,
                     вход_блоков цел.верх,
                     веса *век вещ.рост х 4,
                     гвеса *век вещ.рост х 4, гсмещ *век вещ.рост х 4,
                     д_вх *век вещ.рост х 4):
    для пиксель в 0..пикселей:
        д4 век вещ.рост х 4 = выход[пиксель] - век вещ.рост х 4{маски[пиксель],
            маски[4096 + пиксель], маски[8192 + пиксель], маски[12288 + пиксель]}
        а вещ.рост = д4[0] * 0.000244140625
        б вещ.рост = д4[1] * 0.000244140625
        в вещ.рост = д4[2] * 0.000244140625
        г вещ.рост = д4[3] * 0.000244140625
        если маски[пиксель] > 0.5: а = а * 8.0
        если маски[4096 + пиксель] > 0.5: б = б * 8.0
        если маски[8192 + пиксель] > 0.5: в = в * 8.0
        если маски[12288 + пиксель] > 0.5: г = г * 8.0
        д4 = век вещ.рост х 4{а, б, в, г}
        гсмещ[0] += д4
        пвх цел.верх = пиксель*вход_блоков
        для блок в 0..вход_блоков:
            значение4 век вещ.рост х 4 = вход[пвх + блок]
            д_вх[пвх + блок] += вклад4(веса, блок*4, 1, д4)
            для лейн в 0..4:
                гвеса[блок*4 + лейн] += д4 * повтор(значение4[лейн])

функ зажми(знач вещ.рост) вещ.рост:
