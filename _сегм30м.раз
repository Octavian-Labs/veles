функ ген_сцену(зерно *нат.верх, вход *вещ.рост, маски *вещ.рост):
    для индекс в 0..4096:
        вход[индекс] = 0.0
    для индекс в 0..16384:
        маски[индекс] = 0.0
    объектов цел.верх = 1 + (случ(зерно) % 4) как цел.верх
    для объект в 0..объектов:
        класс цел.верх = (случ(зерно) % 4) как цел.верх
        центр_х вещ.рост = 0.2 + случ01(зерно) * 0.6
        центр_у вещ.рост = 0.2 + случ01(зерно) * 0.6
        размер_ф вещ.рост = 0.10 + случ01(зерно) * 0.18
        толщина вещ.рост = 0.035 + случ01(зерно) * 0.045
        яркость вещ.рост = 0.2 + (класс как вещ.рост) * 0.2
        для ряд в 0..64:
            у вещ.рост = (ряд как вещ.рост) / 63.0
            для столбец в 0..64:
                х вещ.рост = (столбец как вещ.рост) / 63.0
                разн_х вещ.рост = х - центр_х
                разн_у вещ.рост = у - центр_у
                абс_х вещ.рост = модуль(разн_х)
                абс_у вещ.рост = модуль(разн_у)
                внутри лог = нет
                если класс == 0:
                    внутри = разн_х*разн_х + разн_у*разн_у <= размер_ф*размер_ф
                а если класс == 1:
                    внутри = абс_х <= размер_ф и абс_у <= размер_ф
                а если класс == 2:
                    внутри = абс_х <= толщина и абс_у <= размер_ф
                    если абс_у <= толщина и абс_х <= размер_ф:
                        внутри = да
                иначе:
                    дальность вещ.рост = разн_х*разн_х + разн_у*разн_у
                    внешний вещ.рост = размер_ф*размер_ф
                    внутренний вещ.рост = (размер_ф-толщина)*(размер_ф-толщина)
                    внутри = дальность <= внешний и дальность >= внутренний
                если внутри:
                    индекс = ряд*64 + столбец
                    маски[класс*4096 + индекс] = 1.0
                    вход[индекс] = яркость
    для индекс в 0..4096:
        шум вещ.рост = (случ01(зерно) * 2.0 - 1.0) * 0.08
        значение вещ.рост = вход[индекс] + шум
        если значение < 0.0:
            значение = 0.0
        если значение > 1.0:
            значение = 1.0
        вход[индекс] = значение

функ релу4(вход век вещ.рост х 4) век вещ.рост х 4:
    а вещ.рост = вход[0]
    б вещ.рост = вход[1]
    в вещ.рост = вход[2]
    г вещ.рост = вход[3]
    если а < 0.0: а = 0.0
    если б < 0.0: б = 0.0
    если в < 0.0: в = 0.0
    если г < 0.0: г = 0.0
    верни век вещ.рост х 4{а, б, в, г}

