{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "РАЗУМ",
  "scopeName": "source.razum",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#iskra-block" },
    { "include": "#module-use" },
    { "include": "#function-decl" },
    { "include": "#type-decl" },
    { "include": "#const-decl" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#constant" },
    { "include": "#module-chain" },
    { "include": "#predicate-call" },
    { "include": "#function-call" },
    { "include": "#builtin" },
    { "include": "#number" },
    { "include": "#deprecated-op" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.number-sign.razum",
          "match": "#.*$"
        },
        {
          "name": "comment.line.semicolon.razum",
          "match": ";.*$"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.razum",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.razum",
              "match": "\\\\x[0-9A-Fa-f]{2}|\\\\."
            }
          ]
        }
      ]
    },
    "char": {
      "patterns": [
        {
          "name": "string.quoted.single.razum",
          "match": "'(?:\\\\x[0-9A-Fa-f]{2}|\\\\.|[^'\\\\])'"
        }
      ]
    },
    "iskra-block": {
      "patterns": [
        {
          "name": "meta.embedded.iskra.razum",
          "begin": "^(\\s*)(искра)(\\s*:)",
          "beginCaptures": {
            "2": { "name": "keyword.control.razum" },
            "3": { "name": "punctuation.separator.razum" }
          },
          "end": "^(?!\\1[ \\t]|\\s*$)",
          "patterns": [
            { "include": "source.iskra" }
          ]
        }
      ]
    },
    "module-use": {
      "patterns": [
        {
          "name": "meta.import.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_.])(взять)(\\s+)((?:[A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*\\.)*[A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)(\\s*(?:,\\s*(?:[A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*\\.)*[A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.razum" },
            "3": { "name": "entity.name.namespace.razum" },
            "4": { "name": "entity.name.namespace.razum" }
          }
        }
      ]
    },
    "function-decl": {
      "patterns": [
        {
          "name": "meta.function.method.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])(функ)\\s*\\([^)]*\\)\\s*([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
          "captures": {
            "1": { "name": "keyword.razum" },
            "2": { "name": "entity.name.function.razum" }
          }
        },
        {
          "name": "meta.function.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])(функ)\\s+([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
          "captures": {
            "1": { "name": "keyword.razum" },
            "2": { "name": "entity.name.function.razum" }
          }
        }
      ]
    },
    "type-decl": {
      "patterns": [
        {
          "name": "meta.type.declaration.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])(запись|переч|тип)\\s+([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
          "captures": {
            "1": { "name": "keyword.razum" },
            "2": { "name": "entity.name.type.razum" }
          }
        }
      ]
    },
    "const-decl": {
      "patterns": [
        {
          "name": "meta.constant.declaration.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])(конст)\\s+([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
          "captures": {
            "1": { "name": "keyword.razum" },
            "2": { "name": "constant.other.razum" }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])(а\\s+если|если|иначе|пока|вечно|для|выбор|верни|хватит|следующий|отложи|искра)(?![A-Za-zА-Яа-яЁё0-9_])"
        },
        {
          "name": "keyword.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])(взять|внеш|функ|запись|переч|тип|конст|введи)(?![A-Za-zА-Яа-яЁё0-9_])"
        },
        {
          "name": "keyword.operator.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])(не\\s+в|и|или|не|как|в|новый|размер)(?![A-Za-zА-Яа-яЁё0-9_])"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "name": "storage.type.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_.])(цел|нат|вещ)(\\.)(старт|шаг|рост|верх|пик)(?![A-Za-zА-Яа-яЁё0-9_.])",
          "captures": {
            "1": { "name": "storage.type.razum" },
            "2": { "name": "punctuation.accessor.razum" },
            "3": { "name": "storage.type.level.razum" }
          }
        },
        {
          "name": "storage.type.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_.])(лог|сим|стр|знак)(?![A-Za-zА-Яа-яЁё0-9_])"
        },
        {
          "name": "invalid.deprecated.type.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_.])(цел8|цел16|цел32|цел64|без8|без16|без32|без64|бул|д32|д64)(?![A-Za-zА-Яа-яЁё0-9_])"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])(да|нет|пусто)(?![A-Za-zА-Яа-яЁё0-9_])"
        }
      ]
    },
    "module-chain": {
      "patterns": [
        {
          "name": "meta.namespace.call.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_.])((?:[A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*\\.)+)([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.razum" },
            "2": { "name": "entity.name.function.razum" }
          }
        },
        {
          "match": "([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)(\\.)(?=[A-Za-zА-Яа-яЁё_])",
          "captures": {
            "1": { "name": "entity.name.namespace.razum" },
            "2": { "name": "punctuation.accessor.razum" }
          }
        },
        {
          "name": "variable.other.property.razum",
          "match": "(?<=\\.)([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)(?!\\s*\\()"
        }
      ]
    },
    "predicate-call": {
      "patterns": [
        {
          "name": "entity.name.function.predicate.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_.])(это_[A-Za-zА-Яа-яЁё0-9_]+|[A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*_это_[A-Za-zА-Яа-яЁё0-9_]+)(?=\\s*\\()"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "entity.name.function.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_.])([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "builtin": {
      "patterns": [
        {
          "name": "support.function.builtin.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])(выдели|освободи)(?![A-Za-zА-Яа-яЁё0-9_])"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])0[xX][0-9a-fA-F_]+(?![A-Za-zА-Яа-яЁё0-9_])"
        },
        {
          "name": "constant.numeric.binary.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])0[bB][01_]+(?![A-Za-zА-Яа-яЁё0-9_])"
        },
        {
          "name": "constant.numeric.octal.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])0[oO][0-7_]+(?![A-Za-zА-Яа-яЁё0-9_])"
        },
        {
          "name": "constant.numeric.decimal.razum",
          "match": "(?<![A-Za-zА-Яа-яЁё0-9_])[0-9][0-9_]*(?![A-Za-zА-Яа-яЁё0-9_])"
        }
      ]
    },
    "deprecated-op": {
      "patterns": [
        {
          "name": "invalid.deprecated.razum",
          "match": ":="
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.razum",
          "match": "\\.\\.=|<<=|>>=|\\.\\.|==|!=|<=|>=|<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|[-+*/%<>=()\\[\\]{},.:&|^!]"
        }
      ]
    }
  }
}
