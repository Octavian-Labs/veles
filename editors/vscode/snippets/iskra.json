{
  "Программа": {
    "prefix": "программа",
    "body": [
      ";цель ${1|windows,linux,macos|}",
      "СЕКЦИЯ код",
      "ВХОД старт",
      "старт:",
      "    $0"
    ],
    "description": "Каркас программы ИСКРЫ с прагмой цели"
  },
  "Прагма цели": {
    "prefix": ";цель",
    "body": ";цель ${1|windows,linux,macos|}",
    "description": "Прагма целевой ОС (первая строка файла)"
  },
  "Секция": {
    "prefix": "секция",
    "body": "СЕКЦИЯ ${1|код,данные|}",
    "description": "Объявление секции"
  },
  "Точка входа": {
    "prefix": "вход",
    "body": "ВХОД ${1:старт}",
    "description": "Директива точки входа"
  },
  "Метка": {
    "prefix": "метка",
    "body": [
      "${1:имя}:",
      "    $0"
    ],
    "description": "Метка"
  },
  "Константа": {
    "prefix": "равно",
    "body": "${1:ИМЯ} РАВНО ${0:значение}",
    "description": "Константа: имя РАВНО выражение"
  },
  "Вход кадра": {
    "prefix": "входкадра",
    "body": "ВХОДКАДРА ${1:0}",
    "description": "Пролог функции: ВСТЕК УКК; ПЕР УКК,УКС; ВЫЧ УКС,размер"
  },
  "Выход кадра": {
    "prefix": "выходкадра",
    "body": "ВЫХОДКАДРА",
    "description": "Эпилог функции: ПЕР УКС,УКК; ИЗСТЕКА УКК; ВОЗВРАТ"
  },
  "Данные байт": {
    "prefix": "байт",
    "body": "${1:имя}: БАЙТ ${0:0}",
    "description": "Директива данных БАЙТ"
  },
  "Данные квад": {
    "prefix": "квад",
    "body": "${1:имя}: КВАД ${0:0}",
    "description": "Директива данных КВАД"
  },
  "Строка": {
    "prefix": "строка",
    "body": "${1:имя}: БАЙТ \"${0:текст}\"",
    "description": "Строковые данные"
  },
  "Выход linux": {
    "prefix": "выход linux",
    "body": [
      "ПЕР ПРМ, ${1:0}      ; код выхода",
      "ПЕР АКК, 60          ; sys_exit",
      "СИСВЫЗОВ"
    ],
    "description": "sys_exit для Linux"
  },
  "Выход macos": {
    "prefix": "выход macos",
    "body": [
      "ПЕР ПРМ, ${1:0}      ; код выхода",
      "ПЕР АКК, 0x2000001   ; sys_exit",
      "СИСВЫЗОВ"
    ],
    "description": "sys_exit для macOS (BSD 0x2000000+N)"
  },
  "Вывод linux": {
    "prefix": "вывод linux",
    "body": [
      "ПЕР ПРМ, 1           ; stdout",
      "АДР ИСТ, [${1:текст}]",
      "ПЕР ДАН, ${2:длина}",
      "ПЕР АКК, 1           ; sys_write",
      "СИСВЫЗОВ"
    ],
    "description": "sys_write для Linux"
  },
  "Вызов": {
    "prefix": "вызов",
    "body": "ВЫЗОВ ${1:функция}",
    "description": "Вызов подпрограммы"
  }
}
