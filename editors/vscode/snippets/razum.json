{
  "Функция": {
    "prefix": "функ",
    "body": [
      "функ ${1:имя}(${2:парам тип})${3: цел.верх}:",
      "    $0"
    ],
    "description": "Объявление функции"
  },
  "Метод записи": {
    "prefix": "функ метод",
    "body": [
      "функ (${1:п} *${2:Запись}) ${3:имя}(${4}):",
      "    $0"
    ],
    "description": "Метод записи: функ (п *Запись) имя()"
  },
  "Главная": {
    "prefix": "главная",
    "body": [
      "функ главная() цел.верх:",
      "    $0",
      "    верни 0"
    ],
    "description": "Точка входа программы"
  },
  "Взять модули": {
    "prefix": "взять",
    "body": "взять ${1:основа}",
    "description": "Подключение модулей библиотеки"
  },
  "Взять модуль с путём": {
    "prefix": "взять путь",
    "body": "взять ${1|сист.файл,мат.цел,мат.нат,мат|}",
    "description": "Подключение модуля по точечному пути"
  },
  "Объявление": {
    "prefix": "объяв",
    "body": "${1:имя} ${2|цел.старт,цел.шаг,цел.рост,цел.верх,нат.старт,нат.шаг,нат.рост,нат.верх,лог,сим,стр|} = ${0:знач}",
    "description": "Объявление переменной: имя тип = значение"
  },
  "Объявление с выводом типа": {
    "prefix": "введи",
    "body": "введи ${1:имя} = ${0:выражение}",
    "description": "Объявление с выводом типа: введи имя = выражение"
  },
  "Если": {
    "prefix": "если",
    "body": [
      "если ${1:условие}:",
      "    $0"
    ],
    "description": "Условие"
  },
  "Если/иначе": {
    "prefix": "если-иначе",
    "body": [
      "если ${1:условие}:",
      "    $2",
      "иначе:",
      "    $0"
    ],
    "description": "Условие с веткой иначе"
  },
  "А если": {
    "prefix": "а если",
    "body": [
      "а если ${1:условие}:",
      "    $0"
    ],
    "description": "Ветка «а если»"
  },
  "Пока": {
    "prefix": "пока",
    "body": [
      "пока ${1:условие}:",
      "    $0"
    ],
    "description": "Цикл с условием"
  },
  "Вечно": {
    "prefix": "вечно",
    "body": [
      "вечно:",
      "    $0"
    ],
    "description": "Бесконечный цикл"
  },
  "Для": {
    "prefix": "для",
    "body": [
      "для ${1:i} в ${2:0}..${3:n}:",
      "    $0"
    ],
    "description": "Цикл по диапазону"
  },
  "Выбор": {
    "prefix": "выбор",
    "body": [
      "выбор ${1:выражение}:",
      "    ${2:значение}:",
      "        $0",
      "    иначе:",
      "        "
    ],
    "description": "Выбор по значению"
  },
  "Запись": {
    "prefix": "запись",
    "body": [
      "запись ${1:Имя}:",
      "    ${2:поле} ${3:цел.верх}",
      "    $0"
    ],
    "description": "Объявление записи"
  },
  "Переч": {
    "prefix": "переч",
    "body": [
      "переч ${1:Имя}:",
      "    ${2:ЧЛЕН} = ${3:0}",
      "    $0"
    ],
    "description": "Объявление перечисления"
  },
  "Константа": {
    "prefix": "конст",
    "body": "конст ${1:ИМЯ} = ${0:значение}",
    "description": "Константа"
  },
  "Внешняя функция": {
    "prefix": "внеш",
    "body": "внеш функ ${1:имя}(${2})${3: цел.верх}",
    "description": "Объявление внешней функции"
  },
  "Блок ИСКРЫ": {
    "prefix": "искра",
    "body": [
      "искра:",
      "    $0"
    ],
    "description": "Встроенный блок ИСКРЫ"
  },
  "Отложи": {
    "prefix": "отложи",
    "body": "отложи ${1:вызов}()",
    "description": "Отложенный вызов (defer)"
  }
}
