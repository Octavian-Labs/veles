{
  "name": "veles-languages",
  "displayName": "ВЕЛЕС — ИСКРА/РАЗУМ/ЯР",
  "description": "Подсветка синтаксиса и сниппеты для языков экосистемы ВЕЛЕС: ИСКРА (.иск, русский ассемблер x86-64), РАЗУМ (.раз, системный язык), ЯР (.яр, флагманский язык).",
  "version": "0.3.0",
  "publisher": "veles",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.60.0"
  },
  "activationEvents": [
    "onLanguage:razum",
    "onLanguage:iskra"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "veles",
    "iskra",
    "razum",
    "yar",
    "искра",
    "разум",
    "яр",
    "велес"
  ],
  "contributes": {
    "configuration": {
      "title": "ВЕЛЕС",
      "properties": {
        "veles.razumPath": {
          "type": "string",
          "default": "",
          "description": "Путь к компилятору разум (разум.exe). Пусто — ищется raz/разум в корне рабочей области, затем PATH."
        }
      }
    },
    "commands": [
      {
        "command": "veles.check",
        "title": "ВЕЛЕС: проверить файл разумом"
      }
    ],
    "languages": [
      {
        "id": "iskra",
        "aliases": [
          "ИСКРА",
          "iskra",
          "Iskra"
        ],
        "extensions": [
          ".иск"
        ],
        "configuration": "./language-configuration.iskra.json"
      },
      {
        "id": "razum",
        "aliases": [
          "РАЗУМ",
          "razum",
          "Razum"
        ],
        "extensions": [
          ".раз"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "yar",
        "aliases": [
          "ЯР",
          "yar",
          "Yar"
        ],
        "extensions": [
          ".яр"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "iskra",
        "scopeName": "source.iskra",
        "path": "./syntaxes/iskra.tmLanguage.json"
      },
      {
        "language": "razum",
        "scopeName": "source.razum",
        "path": "./syntaxes/razum.tmLanguage.json"
      },
      {
        "language": "yar",
        "scopeName": "source.yar",
        "path": "./syntaxes/yar.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "razum",
        "path": "./snippets/razum.json"
      },
      {
        "language": "iskra",
        "path": "./snippets/iskra.json"
      }
    ]
  }
}
