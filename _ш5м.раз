# ш5м — сеть на ~5 млн параметров: классификация процедурных фигур 64x64.
# 8 классов: круг, кольцо, квадрат, рамка, крест, диагонали,
# горизонтальные и вертикальные полосы — параметры и шум случайны.
# Сеть 4096 -> 1152 -> 288 -> 8 (~5.05M весов), сигмоида, MSE.
# Веса транспонированы блоками «век вещ.рост х 4» и живут в куче
# (~20МБ): fan-in по повтор(вход), дельты через сумма-доты.

взять основа

функ случ(з *нат.верх) нат.верх:
    з[0] = з[0] * 6364136223846793005 + 1442695040888963407
    верни з[0] >> 33

# равномерное [0,1)
функ случ01(з *нат.верх) вещ.рост:
    верни ((случ(з) как вещ.верх) / 2147483648.0) как вещ.рост

функ случ32(з *нат.верх, м вещ.рост) вещ.рост:
    верни (случ01(з) * 2.0 - 1.0) * м

функ эксп4(х век вещ.рост х 4) век вещ.рост х 4:
    у век вещ.рост х 4 = х * повтор((1.0 / 64.0) как вещ.рост)
    член век вещ.рост х 4 = у
    сум век вещ.рост х 4 = повтор(1.0 как вещ.рост) + у
    для к в 2..12:
        член = член * у * повтор(1.0 / (к как вещ.рост))
        сум += член
    для и в 0..6:
        сум = сум * сум
    верни сум

функ сигм4(х век вещ.рост х 4) век вещ.рост х 4:
    ед век вещ.рост х 4 = повтор(1.0 как вещ.рост)
    верни ед / (ед + эксп4(повтор(0.0 как вещ.рост) - х))

функ сигм32(х вещ.рост) вещ.рост:
    в век вещ.рост х 4 = сигм4(повтор(х))
    верни в[0]


# генерация фигуры класса кл в пиксели 64x64; случайные параметры + шум ~3%
функ ген_фигуру(кл цел.верх, з *нат.верх, пик *вещ.рост):
    сх вещ.рост = случ32(з, 0.25)
    су вещ.рост = случ32(з, 0.25)
    р вещ.рост = 0.45 + случ01(з) * 0.3
    т вещ.рост = 0.09 + случ01(з) * 0.1
    шаг цел.верх = 4 + (случ(з) % 6) как цел.верх
    для ряд в 0..64:
        у вещ.рост = ((ряд - 32) как вещ.рост) / 32.0
        для кол в 0..64:
            х вещ.рост = ((кол - 32) как вещ.рост) / 32.0
            дх вещ.рост = х - сх
            ду вещ.рост = у - су
            д2 вещ.рост = дх*дх + ду*ду
            бит вещ.рост = 0.0
            если кл == 0:
                если д2 < р*р: бит = 1.0
            а если кл == 1:
                р2 вещ.рост = (р + 0.12) * (р + 0.12)
                если д2 > р*р и д2 < р2: бит = 1.0
            а если кл == 2:
                если дх < р и дх > 0.0-р и ду < р и ду > 0.0-р: бит = 1.0
            а если кл == 3:
                ах вещ.рост = дх
                ау вещ.рост = ду
                если ах < 0.0: ах = 0.0 - ах
                если ау < 0.0: ау = 0.0 - ау
                мх вещ.рост = ах
                если ау > ах: мх = ау
                если мх > р и мх < р + 0.09: бит = 1.0
            а если кл == 4:
                если (дх > 0.0-т и дх < т) или (ду > 0.0-т и ду < т): бит = 1.0
            а если кл == 5:
                дг1 вещ.рост = х - у
                дг2 вещ.рост = х + у
                если дг1 < 0.0: дг1 = 0.0 - дг1
                если дг2 < 0.0: дг2 = 0.0 - дг2
                если дг1 < т или дг2 < т: бит = 1.0
            а если кл == 6:
                если (ряд / шаг) % 2 == 0: бит = 1.0
            иначе:
                если (кол / шаг) % 2 == 0: бит = 1.0
            если случ(з) < 60:
                бит = 1.0 - бит
            пик[ряд*64 + кол] = бит

функ слой1_прямой(вх *вещ.рост, база цел.верх,
                    веса *век вещ.рост х 4, смещения *век вещ.рост х 4,
                    выход *век вещ.рост х 4):
    для блок в 0..288:
        выход[блок] = смещения[блок]
    для вход_инд в 0..4096:
        вход вещ.рост = вх[база + вход_инд]
        если вход == 1.0:
            для блок в 0..288:
                выход[блок] += веса[вход_инд*288 + блок]
        а если вход != 0.0:
            вход4 век вещ.рост х 4 = повтор(вход)
            для блок в 0..288:
                выход[блок] += веса[вход_инд*288 + блок] * вход4

функ слой1_обнови(вх *вещ.рост, база цел.верх,
                   веса *век вещ.рост х 4, дельта *век вещ.рост х 4,
                   скорость вещ.рост):
    скор4 век вещ.рост х 4 = повтор(скорость)
    для вход_инд в 0..4096:
        вход вещ.рост = вх[база + вход_инд]
        если вход == 1.0:
            для блок в 0..288:
                веса[вход_инд*288 + блок] -= скор4 * дельта[блок]
        а если вход != 0.0:
            шаг4 век вещ.рост х 4 = повтор(скорость * вход)
            для блок в 0..288:
                веса[вход_инд*288 + блок] -= шаг4 * дельта[блок]

# прямой проход: argmax выхода, оценку — в оц
функ прогноз(вх *вещ.рост,
             w1т *век вещ.рост х 4, б1 *век вещ.рост х 4,
             w2т *век вещ.рост х 4, б2 *век вещ.рост х 4,
             w3т *век вещ.рост х 4, б3 *век вещ.рост х 4,
             оц *вещ.рост) цел.верх:
    ш1 век вещ.рост х 4[288]
    ш2 век вещ.рост х 4[72]
    ш1п вещ.рост[1152]
    ш2п вещ.рост[288]
    слой1_прямой(вх, 0, w1т, б1, &ш1[0])
    для б в 0..288:
        ш1[б] = сигм4(ш1[б])
        для л в 0..4:
            ш1п[б*4 + л] = ш1[б][л]
    для б в 0..72:
        ш2[б] = б2[б]
    для и в 0..1152:
        вход4 век вещ.рост х 4 = повтор(ш1п[и])
        для б в 0..72:
            ш2[б] += w2т[и*72 + б] * вход4
    для б в 0..72:
        ш2[б] = сигм4(ш2[б])
        для л в 0..4:
            ш2п[б*4 + л] = ш2[б][л]
    луч цел.верх = 0
    лучз вещ.рост = -1.0
    для б в 0..2:
        а век вещ.рост х 4 = б3[б]
        для и в 0..288:
            а += w3т[и*2 + б] * повтор(ш2п[и])
        в век вещ.рост х 4 = сигм4(а)
        для л в 0..4:
            если в[л] > лучз:
                лучз = в[л]
                луч = б*4 + л
    оц[0] = лучз
    верни луч

открыто функ главная() цел.верх:
    зерно нат.верх = 987654321

    # датасет: 8 классов x 60 фигур = 480 примеров, куча
    вхм *вещ.рост = выдели(480 * 4096 * 4) как *вещ.рост
    цель *вещ.рост = выдели(480 * 8 * 4) как *вещ.рост
    пик *вещ.рост = выдели(4096 * 4) как *вещ.рост
    для с в 0..480:
        кл цел.верх = с % 8
        ген_фигуру(кл, &зерно, пик)
        для и в 0..4096:
            вхм[с*4096 + и] = пик[и]
        для ж в 0..8:
            цель[с*8 + ж] = 0.0
        цель[с*8 + кл] = 1.0

    # веса транспонированно блоками по 4 нейрона, в куче (~20МБ)
    w1т *век вещ.рост х 4 = выдели(1179648 * 16) как *век вещ.рост х 4
    б1 *век вещ.рост х 4 = выдели(288 * 16) как *век вещ.рост х 4
    w2т *век вещ.рост х 4 = выдели(82944 * 16) как *век вещ.рост х 4
    б2 *век вещ.рост х 4 = выдели(72 * 16) как *век вещ.рост х 4
    w3т *век вещ.рост х 4 = выдели(576 * 16) как *век вещ.рост х 4
    б3 *век вещ.рост х 4 = выдели(2 * 16) как *век вещ.рост х 4
    для и в 0..1179648:
        w1т[и] = век вещ.рост х 4{случ32(&зерно, 0.03), случ32(&зерно, 0.03), случ32(&зерно, 0.03), случ32(&зерно, 0.03)}
    для и в 0..82944:
        w2т[и] = век вещ.рост х 4{случ32(&зерно, 0.1), случ32(&зерно, 0.1), случ32(&зерно, 0.1), случ32(&зерно, 0.1)}
    для и в 0..576:
        w3т[и] = век вещ.рост х 4{случ32(&зерно, 0.15), случ32(&зерно, 0.15), случ32(&зерно, 0.15), случ32(&зерно, 0.15)}
    для б в 0..288:
        б1[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}
    для б в 0..72:
        б2[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}
    для б в 0..2:
        б3[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}

    ш1 век вещ.рост х 4[288]
    ш2 век вещ.рост х 4[72]
    вых век вещ.рост х 4[2]
    д2в век вещ.рост х 4[72]
    д1в век вещ.рост х 4[288]
    д3в век вещ.рост х 4[2]
    цв век вещ.рост х 4[2]
    ш1п вещ.рост[1152]
    ш2п вещ.рост[288]
    д1 вещ.рост[1152]
    д2 вещ.рост[288]
    ед4 век вещ.рост х 4 = повтор(1.0 как вещ.рост)

    скор вещ.рост = 0.4
    эпох цел.верх = 6
    оц вещ.рост = 0.0

    для эп в 0..эпох:
        верно цел.верх = 0
        для с в 0..480:
            бс цел.верх = с * 4096
            кл = с % 8
            для б в 0..2:
                цв[б] = век вещ.рост х 4{цель[с*8 + б*4], цель[с*8 + б*4 + 1],
                    цель[с*8 + б*4 + 2], цель[с*8 + б*4 + 3]}

            # прямой проход
            слой1_прямой(вхм, бс, w1т, б1, &ш1[0])
            для б в 0..288:
                ш1[б] = сигм4(ш1[б])
                для л в 0..4:
                    ш1п[б*4 + л] = ш1[б][л]
            для б в 0..72:
                ш2[б] = б2[б]
            для и в 0..1152:
                вход4 век вещ.рост х 4 = повтор(ш1п[и])
                для б в 0..72:
                    ш2[б] += w2т[и*72 + б] * вход4
            для б в 0..72:
                ш2[б] = сигм4(ш2[б])
                для л в 0..4:
                    ш2п[б*4 + л] = ш2[б][л]
            луч цел.верх = 0
            лучз вещ.рост = -1.0
            для б в 0..2:
                а век вещ.рост х 4 = б3[б]
                для и в 0..288:
                    а += w3т[и*2 + б] * повтор(ш2п[и])
                вых[б] = сигм4(а)
                для л в 0..4:
                    если вых[б][л] > лучз:
                        лучз = вых[б][л]
                        луч = б*4 + л
            если луч == кл:
                верно += 1

            # дельты
            для б в 0..2:
                д3в[б] = (вых[б] - цв[б]) * вых[б] * (ед4 - вых[б])
            для и в 0..288:
                сум вещ.рост = сумма(w3т[и*2]*д3в[0] + w3т[и*2+1]*д3в[1])
                д2[и] = сум * ш2п[и] * (1.0 - ш2п[и])
            для б в 0..72:
                д2в[б] = век вещ.рост х 4{д2[б*4], д2[б*4+1], д2[б*4+2], д2[б*4+3]}
            для и в 0..1152:
                сум = 0.0
                для б в 0..72:
                    сум += сумма(w2т[и*72 + б] * д2в[б])
                д1[и] = сум * ш1п[и] * (1.0 - ш1п[и])
            для б в 0..288:
                д1в[б] = век вещ.рост х 4{д1[б*4], д1[б*4+1], д1[б*4+2], д1[б*4+3]}

            # обновления
            скв век вещ.рост х 4 = повтор(скор)
            для и в 0..288:
                ши век вещ.рост х 4 = повтор(скор * ш2п[и])
                для б в 0..2:
                    w3т[и*2 + б] -= ши * д3в[б]
            для б в 0..2:
                б3[б] -= скв * д3в[б]
            для и в 0..1152:
                ши = повтор(скор * ш1п[и])
                для б в 0..72:
                    w2т[и*72 + б] -= ши * д2в[б]
            для б в 0..72:
                б2[б] -= скв * д2в[б]
            слой1_обнови(вхм, бс, w1т, &д1в[0], скор)
            для б в 0..288:
                б1[б] -= скв * д1в[б]
        печать("эпоха ")
        печать(цел_в_стр(эп))
        печать(": точность ")
        печать(цел_в_стр(верно))
        печатьстр(" / 480")

    # свежие фигуры: 800 новых примеров
    свеж цел.верх = 0
    для с в 0..800:
        кл = с % 8
        ген_фигуру(кл, &зерно, пик)
        пр цел.верх = прогноз(пик, &w1т[0], &б1[0], &w2т[0], &б2[0], &w3т[0], &б3[0], &оц)
        если пр == кл:
            свеж += 1
    печать("точность на свежих: ")
    печать(цел_в_стр(свеж))
    печатьстр(" / 800")

    # по одному чистому образцу на класс
    для д в 0..8:
        ген_фигуру(д, &зерно, пик)
        буф *Буфер = буф_новый()
        для ряд в 0..64:
            если ряд % 2 == 0:
                для кол в 0..64:
                    если пик[ряд*64 + кол] > 0.5:
                        буф_сим(буф, '#')
                    иначе:
                        буф_сим(буф, '.')
                буф_сим(буф, 10)
        пр = прогноз(пик, &w1т[0], &б1[0], &w2т[0], &б2[0], &w3т[0], &б3[0], &оц)
        печать(буф_стр(буф))
        буф_свободен(буф)
        печать("класс ")
        печать(цел_в_стр(д))
        печать(" -> ")
        печать(цел_в_стр(пр))
        печать(", уверенность ")
        печатьстр(цел_в_стр((оц * 100.0) как цел.верх))
        печатьстр("%")

    верни 0
