# система — завершение процесса и доступ к ОС (Linux).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять файл, буфер

функ выход(код цел64):
    искра:
        ПЕР ПРМ, код        ; код выхода
        ПЕР АКК, 60         ; sys_exit
        СИСВЫЗОВ

# Командная строка процесса (аргументы разделены NUL).
# /proc — виртуальная ФС: lseek/размер не работают, читаем до EOF.
# Возвращает пусто при ошибке открытия.
функ аргументы() стр:
    п *без8 = стр_в_нуль("/proc/self/cmdline")
    фд цел64 = 0
    искра:
        ПЕР ПРМ, п          ; путь ASCIIZ
        ПЕР ИСТ, 0          ; O_RDONLY
        ПЕР ДАН, 0
        ПЕР АКК, 2          ; sys_open
        СИСВЫЗОВ
        ПЕР фд, АКК
    если фд < 0:
        верни пусто как стр
    б *Буфер = буф_новый()
    кусок *без8 = выдели(4096)
    прочитано цел64 = 1
    пока прочитано > 0:
        искра:
            ПЕР ПРМ, фд
            ПЕР ИСТ, кусок
            ПЕР ДАН, 4096
            ПЕР АКК, 0      ; sys_read
            СИСВЫЗОВ
            ПЕР прочитано, АКК
        если прочитано > 0:
            буф_место(б, прочитано как без64)
            скопируй(б.данные + б.длина, кусок, прочитано как без64)
            б.длина += прочитано как без64
    освободи(кусок)
    искра:
        ПЕР ПРМ, фд
        ПЕР АКК, 3          ; sys_close
        СИСВЫЗОВ
    верни буф_стр(б)
