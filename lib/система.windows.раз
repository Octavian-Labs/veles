# система — завершение процесса и доступ к ОС (Windows).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять стр

внеш "kernel32" функ ExitProcess(код без32)
внеш "kernel32" функ GetCommandLineW() *без16
внеш "kernel32" функ WideCharToMultiByte(кодст без32, флаги без32,
    шир *без16, шир_дл цел32, узк *без8, узк_дл цел32,
    умолч *без8, исп *без32) цел32

функ выход(код цел64):
    ExitProcess(код как без32)

# Командная строка процесса целиком в UTF-8.
функ аргументы() стр:
    шир := GetCommandLineW()
    длин := WideCharToMultiByte(65001, 0, шир, -1, пусто, 0, пусто, пусто)
    буф := выдели(длин как без64) как *без8
    WideCharToMultiByte(65001, 0, шир, -1, буф, длин, пусто, пусто)
    верни стр_собери(буф, (длин - 1) как без64)
