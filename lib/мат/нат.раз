# мат.нат — натуральная математика (беззнаковые).
# Обращения: мат.нат.нод(а, б) или нат.нод(а, б) после «взять мат.нат».

взять основа

функ нат_минимум(а нат.верх, б нат.верх) нат.верх:
    если а < б:
        верни а
    верни б

функ нат_максимум(а нат.верх, б нат.верх) нат.верх:
    если а > б:
        верни а
    верни б

функ нат_ограничь(ч нат.верх, низ нат.верх, верх нат.верх) нат.верх:
    если ч < низ:
        верни низ
    если ч > верх:
        верни верх
    верни ч

функ нат_степень(осн нат.верх, пок нат.верх) нат.верх:
    р нат.верх = 1
    пока пок > 0:
        р = р * осн
        пок = пок - 1
    верни р

функ нат_нод(а нат.верх, б нат.верх) нат.верх:
    пока б != 0:
        т нат.верх = б
        б = а % б
        а = т
    верни а

функ нат_нок(а нат.верх, б нат.верх) нат.верх:
    если а == 0 или б == 0:
        верни 0
    верни а / нат_нод(а, б) * б

функ нат_это_степень_двойки(ч нат.верх) лог:
    верни ч > 0 и (ч & (ч - 1)) == 0

функ нат_корень(ч нат.верх) нат.верх:
    # целочисленный квадратный корень (метод Ньютона)
    если ч == 0:
        верни 0
    х нат.верх = ч
    у нат.верх = (х + 1) / 2
    пока у < х:
        х = у
        у = (х + ч / х) / 2
    верни х
