# мат.цел — целочисленная математика (знаковые).
# Обращения: мат.цел.нод(а, б) или цел.нод(а, б) после «взять мат.цел».

взять основа

функ цел_модуль(ч цел.верх) цел.верх:
    если ч < 0:
        верни -ч
    верни ч

функ цел_минимум(а цел.верх, б цел.верх) цел.верх:
    если а < б:
        верни а
    верни б

функ цел_максимум(а цел.верх, б цел.верх) цел.верх:
    если а > б:
        верни а
    верни б

функ цел_ограничь(ч цел.верх, низ цел.верх, верх цел.верх) цел.верх:
    если ч < низ:
        верни низ
    если ч > верх:
        верни верх
    верни ч

функ цел_знак(ч цел.верх) цел.верх:
    если ч < 0:
        верни -1
    если ч > 0:
        верни 1
    верни 0

функ цел_степень(осн цел.верх, пок цел.верх) цел.верх:
    р цел.верх = 1
    пока пок > 0:
        р = р * осн
        пок = пок - 1
    верни р

функ цел_нод(а цел.верх, б цел.верх) цел.верх:
    а = цел_модуль(а)
    б = цел_модуль(б)
    пока б != 0:
        т цел.верх = б
        б = а % б
        а = т
    верни а

функ цел_нок(а цел.верх, б цел.верх) цел.верх:
    если а == 0 или б == 0:
        верни 0
    верни цел_модуль(а / цел_нод(а, б) * б)

функ цел_делится(ч цел.верх, дел цел.верх) лог:
    если дел == 0:
        верни нет
    верни ч % дел == 0

функ цел_это_степень_двойки(ч цел.верх) лог:
    верни ч > 0 и (ч & (ч - 1)) == 0

функ цел_это_простое(ч цел.верх) лог:
    если ч < 2:
        верни нет
    если ч == 2:
        верни да
    если ч % 2 == 0:
        верни нет
    д цел.верх = 3
    пока д * д <= ч:
        если ч % д == 0:
            верни нет
        д = д + 2
    верни да

функ цел_следующее_простое(ч цел.верх) цел.верх:
    если ч < 2:
        верни 2
    к цел.верх = ч + 1
    пока не цел_это_простое(к):
        к += 1
    верни к

функ цел_корень(ч цел.верх) цел.верх:
    # целочисленный квадратный корень (метод Ньютона)
    если ч <= 0:
        верни 0
    х цел.верх = ч
    у цел.верх = (х + 1) / 2
    пока у < х:
        х = у
        у = (х + ч / х) / 2
    верни х
