# консоль — вывод в stdout (Windows: WinAPI WriteFile).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять стр, память, буфер

внеш "kernel32" функ GetStdHandle(деск без32) без64
внеш "kernel32" функ WriteFile(хендл без64, буф *без8,
                               колво без32, записано *без32,
                               овер *пусто) цел32

функ печать(с стр):
    записано без32 = 0
    х := GetStdHandle(0xFFFFFFF5)   # STD_OUTPUT_HANDLE
    WriteFile(х, с.данные, с.длина как без32, &записано, пусто)

функ печатьстр(с стр):
    печать(с)
    печать("\r\n")

функ печатьцел(ч цел64):
    печать(цел_в_стр(ч))

внеш "kernel32" функ ReadFile(хендл без64, буф *без8, колво без32,
                              прочитано *без32, овер *пусто) цел32

функ ввод() стр:
    # читает весь stdin до EOF порциями по 64 КиБ
    х := GetStdHandle(0xFFFFFFF6)   # STD_INPUT_HANDLE
    б *Буфер = буф_новый()
    кусок *без8 = выдели(65536)
    прочитано без32 = 0
    пока да:
        ок := ReadFile(х, кусок, 65536, &прочитано, пусто)
        если ок == 0 или прочитано == 0:
            хватит
        буф_место(б, прочитано как без64)
        скопируй(б.данные + б.длина, кусок, прочитано как без64)
        б.длина += прочитано как без64
    освободи(кусок)
    верни буф_стр(б)
