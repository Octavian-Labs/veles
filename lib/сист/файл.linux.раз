# файл — чтение и запись файлов (Linux: syscalls через искра:).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.
# файл_прочти возвращает пусто при ошибке — проверяйте «если с == пусто».

взять стр

функ файл_прочти(путь стр) стр:
    п *нат.старт = стр_в_нуль(путь)
    фд цел.верх = 0
    искра:
        ПЕР ПРМ, п          ; путь ASCIIZ
        ПЕР ИСТ, 0          ; O_RDONLY
        ПЕР ДАН, 0
        ПЕР АКК, 2          ; sys_open
        СИСВЫЗОВ
        ПЕР фд, АКК
    если фд < 0:
        верни пусто как стр
    разм цел.верх = 0
    искра:
        ПЕР ПРМ, фд
        ПЕР ИСТ, 0
        ПЕР ДАН, 2          ; SEEK_END
        ПЕР АКК, 8          ; sys_lseek
        СИСВЫЗОВ
        ПЕР разм, АКК
    если разм <= 0:
        искра:
            ПЕР ПРМ, фд
            ПЕР АКК, 3      ; sys_close
            СИСВЫЗОВ
        верни пусто как стр
    буф *нат.старт = выдели(разм + 1)
    искра:
        ПЕР ПРМ, фд         ; перемотка в начало
        ПЕР ИСТ, 0
        ПЕР ДАН, 0          ; SEEK_SET
        ПЕР АКК, 8
        СИСВЫЗОВ
        ПЕР ПРМ, фд
        ПЕР ИСТ, буф
        ПЕР ДАН, разм
        ПЕР АКК, 0          ; sys_read
        СИСВЫЗОВ
        ПЕР ПРМ, фд
        ПЕР АКК, 3          ; sys_close
        СИСВЫЗОВ
    буф[разм] = 0
    верни стр_собери(буф, разм как нат.верх)

функ файл_запиши(путь стр, данные стр) лог:
    п *нат.старт = стр_в_нуль(путь)
    фд цел.верх = 0
    искра:
        ПЕР ПРМ, п
        ПЕР ИСТ, 577        ; O_WRONLY|O_CREAT|O_TRUNC
        ПЕР ДАН, 420        ; 0644
        ПЕР АКК, 2          ; sys_open
        СИСВЫЗОВ
        ПЕР фд, АКК
    если фд < 0:
        верни нет
    записано цел.верх = 0
    искра:
        ПЕР ПРМ, фд
        ПЕР ИСТ, данные     ; стр — указатель на пару
        ПЕР ИСТ, [ИСТ]      ; .данные
        ПЕР ДАН, данные
        ПЕР ДАН, [ДАН+8]    ; .длина
        ПЕР АКК, 1          ; sys_write
        СИСВЫЗОВ
        ПЕР записано, АКК
        ПЕР ПРМ, фд
        ПЕР АКК, 3          ; sys_close
        СИСВЫЗОВ
    верни записано == (данные.длина как цел.верх)
