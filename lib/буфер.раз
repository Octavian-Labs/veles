# буфер — наращиваемый строковый буфер (строитель текстов, генератор .иск).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять память, стр

запись Буфер:
    данные *без8
    длина без64
    вмест без64

функ буф_новый() *Буфер:
    б *Буфер = новый(Буфер)
    б.данные = выдели(256)
    б.длина = 0
    б.вмест = 256
    верни б

функ буф_место(б *Буфер, надо без64):
    # гарантирует «надо» свободных байт, удваивая ёмкость
    если б.длина + надо <= б.вмест:
        верни
    нв := б.вмест * 2
    пока б.длина + надо > нв:
        нв = нв * 2
    новые *без8 = выдели(нв)
    скопируй(новые, б.данные, б.длина)
    освободи(б.данные)
    б.данные = новые
    б.вмест = нв

функ буф_сим(б *Буфер, с без8):
    буф_место(б, 1)
    б.данные[б.длина] = с
    б.длина += 1

функ буф_добавь(б *Буфер, с стр):
    буф_место(б, с.длина)
    скопируй(б.данные + б.длина, с.данные, с.длина)
    б.длина += с.длина

функ буф_стр(б *Буфер) стр:
    # отдаёт накопленное как стр (без копии — данные переходят строке)
    верни стр_собери(б.данные, б.длина)

функ буф_свободен(б *Буфер):
    освободи(б.данные)
    освободи(б)
