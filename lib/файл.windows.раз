# файл — чтение и запись файлов (Windows: WinAPI).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.
# файл_прочти возвращает пусто при ошибке — проверяйте «если с == пусто».

взять стр

внеш "kernel32" функ CreateFileA(имя *без8, доступ без32,
                                 раздел без32, сек *пусто,
                                 режим без32, флаги без32,
                                 шаблон без64) без64
внеш "kernel32" функ GetFileSize(хендл без64, старш *без32) без32
внеш "kernel32" функ ReadFile(хендл без64, буф *без8, колво без32,
                              прочитано *без32, овер *пусто) цел32
внеш "kernel32" функ WriteFile(хендл без64, буф *без8, колво без32,
                               записано *без32, овер *пусто) цел32
внеш "kernel32" функ CloseHandle(хендл без64) цел32

конст ЧИТАТЬ = 0x80000000      # GENERIC_READ
конст ПИСАТЬ = 0x40000000      # GENERIC_WRITE
конст ОТКРЫТЬ = 3              # OPEN_EXISTING
конст СОЗДАТЬ = 2              # CREATE_ALWAYS
конст НЕВЕРНЫЙ = 0xFFFFFFFFFFFFFFFF  # INVALID_HANDLE_VALUE

функ файл_прочти(путь стр) стр:
    п *без8 = стр_в_нуль(путь)
    х := CreateFileA(п, ЧИТАТЬ, 1, пусто, ОТКРЫТЬ, 0x80, пусто)
    если х == НЕВЕРНЫЙ:
        верни пусто как стр
    разм := GetFileSize(х, пусто)
    буф *без8 = выдели((разм как без64) + 1)
    прочитано без32 = 0
    ReadFile(х, буф, разм, &прочитано, пусто)
    CloseHandle(х)
    буф[разм] = 0
    верни стр_собери(буф, прочитано как без64)

функ файл_запиши(путь стр, данные стр) бул:
    п *без8 = стр_в_нуль(путь)
    х := CreateFileA(п, ПИСАТЬ, 0, пусто, СОЗДАТЬ, 0x80, пусто)
    если х == НЕВЕРНЫЙ:
        верни нет
    записано без32 = 0
    WriteFile(х, данные.данные, данные.длина как без32, &записано, пусто)
    CloseHandle(х)
    верни записано == (данные.длина как без32)
