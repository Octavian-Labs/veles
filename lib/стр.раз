# стр — операции со строками: {данные *без8, длина без64}.
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять память

# Служебная запись с разметкой, совпадающей с представлением стр.
запись _стрпара:
    данные *без8
    длина без64

функ стр_собери(д *без8, дл без64) стр:
    п *_стрпара = новый(_стрпара)
    п.данные = д
    п.длина = дл
    верни п как стр

функ стр_равны(а стр, б стр) бул:
    если а.длина != б.длина:
        верни нет
    верни равна_память(а.данные, б.данные, а.длина)

функ стр_начинается(с стр, преф стр) бул:
    # истина, если строка начинается с префикса (сравнение по байтам UTF-8)
    если с.длина < преф.длина:
        верни нет
    верни равна_память(с.данные, преф.данные, преф.длина)

функ _ниж1(б без8) без8:
    # одиночный ASCII-байт в нижний регистр
    если б >= 'A' и б <= 'Z':
        верни б + 32
    верни б

функ _ниж2(б1 без8, б2 без8, д *без8):
    # двухбайтовая кириллица UTF-8 в нижний регистр
    если б1 == 0xD0 и б2 == 0x81:
        д[0] = 0xD1
        д[1] = 0x91
        верни
    если б1 == 0xD0 и б2 >= 0x90 и б2 <= 0x9F:
        д[0] = б1
        д[1] = б2 + 0x20
        верни
    если б1 == 0xD0 и б2 >= 0xA0 и б2 <= 0xAF:
        д[0] = 0xD1
        д[1] = б2 - 0x20
        верни
    д[0] = б1
    д[1] = б2

функ стр_равны_нр(а стр, б стр) бул:
    # регистронезависимое сравнение (ASCII + кириллица UTF-8)
    если а.длина != б.длина:
        верни нет
    tmp *без8 = выдели(2)
    i := 0 как без64
    пока i < а.длина:
        б1 := а.данные[i]
        б2 := б.данные[i]
        если б1 >= 0x80 и б2 >= 0x80 и i + 1 < а.длина:
            _ниж2(б1, а.данные[i + 1], tmp)
            в1 := tmp[0]
            в1б := tmp[1]
            _ниж2(б2, б.данные[i + 1], tmp)
            если в1 != tmp[0] или в1б != tmp[1]:
                освободи(tmp)
                верни нет
            i += 2
        иначе:
            если _ниж1(б1) != _ниж1(б2):
                освободи(tmp)
                верни нет
            i += 1
    освободи(tmp)
    верни да

функ стр_вниз(с стр) стр:
    # нижний регистр: ASCII A-Z и кириллица А-Я/Ё (UTF-8, 2 байта)
    д *без8 = выдели(с.длина)
    i := 0 как без64
    пока i < с.длина:
        б := с.данные[i]
        если б >= 'A' и б <= 'Z':
            д[i] = б + 32
            i += 1
        а если б == 0xD0 и i + 1 < с.длина:
            б2 := с.данные[i + 1]
            если б2 == 0x81:
                # Ё -> ё
                д[i] = 0xD1
                д[i + 1] = 0x91
            а если б2 >= 0x90 и б2 <= 0x9F:
                # А-П -> а-п
                д[i] = б
                д[i + 1] = б2 + 0x20
            а если б2 >= 0xA0 и б2 <= 0xAF:
                # Р-Я -> р-я
                д[i] = 0xD1
                д[i + 1] = б2 - 0x20
            иначе:
                д[i] = б
                д[i + 1] = б2
            i += 2
        иначе:
            д[i] = б
            i += 1
    верни стр_собери(д, с.длина)

функ стр_срез(с стр, с_ч без64, по без64) стр:
    # полуоткрытый диапазон [с_ч, по); данные разделяются с исходной строкой
    верни стр_собери(с.данные + с_ч, по - с_ч)

функ стр_склей(а стр, б стр) стр:
    буф *без8 = выдели(а.длина + б.длина)
    скопируй(буф, а.данные, а.длина)
    скопируй(буф + а.длина, б.данные, б.длина)
    верни стр_собери(буф, а.длина + б.длина)

функ цел_в_стр(ч цел64) стр:
    # десятичное представление; буфер 24 байта хватает на цел64 со знаком
    буф *без8 = выдели(24)
    i цел64 = 24
    минус бул = нет
    если ч < 0:
        минус = да
        ч = -ч
    если ч == 0:
        i = i - 1
        буф[i] = 48
    пока ч > 0:
        i = i - 1
        буф[i] = (48 + ч % 10) как без8
        ч = ч / 10
    если минус:
        i = i - 1
        буф[i] = 45
    верни стр_собери(буф + i, (24 - i) как без64)

функ без_в_стр(ч без64) стр:
    # десятичное представление беззнакового без64 (до 20 цифр)
    буф *без8 = выдели(24)
    i цел64 = 24
    если ч == 0:
        i = i - 1
        буф[i] = 48
    пока ч > 0:
        i = i - 1
        буф[i] = (48 + ч % 10) как без8
        ч = ч / 10
    верни стр_собери(буф + i, (24 - i) как без64)

функ утф8_код(д *без8, дл без64) цел64:
    # декодирует один кодпоинт UTF-8 (1..4 байта); -1 при неверной форме
    если дл == 0 или дл > 4:
        верни -1
    б0 := д[0] как без64
    если дл == 1:
        если б0 >= 0x80:
            верни -1
        верни б0 как цел64
    если дл == 2:
        если б0 < 0xC0 или б0 >= 0xE0:
            верни -1
        верни (((б0 & 0x1F) << 6) | ((д[1] как без64) & 0x3F)) как цел64
    если дл == 3:
        если б0 < 0xE0 или б0 >= 0xF0:
            верни -1
        верни (((б0 & 0x0F) << 12) | (((д[1] как без64) & 0x3F) << 6) |
               ((д[2] как без64) & 0x3F)) как цел64
    если б0 < 0xF0:
        верни -1
    верни (((б0 & 0x07) << 18) | (((д[1] как без64) & 0x3F) << 12) |
           (((д[2] как без64) & 0x3F) << 6) | ((д[3] как без64) & 0x3F)) как цел64

функ стр_в_нуль(с стр) *без8:
    # копия строки с завершающим нулём — для вызовов WinAPI (ASCIIZ)
    буф *без8 = выдели(с.длина + 1)
    скопируй(буф, с.данные, с.длина)
    буф[с.длина] = 0
    верни буф

функ стр_найди(с стр, под стр) цел64:
    # индекс первого вхождения или -1
    если под.длина == 0:
        верни 0
    если под.длина > с.длина:
        верни -1
    i без64 = 0
    пока i <= с.длина - под.длина:
        если равна_память(с.данные + i, под.данные, под.длина):
            верни i как цел64
        i += 1
    верни -1

функ стр_число(с стр) цел64:
    # разбор десятичного числа (atoi)
    i без64 = 0
    минус бул = нет
    если с.длина > 0 и с.данные[0] == 45:
        минус = да
        i = 1
    ч цел64 = 0
    пока i < с.длина:
        б := с.данные[i]
        если б < 48 или б > 57:
            хватит
        ч = ч * 10 + (б - 48)
        i += 1
    если минус:
        верни -ч
    верни ч

# --- предикаты символов (байты; UTF-8 ведущие байты >= 128) -------------------

функ это_цифра(б без8) бул:
    верни б >= 48 и б <= 57

функ это_пробел(б без8) бул:
    верни б == 32 или б == 9 или б == 10 или б == 13

функ это_буква(б без8) бул:
    # латиница + любой байт >= 128 (кириллица в UTF-8)
    верни (б >= 65 и б <= 90) или (б >= 97 и б <= 122) или б >= 128

