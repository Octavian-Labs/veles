# список — динамический массив 64-битных значений (указателей и чисел).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.
# Хранит без64; указатели приводятся через «как без64» / «как *Т».

взять память

запись Список:
    данные *без64
    длина без64
    вмест без64          ; вместимость в элементах

функ список_новый() *Список:
    с *Список = новый(Список)
    с.данные = выдели(8 * 8) как *без64
    с.длина = 0
    с.вмест = 8
    верни с

функ список_добавь(с *Список, э без64):
    если с.длина == с.вмест:
        новая *без64 = выдели(с.вмест * 16) как *без64
        скопируй(новая как *без8, с.данные как *без8, с.вмест * 8)
        освободи(с.данные)
        с.данные = новая
        с.вмест = с.вмест * 2
    с.данные[с.длина] = э
    с.длина += 1

функ список_получи(с *Список, i без64) без64:
    верни с.данные[i]

функ список_свободен(с *Список):
    освободи(с.данные)
    освободи(с)
