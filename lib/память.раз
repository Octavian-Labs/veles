# память — примитивы работы с сырой памятью.
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

функ заполни(указ *без8, б без8, n без64):
    i без64 = 0
    пока i < n:
        указ[i] = б
        i += 1

функ скопируй(куда *без8, откуда *без8, n без64):
    i без64 = 0
    пока i < n:
        куда[i] = откуда[i]
        i += 1

функ равна_память(а *без8, б *без8, n без64) бул:
    i без64 = 0
    пока i < n:
        если а[i] != б[i]:
            верни нет
        i += 1
    верни да
