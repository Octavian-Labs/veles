функ хост_линукс() бул:
    верни нет

функ исполняемый(путь стр):
    # на Windows exe запускается без дополнительных прав
    верни

# --- файлы и процессы ---------------------------------------------------------

функ файл_удали(путь стр) бул:
    верни DeleteFileW(стр_в_шир(путь)) != 0

# наследуемый дочерним процессом файловый хендл
функ _наслед_файл(путь стр, доступ без32, режим без32) без64:
    са *без64 = выдели(24) как *без64
    са[0] = 24                  # SECURITY_ATTRIBUTES.nLength
    са[1] = 0                   # lpSecurityDescriptor
    са32 *без32 = са как *без32
    са32[4] = 1                 # bInheritHandle
    верни CreateFileW(стр_в_шир(путь), доступ, 3, са как *пусто,
                      режим, 0x80, пусто)

# запускает «прог арг» со stdin=вход, stdout+stderr=вых (пути к файлам);
# ждёт завершения, возвращает код выхода или -1 при ошибке запуска
функ запусти(прог стр, арг стр, вход стр, вых стр) цел64:
    вх := _наслед_файл(вход, ЧИТАТЬ, ОТКРЫТЬ)
    выхф := _наслед_файл(вых, ПИСАТЬ, СОЗДАТЬ)
    если вх == НЕВЕРНЫЙ или выхф == НЕВЕРНЫЙ:
        верни -1
    си *без8 = выдели(104)      # STARTUPINFOW
    заполни(си, 0, 104)
    си32 *без32 = си как *без32
    си32[0] = 104               # cb
    си32[15] = СТД_ФЛАГ         # dwFlags @60
    си64 *без64 = си как *без64
    си64[10] = вх               # hStdInput @80
    си64[11] = выхф             # hStdOutput @88
    си64[12] = выхф             # hStdError @96
    пи *без8 = выдели(24)       # PROCESS_INFORMATION
    заполни(пи, 0, 24)
    кстр := стр_в_шир(стр_склей("\"",
        стр_склей(прог, стр_склей("\" ", арг))))
    ок := CreateProcessW(пусто, кстр, пусто, пусто, 1, 0,
                         пусто, пусто, си, пи)
    если ок == 0:
        CloseHandle(вх)
        CloseHandle(выхф)
        верни -1
    пи64 *без64 = пи как *без64
    WaitForSingleObject(пи64[0], ЖДИ_ВЕЧНО)
    код без32 = 0
    GetExitCodeProcess(пи64[0], &код)
    CloseHandle(пи64[0])
    CloseHandle(пи64[1])
    CloseHandle(вх)
    CloseHandle(выхф)
    верни код как цел64
