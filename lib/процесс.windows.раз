# процесс — запуск дочерних процессов с перенаправлением потоков (Windows).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.
# запусти ждёт завершения и возвращает код выхода (-1 — не запустился).

взять стр, память, файл

внеш "kernel32" функ CreateProcessW(прил *без16, кстр *без16,
    па *пусто, та *пусто, наслед цел32, флаги без32,
    среда *пусто, кат *без16, си *без8, пи *без8) цел32
внеш "kernel32" функ WaitForSingleObject(хендл без64, мс без32) без32
внеш "kernel32" функ GetExitCodeProcess(проц без64, код *без32) цел32
внеш "kernel32" функ DeleteFileW(имя *без16) цел32
внеш "kernel32" функ CloseHandle(хендл без64) цел32

конст ЖДИ_ВЕЧНО = 0xFFFFFFFF    # INFINITE
конст СТД_ФЛАГ = 0x100          # STARTF_USESTDHANDLES
конст ЧИТАТЬ = 0x80000000       # GENERIC_READ
конст ПИСАТЬ = 0x40000000       # GENERIC_WRITE
конст ОТКРЫТЬ = 3               # OPEN_EXISTING
конст СОЗДАТЬ = 2               # CREATE_ALWAYS
конст НЕВЕРНЫЙ = 0xFFFFFFFFFFFFFFFF  # INVALID_HANDLE_VALUE

