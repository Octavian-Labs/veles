# консоль — вывод в stdout (Linux: syscall write).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять стр, память, буфер

функ печать(с стр):
    искра:
        ПЕР АКК, с          ; указатель на пару {данные, длина}
        ПЕР ИСТ, [АКК]      ; данные
        ПЕР ДАН, [АКК+8]    ; длина
        ПЕР ПРМ, 1          ; stdout
        ПЕР АКК, 1          ; sys_write
        СИСВЫЗОВ

функ печатьстр(с стр):
    печать(с)
    печать("\n")

функ печатьцел(ч цел64):
    печать(цел_в_стр(ч))

функ ввод() стр:
    # читает весь stdin до EOF порциями по 64 КиБ
    б *Буфер = буф_новый()
    кусок *без8 = выдели(65536)
    прочитано цел64 = 1
    пока прочитано > 0:
        искра:
            ПЕР ПРМ, 0          ; stdin
            ПЕР ИСТ, кусок
            ПЕР ДАН, 65536
            ПЕР АКК, 0          ; sys_read
            СИСВЫЗОВ
            ПЕР прочитано, АКК
        если прочитано > 0:
            буф_место(б, прочитано как без64)
            скопируй(б.данные + б.длина, кусок, прочитано как без64)
            б.длина += прочитано как без64
    освободи(кусок)
    верни буф_стр(б)
