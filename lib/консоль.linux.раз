# консоль — вывод в stdout (Linux: syscall write).
# Часть стандартной библиотеки «основа» экосистемы ВЕЛЕС.

взять стр

функ печать(с стр):
    искра:
        ПЕР АКК, с          ; указатель на пару {данные, длина}
        ПЕР ИСТ, [АКК]      ; данные
        ПЕР ДАН, [АКК+8]    ; длина
        ПЕР ПРМ, 1          ; stdout
        ПЕР АКК, 1          ; sys_write
        СИСВЫЗОВ

функ печатьстр(с стр):
    печать(с)
    печать("\n")

функ печатьцел(ч цел64):
    печать(цел_в_стр(ч))

функ ввод() стр:
    # читает stdin одним вызовом (буфер 1 МиБ — достаточно для компилятора)
    буф *без8 = выдели(1048576)
    прочитано цел64 = 0
    искра:
        ПЕР ПРМ, 0          ; stdin
        ПЕР ИСТ, буф
        ПЕР ДАН, 1048576
        ПЕР АКК, 0          ; sys_read
        СИСВЫЗОВ
        ПЕР прочитано, АКК
    верни стр_собери(буф, прочитано как без64)
