    # ошибка выделения памяти → стд_сбой_памяти, код 103
    _кейс(кейсы, "пам выдели", "тесты/границы/пам_выдели.раз", 103, "")
    _кейс(кейсы, "ст в границах",    "тесты/границы/ст_в_границах.раз",    42,  "")
    верни кейсы

