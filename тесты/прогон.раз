    _кейс(кейсы, "ср созд порядок", "тесты/границы/ср_созд_порядок.раз", 102, "")
    _кейс(кейсы, "ср созд вкл",     "тесты/границы/ср_созд_вкл.раз",     102, "")
    _кейс(кейсы, "ср в границах",   "тесты/границы/ср_в_границах.раз",   42,  "")
    # границы строк: индекс → 101, стр_срез с неверным диапазоном → 102
    _кейс(кейсы, "ст инд дин",       "тесты/границы/ст_инд_дин.раз",       101, "")
    _кейс(кейсы, "ст инд минус",     "тесты/границы/ст_инд_минус.раз",     101, "")
    _кейс(кейсы, "ст инд длина",     "тесты/границы/ст_инд_длина.раз",     101, "")
    _кейс(кейсы, "ст пустая",        "тесты/границы/ст_пустая.раз",        101, "")
