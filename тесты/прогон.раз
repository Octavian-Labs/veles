# прогон — нативный тест-раннер ВЕЛЕС.
# Для каждого кейса: разум < исход.раз > т_*.иск, искра < т_*.иск > экзе,
# запуск экзе с пустым stdin, сверка кода выхода и подстроки вывода.
# Код выхода прогона — число провалов (0 = всё зелёное).
# Запускать из корня репозитория.

взять основа
взять процесс

запись Кейс:
    имя стр
    исх стр
    код цел.верх
    хочет стр              # обязательная подстрока вывода; "" — не проверять
    вин лог                # да — кейс только для Windows
    арг стр                # дополнительные флаги разума; "" — без флагов

запись КейсОшибки:
    имя стр
    исх стр
    хочет стр

функ _кейс(кейсы *Список, имя стр, исх стр, код цел.верх, хочет стр):
    кейс *Кейс = новый(Кейс)
    кейс.имя = имя
    кейс.исх = исх
    кейс.код = код
    кейс.хочет = хочет
    кейс.вин = нет
    кейс.арг = ""
    список_добавь(кейсы, кейс как нат.верх)

# кейс с дополнительными флагами разума (например, « --память проверка»)
функ _кейс_арг(кейсы *Список, имя стр, исх стр, код цел.верх, арг стр):
    _кейс(кейсы, имя, исх, код, "")
    кейс *Кейс = список_получи(кейсы, кейсы.длина - 1) как *Кейс
    кейс.арг = арг

