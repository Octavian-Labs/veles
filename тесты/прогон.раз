    _кейс(кейсы, "пробелы",    "examples/пробелы.раз",     52, "")
    _кейс(кейсы, "основа",     "examples/основа_демо.раз", 42, "Ответ: 42")
    _кейс(кейсы, "список",     "examples/список_демо.раз", 60, "")
    _кейс(кейсы, "файл",       "examples/файл_демо.раз",   42, "42 найдено")
    _кейс(кейсы, "ввод",       "examples/ввод_демо.раз",   0,  "получено байт: 0")
    _кейс(кейсы, "выход",      "examples/выход_linux.раз", 42, "")
    _кейс(кейсы, "рег_стресс", "тесты/рег_стресс.раз",     6,  "")
    _кейс(кейсы, "строки",     "тесты/строки_отложи.раз",  8,  "123")
    _кейс(кейсы, "простые",    "examples/простые.раз",     0,  "148933")
    _кейс(кейсы, "строгий лог", "тесты/лог/верные.раз",      0,  "")
    _кейс(кейсы, "норма лог",   "тесты/лог/нормализация.раз", 1,  "")
    # границы массивов в режиме надёжно: сбой завершает процесс кодом 101
    _кейс(кейсы, "гр дин чтение", "тесты/границы/дин_чтение.раз", 101, "")
    _кейс(кейсы, "гр дин запись", "тесты/границы/дин_запись.раз", 101, "")
    _кейс(кейсы, "гр дин минус",  "тесты/границы/дин_минус.раз",  101, "")
