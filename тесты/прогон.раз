# прогон — нативный тест-раннер ВЕЛЕС.
# Для каждого кейса: разум < исход.раз > т_*.иск, искра < т_*.иск > экзе,
# запуск экзе с пустым stdin, сверка кода выхода и подстроки вывода.
# Код выхода прогона — число провалов (0 = всё зелёное).
# Запускать из корня репозитория.

взять основа
взять процесс

запись Кейс:
    имя стр
    исх стр
    код цел.верх
    хочет стр              # обязательная подстрока вывода; "" — не проверять
    вин лог                # да — кейс только для Windows

функ _кейс(к *Список, имя стр, исх стр, код цел.верх, хочет стр):
    з *Кейс = новый(Кейс)
    з.имя = имя
    з.исх = исх
    з.код = код
    з.хочет = хочет
    з.вин = нет
    список_добавь(к, з как нат.верх)

функ кейсы() *Список:
    к *Список = список_новый()
    _кейс_вин(к, "привет",   "examples/привет.раз",      0,  "Привет")
    _кейс(к, "вычисления", "examples/вычисления.раз",  55, "")
    _кейс(к, "пробелы",    "examples/пробелы.раз",     52, "")
    _кейс(к, "основа",     "examples/основа_демо.раз", 42, "Ответ: 42")
    _кейс(к, "список",     "examples/список_демо.раз", 60, "")
    _кейс(к, "файл",       "examples/файл_демо.раз",   42, "42 найдено")
    _кейс(к, "ввод",       "examples/ввод_демо.раз",   0,  "получено байт: 0")
    _кейс(к, "выход",      "examples/выход_linux.раз", 42, "")
    _кейс(к, "рег_стресс", "тесты/рег_стресс.раз",     6,  "")
    _кейс(к, "строки",     "тесты/строки_отложи.раз",  8,  "123")
    _кейс(к, "простые",    "examples/простые.раз",     0,  "148933")
    верни к

# кейс, имеющий смысл только на Windows (kernel32-импорты)
функ _кейс_вин(к *Список, имя стр, исх стр, код цел.верх, хочет стр):
    _кейс(к, имя, исх, код, хочет)
    з := список_получи(к, к.длина - 1) как *Кейс
    з.вин = да

# прогон одного кейса: компиляция в два прохода, запуск, сверки
функ прогоняй(з *Кейс, пустой стр) лог:
    иск := стр_склей("т_", стр_склей(з.имя, ".иск"))
    экз := экзе_путь(стр_склей("т_", з.имя))
    вых := стр_склей("т_", стр_склей(з.имя, ".out"))
    если запусти(путь_разум(), флаг_цели(), з.исх, иск) != 0:
        печатьстр(стр_склей("ПРОВАЛ разум  ", з.имя))
        верни нет
    если запусти(путь_искра(), "", иск, экз) != 0:
        печатьстр(стр_склей("ПРОВАЛ искра  ", з.имя))
        верни нет
    исполняемый(экз)
    к := запусти(экз, "", пустой, вых)
    если к != з.код:
        печатьстр(стр_склей(стр_склей("ПРОВАЛ ", стр_склей(з.имя, ": код ")),
            стр_склей(цел_в_стр(к), стр_склей(" вместо ", цел_в_стр(з.код)))))
        верни нет
    если з.хочет.длина > 0:
        вывод := файл_прочти(вых)
        если вывод == пусто или стр_найди(вывод, з.хочет) < 0:
            печатьстр(стр_склей("ПРОВАЛ вывод  ", з.имя))
            верни нет
    печатьстр(стр_склей("ок             ", з.имя))
    файл_удали(иск)
    файл_удали(экз)
    файл_удали(вых)
    верни да

функ главная() цел.верх:
    пустой := "т_пусто.txt"
    файл_запиши(пустой, "")
    кс := кейсы()
    плохо цел.верх = 0
    всего := кс.длина как цел.верх
    для i в 0..кс.длина:
        з := список_получи(кс, i) как *Кейс
        если з.вин и хост_линукс():
            печатьстр(стр_склей("пропуск        ", з.имя))
            всего -= 1
        а если не прогоняй(з, пустой):
            плохо += 1
    файл_удали(пустой)
    печать(цел_в_стр(всего - плохо))
    печать(стр_склей("/", цел_в_стр(всего)))
    печатьстр(стр_склей(" ок, провалов: ", цел_в_стр(плохо)))
    верни плохо
