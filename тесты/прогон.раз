# прогон одного кейса: компиляция в два прохода, запуск, сверки
функ прогоняй(кейс *Кейс, пустой стр) лог:
    иск стр = стр_склей("т_", стр_склей(кейс.имя, ".иск"))
    экз стр = экзе_путь(стр_склей("т_", кейс.имя))
    вых стр = стр_склей("т_", стр_склей(кейс.имя, ".out"))
    если запусти(путь_разум(), стр_склей(флаг_цели(), кейс.арг),
        кейс.исх, иск) != 0:
        печатьстр(стр_склей("ПРОВАЛ разум  ", кейс.имя))
        верни нет
    если запусти(путь_искра(), "", иск, экз) != 0:
        печатьстр(стр_склей("ПРОВАЛ искра  ", кейс.имя))
        верни нет
    исполняемый(экз)
    код цел.верх = запусти(экз, "", пустой, вых)
    если код != кейс.код:
        печатьстр(стр_склей(стр_склей("ПРОВАЛ ", стр_склей(кейс.имя, ": код ")),
            стр_склей(цел_в_стр(код), стр_склей(" вместо ", цел_в_стр(кейс.код)))))
        верни нет
    если кейс.хочет.длина > 0:
        вывод стр = файл_прочти(вых)
        если вывод == пусто или стр_найди(вывод, кейс.хочет) < 0:
            печатьстр(стр_склей("ПРОВАЛ вывод  ", кейс.имя))
            верни нет
    печатьстр(стр_склей("ок             ", кейс.имя))
    файл_удали(иск)
    файл_удали(экз)
    файл_удали(вых)
    верни да

функ проверь_ошибку(кейс *КейсОшибки, пустой стр) лог:
    вых стр = стр_склей("т_ош_", стр_склей(кейс.имя, ".out"))
    код цел.верх = запусти(путь_разум(), флаг_цели(), кейс.исх, вых)
    вывод стр = файл_прочти(вых)
    если код == 0:
        печатьстр(стр_склей("ПРОВАЛ принят  ", кейс.имя))
        файл_удали(вых)
        верни нет
    если вывод == пусто или стр_найди(вывод, кейс.хочет) < 0:
        печатьстр(стр_склей("ПРОВАЛ ошибка  ", кейс.имя))
        файл_удали(вых)
        верни нет
    печатьстр(стр_склей("ок ошибка      ", кейс.имя))
    файл_удали(вых)
    верни да

