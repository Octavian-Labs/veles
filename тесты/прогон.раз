# прогон — нативный тест-раннер ВЕЛЕС.
# Для каждого кейса: разум < исход.раз > т_*.иск, искра < т_*.иск > экзе,
# запуск экзе с пустым stdin, сверка кода выхода и подстроки вывода.
# Код выхода прогона — число провалов (0 = всё зелёное).
# Запускать из корня репозитория.

взять основа
взять процесс

запись Кейс:
    имя стр
    исх стр
    код цел.верх
    хочет стр              # обязательная подстрока вывода; "" — не проверять
    вин лог                # да — кейс только для Windows

функ _кейс(кейсы *Список, имя стр, исх стр, код цел.верх, хочет стр):
    кейс *Кейс = новый(Кейс)
    кейс.имя = имя
    кейс.исх = исх
    кейс.код = код
    кейс.хочет = хочет
    кейс.вин = нет
    список_добавь(кейсы, кейс как нат.верх)

функ кейсы() *Список:
    кейсы *Список = список_новый()
    _кейс_вин(кейсы, "привет",   "examples/привет.раз",      0,  "Привет")
    _кейс(кейсы, "вычисления", "examples/вычисления.раз",  55, "")
    _кейс(кейсы, "пробелы",    "examples/пробелы.раз",     52, "")
    _кейс(кейсы, "основа",     "examples/основа_демо.раз", 42, "Ответ: 42")
    _кейс(кейсы, "список",     "examples/список_демо.раз", 60, "")
    _кейс(кейсы, "файл",       "examples/файл_демо.раз",   42, "42 найдено")
    _кейс(кейсы, "ввод",       "examples/ввод_демо.раз",   0,  "получено байт: 0")
    _кейс(кейсы, "выход",      "examples/выход_linux.раз", 42, "")
    _кейс(кейсы, "рег_стресс", "тесты/рег_стресс.раз",     6,  "")
    _кейс(кейсы, "строки",     "тесты/строки_отложи.раз",  8,  "123")
    _кейс(кейсы, "простые",    "examples/простые.раз",     0,  "148933")
    верни кейсы

# кейс, имеющий смысл только на Windows (kernel32-импорты)
функ _кейс_вин(кейсы *Список, имя стр, исх стр, код цел.верх, хочет стр):
    _кейс(кейсы, имя, исх, код, хочет)
    кейс *Кейс = список_получи(кейсы, кейсы.длина - 1) как *Кейс
    кейс.вин = да

# прогон одного кейса: компиляция в два прохода, запуск, сверки
функ прогоняй(кейс *Кейс, пустой стр) лог:
    иск стр = стр_склей("т_", стр_склей(кейс.имя, ".иск"))
    экз стр = экзе_путь(стр_склей("т_", кейс.имя))
    вых стр = стр_склей("т_", стр_склей(кейс.имя, ".out"))
    если запусти(путь_разум(), флаг_цели(), кейс.исх, иск) != 0:
        печатьстр(стр_склей("ПРОВАЛ разум  ", кейс.имя))
        верни нет
    если запусти(путь_искра(), "", иск, экз) != 0:
        печатьстр(стр_склей("ПРОВАЛ искра  ", кейс.имя))
        верни нет
    исполняемый(экз)
    код цел.верх = запусти(экз, "", пустой, вых)
    если код != кейс.код:
        печатьстр(стр_склей(стр_склей("ПРОВАЛ ", стр_склей(кейс.имя, ": код ")),
            стр_склей(цел_в_стр(код), стр_склей(" вместо ", цел_в_стр(кейс.код)))))
        верни нет
    если кейс.хочет.длина > 0:
        вывод стр = файл_прочти(вых)
        если вывод == пусто или стр_найди(вывод, кейс.хочет) < 0:
            печатьстр(стр_склей("ПРОВАЛ вывод  ", кейс.имя))
            верни нет
    печатьстр(стр_склей("ок             ", кейс.имя))
    файл_удали(иск)
    файл_удали(экз)
    файл_удали(вых)
    верни да

функ главная() цел.верх:
    пустой стр = "т_пусто.txt"
    файл_запиши(пустой, "")
    кейсы *Список = кейсы()
    плохо цел.верх = 0
    всего цел.верх = кейсы.длина как цел.верх
    для инд в 0..кейсы.длина:
        кейс *Кейс = список_получи(кейсы, инд) как *Кейс
        если кейс.вин и хост_не_вин():
            печатьстр(стр_склей("пропуск        ", кейс.имя))
            всего -= 1
        а если не прогоняй(кейс, пустой):
            плохо += 1
    файл_удали(пустой)
    печать(цел_в_стр(всего - плохо))
    печать(стр_склей("/", цел_в_стр(всего)))
    печатьстр(стр_склей(" ок, провалов: ", цел_в_стр(плохо)))
    верни плохо
