    _кейс(кейсы, "гр в границах", "тесты/границы/в_границах.раз", 42,  "")
    # границы срезов: индекс → 101, создание → 102
    _кейс(кейсы, "ср инд дин",      "тесты/границы/ср_инд_дин.раз",      101, "")
    _кейс(кейсы, "ср инд минус",    "тесты/границы/ср_инд_минус.раз",    101, "")
