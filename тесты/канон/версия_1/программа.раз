# канон версии 1 — представительная программа под закреплённой
# семантикой: записи, перечисления, константы, массивы, срезы,
# функции, методы, цикл для, условия со строгим лог.
# Компилируется актуальным разумом и исполняется с кодом 42.

взять основа

конст ШАГ = 3

запись Точка:
    икс цел.верх
    игрек цел.верх

переч Сторона:
    север
    юг

функ (т Точка) квадрат() цел.верх:
    верни т.икс * т.икс + т.игрек * т.игрек

функ главная() цел.верх:
    т Точка = Точка{икс: 3, игрек: 4}
    числа нат.верх[3] = нат.верх[3]{1, 2, 3}
    введи часть = числа[0..3]
    сумма цел.верх = т.квадрат()              # 25
    для инд в 0..часть.длина:
        сумма += часть[инд] как цел.верх      # +6 = 31
    если Сторона.юг == юг:
        сумма += ШАГ + 8                      # +11 = 42
    верни сумма
