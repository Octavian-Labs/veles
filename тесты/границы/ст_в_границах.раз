# легальный доступ к строке: индекс, срез синтаксисом, стр_срез,
# пустой срез: (5 + 3) * 5 + (101 - 101) + 2 = 42
взять основа

функ главная() цел.верх:
    с стр = "abcde"
    и цел.верх = 4
    б цел.верх = с[и] как цел.верх
    введи кусок = с[1..4]
    часть стр = стр_срез(с, 0, 4)
    введи пустой = с[5..5]
    верни ((с.длина + кусок.длина) * 5 + (б - 101) +
        часть.длина - пустой.длина - 2) как цел.верх
