# легальные срезы: [1..3], пустые [0..0] и [4..4], включительный [0..=3],
# индексация в границах: 30 + 4 + 0 + 0 + 8 = 42
функ главная() цел.верх:
    м цел.верх[4]
    м[0] = 10
    м[1] = 20
    м[2] = 30
    м[3] = 40
    введи ср = м[1..3]
    и цел.верх = 1
    сумма цел.верх = ср[и]
    введи пусто1 = м[0..0]
    введи пусто2 = м[4..4]
    введи вкл = м[0..=3]
    верни сумма + вкл.длина + пусто1.длина + пусто2.длина + 8
