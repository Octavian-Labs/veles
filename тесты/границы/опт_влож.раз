# вложенные циклы: оба индекса доказаны для своих массивов — без дин.проверок
# внутренняя сумма за каждый и: 1+2+3+4=10; итого 4*10 + (1+2+3+4) - 8 = 42
функ главная() цел.верх:
    м цел.верх[4]
    м[0] = 1
    м[1] = 2
    м[2] = 3
    м[3] = 4
    сум цел.верх = 0
    для и в 0..4:
        для ж в 0..4:
            сум += м[ж]
        сум += м[и]
    верни сум - 8
