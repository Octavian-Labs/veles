# коллекция переприсваивается в теле — доказательство не ставится,
# ср[и] проверяется: после ср = ср2 (длина 2) индекс и=2 → код 101
функ главная() цел.верх:
    м цел.верх[4]
    м[0] = 1
    м[1] = 1
    м[2] = 1
    м[3] = 1
    введи ср = м[0..4]
    введи ср2 = м[0..2]
    сум цел.верх = 0
    для и в ср:
        ср = ср2
        сум += ср[и]
    верни сум
