# размер/смещение — объявления, арифметика, параметры, возврат, указатели
функ суммируй(а размер, б размер) размер:
    верни а + б

функ сдвинь(поз смещение, дельта смещение) смещение:
    верни поз + дельта

функ главная() цел.верх:
    дл размер = 10
    ём размер = 20
    п смещение = -4
    к смещение = 8
    указ *размер = &дл
    указ[0] = суммируй(дл, ём)
    инд смещение = сдвинь(п, к)
    если указ[0] != 30:
        верни 1
    если инд != 4:
        верни 2
    # совместимость с нат.верх/цел.верх (ABI-синонимы)
    н нат.верх = дл
    з цел.верх = п
    дл = н
    п = з
    если дл != 30 или п != -4:
        верни 3
    верни указ[0] + инд + 8
