# тестовый модуль: смесь открытых и скрытых имён

открыто функ о_два() цел.верх:
    верни 2

открыто функ о_сорок() цел.верх:
    верни _внутр() * 20

функ _внутр() цел.верх:
    # скрытый помощник — доступен только этому модулю
    верни 2

скрыто функ ск_три() цел.верх:
    верни 3

открыто конст М_СЕМЬ = 7

конст М_ДЕВЯТЬ = 9

открыто запись Откр:
    поле размер

запись Внутр:
    поле размер
