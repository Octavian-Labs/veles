# модуль для проверки интерфейсного кэша .рми

открыто конст КЭШ_ЧИСЛО = 17

открыто запись КэшПара:
    первое цел.верх
    второе цел.верх

открыто переч КэшВид:
    кэш_один
    кэш_два
    кэш_три

открыто тип КэшСлово = нат.верх

открыто функ кэш_сумма(а цел.верх, б цел.верх) цел.верх:
    верни а + б

функ _скрытый() цел.верх:
    верни -1

открыто функ кэш_двойное(число цел.верх) цел.верх:
    # внутри модуля скрытый помощник доступен
    верни _скрытый() * -2 * число

открыто функ (пара *КэшПара) сумма() цел.верх:
    верни пара.первое + пара.второе
