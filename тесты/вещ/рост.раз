# вещ.рост — f32: литералы, арифметика, сравнения с NaN, приведения
# (в том числе вещ.рост ↔ вещ.верх), параметры и результат через xmm,
# отложи с вещественным возвратом. Восемь групп по биту: код выхода 255.

взять основа

открыто функ удвоить(х вещ.рост) вещ.рост:
    верни х * 2.0

открыто функ среднее(а цел.верх, б вещ.рост, в цел.верх) вещ.рост:
    # смешанные аргументы: целые в регистрах общего назначения, б — в xmm
    верни б + ((а + в) как вещ.рост)

открыто функ половина(х вещ.рост) вещ.рост:
    отложи печать("")            # отложи не должно терять ПЛАВ0
    верни х / 2.0

открыто функ главная() цел.верх:
    р цел.верх = 0

    # литералы: экспонента, подчёркивания, отрицательный, денормал f32
    а вещ.рост = 1.5e2           # 150.0f
    б вещ.рост = 2.5e-1          # 0.25f
    в вещ.рост = 1_000.5         # 1000.5f
    отр вещ.рост = -1.5
    ден вещ.рост = 1e-45         # наименьший денормал binary32
    если а == 150.0 и б == 0.25 и в == 1000.5 и отр == -1.5 и ден > 0.0 и ден < 1e-38:
        р += 1

    # арифметика и точность binary32: 0.1f+0.2f == 0.3f (обратный к f64 квирк),
    # но 0.3f+0.6f != 0.9f — округление всё же видно
    г вещ.рост = 10.0 / 4.0
    д вещ.рост = 0.1 + 0.2
    д2 вещ.рост = 0.3 + 0.6
    если г == 2.5 и д == 0.3 и д2 != 0.9 и (0.0 - отр) == 1.5:
        р += 2

    # границы диапазона: е — почти максимальный f32
    е вещ.рост = 3.4e38
    если е > 1.0e30 и е > 3.0e38:
        р += 4

    # NaN: == ложь, != истина, упорядоченные сравнения ложь
    нан вещ.рост = 0.0 / 0.0
    если нан != нан и не (нан == нан) и не (нан < 1.0) и не (нан >= 1.0):
        р += 8

    # приведения: вещ→цел усечение, цел→вещ, вещ.рост ↔ вещ.верх
    й вещ.рост = 7.9
    ц цел.верх = (й как цел.верх)
    ж вещ.рост = (42 как вещ.рост)
    з вещ.верх = (ж как вещ.верх)
    и вещ.рост = (з как вещ.рост)
    если ц == 7 и ж == 42.0 и з == 42.0 и и == 42.0:
        р += 16

    # вещественный параметр и результат через xmm
    если удвоить(1.5) == 3.0 и удвоить(-2.25) == -4.5:
        р += 32

    # смешанные целые и вещественные аргументы (ABI)
    если среднее(10, 0.5, 4) == 14.5:
        р += 64

    # составные присваивания: += -= *= /=, в том числе по индексу
    х вещ.рост = 10.0
    х += 2.5
    х -= 0.5
    х *= 3.0
    х /= 9.0                    # 4.0
    масс вещ.рост[2] = вещ.рост[2]{1.0, 2.0}
    масс[1] += 0.5

    # отложи сохраняет вещественный результат + составные присваивания
    если половина(9.0) == 4.5 и х == 4.0 и масс[1] == 2.5:
        р += 128

    верни р
