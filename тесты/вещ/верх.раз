# вещ.верх — f64: литералы, арифметика, сравнения с NaN, приведения,
# передача параметров и результат через xmm, отложи с вещественным возвратом.
# Восемь групп проверок по биту: ожидаемый код выхода 255.

взять основа

открыто функ удвоить(х вещ.верх) вещ.верх:
    верни х * 2.0

открыто функ среднее(а цел.верх, б вещ.верх, в цел.верх) вещ.верх:
    # смешанные аргументы: целые в регистрах общего назначения, б — в xmm
    верни б + ((а + в) как вещ.верх)

открыто функ половина(х вещ.верх) вещ.верх:
    отложи печать("")            # отложи не должно терять ПЛАВ0
    верни х / 2.0

открыто функ главная() цел.верх:
    р цел.верх = 0

    # литералы: экспонента, отрицательная экспонента, подчёркивания, денормал
    а вещ.верх = 1.5e2           # 150.0
    б вещ.верх = 2.5e-1          # 0.25
    в вещ.верх = 1_000.5         # 1000.5
    ден вещ.верх = 5e-324        # наименьший денормал
    если а == 150.0 и б == 0.25 и в == 1000.5 и ден > 0.0 и ден < 1e-300:
        р += 1

    # арифметика: деление, двоичная точность, унарный минус
    г вещ.верх = 10.0 / 4.0
    д вещ.верх = 0.1 + 0.2       # != 0.3 в binary64
    отр вещ.верх = -1.5
    если г == 2.5 и д != 0.3 и отр + 1.5 == 0.0:
        р += 2

    # границы диапазона: е — максимальный f64
    е вещ.верх = 1.7976931348623157e308
    если е > 1.0e300 и е > 1.7e308:
        р += 4

    # NaN: == ложь, != истина, упорядоченные сравнения ложь
    нан вещ.верх = 0.0 / 0.0
    если нан != нан и не (нан == нан) и не (нан < 1.0) и не (нан >= 1.0):
        р += 8

    # приведения: усечение вещ→цел, цел→вещ
    ц цел.верх = (7.9 как цел.верх)
    ж вещ.верх = (42 как вещ.верх)
    если ц == 7 и ж == 42.0:
        р += 16

    # вещественный параметр и результат через xmm
    если удвоить(1.5) == 3.0 и удвоить(-2.25) == -4.5:
        р += 32

    # смешанные целые и вещественные аргументы (ABI)
    если среднее(10, 0.5, 4) == 14.5:
        р += 64

    # отложи сохраняет вещественный результат
    если половина(9.0) == 4.5:
        р += 128

    верни р
