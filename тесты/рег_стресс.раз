# рег_стресс — стресс регистровых локалей: больше горячих переменных,
# чем регистров (5), вызовы внутри циклов (сохраняемые регистры должны
# переживать вызов), смесь регистровых и стековых локалей.
# Код выхода — число прошедших проверок, ожидается 6.

функ муль2(х цел64) цел64:
    верни х * 2

функ сумма_до(n цел64) цел64:
    с := 0
    для k в 1..(n + 1):
        с += k
    верни с

функ главная() цел64:
    а := 0
    б := 0
    в := 0
    г := 0
    д := 0
    е := 0
    для i в 1..101:
        а += i              # 5050
        б += муль2(i)       # 10100 — регистр переживает вызов
        в += i % 7
        г += сумма_до(i % 10)   # вложенный цикл в вызове
        д += (а + б) % 13
        е += i * i % 11
    ок := 0
    если а == 5050:
        ок += 1
    если б == 10100:
        ок += 1
    если в == 297:
        ок += 1
    если г == 1650:
        ок += 1
    если д == 508:
        ок += 1
    если е == 397:
        ок += 1
    верни ок
