# рег_стресс — стресс регистровых локалей: больше горячих переменных,
# чем регистров (5), вызовы внутри циклов (сохраняемые регистры должны
# переживать вызов), смесь регистровых и стековых локалей.
# Код выхода — число прошедших проверок, ожидается 6.

функ муль2(х цел.верх) цел.верх:
    верни х * 2

функ сумма_до(n цел.верх) цел.верх:
    с цел.верх = 0
    для инд в 1..(n + 1):
        с += инд
    верни с

функ главная() цел.верх:
    а цел.верх = 0
    б цел.верх = 0
    в цел.верх = 0
    г цел.верх = 0
    д цел.верх = 0
    е цел.верх = 0
    для инд в 1..101:
        а += инд            # 5050
        б += муль2(инд)     # 10100 — регистр переживает вызов
        в += инд % 7
        г += сумма_до(инд % 10) # вложенный цикл в вызове
        д += (а + б) % 13
        е += инд * инд % 11
    ок цел.верх = 0
    если а == 5050:
        ок += 1
    если б == 10100:
        ок += 1
    если в == 297:
        ок += 1
    если г == 1650:
        ок += 1
    если д == 508:
        ок += 1
    если е == 397:
        ок += 1
    верни ок
