# рег_стресс — стресс регистровых локалей: больше горячих переменных,
# чем регистров (5), вызовы внутри циклов (сохраняемые регистры должны
# переживать вызов), смесь регистровых и стековых локалей.
# Код выхода — число прошедших проверок, ожидается 6.

функ муль2(арг цел.верх) цел.верх:
    верни арг * 2

функ сумма_до(предел цел.верх) цел.верх:
    сумма цел.верх = 0
    для инд в 1..(предел + 1):
        сумма += инд
    верни сумма

функ главная() цел.верх:
    сумма_инд цел.верх = 0
    двойные цел.верх = 0
    остатки цел.верх = 0
    вложенная цел.верх = 0
    смесь цел.верх = 0
    квадраты цел.верх = 0
    для инд в 1..101:
        сумма_инд += инд            # 5050
        двойные += муль2(инд)     # 10100 — регистр переживает вызов
        остатки += инд % 7
        вложенная += сумма_до(инд % 10) # вложенный цикл в вызове
        смесь += (сумма_инд + двойные) % 13
        квадраты += инд * инд % 11
    ок цел.верх = 0
    если сумма_инд == 5050:
        ок += 1
    если двойные == 10100:
        ок += 1
    если остатки == 297:
        ок += 1
    если вложенная == 1650:
        ок += 1
    если смесь == 508:
        ок += 1
    если квадраты == 397:
        ок += 1
    верни ок
