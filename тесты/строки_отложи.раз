# Печатает «123» (отложи исполняются в обратном порядке),
# код выхода — число прошедших проверок, ожидается 8.

взять основа

функ хвост(строка стр) стр:
    верни стр_срез(строка, 2, строка.длина)

функ главная() цел.верх:
    ок цел.верх = 0
    отложи печать("3")      # исполнится последним
    отложи печать("2")      # исполнится предпоследним
    печать("1")
    строка стр = стр_склей("ве", "лес")
    если стр_равны(строка, "велес"):
        ок += 1
    если строка.длина == 10:     # 5 кириллических букв по 2 байта UTF-8
        ок += 1
    если стр_найди("абвгдеж", "де") == 8:   # смещение в байтах
        ок += 1
    если стр_равны(хвост("абвгд"), "бвгд"):  # срез тоже в байтах
        ок += 1
    если стр_равны(цел_в_стр(42), "42"):
        ок += 1
    если стр_число("123x") == 123:
        ок += 1
    если стр_равны_нр("ВЕЛЕС", "велес"):
        ок += 1
    выбор 2 + 2:
        4:
            ок += 1
        3:
            ок += 100
        иначе:
            ок += 1000
    верни ок
