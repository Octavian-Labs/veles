# стек_зонд — рамки больше одной страницы (4КБ): Windows растит стек
# только через сторожевую страницу, значит пролог должен зондировать
# каждую страницу сверху вниз. Без зонда первое касание ниже границы —
# ошибка доступа. На Linux/macOS тест проходит и без зондирования.

взять основа

открыто функ главная() цел.верх:
    вхм нат.верх[7200]             # ~57КБ: 14 страниц зондирования
    сум нат.верх = 0
    для и в 0..7200:
        вхм[и] = 1
    для и в 0..7200:
        сум += вхм[и]
    если сум == 7200:
        верни 42
    верни 1
