# переведи — мигратор исходников ВЕЛЕС на актуальный канон (§11).
# Использование: переведи файл.раз [файл2.раз ...]
#
# Переписывает файлы на месте по машиночитаемым правилам:
#   бул      → лог
#   цел8…128 → цел.старт…цел.пик
#   без8…128 → нат.старт…нат.пик
#   «имя := выражение» → «введи имя = выражение»
#
# Строковые литералы, комментарии («#», «;», включая прагмы «;версия»)
# и тела блоков «искра:» не затрагиваются.

взять основа

запись Правило:
    откуда стр
    куда стр

функ _добавь(правила *Список, откуда стр, куда стр):
    пр *Правило = новый(Правило)
    пр.откуда = откуда
    пр.куда = куда
    список_добавь(правила, пр как размер)

функ правила() *Список:
    пр *Список = список_новый()
    _добавь(пр, "бул", "лог")
    _добавь(пр, "цел8", "цел.старт")
    _добавь(пр, "цел16", "цел.шаг")
    _добавь(пр, "цел32", "цел.рост")
    _добавь(пр, "цел64", "цел.верх")
    _добавь(пр, "цел128", "цел.пик")
    _добавь(пр, "без8", "нат.старт")
    _добавь(пр, "без16", "нат.шаг")
    _добавь(пр, "без32", "нат.рост")
    _добавь(пр, "без64", "нат.верх")
    _добавь(пр, "без128", "нат.пик")
    верни пр

функ _замена(правила *Список, слово стр) стр:
    # каноническое имя или "" — замены нет
    для инд в 0..правила.длина:
        пр *Правило = список_получи(правила, инд) как *Правило
        если стр_равны(слово, пр.откуда):
            верни пр.куда
    верни ""

функ _ид_знак(зн нат.старт) лог:
    # знак идентификатора: не-ASCII буква (UTF-8), латиница, цифра, _
    верни (зн >= 128 или зн == '_' или
        (зн >= 'a' и зн <= 'z') или (зн >= 'A' и зн <= 'Z') или
        (зн >= '0' и зн <= '9'))

функ _ид_начало(зн нат.старт) лог:
    верни _ид_знак(зн) и не (зн >= '0' и зн <= '9')

функ _пробел_ли(зн нат.старт) лог:
    верни зн == ' ' или зн == 9

функ _код_конец(лин стр) размер:
    # конец кода в строке: '#' или ';' вне кавычек — дальше комментарий
    поз размер = 0
    пока поз < лин.длина:
        зн нат.старт = лин.данные[поз]
        если зн == '"' или зн == 39:
            поз += 1
            пока поз < лин.длина и лин.данные[поз] != зн:
                если лин.данные[поз] == '\\':
                    поз += 1
                поз += 1
            если поз < лин.длина:
                поз += 1
            следующий
        если зн == '#' или зн == ';':
            верни поз
        поз += 1
    верни лин.длина

функ _обработай_код(лин стр, от размер, до размер, правила *Список,
        замен *размер, вых *Буфер):
    # копирует срез кода [от, до) с заменой устаревших идентификаторов
    поз размер = от
    пока поз < до:
        зн нат.старт = лин.данные[поз]
        нач размер = поз
        если зн == '"' или зн == 39:
            # строковый литерал — без замен
            поз += 1
            пока поз < до и лин.данные[поз] != зн:
                если лин.данные[поз] == '\\':
                    поз += 1
                поз += 1
            если поз < до:
                поз += 1
            буф_добавь(вых, стр_срез(лин, нач, поз))
        а если _ид_начало(зн):
            поз += 1
            пока поз < до и _ид_знак(лин.данные[поз]):
                поз += 1
            слово стр = стр_срез(лин, нач, поз)
            зам стр = _замена(правила, слово)
            если зам.длина > 0:
                буф_добавь(вых, зам)
                замен[0] += 1
            иначе:
                буф_добавь(вых, слово)
        иначе:
            буф_сим(вых, зн)
            поз += 1

функ _обработай_линию(лин стр, правила *Список, замен *размер) стр:
    кон размер = _код_конец(лин)
    вых *Буфер = буф_новый()
    сделано лог = нет
    # шаблон «<отступ>имя :=»: объявление с выводом типа
    поз0 размер = 0
    пока поз0 < кон и _пробел_ли(лин.данные[поз0]):
        поз0 += 1
    если поз0 < кон и _ид_начало(лин.данные[поз0]):
        ним размер = поз0
        пим размер = поз0 + 1
        пока пим < кон и _ид_знак(лин.данные[пим]):
            пим += 1
        посл размер = пим
        пока посл < кон и _пробел_ли(лин.данные[посл]):
            посл += 1
        если посл + 1 < кон и лин.данные[посл] == ':' и лин.данные[посл + 1] == '=':
            буф_добавь(вых, стр_срез(лин, 0, поз0))
            буф_добавь(вых, "введи ")
            _обработай_код(лин, ним, пим, правила, замен, вых)
            буф_добавь(вых, " = ")
            посл += 2
            пока посл < кон и _пробел_ли(лин.данные[посл]):
                посл += 1
            _обработай_код(лин, посл, кон, правила, замен, вых)
            замен[0] += 1
            сделано = да
    если не сделано:
        _обработай_код(лин, 0, кон, правила, замен, вых)
    # хвост строки (комментарий) — как есть
    буф_добавь(вых, стр_срез(лин, кон, лин.длина))
    верни буф_стр(вых)

функ _отступ(лин стр) размер:
    поз размер = 0
    пока поз < лин.длина и _пробел_ли(лин.данные[поз]):
        поз += 1
    верни поз

функ _это_искра(лин стр) лог:
    # строка целиком (без комментария) — «искра:»
    кон размер = _код_конец(лин)
    код стр = стр_срез(лин, _отступ(лин), кон)
    верни стр_равны(код, "искра:")

функ _пустая(лин стр) лог:
    верни _отступ(лин) >= лин.длина

функ переведи_файл(путь стр, правила *Список) лог:
    исх стр = файл_прочти(путь)
    если исх == пусто:
        печать_ош(стр_склей("переведи: файл не найден или не читается: ",
            стр_склей(путь, "\n")))
        верни нет
    вых *Буфер = буф_новый()
    замен размер = 0
    искра_отс смещение = -1          # отступ строки «искра:» или -1
    нач размер = 0
    поз размер = 0
    пока поз <= исх.длина:
        если поз == исх.длина или исх.данные[поз] == 10:
            кон размер = поз
            если кон > нач и исх.данные[кон - 1] == 13:
                кон -= 1
            лин стр = стр_срез(исх, нач, кон)
            разд стр = стр_срез(исх, кон, поз)       # \r\n | \n | ""
            если поз < исх.длина:
                разд = стр_срез(исх, кон, поз + 1)
            если искра_отс >= 0:
                # тело блока искра: — сырой текст, не переписываем
                если _пустая(лин) или (_отступ(лин) как смещение) > искра_отс:
                    буф_добавь(вых, лин)
                иначе:
                    искра_отс = -1
                    буф_добавь(вых, _обработай_линию(лин, правила, &замен))
            иначе:
                буф_добавь(вых, _обработай_линию(лин, правила, &замен))
                если _это_искра(лин):
                    искра_отс = _отступ(лин) как смещение
            буф_добавь(вых, разд)
            нач = поз + 1
        поз += 1
    если замен == 0:
        печать(стр_склей("переведи: ", путь))
        печатьстр(" — без изменений")
        верни да
    если не файл_запиши(путь, буф_стр(вых)):
        печать_ош(стр_склей("переведи: не удалось записать: ",
            стр_склей(путь, "\n")))
        верни нет
    печать(стр_склей("переведи: ", путь))
    печать(" — ")
    печать(без_в_стр(замен))
    печатьстр(" замен")
    верни да

функ _проп_пробелы(текст стр, поз размер) размер:
    пока поз < текст.длина и _пробел_ли(текст.данные[поз]):
        поз += 1
    верни поз

функ главная() цел.верх:
    арг стр = аргументы()
    если арг == пусто:
        печать_ош("переведи: нет командной строки\n")
        верни 2
    # пропуск argv[0] — слово или "путь в кавычках"
    поз размер = _проп_пробелы(арг, 0)
    если поз < арг.длина и арг.данные[поз] == '"':
        поз += 1
        пока поз < арг.длина и арг.данные[поз] != '"':
            поз += 1
        если поз < арг.длина:
            поз += 1
    иначе:
        пока поз < арг.длина и не _пробел_ли(арг.данные[поз]):
            поз += 1
    файлы *Список = список_новый()
    вечно:
        поз = _проп_пробелы(арг, поз)
        если поз >= арг.длина:
            хватит
        нач размер = поз
        если арг.данные[поз] == '"':
            нач = поз + 1
            поз += 1
            пока поз < арг.длина и арг.данные[поз] != '"':
                поз += 1
            список_добавь(файлы, стр_срез(арг, нач, поз) как размер)
            если поз < арг.длина:
                поз += 1
        иначе:
            пока поз < арг.длина и не _пробел_ли(арг.данные[поз]):
                поз += 1
            список_добавь(файлы, стр_срез(арг, нач, поз) как размер)
    если файлы.длина == 0:
        печать_ош("переведи: укажите файлы .раз — переведи файл.раз [файл2.раз]\n")
        верни 2
    правила *Список = правила()
    плохо цел.верх = 0
    для инд в 0..файлы.длина:
        путь стр = список_получи(файлы, инд) как стр
        если не переведи_файл(путь, правила):
            плохо += 1
    верни плохо
