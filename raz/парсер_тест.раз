# парсер_тест — проверка парсера на РАЗУМЕ: читает исходник из stdin,
# печатает вид и имя каждого объявления + общее число. Временный файл.
взять основа
взять лексер, узлы, парсер

функ главная() цел.верх:
    исх стр = ввод()
    прог *Узел = разбери(исх)
    для инд в 0..прог.дети.длина:
        объяв *Узел = список_получи(прог.дети, инд) как *Узел
        печатьцел(объяв.вид как цел.верх)
        печать(":")
        если объяв.текст == пусто:
            печатьстр("-")
        иначе:
            печатьстр(объяв.текст)
    печать("объявлений: ")
    печатьцел(прог.дети.длина как цел.верх)
    печатьстр("")
    верни 0
