# парсер_тест — проверка парсера на РАЗУМЕ: читает исходник из stdin,
# печатает вид и имя каждого объявления + общее число. Временный файл.
взять основа
взять лексер, узлы, парсер

функ главная() цел.верх:
    исх := ввод()
    прог := разбери(исх)
    для i в 0..прог.дети.длина:
        д := список_получи(прог.дети, i) как *Узел
        печатьцел(д.вид как цел.верх)
        печать(":")
        если д.текст == пусто:
            печатьстр("-")
        иначе:
            печатьстр(д.текст)
    печать("объявлений: ")
    печатьцел(прог.дети.длина как цел.верх)
    печатьстр("")
    верни 0
