# опт — peephole-оптимизатор текста ИСКРЫ.
# Работает построчно над сгенерированным кодом: сэндвичи ВСТЕК/ИЗСТЕКА
# вокруг одного вычисления, свёртка УСТ*/БЕЗРАСШ/ПРОВ/переход в один jcc,
# лишние ПЕР-пары, переходы на следующую метку и мёртвый код.
# Все правила сохраняют семантику; метки и не-инструкции — барьеры окон.

взять основа

# --- строковые помощники --------------------------------------------------

функ _о_тело(л стр) стр:
    # тело инструкции без отступа; "" — метка/директива/пустая строка
    если л.длина > 4 и стр_начинается(л, "    "):
        т стр = стр_срез(л, 4, л.длина)
        если т.данные[т.длина - 1] != 58:
            верни т
    верни ""

функ _о_т(лини *Список, i нат.верх) стр:
    если i >= лини.длина:
        верни ""
    верни _о_тело(список_получи(лини, i) как стр)

функ _о_метка(л стр) стр:
    # имя метки (строка вида «имя:» с отступом или без); "" — не метка
    т стр = л
    если стр_начинается(л, "    "):
        т = стр_срез(л, 4, л.длина)
    если т.длина > 0 и т.данные[т.длина - 1] == 58:
        верни стр_срез(т, 0, т.длина - 1)
    верни ""

функ _о_мнем(т стр) стр:
    п цел.верх = стр_найди(т, " ")
    если п < 0:
        верни т
    верни стр_срез(т, 0, п как нат.верх)

функ _о_ост(т стр) стр:
    п цел.верх = стр_найди(т, " ")
    если п < 0:
        верни ""
    верни стр_срез(т, (п + 1) как нат.верх, т.длина)

функ _о_оп1(т стр) стр:
    ост стр = _о_ост(т)
    п цел.верх = стр_найди(ост, ", ")
    если п < 0:
        верни ост
    верни стр_срез(ост, 0, п как нат.верх)

функ _о_оп2(т стр) стр:
    ост стр = _о_ост(т)
    п цел.верх = стр_найди(ост, ", ")
    если п < 0:
        верни ""
    верни стр_срез(ост, (п + 2) как нат.верх, ост.длина)

функ _о_конч(с стр, хв стр) лог:
    если с.длина < хв.длина:
        верни нет
    верни стр_равны(стр_срез(с, с.длина - хв.длина, с.длина), хв)

функ _о_к3(а стр, б стр, в стр) стр:
    верни стр_склей(стр_склей(а, б), в)

функ _о_п(вых *Список, т стр):
    список_добавь(вых, стр_склей("    ", т) как нат.верх)

# --- таблицы условий и мнемоник --------------------------------------------

функ _о_инв(ус стр) стр:
    # обратный условный переход; "" — неизвестное условие
    если стр_равны(ус, "РАВНО"):
        верни "НЕРАВНО"
    если стр_равны(ус, "НЕРАВНО"):
        верни "РАВНО"
    если стр_равны(ус, "МЕНЬШЕ"):
        верни "БОЛРАВ"
    если стр_равны(ус, "МЕНРАВ"):
        верни "БОЛЬШЕ"
    если стр_равны(ус, "БОЛЬШЕ"):
        верни "МЕНРАВ"
    если стр_равны(ус, "БОЛРАВ"):
        верни "МЕНЬШЕ"
    если стр_равны(ус, "НИЖЕ"):
        верни "НЕНИЖЕ"
    если стр_равны(ус, "НИЖРАВ"):
        верни "ВЫШЕ"
    если стр_равны(ус, "ВЫШЕ"):
        верни "НИЖРАВ"
    если стр_равны(ус, "ВЫШРАВ"):
        верни "НИЖЕ"
    верни ""

функ _о_запись(м стр) лог:
    # инструкции, где первый операнд — только приёмник (не читается)
    верни (стр_равны(м, "ПЕР") или стр_равны(м, "АДР") или
           стр_равны(м, "БЕЗРАСШ") или стр_равны(м, "БЕЗРАСШД") или
           стр_равны(м, "ЗНАКРАСШ") или стр_равны(м, "ЗНАКРАСШД"))

функ _о_коммут(м стр) лог:
    # коммутативные двухоперандные операции
    верни (стр_равны(м, "ДОБ") или стр_равны(м, "УМН") или
           стр_равны(м, "И") или стр_равны(м, "ИЛИ") или стр_равны(м, "ИИЛИ"))

функ _о_акк(о стр) лог:
    верни (стр_равны(о, "АКК") или стр_равны(о, "АККМ") или
           стр_равны(о, "АККД") или стр_равны(о, "АККБ"))

функ _о_рег64(о стр) лог:
    верни (стр_равны(о, "АКК") или стр_равны(о, "СЧТ") или стр_равны(о, "ДАН") или
           стр_равны(о, "БАЗ") или
           стр_равны(о, "УКК") или стр_равны(о, "УКС") или стр_равны(о, "ИСТ") или
           стр_равны(о, "ПРМ") или стр_равны(о, "Р8") или стр_равны(о, "Р9") или
           стр_равны(о, "Р10") или стр_равны(о, "Р11") или стр_равны(о, "Р12") или
           стр_равны(о, "Р13") или стр_равны(о, "Р14") или стр_равны(о, "Р15"))

функ _о_цель_ок(ц стр) лог:
    # цель условного перехода, которую можно переписывать: сгенерированная
    # метка «м_<функция>_<контекст>_<номер>», на входе которой АКК не несёт
    # булево значение — метки-срезки «и»/«или» читают АКК сразу после метки.
    если ц.длина < 4 или ц.данные[0] != 208 или ц.данные[1] != 188:
        верни нет
    если ц.данные[2] != 95:    # '_'
        верни нет
    верни не (стр_найди(ц, "_или_ист_") >= 0 или
              стр_найди(ц, "_и_ложь_") >= 0)

# --- разбор и сборка текста -------------------------------------------------

функ _о_разбей(текст стр) *Список:
    лини *Список = список_новый()
    нач нат.верх = 0 как нат.верх
    для поз в 0..текст.длина:
        если текст.данные[поз] == 10:
            список_добавь(лини, стр_срез(текст, нач, поз) как нат.верх)
            нач = (поз + 1) как нат.верх
    если нач < текст.длина:
        список_добавь(лини, стр_срез(текст, нач, текст.длина) как нат.верх)
    верни лини

# --- один проход переписываний ----------------------------------------------

функ _о_проход(лини *Список, изм *нат.верх) *Список:
    вых *Список = список_новый()
    n нат.верх = лини.длина
    поз нат.верх = 0 как нат.верх
    пока поз < n:
        л стр = список_получи(лини, поз) как стр
        т стр = _о_тело(л)
        если т.длина == 0:
            список_добавь(вых, л как нат.верх)
            поз += 1
            следующий
        т1 стр = _о_т(лини, поз + 1)
        т2 стр = _о_т(лини, поз + 2)
        т3 стр = _о_т(лини, поз + 3)
        т4 стр = _о_т(лини, поз + 4)

        # «не x» в условии: ПРОВ; УСТРАВНО; БЕЗРАСШ; ПРОВ; jcc -> ПРОВ; jcc'
        если (стр_равны(т, "ПРОВ АКК, АКК") и стр_равны(т1, "УСТРАВНО АККБ") и
              стр_равны(т2, "БЕЗРАСШ АКК, АККБ") и стр_равны(т3, "ПРОВ АКК, АКК") и
              (стр_начинается(т4, "РАВНО ") или стр_начинается(т4, "НЕРАВНО ")) и
              _о_цель_ок(_о_ост(т4))):
            дж стр = "НЕРАВНО"
            если стр_начинается(т4, "НЕРАВНО "):
                дж = "РАВНО"
            список_добавь(вых, л как нат.верх)
            _о_п(вых, _о_к3(дж, " ", _о_ост(т4)))
            изм[0] = 1
            поз += 5
            следующий

        # сравнение в условии: УСТcc; БЕЗРАСШ; ПРОВ; РАВНО/НЕРАВНО -> jcc
        если (стр_начинается(т, "УСТ") и _о_конч(т, " АККБ") и
              стр_равны(т1, "БЕЗРАСШ АКК, АККБ") и стр_равны(т2, "ПРОВ АКК, АКК") и
              (стр_начинается(т3, "РАВНО ") или стр_начинается(т3, "НЕРАВНО ")) и
              _о_цель_ок(_о_ост(т3))):
            cc стр = стр_срез(т, 6, т.длина - 9)
            дж = _о_инв(cc)
            если стр_начинается(т3, "НЕРАВНО "):
                если дж.длина > 0:
                    дж = cc
            если дж.длина > 0:
                _о_п(вых, _о_к3(дж, " ", _о_ост(т3)))
                изм[0] = 1
                поз += 4
                следующий

        # сэндвич бинопа: ВСТЕК АКК; ОП АКК*,X; ПЕР СЧТ,АКК; ИЗСТЕКА АКК
        #   -> ОП СЧТ*,X   (АКК держит левый операнд, стек не тронут)
        если (стр_равны(т, "ВСТЕК АКК") и стр_равны(т2, "ПЕР СЧТ, АКК") и
              стр_равны(т3, "ИЗСТЕКА АКК") и т1.длина > 0):
            мнем стр = _о_мнем(т1)
            оп1 стр = _о_оп1(т1)
            оп2 стр = _о_оп2(т1)
            если (_о_запись(мнем) и _о_акк(оп1) и оп2.длина > 0 и
                  стр_найди(т1, "УКС") < 0):
                суф стр = стр_срез(оп1, 6, оп1.длина)
                _о_п(вых, _о_к3(_о_к3(мнем, " СЧТ", суф), ", ", оп2))
                изм[0] = 1
                поз += 4
                следующий

        # сэндвич индексации: ВСТЕК АКК; ОП АКК*,X; ИЗСТЕКА СЧТ; КОММУТ АКК,СЧТ
        #   -> ОП СЧТ*,X; КОММУТ АКК,СЧТ   (коммутативность меняет порядок)
        если (стр_равны(т, "ВСТЕК АКК") и стр_равны(т2, "ИЗСТЕКА СЧТ") и
              т1.длина > 0 и т3.длина > 0):
            мнем = _о_мнем(т1)
            оп1 = _о_оп1(т1)
            оп2 = _о_оп2(т1)
            если (_о_запись(мнем) и _о_акк(оп1) и оп2.длина > 0 и
                  стр_найди(т1, "УКС") < 0 и
                  _о_коммут(_о_мнем(т3)) и стр_равны(_о_ост(т3), "АКК, СЧТ")):
                суф = стр_срез(оп1, 6, оп1.длина)
                _о_п(вых, _о_к3(_о_к3(мнем, " СЧТ", суф), ", ", оп2))
                список_добавь(вых, список_получи(лини, поз + 3))
                изм[0] = 1
                поз += 4
                следующий

        # сэндвич с выгрузкой в другой регистр (Q не АКК/СЧТ):
        #   ВСТЕК АКК; ОП АКК*,X; ПЕР СЧТ,АКК; ИЗСТЕКА Q
        #   -> ПЕР Q,АКК; ОП АКК*,X; ПЕР СЧТ,АКК   (4 -> 3, та же семантика)
        если (стр_равны(т, "ВСТЕК АКК") и стр_равны(т2, "ПЕР СЧТ, АКК") и
              стр_начинается(т3, "ИЗСТЕКА ") и т1.длина > 0):
            рп стр = _о_ост(т3)
            мнем = _о_мнем(т1)
            оп1 = _о_оп1(т1)
            оп2 = _о_оп2(т1)
            если (_о_запись(мнем) и _о_акк(оп1) и оп2.длина > 0 и
                  _о_рег64(рп) и не стр_равны(рп, "СЧТ") и
                  стр_найди(т1, "УКС") < 0):
                _о_п(вых, _о_к3("ПЕР ", рп, ", АКК"))
                список_добавь(вых, список_получи(лини, поз + 1))
                _о_п(вых, "ПЕР СЧТ, АКК")
                изм[0] = 1
                поз += 4
                следующий

        # переход на следующую метку: ПРЫГ L + (метки)*L: -> убрать ПРЫГ
        если стр_начинается(т, "ПРЫГ "):
            цель стр = _о_ост(т)
            инд2 нат.верх = поз + 1
            нашли лог = нет
            пока инд2 < n:
                м2 стр = _о_метка(список_получи(лини, инд2) как стр)
                если м2.длина == 0:
                    хватит
                если стр_равны(м2, цель):
                    нашли = да
                    хватит
                инд2 += 1
            если нашли:
                изм[0] = 1
                поз += 1
                следующий
            список_добавь(вых, л как нат.верх)
            поз += 1
            # мёртвый код после безусловного перехода до ближайшей метки
            пока поз < n и _о_т(лини, поз).длина > 0:
                изм[0] = 1
                поз += 1
            следующий

        # мёртвый код после ВОЗВРАТ/СТОП
        если стр_равны(т, "ВОЗВРАТ") или стр_равны(т, "СТОП"):
            список_добавь(вых, л как нат.верх)
            поз += 1
            пока поз < n и _о_т(лини, поз).длина > 0:
                изм[0] = 1
                поз += 1
            следующий

        # смежные ВСТЕК X / ИЗСТЕКА Y -> ПЕР Y,X (или ничего при X==Y)
        если стр_начинается(т, "ВСТЕК ") и стр_начинается(т1, "ИЗСТЕКА "):
            рв стр = _о_ост(т)
            рп = _о_ост(т1)
            изм[0] = 1
            если не стр_равны(рв, рп):
                _о_п(вых, _о_к3("ПЕР ", _о_к3(рп, ", ", рв), ""))
            поз += 2
            следующий

        # ПЕР Q,... / ИЗСТЕКА Q — запись затёрта снятием со стека
        если стр_начинается(т, "ПЕР ") и стр_начинается(т1, "ИЗСТЕКА "):
            если стр_равны(_о_оп1(т), _о_ост(т1)):
                список_добавь(вых, список_получи(лини, поз + 1))
                изм[0] = 1
                поз += 2
                следующий

        # ПЕР-пары
        если стр_начинается(т, "ПЕР ") и стр_начинается(т1, "ПЕР "):
            оп1 = _о_оп1(т)
            оп2 = _о_оп2(т)
            п1 стр = _о_оп1(т1)
            п2 стр = _о_оп2(т1)
            если (оп2.длина > 0 и п2.длина > 0):
                # ПЕР X,X — холостой ход (только 64-битные: ПЕР АККМ,АККМ
                # зануляет старшие разряды и не является no-op)
                если (стр_равны(оп1, оп2) и
                    (_о_рег64(оп1) или стр_найди(оп1, "[") >= 0)):
                    изм[0] = 1
                    поз += 1
                    следующий
                # ПЕР A,B; ПЕР B,A — вторая пустая, если B не ссылается на A
                если (стр_равны(оп1, п2) и стр_равны(оп2, п1) и
                      стр_найди(оп2, оп1) < 0):
                    список_добавь(вых, л как нат.верх)
                    изм[0] = 1
                    поз += 2
                    следующий
                # две одинаковые загрузки — вторая пустая, если источник
                # не зависит от приёмника (ПЕР АКК,[АКК] — разыменование!)
                если стр_равны(т, т1) и стр_найди(оп2, оп1) < 0:
                    список_добавь(вых, л как нат.верх)
                    изм[0] = 1
                    поз += 2
                    следующий
                # ПЕР R1,[X]; ПЕР R2,[X] -> ПЕР R1,[X]; ПЕР R2,R1
                если (стр_равны(оп2, п2) и стр_найди(оп2, "[") >= 0 и
                      _о_рег64(оп1) и _о_рег64(п1) и стр_найди(оп2, оп1) < 0):
                    список_добавь(вых, л как нат.верх)
                    _о_п(вых, _о_к3("ПЕР ", _о_к3(п1, ", ", оп1), ""))
                    изм[0] = 1
                    поз += 2
                    следующий

        список_добавь(вых, л как нат.верх)
        поз += 1
    верни вых

# --- драйвер: проходы до стабилизации ---------------------------------------

функ опт_код(текст стр) стр:
    лини *Список = _о_разбей(текст)
    флаг *нат.верх = выдели(8) как *нат.верх
    флаг[0] = 1
    проходов нат.верх = 0 как нат.верх
    пока флаг[0] != 0 и проходов < 16:
        флаг[0] = 0
        лини = _о_проход(лини, флаг)
        проходов += 1
    б *Буфер = буф_новый()
    для инд в 0..лини.длина:
        буф_добавь(б, список_получи(лини, инд) как стр)
        буф_сим(б, 10)
    верни буф_стр(б)
