# опт — peephole-оптимизатор текста ИСКРЫ.
# Работает построчно над сгенерированным кодом: сэндвичи ВСТЕК/ИЗСТЕКА
# вокруг одного вычисления, свёртка УСТ*/БЕЗРАСШ/ПРОВ/переход в один jcc,
# лишние ПЕР-пары, переходы на следующую метку и мёртвый код.
# Все правила сохраняют семантику; метки и не-инструкции — барьеры окон.

взять основа

# --- строковые помощники --------------------------------------------------

функ _о_тело(линия стр) стр:
    # тело инструкции без отступа; "" — метка/директива/пустая строка
    если линия.длина > 4 и стр_начинается(линия, "    "):
        тело стр = стр_срез(линия, 4, линия.длина)
        если тело.данные[тело.длина - 1] != 58:
            верни тело
    верни ""

функ _о_т(линии *Список, инд размер) стр:
    если инд >= линии.длина:
        верни ""
    верни _о_тело(список_получи(линии, инд) как стр)

функ _о_метка(линия стр) стр:
    # имя метки (строка вида «имя:» с отступом или без); "" — не метка
    тело стр = линия
    если стр_начинается(линия, "    "):
        тело = стр_срез(линия, 4, линия.длина)
    если тело.длина > 0 и тело.данные[тело.длина - 1] == 58:
        верни стр_срез(тело, 0, тело.длина - 1)
    верни ""

функ _о_мнем(тело стр) стр:
    поз смещение = стр_найди(тело, " ")
    если поз < 0:
        верни тело
    верни стр_срез(тело, 0, поз как размер)

функ _о_ост(тело стр) стр:
    поз смещение = стр_найди(тело, " ")
    если поз < 0:
        верни ""
    верни стр_срез(тело, (поз + 1) как размер, тело.длина)

функ _о_оп1(тело стр) стр:
    ост стр = _о_ост(тело)
    поз смещение = стр_найди(ост, ", ")
    если поз < 0:
        верни ост
    верни стр_срез(ост, 0, поз как размер)

функ _о_оп2(тело стр) стр:
    ост стр = _о_ост(тело)
    поз смещение = стр_найди(ост, ", ")
    если поз < 0:
        верни ""
    верни стр_срез(ост, (поз + 2) как размер, ост.длина)

функ _о_конч(строка стр, хвост стр) лог:
    если строка.длина < хвост.длина:
        верни нет
    верни стр_равны(стр_срез(строка, строка.длина - хвост.длина, строка.длина), хвост)

функ _о_к3(стр1 стр, стр2 стр, стр3 стр) стр:
    верни стр_склей(стр_склей(стр1, стр2), стр3)

функ _о_п(вых *Список, тело стр):
    список_добавь(вых, стр_склей("    ", тело) как размер)

# --- таблицы условий и мнемоник --------------------------------------------

функ _о_инв(усл стр) стр:
    # обратный условный переход; "" — неизвестное условие
    если стр_равны(усл, "РАВНО"):
        верни "НЕРАВНО"
    если стр_равны(усл, "НЕРАВНО"):
        верни "РАВНО"
    если стр_равны(усл, "МЕНЬШЕ"):
        верни "БОЛРАВ"
    если стр_равны(усл, "МЕНРАВ"):
        верни "БОЛЬШЕ"
    если стр_равны(усл, "БОЛЬШЕ"):
        верни "МЕНРАВ"
    если стр_равны(усл, "БОЛРАВ"):
        верни "МЕНЬШЕ"
    если стр_равны(усл, "НИЖЕ"):
        верни "НЕНИЖЕ"
    если стр_равны(усл, "НИЖРАВ"):
        верни "ВЫШЕ"
    если стр_равны(усл, "ВЫШЕ"):
        верни "НИЖРАВ"
    если стр_равны(усл, "ВЫШРАВ"):
        верни "НИЖЕ"
    верни ""

функ _о_запись(мнем стр) лог:
    # инструкции, где первый операнд — только приёмник (не читается)
    верни (стр_равны(мнем, "ПЕР") или стр_равны(мнем, "АДР") или
           стр_равны(мнем, "БЕЗРАСШ") или стр_равны(мнем, "БЕЗРАСШД") или
           стр_равны(мнем, "ЗНАКРАСШ") или стр_равны(мнем, "ЗНАКРАСШД"))

функ _о_коммут(мнем стр) лог:
    # коммутативные двухоперандные операции
    верни (стр_равны(мнем, "ДОБ") или стр_равны(мнем, "УМН") или
           стр_равны(мнем, "И") или стр_равны(мнем, "ИЛИ") или стр_равны(мнем, "ИИЛИ"))

функ _о_акк(опер стр) лог:
    верни (стр_равны(опер, "АКК") или стр_равны(опер, "АККМ") или
           стр_равны(опер, "АККД") или стр_равны(опер, "АККБ"))

функ _о_рег64(опер стр) лог:
    верни (стр_равны(опер, "АКК") или стр_равны(опер, "СЧТ") или стр_равны(опер, "ДАН") или
           стр_равны(опер, "БАЗ") или
           стр_равны(опер, "УКК") или стр_равны(опер, "УКС") или стр_равны(опер, "ИСТ") или
           стр_равны(опер, "ПРМ") или стр_равны(опер, "Р8") или стр_равны(опер, "Р9") или
           стр_равны(опер, "Р10") или стр_равны(опер, "Р11") или стр_равны(опер, "Р12") или
           стр_равны(опер, "Р13") или стр_равны(опер, "Р14") или стр_равны(опер, "Р15"))

функ _о_цель_ок(метка стр) лог:
    # цель условного перехода, которую можно переписывать: сгенерированная
    # метка «м_<функция>_<контекст>_<номер>», на входе которой АКК не несёт
    # булево значение — метки-срезки «и»/«или» читают АКК сразу после метки.
    если метка.длина < 4 или метка.данные[0] != 208 или метка.данные[1] != 188:
        верни нет
    если метка.данные[2] != 95:    # '_'
        верни нет
    верни не (стр_найди(метка, "_или_ист_") >= 0 или
              стр_найди(метка, "_и_ложь_") >= 0)

# --- разбор и сборка текста -------------------------------------------------

функ _о_разбей(текст стр) *Список:
    линии *Список = список_новый()
    нач размер = 0 как размер
    для поз в 0..текст.длина:
        если текст.данные[поз] == 10:
            список_добавь(линии, стр_срез(текст, нач, поз) как размер)
            нач = (поз + 1) как размер
    если нач < текст.длина:
        список_добавь(линии, стр_срез(текст, нач, текст.длина) как размер)
    верни линии

# --- один проход переписываний ----------------------------------------------

функ _о_проход(линии *Список, изм *нат.верх) *Список:
    вых *Список = список_новый()
    всего размер = линии.длина
    поз размер = 0 как размер
    пока поз < всего:
        линия стр = список_получи(линии, поз) как стр
        тело стр = _о_тело(линия)
        если тело.длина == 0:
            список_добавь(вых, линия как размер)
            поз += 1
            следующий
        тело1 стр = _о_т(линии, поз + 1)
        тело2 стр = _о_т(линии, поз + 2)
        тело3 стр = _о_т(линии, поз + 3)
        тело4 стр = _о_т(линии, поз + 4)

        # «не x» в условии: ПРОВ; УСТРАВНО; БЕЗРАСШ; ПРОВ; jcc -> ПРОВ; jcc'
        если (стр_равны(тело, "ПРОВ АКК, АКК") и стр_равны(тело1, "УСТРАВНО АККБ") и
              стр_равны(тело2, "БЕЗРАСШ АКК, АККБ") и стр_равны(тело3, "ПРОВ АКК, АКК") и
              (стр_начинается(тело4, "РАВНО ") или стр_начинается(тело4, "НЕРАВНО ")) и
              _о_цель_ок(_о_ост(тело4))):
            усл стр = "НЕРАВНО"
            если стр_начинается(тело4, "НЕРАВНО "):
                усл = "РАВНО"
            список_добавь(вых, линия как размер)
            _о_п(вых, _о_к3(усл, " ", _о_ост(тело4)))
            изм[0] = 1
            поз += 5
            следующий

        # сравнение в условии: УСТcc; БЕЗРАСШ; ПРОВ; РАВНО/НЕРАВНО -> jcc
        если (стр_начинается(тело, "УСТ") и _о_конч(тело, " АККБ") и
              стр_равны(тело1, "БЕЗРАСШ АКК, АККБ") и стр_равны(тело2, "ПРОВ АКК, АКК") и
              (стр_начинается(тело3, "РАВНО ") или стр_начинается(тело3, "НЕРАВНО ")) и
              _о_цель_ок(_о_ост(тело3))):
            код_усл стр = стр_срез(тело, 6, тело.длина - 9)
            усл = _о_инв(код_усл)
            если стр_начинается(тело3, "НЕРАВНО "):
                если усл.длина > 0:
                    усл = код_усл
            если усл.длина > 0:
                _о_п(вых, _о_к3(усл, " ", _о_ост(тело3)))
                изм[0] = 1
                поз += 4
                следующий

        # сэндвич бинопа: ВСТЕК АКК; ОП АКК*,X; ПЕР СЧТ,АКК; ИЗСТЕКА АКК
        #   -> ОП СЧТ*,X   (АКК держит левый операнд, стек не тронут)
        если (стр_равны(тело, "ВСТЕК АКК") и стр_равны(тело2, "ПЕР СЧТ, АКК") и
              стр_равны(тело3, "ИЗСТЕКА АКК") и тело1.длина > 0):
            мнем стр = _о_мнем(тело1)
            оп1 стр = _о_оп1(тело1)
            оп2 стр = _о_оп2(тело1)
            если (_о_запись(мнем) и _о_акк(оп1) и оп2.длина > 0 и
                  стр_найди(тело1, "УКС") < 0):
                суф стр = стр_срез(оп1, 6, оп1.длина)
                _о_п(вых, _о_к3(_о_к3(мнем, " СЧТ", суф), ", ", оп2))
                изм[0] = 1
                поз += 4
                следующий

        # сэндвич индексации: ВСТЕК АКК; ОП АКК*,X; ИЗСТЕКА СЧТ; КОММУТ АКК,СЧТ
        #   -> ОП СЧТ*,X; КОММУТ АКК,СЧТ   (коммутативность меняет порядок)
        если (стр_равны(тело, "ВСТЕК АКК") и стр_равны(тело2, "ИЗСТЕКА СЧТ") и
              тело1.длина > 0 и тело3.длина > 0):
            мнем = _о_мнем(тело1)
            оп1 = _о_оп1(тело1)
            оп2 = _о_оп2(тело1)
            если (_о_запись(мнем) и _о_акк(оп1) и оп2.длина > 0 и
                  стр_найди(тело1, "УКС") < 0 и
                  _о_коммут(_о_мнем(тело3)) и стр_равны(_о_ост(тело3), "АКК, СЧТ")):
                суф = стр_срез(оп1, 6, оп1.длина)
                _о_п(вых, _о_к3(_о_к3(мнем, " СЧТ", суф), ", ", оп2))
                список_добавь(вых, список_получи(линии, поз + 3))
                изм[0] = 1
                поз += 4
                следующий

        # сэндвич с выгрузкой в другой регистр (Q не АКК/СЧТ):
        #   ВСТЕК АКК; ОП АКК*,X; ПЕР СЧТ,АКК; ИЗСТЕКА Q
        #   -> ПЕР Q,АКК; ОП АКК*,X; ПЕР СЧТ,АКК   (4 -> 3, та же семантика)
        если (стр_равны(тело, "ВСТЕК АКК") и стр_равны(тело2, "ПЕР СЧТ, АКК") и
              стр_начинается(тело3, "ИЗСТЕКА ") и тело1.длина > 0):
            рег_изс стр = _о_ост(тело3)
            мнем = _о_мнем(тело1)
            оп1 = _о_оп1(тело1)
            оп2 = _о_оп2(тело1)
            если (_о_запись(мнем) и _о_акк(оп1) и оп2.длина > 0 и
                  _о_рег64(рег_изс) и не стр_равны(рег_изс, "СЧТ") и
                  стр_найди(тело1, "УКС") < 0):
                _о_п(вых, _о_к3("ПЕР ", рег_изс, ", АКК"))
                список_добавь(вых, список_получи(линии, поз + 1))
                _о_п(вых, "ПЕР СЧТ, АКК")
                изм[0] = 1
                поз += 4
                следующий

        # переход на следующую метку: ПРЫГ L + (метки)*L: -> убрать ПРЫГ
        если стр_начинается(тело, "ПРЫГ "):
            цель стр = _о_ост(тело)
            инд2 размер = поз + 1
            нашли лог = нет
            пока инд2 < всего:
                метка стр = _о_метка(список_получи(линии, инд2) как стр)
                если метка.длина == 0:
                    хватит
                если стр_равны(метка, цель):
                    нашли = да
                    хватит
                инд2 += 1
            если нашли:
                изм[0] = 1
                поз += 1
                следующий
            список_добавь(вых, линия как размер)
            поз += 1
            # мёртвый код после безусловного перехода до ближайшей метки
            пока поз < всего и _о_т(линии, поз).длина > 0:
                изм[0] = 1
                поз += 1
            следующий

        # мёртвый код после ВОЗВРАТ/СТОП
        если стр_равны(тело, "ВОЗВРАТ") или стр_равны(тело, "СТОП"):
            список_добавь(вых, линия как размер)
            поз += 1
            пока поз < всего и _о_т(линии, поз).длина > 0:
                изм[0] = 1
                поз += 1
            следующий

        # смежные ВСТЕК X / ИЗСТЕКА Y -> ПЕР Y,X (или ничего при X==Y)
        если стр_начинается(тело, "ВСТЕК ") и стр_начинается(тело1, "ИЗСТЕКА "):
            рег_вс стр = _о_ост(тело)
            рег_изс = _о_ост(тело1)
            изм[0] = 1
            если не стр_равны(рег_вс, рег_изс):
                _о_п(вых, _о_к3("ПЕР ", _о_к3(рег_изс, ", ", рег_вс), ""))
            поз += 2
            следующий

        # ПЕР Q,... / ИЗСТЕКА Q — запись затёрта снятием со стека
        если стр_начинается(тело, "ПЕР ") и стр_начинается(тело1, "ИЗСТЕКА "):
            если стр_равны(_о_оп1(тело), _о_ост(тело1)):
                список_добавь(вых, список_получи(линии, поз + 1))
                изм[0] = 1
                поз += 2
                следующий

        # ПЕР-пары
        если стр_начинается(тело, "ПЕР ") и стр_начинается(тело1, "ПЕР "):
            оп1 = _о_оп1(тело)
            оп2 = _о_оп2(тело)
            опн1 стр = _о_оп1(тело1)
            опн2 стр = _о_оп2(тело1)
            если (оп2.длина > 0 и опн2.длина > 0):
                # ПЕР X,X — холостой ход (только 64-битные: ПЕР АККМ,АККМ
                # зануляет старшие разряды и не является no-op)
                если (стр_равны(оп1, оп2) и
                    (_о_рег64(оп1) или стр_найди(оп1, "[") >= 0)):
                    изм[0] = 1
                    поз += 1
                    следующий
                # ПЕР A,B; ПЕР B,A — вторая пустая, если B не ссылается на A
                если (стр_равны(оп1, опн2) и стр_равны(оп2, опн1) и
                      стр_найди(оп2, оп1) < 0):
                    список_добавь(вых, линия как размер)
                    изм[0] = 1
                    поз += 2
                    следующий
                # две одинаковые загрузки — вторая пустая, если источник
                # не зависит от приёмника (ПЕР АКК,[АКК] — разыменование!)
                если стр_равны(тело, тело1) и стр_найди(оп2, оп1) < 0:
                    список_добавь(вых, линия как размер)
                    изм[0] = 1
                    поз += 2
                    следующий
                # ПЕР R1,[X]; ПЕР R2,[X] -> ПЕР R1,[X]; ПЕР R2,R1
                если (стр_равны(оп2, опн2) и стр_найди(оп2, "[") >= 0 и
                      _о_рег64(оп1) и _о_рег64(опн1) и стр_найди(оп2, оп1) < 0):
                    список_добавь(вых, линия как размер)
                    _о_п(вых, _о_к3("ПЕР ", _о_к3(опн1, ", ", оп1), ""))
                    изм[0] = 1
                    поз += 2
                    следующий

        список_добавь(вых, линия как размер)
        поз += 1
    верни вых

# --- драйвер: проходы до стабилизации ---------------------------------------

функ опт_код(текст стр) стр:
    линии *Список = _о_разбей(текст)
    флаг *нат.верх = выдели(8) как *нат.верх
    флаг[0] = 1
    проходов размер = 0 как размер
    пока флаг[0] != 0 и проходов < 16:
        флаг[0] = 0
        линии = _о_проход(линии, флаг)
        проходов += 1
    буф *Буфер = буф_новый()
    для инд в 0..линии.длина:
        буф_добавь(буф, список_получи(линии, инд) как стр)
        буф_сим(буф, 10)
    верни буф_стр(буф)
