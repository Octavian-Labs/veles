# загрузчик — рекурсивное разрешение «взять имя».
# Порядок поиска модуля «имя»:
#   <каталог>/имя.<цель>.раз
#   <каталог>/имя.раз
#   <каталог>/биб/имя.<цель>.раз
#   <каталог>/биб/имя.раз
#   <каталог>/../биб/имя.<цель>.раз
#   <каталог>/../биб/имя.раз
#   («lib» вместо «биб» — устаревший запасной путь перехода)
# Каждый файл разбирается один раз; циклические импорты отсекаются по пути.

взять основа
взять лексер, узлы, парсер

запись Загр:
    seen *Список        # стр — уже подключённые пути
    decls *Список       # *Узел — объявления в порядке обхода
    модули *Список      # стр — точечные пути «взять» в порядке обхода
    суф стр             # "windows" | "linux"

функ загр_новый(суф стр) *Загр:
    з *Загр = новый(Загр)
    з.seen = список_новый()
    з.decls = список_новый()
    з.модули = список_новый()
    з.суф = суф
    верни з

функ _путь(каталог стр, имя стр) стр:
    верни стр_склей(стр_склей(каталог, "/"), имя)

функ _путь_модуля(имя стр) стр:
    # точечный путь «сист.файл» -> файловый «сист/файл»
    р *нат.старт = выдели(имя.длина)
    для i в 0..имя.длина:
        б := имя.данные[i]
        если б == '.':
            б = '/'
        р[i] = б
    верни стр_собери(р, имя.длина)

функ _файл_есть(путь стр) лог:
    верни файл_прочти(путь) != пусто

функ _норм_путь(путь стр) стр:
    # «a/b/../c» -> «a/c»: сегменты «.» и «..» раскрываются в строке пути,
    # чтобы один и тот же файл не грузился дважды через разные записи пути
    сеги := список_новый()
    нач := 0 как нат.верх
    i нат.верх = 0
    пока i <= путь.длина:
        если i == путь.длина или путь.данные[i] == '/':
            сег := стр_срез(путь, нач, i)
            если стр_равны(сег, ".."):
                если сеги.длина > 0:
                    верх := список_получи(сеги, сеги.длина - 1) как стр
                    если не стр_равны(верх, ".."):
                        сеги.длина = сеги.длина - 1
                    иначе:
                        список_добавь(сеги, сег как нат.верх)
                иначе:
                    список_добавь(сеги, сег как нат.верх)
            а если не стр_равны(сег, ".") и сег.длина > 0:
                список_добавь(сеги, сег как нат.верх)
            нач = i + 1
        i += 1
    р := ""
    для j в 0..сеги.длина:
        если j > 0:
            р = стр_склей(р, "/")
        р = стр_склей(р, список_получи(сеги, j) как стр)
    верни р

функ (з *Загр) найди_модуль(имя стр, каталог стр) стр:
    # возвращает реальный путь найденного файла; не найден — ошибка
    путь_имя := _путь_модуля(имя)
    базы *Список = список_новый()
    список_добавь(базы, каталог как нат.верх)
    список_добавь(базы, _путь(каталог, "биб") как нат.верх)
    список_добавь(базы, _путь(каталог, "..") как нат.верх)
    список_добавь(базы, _путь(каталог, "../биб") как нат.верх)
    # переходный период: устаревшее имя каталога стдлиба
    список_добавь(базы, _путь(каталог, "lib") как нат.верх)
    список_добавь(базы, _путь(каталог, "../lib") как нат.верх)
    для i в 0..базы.длина:
        б := список_получи(базы, i) как стр
        п1 := _путь(б, стр_склей(стр_склей(путь_имя, "."),
                               стр_склей(з.суф, ".раз")))
        если _файл_есть(п1):
            верни п1
        п2 := _путь(б, стр_склей(путь_имя, ".раз"))
        если _файл_есть(п2):
            верни п2
    печать("разум: взять ")
    печатьстр(имя)
    печать(" — модуль не найден\n")
    выход(1)
    верни пусто как стр

функ _seen_есть(seen *Список, путь стр) лог:
    для i в 0..seen.длина:
        если стр_равны(список_получи(seen, i) как стр, путь):
            верни да
    верни нет

функ _каталог(путь стр) стр:
    # каталог файла: всё до последнего '/' или '\'; нет — «.»
    i := (путь.длина как цел.верх) - 1
    пока i >= 0:
        c := путь.данные[i как нат.верх]
        если c == '/' или c == '\\':
            верни стр_срез(путь, 0, i как нат.верх)
        i -= 1
    верни "."

функ (з *Загр) обход(путь стр, исх стр):
    # seen — по нормализованному пути; чтение и каталог — по реальному
    ключ := _норм_путь(путь)
    если _seen_есть(з.seen, ключ):
        верни
    список_добавь(з.seen, ключ как нат.верх)
    прог := разбери(исх)
    кат := _каталог(путь)
    для i в 0..прог.дети.длина:
        d := список_получи(прог.дети, i) как *Узел
        если d.вид == У_ВЗЯТЬ:
            для j в 0..d.дети.длина:
                м := список_получи(d.дети, j) как *Узел
                список_добавь(з.модули, м.текст как нат.верх)
                путь_м := з.найди_модуль(м.текст, кат)
                исх_м := файл_прочти(путь_м)
                з.обход(путь_м, исх_м)
        иначе:
            список_добавь(з.decls, d как нат.верх)

функ (з *Загр) загрузи_текст(путь стр, исх стр) *Узел:
    # точка входа: виртуальный путь + готовый текст (например, stdin)
    з.обход(путь, исх)
    прог := узел(У_ПРОГ, 0)
    прог.дети = з.decls
    прог.дети2 = з.модули     # стр — пути «взять» для резолвера ген
    верни прог
