# загрузчик — рекурсивное разрешение «взять имя».
# Порядок поиска модуля «имя»:
#   <каталог>/имя.<цель>.раз
#   <каталог>/имя.раз
#   <каталог>/биб/имя.<цель>.раз
#   <каталог>/биб/имя.раз
#   <каталог>/../биб/имя.<цель>.раз
#   <каталог>/../биб/имя.раз
#   («lib» вместо «биб» — устаревший запасной путь перехода)
# Каждый файл разбирается один раз; циклические импорты отсекаются по пути.

взять основа
взять лексер, узлы, парсер, кэш

открыто запись Загр:
    взято *Список       # стр — уже подключённые пути
    объявы *Список      # *Узел — объявления в порядке обхода
    модули *Список      # стр — точечные пути «взять» в порядке обхода
    суффикс стр         # "windows" | "linux" | "macos"
    кэш лог             # читать/писать интерфейсный кэш .рми
    режим нат.верх      # ось безопасности — часть ключа кэша
    память нат.верх     # ось памяти — часть ключа кэша
    опт нат.верх        # уровень оптимизации — часть ключа кэша
    корень стр          # норм-путь корневого модуля — не кэшируется
    хеши *Список        # КХеш — норм-путь → хеш источника
    зависим *Список     # КЗавис — реестр зависимостей модулей

открыто функ загр_новый(суффикс стр, кэш лог, режим нат.верх, пам нат.верх,
        опт нат.верх) *Загр:
    загр *Загр = новый(Загр)
    загр.взято = список_новый()
    загр.объявы = список_новый()
    загр.модули = список_новый()
    загр.суффикс = суффикс
    загр.кэш = кэш
    загр.режим = режим
    загр.память = пам
    загр.опт = опт
    загр.корень = ""
    загр.хеши = список_новый()
    загр.зависим = список_новый()
    верни загр

открыто функ _путь(каталог стр, имя стр) стр:
    верни стр_склей(стр_склей(каталог, "/"), имя)

открыто функ _путь_модуля(имя стр) стр:
    # точечный путь «сист.файл» -> файловый «сист/файл»
    буф *нат.старт = выдели(имя.длина)
    для поз в 0..имя.длина:
        зн нат.старт = имя.данные[поз]
        если зн == '.':
            зн = '/'
        буф[поз] = зн
    верни стр_собери(буф, имя.длина)

открыто функ _файл_есть(путь стр) лог:
    верни файл_прочти(путь) != пусто

открыто функ _норм_путь(путь стр) стр:
    # «а/б/../в» -> «а/в»: сегменты «.» и «..» раскрываются в строке пути,
    # чтобы один и тот же файл не грузился дважды через разные записи пути
    сеги *Список = список_новый()
    нач размер = 0 как размер
    поз размер = 0
    пока поз <= путь.длина:
        если поз == путь.длина или путь.данные[поз] == '/':
            сег стр = стр_срез(путь, нач, поз)
            если стр_равны(сег, ".."):
                если сеги.длина > 0:
                    верх стр = список_получи(сеги, сеги.длина - 1) как стр
                    если не стр_равны(верх, ".."):
                        сеги.длина = сеги.длина - 1
                    иначе:
                        список_добавь(сеги, сег как размер)
                иначе:
                    список_добавь(сеги, сег как размер)
            а если не стр_равны(сег, ".") и сег.длина > 0:
                список_добавь(сеги, сег как размер)
            нач = поз + 1
        поз += 1
    итог стр = ""
    для инд2 в 0..сеги.длина:
        если инд2 > 0:
            итог = стр_склей(итог, "/")
        итог = стр_склей(итог, список_получи(сеги, инд2) как стр)
    верни итог

открыто функ (загр *Загр) найди_модуль(имя стр, каталог стр) стр:
    # возвращает реальный путь найденного файла; не найден — ошибка
    путь_имя стр = _путь_модуля(имя)
    базы *Список = список_новый()
    список_добавь(базы, каталог как размер)
    список_добавь(базы, _путь(каталог, "биб") как размер)
    список_добавь(базы, _путь(каталог, "..") как размер)
    список_добавь(базы, _путь(каталог, "../биб") как размер)
    # переходный период: устаревшее имя каталога стдлиба
    список_добавь(базы, _путь(каталог, "lib") как размер)
    список_добавь(базы, _путь(каталог, "../lib") как размер)
    для инд в 0..базы.длина:
        база стр = список_получи(базы, инд) как стр
        п1 стр = _путь(база, стр_склей(стр_склей(путь_имя, "."),
                               стр_склей(загр.суффикс, ".раз")))
        если _файл_есть(п1):
            верни п1
        п2 стр = _путь(база, стр_склей(путь_имя, ".раз"))
        если _файл_есть(п2):
            верни п2
    печать("разум: взять ")
    печатьстр(имя)
    печать(" — модуль не найден\n")
    выход(1)
    верни пусто как стр

открыто функ _взято_ли(взято *Список, путь стр) лог:
    для инд в 0..взято.длина:
        если стр_равны(список_получи(взято, инд) как стр, путь):
            верни да
    верни нет

открыто функ _каталог(путь стр) стр:
    # каталог файла: всё до последнего '/' или '\'; нет — «.»
    поз смещение = (путь.длина как смещение) - 1
    пока поз >= 0:
        зн нат.старт = путь.данные[поз как размер]
        если зн == '/' или зн == '\\':
            верни стр_срез(путь, 0, поз как размер)
        поз -= 1
    верни "."

открыто функ _хеш_мода(хеши *Список, мод стр) нат.верх:
    для инд в 0..хеши.длина:
        кх *КХеш = список_получи(хеши, инд) как *КХеш
        если стр_равны(кх.мод, мод):
            верни кх.хеш
    верни 0

открыто функ _без_возврата(исх стр) стр:
    # канонизация переводов строк: байт 13 удаляется, \r\n → \n.
    # Иначе CRLF-чекаут Windows протекает в вывод через искра-блоки
    # (там исходный текст копируется побайтно) и ломает фикс-точку:
    # первое поколение читает .раз с \r\n, второе — .рми с \n.
    буф *нат.старт = выдели(исх.длина)
    вых размер = 0
    для поз в 0..исх.длина:
        б нат.старт = исх.данные[поз]
        если б != 13:
            буф[вых] = б
            вых += 1
    верни стр_собери(буф, вых)

открыто функ (загр *Загр) обход(путь стр, исх стр):
    # взято — по нормализованному пути; чтение и каталог — по реальному
    ключ стр = _норм_путь(путь)
    если _взято_ли(загр.взято, ключ):
        верни
    список_добавь(загр.взято, ключ как размер)
    кх *КХеш = новый(КХеш)
    кх.мод = ключ
    кх.хеш = хеш_текста(исх)     # хеш файла как есть — для сверки кэша
    список_добавь(загр.хеши, кх как размер)
    исх = _без_возврата(исх)     # для разбора — канонические \n
    кат стр = _каталог(путь)
    # интерфейсный кэш: действителен — объявления и код приходят из .рми
    если загр.кэш и не стр_равны(ключ, загр.корень):
        км *КэшМодуль = рми_прочти(рми_путь(ключ, загр.суффикс), ключ,
            загр.суффикс, загр.режим, загр.память, загр.опт, кх.хеш)
        если км != пусто:
            ок лог = да
            для инд3 в 0..км.зависим.длина:
                зав *КЗавис = список_получи(км.зависим, инд3) как *КЗавис
                исх_д стр = файл_прочти(зав.путь)
                если исх_д == пусто или хеш_текста(исх_д) != зав.хеш:
                    ок = нет
                    хватит
                список_добавь(загр.модули, зав.имя как размер)
                зав.владелец = ключ
                список_добавь(загр.зависим, зав как размер)
                загр.обход(зав.путь, исх_д)
            если ок:
                маркер *Узел = узел(У_РМИ, 0)
                маркер.мод = ключ
                маркер.знач = км как нат.верх
                список_добавь(загр.объявы, маркер как размер)
                верни
            # кэш недействителен — обычный разбор источника
    прог *Узел = разбери_ф(исх, путь)
    для инд в 0..прог.дети.длина:
        объяв *Узел = список_получи(прог.дети, инд) как *Узел
        если объяв.вид == У_ВЗЯТЬ:
            для инд2 в 0..объяв.дети.длина:
                мод *Узел = список_получи(объяв.дети, инд2) как *Узел
                список_добавь(загр.модули, мод.текст как размер)
                путь_м стр = загр.найди_модуль(мод.текст, кат)
                исх_м стр = файл_прочти(путь_м)
                загр.обход(путь_м, исх_м)
                зав = новый(КЗавис)
                зав.владелец = ключ
                зав.имя = мод.текст
                зав.путь = _норм_путь(путь_м)
                зав.хеш = _хеш_мода(загр.хеши, зав.путь)
                список_добавь(загр.зависим, зав как размер)
        иначе:
            объяв.мод = ключ
            список_добавь(загр.объявы, объяв как размер)

открыто функ (загр *Загр) загрузи_текст(путь стр, исх стр) *Узел:
    # точка входа: виртуальный путь + готовый текст (например, stdin)
    загр.корень = _норм_путь(путь)
    загр.обход(путь, исх)
    прог *Узел = узел(У_ПРОГ, 0)
    прог.дети = загр.объявы
    прог.дети2 = загр.модули     # стр — пути «взять» для резолвера ген
    верни прог
