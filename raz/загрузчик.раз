# загрузчик — рекурсивное разрешение «взять имя».
# Порядок поиска модуля «имя»:
#   <каталог>/имя.<цель>.раз
#   <каталог>/имя.раз
#   <каталог>/биб/имя.<цель>.раз
#   <каталог>/биб/имя.раз
#   <каталог>/../биб/имя.<цель>.раз
#   <каталог>/../биб/имя.раз
#   («lib» вместо «биб» — устаревший запасной путь перехода)
# Каждый файл разбирается один раз; циклические импорты отсекаются по пути.

взять основа
взять лексер, узлы, парсер

запись Загр:
    взято *Список       # стр — уже подключённые пути
    объявы *Список      # *Узел — объявления в порядке обхода
    модули *Список      # стр — точечные пути «взять» в порядке обхода
    суффикс стр         # "windows" | "linux" | "macos"

функ загр_новый(суффикс стр) *Загр:
    загр *Загр = новый(Загр)
    загр.взято = список_новый()
    загр.объявы = список_новый()
    загр.модули = список_новый()
    загр.суффикс = суффикс
    верни загр

функ _путь(каталог стр, имя стр) стр:
    верни стр_склей(стр_склей(каталог, "/"), имя)

функ _путь_модуля(имя стр) стр:
    # точечный путь «сист.файл» -> файловый «сист/файл»
    буф *нат.старт = выдели(имя.длина)
    для поз в 0..имя.длина:
        зн нат.старт = имя.данные[поз]
        если зн == '.':
            зн = '/'
        буф[поз] = зн
    верни стр_собери(буф, имя.длина)

функ _файл_есть(путь стр) лог:
    верни файл_прочти(путь) != пусто

функ _норм_путь(путь стр) стр:
    # «а/б/../в» -> «а/в»: сегменты «.» и «..» раскрываются в строке пути,
    # чтобы один и тот же файл не грузился дважды через разные записи пути
    сеги *Список = список_новый()
    нач размер = 0 как размер
    поз размер = 0
    пока поз <= путь.длина:
        если поз == путь.длина или путь.данные[поз] == '/':
            сег стр = стр_срез(путь, нач, поз)
            если стр_равны(сег, ".."):
                если сеги.длина > 0:
                    верх стр = список_получи(сеги, сеги.длина - 1) как стр
                    если не стр_равны(верх, ".."):
                        сеги.длина = сеги.длина - 1
                    иначе:
                        список_добавь(сеги, сег как размер)
                иначе:
                    список_добавь(сеги, сег как размер)
            а если не стр_равны(сег, ".") и сег.длина > 0:
                список_добавь(сеги, сег как размер)
            нач = поз + 1
        поз += 1
    итог стр = ""
    для инд2 в 0..сеги.длина:
        если инд2 > 0:
            итог = стр_склей(итог, "/")
        итог = стр_склей(итог, список_получи(сеги, инд2) как стр)
    верни итог

функ (загр *Загр) найди_модуль(имя стр, каталог стр) стр:
    # возвращает реальный путь найденного файла; не найден — ошибка
    путь_имя стр = _путь_модуля(имя)
    базы *Список = список_новый()
    список_добавь(базы, каталог как размер)
    список_добавь(базы, _путь(каталог, "биб") как размер)
    список_добавь(базы, _путь(каталог, "..") как размер)
    список_добавь(базы, _путь(каталог, "../биб") как размер)
    # переходный период: устаревшее имя каталога стдлиба
    список_добавь(базы, _путь(каталог, "lib") как размер)
    список_добавь(базы, _путь(каталог, "../lib") как размер)
    для инд в 0..базы.длина:
        база стр = список_получи(базы, инд) как стр
        п1 стр = _путь(база, стр_склей(стр_склей(путь_имя, "."),
                               стр_склей(загр.суффикс, ".раз")))
        если _файл_есть(п1):
            верни п1
        п2 стр = _путь(база, стр_склей(путь_имя, ".раз"))
        если _файл_есть(п2):
            верни п2
    печать("разум: взять ")
    печатьстр(имя)
    печать(" — модуль не найден\n")
    выход(1)
    верни пусто как стр

функ _взято_ли(взято *Список, путь стр) лог:
    для инд в 0..взято.длина:
        если стр_равны(список_получи(взято, инд) как стр, путь):
            верни да
    верни нет

функ _каталог(путь стр) стр:
    # каталог файла: всё до последнего '/' или '\'; нет — «.»
    поз смещение = (путь.длина как смещение) - 1
    пока поз >= 0:
        зн нат.старт = путь.данные[поз как размер]
        если зн == '/' или зн == '\\':
            верни стр_срез(путь, 0, поз как размер)
        поз -= 1
    верни "."

функ (загр *Загр) обход(путь стр, исх стр):
    # взято — по нормализованному пути; чтение и каталог — по реальному
    ключ стр = _норм_путь(путь)
    если _взято_ли(загр.взято, ключ):
        верни
    список_добавь(загр.взято, ключ как размер)
    прог *Узел = разбери(исх)
    кат стр = _каталог(путь)
    для инд в 0..прог.дети.длина:
        объяв *Узел = список_получи(прог.дети, инд) как *Узел
        если объяв.вид == У_ВЗЯТЬ:
            для инд2 в 0..объяв.дети.длина:
                мод *Узел = список_получи(объяв.дети, инд2) как *Узел
                список_добавь(загр.модули, мод.текст как размер)
                путь_м стр = загр.найди_модуль(мод.текст, кат)
                исх_м стр = файл_прочти(путь_м)
                загр.обход(путь_м, исх_м)
        иначе:
            список_добавь(загр.объявы, объяв как размер)

функ (загр *Загр) загрузи_текст(путь стр, исх стр) *Узел:
    # точка входа: виртуальный путь + готовый текст (например, stdin)
    загр.обход(путь, исх)
    прог *Узел = узел(У_ПРОГ, 0)
    прог.дети = загр.объявы
    прог.дети2 = загр.модули     # стр — пути «взять» для резолвера ген
    верни прог
