# ген — генератор текста ИСКРЫ (.иск) из AST РАЗУМА.
# Выражение оставляет результат в АКК; локали/парамы адресуются через УКК. Windows: СЧТ/ДАН/Р8/Р9 + тень 32Б; Linux SysV:
# ПРМ/ИСТ/ДАН/СЧТ/Р8/Р9.

взять основа
взять узлы
взять опт

конст ТВ_ЛЮБОЙ = 12   # внутренний тип «вывести самому»

# --- записи таблиц символов -----------------------------------------------------

запись ГСим:            # локал/параметр: имя -> (смещение, тип)
    имя стр
    смещ без64
    тип *Узел
    рег без64           # 0 — в кадре; 1..5 — индекс callee-saved регистра
    парам бул           # это параметр (слот [УКК+..]), иначе локал [УКК-..]

запись ГСчёт:           # вес обращений к имени внутри текущей функции
    имя стр
    n без64

запись ГПоле:           # поле записи / элемент перечисления
    имя стр
    смещ без64          # смещение поля или значение элемента переча
    тип *Узел

запись ГЗапись:
    имя стр
    разм без64
    поля *Список        # ГПоле

запись ГКонст:
    имя стр
    знач цел64
    большое бул     # значение >= 2^63 из литерала — печатаем беззнаково

запись ГСин:
    имя стр
    тип *Узел

запись ГПереч:
    имя стр
    элементы *Список    # ГПоле (смещ = значение)

запись ГФунк:
    имя стр             # исходное имя
    асм стр             # имя метки в ИСКРЕ
    парамы *Список      # У_ПАРАМ
    возвр *Узел
    внеш без64

запись ГМетод:
    запись стр          # имя записи-приёмника
    имя стр
    асм стр
    парамы *Список
    возвр *Узел

запись ГИмп:
    длл стр
    имена *Список       # стр

запись ГЦикл:
    шаг стр
    кон стр

запись ГЛок:            # элемент «порядок» при скане тела
    имя стр
    тип *Узел           # может быть пусто — выводится из выр
    выр *Узел           # может быть пусто

запись Ген:
    код *Буфер
    данные *Буфер
    записи *Список
    синонимы *Список
    консты *Список
    перечи *Список
    функции *Список
    методы *Список
    импорты *Список
    нужны_стд без64     # биты: 1=выдели 2=освободи
    стр_n без64
    lbl без64
    конст_большое бул   # последняя конст >= 2^63 из литерала
    глуб цел64          # выданные ВСТЕК (в восьмибайтовках)
    цель без64          # 0=windows 1=linux
    опт без64           # уровень оптимизации: 0=нет, 1=пипхол
    есть_главная без64
    # контекст текущей функции
    локалы *Список      # ГСим
    парамы *Список      # ГСим
    циклы *Список       # ГЦикл
    отложи *Список      # *Узел
    счёты *Список       # ГСчёт — веса обращений к именам
    запреты *Список     # стр — имена, которым нельзя в регистр (адрес/искра)
    рл_n без64          # сколько регистров занято локалями (префикс _рег_лок)
    фрейм без64
    выход_м стр
    возвр *Узел

функ ген_новый(цель без64, опт без64) *Ген:
    г *Ген = новый(Ген)
    г.код = буф_новый()
    г.данные = буф_новый()
    г.записи = список_новый()
    г.синонимы = список_новый()
    г.консты = список_новый()
    г.перечи = список_новый()
    г.функции = список_новый()
    г.методы = список_новый()
    г.импорты = список_новый()
    г.нужны_стд = 0
    г.стр_n = 0
    г.lbl = 0
    г.глуб = 0
    г.цель = цель
    г.опт = опт
    г.есть_главная = 0
    г.локалы = список_новый()
    г.парамы = список_новый()
    г.циклы = список_новый()
    г.отложи = список_новый()
    г.счёты = список_новый()
    г.запреты = список_новый()
    г.рл_n = 0
    г.фрейм = 0
    г.выход_м = ""
    г.возвр = пусто как *Узел
    верни г

функ ген_ош(текст стр, строка без64):
    печать("разум.ген: строка ")
    печатьцел(строка как цел64)
    печать(": ")
    печатьстр(текст)
    выход(1)

