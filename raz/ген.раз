# режим «--память проверка»: заголовок блока 48 байт перед областью
#   (размер, магия, строка, след, состояние, резерв) и огранка 16 байт
#   0x5A после области; блоки связаны списком от стд_пам_голова.
#   Освобождение проверяет магию/состояние/огранку, заливает область 0xDD
#   и оставляет блок в карантине (ОС его не получает). Сбои — код 104.
открыто функ (ген *Ген) стд_пам_хелперы():
    буф_добавь(ген.данные, "стд_пам_голова: КВАД 0\n")
    если (ген.нужны_стд & 1) != 0:
        зап_ц стр = ген.новая("пм_зап")
        зап_к стр = ген.новая("пм_запк")
        # СЧТ=размер, БАЗ=строка → АКК=указатель области
        ген.метка("стд_выдели_пров")
        ген.пиши("ВСТЕК УКК")
        ген.пиши("ПЕР УКК, УКС")
        ген.пиши("ВЫЧ УКС, 48")
        ген.пиши("ПЕР [УКК-8], СЧТ")
        ген.пиши("ПЕР [УКК-16], БАЗ")
        ген.пиши("ДОБ СЧТ, 64")
        ген.пиши("ВЫЗОВ стд_выдели")
        ген.пиши("ПЕР СЧТ, [УКК-8]")
        ген.пиши("ПЕР БАЗ, [УКК-16]")
        ген.пиши("ПЕР [АКК], СЧТ")
