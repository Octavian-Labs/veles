# граница массива Т[N]: статическая ошибка для известного индекса в обоих
# режимах; верни да, если индекс доказанно константный и динамическая
# проверка не нужна. конт: 0=чтение 1=запись 2=адрес — для диагностики.
открыто функ (ген *Ген) граница_масс(инд_выр *Узел, длина размер, конт нат.верх,
                             строка размер) лог:
    к *Узел = ген.сверни(инд_выр)
    если к == пусто:
        верни нет
    если к.знач2 != 0 или к.знач >= длина:
        вид_стр стр = "чтении"
        если конт == 1:
            вид_стр = "записи"
        а если конт == 2:
            вид_стр = "взятии адреса"
        ген_ош(_склей3(_склей2("индекс ", _цел_стр(к.знач как цел.верх)),
                   _склей3(" вне границ массива[", _цел_стр(длина как цел.верх),
                       "] при "), вид_стр), строка)
    верни да

# динамическая проверка границы Т[N] в режиме надёжно. АКК уже содержит
# индекс; вызывать до умножения на размер элемента. Знаковый индекс ловится
# на < 0, беззнаковый — только на верхней границе. Сбой → стд_сбой_границы
# с ABI: СЧТ=значение, ДАН=предел, ИСТ=вид, БАЗ=строка, Р8=файл (резерв).
открыто функ (ген *Ген) граница_дин(инд_выр *Узел, длина размер, конт нат.верх,
    строка размер):
    т_и *Узел = ген.реш_тип(ген.тип_выр(инд_выр))
    сбой стр = ген.новая("гр_сбой")
    ок стр = ген.новая("гр_ок")
    если т_и.знач == ТВ_ЦЕЛ:
        ген.пиши("ПРОВ АКК, АКК")
        ген.пиши(_склей2("МЕНЬШЕ ", сбой))
    ген.пиши(_склей2("СРАВ АКК, ", _цел_стр(длина как цел.верх)))
    ген.пиши(_склей2("ВЫШРАВ ", сбой))
    ген.пиши(_склей2("ПРЫГ ", ок))
    ген.метка(сбой)
    ген.нужны(4)
    ген.пиши("ПЕР СЧТ, АКК")
    ген.пиши(_склей2("ПЕР ДАН, ", _цел_стр(длина как цел.верх)))
    ген.пиши(_склей2("ПЕР ИСТ, ", _цел_стр(конт как цел.верх)))
    ген.пиши(_склей2("ПЕР БАЗ, ", _цел_стр(строка как цел.верх)))
    ген.пиши("ПЕР Р8, 0")
    ген.пад_и_вызов("стд_сбой_границы")
    ген.метка(ок)

# индекс пары {данные, длина} — среза []Т и строки стр: константный
# отрицательный знаковый индекс — статическая ошибка в обоих режимах; длина
# пары известна только в рантайме, поэтому верхняя граница проверяется
# динамически. конт: 0=чтение 1=запись 2=адрес; что — "среза" или "строки".
открыто функ (ген *Ген) пара_инд_стат(инд_выр *Узел, конт нат.верх, строка размер, что стр):
    к *Узел = ген.сверни(инд_выр)
    если к == пусто или к.знач2 == 0:
        верни
    вид_стр стр = "чтении"
    если конт == 1:
        вид_стр = "записи"
    а если конт == 2:
        вид_стр = "взятии адреса"
    ген_ош(_склей3(_склей2("индекс ", _цел_стр(к.знач как цел.верх)),
               _склей3(" вне границ ", что, " при "), вид_стр), строка)

# динамическая проверка индекса пары {данные, длина}: на входе СЧТ = индекс,
# АКК = адрес пары, длина в [АКК+8]. Знаковый индекс ловится на < 0, верхняя
# граница — беззнаковым сравнением с длиной. Вызывается только в надёжно.
# Сбой → стд_сбой_границы: СЧТ=индекс и ДАН=длина уже на месте.
открыто функ (ген *Ген) пара_инд_дин(инд_выр *Узел, конт нат.верх, строка размер):
    сбой стр = ген.новая("гр_сбой")
    ок стр = ген.новая("гр_ок")
    т_и *Узел = ген.реш_тип(ген.тип_выр(инд_выр))
    # ДАН = длина загружается до проверок — нужна диагностике обоих входов
    ген.пиши("ПЕР ДАН, [АКК+8]")
    если т_и.знач == ТВ_ЦЕЛ:
        ген.пиши("ПРОВ СЧТ, СЧТ")
        ген.пиши(_склей2("МЕНЬШЕ ", сбой))
    ген.пиши("СРАВ СЧТ, ДАН")
    ген.пиши(_склей2("ВЫШРАВ ", сбой))
    ген.пиши(_склей2("ПРЫГ ", ок))
    ген.метка(сбой)
    ген.нужны(4)
    ген.пиши(_склей2("ПЕР ИСТ, ", _цел_стр(конт как цел.верх)))
    ген.пиши(_склей2("ПЕР БАЗ, ", _цел_стр(строка как цел.верх)))
    ген.пиши("ПЕР Р8, 0")
    ген.пад_и_вызов("стд_сбой_границы")
    ген.метка(ок)

открыто функ (ген *Ген) индекс_адрес(выр *Узел, конт нат.верх) *Узел:
    # индукционный адрес (этап В): узел заменён бегущим слотом —
    # вся адресная арифметика уже посчитана на инициализации/шаге
    если ген.инд_актив.длина > 0:
        для поз в 0..ген.инд_актив.длина:
            з *ГИнд = список_получи(ген.инд_актив,
                ген.инд_актив.длина - 1 - поз) как *ГИнд
            если з.узел == выр:
                ген.пиши(_склей2("ПЕР АКК, ", з.оп))
                верни з.элем
    т_об *Узел = ген.реш_тип(ген.тип_выр(выр.а))
    если т_об.знач == ТВ_СТР:
        # индексация по байтам UTF-8: индекс — смещение байта, элемент — сим;
        # строка — та же пара {данные, длина}, что и у среза
        ген.пара_инд_стат(выр.б, конт, выр.строка, "строки")
        ген.выр(выр.б)
        ген.пиши("ВСТЕК АКК")
        ген.глуб += 1
        ген.выр(выр.а)
        ген.пиши("ИЗСТЕКА СЧТ")
        ген.глуб -= 1
        если ген.режим == 1 и не ген.индекс_доказан(выр.а, выр.б, 0, да):
            ген.пара_инд_дин(выр.б, конт, выр.строка)
        ген.пиши("ПЕР АКК, [АКК]")
        ген.пиши("ДОБ АКК, СЧТ")
        верни т_сим()
    если т_об.знач == ТВ_СРЕЗ:
        элем *Узел = т_об.а
        разм_эл размер = ген.размер(элем)
        ген.пара_инд_стат(выр.б, конт, выр.строка, "среза")
        ген.выр(выр.б)
        ген.пиши("ВСТЕК АКК")
        ген.глуб += 1
        ген.выр(выр.а)
        ген.пиши("ИЗСТЕКА СЧТ")
        ген.глуб -= 1
        если ген.режим == 1 и не ген.индекс_доказан(выр.а, выр.б, 0, да):
            # надёжно: СЧТ = индекс, АКК = &срез; длина среза в [АКК+8]
            ген.пара_инд_дин(выр.б, конт, выр.строка)
        ген.пиши("ПЕР АКК, [АКК]")
        _пиши_адр_сум(ген, разм_эл)
        верни элем
    если (т_об.знач == ТВ_УКАЗ или т_об.знач == ТВ_МАСС или
       т_об.знач == ТВ_ВЕК):
        элем = ген.реш_тип(т_об.а)
        разм_эл = ген.размер(элем)
        стат_ок лог = нет
        если т_об.знач == ТВ_МАСС или т_об.знач == ТВ_ВЕК:
            стат_ок = ген.граница_масс(выр.б, т_об.знач2, конт, выр.строка)
            если не стат_ок:
                стат_ок = ген.индекс_доказан(выр.а, выр.б, т_об.знач2, нет)
        ген.выр(выр.б)
        дин_гр лог = (т_об.знач == ТВ_МАСС или т_об.знач == ТВ_ВЕК)
        если дин_гр и ген.режим == 1 и не стат_ок:
            ген.граница_дин(выр.б, т_об.знач2, конт, выр.строка)
        # простое имя-основание: адрес одним АДР, без стекового пробега
        дисп смещение = 0
        бр стр = ген.индекс_база(выр.а, т_об, &дисп)
        если бр.длина > 0:
            ген.адр_индекс(бр, дисп, разм_эл)
            верни элем
        ген.пиши("ВСТЕК АКК")
        ген.глуб += 1
        если т_об.знач == ТВ_МАСС или т_об.знач == ТВ_ВЕК:
            ген.адрес(выр.а, 2)
        иначе:
            ген.выр(выр.а)
        ген.пиши("ИЗСТЕКА СЧТ")
        ген.глуб -= 1
        _пиши_адр_сум(ген, разм_эл)
        верни элем
    ген_ош("индексация не-массива", выр.строка)
    верни т_любой()

открыто функ (ген *Ген) унар(выр *Узел) *Узел:
    если стр_равны(выр.текст, "-"):
        тип_уз *Узел = ген.выр(выр.а)
        тип_у *Узел = ген.реш_тип(тип_уз)
        если _это_вещ(тип_у):
            # 0.0 - x — без константы: обнулить xmm1 через xorpd/xorps с собой
            суф стр = _вещ_суф(тип_у)
            ген.пиши(_склей3("ИИЛИП", суф, " ПЛАВ1, ПЛАВ1"))
            ген.пиши(_склей3("ВЫЧВ", суф, " ПЛАВ1, ПЛАВ0"))
            ген.пиши(_склей3("ПЕРВ", суф, " ПЛАВ0, ПЛАВ1"))
            верни тип_уз
        если _это_век(тип_у):
            # 0 - x по лейнам: ноль через pxor, вычитание пакетное
            элем_у *Узел = ген.век_эл(тип_у)
            ген.пиши("ПИИЛИ ПЛАВ1, ПЛАВ1")
            если элем_у.знач == ТВ_ВЕЩ:
                суф = _век_суф(элем_у)
                ген.пиши(_склей3("ВЫЧП", суф, " ПЛАВ1, ПЛАВ0"))
                ген.пиши(_склей3("ПЕРП", суф, " ПЛАВ0, ПЛАВ1"))
            иначе:
                ген.пиши(_склей3("ПВЫЧ", _лейн_суф(ген.размер(элем_у)),
                    " ПЛАВ1, ПЛАВ0"))
                ген.пиши("ПЕРЦВ ПЛАВ0, ПЛАВ1")
            верни тип_уз
        ген.пиши("ОТР АКК")
        верни тип_уз
    если стр_равны(выр.текст, "не"):
        ген.требуй_логические_операнды(выр)
        ген.выр(выр.а)
        ген.пиши("ПРОВ АКК, АКК")
        ген.пиши("УСТРАВНО АККБ")
        ген.пиши("БЕЗРАСШ АКК, АККБ")
        верни т_бул()
    ген_ош(_склей2("неизвестный унарный ", выр.текст), выр.строка)
    верни т_любой()

# --- константная свёртка ---------------------------------------------------------

открыто функ _число_уз(знач цел.верх, строка размер) *Узел:
    уз *Узел = узел(У_ЧИСЛО, строка)
    уз.знач = знач как нат.верх
    уз.знач2 = уз.знач >> 63
    верни уз

открыто функ (ген *Ген) сверни(выр *Узел) *Узел:
    # Вычисляет выражение во время компиляции; возвращает узел У_ЧИСЛО
    # или пусто, если выражение не константное. Семантика повторяет
    # сгенерированный код: усечённое деление, знаковость сдвигов и
    # сравнений по типу операндов, маска счётчика сдвига в 63.
    если выр == пусто:
        верни пусто как *Узел
    вид нат.верх = выр.вид
    если вид == У_ЧИСЛО или вид == У_БУЛ:
        верни выр
    если вид == У_ИМЯ:
        конста *ГКонст = ген.конст_ищи(выр.текст)
        если конста == пусто:
            эл *ГПоле = ген.переч_элем_ищи(выр.текст)
            если эл == пусто:
                верни пусто как *Узел
            верни _число_уз(эл.смещ как цел.верх, выр.строка)
        уз *Узел = узел(У_ЧИСЛО, выр.строка)
        уз.знач = конста.знач как нат.верх
        уз.знач2 = конста.большое как нат.верх
        верни уз
    если (вид == У_ПОЛЕ и выр.а != пусто и выр.а.вид == У_ИМЯ):
        переч *ГПереч = ген.переч_ищи(выр.а.текст)
        если переч != пусто:
            для инд в 0..переч.элементы.длина:
                элем *ГПоле = список_получи(переч.элементы, инд) как *ГПоле
                если стр_равны(элем.имя, выр.текст):
                    верни _число_уз(элем.смещ как цел.верх, выр.строка)
        верни пусто как *Узел
    если вид == У_УН:
        лев *Узел = ген.сверни(выр.а)
        если лев == пусто:
            верни пусто как *Узел
        если стр_равны(выр.текст, "-"):
            верни _число_уз(0 - (лев.знач как цел.верх), выр.строка)
        если стр_равны(выр.текст, "не"):
            верни _число_уз((лев.знач == 0) как цел.верх, выр.строка)
        верни пусто как *Узел
    если вид == У_ПРИВЕД:
        тип_св *Узел = ген.реш_тип(ген.тип_приведения(выр))
        если _это_вещ(тип_св):
            верни пусто как *Узел   # вещественное приведение не сворачиваем
        верни ген.сверни(выр.а)
    если вид == У_РАЗМЕР:
        уз = узел(У_ЧИСЛО, выр.строка)
        если выр.знач2 == 1:
            уз.знач = ген.размер(выр.а)
        иначе:
            уз.знач = ген.размер(ген.тип_выр(выр.а))
        верни уз
    если вид == У_БИН:
        верни ген.сверни_бин(выр)
    верни пусто как *Узел

# --- доказательство границ ---------------------------------------------------

открыто функ _мут_корень(уз *Узел, имя стр) лог:
    # корень цели присваивания или адреса: У_ИМЯ — запись в слот,
    # У_ПОЛЕ — запись поля (в т.ч. пары среза); У_ИНДЕКС — элемент, слот не меняется
    если уз == пусто:
        верни нет
    если уз.вид == У_ИМЯ:
        верни стр_равны(уз.текст, имя)
    если уз.вид == У_ПОЛЕ:
        верни _мут_корень(уз.а, имя)
    верни нет

открыто функ _мутирует(уз *Узел, имя стр) лог:
    # присваивание, затенение или взятие адреса переменной «имя» внутри узла
    если уз == пусто:
        верни нет
    если уз.вид == У_ПРИСВ и _мут_корень(уз.а, имя):
        верни да
    если уз.вид == У_ОБЪЯВЛ и стр_равны(уз.текст, имя):
        верни да
    если уз.вид == У_АДРЕС и _мут_корень(уз.а, имя):
        верни да
    если _мутирует(уз.а, имя) или _мутирует(уз.б, имя) или _мутирует(уз.в, имя):
        верни да
    если уз.дети != пусто:
        для поз в 0..уз.дети.длина:
            если _мутирует(список_получи(уз.дети, поз) как *Узел, имя):
                верни да
    если уз.дети2 != пусто:
        для поз в 0..уз.дети2.длина:
            если _мутирует(список_получи(уз.дети2, поз) как *Узел, имя):
                верни да
    верни нет

открыто функ (ген *Ген) тело_мутирует(дети *Список, имя стр) лог:
    если дети == пусто:
        верни нет
    для поз в 0..дети.длина:
        если _мутирует(список_получи(дети, поз) как *Узел, имя):
            верни да
    верни нет

# --- индукционные адреса и вынос инвариантов (этап В) -------------------------
#
# Идея: в цикле «для сч в низ..верх» индексация вида «указатель[А + сч*Б]»
# (А и Б — чистые инварианты тела) заменяется бегущим адресом в скрытом
# локале: перед циклом адрес инициализируется базой + (А + низ*Б)*разм_эл,
# на метке шага прибавляется Б*разм_эл. Применяется только к сырым
# указателям *Т — у них нет проверки границ, подмена не ослабляет надёжно.
# Инвариантом не считаются имена, мутируемые в теле или служащие
# счётчиками вложенных «для» — их значение меняется между итерациями.

открыто функ _инд_имя_есть(выр *Узел, имя стр) лог:
    # входит ли имя в поддерево выражения
    если выр == пусто:
        верни нет
    если выр.вид == У_ИМЯ:
        верни стр_равны(выр.текст, имя)
    если (_инд_имя_есть(выр.а, имя) или _инд_имя_есть(выр.б, имя) или
          _инд_имя_есть(выр.в, имя) или _инд_имя_есть(выр.г, имя)):
        верни да
    если выр.дети != пусто:
        для поз в 0..выр.дети.длина:
            если _инд_имя_есть(список_получи(выр.дети, поз) как *Узел, имя):
                верни да
    если выр.дети2 != пусто:
        для поз в 0..выр.дети2.длина:
            если _инд_имя_есть(список_получи(выр.дети2, поз) как *Узел, имя):
                верни да
    верни нет

открыто функ _инд_счётчик(уз *Узел, имя стр) лог:
    # служит ли имя счётчиком вложенного «для» внутри узла —
    # такая переменная меняется между итерациями внешнего цикла
    если уз == пусто:
        верни нет
    если уз.вид == У_ДЛЯ и уз.дети != пусто:
        для поз в 0..уз.дети.длина:
            ис *Узел = список_получи(уз.дети, поз) как *Узел
            если ис.вид == У_ИМЯ и стр_равны(ис.текст, имя):
                верни да
    если (_инд_счётчик(уз.а, имя) или _инд_счётчик(уз.б, имя) или
          _инд_счётчик(уз.в, имя) или _инд_счётчик(уз.г, имя)):
        верни да
    если уз.дети != пусто:
        для поз в 0..уз.дети.длина:
            если _инд_счётчик(список_получи(уз.дети, поз) как *Узел, имя):
                верни да
    если уз.дети2 != пусто:
        для поз в 0..уз.дети2.длина:
            если _инд_счётчик(список_получи(уз.дети2, поз) как *Узел, имя):
                верни да
    верни нет

открыто функ _инд_счётчик_в(тело *Список, имя стр) лог:
    если тело == пусто:
        верни нет
    для поз в 0..тело.длина:
        если _инд_счётчик(список_получи(тело, поз) как *Узел, имя):
            верни да
    верни нет

открыто функ (ген *Ген) инд_чист(выр *Узел, сч стр, тело *Список) лог:
    # чистый инвариант цикла: без счётчика, без чтений памяти и вызовов;
    # входящие имена не мутируются и не являются вложенными счётчиками
    если выр == пусто:
        верни нет
    вид нат.верх = выр.вид
    если вид == У_ИМЯ:
        если стр_равны(выр.текст, сч):
            верни нет
        верни (не ген.тело_мутирует(тело, выр.текст) и
               не _инд_счётчик_в(тело, выр.текст))
    если вид == У_ЧИСЛО или вид == У_БУЛ:
        верни да
    если вид == У_БИН:
        оп стр = выр.текст
        если (стр_равны(оп, "+") или стр_равны(оп, "-") или стр_равны(оп, "*") или
              стр_равны(оп, "/") или стр_равны(оп, "%") или стр_равны(оп, "<<") или
              стр_равны(оп, ">>") или стр_равны(оп, "&") или стр_равны(оп, "|") или
              стр_равны(оп, "^")):
            верни ген.инд_чист(выр.а, сч, тело) и ген.инд_чист(выр.б, сч, тело)
        верни нет
    если вид == У_УН и стр_равны(выр.текст, "-"):
        верни ген.инд_чист(выр.а, сч, тело)
    если вид == У_ПРИВЕД:
        верни ген.инд_чист(выр.а, сч, тело)
    верни нет

открыто функ _инд_бин(текст стр, лев *Узел, прав *Узел, строка размер) *Узел:
    у *Узел = узел(У_БИН, строка)
    у.текст = текст
    у.а = лев
    у.б = прав
    верни у

открыто функ _инд_унмин(выр *Узел, строка размер) *Узел:
    у *Узел = узел(У_УН, строка)
    у.текст = "-"
    у.а = выр
    верни у

открыто функ (ген *Ген) инд_член(выр *Узел, сч стр) *ГЛин:
    # разложение одного члена на коэффициент*счётчик; лин=нет —
    # счётчик не входит (инвариантность проверяет вызывающий)
    р *ГЛин = новый(ГЛин)
    р.ок = да
    если выр.вид == У_ИМЯ и стр_равны(выр.текст, сч):
        р.лин = да
        верни р
    если выр.вид == У_БИН и стр_равны(выр.текст, "*"):
        л *ГЛин = ген.инд_член(выр.а, сч)
        п *ГЛин = ген.инд_член(выр.б, сч)
        если не л.ок или не п.ок:
            р.ок = нет
            верни р
        если л.лин и п.лин:
            р.ок = нет
            верни р
        если л.лин:
            р.лин = да
            если л.б == пусто:
                р.б = выр.б
            иначе:
                р.б = _инд_бин("*", л.б, выр.б, выр.строка)
            верни р
        если п.лин:
            р.лин = да
            если п.б == пусто:
                р.б = выр.а
            иначе:
                р.б = _инд_бин("*", п.б, выр.а, выр.строка)
        верни р
    если выр.вид == У_УН и стр_равны(выр.текст, "-"):
        вн *ГЛин = ген.инд_член(выр.а, сч)
        если не вн.ок:
            р.ок = нет
            верни р
        если вн.лин:
            р.лин = да
            если вн.б == пусто:
                р.б = _инд_унмин(_число_уз(1, выр.строка), выр.строка)
            иначе:
                р.б = _инд_унмин(вн.б, выр.строка)
        верни р
    если _инд_имя_есть(выр, сч):
        р.ок = нет
    верни р

открыто функ (ген *Ген) инд_разложи(инд_выр *Узел, сч стр, тело *Список) *ГЛин:
    # индекс = а + сч*б; лин=нет — чистый инвариант; ок=нет — не подходит
    р *ГЛин = новый(ГЛин)
    р.ок = да
    если не _инд_имя_есть(инд_выр, сч):
        если ген.инд_чист(инд_выр, сч, тело):
            р.а = инд_выр
            верни р
        р.ок = нет
        верни р
    если (инд_выр.вид == У_БИН и
          (стр_равны(инд_выр.текст, "+") или стр_равны(инд_выр.текст, "-"))):
        минус лог = стр_равны(инд_выр.текст, "-")
        л *ГЛин = ген.инд_член(инд_выр.а, сч)
        п *ГЛин = ген.инд_член(инд_выр.б, сч)
        если не л.ок или не п.ок:
            р.ок = нет
            верни р
        если л.лин и п.лин:
            р.ок = нет
            верни р
        если л.лин:
            если не ген.инд_чист(инд_выр.б, сч, тело):
                р.ок = нет
                верни р
            р.лин = да
            р.б = л.б
            если минус:
                р.а = _инд_унмин(инд_выр.б, инд_выр.строка)
            иначе:
                р.а = инд_выр.б
            верни р
        если п.лин:
            если не ген.инд_чист(инд_выр.а, сч, тело):
                р.ок = нет
                верни р
            р.лин = да
            р.а = инд_выр.а
            если минус:
                если п.б == пусто:
                    р.б = _инд_унмин(_число_уз(1, инд_выр.строка), инд_выр.строка)
                иначе:
                    р.б = _инд_унмин(п.б, инд_выр.строка)
            иначе:
                р.б = п.б
            верни р
        р.ок = нет
        верни р
    ч *ГЛин = ген.инд_член(инд_выр, сч)
    если ч.ок и ч.лин:
        р.лин = да
        р.б = ч.б
        верни р
    р.ок = нет
    верни р

открыто функ (ген *Ген) инд_собери(уз *Узел, сч стр, тело *Список, план *Список):
    # обход тела: каждый У_ИНДЕКС по сырому имени с аффинным или
    # инвариантным индексом — кандидат на бегущий адрес
    если уз == пусто или план.длина >= 8:
        верни
    если уз.вид == У_ИНДЕКС:
        если (уз.а != пусто и уз.а.вид == У_ИМЯ и
              не ген.тело_мутирует(тело, уз.а.текст) и
              не _инд_счётчик_в(тело, уз.а.текст)):
            р *ГЛин = ген.инд_разложи(уз.б, сч, тело)
            если р.ок:
                з *ГИнд = новый(ГИнд)
                з.узел = уз
                з.база = уз.а
                з.а = р.а
                з.б = р.б
                з.лин = р.лин
                список_добавь(план, з как размер)
    ген.инд_собери(уз.а, сч, тело, план)
    ген.инд_собери(уз.б, сч, тело, план)
    ген.инд_собери(уз.в, сч, тело, план)
    ген.инд_собери(уз.г, сч, тело, план)
    если уз.дети != пусто:
        для поз в 0..уз.дети.длина:
            ген.инд_собери(список_получи(уз.дети, поз) как *Узел, сч, тело, план)
    если уз.дети2 != пусто:
        для поз в 0..уз.дети2.длина:
            ген.инд_собери(список_получи(уз.дети2, поз) как *Узел, сч, тело, план)

открыто функ (ген *Ген) инд_планируй(оператор *Узел, порядок *Список):
    # при скане тела: найти кандидатов и зарезервировать скрытые слоты
    если оператор.а == пусто или оператор.а.вид != У_ДИАП:
        верни
    если оператор.дети == пусто или оператор.дети.длина == 0:
        верни
    имя_у *Узел = список_получи(оператор.дети, 0) как *Узел
    тело *Список = оператор.дети2
    если тело == пусто:
        верни
    если ген.тело_мутирует(тело, имя_у.текст):
        верни
    если _инд_счётчик_в(тело, имя_у.текст):
        верни
    план *Список = список_новый()
    для поз в 0..тело.длина:
        ген.инд_собери(список_получи(тело, поз) как *Узел, имя_у.текст, тело, план)
    если план.длина == 0:
        верни
    для поз в 0..план.длина:
        з *ГИнд = список_получи(план, поз) как *ГИнд
        з.слот = _склей2("_инд", _цел_стр(ген.мет_сч как цел.верх))
        ген.мет_сч += 1
        _лок_добавь(порядок, з.слот, т_без64(), пусто как *Узел)
        з.шаг_слот = ""
        если з.лин:
            з.шаг_слот = _склей2("_индш", _цел_стр(ген.мет_сч как цел.верх))
            ген.мет_сч += 1
            _лок_добавь(порядок, з.шаг_слот, т_без64(), пусто как *Узел)
    ц *ГИндЦикл = новый(ГИндЦикл)
    ц.оп = оператор
    ц.записи = план
    список_добавь(ген.инд_планы, ц как размер)

открыто функ _инд_масштаб(ген *Ген, разм размер):
    # АКК *= разм — сдвиг для степени двух, иначе imul
    если разм <= 1:
        верни
    бит цел.верх = _степень2(разм как нат.верх)
    если бит >= 0:
        ген.пиши(_склей2("СДЛ АКК, ", _цел_стр(бит)))
    иначе:
        ген.пиши(_склей2("УМН АКК, АКК, ", _цел_стр(разм как цел.верх)))

открыто функ (ген *Ген) индекс_доказан(об_выр *Узел, инд_выр *Узел, длина размер, пара лог) лог:
    # «да» — индекс гарантированно в границах, динамическая проверка не нужна.
    # доказательства:
    #   1. «инд & предел-1» с беззнаковым индексом и пределом = степени двух;
    #   2. «инд % предел» с беззнаковым индексом;
    #   3. переменная «для i в мин..предел» — предел в границах массива;
    #   4. переменная «для i в кол» — объект и есть та же коллекция.
    если инд_выр == пусто:
        верни нет
    если длина > 0 и инд_выр.вид == У_БИН:
        ит *Узел = ген.тип_выр(инд_выр.а)
        если ит != пусто и ит.знач == ТВ_БЕЗ:
            если (стр_равны(инд_выр.текст, "&") и ген.конст_ли(инд_выр.б) и
                  ген.конст(инд_выр.б) + 1 == длина и (длина & (длина - 1)) == 0):
                верни да
            если (стр_равны(инд_выр.текст, "%") и ген.конст_ли(инд_выр.б) и
                  ген.конст(инд_выр.б) <= длина и ген.конст(инд_выр.б) > 0):
                верни да
    если инд_выр.вид != У_ИМЯ:
        верни нет
    сл *ГСим = ген.локал_ищи(инд_выр.текст)
    если сл == пусто:
        сл = ген.парам_ищи(инд_выр.текст)
    если сл == пусто:
        верни нет
    для поз в 0..ген.доказаны.длина:
        дк *ГДоказ = список_получи(ген.доказаны, поз) как *ГДоказ
        если дк.слот != сл:
            следующий
        если дк.кол != пусто:
            если об_выр.вид == У_ИМЯ:
                кс *ГСим = ген.локал_ищи(об_выр.текст)
                если кс == пусто:
                    кс = ген.парам_ищи(об_выр.текст)
                если кс == дк.кол:
                    верни да
            следующий
        если не пара и длина > 0 и дк.мин >= 0 и дк.предел <= длина:
            верни да
    верни нет

открыто функ (ген *Ген) сверни_бин(выр *Узел) *Узел:
    лев *Узел = ген.сверни(выр.а)
    если лев == пусто:
        верни пусто как *Узел
    оп стр = выр.текст
    если стр_равны(оп, "в"):
        диап *Узел = выр.б
        если диап == пусто или диап.вид != У_ДИАП:
            верни пусто как *Узел
        низ *Узел = ген.сверни(диап.а)
        верх *Узел = ген.сверни(диап.б)
        если низ == пусто или верх == пусто:
            верни пусто как *Узел
        ок лог = нет
        если не т_знаковый(ген.реш_тип(ген.тип_выр(выр.а))):
            если диап.знач2 == 1:
                ок = (лев.знач >= низ.знач) и (лев.знач <= верх.знач)
            иначе:
                ок = (лев.знач >= низ.знач) и (лев.знач < верх.знач)
        иначе:
            хс цел.верх = лев.знач как цел.верх
            лс цел.верх = низ.знач как цел.верх
            пс цел.верх = верх.знач как цел.верх
            если диап.знач2 == 1:
                ок = (хс >= лс) и (хс <= пс)
            иначе:
                ок = (хс >= лс) и (хс < пс)
        верни _число_уз(ок как цел.верх, выр.строка)
    прав *Узел = ген.сверни(выр.б)
    если прав == пусто:
        верни пусто как *Узел
    если стр_равны(оп, "и"):
        верни _число_уз(((лев.знач != 0) и (прав.знач != 0)) как цел.верх, выр.строка)
    если стр_равны(оп, "или"):
        верни _число_уз(((лев.знач != 0) или (прав.знач != 0)) как цел.верх, выр.строка)
    тип_л *Узел = ген.тип_выр(выр.а)
    тип_п *Узел = ген.тип_выр(выр.б)
    беззн лог = не (т_знаковый(ген.реш_тип(тип_л)) и т_знаковый(ген.реш_тип(тип_п)))
    ав цел.верх = лев.знач как цел.верх
    бв цел.верх = прав.знач как цел.верх
    ау нат.верх = лев.знач
    бу нат.верх = прав.знач
    если стр_равны(оп, "+"):
        верни _число_уз(ав + бв, выр.строка)
    если стр_равны(оп, "-"):
        верни _число_уз(ав - бв, выр.строка)
    если стр_равны(оп, "*"):
        верни _число_уз(ав * бв, выр.строка)
    если стр_равны(оп, "&"):
        верни _число_уз(ав & бв, выр.строка)
    если стр_равны(оп, "|"):
        верни _число_уз(ав | бв, выр.строка)
    если стр_равны(оп, "^"):
        верни _число_уз(ав ^ бв, выр.строка)
    если стр_равны(оп, "<<"):
        верни _число_уз(ав << (бв & 63), выр.строка)
    если стр_равны(оп, ">>"):
        если беззн:
            верни _число_уз((ау >> (бу & 63)) как цел.верх, выр.строка)
        верни _число_уз(ав >> (бв & 63), выр.строка)
    если (стр_равны(оп, "/") или стр_равны(оп, "%")):
        если бу == 0:
            верни пусто как *Узел
        частн цел.верх = 0
        ост цел.верх = 0
        если беззн:
            частн = (ау / бу) как цел.верх
            ост = (ау % бу) как цел.верх
        иначе:
            частн = ав / бв
            ост = ав % бв
        если стр_равны(оп, "/"):
            верни _число_уз(частн, выр.строка)
        верни _число_уз(ост, выр.строка)
    если _это_сравн(оп):
        рез лог = нет
        если беззн:
            если стр_равны(оп, "=="):
                рез = ау == бу
            если стр_равны(оп, "!="):
                рез = ау != бу
            если стр_равны(оп, "<"):
                рез = ау < бу
            если стр_равны(оп, "<="):
                рез = ау <= бу
            если стр_равны(оп, ">"):
                рез = ау > бу
            если стр_равны(оп, ">="):
                рез = ау >= бу
        иначе:
            если стр_равны(оп, "=="):
                рез = ав == бв
            если стр_равны(оп, "!="):
                рез = ав != бв
            если стр_равны(оп, "<"):
                рез = ав < бв
            если стр_равны(оп, "<="):
                рез = ав <= бв
            если стр_равны(оп, ">"):
                рез = ав > бв
            если стр_равны(оп, ">="):
                рез = ав >= бв
        верни _число_уз(рез как цел.верх, выр.строка)
    верни пусто как *Узел

открыто функ (ген *Ген) бин(выр *Узел) *Узел:
    оп стр = выр.текст
    если стр_равны(оп, "и") или стр_равны(оп, "или"):
        ген.требуй_логические_операнды(выр)
    св *Узел = ген.сверни(выр)
    если св != пусто:
        ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(св.знач как цел.верх)))
        если (_это_сравн(оп) или стр_равны(оп, "и") или
              стр_равны(оп, "или") или стр_равны(оп, "в")):
            верни т_бул()
        верни ген.тип_выр(выр.а)
    если стр_равны(оп, "и"):
        ложь стр = ген.новая("и_ложь")
        конец стр = ген.новая("и_конец")
        ген.усл_прыг(выр.а, ложь, нет)
        ген.усл_прыг(выр.б, ложь, нет)
        ген.пиши("ПЕР АКК, 1")
        ген.пиши(_склей2("ПРЫГ ", конец))
        ген.метка(ложь)
        ген.пиши("ПЕР АКК, 0")
        ген.метка(конец)
        верни т_бул()
    если стр_равны(оп, "или"):
        ист стр = ген.новая("или_ист")
        конец = ген.новая("или_конец")
        ген.усл_прыг(выр.а, ист, да)
        ген.усл_прыг(выр.б, ист, да)
        ген.пиши("ПЕР АКК, 0")
        ген.пиши(_склей2("ПРЫГ ", конец))
        ген.метка(ист)
        ген.пиши("ПЕР АКК, 1")
        ген.метка(конец)
        верни т_бул()
    если стр_равны(оп, "в"):
        верни ген.проверка_диапазона(выр)
    тип_л0 *Узел = ген.реш_тип(ген.тип_выр(выр.а))
    тип_п0 *Узел = ген.реш_тип(ген.тип_выр(выр.б))
    кл лог = _это_век(тип_л0)
    кп лог = _это_век(тип_п0)
    если кл != кп:
        ген_ош("нельзя смешивать вектор и скаляр без «как»", выр.строка)
    если кл:
        если не т_равны(тип_л0, тип_п0):
            ген_ош(_склей3("несовместимые векторы: ",
                ген.имя_типа(тип_л0),
                _склей2(" и ", ген.имя_типа(тип_п0))), выр.строка)
        верни ген.бин_век(выр, оп, тип_л0)
    вл лог = _это_вещ(тип_л0)
    вп лог = _это_вещ(тип_п0)
    если вл != вп:
        ген_ош("нельзя смешивать вещественный и целый операнд без «как»",
            выр.строка)
    если вл:
        # литерал приобретает уровень другого операнда; смешение уровней — «как»
        если _пометь_лит(выр.а, тип_п0.знач2):
            тип_л0 = тип_п0
        если _пометь_лит(выр.б, тип_л0.знач2):
            тип_п0 = тип_л0
        если тип_л0.знач2 != тип_п0.знач2:
            ген_ош("нельзя смешивать уровни вещественных без «как»",
                выр.строка)
        верни ген.бин_вещ(выр, оп)
    если _это_сравн(оп):
        тип_л *Узел = ген.тип_выр(выр.а)
        тип_п *Узел = ген.тип_выр(выр.б)
        знак лог = т_знаковый(ген.реш_тип(тип_л)) и т_знаковый(ген.реш_тип(тип_п))
        пкс *Узел = ген.сверни(выр.б)
        если пкс != пусто и _в_имм32(пкс.знач):
            # x ? K: СРАВ с непосредственным — правый операнд не вычисляется
            ген.выр(выр.а)
            ген.пиши(_склей2("СРАВ АКК, ", _цел_стр(пкс.знач как цел.верх)))
        иначе:
            пкл *Узел = ген.сверни(выр.а)
            если (пкл != пусто и _в_имм32(пкл.знач) и
                  (стр_равны(оп, "==") или стр_равны(оп, "!="))):
                # K == x / K != x: симметричны, тот же СРАВ с непосредственным
                ген.выр(выр.б)
                ген.пиши(_склей2("СРАВ АКК, ", _цел_стр(пкл.знач как цел.верх)))
            иначе:
                ген.выр(выр.а)
                ген.пиши("ВСТЕК АКК")
                ген.глуб += 1
                ген.выр(выр.б)
                ген.пиши("ПЕР СЧТ, АКК")
                ген.пиши("ИЗСТЕКА АКК")
                ген.глуб -= 1
                ген.пиши("СРАВ АКК, СЧТ")
        ген.пиши(_склей2(_усл_сравн(оп, знак), " АККБ"))
        ген.пиши("БЕЗРАСШ АКК, АККБ")
        верни т_бул()
    тип_л = ген.тип_выр(выр.а)
    # константа справа: непосредственный операнд, без стека и второго вычисления
    пк *Узел = ген.сверни(выр.б)
    если пк != пусто и _в_имм32(пк.знач):
        имм стр = _цел_стр(пк.знач как цел.верх)
        если стр_равны(оп, "+"):
            ген.выр(выр.а)
            ген.пиши(_склей2("ДОБ АКК, ", имм))
            верни тип_л
        если стр_равны(оп, "-"):
            ген.выр(выр.а)
            ген.пиши(_склей2("ВЫЧ АКК, ", имм))
            верни тип_л
        если стр_равны(оп, "&"):
            ген.выр(выр.а)
            ген.пиши(_склей2("И АКК, ", имм))
            верни тип_л
        если стр_равны(оп, "|"):
            ген.выр(выр.а)
            ген.пиши(_склей2("ИЛИ АКК, ", имм))
            верни тип_л
        если стр_равны(оп, "^"):
            ген.выр(выр.а)
            ген.пиши(_склей2("ИИЛИ АКК, ", имм))
            верни тип_л
        если стр_равны(оп, "*"):
            ген.выр(выр.а)
            бит цел.верх = _степень2(пк.знач)
            если бит > 0:
                ген.пиши(_склей2("СДЛ АКК, ", _цел_стр(бит)))
            а если пк.знач == 0:
                ген.пиши("ПЕР АКК, 0")
            а если бит < 0:
                ген.пиши(_склей2("УМН АКК, АКК, ", имм))
            # бит == 0 — x*1: значение уже в АКК, ничего не эмитим
            верни тип_л
        если стр_равны(оп, "<<"):
            ген.выр(выр.а)
            ген.пиши(_склей2("СДЛ АКК, ", _цел_стр((пк.знач & 63) как цел.верх)))
            верни тип_л
        если стр_равны(оп, ">>"):
            ген.выр(выр.а)
            мнем_сдв стр = "СДП"
            если т_знаковый(ген.реш_тип(тип_л)):
                мнем_сдв = "СДПА"
            ген.пиши(_склей3(мнем_сдв, " АКК, ", _цел_стр((пк.знач & 63) как цел.верх)))
            верни тип_л
        если ((стр_равны(оп, "/") или стр_равны(оп, "%")) и
           _степень2(пк.знач) >= 0):
            # x/2^k и x%2^k сдвигами вместо ДЕЛ (idiv ~30+ тактов);
            # для знаковых — компенсация усечения к нулю
            бит_д цел.верх = _степень2(пк.знач)
            если бит_д < 63:
                знак_д лог = т_знаковый(ген.реш_тип(тип_л))
                ген.выр(выр.а)
                если бит_д == 0:
                    если стр_равны(оп, "%"):
                        ген.пиши("ПЕР АКК, 0")
                    верни тип_л
                если не знак_д:
                    если стр_равны(оп, "/"):
                        ген.пиши(_склей2("СДП АКК, ", _цел_стр(бит_д)))
                    иначе:
                        ген.пиши(_склей2("СДЛ АКК, ", _цел_стр(64 - бит_д)))
                        ген.пиши(_склей2("СДП АКК, ", _цел_стр(64 - бит_д)))
                    верни тип_л
                если стр_равны(оп, "/"):
                    ген.пиши("ПЕР СЧТ, АКК")
                    ген.пиши("СДПА СЧТ, 63")
                    ген.пиши(_склей2("СДП СЧТ, ", _цел_стр(64 - бит_д)))
                    ген.пиши("ДОБ АКК, СЧТ")
                    ген.пиши(_склей2("СДПА АКК, ", _цел_стр(бит_д)))
                    верни тип_л
                ген.пиши("ПЕР СЧТ, АКК")
                ген.пиши("ПЕР ДАН, АКК")
                ген.пиши("СДПА ДАН, 63")
                ген.пиши(_склей2("СДП ДАН, ", _цел_стр(64 - бит_д)))
                ген.пиши("ДОБ АКК, ДАН")
                если бит_д <= 31:
                    ген.пиши(_склей2("И АКК, ", _цел_стр(-(пк.знач как цел.верх))))
                иначе:
                    ген.пиши(_склей2("СДПА АКК, ", _цел_стр(бит_д)))
                    ген.пиши(_склей2("СДЛ АКК, ", _цел_стр(бит_д)))
                ген.пиши("ВЫЧ СЧТ, АКК")
                ген.пиши("ПЕР АКК, СЧТ")
                верни тип_л
    # константа слева у коммутативных операций: считаем правую, op с непосредственным
    пкл2 *Узел = ген.сверни(выр.а)
    если (пкл2 != пусто и _в_имм32(пкл2.знач) и
       (стр_равны(оп, "+") или стр_равны(оп, "*") или
        стр_равны(оп, "&") или стр_равны(оп, "|") или стр_равны(оп, "^"))):
        имм2 стр = _цел_стр(пкл2.знач как цел.верх)
        ген.выр(выр.б)
        если стр_равны(оп, "+"):
            ген.пиши(_склей2("ДОБ АКК, ", имм2))
        а если стр_равны(оп, "*"):
            бит2 цел.верх = _степень2(пкл2.знач)
            если бит2 > 0:
                ген.пиши(_склей2("СДЛ АКК, ", _цел_стр(бит2)))
            а если пкл2.знач == 0:
                ген.пиши("ПЕР АКК, 0")
            а если бит2 < 0:
                ген.пиши(_склей2("УМН АКК, АКК, ", имм2))
            # бит2 == 0 — 1*x: значение уже в АКК
        а если стр_равны(оп, "&"):
            ген.пиши(_склей2("И АКК, ", имм2))
        а если стр_равны(оп, "|"):
            ген.пиши(_склей2("ИЛИ АКК, ", имм2))
        иначе:
            ген.пиши(_склей2("ИИЛИ АКК, ", имм2))
        верни тип_л
    ген.выр(выр.а)
    ген.пиши("ВСТЕК АКК")
    ген.глуб += 1
    ген.выр(выр.б)
    ген.пиши("ПЕР СЧТ, АКК")
    ген.пиши("ИЗСТЕКА АКК")
    ген.глуб -= 1
    если стр_равны(оп, "+"):
        ген.пиши("ДОБ АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "-"):
        ген.пиши("ВЫЧ АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "&"):
        ген.пиши("И АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "|"):
        ген.пиши("ИЛИ АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "^"):
        ген.пиши("ИИЛИ АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "*"):
        ген.пиши("УМН АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "/") или стр_равны(оп, "%"):
        если т_знаковый(ген.реш_тип(тип_л)):
            ген.пиши("РАСШ")
            ген.пиши("ДЕЛ СЧТ")
        иначе:
            ген.пиши("ПЕР ДАН, 0")
            ген.пиши("ДЕЛБ СЧТ")
        если стр_равны(оп, "%"):
            ген.пиши("ПЕР АКК, ДАН")
        верни тип_л
    если стр_равны(оп, "<<"):
        ген.пиши("СДЛ АКК, СЧТБ")
        верни тип_л
    если стр_равны(оп, ">>"):
        если т_знаковый(ген.реш_тип(тип_л)):
            ген.пиши("СДПА АКК, СЧТБ")
        иначе:
            ген.пиши("СДП АКК, СЧТБ")
        верни тип_л
    ген_ош(_склей2("неизвестный оператор ", оп), выр.строка)
    верни т_любой()

открыто функ (ген *Ген) бин_вещ(выр *Узел, оп стр) *Узел:
    # скалярная f32|f64: левый спилливается, правый идёт в ПЛАВ1
    тип_л *Узел = ген.реш_тип(ген.тип_выр(выр.а))
    суф стр = _вещ_суф(тип_л)
    разд стр = _вещ_раз(тип_л)
    ген.выр(выр.а)
    ген.пиши("ВЫЧ УКС, 8")
    ген.пиши(_склей4("ПЕРВ", суф, " ", _склей3(разд, "[УКС]", ", ПЛАВ0")))
    ген.глуб += 1
    ген.выр(выр.б)
    ген.пиши(_склей3("ПЕРВ", суф, " ПЛАВ1, ПЛАВ0"))
    ген.пиши(_склей4("ПЕРВ", суф, " ПЛАВ0, ", _склей2(разд, "[УКС]")))
    ген.пиши("ДОБ УКС, 8")
    ген.глуб -= 1
    если _это_сравн(оп):
        # ucomisd/ucomiss: неупорядоченное (NaN) выставляет ZF=PF=CF=1.
        # «==»/«<»/«<=» маскируются по PF (NaN → ложь), «!=» — наоборот;
        # «>»/«>=» без маски уже ложны на NaN.
        ген.пиши(_склей3("СРАВВ", суф, " ПЛАВ0, ПЛАВ1"))
        если стр_равны(оп, "!="):
            ген.пиши("УСТНЕРАВНО АККБ")
            ген.пиши("УСТЧЁТ СЧТБ")
            ген.пиши("ИЛИ АККБ, СЧТБ")
        иначе:
            если стр_равны(оп, "=="):
                ген.пиши("УСТРАВНО АККБ")
            а если стр_равны(оп, "<"):
                ген.пиши("УСТНИЖЕ АККБ")
            а если стр_равны(оп, "<="):
                ген.пиши("УСТНИЖРАВ АККБ")
            а если стр_равны(оп, ">"):
                ген.пиши("УСТВЫШЕ АККБ")
            иначе:
                ген.пиши("УСТВЫШРАВ АККБ")
            если стр_равны(оп, "<") или стр_равны(оп, "<=") или стр_равны(оп, "=="):
                ген.пиши("УСТНЕЧЁТ СЧТБ")
                ген.пиши("И АККБ, СЧТБ")
        ген.пиши("БЕЗРАСШ АКК, АККБ")
        верни т_бул()
    если стр_равны(оп, "+"):
        ген.пиши(_склей3("ДОБВ", суф, " ПЛАВ0, ПЛАВ1"))
    а если стр_равны(оп, "-"):
        ген.пиши(_склей3("ВЫЧВ", суф, " ПЛАВ0, ПЛАВ1"))
    а если стр_равны(оп, "*"):
        ген.пиши(_склей3("УМНВ", суф, " ПЛАВ0, ПЛАВ1"))
    а если стр_равны(оп, "/"):
        ген.пиши(_склей3("ДЕЛВ", суф, " ПЛАВ0, ПЛАВ1"))
    иначе:
        ген_ош(_склей2("оператор не для вещественных: ", оп), выр.строка)
    верни т_вещ(тип_л.знач2)

открыто функ _лейн_суф(разм размер) стр:
    # суффикс лейна целых пакетных команд: байт/слово/двслово/квад
    если разм == 1:
        верни "Б"
    если разм == 2:
        верни "С"
    если разм == 4:
        верни "Д"
    верни "К"

открыто функ (ген *Ген) век_маска_тип(тип_в *Узел, строка размер) *Узел:
    # тип маски сравнения: век нат.<бит лейна> х N
    элем *Узел = ген.век_эл(тип_в)
    маск *Узел = узел(У_ТИП, строка)
    маск.знач = ТВ_БЕЗ
    маск.знач2 = (ген.размер(элем) * 8) как нат.верх
    маск.текст = _склей2("без", _цел_стр(маск.знач2 как цел.верх))
    верни т_век(маск, тип_в.знач2)

открыто функ (ген *Ген) век_сравн(выр *Узел, оп стр, тип_в *Узел) *Узел:
    # сравнение векторов -> вектор-маска (все биты лейна 0|1)
    элем *Узел = ген.век_эл(тип_в)
    если элем.знач == ТВ_ВЕЩ:
        суф стр = _век_суф(элем)
        имм цел.верх = -1
        если стр_равны(оп, "=="):
            имм = 0
        а если стр_равны(оп, "!="):
            имм = 4
        а если стр_равны(оп, "<"):
            имм = 1
        а если стр_равны(оп, "<="):
            имм = 2
        если стр_равны(оп, ">") или стр_равны(оп, ">="):
            # a>b <=> b<a: считаем на месте ПЛАВ1 и переносим в ПЛАВ0
            имм = 1
            если стр_равны(оп, ">="):
                имм = 2
            ген.пиши(_склей4("СРАВП", суф, " ПЛАВ1, ПЛАВ0, ",
                _цел_стр(имм)))
            ген.пиши(_склей3("ПЕРП", суф, " ПЛАВ0, ПЛАВ1"))
        иначе:
            ген.пиши(_склей4("СРАВП", суф, " ПЛАВ0, ПЛАВ1, ",
                _цел_стр(имм)))
    иначе:
        лс стр = _лейн_суф(ген.размер(элем))
        если стр_равны(лс, "К"):
            ген_ош("сравнение векторов с 64-битными целыми лейнами пока не поддержано",
                выр.строка)
        если стр_равны(оп, "=="):
            ген.пиши(_склей3("ПСРАВ", лс, " ПЛАВ0, ПЛАВ1"))
        а если стр_равны(оп, "!="):
            ген.пиши(_склей3("ПСРАВ", лс, " ПЛАВ0, ПЛАВ1"))
            ген.пиши("ПСРАВД ПЛАВ1, ПЛАВ1")     # все единицы
            ген.пиши("ПИИЛИ ПЛАВ0, ПЛАВ1")     # инверсия маски
        а если стр_равны(оп, ">") или стр_равны(оп, "<"):
            если элем.знач != ТВ_ЦЕЛ:
                ген_ош("упорядоченное сравнение целых векторов — только знаковые лейны",
                    выр.строка)
            если стр_равны(оп, ">"):
                ген.пиши(_склей3("ПБОЛЬ", лс, " ПЛАВ0, ПЛАВ1"))
            иначе:
                ген.пиши(_склей3("ПБОЛЬ", лс, " ПЛАВ1, ПЛАВ0"))
                ген.пиши("ПЕРЦВ ПЛАВ0, ПЛАВ1")
        иначе:
            ген_ош(_склей2("сравнение целых векторов не поддержано: ", оп),
                выр.строка)
    верни ген.век_маска_тип(тип_в, выр.строка)

открыто функ (ген *Ген) век_оп(оп стр, элем *Узел, дст стр, ист стр,
             строка размер):
    # поэлементная арифметика/битовая операция: дст = дст <оп> ист
    если стр_равны(оп, "&"):
        ген.пиши(_склей4("ПИ ", дст, ", ", ист))
        верни
    если стр_равны(оп, "|"):
        ген.пиши(_склей4("ПИЛИ ", дст, ", ", ист))
        верни
    если стр_равны(оп, "^"):
        ген.пиши(_склей4("ПИИЛИ ", дст, ", ", ист))
        верни
    если элем.знач == ТВ_ВЕЩ:
        суф стр = _век_суф(элем)
        если стр_равны(оп, "+"):
            ген.пиши(_склей4("ДОБП", суф, " ", _склей3(дст, ", ", ист)))
        а если стр_равны(оп, "-"):
            ген.пиши(_склей4("ВЫЧП", суф, " ", _склей3(дст, ", ", ист)))
        а если стр_равны(оп, "*"):
            ген.пиши(_склей4("УМНП", суф, " ", _склей3(дст, ", ", ист)))
        а если стр_равны(оп, "/"):
            ген.пиши(_склей4("ДЕЛП", суф, " ", _склей3(дст, ", ", ист)))
        иначе:
            ген_ош(_склей2("оператор не для вещественных векторов: ", оп),
                строка)
        верни
    лс стр = _лейн_суф(ген.размер(элем))
    если стр_равны(оп, "+"):
        ген.пиши(_склей4("ПДОБ", лс, " ", _склей3(дст, ", ", ист)))
    а если стр_равны(оп, "-"):
        ген.пиши(_склей4("ПВЫЧ", лс, " ", _склей3(дст, ", ", ист)))
    а если стр_равны(оп, "*"):
        если не стр_равны(лс, "С"):
            ген_ош("поэлементное умножение целых — только лейны-слова (16 бит)",
                строка)
        ген.пиши(_склей4("ПУМНС ", дст, ", ", ист))
    иначе:
        ген_ош(_склей2("оператор не для целых векторов: ", оп), строка)

открыто функ (ген *Ген) бин_век(выр *Узел, оп стр, тип_в *Узел) *Узел:
    # поэлементная операция: левый спилливается в ОКВАД[УКС]; для
    # коммутативных операций он же — источник m128, для прочих — ПЛАВ1
    элем *Узел = ген.век_эл(тип_в)
    под стр = _век_под(элем)
    ген.выр(выр.а)
    # опкоды с m128 требуют выравнивания по 16: при нечётной глубине
    # стека резервируем 24 байта вместо 16 — слот остаётся выровненным
    сдвиг размер = 16
    если ген.глуб % 2 != 0:
        сдвиг = 24
    сдвиг_с стр = _цел_стр(сдвиг как цел.верх)
    ген.пиши(_склей2("ВЫЧ УКС, ", сдвиг_с))
    ген.пиши(_склей2(под, " ОКВАД[УКС], ПЛАВ0"))
    ген.глуб += сдвиг / 8
    ген.выр(выр.б)
    если (стр_равны(оп, "+") или стр_равны(оп, "*") или
       стр_равны(оп, "&") или стр_равны(оп, "|") или стр_равны(оп, "^")):
        ген.пиши(_склей2("ДОБ УКС, ", сдвиг_с))
        ген.глуб -= сдвиг / 8
        ген.век_оп(оп, элем, "ПЛАВ0",
            _склей3("ОКВАД[УКС-", сдвиг_с, "]"), выр.строка)
        верни тип_в
    ген.пиши(_склей2(под, " ПЛАВ1, ПЛАВ0"))
    ген.пиши(_склей2(под, " ПЛАВ0, ОКВАД[УКС]"))
    ген.пиши(_склей2("ДОБ УКС, ", сдвиг_с))
    ген.глуб -= сдвиг / 8
    если _это_сравн(оп):
        верни ген.век_сравн(выр, оп, тип_в)
    ген.век_оп(оп, элем, "ПЛАВ0", "ПЛАВ1", выр.строка)
    верни тип_в

открыто функ (ген *Ген) проверка_диапазона(выр *Узел) *Узел:
    диап *Узел = выр.б
    ложь стр = ген.новая("диап_вне")
    конец стр = ген.новая("диап_конец")
    ген.выр(выр.а)
    ген.пиши("ВСТЕК АКК")
    ген.глуб += 1
    ген.выр(диап.а)
    ген.пиши("ВСТЕК АКК")
    ген.глуб += 1
    ген.выр(диап.б)
    ген.пиши("ПЕР ДАН, АКК")
    ген.пиши("ИЗСТЕКА СЧТ")
    ген.пиши("ИЗСТЕКА АКК")
    ген.глуб -= 2
    беззн лог = не т_знаковый(ген.реш_тип(ген.тип_выр(выр.а)))
    м_меньше стр = "МЕНЬШЕ"
    м_больше стр = "БОЛЬШЕ"
    м_болрав стр = "БОЛРАВ"
    если беззн:
        м_меньше = "НИЖЕ"
        м_больше = "ВЫШЕ"
        м_болрав = "ВЫШРАВ"
    ген.пиши("СРАВ АКК, СЧТ")
    ген.пиши(_склей3(м_меньше, " ", ложь))
    ген.пиши("СРАВ АКК, ДАН")
    если диап.знач2 == 1:
        ген.пиши(_склей3(м_больше, " ", ложь))
    иначе:
        ген.пиши(_склей3(м_болрав, " ", ложь))
    ген.пиши("ПЕР АКК, 1")
    ген.пиши(_склей2("ПРЫГ ", конец))
    ген.метка(ложь)
    ген.пиши("ПЕР АКК, 0")
    ген.метка(конец)
    верни т_бул()

