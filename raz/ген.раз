открыто функ (ген *Ген) размер(тип_уз *Узел) размер:
    тип_уз = ген.реш_тип(тип_уз)
    вид нат.верх = тип_уз.знач
    если вид == ТВ_МАСС:
        верни ген.размер(тип_уз.а) * тип_уз.знач2
    если вид == ТВ_ИМЯ:
        зап *ГЗапись = ген.запись_ищи(тип_уз.текст)
        если зап == пусто:
            ген_ош(_склей2("неизвестная запись ", тип_уз.текст), тип_уз.строка)
        верни зап.разм
    если вид == ТВ_СТР или вид == ТВ_СРЕЗ или вид == ТВ_УКАЗ или вид == ТВ_ФУНК или вид == ТВ_ЛЮБОЙ:
        верни 8
    если вид == ТВ_ВЕЩ:
        # разрядность хранится в знач2 (32=f32, 64=f64)
        верни (тип_уз.знач2 / 8) как размер
    если вид == ТВ_ВЕК:
        # один xmm: |лейн| * N == 16; недоступная ширина — ошибка, не разворот
        элем *Узел = ген.реш_тип(тип_уз.а)
        если элем.знач != ТВ_ВЕЩ и элем.знач != ТВ_ЦЕЛ и элем.знач != ТВ_БЕЗ:
            ген_ош(_склей2("элемент век должен быть целым или вещественным, получено ",
                ген.имя_типа(элем)), тип_уз.строка)
        бит размер = (ген.размер(элем) * 8) как размер
        если бит * тип_уз.знач2 != 128:
            ген_ош(_склей4("век ", ген.имя_типа(элем), " х ",
                _склей2(_цел_стр(тип_уз.знач2 как цел.верх),
                ": суммарная ширина должна быть 128 бит")), тип_уз.строка)
        верни 16
    если вид == ТВ_ЦЕЛ или вид == ТВ_БЕЗ:
        # разрядность хранится в знач2 (парсер проставляет при разборе имени)
        верни (тип_уз.знач2 / 8) как размер
    если вид == ТВ_БУЛ или вид == ТВ_СИМ:
        верни 1
    верни 0

открыто функ (ген *Ген) загрузить(операнд стр, тип_уз *Узел):
    тип_р *Узел = ген.реш_тип(тип_уз)
    если _это_вещ(тип_р):
        ген.пиши(_склей4("ПЕРВ", _вещ_суф(тип_р), " ПЛАВ0, ",
            _склей2(_вещ_раз(тип_р), операнд)))
        верни
    если _это_век(тип_р):
        ген.пиши(_склей3(_век_под(ген.век_эл(тип_р)), " ПЛАВ0, ОКВАД",
            операнд))
        верни
    разм размер = ген.размер(тип_уз)
    если разм >= 8:
        ген.пиши(_склей2("ПЕР АКК, ", операнд))
    а если разм == 4:
        если т_знаковый(ген.реш_тип(тип_уз)):
            ген.пиши(_склей2("ЗНАКРАСШД АКК, ДВСЛОВО", операнд))
        иначе:
            ген.пиши(_склей2("ПЕР АККМ, ", операнд))
    а если разм == 2:
        если т_знаковый(ген.реш_тип(тип_уз)):
            ген.пиши(_склей2("ЗНАКРАСШ АКК, СЛОВО", операнд))
        иначе:
            ген.пиши(_склей2("БЕЗРАСШ АКК, СЛОВО", операнд))
    иначе:
        если т_знаковый(ген.реш_тип(тип_уз)):
            ген.пиши(_склей2("ЗНАКРАСШ АКК, БАЙТ", операнд))
        иначе:
            ген.пиши(_склей2("БЕЗРАСШ АКК, БАЙТ", операнд))
    если ген.реш_тип(тип_уз).знач == ТВ_БУЛ:
        ген.пиши("ПРОВ АКК, АКК")
        ген.пиши("УСТНЕРАВНО АККБ")
        ген.пиши("БЕЗРАСШ АКК, АККБ")

открыто функ (ген *Ген) сохранить(операнд стр, тип_уз *Узел):
    тип_с *Узел = ген.реш_тип(тип_уз)
    если _это_вещ(тип_с):
        ген.пиши(_склей4("ПЕРВ", _вещ_суф(тип_с), " ",
            _склей3(_вещ_раз(тип_с), операнд, ", ПЛАВ0")))
        верни
    если _это_век(тип_с):
        ген.пиши(_склей3(_век_под(ген.век_эл(тип_с)), " ОКВАД",
            _склей2(операнд, ", ПЛАВ0")))
        верни
    если ген.реш_тип(тип_уз).знач == ТВ_БУЛ:
        ген.пиши("ПРОВ АКК, АКК")
        ген.пиши("УСТНЕРАВНО АККБ")
        ген.пиши("БЕЗРАСШ АКК, АККБ")
    разм размер = ген.размер(тип_уз)
    если разм > 8:
        разм = 8
    если разм == 0:
        разм = 8
    если разм == 8:
        ген.пиши(_склей3("ПЕР ", операнд, ", АКК"))
    а если разм == 4:
        ген.пиши(_склей3("ПЕР ", операнд, ", АККМ"))
    а если разм == 2:
        ген.пиши(_склей3("ПЕР ", операнд, ", АККП"))
    иначе:
        ген.пиши(_склей3("ПЕР ", операнд, ", АККБ"))

