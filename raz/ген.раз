функ (г *Ген) счёт_бамп(имя стр, вес без64):
    для i в 0..г.счёты.длина:
        с := список_получи(г.счёты, i) как *ГСчёт
        если стр_равны(с.имя, имя):
            с.n += вес
            верни
    с *ГСчёт = новый(ГСчёт)
    с.имя = имя
    с.n = вес
    список_добавь(г.счёты, с как без64)

функ (г *Ген) счёт_найди(имя стр) без64:
