функ (ген *Ген) для_(оператор *Узел):
    если оператор.а.вид == У_ДИАП:
        имя_у *Узел = список_получи(оператор.дети, 0) как *Узел
        лок *ГСим = ген.локал_ищи(имя_у.текст)
        пр *ГСим = ген.локал_ищи(оператор.текст2)
        вниз лог = нет
        если ген.конст_ли(оператор.а.а) и ген.конст_ли(оператор.а.б):
            вниз = ген.конст(оператор.а.а) > ген.конст(оператор.а.б)
        ген.выр(оператор.а.а)
        ген.сохранить(_слот(лок), т_цел64())
        ген.выр(оператор.а.б)
        ген.сохранить(_слот(пр), т_цел64())
        нач стр = ген.новая("для_начало")
        шаг стр = ген.новая("для_шаг")
        кон стр = ген.новая("для_конец")
        цикл *ГЦикл = новый(ГЦикл)
        цикл.шаг = шаг
        цикл.кон = кон
        список_добавь(ген.циклы, цикл как нат.верх)
        ген.метка(нач)
        ген.пиши(_склей2("ПЕР АКК, ", _слот(лок)))
        ген.пиши(_склей2("СРАВ АКК, ", _слот(пр)))
        если вниз:
            если оператор.а.знач2 == 1:
                ген.пиши(_склей2("МЕНЬШЕ ", кон))
            иначе:
                ген.пиши(_склей2("МЕНРАВ ", кон))
        иначе:
            если оператор.а.знач2 == 1:
                ген.пиши(_склей2("БОЛЬШЕ ", кон))
            иначе:
                ген.пиши(_склей2("БОЛРАВ ", кон))
        если оператор.дети2 != пусто:
            для инд2 в 0..оператор.дети2.длина:
                ген.оп(список_получи(оператор.дети2, инд2) как *Узел)
        ген.метка(шаг)
        если вниз:
            ген.пиши(_склей2("УМЕН ", _слот_кв(лок)))
        иначе:
            ген.пиши(_склей2("УВЕЛ ", _слот_кв(лок)))
        ген.пиши(_склей2("ПРЫГ ", нач))
        ген.метка(кон)
        ген.циклы.длина -= 1
        верни
    # для по массиву/срезу
    имя_инд *Узел = список_получи(оператор.дети, 0) как *Узел
    л_инд *ГСим = ген.локал_ищи(имя_инд.текст)
    пр = ген.локал_ищи(оператор.текст2)
    т_ит *Узел = ген.реш_тип(ген.тип_выр(оператор.а))
    если т_ит.знач == ТВ_МАСС:
        ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(т_ит.знач2 как цел.верх)))
        ген.сохранить(_слот(пр), т_цел64())
    а если т_ит.знач == ТВ_СРЕЗ:
        ген.выр(оператор.а)
        ген.пиши("ПЕР АКК, [АКК+8]")
        ген.сохранить(_слот(пр), т_цел64())
    иначе:
        ген_ош("«для в» — по диапазону, массиву или срезу", оператор.строка)
    ген.пиши("ПЕР АКК, 0")
    ген.сохранить(_слот(л_инд), т_цел64())
    нач = ген.новая("для_начало")
    шаг = ген.новая("для_шаг")
    кон = ген.новая("для_конец")
    цикл = новый(ГЦикл)
    цикл.шаг = шаг
    цикл.кон = кон
    список_добавь(ген.циклы, цикл как нат.верх)
    ген.метка(нач)
    ген.пиши(_склей2("ПЕР АКК, ", _слот(л_инд)))
    ген.пиши(_склей2("СРАВ АКК, ", _слот(пр)))
    ген.пиши(_склей2("БОЛРАВ ", кон))
    если оператор.дети.длина == 2:
        имя_э *Узел = список_получи(оператор.дети, 1) как *Узел
        л_э *ГСим = ген.локал_ищи(имя_э.текст)
        инд *Узел = узел(У_ИНДЕКС, оператор.строка)
        инд.а = оператор.а
        инд.б = имя_инд
        элем *Узел = ген.индекс_адрес(инд, 0)
        ген.загрузить("[АКК]", элем)
        ген.сохранить(_слот(л_э), ген.реш_тип(л_э.тип))
    если оператор.дети2 != пусто:
        для инд2 в 0..оператор.дети2.длина:
            ген.оп(список_получи(оператор.дети2, инд2) как *Узел)
    ген.метка(шаг)
    ген.пиши(_склей2("УВЕЛ ", _слот_кв(л_инд)))
    ген.пиши(_склей2("ПРЫГ ", нач))
    ген.метка(кон)
    ген.циклы.длина -= 1

функ (ген *Ген) выбор_(оператор *Узел):
    сл *ГСим = ген.локал_ищи(оператор.текст2)
    слот стр = _слот(сл)
    ген.выр(оператор.а)
    ген.сохранить(слот, т_цел64())
    конец стр = ген.новая("выбор_конец")
    метки *Список = список_новый()
    для инд в 0..оператор.дети.длина:
        список_добавь(метки, ген.новая("выбор_случай") как нат.верх)
    деф стр = конец
    если оператор.дети2 != пусто:
        деф = ген.новая("выбор_иначе")
    для инд в 0..оператор.дети.длина:
        вр *Узел = список_получи(оператор.дети, инд) как *Узел
        мт стр = список_получи(метки, инд) как стр
        если вр.дети != пусто:
            для инд2 в 0..вр.дети.длина:
                обр *Узел = список_получи(вр.дети, инд2) как *Узел
                если обр.вид == У_ДИАП:
                    ложь стр = ген.новая("выбор_мимо")
                    ген.пиши(_склей2("ПЕР АКК, ", слот))
                    ген.пиши("ВСТЕК АКК")
                    ген.глуб += 1
                    ген.выр(обр.а)
                    ген.пиши("ПЕР СЧТ, АКК")
                    ген.пиши("ИЗСТЕКА АКК")
                    ген.глуб -= 1
                    ген.пиши("СРАВ АКК, СЧТ")
                    ген.пиши(_склей2("МЕНЬШЕ ", ложь))
                    ген.пиши(_склей2("ПЕР АКК, ", слот))
                    ген.пиши("ВСТЕК АКК")
                    ген.глуб += 1
                    ген.выр(обр.б)
                    ген.пиши("ПЕР СЧТ, АКК")
                    ген.пиши("ИЗСТЕКА АКК")
                    ген.глуб -= 1
                    ген.пиши("СРАВ АКК, СЧТ")
                    если обр.знач2 == 1:
                        ген.пиши(_склей2("БОЛЬШЕ ", ложь))
                    иначе:
                        ген.пиши(_склей2("БОЛРАВ ", ложь))
                    ген.пиши(_склей2("ПРЫГ ", мт))
                    ген.метка(ложь)
                иначе:
                    ген.выр(обр)
                    ген.пиши(_склей2("СРАВ АКК, ", слот))
                    ген.пиши(_склей2("РАВНО ", мт))
    ген.пиши(_склей2("ПРЫГ ", деф))
    для инд в 0..оператор.дети.длина:
        вр = список_получи(оператор.дети, инд) как *Узел
        мт = список_получи(метки, инд) как стр
        ген.метка(мт)
        если вр.дети2 != пусто:
            для инд2 в 0..вр.дети2.длина:
                ген.оп(список_получи(вр.дети2, инд2) как *Узел)
        ген.пиши(_склей2("ПРЫГ ", конец))
    если оператор.дети2 != пусто:
        ген.метка(деф)
        для инд2 в 0..оператор.дети2.длина:
            ген.оп(список_получи(оператор.дети2, инд2) как *Узел)
    ген.метка(конец)

