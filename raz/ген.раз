функ (ген *Ген) стр_интерн(текст стр) нат.верх:
    номер нат.верх = ген.стр_сч
    ген.стр_сч += 1
    части *Список = список_новый()
    буф *Буфер = буф_новый()
    для поз в 0..текст.длина:
        байт нат.старт = текст.данные[поз]
        если байт == 34 или байт == 92 или байт < 32:
            если буф.длина > 0:
                список_добавь(части, _склей3("\"", буф_стр(буф), "\"") как нат.верх)
                буф = буф_новый()
            список_добавь(части, _цел_стр(байт как цел.верх) как нат.верх)
        иначе:
            буф_сим(буф, байт)
    если буф.длина > 0:
        список_добавь(части, _склей3("\"", буф_стр(буф), "\"") как нат.верх)
    список_добавь(части, "0" как нат.верх)
    буф_добавь(ген.данные, _склей3("стрд_", _цел_стр(номер как цел.верх), ": БАЙТ "))
    для инд в 0..части.длина:
        если инд > 0:
            буф_добавь(ген.данные, ", ")
        буф_добавь(ген.данные, список_получи(части, инд) как стр)
    буф_сим(ген.данные, 10)
    буф_добавь(ген.данные, _склей3("стр_", _цел_стр(номер как цел.верх), ": КВАД стрд_"))
    буф_добавь(ген.данные, _склей3(_цел_стр(номер как цел.верх), ", ", _цел_стр(текст.длина как цел.верх)))
    буф_сим(ген.данные, 10)
    верни номер

