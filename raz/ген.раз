открыто функ (ген *Ген) конст(выр *Узел) цел.верх:
    вид нат.верх = выр.вид
    если вид == У_ЧИСЛО:
        ген.конст_большое = выр.знач2 != 0
        верни выр.знач как цел.верх
    если вид == У_БУЛ:
        ген.конст_большое = нет
        верни выр.знач как цел.верх
    если вид == У_ИМЯ:
        конста *ГКонст = ген.конст_ищи(выр.текст)
        если конста != пусто:
            ген.конст_большое = конста.большое
            верни конста.знач
        эл *ГПоле = ген.переч_элем_ищи(выр.текст)
        если эл != пусто:
            ген.конст_большое = нет
            верни эл.смещ как цел.верх
        ген_ош(_склей2("константа не определена: ", выр.текст), выр.строка)
    если вид == У_ПОЛЕ:
        мк *ГКонст = ген.мод_конст(выр)
        если мк != пусто:
            ген.конст_большое = мк.большое
            верни мк.знач
    если вид == У_ПОЛЕ и выр.а != пусто и выр.а.вид == У_ИМЯ:
        переч *ГПереч = ген.переч_ищи(выр.а.текст)
        если переч != пусто:
            для инд в 0..переч.элементы.длина:
                элем *ГПоле = список_получи(переч.элементы, инд) как *ГПоле
                если стр_равны(элем.имя, выр.текст):
                    ген.конст_большое = нет
                    верни элем.смещ как цел.верх
    если вид == У_УН и стр_равны(выр.текст, "-"):
        рез цел.верх = 0 - ген.конст(выр.а)
        ген.конст_большое = нет
        верни рез
    если вид == У_ПРИВЕД:
        верни ген.конст(выр.а)
    если вид == У_РАЗМЕР:
        ген.конст_большое = нет
        если выр.знач2 == 1:
            верни ген.размер(выр.а) как цел.верх
        верни ген.размер(ген.тип_выр(выр.а)) как цел.верх
    если вид == У_БИН:
        лев цел.верх = ген.конст(выр.а)
        прав цел.верх = ген.конст(выр.б)
        ген.конст_большое = нет
        оп стр = выр.текст
        если стр_равны(оп, "+"):
            верни лев + прав
        если стр_равны(оп, "-"):
            верни лев - прав
        если стр_равны(оп, "*"):
            верни лев * прав
        если стр_равны(оп, "/"):
            если прав == 0:
                верни 0
            верни лев / прав
        если стр_равны(оп, "%"):
            если прав == 0:
                верни 0
            верни лев % прав
        если стр_равны(оп, "&"):
            верни лев & прав
        если стр_равны(оп, "|"):
            верни лев | прав
        если стр_равны(оп, "^"):
            верни лев ^ прав
        если стр_равны(оп, "<<"):
            верни лев << прав
        если стр_равны(оп, ">>"):
            верни лев >> прав
        если стр_равны(оп, "=="):
            верни (лев == прав) как цел.верх
        если стр_равны(оп, "!="):
            верни (лев != прав) как цел.верх
        если стр_равны(оп, "<"):
            верни (лев < прав) как цел.верх
        если стр_равны(оп, "<="):
            верни (лев <= прав) как цел.верх
        если стр_равны(оп, ">"):
            верни (лев > прав) как цел.верх
        если стр_равны(оп, ">="):
            верни (лев >= прав) как цел.верх
    ген_ош("не константное выражение", выр.строка)
    верни 0

открыто функ (ген *Ген) конст_ли(выр *Узел) лог:
    # истина, если выражение вычислимо во время компиляции
    если выр == пусто:
        верни нет
    вид нат.верх = выр.вид
    если вид == У_ЧИСЛО или вид == У_БУЛ:
        верни да
    если вид == У_ИМЯ:
        верни ген.конст_ищи(выр.текст) != пусто
    верни нет

