функ (г *Ген) объяви_запись(d *Узел):
    з *ГЗапись = новый(ГЗапись)
    з.имя = d.текст
    з.поля = список_новый()
    off без64 = 0
    для i в 0..d.дети.длина:
        п := список_получи(d.дети, i) как *Узел
        т := г.реш_тип(п.а)
        sz := г.размер(т)
        ал := sz
        если ал > 8:
            ал = 8
        если ал == 0:
            ал = 1
        off = (off + ал - 1) / ал * ал
        пл *ГПоле = новый(ГПоле)
        пл.имя = п.текст
        пл.смещ = off
        пл.тип = т
        список_добавь(з.поля, пл как без64)
        off += sz
    з.разм = (off + 7) / 8 * 8
    список_добавь(г.записи, з как без64)

функ _асм_имя(имя стр) стр:
    # «Точка.норма» -> «Точка_норма» (точка недопустима в метке)
    б := буф_новый()
    для i в 0..имя.длина:
        c := имя.данные[i]
        если c == '.':
            буф_сим(б, '_')
        иначе:
            буф_сим(б, c)
    верни буф_стр(б)

функ (г *Ген) функ_(f *Узел):
    г.локалы = список_новый()
    г.парамы = список_новый()
    г.циклы = список_новый()
    г.отложи = список_новый()
    г.счёты = список_новый()
    г.запреты = список_новый()
    г.рл_n = 0
    г.возвр = f.а
    парамы := список_новый()
    имя_асм := ""
    если f.в != пусто:
        rt := г.реш_тип(f.в.а)
        rec := ""
        если rt.знач == ТВ_УКАЗ:
            rec = г.реш_тип(rt.а).текст
        иначе:
            rec = rt.текст
        имя_асм = _к4("ф_", rec, "_", f.текст)
        прм0 := узел(У_ПАРАМ, f.строка)
        прм0.текст = f.в.текст
        прм0.а = т_указ(т_запись(rec))
        список_добавь(парамы, прм0 как без64)
        для i в 0..f.дети.длина:
            список_добавь(парамы, список_получи(f.дети, i))
    иначе:
        имя_асм = _к2("ф_", _асм_имя(f.текст))
        парамы = f.дети
    nreg := 4
    если г.цель == 1:
        nreg = 6
    np без64 = 0
    если парамы != пусто:
        np = парамы.длина
    # регистровые параметры — домашние слоты [УКК+16+8*i]; стековые —
    # выше тени: [УКК+16+8*nreg+8*(i-nreg)] (тень == 8*nreg на обеих целях)
    для i в 0..np:
        п := список_получи(парамы, i) как *Узел
        с *ГСим = новый(ГСим)
        с.имя = п.текст
        с.тип = п.а
        с.парам = да
        если (i как цел64) >= nreg:
            с.смещ = (16 + 8 * nreg + 8 * ((i как цел64) - nreg)) как без64
        иначе:
            с.смещ = (16 + 8 * i) как без64
        список_добавь(г.парамы, с как без64)
    # скан тела: локали, скрытые слоты, веса имён и запреты на регистры
    порядок := список_новый()
    имена := список_новый()
    г.скан_тело(f.дети2, порядок, имена, 0)
    off без64 = 8
    для i в 0..порядок.длина:
        ло := список_получи(порядок, i) как *ГЛок
        т := ло.тип
        если т == пусто:
            если ло.выр != пусто:
                т = г.тип_выр(ло.выр)
            иначе:
                т = т_цел64()
        т = г.реш_тип(т)
        sz := (г.размер(т) + 7) / 8 * 8
        если sz < 8:
            sz = 8
        с *ГСим = новый(ГСим)
        с.имя = ло.имя
        с.тип = т
        с.смещ = off + sz - 8
        список_добавь(г.локалы, с как без64)
        off += sz
    локалов := off - 8
    г.фрейм = (локалов + 15) / 16 * 16
    г.выход_м = г.новая("выход")
    # регистровые переменные: самые горячие скаляры по 8 байт без взятия
    # адреса и без упоминания в искра-блоках — в callee-saved регистрах
    канд := список_новый()
    для i в 0..г.парамы.длина:
        с := список_получи(г.парамы, i) как *ГСим
        если г.годен_рег(с):
            список_добавь(канд, с как без64)
    для i в 0..г.локалы.длина:
        с := список_получи(г.локалы, i) как *ГСим
        если г.годен_рег(с):
            список_добавь(канд, с как без64)
    для k в 0..5:
        лучший *ГСим = пусто как *ГСим
        лс без64 = 0
        для i в 0..канд.длина:
            с := список_получи(канд, i) как *ГСим
            c := г.счёт_найди(с.имя)
            если с.рег == 0 и c > лс:
                лучший = с
                лс = c
        если лучший == пусто:
            хватит
        лучший.рег = (k + 1) как без64
        г.рл_n += 1
    # пролог
    г.метка(имя_асм)
    г.е("ВСТЕК УКК")
    г.е("ПЕР УКК, УКС")
    если г.фрейм != 0:
        г.е(_к2("ВЫЧ УКС, ", _н(г.фрейм как цел64)))
    для k в 0..г.рл_n:
        г.е(_к2("ВСТЕК ", _рег_лок(k)))
    г.глуб += г.рл_n как цел64
    # домашнее сохранение регистровых параметров
    lim := np
    если (lim как цел64) > nreg:
        lim = nreg как без64
    для i в 0..lim:
        п := список_получи(парамы, i) как *Узел
        с := г.парам_ищи(п.текст)
        рег := _арг_рег(г.цель, i)
        sz := г.размер(п.а)
        если sz > 8:
            sz = 8
        если sz == 0:
            sz = 8
        регимя := рег
        если sz == 4:
            регимя = _к2(рег, "М")
        а если sz == 2:
            регимя = _к2(рег, "П")
        а если sz == 1:
            регимя = _к2(рег, "Б")
        если с.рег > 0:
            г.е(_к4("ПЕР ", _рег_лок(с.рег - 1), ", ", регимя))
        иначе:
            г.е(_к3(_к2("ПЕР ", _па(с.смещ)), ", ", регимя))
    # стековые параметры, попавшие в регистры — снимаем сразу
    ip без64 = nreg как без64
    пока ip < np:
        п2 := список_получи(парамы, ip) как *Узел
        с2 := г.парам_ищи(п2.текст)
        если с2.рег > 0:
            г.е(_к4("ПЕР ", _рег_лок(с2.рег - 1), ", ", _па(с2.смещ)))
        ip += 1
    # тело
    если f.дети2 != пусто:
        для i в 0..f.дети2.длина:
            г.оп(список_получи(f.дети2, i) как *Узел)
    # эпилог
    г.метка(г.выход_м)
    i2 := (г.отложи.длина как цел64) - 1
    пока i2 >= 0:
        г.выр(список_получи(г.отложи, i2 как без64) как *Узел)
        i2 -= 1
    k2 := г.рл_n как цел64
    пока k2 > 0:
        k2 -= 1
        г.е(_к2("ИЗСТЕКА ", _рег_лок(k2 как без64)))
    г.глуб -= г.рл_n как цел64
    г.е("ПОКИНЬ")
    г.е("ВОЗВРАТ")

функ (г *Ген) старт():
    г.метка("старт")
    если г.цель == 0:
        г.е("ВЫЧ УКС, 8")
        г.е("ВЫЗОВ ф_главная")
        г.е("ПЕР СЧТМ, АККМ")
        г.е("ВЫЗОВ ExitProcess")
    иначе:
        г.е("ВЫЗОВ ф_главная")
        г.е("ПЕР ПРМ, АКК")
        г.е("ПЕР АКК, 60")
        г.е("СИСВЫЗОВ")

функ (г *Ген) стд_хелперы():
    если г.цель == 0:
        если (г.нужны_стд & 1) != 0:
            г.метка("стд_выдели")
            г.е("ВСТЕК УКК")
            г.е("ПЕР УКК, УКС")
            г.е("ВЫЧ УКС, 48")
            г.е("ПЕР [УКС+32], СЧТ")
            г.е("ВЫЗОВ GetProcessHeap")
            г.е("ПЕР СЧТ, АКК")
            г.е("ПЕР ДАН, 8")
            г.е("ПЕР Р8, [УКС+32]")
            г.е("ДОБ Р8, 16")
            г.е("ВЫЗОВ HeapAlloc")
            г.е("ПРОВ АКК, АКК")
            ок := г.новая("выдок")
            г.е(_к2("РАВНО ", ок))
            г.е("ПЕР СЧТ, [УКС+32]")
            г.е("ПЕР [АКК], СЧТ")
            г.е("ДОБ АКК, 16")
            г.метка(ок)
            г.е("ПОКИНЬ")
            г.е("ВОЗВРАТ")
        если (г.нужны_стд & 2) != 0:
            г.метка("стд_освободи")
            г.е("ВСТЕК УКК")
            г.е("ПЕР УКК, УКС")
            г.е("ВЫЧ УКС, 48")
            г.е("ПЕР [УКС+32], СЧТ")
            г.е("ВЫЗОВ GetProcessHeap")
            г.е("ПЕР СЧТ, АКК")
            г.е("ПЕР ДАН, 0")
            г.е("ПЕР Р8, [УКС+32]")
            г.е("ВЫЧ Р8, 16")
            г.е("ВЫЗОВ HeapFree")
            г.е("ПОКИНЬ")
            г.е("ВОЗВРАТ")
    иначе:
        если (г.нужны_стд & 1) != 0:
            г.метка("стд_выдели")
            г.е("ПЕР ИСТ, СЧТ")
            г.е("ДОБ ИСТ, 16")
            г.е("ВСТЕК ИСТ")
            г.е("ПЕР АКК, 9")
            г.е("ПЕР ПРМ, 0")
            г.е("ПЕР ДАН, 3")
            г.е("ПЕР Р10, 0x22")
            г.е("ПЕР Р8, -1")
            г.е("ПЕР Р9, 0")
            г.е("СИСВЫЗОВ")
            г.е("ИЗСТЕКА ИСТ")
            г.е("ПЕР [АКК], ИСТ")
            г.е("ДОБ АКК, 16")
            г.е("ВОЗВРАТ")
        если (г.нужны_стд & 2) != 0:
            г.метка("стд_освободи")
            г.е("ВЫЧ СЧТ, 16")
            г.е("ПЕР ИСТ, [СЧТ]")
            г.е("ПЕР ПРМ, СЧТ")
            г.е("ПЕР АКК, 11")
            г.е("СИСВЫЗОВ")
            г.е("ВОЗВРАТ")

