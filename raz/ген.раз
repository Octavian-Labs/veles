функ (г *Ген) генерируй(прог *Узел) стр:
    # проход 1: типы и сигнатуры
    для di в 0..прог.дети.длина:
        d := список_получи(прог.дети, di) как *Узел
        v := d.вид
        если v == У_ЗАПИСЬ:
            г.объяви_запись(d)
        а если v == У_ТИПСИН:
            с *ГСин = новый(ГСин)
            с.имя = d.текст
            с.тип = d.а
            список_добавь(г.синонимы, с как без64)
        а если v == У_КОНСТ:
            к *ГКонст = новый(ГКонст)
            к.имя = d.текст
            к.знач = г.конст(d.а)
            к.большое = г.конст_большое
            список_добавь(г.консты, к как без64)
        а если v == У_ПЕРЕЧ:
            п *ГПереч = новый(ГПереч)
            п.имя = d.текст
            п.элементы = список_новый()
            для i в 0..d.дети.длина:
                э := список_получи(d.дети, i) как *Узел
                пл *ГПоле = новый(ГПоле)
                пл.имя = э.текст
                пл.смещ = э.знач
                список_добавь(п.элементы, пл как без64)
            список_добавь(г.перечи, п как без64)
        а если v == У_ВНЕШ:
            г.имп_добавь(d.текст2, d.текст)
            ф *ГФунк = новый(ГФунк)
            ф.имя = d.текст
            ф.асм = d.текст
            ф.парамы = d.дети
            ф.возвр = d.а
            ф.внеш = 1
            список_добавь(г.функции, ф как без64)
        а если v == У_ФУНК:
            если d.в != пусто:
                rt := г.реш_тип(d.в.а)
                rec := ""
                если rt.знач == ТВ_УКАЗ:
                    бр := г.реш_тип(rt.а)
                    если бр.знач != ТВ_ИМЯ:
                        ген_ош("приёмник метода — запись или *запись",
                               d.строка)
                    rec = бр.текст
                а если rt.знач == ТВ_ИМЯ:
                    rec = rt.текст
                иначе:
                    ген_ош("приёмник метода — запись или *запись", d.строка)
                парамы := список_новый()
                прм0 := узел(У_ПАРАМ, d.строка)
                прм0.текст = d.в.текст
                прм0.а = т_указ(т_запись(rec))
                список_добавь(парамы, прм0 как без64)
                для i в 0..d.дети.длина:
                    список_добавь(парамы, список_получи(d.дети, i))
                м *ГМетод = новый(ГМетод)
                м.запись = rec
                м.имя = d.текст
                м.асм = _к4("ф_", rec, "_", d.текст)
                м.парамы = парамы
                м.возвр = d.а
                список_добавь(г.методы, м как без64)
                ф *ГФунк = новый(ГФунк)
                ф.имя = _к3(rec, ".", d.текст)
                ф.асм = м.асм
                ф.парамы = парамы
                ф.возвр = d.а
                ф.внеш = 0
                список_добавь(г.функции, ф как без64)
            иначе:
                ф *ГФунк = новый(ГФунк)
                ф.имя = d.текст
                ф.асм = _к2("ф_", _асм_имя(d.текст))
                ф.парамы = d.дети
                ф.возвр = d.а
                ф.внеш = 0
                список_добавь(г.функции, ф как без64)
    # автоматический импорт завершения
    если г.цель == 0:
        г.имп_добавь("kernel32", "ExitProcess")
    # проход 2: код функций
    для di в 0..прог.дети.длина:
        d := список_получи(прог.дети, di) как *Узел
        если d.вид == У_ФУНК:
            если стр_равны(d.текст, "главная"):
                г.есть_главная = 1
            г.функ_(d)
    если г.цель == 0 и г.нужны_стд != 0:
        г.имп_добавь("kernel32", "GetProcessHeap")
        г.имп_добавь("kernel32", "HeapAlloc")
        г.имп_добавь("kernel32", "HeapFree")
    г.стд_хелперы()
    если г.есть_главная != 0:
        г.старт()
    иначе:
        ген_ош("программе нужна функция «главная»", 0)
    # сборка текста
    вых := буф_новый()
    если г.цель == 1:
        буф_добавь(вых, ";цель linux\n")
    буф_добавь(вых, "; сгенерировано компилятором РАЗУМ\nСЕКЦИЯ код\n")
    для i в 0..г.импорты.длина:
        и := список_получи(г.импорты, i) как *ГИмп
        буф_добавь(вых, _к3("ИМПОРТ \"", и.длл, "\" "))
        для j в 0..и.имена.длина:
            если j > 0:
                буф_добавь(вых, ", ")
            буф_добавь(вых, список_получи(и.имена, j) как стр)
        буф_сим(вых, 10)
    если г.есть_главная != 0:
        буф_добавь(вых, "ВХОД старт\n")
    если г.опт > 0:
        буф_добавь(вых, опт_код(буф_стр(г.код)))
    иначе:
        буф_добавь(вых, буф_стр(г.код))
    если г.данные.длина > 0:
        буф_добавь(вых, "СЕКЦИЯ данные\n")
        буф_добавь(вых, буф_стр(г.данные))
    верни буф_стр(вых)
