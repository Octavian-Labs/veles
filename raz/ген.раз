открыто функ (ген *Ген) тип_выр(выр *Узел) *Узел:
    вид нат.верх = выр.вид
    если вид == У_ЧИСЛО:
        верни т_цел64()
    если вид == У_ВЕЩ:
        если выр.знач2 == 32:
            верни т_вещ32()
        верни т_вещ64()
    если вид == У_СТР:
        верни т_стр()
    если вид == У_БУЛ:
        верни т_бул()
    если вид == У_ПУСТО:
        верни т_указ(т_пусто())
    если вид == У_ИМЯ:
        лок *ГСим = ген.локал_ищи(выр.текст)
        если лок != пусто:
            верни лок.тип
        псим *ГСим = ген.парам_ищи(выр.текст)
        если псим != пусто:
            верни псим.тип
        если ген.конст_ищи(выр.текст) != пусто:
            верни т_цел64()
        функц *ГФунк = ген.функ_ищи(выр.текст)
        если функц != пусто:
            тп *Список = список_новый()
            для инд в 0..функц.парамы.длина:
                прм *Узел = список_получи(функц.парамы, инд) как *Узел
                список_добавь(тп, прм.а как размер)
            верни т_функ(тп, функц.возвр)
        если ген.переч_элем_ищи(выр.текст) != пусто:
            верни т_цел64()
        ген_ош(_склей2("неизвестное имя ", выр.текст), выр.строка)
    если вид == У_БИН:
        оп стр = выр.текст
        если стр_равны(оп, "и") или стр_равны(оп, "или"):
            ген.требуй_логические_операнды(выр)
            верни т_бул()
        лт0 *Узел = ген.реш_тип(ген.тип_выр(выр.а))
        пт0 *Узел = ген.реш_тип(ген.тип_выр(выр.б))
        если _это_век(лт0) или _это_век(пт0):
            # сравнение векторов — вектор-маска; остальные операции — тот же вектор
            если _это_сравн(оп) и _это_век(лт0):
                верни ген.век_маска_тип(лт0, выр.строка)
            верни лт0
        если _это_сравн(оп) или стр_равны(оп, "в"):
            верни т_бул()
        # вещественная операция: литералы принимают уровень другого операнда
        лт *Узел = лт0
        пт *Узел = пт0
        если _это_вещ(лт) и _это_вещ(пт):
            если _пометь_лит(выр.а, пт.знач2):
                лт = пт
            если _пометь_лит(выр.б, лт.знач2):
                пт = лт
            верни лт
        верни ген.тип_выр(выр.а)
    если вид == У_УН:
        если стр_равны(выр.текст, "не"):
            ген.требуй_логические_операнды(выр)
            верни т_бул()
        верни ген.тип_выр(выр.а)
    если вид == У_АДРЕС:
        верни т_указ(ген.тип_выр(выр.а))
    если вид == У_РАЗЫМ:
        тип_уз *Узел = ген.реш_тип(ген.тип_выр(выр.а))
        если тип_уз.знач != ТВ_УКАЗ:
            ген_ош("разыменование не-указателя", выр.строка)
        верни тип_уз.а
    если вид == У_ПОЛЕ:
        мф *ГФунк = ген.мод_функ(выр)
        если мф != пусто:
            мтп *Список = список_новый()
            для инд в 0..мф.парамы.длина:
                мпрм *Узел = список_получи(мф.парамы, инд) как *Узел
                список_добавь(мтп, мпрм.а как размер)
            верни т_функ(мтп, мф.возвр)
        если ген.мод_конст(выр) != пусто:
            верни т_цел64()
        если выр.а != пусто и выр.а.вид == У_ИМЯ и ген.переч_ищи(выр.а.текст) != пусто:
            верни т_цел64()
        тип_уз = ген.реш_тип(ген.тип_выр(выр.а))
        если (тип_уз.знач == ТВ_СТР или тип_уз.знач == ТВ_СРЕЗ):
            если стр_равны(выр.текст, "данные"):
                верни т_указ(т_без8())
            если стр_равны(выр.текст, "длина"):
                верни т_без64()
        если тип_уз.знач == ТВ_УКАЗ:
            тип_уз = ген.реш_тип(тип_уз.а)
            если (тип_уз.знач == ТВ_СТР или тип_уз.знач == ТВ_СРЕЗ):
                если стр_равны(выр.текст, "данные"):
                    верни т_указ(т_без8())
                если стр_равны(выр.текст, "длина"):
                    верни т_без64()
        если тип_уз.знач == ТВ_ИМЯ:
            зап *ГЗапись = ген.запись_ищи(тип_уз.текст)
            если зап != пусто:
                пл *ГПоле = поле_ищи(зап, выр.текст)
                если пл != пусто:
                    верни пл.тип
        ген_ош(_склей2("нет поля ", выр.текст), выр.строка)
    если вид == У_ИНДЕКС:
        тип_уз = ген.реш_тип(ген.тип_выр(выр.а))
        если (тип_уз.знач == ТВ_МАСС или тип_уз.знач == ТВ_СРЕЗ или
           тип_уз.знач == ТВ_УКАЗ или тип_уз.знач == ТВ_ВЕК):
            верни тип_уз.а
        если тип_уз.знач == ТВ_СТР:
            верни т_сим()
        ген_ош("индексация не-массива", выр.строка)
    если вид == У_СРЕЗ:
        тип_уз = ген.реш_тип(ген.тип_выр(выр.а))
        если тип_уз.знач == ТВ_СТР:
            верни т_срез(т_сим())
        если тип_уз.знач == ТВ_МАСС или тип_уз.знач == ТВ_СРЕЗ или тип_уз.знач == ТВ_УКАЗ:
            верни т_срез(тип_уз.а)
        ген_ош("срез не-массива", выр.строка)
    если вид == У_ЛИТТИП:
        верни ген.реш_тип(выр.а)
    если вид == У_ПРИВЕД:
        верни ген.тип_приведения(выр)
    если вид == У_РАЗМЕР:
        верни т_без64()
    если вид == У_НОВЫЙ:
        верни т_указ(выр.а)
    если вид == У_ПОВТОР:
        ст_повт *Узел = ген.тип_выр(выр.а)
        если ст_повт == пусто:
            верни пусто как *Узел
        если ст_повт.знач != ТВ_ЦЕЛ и ст_повт.знач != ТВ_БЕЗ и ст_повт.знач != ТВ_ВЕЩ:
            ген_ош("повтор: нужен числовой скаляр", выр.строка)
        верни т_век(ст_повт, 16 / ген.размер(ст_повт))
    если вид == У_СУММА:
        ст_сум *Узел = ген.тип_выр(выр.а)
        если ст_сум == пусто:
            верни пусто как *Узел
        если ст_сум.знач != ТВ_ВЕК:
            ген_ош("сумма: нужен вектор", выр.строка)
        верни ген.век_эл(ст_сум)
    если вид == У_МАКС или вид == У_МИН:
        лм *Узел = ген.реш_тип(ген.тип_выр(выр.а))
        пм *Узел = ген.реш_тип(ген.тип_выр(выр.б))
        если лм == пусто или пм == пусто:
            верни пусто как *Узел
        если лм.знач != ТВ_ВЕК или пм.знач != ТВ_ВЕК:
            ген_ош("макс/мин: нужны векторы", выр.строка)
        если не т_равны(лм, пм):
            ген_ош(_склей3("несовместимые векторы: ",
                ген.имя_типа(лм),
                _склей2(" и ", ген.имя_типа(пм))), выр.строка)
        если ген.век_эл(лм).знач != ТВ_ВЕЩ:
            ген_ош("макс/мин: пока только вещественные лейны", выр.строка)
        верни лм
    если вид == У_ВЫЗОВ:
        фу *Узел = выр.а
        если фу.вид == У_ПОЛЕ:
            мфв *ГФунк = ген.мод_функ(фу)
            если мфв != пусто:
                верни мфв.возвр
            мет *ГМетод = ген.метод_ищи(выр)
            если мет == пусто:
                ген_ош("вызов метода не найден", выр.строка)
            верни мет.возвр
        если фу.вид == У_ИМЯ:
            имя стр = фу.текст
            функц = ген.функ_ищи(имя)
            если функц != пусто:
                верни функц.возвр
            если стр_равны(имя, "освободи"):
                верни т_пусто()
            если стр_равны(имя, "выдели"):
                верни т_указ(т_без8())
            слот *ГСим = ген.локал_ищи(имя)
            если слот == пусто:
                слот = ген.парам_ищи(имя)
            если слот != пусто:
                ст *Узел = ген.реш_тип(слот.тип)
                если ст.знач == ТВ_ФУНК:
                    если ст.б != пусто:
                        верни ст.б
                    верни т_пусто()
        верни т_любой()
    если вид == У_ДИАП:
        ген_ош("диапазон допустим в «для», «выбор» и «в»", выр.строка)
    верни т_любой()

открыто функ _это_сравн(оп стр) лог:
    верни (стр_равны(оп, "==") или стр_равны(оп, "!=") или стр_равны(оп, "<") или
       стр_равны(оп, "<=") или стр_равны(оп, ">") или стр_равны(оп, ">="))

# степень двойки: номер бита или -1 (для СДЛ вместо УМН)
открыто функ _степень2(знач нат.верх) цел.верх:
    если знач == 0 или (знач & (знач - 1)) != 0:
        верни -1
    бит цел.верх = 0
    вр нат.верх = знач
    пока вр > 1:
        вр = вр >> 1
        бит += 1
    верни бит

# помещается ли значение в знаковый imm32 — предел непосредственных
# операндов x86-64 (ДОБ/ВЫЧ/СРАВ/И/ИЛИ/ИИЛИ/УМН …, имм)
открыто функ _в_имм32(знач нат.верх) лог:
    зн цел.верх = знач как цел.верх
    верни зн >= -2147483648 и зн <= 2147483647

# АКК += СЧТ * разм: масштаб SIB для 2/4/8, сдвиг или LEA-умножение
# для прочих степеней и 3/5/9, иначе imul с непосредственным
открыто функ _пиши_адр_сум(ген *Ген, разм размер):
    если разм == 2 или разм == 4 или разм == 8:
        ген.пиши(_склей3("АДР АКК, [АКК + СЧТ*",
            _цел_стр(разм как цел.верх), "]"))
        верни
    бит цел.верх = _степень2(разм как нат.верх)
    если разм == 3:
        ген.пиши("АДР СЧТ, [СЧТ + СЧТ*2]")
    а если разм == 5:
        ген.пиши("АДР СЧТ, [СЧТ + СЧТ*4]")
    а если разм == 9:
        ген.пиши("АДР СЧТ, [СЧТ + СЧТ*8]")
    а если бит > 0:
        ген.пиши(_склей2("СДЛ СЧТ, ", _цел_стр(бит)))
    а если разм != 1:
        ген.пиши(_склей2("УМН СЧТ, СЧТ, ", _цел_стр(разм как цел.верх)))
    ген.пиши("ДОБ АКК, СЧТ")

# дисплейсмент для SIB-операнда: « + N» / « - N» / «»
открыто функ _дисп_стр(дисп смещение) стр:
    если дисп == 0:
        верни ""
    если дисп > 0:
        верни _склей2(" + ", _цел_стр(дисп))
    верни _склей2(" - ", _цел_стр(-дисп))

# быстрый путь индексации: объект — простое имя локала/параметра.
# Возвращает регистр SIB-базы («УКК», «СЧТ» или сохраняемый регистр) и
# записывает дисплейсмент в *дисп; для указателя из слота сам эмитит
# «ПЕР СЧТ, слот». "" — имя не годится, нужен общий путь со стеком.
открыто функ (ген *Ген) индекс_база(выр *Узел, т_об *Узел,
   дисп *смещение) стр:
    если выр.вид != У_ИМЯ:
        верни ""
    сим *ГСим = ген.локал_ищи(выр.текст)
    если сим == пусто:
        сим = ген.парам_ищи(выр.текст)
    если сим == пусто:
        верни ""
    если сим.рег > 0:
        # регистровая переменная — только указатель (скаляр 8 байт)
        если т_об.знач != ТВ_УКАЗ:
            верни ""
        *дисп = 0
        верни _рег_лок(сим.рег - 1)
    если т_об.знач == ТВ_УКАЗ:
        # значение указателя лежит в слоте — грузим базу в СЧТ
        ген.пиши(_склей2("ПЕР СЧТ, ", _слот(сим)))
        *дисп = 0
        верни "СЧТ"
    # массив и век живут в кадре: база УКК, смещение — дисплейсмент;
    # массив-параметр копируется в слот выше УКК, век-параметр — ниже
    если сим.парам и т_об.знач == ТВ_МАСС:
        *дисп = сим.смещ
    иначе:
        *дисп = -сим.смещ
    верни "УКК"

# АКК = бр + АКК*разм + дисп — прямая SIB-адресация без стекового пробега
открыто функ (ген *Ген) адр_индекс(бр стр, дисп смещение, разм размер):
    если разм == 2 или разм == 4 или разм == 8:
        ген.пиши(_склей4("АДР АКК, [", бр,
            _склей2(" + АКК*", _цел_стр(разм как цел.верх)),
            _склей2(_дисп_стр(дисп), "]")))
        верни
    если разм > 1:
        бит цел.верх = _степень2(разм как нат.верх)
        если разм == 3:
            ген.пиши("АДР АКК, [АКК + АКК*2]")
        а если разм == 5:
            ген.пиши("АДР АКК, [АКК + АКК*4]")
        а если разм == 9:
            ген.пиши("АДР АКК, [АКК + АКК*8]")
        а если бит > 0:
            ген.пиши(_склей2("СДЛ АКК, ", _цел_стр(бит)))
        иначе:
            ген.пиши(_склей2("УМН АКК, АКК, ",
                _цел_стр(разм как цел.верх)))
    ген.пиши(_склей4("АДР АКК, [", бр, " + АКК",
        _склей2(_дисп_стр(дисп), "]")))

открыто функ _усл_сравн(оп стр, знак лог) стр:
    если стр_равны(оп, "=="):
        верни "УСТРАВНО"
    если стр_равны(оп, "!="):
        верни "УСТНЕРАВНО"
    если знак:
        если стр_равны(оп, "<"):
            верни "УСТМЕНЬШЕ"
        если стр_равны(оп, "<="):
            верни "УСТМЕНРАВ"
        если стр_равны(оп, ">"):
            верни "УСТБОЛЬШЕ"
        верни "УСТБОЛРАВ"
    если стр_равны(оп, "<"):
        верни "УСТНИЖЕ"
    если стр_равны(оп, "<="):
        верни "УСТНИЖРАВ"
    если стр_равны(оп, ">"):
        верни "УСТВЫШЕ"
    верни "УСТВЫШРАВ"

# --- выражения --------------------------------------------------------------------

открыто функ (ген *Ген) выр(выр *Узел) *Узел:
    вид нат.верх = выр.вид
    ген.стр_тек = выр.строка
    если вид == У_ЧИСЛО:
        если выр.знач2 != 0:
            ген.пиши(_склей2("ПЕР АКК, ", без_в_стр(выр.знач)))
        иначе:
            ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(выр.знач как цел.верх)))
        верни т_цел64()
    если вид == У_ВЕЩ:
        # знач2 помечается в совместим: 32 → вещ.рост, иначе вещ.верх
        форм нат.верх = 64
        если выр.знач2 == 32:
            форм = 32
        метка_в стр = ген.вещ_интерн(выр.текст, выр.строка, форм)
        разд стр = "КВАД"
        если форм == 32:
            разд = "ДВСЛОВО"
        суф стр = "Д"
        если форм == 32:
            суф = "С"
        ген.пиши(_склей4("ПЕРВ", суф, _склей2(" ПЛАВ0, ", _склей3(разд, "[", метка_в)), "]"))
        если форм == 32:
            верни т_вещ32()
        верни т_вещ64()
    если вид == У_СТР:
        метка стр = ген.стр_интерн(выр.текст)
        ген.пиши(_склей3("АДР АКК, [", метка, "]"))
        верни т_стр()
    если вид == У_БУЛ:
        ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(выр.знач как цел.верх)))
        верни т_бул()
    если вид == У_ПУСТО:
        ген.пиши("ПЕР АКК, 0")
        верни т_указ(т_пусто())
    если вид == У_ИМЯ:
        верни ген.выр_имя(выр)
    если вид == У_ПРИВЕД:
        тип_привед *Узел = ген.тип_приведения(выр)
        ст_исх *Узел = ген.реш_тип(ген.тип_выр(выр.а))
        цель_пр *Узел = ген.реш_тип(тип_привед)
        ген.выр(выр.а)
        если _это_вещ(цель_пр) и не _это_вещ(ст_исх):
            ген.пиши(_склей3("ЦЕЛВ", _вещ_суф(цель_пр), " ПЛАВ0, АКК"))
        а если _это_вещ(ст_исх) и не _это_вещ(цель_пр):
            ген.пиши(_склей3("ВЕЩЦ", _вещ_суф(ст_исх), " АКК, ПЛАВ0"))
        а если _это_вещ(ст_исх) и _это_вещ(цель_пр) и ст_исх.знач2 != цель_пр.знач2:
            # вещ32 ↔ вещ64: cvtss2sd (ВЕЩРВ) или cvtsd2ss (ВЕЩВР)
            если цель_пр.знач2 == 64:
                ген.пиши("ВЕЩРВ ПЛАВ0, ПЛАВ0")
            иначе:
                ген.пиши("ВЕЩВР ПЛАВ0, ПЛАВ0")
        верни тип_привед
    если вид == У_РАЗМЕР:
        если выр.знач2 == 1:
            ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(ген.размер(выр.а) как цел.верх)))
        иначе:
            ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(ген.размер(ген.тип_выр(выр.а)) как цел.верх)))
        верни т_без64()
    если вид == У_ПОВТОР:
        # повтор(скаляр): все лейны вектора = значение
        ст_повт *Узел = ген.тип_выр(выр.а)
        если ст_повт == пусто или (ст_повт.знач != ТВ_ЦЕЛ и
           ст_повт.знач != ТВ_БЕЗ и ст_повт.знач != ТВ_ВЕЩ):
            ген_ош("повтор: нужен числовой скаляр", выр.строка)
        ген.выр(выр.а)
        если _это_вещ(ст_повт):
            # уже в ПЛАВ0: pshufd — f32 лейн0×4, f64 квад0×2
            если ст_повт.знач2 == 32:
                ген.пиши("ПСДВИГД ПЛАВ0, ПЛАВ0, 0")
            иначе:
                ген.пиши("ПСДВИГД ПЛАВ0, ПЛАВ0, 68")
        иначе:
            # целые: слот 16 байт, скаляр по шагу лейна, movdqu
            ген.пиши("ВЫЧ УКС, 16")
            ген.глуб += 2
            шаг размер = ген.размер(ст_повт)
            для ип в 0..16 / шаг:
                ген.сохранить(_склей3("[УКС+", _цел_стр((ип * шаг) как цел.верх), "]"), ст_повт)
            ген.пиши("ПЕРЦВ ПЛАВ0, ОКВАД[УКС]")
            ген.пиши("ДОБ УКС, 16")
            ген.глуб -= 2
        верни т_век(ст_повт, 16 / ген.размер(ст_повт))
    если вид == У_СУММА:
        # горизонтальная сумма лейнов: скаляр типа лейна
        ст_сум *Узел = ген.тип_выр(выр.а)
        если ст_сум == пусто или ст_сум.знач != ТВ_ВЕК:
            ген_ош("сумма: нужен вектор", выр.строка)
        эл_сум *Узел = ген.век_эл(ст_сум)
        ген.выр(выр.а)
        если _это_вещ(эл_сум):
            # f32: pshufd {1,0,3,2}+addps, pshufd {2}+addss
            # f64: pshufd {2,3,0,1}+addsd
            если эл_сум.знач2 == 32:
                ген.пиши("ПСДВИГД ПЛАВ1, ПЛАВ0, 177")
                ген.пиши("ДОБПС ПЛАВ0, ПЛАВ1")
                ген.пиши("ПСДВИГД ПЛАВ1, ПЛАВ0, 2")
                ген.пиши("ДОБВС ПЛАВ0, ПЛАВ1")
            иначе:
                ген.пиши("ПСДВИГД ПЛАВ1, ПЛАВ0, 78")
                ген.пиши("ДОБВД ПЛАВ0, ПЛАВ1")
            верни эл_сум
        # целые: слот 24 байта — вектор по [УКС+8], сумма по [УКС]
        ген.пиши("ВЫЧ УКС, 24")
        ген.глуб += 3
        ген.пиши("ПЕРЦВ ОКВАД[УКС+8], ПЛАВ0")
        шс размер = ген.размер(эл_сум)
        нл размер = (16 как размер) / шс
        ген.загрузить("[УКС+8]", эл_сум)
        ген.пиши("ПЕР [УКС], АКК")
        для ис в 1..нл:
            ген.загрузить(_склей3("[УКС+", _цел_стр(((ис * шс) как цел.верх) + 8), "]"), эл_сум)
            ген.пиши("ДОБ [УКС], АКК")
        ген.пиши("ПЕР АКК, [УКС]")
        ген.пиши("ДОБ УКС, 24")
        ген.глуб -= 3
        верни эл_сум
    если вид == У_МАКС или вид == У_МИН:
        # поэлементный пакетный мин/макс: МАКСПС/МИНПС — одна инструкция
        т_м *Узел = ген.реш_тип(ген.тип_выр(выр.а))
        эл_м *Узел = ген.век_эл(т_м)
        под_м стр = _век_под(эл_м)
        ген.выр(выр.а)
        # опкоды с m128 требуют выравнивания по 16: при нечётной глубине
        # стека резервируем 24 байта вместо 16 — слот остаётся выровненным
        сдвиг_м размер = 16
        если ген.глуб % 2 != 0:
            сдвиг_м = 24
        ген.пиши(_склей2("ВЫЧ УКС, ", _цел_стр(сдвиг_м как цел.верх)))
        ген.пиши(_склей2(под_м, " ОКВАД[УКС], ПЛАВ0"))
        ген.глуб += сдвиг_м / 8
        ген.выр(выр.б)
        ген.пиши(_склей2("ДОБ УКС, ", _цел_стр(сдвиг_м как цел.верх)))
        ген.глуб -= сдвиг_м / 8
        мнем_м стр = "МИНП"
        если вид == У_МАКС:
            мнем_м = "МАКСП"
        ген.пиши(_склей4(мнем_м, _век_суф(эл_м), " ПЛАВ0, ОКВАД[УКС-",
            _склей2(_цел_стр(сдвиг_м как цел.верх), "]")))
        верни т_м
    если вид == У_НОВЫЙ:
        разм размер = ген.размер(выр.а)
        ген.нужны(1 | 16)
        хелпер_в стр = "стд_выдели"
        если ген.память == 1:
            хелпер_в = "стд_выдели_пров"
            ген.нужны(32 | 64)
        ген.пиши(_склей2("ПЕР СЧТ, ", _цел_стр(разм как цел.верх)))
        # БАЗ = номер строки для стд_сбой_памяти; БАЗ сохраняем, хелпер его не трогает
        ген.пиши("ВСТЕК БАЗ")
        ген.глуб += 1
        ген.пиши(_склей2("ПЕР БАЗ, ", _цел_стр(выр.строка как цел.верх)))
        ген.пад_и_вызов(хелпер_в)
        ген.пиши("ИЗСТЕКА БАЗ")
        ген.глуб -= 1
        верни т_указ(выр.а)
    если вид == У_АДРЕС:
        ген.адрес(выр.а, 2)
        верни т_указ(ген.тип_выр(выр.а))
    если вид == У_РАЗЫМ:
        тип_уз *Узел = ген.реш_тип(ген.выр(выр.а))
        если тип_уз.знач != ТВ_УКАЗ:
            ген_ош("разыменование не-указателя", выр.строка)
        ген.загрузить("[АКК]", тип_уз.а)
        верни тип_уз.а
    если вид == У_ПОЛЕ:
        # модульное имя «модуль.функ» / «модуль.КОНСТ»
        мф *ГФунк = ген.мод_функ(выр)
        если мф != пусто:
            ген.пиши(_склей3("АДР АКК, [", мф.асм, "]"))
            мтп *Список = список_новый()
            для инд в 0..мф.парамы.длина:
                мпрм *Узел = список_получи(мф.парамы, инд) как *Узел
                список_добавь(мтп, мпрм.а как размер)
            верни т_функ(мтп, мф.возвр)
        мк *ГКонст = ген.мод_конст(выр)
        если мк != пусто:
            если мк.большое:
                ген.пиши(_склей2("ПЕР АКК, ", без_в_стр(мк.знач как размер)))
            иначе:
                ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(мк.знач)))
            верни т_цел64()
        если выр.а.вид == У_ИМЯ:
            переч *ГПереч = ген.переч_ищи(выр.а.текст)
            если переч != пусто:
                для инд в 0..переч.элементы.длина:
                    элем *ГПоле = список_получи(переч.элементы, инд) как *ГПоле
                    если стр_равны(элем.имя, выр.текст):
                        ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(элем.смещ как цел.верх)))
                        верни т_цел64()
        тип_уз = ген.поле_адрес(выр, 0)
        ген.загрузить("[АКК]", тип_уз)
        верни тип_уз
    если вид == У_ИНДЕКС:
        тип_уз = ген.индекс_адрес(выр, 0)
        ген.загрузить("[АКК]", тип_уз)
        верни тип_уз
    если вид == У_УН:
        верни ген.унар(выр)
    если вид == У_БИН:
        верни ген.бин(выр)
    если вид == У_ВЫЗОВ:
        верни ген.вызов(выр)
    если вид == У_СРЕЗ:
        верни ген.срез_дл(выр)
    если вид == У_ЛИТТИП:
        верни ген.литерал(выр)
    если вид == У_ДИАП:
        ген_ош("диапазон вне контекста итерации", выр.строка)
    ген_ош(_склей2("не поддержан узел ", _цел_стр(выр.вид как цел.верх)), выр.строка)
    верни т_любой()

открыто функ (ген *Ген) выр_имя(выр *Узел) *Узел:
    имя стр = выр.текст
    лок *ГСим = ген.локал_ищи(имя)
    если лок != пусто:
        тип_уз *Узел = ген.реш_тип(лок.тип)
        если тип_уз.знач == ТВ_ИМЯ или тип_уз.знач == ТВ_МАСС:
            ген.пиши(_склей2("АДР АКК, ", _адр_лок(лок.смещ)))
            верни тип_уз
        ген.загрузить(_слот(лок), тип_уз)
        верни тип_уз
    псим *ГСим = ген.парам_ищи(имя)
    если псим != пусто:
        тип_уз = ген.реш_тип(псим.тип)
        если тип_уз.знач == ТВ_ИМЯ или тип_уз.знач == ТВ_МАСС:
            ген.пиши(_склей2("АДР АКК, ", _адр_пар(псим.смещ)))
            верни тип_уз
        ген.загрузить(_слот(псим), тип_уз)
        верни тип_уз
    конста *ГКонст = ген.конст_ищи(имя)
    если конста != пусто:
        если конста.большое:
            ген.пиши(_склей2("ПЕР АКК, ", без_в_стр(конста.знач как размер)))
        иначе:
            ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(конста.знач)))
        верни т_цел64()
    элем *ГПоле = ген.переч_элем_ищи(имя)
    если элем != пусто:
        ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(элем.смещ как цел.верх)))
        верни т_цел64()
    функц *ГФунк = ген.функ_ищи(имя)
    если функц != пусто:
        ген.пиши(_склей3("АДР АКК, [", функц.асм, "]"))
        тп *Список = список_новый()
        для инд в 0..функц.парамы.длина:
            прм *Узел = список_получи(функц.парамы, инд) как *Узел
            список_добавь(тп, прм.а как размер)
        верни т_функ(тп, функц.возвр)
    ген_ош(_склей2("неизвестное имя ", имя), выр.строка)
    верни т_любой()

# контекст обращения к элементу массива: 0=чтение 1=запись 2=адрес
# (для диагностики границ; 2 также для вложенных индексов и срезов)
открыто функ (ген *Ген) адрес(выр *Узел, конт нат.верх):
    если выр.вид == У_ИМЯ:
        лок *ГСим = ген.локал_ищи(выр.текст)
        если лок != пусто:
            ген.пиши(_склей2("АДР АКК, ", _адр_лок(лок.смещ)))
            верни
        псим *ГСим = ген.парам_ищи(выр.текст)
        если псим != пусто:
            если псим.парам:
                ген.пиши(_склей2("АДР АКК, ", _адр_пар(псим.смещ)))
            иначе:
                ген.пиши(_склей2("АДР АКК, ", _адр_лок(псим.смещ)))
            верни
        ген_ош(_склей2("нельзя взять адрес ", выр.текст), выр.строка)
    если выр.вид == У_РАЗЫМ:
        ген.выр(выр.а)
        верни
    если выр.вид == У_ПОЛЕ:
        ген.поле_адрес(выр, конт)
        верни
    если выр.вид == У_ИНДЕКС:
        ген.индекс_адрес(выр, конт)
        верни
    ген_ош("выражение не имеет адреса", выр.строка)

# поле стр/срез: данные=0 (*нат.старт), длина=8 (нат.верх)
открыто функ _поле_пары(имя стр, смещ *смещение) *Узел:
    если стр_равны(имя, "данные"):
        *смещ = 0
        верни т_указ(т_без8())
    если стр_равны(имя, "длина"):
        *смещ = 8
        верни т_без64()
    верни пусто как *Узел

открыто функ (ген *Ген) поле_адрес(выр *Узел, конт нат.верх) *Узел:
    если выр.а.вид == У_ИМЯ и ген.переч_ищи(выр.а.текст) != пусто:
        ген_ош("элемент перечисления — не адрес", выр.строка)
    т_об *Узел = ген.реш_тип(ген.тип_выр(выр.а))
    если т_об.знач == ТВ_СТР или т_об.знач == ТВ_СРЕЗ:
        смещ смещение = 0
        тип_поля *Узел = _поле_пары(выр.текст, &смещ)
        если тип_поля == пусто:
            ген_ош(_склей2("нет поля пары: ", выр.текст), выр.строка)
        ген.выр(выр.а)
        если смещ != 0:
            ген.пиши(_склей2("ДОБ АКК, ", _цел_стр(смещ как цел.верх)))
        верни тип_поля
    если т_об.знач == ТВ_УКАЗ:
        база *Узел = ген.реш_тип(т_об.а)
        если база.знач == ТВ_ИМЯ:
            тип_поля = ген.поле_записи(база.текст, выр.текст, выр.строка)
            смещ2 смещение = 0
            тип_поля = ген.поле_записи2(база.текст, выр.текст, выр.строка, &смещ2)
            ген.выр(выр.а)
            если смещ2 != 0:
                ген.пиши(_склей2("ДОБ АКК, ", _цел_стр(смещ2 как цел.верх)))
            верни тип_поля
        если база.знач == ТВ_СТР или база.знач == ТВ_СРЕЗ:
            смещ3 смещение = 0
            тип_поля3 *Узел = _поле_пары(выр.текст, &смещ3)
            если тип_поля3 != пусто:
                ген.выр(выр.а)
                если смещ3 != 0:
                    ген.пиши(_склей2("ДОБ АКК, ", _цел_стр(смещ3 как цел.верх)))
                верни тип_поля3
    если т_об.знач == ТВ_ИМЯ:
        смещ4 смещение = 0
        тип_поля4 *Узел = ген.поле_записи2(т_об.текст, выр.текст, выр.строка, &смещ4)
        ген.адрес(выр.а, конт)
        если смещ4 != 0:
            ген.пиши(_склей2("ДОБ АКК, ", _цел_стр(смещ4 как цел.верх)))
        верни тип_поля4
    ген_ош(_склей2("поле неприменимо: ", выр.текст), выр.строка)
    верни т_любой()

открыто функ (ген *Ген) поле_записи(имя_з стр, имя_поля стр, строка размер) *Узел:
    зап *ГЗапись = ген.запись_ищи(имя_з)
    если зап == пусто:
        ген_ош(_склей2("неизвестная запись ", имя_з), строка)
    поле *ГПоле = поле_ищи(зап, имя_поля)
    если поле == пусто:
        ген_ош(_склей3("у записи ", имя_з, _склей2(" нет поля ", имя_поля)), строка)
