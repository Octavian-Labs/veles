    ген.пиши("ПЕР Р12, СЧТ")
    ген.пиши("ПЕР Р13, ДАН")
    ген.пиши("ПЕР Р14, ИСТ")
    ген.пиши("ПЕР Р15, БАЗ")
    если ген.цель == 0:
        ген.пиши("ПЕР СЧТ, -12")
        ген.пиши("ВЫЗОВ GetStdHandle")
        ген.пиши("ПЕР ПРМ, АКК")

# байтовый фрагмент диагностики в секцию данных; возвращает длину в байтах
открыто функ (ген *Ген) сб_фраг(метка стр, текст стр, нс лог) размер:
    строчка стр = _склей3(метка, ": БАЙТ \"", текст)
    если нс:
        строчка = _склей2(строчка, "\", 10")
    иначе:
        строчка = _склей2(строчка, "\"")
    буф_добавь(ген.данные, _склей2(строчка, "\n"))
    дл размер = текст.длина
    если нс:
        дл += 1
    верни дл

