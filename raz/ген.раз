функ (ген *Ген) генерируй(прог *Узел) стр:
    # проход 0: реестр модулей из «взять» (загрузчик кладёт пути в дети2)
    если прог.дети2 != пусто:
        для инд в 0..прог.дети2.длина:
            мп стр = список_получи(прог.дети2, инд) как стр
            мл стр = _лист_пути(мп)
            ген.мод_рег(мп, мл)
            ген.мод_рег(мл, мл)
    # проход 1: типы и сигнатуры
    для инд в 0..прог.дети.длина:
        объяв *Узел = список_получи(прог.дети, инд) как *Узел
        вид нат.верх = объяв.вид
        если вид == У_ЗАПИСЬ:
            ген.объяви_запись(объяв)
        а если вид == У_ТИПСИН:
            син *ГСин = новый(ГСин)
            син.имя = объяв.текст
            син.тип = объяв.а
            список_добавь(ген.синонимы, син как нат.верх)
        а если вид == У_КОНСТ:
            конста *ГКонст = новый(ГКонст)
            конста.имя = объяв.текст
            конста.знач = ген.конст(объяв.а)
            конста.большое = ген.конст_большое
            список_добавь(ген.консты, конста как нат.верх)
        а если вид == У_ПЕРЕЧ:
            переч *ГПереч = новый(ГПереч)
            переч.имя = объяв.текст
            переч.элементы = список_новый()
            для инд2 в 0..объяв.дети.длина:
                элем *Узел = список_получи(объяв.дети, инд2) как *Узел
                пл *ГПоле = новый(ГПоле)
                пл.имя = элем.текст
                пл.смещ = элем.знач
                список_добавь(переч.элементы, пл как нат.верх)
            список_добавь(ген.перечи, переч как нат.верх)
        а если вид == У_ВНЕШ:
            ген.имп_добавь(объяв.текст2, объяв.текст)
            функц *ГФунк = новый(ГФунк)
            функц.имя = объяв.текст
            функц.асм = объяв.текст
            функц.парамы = объяв.дети
            функц.возвр = объяв.а
            функц.внеш = 1
            список_добавь(ген.функции, функц как нат.верх)
        а если вид == У_ФУНК:
            если объяв.в != пусто:
                тип_пр *Узел = ген.реш_тип(объяв.в.а)
                имя_записи стр = ""
                если тип_пр.знач == ТВ_УКАЗ:
                    бр *Узел = ген.реш_тип(тип_пр.а)
                    если бр.знач != ТВ_ИМЯ:
                        ген_ош("приёмник метода — запись или *запись",
                               объяв.строка)
                    имя_записи = бр.текст
                а если тип_пр.знач == ТВ_ИМЯ:
                    имя_записи = тип_пр.текст
                иначе:
                    ген_ош("приёмник метода — запись или *запись", объяв.строка)
                парамы *Список = список_новый()
                прм0 *Узел = узел(У_ПАРАМ, объяв.строка)
                прм0.текст = объяв.в.текст
                прм0.а = т_указ(т_запись(имя_записи))
                список_добавь(парамы, прм0 как нат.верх)
                для инд2 в 0..объяв.дети.длина:
                    список_добавь(парамы, список_получи(объяв.дети, инд2))
                мет *ГМетод = новый(ГМетод)
                мет.запись = имя_записи
                мет.имя = объяв.текст
                мет.асм = _склей4("ф_", имя_записи, "_", объяв.текст)
                мет.парамы = парамы
                мет.возвр = объяв.а
                список_добавь(ген.методы, мет как нат.верх)
                функц = новый(ГФунк)
                функц.имя = _склей3(имя_записи, ".", объяв.текст)
                функц.асм = мет.асм
                функц.парамы = парамы
                функц.возвр = объяв.а
                функц.внеш = 0
                список_добавь(ген.функции, функц как нат.верх)
            иначе:
                функц = новый(ГФунк)
                функц.имя = объяв.текст
                функц.асм = _склей2("ф_", _асм_имя(объяв.текст))
                функц.парамы = объяв.дети
                функц.возвр = объяв.а
                функц.внеш = 0
                список_добавь(ген.функции, функц как нат.верх)
    # автоматический импорт завершения
    если ген.цель == 0:
        ген.имп_добавь("kernel32", "ExitProcess")
    # проход 2: код функций
    для инд в 0..прог.дети.длина:
        объяв = список_получи(прог.дети, инд) как *Узел
        если объяв.вид == У_ФУНК:
            если стр_равны(объяв.текст, "главная"):
                ген.есть_главная = 1
            ген.функ_(объяв)
    если ген.цель == 0 и ген.нужны_стд != 0:
        ген.имп_добавь("kernel32", "GetProcessHeap")
        ген.имп_добавь("kernel32", "HeapAlloc")
        ген.имп_добавь("kernel32", "HeapFree")
    ген.стд_хелперы()
    если ген.есть_главная != 0:
        ген.старт()
    иначе:
        ген_ош("программе нужна функция «главная»", 0)
    # сборка текста
    вых *Буфер = буф_новый()
    если ген.цель == 1:
        буф_добавь(вых, ";цель linux\n")
    а если ген.цель == 2:
        буф_добавь(вых, ";цель macos\n")
        буф_добавь(ген.данные, "гл_аргв: КВАД 0, 0\n")
    если ген.режим == 0:
        буф_добавь(вых, ";режим быстро\n")
    иначе:
        буф_добавь(вых, ";режим надёжно\n")
    буф_добавь(вых, "; сгенерировано компилятором РАЗУМ\nСЕКЦИЯ код\n")
    для инд в 0..ген.импорты.длина:
        имп *ГИмп = список_получи(ген.импорты, инд) как *ГИмп
        буф_добавь(вых, _склей3("ИМПОРТ \"", имп.длл, "\" "))
        для инд2 в 0..имп.имена.длина:
            если инд2 > 0:
                буф_добавь(вых, ", ")
            буф_добавь(вых, список_получи(имп.имена, инд2) как стр)
        буф_сим(вых, 10)
    если ген.есть_главная != 0:
        буф_добавь(вых, "ВХОД старт\n")
    если ген.опт > 0:
        буф_добавь(вых, опт_код(буф_стр(ген.код)))
    иначе:
        буф_добавь(вых, буф_стр(ген.код))
    если ген.данные.длина > 0:
        буф_добавь(вых, "СЕКЦИЯ данные\n")
        буф_добавь(вых, буф_стр(ген.данные))
    верни буф_стр(вых)
