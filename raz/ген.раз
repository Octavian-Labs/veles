        с := список_получи(г.счёты, i) как *ГСчёт
        если стр_равны(с.имя, имя):
            верни с.n
    верни 0

функ _запрет_добавь(г *Ген, имя стр):
    если не _имя_есть(г.запреты, имя):
        список_добавь(г.запреты, имя как без64)

функ (г *Ген) годен_рег(с *ГСим) бул:
    # в регистр идёт только скаляр размером 8 без взятия адреса/искра-блоков
    если _имя_есть(г.запреты, с.имя):
        верни нет
    т := г.реш_тип(с.тип)
    если т.знач == ТВ_ИМЯ или т.знач == ТВ_МАСС:
        верни нет
    верни г.размер(т) == 8

функ (г *Ген) искра_запреты(стр стр):
    # слова-имена в строке сырой ИСКРЫ — те же правила, что в искра_подстановка
    с := стр
    hi := стр_найди(стр, "#")
    если hi >= 0:
        с = стр_срез(стр, 0, hi как без64)
    k без64 = 0
    пока k < с.длина:
        б0 := с.данные[k]
        если (_слово_нач(б0) и
           (k == 0 или (не _слово_часть(с.данные[k - 1]) и
            с.данные[k - 1] != '.'))):
            j := k + 1
            пока j < с.длина и _слово_часть(с.данные[j]):
                j += 1
            m := j
            пока m < с.длина и (с.данные[m] == ' ' или с.данные[m] == 9):
                m += 1
            если m >= с.длина или с.данные[m] != ':':
                _запрет_добавь(г, стр_срез(с, k, j))
            k = j
        иначе:
            k += 1

