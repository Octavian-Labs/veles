# --- модульные пути ---------------------------------------------------------------

функ _лист_пути(путь стр) стр:
    # «сист.файл» -> «файл»
    поз нат.верх = путь.длина
    пока поз > 0:
        если путь.данные[поз - 1] == '.':
            верни стр_срез(путь, поз, путь.длина)
        поз -= 1
    верни путь

функ (ген *Ген) мод_рег(ключ стр, преф стр):
    для инд в 0..ген.модули.длина:
        мод *ГМод = список_получи(ген.модули, инд) как *ГМод
        если стр_равны(мод.ключ, ключ):
            верни
    нм *ГМод = новый(ГМод)
    нм.ключ = ключ
    нм.преф = преф
    список_добавь(ген.модули, нм как нат.верх)

функ (ген *Ген) мод_ищи(ключ стр) *ГМод:
    для инд в 0..ген.модули.длина:
        мод *ГМод = список_получи(ген.модули, инд) как *ГМод
        если стр_равны(мод.ключ, ключ):
            верни мод
    верни пусто как *ГМод

функ _цепочка_имён(выр *Узел) *Список:
    # Поле(Поле(a, b), c) -> [a, b, c]; пусто, если корень не имя
    цеп *Список = список_новый()
    тек *Узел = выр
    пока тек.вид == У_ПОЛЕ:
        список_добавь(цеп, тек.текст как нат.верх)
        тек = тек.а
    если тек.вид != У_ИМЯ:
        верни пусто как *Список
    список_добавь(цеп, тек.текст как нат.верх)
    итог *Список = список_новый()
    инд нат.верх = цеп.длина
    пока инд > 0:
        список_добавь(итог, список_получи(цеп, инд - 1))
        инд -= 1
    верни итог

функ _склей(имена *Список, от нат.верх, по нат.верх, разд стр) стр:
    рез стр = ""
    для инд в от..по:
        если инд > от:
            рез = стр_склей(рез, разд)
        рез = стр_склей(рез, список_получи(имена, инд) как стр)
    верни рез

функ (ген *Ген) мод_канд(имена *Список) *Список:
    # кандидаты манглированных имён для цепочки «a.b.c»
    канд *Список = список_новый()
    дл нат.верх = имена.длина
    инд цел.верх = (дл как цел.верх) - 1
    пока инд >= 1:
        мод *ГМод = ген.мод_ищи(_склей(имена, 0, инд как нат.верх, "."))
        если мод != пусто:
            список_добавь(канд, стр_склей(стр_склей(мод.преф, "_"),
                _склей(имена, инд как нат.верх, дл, "_")) как нат.верх)
            список_добавь(канд, _склей(имена, инд как нат.верх, дл, "_") как нат.верх)
        инд -= 1
    список_добавь(канд, _склей(имена, 0, дл, "_") как нат.верх)
    если дл == 2:
        если ген.мод_ищи(список_получи(имена, 0) как стр) != пусто:
            список_добавь(канд, список_получи(имена, 1))
    верни канд

функ (ген *Ген) мод_цеп(выр *Узел) *Список:
    # список кандидатов для узла-цепочки; пусто — это поле/метод переменной
    имена *Список = _цепочка_имён(выр)
    если имена == пусто или имена.длина < 2:
        верни пусто как *Список
    корень стр = список_получи(имена, 0) как стр
    если (ген.локал_ищи(корень) != пусто или ген.парам_ищи(корень) != пусто):
        верни пусто как *Список
    верни ген.мод_канд(имена)

функ (ген *Ген) мод_функ(выр *Узел) *ГФунк:
    канд *Список = ген.мод_цеп(выр)
    если канд == пусто:
        верни пусто как *ГФунк
    для инд в 0..канд.длина:
        функц *ГФунк = ген.функ_ищи(список_получи(канд, инд) как стр)
        если функц != пусто:
            верни функц
    верни пусто как *ГФунк

функ (ген *Ген) мод_конст(выр *Узел) *ГКонст:
    канд *Список = ген.мод_цеп(выр)
    если канд == пусто:
        верни пусто как *ГКонст
    для инд в 0..канд.длина:
        конста *ГКонст = ген.конст_ищи(список_получи(канд, инд) как стр)
        если конста != пусто:
            верни конста
    верни пусто как *ГКонст

