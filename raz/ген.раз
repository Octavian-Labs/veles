открыто функ (ген *Ген) объяви_запись(объяв *Узел):
    зап *ГЗапись = новый(ГЗапись)
    зап.имя = объяв.текст
    зап.мод = объяв.мод
    зап.отк = объяв.отк
    зап.поля = список_новый()
    смещ смещение = 0
    для инд в 0..объяв.дети.длина:
        поле *Узел = список_получи(объяв.дети, инд) как *Узел
        тип_уз *Узел = ген.реш_тип(поле.а)
        разм размер = ген.размер(тип_уз)
        ал размер = разм
        если ал > 8:
            ал = 8
        если ал == 0:
            ал = 1
        смещ = (смещ + ал - 1) / ал * ал
        пл *ГПоле = новый(ГПоле)
        пл.имя = поле.текст
        пл.смещ = смещ
        пл.тип = тип_уз
        список_добавь(зап.поля, пл как размер)
        смещ += разм как смещение
    зап.разм = ((смещ + 7) / 8 * 8) как размер
    список_добавь(ген.записи, зап как размер)

