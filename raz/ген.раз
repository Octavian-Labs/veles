# ген — генератор текста ИСКРЫ (.иск) из AST РАЗУМА.
# Выражение оставляет результат в АКК; локали/парамы адресуются через УКК. Windows: СЧТ/ДАН/Р8/Р9 + тень 32Б; Linux SysV:
# ПРМ/ИСТ/ДАН/СЧТ/Р8/Р9. Вещественное выражение (вещ.верх) оставляет результат в ПЛАВ0;
# вещ-аргументы идут через xmm: Windows — ПЛАВi по позиции i, SysV — ПЛАВ0..7 отдельным счётчиком.

взять основа
взять узлы
взять опт
взять парсер
взять кэш

открыто конст ТВ_ЛЮБОЙ = 13   # внутренний тип «вывести самому»

# --- записи таблиц символов -----------------------------------------------------

открыто запись ГСим:            # локал/параметр: имя -> (смещение, тип)
    имя стр
    смещ смещение
    тип *Узел
    рег размер           # 0 — в кадре; 1..5 — индекс сохраняемого регистра
    парам лог           # это параметр (слот [УКК+..]), иначе локал [УКК-..]

открыто запись ГСчёт:           # вес обращений к имени внутри текущей функции
    имя стр
    колво размер

открыто запись ГПоле:           # поле записи / элемент перечисления
    имя стр
    смещ смещение          # смещение поля или значение элемента переча
    тип *Узел

открыто запись ГЗапись:
    имя стр
    разм размер
    поля *Список        # ГПоле
    мод стр             # модуль-источник
    отк нат.верх        # 0=скрыто, 1=открыто

открыто запись ГКонст:
    имя стр
    знач цел.верх
    большое лог     # значение >= 2^63 из литерала — печатаем беззнаково
    мод стр
    отк нат.верх

открыто запись ГСин:
    имя стр
    тип *Узел
    мод стр
    отк нат.верх

открыто запись ГПереч:
    имя стр
    элементы *Список    # ГПоле (смещ = значение)
    мод стр
    отк нат.верх

открыто запись ГФунк:
    имя стр             # исходное имя
    асм стр             # имя метки в ИСКРЕ
    парамы *Список      # У_ПАРАМ
    возвр *Узел
    внеш нат.верх
    длл стр             # dll для внешних; пусто — обычная функция
    мод стр             # модуль-источник объявления
    отк нат.верх        # 0=скрыто, 1=открыто

открыто запись ГМетод:
    запись стр          # имя записи-приёмника
    имя стр
    асм стр
    парамы *Список
    возвр *Узел
    мод стр
    отк нат.верх

открыто запись ГИмп:
    длл стр
    имена *Список       # стр

открыто запись ГЦикл:
    шаг стр
    кон стр

открыто запись ГМод:            # модульный префикс из «взять»: ключ -> префикс имён
    ключ стр            # «сист.файл» (полный путь) или «файл» (открытое имя)
    преф стр            # лист пути — префикс манглированных имён («файл»)

открыто запись ГЛок:            # элемент «порядок» при скане тела
    имя стр
    тип *Узел           # может быть пусто — выводится из выр
    выр *Узел           # может быть пусто

открыто запись ГМодБуф:         # фрагменты кода/данных одного модуля
    мод стр
    код *Буфер
    данные *Буфер
    нужны нат.верх          # биты нужны_стд, выставленные функциями модуля
    км *КэшМодуль           # загруженный кэш; пусто — модуль собран заново

открыто запись ГДоказ:          # доказанный диапазон переменной цикла «для»
    слот *ГСим          # переменная цикла
    кол *ГСим           # коллекция-источник; пусто — числовой предел
    мин цел.верх        # числовой диапазон: нижняя граница включительно
    предел размер     # числовой диапазон: верхняя граница исключительно

открыто запись ГЛин:            # разложение индекса на «а + счётчик*б»
    а *Узел             # инвариантная часть; пусто = 0
    б *Узел             # коэффициент при счётчике; пусто = 1 (при лин)
    лин лог             # счётчик входит линейно
    ок лог              # разложение удалось

открыто запись ГИнд:            # бегущий адрес для одного У_ИНДЕКС
    узел *Узел          # заменяемый узел индексации
    база *Узел          # узел.а — имя сырого указателя
    а *Узел             # инвариантная часть индекса; пусто = 0
    б *Узел             # шаг индекса за итерацию; пусто = 1 при лин
    лин лог             # счётчик входит; нет — чистый инвариант (LICM)
    элем *Узел          # решённый тип элемента (при активации)
    слот стр            # имя скрытого локала: бегущий адрес
    шаг_слот стр        # имя скрытого локала: шаг в байтах ("" при лин=нет)
    оп стр              # операнд слота адреса (при активации)

открыто запись ГИндЦикл:        # план индукции одного оператора «для»
    оп *Узел
    записи *Список      # ГИнд

открыто запись Ген:
    код *Буфер
    данные *Буфер
    записи *Список
    синонимы *Список
    консты *Список
    перечи *Список
    функции *Список
    методы *Список
    импорты *Список
    модули *Список      # ГМод — зарегистрированные пути «взять»
    нужны_стд нат.верх     # биты: 1=выдели 2=освободи 4=сбой_границы
                           # 8=сбой_среза 16=сбой_памяти
    стр_сч размер
    мет_сч размер
    конст_большое лог   # последняя конст >= 2^63 из литерала
    глуб размер          # выданные ВСТЕК (в восьмибайтовках)
    цель нат.верх          # 0=windows 1=linux 2=macos
    опт нат.верх           # уровень оптимизации: 0=нет, 1=пипхол
    режим нат.верх         # ось безопасности: 1=надёжно (умолчание), 0=быстро
    память нат.верх        # ось учёта памяти: 0=обычно (умолчание), 1=проверка
    есть_главная размер
    # контекст текущей функции
    локалы *Список      # ГСим
    парамы *Список      # ГСим
    циклы *Список       # ГЦикл
    отложи *Список      # *Узел
    счёты *Список       # ГСчёт — веса обращений к именам
    запреты *Список     # стр — имена, которым нельзя в регистр (адрес/искра)
    доказаны *Список    # ГДоказ — переменные цикла с доказанным диапазоном
    инд_планы *Список   # ГИндЦикл — планы индукции текущей функции
    инд_актив *Список   # ГИнд — активные бегущие адреса (стек по циклам)
    рег_локов размер     # сколько регистров занято локалями (префикс _рег_лок)
    фрейм размер
    выход_м стр
    возвр *Узел
    фимя стр            # имя текущей функции — контекст меток м_<фимя>_*_N
    пред_сказано лог    # предупреждение про «:=» уже выдано
    мод_тек стр         # модуль обрабатываемого объявления (для видимости)
    стр_тек размер      # строка текущего контекста — для диагностики
    кэш_вкл лог         # интерфейсный кэш .рми включён
    корень стр          # норм-путь корневого модуля — не кэшируется
    хеши *Список        # КХеш — хеши источников модулей
    зависим *Список     # КЗавис — реестр зависимостей модулей
    модбуфы *Список     # ГМодБуф — фрагменты по модулям в порядке обхода
    мб_тек *ГМодБуф     # буфер текущего модуля (код/данные указывают на него)

открыто функ ген_новый(цель нат.верх, опт нат.верх, режим нат.верх, пам нат.верх) *Ген:
    ген *Ген = новый(Ген)
    ген.код = буф_новый()
    ген.данные = буф_новый()
    ген.записи = список_новый()
    ген.синонимы = список_новый()
    ген.консты = список_новый()
    ген.перечи = список_новый()
    ген.функции = список_новый()
    ген.методы = список_новый()
    ген.импорты = список_новый()
    ген.модули = список_новый()
    ген.нужны_стд = 0
    ген.стр_сч = 0
    ген.мет_сч = 0
    ген.глуб = 0
    ген.цель = цель
    ген.опт = опт
    ген.режим = режим
    ген.память = пам
    ген.есть_главная = 0
    ген.локалы = список_новый()
    ген.парамы = список_новый()
    ген.циклы = список_новый()
    ген.отложи = список_новый()
    ген.счёты = список_новый()
    ген.запреты = список_новый()
    ген.доказаны = список_новый()
    ген.инд_планы = список_новый()
    ген.инд_актив = список_новый()
    ген.рег_локов = 0
    ген.фрейм = 0
    ген.выход_м = ""
    ген.мод_тек = ""
    ген.стр_тек = 0
    ген.возвр = пусто как *Узел
    ген.фимя = ""
    ген.пред_сказано = нет
