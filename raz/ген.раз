открыто функ (ген *Ген) мбуф_сейчас(мод стр) *ГМодБуф:
    # буфер модуля: найти или создать; ген.код/ген.данные переключаются на него
    для инд в 0..ген.модбуфы.длина:
        мб *ГМодБуф = список_получи(ген.модбуфы, инд) как *ГМодБуф
        если стр_равны(мб.мод, мод):
            ген.мб_тек = мб
            ген.код = мб.код
            ген.данные = мб.данные
            верни мб
    мб = новый(ГМодБуф)
    мб.мод = мод
    мб.код = буф_новый()
    мб.данные = буф_новый()
    мб.нужны = 0
    мб.км = пусто как *КэшМодуль
    список_добавь(ген.модбуфы, мб как размер)
    ген.мб_тек = мб
    ген.код = мб.код
    ген.данные = мб.данные
    верни мб

открыто функ (ген *Ген) нужны(биты нат.верх):
    # бит в общий счётчик и в текущий модульный буфер (для поля нужны в .рми)
    ген.нужны_стд = ген.нужны_стд | биты
    если ген.мб_тек != пусто:
        ген.мб_тек.нужны = ген.мб_тек.нужны | биты

