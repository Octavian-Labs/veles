    верни т_любой()

# --- константная свёртка ---------------------------------------------------------

функ _число_уз(знач цел.верх, строка нат.верх) *Узел:
    уз *Узел = узел(У_ЧИСЛО, строка)
    уз.знач = знач как нат.верх
    уз.знач2 = уз.знач >> 63
    верни уз

функ (ген *Ген) сверни(выр *Узел) *Узел:
    # Вычисляет выражение во время компиляции; возвращает узел У_ЧИСЛО
    # или пусто, если выражение не константное. Семантика повторяет
    # сгенерированный код: усечённое деление, знаковость сдвигов и
    # сравнений по типу операндов, маска счётчика сдвига в 63.
    если выр == пусто:
        верни пусто как *Узел
    вид нат.верх = выр.вид
    если вид == У_ЧИСЛО или вид == У_БУЛ:
        верни выр
    если вид == У_ИМЯ:
        конста *ГКонст = ген.конст_ищи(выр.текст)
        если конста == пусто:
            верни пусто как *Узел
        уз *Узел = узел(У_ЧИСЛО, выр.строка)
        уз.знач = конста.знач как нат.верх
        уз.знач2 = конста.большое как нат.верх
        верни уз
    если (вид == У_ПОЛЕ и выр.а != пусто и выр.а.вид == У_ИМЯ):
        переч *ГПереч = ген.переч_ищи(выр.а.текст)
        если переч != пусто:
            для инд в 0..переч.элементы.длина:
                элем *ГПоле = список_получи(переч.элементы, инд) как *ГПоле
                если стр_равны(элем.имя, выр.текст):
                    верни _число_уз(элем.смещ как цел.верх, выр.строка)
        верни пусто как *Узел
    если вид == У_УН:
        лев *Узел = ген.сверни(выр.а)
        если лев == пусто:
            верни пусто как *Узел
        если стр_равны(выр.текст, "-"):
            верни _число_уз(0 - (лев.знач как цел.верх), выр.строка)
        если стр_равны(выр.текст, "не"):
            верни _число_уз((лев.знач == 0) как цел.верх, выр.строка)
        верни пусто как *Узел
    если вид == У_ПРИВЕД:
        ген.тип_приведения(выр)
        верни ген.сверни(выр.а)
    если вид == У_РАЗМЕР:
        уз = узел(У_ЧИСЛО, выр.строка)
        если выр.знач2 == 1:
            уз.знач = ген.размер(выр.а)
        иначе:
            уз.знач = ген.размер(ген.тип_выр(выр.а))
        верни уз
    если вид == У_БИН:
        верни ген.сверни_бин(выр)
    верни пусто как *Узел

функ (ген *Ген) сверни_бин(выр *Узел) *Узел:
    лев *Узел = ген.сверни(выр.а)
    если лев == пусто:
        верни пусто как *Узел
    оп стр = выр.текст
    если стр_равны(оп, "в"):
        диап *Узел = выр.б
        если диап == пусто или диап.вид != У_ДИАП:
            верни пусто как *Узел
        низ *Узел = ген.сверни(диап.а)
        верх *Узел = ген.сверни(диап.б)
        если низ == пусто или верх == пусто:
            верни пусто как *Узел
        ок лог = нет
        если не т_знаковый(ген.реш_тип(ген.тип_выр(выр.а))):
            если диап.знач2 == 1:
                ок = (лев.знач >= низ.знач) и (лев.знач <= верх.знач)
            иначе:
                ок = (лев.знач >= низ.знач) и (лев.знач < верх.знач)
        иначе:
            хс цел.верх = лев.знач как цел.верх
            лс цел.верх = низ.знач как цел.верх
            пс цел.верх = верх.знач как цел.верх
            если диап.знач2 == 1:
                ок = (хс >= лс) и (хс <= пс)
            иначе:
                ок = (хс >= лс) и (хс < пс)
        верни _число_уз(ок как цел.верх, выр.строка)
    прав *Узел = ген.сверни(выр.б)
    если прав == пусто:
        верни пусто как *Узел
    если стр_равны(оп, "и"):
        верни _число_уз(((лев.знач != 0) и (прав.знач != 0)) как цел.верх, выр.строка)
    если стр_равны(оп, "или"):
        верни _число_уз(((лев.знач != 0) или (прав.знач != 0)) как цел.верх, выр.строка)
    тип_л *Узел = ген.тип_выр(выр.а)
    тип_п *Узел = ген.тип_выр(выр.б)
    беззн лог = не (т_знаковый(ген.реш_тип(тип_л)) и т_знаковый(ген.реш_тип(тип_п)))
    ав цел.верх = лев.знач как цел.верх
    бв цел.верх = прав.знач как цел.верх
    ау нат.верх = лев.знач
    бу нат.верх = прав.знач
    если стр_равны(оп, "+"):
        верни _число_уз(ав + бв, выр.строка)
    если стр_равны(оп, "-"):
        верни _число_уз(ав - бв, выр.строка)
    если стр_равны(оп, "*"):
        верни _число_уз(ав * бв, выр.строка)
    если стр_равны(оп, "&"):
        верни _число_уз(ав & бв, выр.строка)
    если стр_равны(оп, "|"):
        верни _число_уз(ав | бв, выр.строка)
    если стр_равны(оп, "^"):
        верни _число_уз(ав ^ бв, выр.строка)
    если стр_равны(оп, "<<"):
        верни _число_уз(ав << (бв & 63), выр.строка)
    если стр_равны(оп, ">>"):
        если беззн:
            верни _число_уз((ау >> (бу & 63)) как цел.верх, выр.строка)
        верни _число_уз(ав >> (бв & 63), выр.строка)
    если (стр_равны(оп, "/") или стр_равны(оп, "%")):
        если бу == 0:
            верни пусто как *Узел
        частн цел.верх = 0
        ост цел.верх = 0
        если беззн:
            частн = (ау / бу) как цел.верх
            ост = (ау % бу) как цел.верх
        иначе:
            частн = ав / бв
            ост = ав % бв
        если стр_равны(оп, "/"):
            верни _число_уз(частн, выр.строка)
        верни _число_уз(ост, выр.строка)
    если _это_сравн(оп):
        рез лог = нет
        если беззн:
            если стр_равны(оп, "=="):
                рез = ау == бу
            если стр_равны(оп, "!="):
                рез = ау != бу
            если стр_равны(оп, "<"):
                рез = ау < бу
            если стр_равны(оп, "<="):
                рез = ау <= бу
            если стр_равны(оп, ">"):
                рез = ау > бу
            если стр_равны(оп, ">="):
                рез = ау >= бу
        иначе:
            если стр_равны(оп, "=="):
                рез = ав == бв
            если стр_равны(оп, "!="):
                рез = ав != бв
            если стр_равны(оп, "<"):
                рез = ав < бв
            если стр_равны(оп, "<="):
                рез = ав <= бв
            если стр_равны(оп, ">"):
                рез = ав > бв
            если стр_равны(оп, ">="):
                рез = ав >= бв
        верни _число_уз(рез как цел.верх, выр.строка)
    верни пусто как *Узел

функ (ген *Ген) бин(выр *Узел) *Узел:
    оп стр = выр.текст
    если стр_равны(оп, "и") или стр_равны(оп, "или"):
        ген.требуй_логические_операнды(выр)
    св *Узел = ген.сверни(выр)
    если св != пусто:
        ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(св.знач как цел.верх)))
        если (_это_сравн(оп) или стр_равны(оп, "и") или
              стр_равны(оп, "или") или стр_равны(оп, "в")):
            верни т_бул()
        верни ген.тип_выр(выр.а)
    если стр_равны(оп, "и"):
        конец стр = ген.новая("и_ложь")
        ген.выр(выр.а)
        ген.пиши("ПРОВ АКК, АКК")
        ген.пиши(_склей2("РАВНО ", конец))
        ген.выр(выр.б)
        ген.метка(конец)
        верни т_бул()
    если стр_равны(оп, "или"):
        конец = ген.новая("или_ист")
        ген.выр(выр.а)
        ген.пиши("ПРОВ АКК, АКК")
        ген.пиши(_склей2("НЕРАВНО ", конец))
        ген.выр(выр.б)
        ген.метка(конец)
        верни т_бул()
    если стр_равны(оп, "в"):
        верни ген.проверка_диапазона(выр)
    если _это_сравн(оп):
        тип_л *Узел = ген.тип_выр(выр.а)
        тип_п *Узел = ген.тип_выр(выр.б)
        знак лог = т_знаковый(ген.реш_тип(тип_л)) и т_знаковый(ген.реш_тип(тип_п))
        ген.выр(выр.а)
        ген.пиши("ВСТЕК АКК")
        ген.глуб += 1
        ген.выр(выр.б)
        ген.пиши("ПЕР СЧТ, АКК")
        ген.пиши("ИЗСТЕКА АКК")
        ген.глуб -= 1
        ген.пиши("СРАВ АКК, СЧТ")
        ген.пиши(_склей2(_усл_сравн(оп, знак), " АККБ"))
        ген.пиши("БЕЗРАСШ АКК, АККБ")
        верни т_бул()
    тип_л = ген.тип_выр(выр.а)
    ген.выр(выр.а)
    ген.пиши("ВСТЕК АКК")
    ген.глуб += 1
    ген.выр(выр.б)
    ген.пиши("ПЕР СЧТ, АКК")
    ген.пиши("ИЗСТЕКА АКК")
    ген.глуб -= 1
    если стр_равны(оп, "+"):
        ген.пиши("ДОБ АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "-"):
        ген.пиши("ВЫЧ АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "&"):
        ген.пиши("И АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "|"):
        ген.пиши("ИЛИ АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "^"):
        ген.пиши("ИИЛИ АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "*"):
        ген.пиши("УМН АКК, СЧТ")
        верни тип_л
    если стр_равны(оп, "/") или стр_равны(оп, "%"):
        если т_знаковый(ген.реш_тип(тип_л)):
            ген.пиши("РАСШ")
            ген.пиши("ДЕЛ СЧТ")
        иначе:
            ген.пиши("ПЕР ДАН, 0")
            ген.пиши("ДЕЛБ СЧТ")
        если стр_равны(оп, "%"):
            ген.пиши("ПЕР АКК, ДАН")
        верни тип_л
    если стр_равны(оп, "<<"):
        ген.пиши("СДЛ АКК, СЧТБ")
        верни тип_л
    если стр_равны(оп, ">>"):
        если т_знаковый(ген.реш_тип(тип_л)):
            ген.пиши("СДПА АКК, СЧТБ")
        иначе:
            ген.пиши("СДП АКК, СЧТБ")
        верни тип_л
    ген_ош(_склей2("неизвестный оператор ", оп), выр.строка)
    верни т_любой()

функ (ген *Ген) проверка_диапазона(выр *Узел) *Узел:
    диап *Узел = выр.б
    ложь стр = ген.новая("диап_вне")
    конец стр = ген.новая("диап_конец")
    ген.выр(выр.а)
    ген.пиши("ВСТЕК АКК")
    ген.глуб += 1
    ген.выр(диап.а)
    ген.пиши("ВСТЕК АКК")
    ген.глуб += 1
    ген.выр(диап.б)
    ген.пиши("ПЕР ДАН, АКК")
    ген.пиши("ИЗСТЕКА СЧТ")
    ген.пиши("ИЗСТЕКА АКК")
    ген.глуб -= 2
    беззн лог = не т_знаковый(ген.реш_тип(ген.тип_выр(выр.а)))
    м_меньше стр = "МЕНЬШЕ"
    м_больше стр = "БОЛЬШЕ"
    м_болрав стр = "БОЛРАВ"
    если беззн:
        м_меньше = "НИЖЕ"
        м_больше = "ВЫШЕ"
        м_болрав = "ВЫШРАВ"
    ген.пиши("СРАВ АКК, СЧТ")
    ген.пиши(_склей3(м_меньше, " ", ложь))
    ген.пиши("СРАВ АКК, ДАН")
    если диап.знач2 == 1:
        ген.пиши(_склей3(м_больше, " ", ложь))
    иначе:
        ген.пиши(_склей3(м_болрав, " ", ложь))
    ген.пиши("ПЕР АКК, 1")
    ген.пиши(_склей2("ПРЫГ ", конец))
    ген.метка(ложь)
    ген.пиши("ПЕР АКК, 0")
    ген.метка(конец)
    верни т_бул()

