функ (г *Ген) слот_узла(e *Узел) без64:
    л := г.локал_ищи(e.текст2)
    если л == пусто:
        ген_ош("внутренняя: слот не выделен", e.строка)
    верни л.смещ

функ (г *Ген) срез_дл(e *Узел) *Узел:
    т_об := г.реш_тип(г.тип_выр(e.а))
    элем := т_без8()
    esz без64 = 1
    если т_об.знач == ТВ_СТР:
        элем = т_сим()
    а если т_об.знач == ТВ_МАСС или т_об.знач == ТВ_СРЕЗ или т_об.знач == ТВ_УКАЗ:
        элем = г.реш_тип(т_об.а)
        esz = г.размер(элем)
    иначе:
        ген_ош("срез не-массива", e.строка)
    off := г.слот_узла(e)
    г.выр(e.б.а)
    если esz != 1:
        г.е(_к2("УМН АКК, АКК, ", _н(esz как цел64)))
    г.е("ВСТЕК АКК")
    г.глуб += 1
    если т_об.знач == ТВ_МАСС:
        г.адрес(e.а)
    иначе:
        г.выр(e.а)
        если т_об.знач == ТВ_СРЕЗ или т_об.знач == ТВ_СТР:
            г.е("ПЕР АКК, [АКК]")
    г.е("ИЗСТЕКА СЧТ")
    г.глуб -= 1
    г.е("ДОБ АКК, СЧТ")
    г.е(_к3("ПЕР ", _ло(off), ", АКК"))
    г.выр(e.б.б)
    г.е("ВСТЕК АКК")
    г.глуб += 1
    г.выр(e.б.а)
    г.е("ПЕР СЧТ, АКК")
    г.е("ИЗСТЕКА АКК")
    г.глуб -= 1
    г.е("ВЫЧ АКК, СЧТ")
    если e.б.знач2 == 1:
        г.е("УВЕЛ АКК")
    г.е(_к3("ПЕР ", _ло(off - 8), ", АКК"))
    г.е(_к2("АДР АКК, ", _ло(off)))
    верни т_срез(элем)

функ (г *Ген) литерал(e *Узел) *Узел:
    т := г.реш_тип(e.а)
    off := г.слот_узла(e)
    sz := г.размер(т)
    цикл := г.новая("литноль")
    г.е(_к2("ПЕР СЧТ, ", _н(sz как цел64)))
    г.е(_к2("АДР ПРМ, ", _ло(off)))
    г.метка(цикл)
    г.е("ПЕР БАЙТ[ПРМ], 0")
    г.е("УВЕЛ ПРМ")
    г.е("УМЕН СЧТ")
    г.е(_к2("НЕНОЛЬ ", цикл))
    если т.знач == ТВ_ИМЯ:
        з := г.запись_ищи(т.текст)
        именован бул = нет
        для i в 0..e.дети.длина:
            эл := список_получи(e.дети, i) как *Узел
            если эл.текст != пусто и не стр_равны(эл.текст, ""):
                именован = да
        если именован:
            поз без64 = 0
            для i в 0..e.дети.длина:
                эл := список_получи(e.дети, i) как *Узел
                имя_п := эл.текст
                если имя_п == пусто или стр_равны(имя_п, ""):
                    пл0 := список_получи(з.поля, поз) как *ГПоле
                    имя_п = пл0.имя
                пл := поле_ищи(з, имя_п)
                если пл == пусто:
                    ген_ош(_к3("у записи ", т.текст,
                               _к2(" нет поля ", имя_п)), e.строка)
                г.совместим(пл.тип, эл.а, e.строка)
                г.выр(эл.а)
                г.сохранить(_ло(off - пл.смещ), пл.тип)
                поз += 1
        иначе:
            для i в 0..e.дети.длина:
                если i >= з.поля.длина:
                    ген_ош("слишком много полей в литерале", e.строка)
                пл := список_получи(з.поля, i) как *ГПоле
                эл := список_получи(e.дети, i) как *Узел
                г.совместим(пл.тип, эл.а, e.строка)
                г.выр(эл.а)
                г.сохранить(_ло(off - пл.смещ), пл.тип)
    а если т.знач == ТВ_МАСС:
        элем := г.реш_тип(т.а)
        esz := г.размер(элем)
        если e.дети.длина > т.знач2:
            ген_ош("слишком много элементов в литерале", e.строка)
        для i в 0..e.дети.длина:
            эл := список_получи(e.дети, i) как *Узел
            г.совместим(элем, эл.а, e.строка)
            г.выр(эл.а)
            г.сохранить(_ло(off - i * esz), элем)
    иначе:
        ген_ош("литерал {..} — только записи и массивы", e.строка)
    г.е(_к2("АДР АКК, ", _ло(off)))
    верни т

