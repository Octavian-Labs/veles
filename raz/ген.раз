функ (г *Ген) стр_интерн(с стр) без64:
    i := г.стр_n
    г.стр_n += 1
    части := список_новый()
    буф := буф_новый()
    для k в 0..с.длина:
        c := с.данные[k]
        если c == 34 или c == 92 или c < 32:
            если буф.длина > 0:
                список_добавь(части, _к3("\"", буф_стр(буф), "\"") как без64)
                буф = буф_новый()
            список_добавь(части, _н(c как цел64) как без64)
        иначе:
            буф_сим(буф, c)
    если буф.длина > 0:
        список_добавь(части, _к3("\"", буф_стр(буф), "\"") как без64)
    список_добавь(части, "0" как без64)
    буф_добавь(г.данные, _к3("стрд_", _н(i как цел64), ": БАЙТ "))
    для k в 0..части.длина:
        если k > 0:
            буф_добавь(г.данные, ", ")
        буф_добавь(г.данные, список_получи(части, k) как стр)
    буф_сим(г.данные, 10)
    буф_добавь(г.данные, _к3("стр_", _н(i как цел64), ": КВАД стрд_"))
    буф_добавь(г.данные, _к3(_н(i как цел64), ", ", _н(с.длина как цел64)))
    буф_сим(г.данные, 10)
    верни i

