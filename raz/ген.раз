функ (ген *Ген) объяви_запись(объяв *Узел):
    зап *ГЗапись = новый(ГЗапись)
    зап.имя = объяв.текст
    зап.поля = список_новый()
    смещ нат.верх = 0
    для инд в 0..объяв.дети.длина:
        поле *Узел = список_получи(объяв.дети, инд) как *Узел
        тип_уз *Узел = ген.реш_тип(поле.а)
        разм нат.верх = ген.размер(тип_уз)
        ал нат.верх = разм
        если ал > 8:
            ал = 8
        если ал == 0:
            ал = 1
        смещ = (смещ + ал - 1) / ал * ал
        пл *ГПоле = новый(ГПоле)
        пл.имя = поле.текст
        пл.смещ = смещ
        пл.тип = тип_уз
        список_добавь(зап.поля, пл как нат.верх)
        смещ += разм
    зап.разм = (смещ + 7) / 8 * 8
    список_добавь(ген.записи, зап как нат.верх)

функ _асм_имя(имя стр) стр:
    # «Точка.норма» -> «Точка_норма» (точка недопустима в метке)
    буф *Буфер = буф_новый()
    для поз в 0..имя.длина:
        байт нат.старт = имя.данные[поз]
        если байт == '.':
            буф_сим(буф, '_')
        иначе:
            буф_сим(буф, байт)
    верни буф_стр(буф)

функ (ген *Ген) функ_(функ *Узел):
    ген.локалы = список_новый()
    ген.парамы = список_новый()
    ген.циклы = список_новый()
    ген.отложи = список_новый()
    ген.счёты = список_новый()
    ген.запреты = список_новый()
    ген.рег_локов = 0
    ген.возвр = функ.а
    парамы *Список = список_новый()
    имя_асм стр = ""
    если функ.в != пусто:
        тип_пр *Узел = ген.реш_тип(функ.в.а)
        имя_записи стр = ""
        если тип_пр.знач == ТВ_УКАЗ:
            имя_записи = ген.реш_тип(тип_пр.а).текст
        иначе:
            имя_записи = тип_пр.текст
        имя_асм = _склей4("ф_", имя_записи, "_", функ.текст)
        прм0 *Узел = узел(У_ПАРАМ, функ.строка)
        прм0.текст = функ.в.текст
        прм0.а = т_указ(т_запись(имя_записи))
        список_добавь(парамы, прм0 как нат.верх)
        для инд в 0..функ.дети.длина:
            список_добавь(парамы, список_получи(функ.дети, инд))
    иначе:
        имя_асм = _склей2("ф_", _асм_имя(функ.текст))
        парамы = функ.дети
    ген.фимя = стр_срез(имя_асм, 3, имя_асм.длина)   # срезать «ф_» (3 байта)
    регистров цел.верх = 4
    если ген.цель != 0:
        регистров = 6
    параметров нат.верх = 0
    если парамы != пусто:
        параметров = парамы.длина
    # регистровые параметры — домашние слоты [УКК+16+8*i]; стековые —
    # выше тени: [УКК+16+8*nreg+8*(i-nreg)] (тень == 8*nreg на обеих целях)
    для инд в 0..параметров:
        пар *Узел = список_получи(парамы, инд) как *Узел
        сим *ГСим = новый(ГСим)
        сим.имя = пар.текст
        сим.тип = пар.а
        сим.парам = да
        если (инд как цел.верх) >= регистров:
            сим.смещ = (16 + 8 * регистров + 8 * ((инд как цел.верх) - регистров)) как нат.верх
        иначе:
            сим.смещ = (16 + 8 * инд) как нат.верх
        список_добавь(ген.парамы, сим как нат.верх)
    # скан тела: локали, скрытые слоты, веса имён и запреты на регистры
    порядок *Список = список_новый()
    имена *Список = список_новый()
    ген.скан_тело(функ.дети2, порядок, имена, 0)
    смещ нат.верх = 8
    для инд в 0..порядок.длина:
        ло *ГЛок = список_получи(порядок, инд) как *ГЛок
        тип_уз *Узел = ло.тип
        если тип_уз == пусто:
            если ло.выр != пусто:
                тип_уз = ген.тип_выр(ло.выр)
            иначе:
                тип_уз = т_цел64()
        тип_уз = ген.реш_тип(тип_уз)
        разм нат.верх = (ген.размер(тип_уз) + 7) / 8 * 8
        если разм < 8:
            разм = 8
        сим = новый(ГСим)
        сим.имя = ло.имя
        сим.тип = тип_уз
        сим.смещ = смещ + разм - 8
        список_добавь(ген.локалы, сим как нат.верх)
        смещ += разм
    локалов нат.верх = смещ - 8
    ген.фрейм = (локалов + 15) / 16 * 16
    ген.выход_м = _склей3("м_", ген.фимя, "_выход")
    # регистровые переменные: самые горячие скаляры по 8 байт без взятия
    # адреса и без упоминания в искра-блоках — в сохраняемых регистрах
    канд *Список = список_новый()
    для инд в 0..ген.парамы.длина:
        сим = список_получи(ген.парамы, инд) как *ГСим
        если ген.годен_рег(сим):
            список_добавь(канд, сим как нат.верх)
    для инд в 0..ген.локалы.длина:
        сим = список_получи(ген.локалы, инд) как *ГСим
        если ген.годен_рег(сим):
            список_добавь(канд, сим как нат.верх)
    для инд в 0..5:
        лучший *ГСим = пусто как *ГСим
        лс нат.верх = 0
        для инд2 в 0..канд.длина:
            сим = список_получи(канд, инд2) как *ГСим
            вес нат.верх = ген.счёт_найди(сим.имя)
            если сим.рег == 0 и вес > лс:
                лучший = сим
                лс = вес
        если лучший == пусто:
            хватит
        лучший.рег = (инд + 1) как нат.верх
        ген.рег_локов += 1
    # пролог
    ген.метка(имя_асм)
    ген.пиши("ВСТЕК УКК")
    ген.пиши("ПЕР УКК, УКС")
    если ген.фрейм != 0:
        ген.пиши(_склей2("ВЫЧ УКС, ", _цел_стр(ген.фрейм как цел.верх)))
    для инд в 0..ген.рег_локов:
        ген.пиши(_склей2("ВСТЕК ", _рег_лок(инд)))
    ген.глуб += ген.рег_локов как цел.верх
    # домашнее сохранение регистровых параметров
    предел нат.верх = параметров
    если (предел как цел.верх) > регистров:
        предел = регистров как нат.верх
    для инд в 0..предел:
        пар = список_получи(парамы, инд) как *Узел
        сим = ген.парам_ищи(пар.текст)
        рег стр = _арг_рег(ген.цель, инд)
        разм = ген.размер(пар.а)
        если разм > 8:
            разм = 8
        если разм == 0:
            разм = 8
        регимя стр = рег
        если разм == 4:
            регимя = _склей2(рег, "М")
        а если разм == 2:
            регимя = _склей2(рег, "П")
        а если разм == 1:
            регимя = _склей2(рег, "Б")
        если сим.рег > 0:
            ген.пиши(_склей4("ПЕР ", _рег_лок(сим.рег - 1), ", ", регимя))
        иначе:
            ген.пиши(_склей3(_склей2("ПЕР ", _адр_пар(сим.смещ)), ", ", регимя))
    # стековые параметры, попавшие в регистры — снимаем сразу
    инд_п нат.верх = регистров как нат.верх
    пока инд_п < параметров:
        п2 *Узел = список_получи(парамы, инд_п) как *Узел
        с2 *ГСим = ген.парам_ищи(п2.текст)
        если с2.рег > 0:
            ген.пиши(_склей4("ПЕР ", _рег_лок(с2.рег - 1), ", ", _адр_пар(с2.смещ)))
        инд_п += 1
    # тело
    если функ.дети2 != пусто:
        для инд в 0..функ.дети2.длина:
            ген.оп(список_получи(функ.дети2, инд) как *Узел)
    # эпилог
    ген.метка(ген.выход_м)
    # отложи исполняется после «верни» — спасаем результат из АКК,
    # иначе отложенные вызовы затрут возвращаемое значение
    если ген.отложи.длина > 0:
        ген.пиши("ВСТЕК АКК")
        ген.глуб += 1
    инд_о цел.верх = (ген.отложи.длина как цел.верх) - 1
    пока инд_о >= 0:
        ген.выр(список_получи(ген.отложи, инд_о как нат.верх) как *Узел)
        инд_о -= 1
    если ген.отложи.длина > 0:
        ген.пиши("ИЗСТЕКА АКК")
        ген.глуб -= 1
    инд_р цел.верх = ген.рег_локов как цел.верх
    пока инд_р > 0:
        инд_р -= 1
        ген.пиши(_склей2("ИЗСТЕКА ", _рег_лок(инд_р как нат.верх)))
    ген.глуб -= ген.рег_локов как цел.верх
    ген.пиши("ПОКИНЬ")
    ген.пиши("ВОЗВРАТ")

функ (ген *Ген) старт():
    ген.метка("старт")
    если ген.цель == 0:
        ген.пиши("ВЫЧ УКС, 8")
        ген.пиши("ВЫЗОВ ф_главная")
        ген.пиши("ПЕР СЧТМ, АККМ")
        ген.пиши("ВЫЗОВ ExitProcess")
    а если ген.цель == 2:
        # macOS+LC_MAIN: dyld вызывает вход как функцию — argc в ПРМ,
        # argv в ИСТ; сохраняем пару в гл_аргв для библиотечной «аргументы»
        ген.пиши("АДР АКК, [гл_аргв]")
        ген.пиши("ПЕР [АКК], ПРМ")
        ген.пиши("ПЕР [АКК+8], ИСТ")
        ген.пиши("ВЫЗОВ ф_главная")
        ген.пиши("ПЕР ПРМ, АКК")
        ген.пиши("ПЕР АКК, 0x2000001")
        ген.пиши("СИСВЫЗОВ")
    иначе:
        ген.пиши("ВЫЗОВ ф_главная")
        ген.пиши("ПЕР ПРМ, АКК")
        ген.пиши("ПЕР АКК, 60")
        ген.пиши("СИСВЫЗОВ")

функ (ген *Ген) стд_хелперы():
    если ген.цель == 0:
        если (ген.нужны_стд & 1) != 0:
            ген.метка("стд_выдели")
            ген.пиши("ВСТЕК УКК")
            ген.пиши("ПЕР УКК, УКС")
            ген.пиши("ВЫЧ УКС, 48")
            ген.пиши("ПЕР [УКС+32], СЧТ")
            ген.пиши("ВЫЗОВ GetProcessHeap")
            ген.пиши("ПЕР СЧТ, АКК")
            ген.пиши("ПЕР ДАН, 8")
            ген.пиши("ПЕР Р8, [УКС+32]")
            ген.пиши("ДОБ Р8, 16")
            ген.пиши("ВЫЗОВ HeapAlloc")
            ген.пиши("ПРОВ АКК, АКК")
            ок стр = ген.новая("выд_ок")
            ген.пиши(_склей2("РАВНО ", ок))
            ген.пиши("ПЕР СЧТ, [УКС+32]")
            ген.пиши("ПЕР [АКК], СЧТ")
            ген.пиши("ДОБ АКК, 16")
            ген.метка(ок)
            ген.пиши("ПОКИНЬ")
            ген.пиши("ВОЗВРАТ")
        если (ген.нужны_стд & 2) != 0:
            ген.метка("стд_освободи")
            ген.пиши("ВСТЕК УКК")
            ген.пиши("ПЕР УКК, УКС")
            ген.пиши("ВЫЧ УКС, 48")
            ген.пиши("ПЕР [УКС+32], СЧТ")
            ген.пиши("ВЫЗОВ GetProcessHeap")
            ген.пиши("ПЕР СЧТ, АКК")
            ген.пиши("ПЕР ДАН, 0")
            ген.пиши("ПЕР Р8, [УКС+32]")
            ген.пиши("ВЫЧ Р8, 16")
            ген.пиши("ВЫЗОВ HeapFree")
            ген.пиши("ПОКИНЬ")
            ген.пиши("ВОЗВРАТ")
        если (ген.нужны_стд & 4) != 0:
            # аварийный выход по коду СЧТ (ДАН — вид операции, для будущей
            # диагностики); не возвращается
            ген.метка("стд_сбой_границы")
            ген.пиши("ВСТЕК УКК")
            ген.пиши("ПЕР УКК, УКС")
            ген.пиши("ВЫЧ УКС, 32")
            ген.пиши("ВЫЗОВ ExitProcess")
    иначе:
        # SysV-цели: linux (mmap=9, MAP_ANON=0x20) и macos
        # (mmap=0x20000C5, MAP_ANON=0x1000, munmap=0x2000049)
        н_карт нат.верх = 9 как нат.верх
        н_анон нат.верх = 0x22 как нат.верх
        н_разм нат.верх = 11 как нат.верх
        если ген.цель == 2:
            н_карт = 0x20000C5
            н_анон = 0x1002
            н_разм = 0x2000049
        если (ген.нужны_стд & 1) != 0:
            ген.метка("стд_выдели")
            ген.пиши("ПЕР ИСТ, СЧТ")
            ген.пиши("ДОБ ИСТ, 16")
            ген.пиши("ВСТЕК ИСТ")
            ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(н_карт как цел.верх)))
            ген.пиши("ПЕР ПРМ, 0")
            ген.пиши("ПЕР ДАН, 3")
            ген.пиши(_склей2("ПЕР Р10, ", _цел_стр(н_анон как цел.верх)))
            ген.пиши("ПЕР Р8, -1")
            ген.пиши("ПЕР Р9, 0")
            ген.пиши("СИСВЫЗОВ")
            ген.пиши("ИЗСТЕКА ИСТ")
            ген.пиши("ПЕР [АКК], ИСТ")
            ген.пиши("ДОБ АКК, 16")
            ген.пиши("ВОЗВРАТ")
        если (ген.нужны_стд & 2) != 0:
            ген.метка("стд_освободи")
            ген.пиши("ВЫЧ СЧТ, 16")
            ген.пиши("ПЕР ИСТ, [СЧТ]")
            ген.пиши("ПЕР ПРМ, СЧТ")
            ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(н_разм как цел.верх)))
            ген.пиши("СИСВЫЗОВ")
            ген.пиши("ВОЗВРАТ")
        если (ген.нужны_стд & 4) != 0:
            # аварийный выход по коду СЧТ; не возвращается
            н_вых нат.верх = 60 как нат.верх
            если ген.цель == 2:
                н_вых = 0x2000001
            ген.метка("стд_сбой_границы")
            ген.пиши("ПЕР ПРМ, СЧТ")
            ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(н_вых как цел.верх)))
            ген.пиши("СИСВЫЗОВ")

