функ (г *Ген) оп(s *Узел):
    v := s.вид
    если v == У_ОБЪЯВЛ:
        г.объявл(s)
        верни
    если v == У_КОНСТ:
        верни
    если v == У_ПРИСВ:
        г.присв(s)
        верни
    если v == У_ВЫРОП:
        г.выр(s.а)
        верни
    если v == У_ЕСЛИ:
        г.если_(s)
        верни
    если v == У_ПОКА:
        г.пока_(s)
        верни
    если v == У_ВЕЧНО:
        г.вечно_(s)
        верни
    если v == У_ДЛЯ:
        г.для_(s)
        верни
    если v == У_ВЫБОР:
        г.выбор_(s)
        верни
    если v == У_ВЕРНИ:
        если s.а != пусто:
            г.выр(s.а)
        г.е(_к2("ПРЫГ ", г.выход_м))
        верни
    если v == У_ХВАТИТ:
        если г.циклы.длина == 0:
            ген_ош("«хватит» вне цикла", s.строка)
        ц := список_получи(г.циклы, г.циклы.длина - 1) как *ГЦикл
        г.е(_к2("ПРЫГ ", ц.кон))
        верни
    если v == У_СЛЕДУЮЩИЙ:
        если г.циклы.длина == 0:
            ген_ош("«следующий» вне цикла", s.строка)
        ц := список_получи(г.циклы, г.циклы.длина - 1) как *ГЦикл
        г.е(_к2("ПРЫГ ", ц.шаг))
        верни
    если v == У_ОТЛОЖИ:
        список_добавь(г.отложи, s.а как без64)
        верни
    если v == У_ИСКРА:
        если s.дети != пусто:
            для i в 0..s.дети.длина:
                стр := список_получи(s.дети, i) как *Узел
                если стр.текст != пусто и стр.текст.длина > 0:
                    г.е(г.искра_подстановка(стр.текст))
        верни
    ген_ош(_к2("не поддержан оператор ", _н(v как цел64)), s.строка)

функ _слово_нач(б без8) бул:
    верни это_буква(б) или б == '_'

функ _слово_часть(б без8) бул:
    верни это_буква(б) или это_цифра(б) или б == '_'

функ (г *Ген) искра_подстановка(стр стр) стр:
    # отрезать комментарий '#'
    с := стр
    hi := стр_найди(стр, "#")
    если hi >= 0:
        с = стр_срез(стр, 0, hi как без64)
    б := буф_новый()
    k без64 = 0
    пока k < с.длина:
        б0 := с.данные[k]
        если (_слово_нач(б0) и
           (k == 0 или (не _слово_часть(с.данные[k - 1]) и
            с.данные[k - 1] != '.'))):
            j := k + 1
            пока j < с.длина и _слово_часть(с.данные[j]):
                j += 1
            # не метка «имя:» (после слова допускаются пробелы)
            m := j
            пока m < с.длина и (с.данные[m] == ' ' или с.данные[m] == 9):
                m += 1
            если m < с.длина и с.данные[m] == ':':
                для q в k..j:
                    буф_сим(б, с.данные[q])
            иначе:
                слово := стр_срез(с, k, j)
                л := г.локал_ищи(слово)
                п := г.парам_ищи(слово)
                если л != пусто:
                    буф_добавь(б, _слот(л))
                а если п != пусто:
                    буф_добавь(б, _слот(п))
                иначе:
                    буф_добавь(б, слово)
            k = j
        иначе:
            буф_сим(б, б0)
            k += 1
    верни буф_стр(б)

функ (г *Ген) объявл(s *Узел):
    л := г.локал_ищи(s.текст)
    если л == пусто:
        ген_ош(_к2("внутренняя: локаль не выделена ", s.текст), s.строка)
    off := л.смещ
    т := г.реш_тип(л.тип)
    если s.б == пусто:
        если л.рег > 0:
            г.е(_к3("ПЕР ", _рег_лок(л.рег - 1), ", 0"))
            верни
        sz := г.размер(т)
        если sz <= 8:
            если sz == 8:
                г.е(_к3("ПЕР КВАД", _ло(off), ", 0"))
            а если sz == 4:
                г.е(_к3("ПЕР ДВСЛОВО", _ло(off), ", 0"))
            а если sz == 2:
                г.е(_к3("ПЕР СЛОВО", _ло(off), ", 0"))
            иначе:
                г.е(_к3("ПЕР БАЙТ", _ло(off), ", 0"))
        иначе:
            цикл := г.новая("обнул")
            г.е(_к2("ПЕР СЧТ, ", _н(sz как цел64)))
            г.е(_к2("АДР ПРМ, ", _ло(off)))
            г.метка(цикл)
            г.е("ПЕР БАЙТ[ПРМ], 0")
            г.е("УВЕЛ ПРМ")
            г.е("УМЕН СЧТ")
            г.е(_к2("НЕНОЛЬ ", цикл))
        верни
    г.совместим(т, s.б, s.строка)
    et := г.выр(s.б)
    если т.знач == ТВ_ЛЮБОЙ:
        т = et
    если (г.реш_тип(т).знач == ТВ_ИМЯ или г.реш_тип(т).знач == ТВ_МАСС или
       г.реш_тип(г.тип_выр(s.б)).знач == ТВ_ИМЯ или
       г.реш_тип(г.тип_выр(s.б)).знач == ТВ_МАСС):
        sz := г.размер(т)
        г.е("ВСТЕК АКК")
        г.глуб += 1
        г.е(_к2("АДР АКК, ", _ло(off)))
        г.е("ПЕР ПРМ, АКК")
        г.е("ИЗСТЕКА ИСТ")
        г.глуб -= 1
        цикл := г.новая("коп")
        г.е(_к2("ПЕР СЧТ, ", _н(sz как цел64)))
        г.метка(цикл)
        г.е("ПЕР АККБ, БАЙТ[ИСТ]")
        г.е("ПЕР БАЙТ[ПРМ], АККБ")
        г.е("УВЕЛ ИСТ")
        г.е("УВЕЛ ПРМ")
        г.е("УМЕН СЧТ")
        г.е(_к2("НЕНОЛЬ ", цикл))
        верни
    г.сохранить(_слот(л), т)

функ (г *Ген) присв(s *Узел):
    # регистровая переменная: запись напрямую, без адреса и стека
    если s.а.вид == У_ИМЯ:
        сл := г.локал_ищи(s.а.текст)
        если сл == пусто:
            сл = г.парам_ищи(s.а.текст)
        если сл != пусто и сл.рег > 0:
            рг := _рег_лок(сл.рег - 1)
            т := г.тип_выр(s.а)
            г.совместим(т, s.б, s.строка)
            г.выр(s.б)
            если стр_равны(s.текст, "="):
                г.е(_к3("ПЕР ", рг, ", АКК"))
                верни
            оп := стр_срез(s.текст, 0, 1)
            если стр_равны(оп, "+"):
                г.е(_к3("ДОБ ", рг, ", АКК"))
                верни
            если стр_равны(оп, "-"):
                г.е(_к3("ВЫЧ ", рг, ", АКК"))
                верни
            если стр_равны(оп, "&"):
                г.е(_к3("И ", рг, ", АКК"))
                верни
            если стр_равны(оп, "|"):
                г.е(_к3("ИЛИ ", рг, ", АКК"))
                верни
            если стр_равны(оп, "^"):
                г.е(_к3("ИИЛИ ", рг, ", АКК"))
                верни
            если стр_равны(оп, "*"):
                г.е(_к3("УМН ", рг, ", АКК"))
                верни
            # / и %: делитель в СЧТ, делимое в АКК, ДАН свободен
            г.е("ПЕР СЧТ, АКК")
            г.е(_к2("ПЕР АКК, ", рг))
            г.е("РАСШ")
            г.е("ДЕЛ СЧТ")
            если стр_равны(оп, "%"):
                г.е("ПЕР АКК, ДАН")
            г.е(_к3("ПЕР ", рг, ", АКК"))
            верни
    г.адрес(s.а)
    т := г.тип_выр(s.а)
    г.совместим(т, s.б, s.строка)
    г.е("ВСТЕК АКК")
    г.глуб += 1
    г.выр(s.б)
    если стр_равны(s.текст, "="):
        г.е("ПЕР СЧТ, АКК")
        г.е("ИЗСТЕКА ДАН")
        г.глуб -= 1
        sz := г.размер(т)
        если sz > 8:
            sz = 8
        если sz == 8:
            г.е("ПЕР [ДАН], СЧТ")
        а если sz == 4:
            г.е("ПЕР [ДАН], СЧТМ")
        а если sz == 2:
            г.е("ПЕР [ДАН], СЧТП")
        иначе:
            г.е("ПЕР [ДАН], СЧТБ")
        верни
    оп := стр_срез(s.текст, 0, 1)
    г.е("ПЕР СЧТ, АКК")
    г.е("ИЗСТЕКА ДАН")
    г.глуб -= 1
    если стр_равны(оп, "+"):
        г.е("ДОБ [ДАН], СЧТ")
        верни
    если стр_равны(оп, "-"):
        г.е("ВЫЧ [ДАН], СЧТ")
        верни
    если стр_равны(оп, "&"):
        г.е("И [ДАН], СЧТ")
        верни
    если стр_равны(оп, "|"):
        г.е("ИЛИ [ДАН], СЧТ")
        верни
    если стр_равны(оп, "^"):
        г.е("ИИЛИ [ДАН], СЧТ")
        верни
    если стр_равны(оп, "*"):
        г.е("ПЕР АКК, [ДАН]")
        г.е("УМН АКК, СЧТ")
        г.е("ПЕР [ДАН], АКК")
        верни
    если стр_равны(оп, "/") или стр_равны(оп, "%"):
        г.е("ПЕР АКК, [ДАН]")
        г.е("ВСТЕК ДАН")
        г.глуб += 1
        г.е("РАСШ")
        г.е("ДЕЛ СЧТ")
        если стр_равны(оп, "%"):
            г.е("ПЕР АКК, ДАН")
        г.е("ИЗСТЕКА ДАН")
        г.глуб -= 1
        г.е("ПЕР [ДАН], АКК")
        верни

функ (г *Ген) если_(s *Узел):
    конец := г.новая("есликон")
    нр := s.дети.длина
    для i в 0..нр:
        р := список_получи(s.дети, i) как *Узел
        след := конец
        есть_след := i + 1 < нр или s.дети2 != пусто
        если есть_след:
            след = г.новая("еслисл")
        г.выр(р.а)
        г.е("ПРОВ АКК, АКК")
        г.е(_к2("РАВНО ", след))
        если р.дети != пусто:
            для j в 0..р.дети.длина:
                г.оп(список_получи(р.дети, j) как *Узел)
        г.е(_к2("ПРЫГ ", конец))
        если есть_след:
            г.метка(след)
    если s.дети2 != пусто:
        для j в 0..s.дети2.длина:
            г.оп(список_получи(s.дети2, j) как *Узел)
    г.метка(конец)

функ (г *Ген) пока_(s *Узел):
    нач := г.новая("пока")
    кон := г.новая("покакон")
    ц *ГЦикл = новый(ГЦикл)
    ц.шаг = нач
    ц.кон = кон
    список_добавь(г.циклы, ц как без64)
    г.метка(нач)
    г.выр(s.а)
    г.е("ПРОВ АКК, АКК")
    г.е(_к2("РАВНО ", кон))
    если s.дети != пусто:
        для j в 0..s.дети.длина:
            г.оп(список_получи(s.дети, j) как *Узел)
    г.е(_к2("ПРЫГ ", нач))
    г.метка(кон)
    г.циклы.длина -= 1

