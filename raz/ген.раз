функ т_знаковый(т *Узел) бул:
    верни т.знач == ТВ_ЦЕЛ

функ т_равны(а *Узел, б *Узел) бул:
    если а == пусто или б == пусто:
        верни а == б
    если а.знач != б.знач:
        верни нет
    если а.знач == ТВ_ИМЯ:
        верни стр_равны(а.текст, б.текст)
    если а.знач == ТВ_УКАЗ или а.знач == ТВ_СРЕЗ:
        верни т_равны(а.а, б.а)
    если а.знач == ТВ_МАСС:
        верни а.знач2 == б.знач2 и т_равны(а.а, б.а)
    верни да

# --- строки-помощники -----------------------------------------------------------

функ _н(ч цел64) стр:
    верни цел_в_стр(ч)

функ _ло(off без64) стр:
    верни стр_склей(стр_склей("[УКК-", _н(off как цел64)), "]")

функ _па(off без64) стр:
    верни стр_склей(стр_склей("[УКК+", _н(off как цел64)), "]")

# callee-saved регистры для горячих локалей и параметров (обе ABI)
функ _рег_лок(i без64) стр:
    если i == 0:
        верни "БАЗ"
    если i == 1:
        верни "Р12"
    если i == 2:
        верни "Р13"
    если i == 3:
        верни "Р14"
    верни "Р15"

функ _слот(с *ГСим) стр:
    # операнд переменной: регистр, если размещена, иначе [УКК±смещ]
    если с.рег > 0:
        верни _рег_лок(с.рег - 1)
    если с.парам:
        верни _па(с.смещ)
    верни _ло(с.смещ)

функ _слот_кв(с *ГСим) стр:
    # то же с префиксом КВАД для памяти (УВЕЛ/УМЕН/ПЕР КВАД[...])
    если с.рег > 0:
        верни _рег_лок(с.рег - 1)
    если с.парам:
        верни _к2("КВАД", _па(с.смещ))
    верни _к2("КВАД", _ло(с.смещ))

функ _к2(а стр, б стр) стр:
    верни стр_склей(а, б)

функ _к3(а стр, б стр, в стр) стр:
    верни стр_склей(стр_склей(а, б), в)

функ _к4(а стр, б стр, в стр, г стр) стр:
    верни стр_склей(стр_склей(а, б), стр_склей(в, г))

