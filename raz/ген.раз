# --- типы -----------------------------------------------------------------------

функ (г *Ген) реш_тип(т *Узел) *Узел:
    пока т != пусто и т.знач == ТВ_ИМЯ:
        с := г.син_ищи(т.текст)
        если с == пусто:
            хватит
        т = с.тип
    верни т

функ (г *Ген) размер(т *Узел) без64:
    т = г.реш_тип(т)
    v := т.знач
    если v == ТВ_МАСС:
        верни г.размер(т.а) * т.знач2
    если v == ТВ_ИМЯ:
        з := г.запись_ищи(т.текст)
        если з == пусто:
            ген_ош(_к2("неизвестная запись ", т.текст), т.строка)
        верни з.разм
    если v == ТВ_СТР или v == ТВ_СРЕЗ или v == ТВ_УКАЗ или v == ТВ_ФУНК или v == ТВ_ЛЮБОЙ:
        верни 8
    если v == ТВ_ЦЕЛ или v == ТВ_БЕЗ:
        # размер из суффикса имени: «цел64»/«без16» — цифры с 6-го байта
        бит := стр_число(стр_срез(т.текст, 6, т.текст.длина))
        верни (бит / 8) как без64
    если v == ТВ_БУЛ или v == ТВ_СИМ:
        верни 1
    верни 0

функ (г *Ген) загрузить(операнд стр, т *Узел):
    sz := г.размер(т)
    если sz >= 8:
        г.е(_к2("ПЕР АКК, ", операнд))
    а если sz == 4:
        если т_знаковый(г.реш_тип(т)):
            г.е(_к2("ЗНАКРАСШД АКК, ДВСЛОВО", операнд))
        иначе:
            г.е(_к2("ПЕР АККМ, ", операнд))
    а если sz == 2:
        если т_знаковый(г.реш_тип(т)):
            г.е(_к2("ЗНАКРАСШ АКК, СЛОВО", операнд))
        иначе:
            г.е(_к2("БЕЗРАСШ АКК, СЛОВО", операнд))
    иначе:
        если т_знаковый(г.реш_тип(т)):
            г.е(_к2("ЗНАКРАСШ АКК, БАЙТ", операнд))
        иначе:
            г.е(_к2("БЕЗРАСШ АКК, БАЙТ", операнд))

функ (г *Ген) сохранить(операнд стр, т *Узел):
    sz := г.размер(т)
    если sz > 8:
        sz = 8
    если sz == 0:
        sz = 8
    если sz == 8:
        г.е(_к3("ПЕР ", операнд, ", АКК"))
    а если sz == 4:
        г.е(_к3("ПЕР ", операнд, ", АККМ"))
    а если sz == 2:
        г.е(_к3("ПЕР ", операнд, ", АККП"))
    иначе:
        г.е(_к3("ПЕР ", операнд, ", АККБ"))

# --- константы ------------------------------------------------------------------

функ (г *Ген) конст(e *Узел) цел64:
    v := e.вид
    если v == У_ЧИСЛО:
        г.конст_большое = e.знач2 != 0
        верни e.знач как цел64
    если v == У_БУЛ:
        г.конст_большое = нет
        верни e.знач как цел64
    если v == У_ИМЯ:
        к := г.конст_ищи(e.текст)
        если к == пусто:
            ген_ош(_к2("константа не определена: ", e.текст), e.строка)
        г.конст_большое = к.большое
        верни к.знач
    если v == У_ПОЛЕ и e.а != пусто и e.а.вид == У_ИМЯ:
        п := г.переч_ищи(e.а.текст)
        если п != пусто:
            для i в 0..п.элементы.длина:
                э := список_получи(п.элементы, i) как *ГПоле
                если стр_равны(э.имя, e.текст):
                    г.конст_большое = нет
                    верни э.смещ как цел64
    если v == У_УН и стр_равны(e.текст, "-"):
        р := 0 - г.конст(e.а)
        г.конст_большое = нет
        верни р
    если v == У_ПРИВЕД:
        верни г.конст(e.а)
    если v == У_РАЗМЕР:
        г.конст_большое = нет
        если e.знач2 == 1:
            верни г.размер(e.а) как цел64
        верни г.размер(г.тип_выр(e.а)) как цел64
    если v == У_БИН:
        а := г.конст(e.а)
        б := г.конст(e.б)
        г.конст_большое = нет
        оп := e.текст
        если стр_равны(оп, "+"):
            верни а + б
        если стр_равны(оп, "-"):
            верни а - б
        если стр_равны(оп, "*"):
            верни а * б
        если стр_равны(оп, "/"):
            если б == 0:
                верни 0
            верни а / б
        если стр_равны(оп, "%"):
            если б == 0:
                верни 0
            верни а % б
        если стр_равны(оп, "&"):
            верни а & б
        если стр_равны(оп, "|"):
            верни а | б
        если стр_равны(оп, "^"):
            верни а ^ б
        если стр_равны(оп, "<<"):
            верни а << б
        если стр_равны(оп, ">>"):
            верни а >> б
        если стр_равны(оп, "=="):
            верни (а == б) как цел64
        если стр_равны(оп, "!="):
            верни (а != б) как цел64
        если стр_равны(оп, "<"):
            верни (а < б) как цел64
        если стр_равны(оп, "<="):
            верни (а <= б) как цел64
        если стр_равны(оп, ">"):
            верни (а > б) как цел64
        если стр_равны(оп, ">="):
            верни (а >= б) как цел64
    ген_ош("не константное выражение", e.строка)
    верни 0

функ (г *Ген) конст_ли(e *Узел) бул:
    # истина, если выражение вычислимо во время компиляции
    если e == пусто:
        верни нет
    v := e.вид
    если v == У_ЧИСЛО или v == У_БУЛ:
        верни да
    если v == У_ИМЯ:
        верни г.конст_ищи(e.текст) != пусто
    верни нет

# --- совместимость ---------------------------------------------------------------

функ (г *Ген) совместим(цель *Узел, выр *Узел, строка без64):
    цель = г.реш_тип(цель)
    ст := г.реш_тип(г.тип_выр(выр))
    если цель.знач == ТВ_ЛЮБОЙ или ст.знач == ТВ_ЛЮБОЙ:
        верни
    # имя-константа раскрывается в литерал
    если выр.вид == У_ИМЯ:
        к := г.конст_ищи(выр.текст)
        если к != пусто:
            ну := узел(У_ЧИСЛО, выр.строка)
            ну.знач = к.знач как без64
            ну.знач2 = к.большое как без64
            выр = ну
    если ((выр.вид == У_ЧИСЛО или выр.вид == У_БУЛ) и
       (цель.знач == ТВ_ЦЕЛ или цель.знач == ТВ_БЕЗ или
        цель.знач == ТВ_СИМ или цель.знач == ТВ_БУЛ)):
        v := выр.знач как цел64
        бит := (г.размер(цель) * 8) как цел64
        ок бул = нет
        если бит >= 64:
            если т_знаковый(цель):
                ок = да
            иначе:
                ок = v >= 0
        а если т_знаковый(цель):
            ок = (0 - (1 << (бит - 1))) <= v и v < (1 << (бит - 1))
        иначе:
            ок = 0 <= v и v < (1 << бит)
        если не ок:
            ген_ош(_к2("литерал не влезает в тип: ", _н(v)), строка)
        верни
    если цель.знач == ТВ_УКАЗ и ст.знач == ТВ_УКАЗ:
        бц := г.реш_тип(цель.а)
        бс := г.реш_тип(ст.а)
        если бц.знач == ТВ_ПУСТО или бс.знач == ТВ_ПУСТО:
            верни
        если (бц.знач != бс.знач или
           (бц.знач == ТВ_ИМЯ и не стр_равны(бц.текст, бс.текст))):
            ген_ош("несовместимые указатели", строка)
        верни
    если цель.знач == ТВ_ФУНК и ст.знач == ТВ_ФУНК:
        верни
    если цель.знач != ст.знач:
        ген_ош(_к3("несовместимые типы: ", _н(цель.знач как цел64),
                   _к2(" и ", _н(ст.знач как цел64))), строка)
    если цель.знач == ТВ_ИМЯ и не стр_равны(цель.текст, ст.текст):
        ген_ош("разные записи", строка)
    если ((цель.знач == ТВ_СРЕЗ или цель.знач == ТВ_МАСС) и
       не т_равны(цель.а, ст.а)):
        ген_ош("несовместимые базовые типы", строка)

# --- тип выражения ----------------------------------------------------------------

функ (г *Ген) тип_выр(e *Узел) *Узел:
    v := e.вид
    если v == У_ЧИСЛО:
        верни т_цел64()
    если v == У_СТР:
        верни т_стр()
    если v == У_БУЛ:
        верни т_бул()
    если v == У_ПУСТО:
        верни т_указ(т_пусто())
    если v == У_ИМЯ:
        л := г.локал_ищи(e.текст)
        если л != пусто:
            верни л.тип
        п := г.парам_ищи(e.текст)
        если п != пусто:
            верни п.тип
        если г.конст_ищи(e.текст) != пусто:
            верни т_цел64()
        ф := г.функ_ищи(e.текст)
        если ф != пусто:
            тп := список_новый()
            для i в 0..ф.парамы.длина:
                прм := список_получи(ф.парамы, i) как *Узел
                список_добавь(тп, прм.а как без64)
            верни т_функ(тп, ф.возвр)
        ген_ош(_к2("неизвестное имя ", e.текст), e.строка)
    если v == У_БИН:
        оп := e.текст
        если (_это_сравн(оп) или стр_равны(оп, "и") или стр_равны(оп, "или") или
           стр_равны(оп, "в")):
            верни т_бул()
        верни г.тип_выр(e.а)
    если v == У_УН:
        если стр_равны(e.текст, "не"):
            верни т_бул()
        верни г.тип_выр(e.а)
    если v == У_АДРЕС:
        верни т_указ(г.тип_выр(e.а))
    если v == У_РАЗЫМ:
        т := г.реш_тип(г.тип_выр(e.а))
        если т.знач != ТВ_УКАЗ:
            ген_ош("разыменование не-указателя", e.строка)
        верни т.а
    если v == У_ПОЛЕ:
        т := г.реш_тип(г.тип_выр(e.а))
        если (т.знач == ТВ_СТР или т.знач == ТВ_СРЕЗ):
            если стр_равны(e.текст, "данные"):
                верни т_указ(т_без8())
            если стр_равны(e.текст, "длина"):
                верни т_без64()
        если т.знач == ТВ_УКАЗ:
            т = г.реш_тип(т.а)
            если (т.знач == ТВ_СТР или т.знач == ТВ_СРЕЗ):
                если стр_равны(e.текст, "данные"):
                    верни т_указ(т_без8())
                если стр_равны(e.текст, "длина"):
                    верни т_без64()
        если т.знач == ТВ_ИМЯ:
            з := г.запись_ищи(т.текст)
            если з != пусто:
                пл := поле_ищи(з, e.текст)
                если пл != пусто:
                    верни пл.тип
        если e.а.вид == У_ИМЯ и г.переч_ищи(e.а.текст) != пусто:
            верни т_цел64()
        ген_ош(_к2("нет поля ", e.текст), e.строка)
    если v == У_ИНДЕКС:
        т := г.реш_тип(г.тип_выр(e.а))
        если т.знач == ТВ_МАСС или т.знач == ТВ_СРЕЗ или т.знач == ТВ_УКАЗ:
            верни т.а
        если т.знач == ТВ_СТР:
            верни т_сим()
        ген_ош("индексация не-массива", e.строка)
    если v == У_СРЕЗ:
        т := г.реш_тип(г.тип_выр(e.а))
        если т.знач == ТВ_СТР:
            верни т_срез(т_сим())
        если т.знач == ТВ_МАСС или т.знач == ТВ_СРЕЗ или т.знач == ТВ_УКАЗ:
            верни т_срез(т.а)
        ген_ош("срез не-массива", e.строка)
    если v == У_ЛИТТИП:
        верни г.реш_тип(e.а)
    если v == У_ПРИВЕД:
        верни e.б
    если v == У_РАЗМЕР:
        верни т_без64()
    если v == У_НОВЫЙ:
        верни т_указ(e.а)
    если v == У_ВЫЗОВ:
        фу := e.а
        если фу.вид == У_ПОЛЕ:
            м := г.метод_ищи(e)
            если м == пусто:
                ген_ош("вызов метода не найден", e.строка)
            верни м.возвр
        если фу.вид == У_ИМЯ:
            имя := фу.текст
            ф := г.функ_ищи(имя)
            если ф != пусто:
                верни ф.возвр
            если стр_равны(имя, "освободи"):
                верни т_пусто()
            если стр_равны(имя, "выдели"):
                верни т_указ(т_без8())
            слот := г.локал_ищи(имя)
            если слот == пусто:
                слот = г.парам_ищи(имя)
            если слот != пусто:
                ст := г.реш_тип(слот.тип)
                если ст.знач == ТВ_ФУНК:
                    если ст.б != пусто:
                        верни ст.б
                    верни т_пусто()
        верни т_любой()
    если v == У_ДИАП:
        ген_ош("диапазон допустим в «для», «выбор» и «в»", e.строка)
    верни т_любой()

функ _это_сравн(оп стр) бул:
    верни (стр_равны(оп, "==") или стр_равны(оп, "!=") или стр_равны(оп, "<") или
       стр_равны(оп, "<=") или стр_равны(оп, ">") или стр_равны(оп, ">="))

функ _cc(оп стр, знак бул) стр:
    если стр_равны(оп, "=="):
        верни "УСТРАВНО"
    если стр_равны(оп, "!="):
        верни "УСТНЕРАВНО"
    если знак:
        если стр_равны(оп, "<"):
            верни "УСТМЕНЬШЕ"
        если стр_равны(оп, "<="):
            верни "УСТМЕНРАВ"
        если стр_равны(оп, ">"):
            верни "УСТБОЛЬШЕ"
        верни "УСТБОЛРАВ"
    если стр_равны(оп, "<"):
        верни "УСТНИЖЕ"
    если стр_равны(оп, "<="):
        верни "УСТНИЖРАВ"
    если стр_равны(оп, ">"):
        верни "УСТВЫШЕ"
    верни "УСТВЫШРАВ"

# --- выражения --------------------------------------------------------------------

функ (г *Ген) выр(e *Узел) *Узел:
    v := e.вид
    если v == У_ЧИСЛО:
        если e.знач2 != 0:
            г.е(_к2("ПЕР АКК, ", без_в_стр(e.знач)))
        иначе:
            г.е(_к2("ПЕР АКК, ", _н(e.знач как цел64)))
        верни т_цел64()
    если v == У_СТР:
        i := г.стр_интерн(e.текст)
        г.е(_к3("АДР АКК, [стр_", _н(i как цел64), "]"))
        верни т_стр()
    если v == У_БУЛ:
        г.е(_к2("ПЕР АКК, ", _н(e.знач как цел64)))
        верни т_бул()
    если v == У_ПУСТО:
        г.е("ПЕР АКК, 0")
        верни т_указ(т_пусто())
    если v == У_ИМЯ:
        верни г.выр_имя(e)
    если v == У_ПРИВЕД:
        г.выр(e.а)
        верни г.реш_тип(e.б)
    если v == У_РАЗМЕР:
        если e.знач2 == 1:
            г.е(_к2("ПЕР АКК, ", _н(г.размер(e.а) как цел64)))
        иначе:
            г.е(_к2("ПЕР АКК, ", _н(г.размер(г.тип_выр(e.а)) как цел64)))
        верни т_без64()
    если v == У_НОВЫЙ:
        sz := г.размер(e.а)
        г.нужны_стд = г.нужны_стд | 1
        г.е(_к2("ПЕР СЧТ, ", _н(sz как цел64)))
        г.пад_и_вызов("стд_выдели")
        верни т_указ(e.а)
    если v == У_АДРЕС:
        г.адрес(e.а)
        верни т_указ(г.тип_выр(e.а))
    если v == У_РАЗЫМ:
        т := г.реш_тип(г.выр(e.а))
        если т.знач != ТВ_УКАЗ:
            ген_ош("разыменование не-указателя", e.строка)
        г.загрузить("[АКК]", т.а)
        верни т.а
    если v == У_ПОЛЕ:
        т := г.поле_адрес(e)
        г.загрузить("[АКК]", т)
        верни т
    если v == У_ИНДЕКС:
        т := г.индекс_адрес(e)
        г.загрузить("[АКК]", т)
        верни т
    если v == У_УН:
        верни г.унар(e)
    если v == У_БИН:
        верни г.бин(e)
    если v == У_ВЫЗОВ:
        верни г.вызов(e)
    если v == У_СРЕЗ:
        верни г.срез_дл(e)
    если v == У_ЛИТТИП:
        верни г.литерал(e)
    если v == У_ДИАП:
        ген_ош("диапазон вне контекста итерации", e.строка)
    ген_ош(_к2("не поддержан узел ", _н(e.вид как цел64)), e.строка)
    верни т_любой()

функ (г *Ген) выр_имя(e *Узел) *Узел:
    имя := e.текст
    л := г.локал_ищи(имя)
    если л != пусто:
        т := г.реш_тип(л.тип)
        если т.знач == ТВ_ИМЯ или т.знач == ТВ_МАСС:
            г.е(_к2("АДР АКК, ", _ло(л.смещ)))
            верни т
        г.загрузить(_слот(л), т)
        верни т
    п := г.парам_ищи(имя)
    если п != пусто:
        т := г.реш_тип(п.тип)
        если т.знач == ТВ_ИМЯ или т.знач == ТВ_МАСС:
            г.е(_к2("АДР АКК, ", _па(п.смещ)))
            верни т
        г.загрузить(_слот(п), т)
        верни т
    к := г.конст_ищи(имя)
    если к != пусто:
        если к.большое:
            г.е(_к2("ПЕР АКК, ", без_в_стр(к.знач как без64)))
        иначе:
            г.е(_к2("ПЕР АКК, ", _н(к.знач)))
        верни т_цел64()
    для i в 0..г.перечи.длина:
        пе := список_получи(г.перечи, i) как *ГПереч
        для j в 0..пе.элементы.длина:
            э := список_получи(пе.элементы, j) как *ГПоле
            если стр_равны(э.имя, имя):
                г.е(_к2("ПЕР АКК, ", _н(э.смещ как цел64)))
                верни т_цел64()
    ф := г.функ_ищи(имя)
    если ф != пусто:
        г.е(_к3("АДР АКК, [", ф.асм, "]"))
        тп := список_новый()
        для i в 0..ф.парамы.длина:
            прм := список_получи(ф.парамы, i) как *Узел
            список_добавь(тп, прм.а как без64)
        верни т_функ(тп, ф.возвр)
    ген_ош(_к2("неизвестное имя ", имя), e.строка)
    верни т_любой()

функ (г *Ген) адрес(e *Узел):
    если e.вид == У_ИМЯ:
        л := г.локал_ищи(e.текст)
        если л != пусто:
            г.е(_к2("АДР АКК, ", _ло(л.смещ)))
            верни
        п := г.парам_ищи(e.текст)
        если п != пусто:
            г.е(_к2("АДР АКК, ", _па(п.смещ)))
            верни
        ген_ош(_к2("нельзя взять адрес ", e.текст), e.строка)
    если e.вид == У_РАЗЫМ:
        г.выр(e.а)
        верни
    если e.вид == У_ПОЛЕ:
        г.поле_адрес(e)
        верни
    если e.вид == У_ИНДЕКС:
        г.индекс_адрес(e)
        верни
    ген_ош("выражение не имеет адреса", e.строка)

# поле стр/срез: данные=0 (*без8), длина=8 (без64)
функ _поле_пары(имя стр, off *без64) *Узел:
    если стр_равны(имя, "данные"):
        *off = 0
        верни т_указ(т_без8())
    если стр_равны(имя, "длина"):
        *off = 8
        верни т_без64()
    верни пусто как *Узел

функ (г *Ген) поле_адрес(e *Узел) *Узел:
    т_об := г.реш_тип(г.тип_выр(e.а))
    если e.а.вид == У_ИМЯ и г.переч_ищи(e.а.текст) != пусто:
        ген_ош("элемент перечисления — не адрес", e.строка)
    если т_об.знач == ТВ_СТР или т_об.знач == ТВ_СРЕЗ:
        off без64 = 0
        ft := _поле_пары(e.текст, &off)
        если ft == пусто:
            ген_ош(_к2("нет поля пары: ", e.текст), e.строка)
        г.выр(e.а)
        если off != 0:
            г.е(_к2("ДОБ АКК, ", _н(off как цел64)))
        верни ft
    если т_об.знач == ТВ_УКАЗ:
        база := г.реш_тип(т_об.а)
        если база.знач == ТВ_ИМЯ:
            ft := г.поле_записи(база.текст, e.текст, e.строка)
            off2 без64 = 0
            ft = г.поле_записи2(база.текст, e.текст, e.строка, &off2)
            г.выр(e.а)
            если off2 != 0:
                г.е(_к2("ДОБ АКК, ", _н(off2 как цел64)))
            верни ft
        если база.знач == ТВ_СТР или база.знач == ТВ_СРЕЗ:
            off3 без64 = 0
            ft3 := _поле_пары(e.текст, &off3)
            если ft3 != пусто:
                г.выр(e.а)
                если off3 != 0:
                    г.е(_к2("ДОБ АКК, ", _н(off3 как цел64)))
                верни ft3
    если т_об.знач == ТВ_ИМЯ:
        off4 без64 = 0
        ft4 := г.поле_записи2(т_об.текст, e.текст, e.строка, &off4)
        г.адрес(e.а)
        если off4 != 0:
            г.е(_к2("ДОБ АКК, ", _н(off4 как цел64)))
        верни ft4
    ген_ош(_к2("поле неприменимо: ", e.текст), e.строка)
    верни т_любой()

функ (г *Ген) поле_записи(имя_з стр, поле стр, строка без64) *Узел:
    з := г.запись_ищи(имя_з)
    если з == пусто:
        ген_ош(_к2("неизвестная запись ", имя_з), строка)
    п := поле_ищи(з, поле)
    если п == пусто:
        ген_ош(_к3("у записи ", имя_з, _к2(" нет поля ", поле)), строка)
    верни п.тип

функ (г *Ген) поле_записи2(имя_з стр, поле стр, строка без64, off *без64) *Узел:
    з := г.запись_ищи(имя_з)
    если з == пусто:
        ген_ош(_к2("неизвестная запись ", имя_з), строка)
    п := поле_ищи(з, поле)
    если п == пусто:
        ген_ош(_к3("у записи ", имя_з, _к2(" нет поля ", поле)), строка)
    *off = п.смещ
    верни п.тип

функ (г *Ген) индекс_адрес(e *Узел) *Узел:
    т_об := г.реш_тип(г.тип_выр(e.а))
    если т_об.знач == ТВ_СТР:
        г.выр(e.б)
        г.е("ВСТЕК АКК")
        г.глуб += 1
        г.выр(e.а)
        г.е("ПЕР АКК, [АКК]")
        г.е("ИЗСТЕКА СЧТ")
        г.глуб -= 1
        г.е("ДОБ АКК, СЧТ")
        верни т_сим()
    если т_об.знач == ТВ_СРЕЗ:
        элем := т_об.а
        esz := г.размер(элем)
        г.выр(e.б)
        если esz != 1:
            г.е(_к2("УМН АКК, АКК, ", _н(esz как цел64)))
        г.е("ВСТЕК АКК")
        г.глуб += 1
        г.выр(e.а)
        г.е("ПЕР АКК, [АКК]")
        г.е("ИЗСТЕКА СЧТ")
        г.глуб -= 1
        г.е("ДОБ АКК, СЧТ")
        верни элем
    если т_об.знач == ТВ_УКАЗ или т_об.знач == ТВ_МАСС:
        элем := г.реш_тип(т_об.а)
        esz := г.размер(элем)
        г.выр(e.б)
        если esz != 1:
            г.е(_к2("УМН АКК, АКК, ", _н(esz как цел64)))
        г.е("ВСТЕК АКК")
        г.глуб += 1
        если т_об.знач == ТВ_МАСС:
            г.адрес(e.а)
        иначе:
            г.выр(e.а)
        г.е("ИЗСТЕКА СЧТ")
        г.глуб -= 1
        г.е("ДОБ АКК, СЧТ")
        верни элем
    ген_ош("индексация не-массива", e.строка)
    верни т_любой()

функ (г *Ген) унар(e *Узел) *Узел:
    если стр_равны(e.текст, "-"):
        т := г.выр(e.а)
        г.е("ОТР АКК")
        верни т
    если стр_равны(e.текст, "не"):
        г.выр(e.а)
        г.е("ПРОВ АКК, АКК")
        г.е("УСТРАВНО АККБ")
        г.е("БЕЗРАСШ АКК, АККБ")
        верни т_бул()
    ген_ош(_к2("неизвестный унарный ", e.текст), e.строка)
    верни т_любой()

# --- константная свёртка ---------------------------------------------------------

функ _число_уз(v цел64, строка без64) *Узел:
    у := узел(У_ЧИСЛО, строка)
    у.знач = v как без64
    у.знач2 = у.знач >> 63
    верни у

функ (г *Ген) сверни(e *Узел) *Узел:
    # Вычисляет выражение во время компиляции; возвращает узел У_ЧИСЛО
    # или пусто, если выражение не константное. Семантика повторяет
    # сгенерированный код: усечённое деление, знаковость сдвигов и
    # сравнений по типу операндов, маска счётчика сдвига в 63.
    если e == пусто:
        верни пусто как *Узел
    v := e.вид
    если v == У_ЧИСЛО или v == У_БУЛ:
        верни e
    если v == У_ИМЯ:
        к := г.конст_ищи(e.текст)
        если к == пусто:
            верни пусто как *Узел
        у := узел(У_ЧИСЛО, e.строка)
        у.знач = к.знач как без64
        у.знач2 = к.большое как без64
        верни у
    если (v == У_ПОЛЕ и e.а != пусто и e.а.вид == У_ИМЯ):
        п := г.переч_ищи(e.а.текст)
        если п != пусто:
            для i в 0..п.элементы.длина:
                э := список_получи(п.элементы, i) как *ГПоле
                если стр_равны(э.имя, e.текст):
                    верни _число_уз(э.смещ как цел64, e.строка)
        верни пусто как *Узел
    если v == У_УН:
        а := г.сверни(e.а)
        если а == пусто:
            верни пусто как *Узел
        если стр_равны(e.текст, "-"):
            верни _число_уз(0 - (а.знач как цел64), e.строка)
        если стр_равны(e.текст, "не"):
            верни _число_уз((а.знач == 0) как цел64, e.строка)
        верни пусто как *Узел
    если v == У_ПРИВЕД:
        верни г.сверни(e.а)
    если v == У_РАЗМЕР:
        у := узел(У_ЧИСЛО, e.строка)
        если e.знач2 == 1:
            у.знач = г.размер(e.а)
        иначе:
            у.знач = г.размер(г.тип_выр(e.а))
        верни у
    если v == У_БИН:
        верни г.сверни_бин(e)
    верни пусто как *Узел

функ (г *Ген) сверни_бин(e *Узел) *Узел:
    а := г.сверни(e.а)
    если а == пусто:
        верни пусто как *Узел
    оп := e.текст
    если стр_равны(оп, "в"):
        диап := e.б
        если диап == пусто или диап.вид != У_ДИАП:
            верни пусто как *Узел
        lo := г.сверни(диап.а)
        hi := г.сверни(диап.б)
        если lo == пусто или hi == пусто:
            верни пусто как *Узел
        ок := нет
        если не т_знаковый(г.реш_тип(г.тип_выр(e.а))):
            если диап.знач2 == 1:
                ок = (а.знач >= lo.знач) и (а.знач <= hi.знач)
            иначе:
                ок = (а.знач >= lo.знач) и (а.знач < hi.знач)
        иначе:
            хс := а.знач как цел64
            лс := lo.знач как цел64
            пс := hi.знач как цел64
            если диап.знач2 == 1:
                ок = (хс >= лс) и (хс <= пс)
            иначе:
                ок = (хс >= лс) и (хс < пс)
        верни _число_уз(ок как цел64, e.строка)
    б := г.сверни(e.б)
    если б == пусто:
        верни пусто как *Узел
    если стр_равны(оп, "и"):
        верни _число_уз(((а.знач != 0) и (б.знач != 0)) как цел64, e.строка)
    если стр_равны(оп, "или"):
        верни _число_уз(((а.знач != 0) или (б.знач != 0)) как цел64, e.строка)
    lt := г.тип_выр(e.а)
    rt := г.тип_выр(e.б)
    uns := не (т_знаковый(г.реш_тип(lt)) и т_знаковый(г.реш_тип(rt)))
    ав := а.знач как цел64
    бв := б.знач как цел64
    ау := а.знач
    бу := б.знач
    если стр_равны(оп, "+"):
        верни _число_уз(ав + бв, e.строка)
    если стр_равны(оп, "-"):
        верни _число_уз(ав - бв, e.строка)
    если стр_равны(оп, "*"):
        верни _число_уз(ав * бв, e.строка)
    если стр_равны(оп, "&"):
        верни _число_уз(ав & бв, e.строка)
    если стр_равны(оп, "|"):
        верни _число_уз(ав | бв, e.строка)
    если стр_равны(оп, "^"):
        верни _число_уз(ав ^ бв, e.строка)
    если стр_равны(оп, "<<"):
        верни _число_уз(ав << (бв & 63), e.строка)
    если стр_равны(оп, ">>"):
        если uns:
            верни _число_уз((ау >> (бу & 63)) как цел64, e.строка)
        верни _число_уз(ав >> (бв & 63), e.строка)
    если (стр_равны(оп, "/") или стр_равны(оп, "%")):
        если бу == 0:
            верни пусто как *Узел
        д цел64 = 0
        о цел64 = 0
        если uns:
            д = (ау / бу) как цел64
            о = (ау % бу) как цел64
        иначе:
            д = ав / бв
            о = ав % бв
        если стр_равны(оп, "/"):
            верни _число_уз(д, e.строка)
        верни _число_уз(о, e.строка)
    если _это_сравн(оп):
        р := нет
        если uns:
            если стр_равны(оп, "=="):
                р = ау == бу
            если стр_равны(оп, "!="):
                р = ау != бу
            если стр_равны(оп, "<"):
                р = ау < бу
            если стр_равны(оп, "<="):
                р = ау <= бу
            если стр_равны(оп, ">"):
                р = ау > бу
            если стр_равны(оп, ">="):
                р = ау >= бу
        иначе:
            если стр_равны(оп, "=="):
                р = ав == бв
            если стр_равны(оп, "!="):
                р = ав != бв
            если стр_равны(оп, "<"):
                р = ав < бв
            если стр_равны(оп, "<="):
                р = ав <= бв
            если стр_равны(оп, ">"):
                р = ав > бв
            если стр_равны(оп, ">="):
                р = ав >= бв
        верни _число_уз(р как цел64, e.строка)
    верни пусто как *Узел

функ (г *Ген) бин(e *Узел) *Узел:
    оп := e.текст
    св := г.сверни(e)
    если св != пусто:
        г.е(_к2("ПЕР АКК, ", _н(св.знач как цел64)))
        если (_это_сравн(оп) или стр_равны(оп, "и") или
              стр_равны(оп, "или") или стр_равны(оп, "в")):
            верни т_бул()
        верни г.тип_выр(e.а)
    если стр_равны(оп, "и"):
        конец := г.новая("иложь")
        г.выр(e.а)
        г.е("ПРОВ АКК, АКК")
        г.е(_к2("РАВНО ", конец))
        г.выр(e.б)
        г.метка(конец)
        верни т_бул()
    если стр_равны(оп, "или"):
        конец := г.новая("иист")
        г.выр(e.а)
        г.е("ПРОВ АКК, АКК")
        г.е(_к2("НЕРАВНО ", конец))
        г.выр(e.б)
        г.метка(конец)
        верни т_бул()
    если стр_равны(оп, "в"):
        верни г.проверка_диапазона(e)
    если _это_сравн(оп):
        lt := г.тип_выр(e.а)
        rt := г.тип_выр(e.б)
        знак := т_знаковый(г.реш_тип(lt)) и т_знаковый(г.реш_тип(rt))
        г.выр(e.а)
        г.е("ВСТЕК АКК")
        г.глуб += 1
        г.выр(e.б)
        г.е("ПЕР СЧТ, АКК")
        г.е("ИЗСТЕКА АКК")
        г.глуб -= 1
        г.е("СРАВ АКК, СЧТ")
        г.е(_к2(_cc(оп, знак), " АККБ"))
        г.е("БЕЗРАСШ АКК, АККБ")
        верни т_бул()
    lt := г.тип_выр(e.а)
    г.выр(e.а)
    г.е("ВСТЕК АКК")
    г.глуб += 1
    г.выр(e.б)
    г.е("ПЕР СЧТ, АКК")
    г.е("ИЗСТЕКА АКК")
    г.глуб -= 1
    если стр_равны(оп, "+"):
        г.е("ДОБ АКК, СЧТ")
        верни lt
    если стр_равны(оп, "-"):
        г.е("ВЫЧ АКК, СЧТ")
        верни lt
    если стр_равны(оп, "&"):
        г.е("И АКК, СЧТ")
        верни lt
    если стр_равны(оп, "|"):
        г.е("ИЛИ АКК, СЧТ")
        верни lt
    если стр_равны(оп, "^"):
        г.е("ИИЛИ АКК, СЧТ")
        верни lt
    если стр_равны(оп, "*"):
        г.е("УМН АКК, СЧТ")
        верни lt
    если стр_равны(оп, "/") или стр_равны(оп, "%"):
        если т_знаковый(г.реш_тип(lt)):
            г.е("РАСШ")
            г.е("ДЕЛ СЧТ")
        иначе:
            г.е("ПЕР ДАН, 0")
            г.е("ДЕЛБ СЧТ")
        если стр_равны(оп, "%"):
            г.е("ПЕР АКК, ДАН")
        верни lt
    если стр_равны(оп, "<<"):
        г.е("СДЛ АКК, СЧТБ")
        верни lt
    если стр_равны(оп, ">>"):
        если т_знаковый(г.реш_тип(lt)):
            г.е("СДПА АКК, СЧТБ")
        иначе:
            г.е("СДП АКК, СЧТБ")
        верни lt
    ген_ош(_к2("неизвестный оператор ", оп), e.строка)
    верни т_любой()

функ (г *Ген) проверка_диапазона(e *Узел) *Узел:
    диап := e.б
    ложь := г.новая("вне")
    конец := г.новая("вкон")
    г.выр(e.а)
    г.е("ВСТЕК АКК")
    г.глуб += 1
    г.выр(диап.а)
    г.е("ВСТЕК АКК")
    г.глуб += 1
    г.выр(диап.б)
    г.е("ПЕР ДАН, АКК")
    г.е("ИЗСТЕКА СЧТ")
    г.е("ИЗСТЕКА АКК")
    г.глуб -= 2
    uns := не т_знаковый(г.реш_тип(г.тип_выр(e.а)))
    м_меньше := "МЕНЬШЕ"
    м_больше := "БОЛЬШЕ"
    м_болрав := "БОЛРАВ"
    если uns:
        м_меньше = "НИЖЕ"
        м_больше = "ВЫШЕ"
        м_болрав = "ВЫШРАВ"
    г.е("СРАВ АКК, СЧТ")
    г.е(_к3(м_меньше, " ", ложь))
    г.е("СРАВ АКК, ДАН")
    если диап.знач2 == 1:
        г.е(_к3(м_больше, " ", ложь))
    иначе:
        г.е(_к3(м_болрав, " ", ложь))
    г.е("ПЕР АКК, 1")
    г.е(_к2("ПРЫГ ", конец))
    г.метка(ложь)
    г.е("ПЕР АКК, 0")
    г.метка(конец)
    верни т_бул()

