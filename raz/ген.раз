функ (ген *Ген) требуй_лог(выр *Узел):
    тип_уз *Узел = ген.реш_тип(ген.тип_выр(выр))
    если тип_уз.знач != ТВ_БУЛ:
        ген_ош(_склей2("условие должно иметь тип лог, получено ",
            ген.имя_типа(тип_уз)), выр.строка)

функ (ген *Ген) требуй_логические_операнды(выр *Узел):
    лев *Узел = ген.реш_тип(ген.тип_выр(выр.а))
    если стр_равны(выр.текст, "не"):
        если лев.знач != ТВ_БУЛ:
            ген_ош(_склей2("оператор «не» требует лог, получено ",
                ген.имя_типа(лев)), выр.строка)
        верни
    прав *Узел = ген.реш_тип(ген.тип_выр(выр.б))
    если лев.знач != ТВ_БУЛ или прав.знач != ТВ_БУЛ:
        ген_ош(_склей3("оператор «", выр.текст,
            _склей3("» требует лог, получено ", ген.имя_типа(лев),
                _склей2(" и ", ген.имя_типа(прав)))), выр.строка)

функ (ген *Ген) тип_приведения(выр *Узел) *Узел:
    цель *Узел = ген.реш_тип(выр.б)
    исходный *Узел = ген.реш_тип(ген.тип_выр(выр.а))
    если цель.знач == ТВ_БУЛ и исходный.знач != ТВ_БУЛ:
        ген_ош(_склей2("приведение к лог требует исходный тип лог, получено ",
            ген.имя_типа(исходный)), выр.строка)
    верни цель

функ (ген *Ген) совместим(цель *Узел, выр *Узел, строка нат.верх):
    цель = ген.реш_тип(цель)
    ст *Узел = ген.реш_тип(ген.тип_выр(выр))
    если цель.знач == ТВ_ЛЮБОЙ или ст.знач == ТВ_ЛЮБОЙ:
        верни
    # имя-константа раскрывается в литерал
    если выр.вид == У_ИМЯ:
        конста *ГКонст = ген.конст_ищи(выр.текст)
        если конста != пусто:
            ну *Узел = узел(У_ЧИСЛО, выр.строка)
            ну.знач = конста.знач как нат.верх
            ну.знач2 = конста.большое как нат.верх
            выр = ну
    если (выр.вид == У_ЧИСЛО и
       (цель.знач == ТВ_ЦЕЛ или цель.знач == ТВ_БЕЗ или цель.знач == ТВ_СИМ)):
        знач цел.верх = выр.знач как цел.верх
        бит цел.верх = (ген.размер(цель) * 8) как цел.верх
        ок лог = нет
        если бит >= 64:
            если т_знаковый(цель):
                ок = да
            иначе:
                ок = знач >= 0
        а если т_знаковый(цель):
            ок = (0 - (1 << (бит - 1))) <= знач и знач < (1 << (бит - 1))
        иначе:
            ок = 0 <= знач и знач < (1 << бит)
        если не ок:
            ген_ош(_склей2("литерал не влезает в тип: ", _цел_стр(знач)), строка)
        верни
    если цель.знач == ТВ_УКАЗ и ст.знач == ТВ_УКАЗ:
        бц *Узел = ген.реш_тип(цель.а)
        бс *Узел = ген.реш_тип(ст.а)
        если бц.знач == ТВ_ПУСТО или бс.знач == ТВ_ПУСТО:
            верни
        если (бц.знач != бс.знач или
           (бц.знач == ТВ_ИМЯ и не стр_равны(бц.текст, бс.текст))):
            ген_ош("несовместимые указатели", строка)
        верни
    если цель.знач == ТВ_ФУНК и ст.знач == ТВ_ФУНК:
        верни
    если цель.знач != ст.знач:
        ген_ош(_склей3("несовместимые типы: требуется ", ген.имя_типа(цель),
                   _склей2(", получено ", ген.имя_типа(ст))), строка)
    если цель.знач == ТВ_ИМЯ и не стр_равны(цель.текст, ст.текст):
        ген_ош("разные записи", строка)
    если ((цель.знач == ТВ_СРЕЗ или цель.знач == ТВ_МАСС) и
       не т_равны(цель.а, ст.а)):
        ген_ош("несовместимые базовые типы", строка)

# --- тип выражения ----------------------------------------------------------------

функ (ген *Ген) тип_выр(выр *Узел) *Узел:
    вид нат.верх = выр.вид
    если вид == У_ЧИСЛО:
        верни т_цел64()
    если вид == У_СТР:
        верни т_стр()
    если вид == У_БУЛ:
        верни т_бул()
    если вид == У_ПУСТО:
        верни т_указ(т_пусто())
    если вид == У_ИМЯ:
        лок *ГСим = ген.локал_ищи(выр.текст)
        если лок != пусто:
            верни лок.тип
        псим *ГСим = ген.парам_ищи(выр.текст)
        если псим != пусто:
            верни псим.тип
        если ген.конст_ищи(выр.текст) != пусто:
            верни т_цел64()
        функц *ГФунк = ген.функ_ищи(выр.текст)
        если функц != пусто:
            тп *Список = список_новый()
            для инд в 0..функц.парамы.длина:
                прм *Узел = список_получи(функц.парамы, инд) как *Узел
                список_добавь(тп, прм.а как нат.верх)
            верни т_функ(тп, функц.возвр)
        ген_ош(_склей2("неизвестное имя ", выр.текст), выр.строка)
    если вид == У_БИН:
        оп стр = выр.текст
        если стр_равны(оп, "и") или стр_равны(оп, "или"):
            ген.требуй_логические_операнды(выр)
            верни т_бул()
        если _это_сравн(оп) или стр_равны(оп, "в"):
            верни т_бул()
        верни ген.тип_выр(выр.а)
    если вид == У_УН:
        если стр_равны(выр.текст, "не"):
            ген.требуй_логические_операнды(выр)
            верни т_бул()
        верни ген.тип_выр(выр.а)
    если вид == У_АДРЕС:
        верни т_указ(ген.тип_выр(выр.а))
    если вид == У_РАЗЫМ:
        тип_уз *Узел = ген.реш_тип(ген.тип_выр(выр.а))
        если тип_уз.знач != ТВ_УКАЗ:
            ген_ош("разыменование не-указателя", выр.строка)
        верни тип_уз.а
    если вид == У_ПОЛЕ:
        мф *ГФунк = ген.мод_функ(выр)
        если мф != пусто:
            мтп *Список = список_новый()
            для инд в 0..мф.парамы.длина:
                мпрм *Узел = список_получи(мф.парамы, инд) как *Узел
                список_добавь(мтп, мпрм.а как нат.верх)
            верни т_функ(мтп, мф.возвр)
        если ген.мод_конст(выр) != пусто:
            верни т_цел64()
        тип_уз = ген.реш_тип(ген.тип_выр(выр.а))
        если (тип_уз.знач == ТВ_СТР или тип_уз.знач == ТВ_СРЕЗ):
            если стр_равны(выр.текст, "данные"):
                верни т_указ(т_без8())
            если стр_равны(выр.текст, "длина"):
                верни т_без64()
        если тип_уз.знач == ТВ_УКАЗ:
            тип_уз = ген.реш_тип(тип_уз.а)
            если (тип_уз.знач == ТВ_СТР или тип_уз.знач == ТВ_СРЕЗ):
                если стр_равны(выр.текст, "данные"):
                    верни т_указ(т_без8())
                если стр_равны(выр.текст, "длина"):
                    верни т_без64()
        если тип_уз.знач == ТВ_ИМЯ:
            зап *ГЗапись = ген.запись_ищи(тип_уз.текст)
            если зап != пусто:
                пл *ГПоле = поле_ищи(зап, выр.текст)
                если пл != пусто:
                    верни пл.тип
        если выр.а.вид == У_ИМЯ и ген.переч_ищи(выр.а.текст) != пусто:
            верни т_цел64()
        ген_ош(_склей2("нет поля ", выр.текст), выр.строка)
    если вид == У_ИНДЕКС:
        тип_уз = ген.реш_тип(ген.тип_выр(выр.а))
        если тип_уз.знач == ТВ_МАСС или тип_уз.знач == ТВ_СРЕЗ или тип_уз.знач == ТВ_УКАЗ:
            верни тип_уз.а
        если тип_уз.знач == ТВ_СТР:
            верни т_сим()
        ген_ош("индексация не-массива", выр.строка)
    если вид == У_СРЕЗ:
        тип_уз = ген.реш_тип(ген.тип_выр(выр.а))
        если тип_уз.знач == ТВ_СТР:
            верни т_срез(т_сим())
        если тип_уз.знач == ТВ_МАСС или тип_уз.знач == ТВ_СРЕЗ или тип_уз.знач == ТВ_УКАЗ:
            верни т_срез(тип_уз.а)
        ген_ош("срез не-массива", выр.строка)
    если вид == У_ЛИТТИП:
        верни ген.реш_тип(выр.а)
    если вид == У_ПРИВЕД:
        верни ген.тип_приведения(выр)
    если вид == У_РАЗМЕР:
        верни т_без64()
    если вид == У_НОВЫЙ:
        верни т_указ(выр.а)
    если вид == У_ВЫЗОВ:
        фу *Узел = выр.а
        если фу.вид == У_ПОЛЕ:
            мфв *ГФунк = ген.мод_функ(фу)
            если мфв != пусто:
                верни мфв.возвр
            мет *ГМетод = ген.метод_ищи(выр)
            если мет == пусто:
                ген_ош("вызов метода не найден", выр.строка)
            верни мет.возвр
        если фу.вид == У_ИМЯ:
            имя стр = фу.текст
            функц = ген.функ_ищи(имя)
            если функц != пусто:
                верни функц.возвр
            если стр_равны(имя, "освободи"):
                верни т_пусто()
            если стр_равны(имя, "выдели"):
                верни т_указ(т_без8())
            слот *ГСим = ген.локал_ищи(имя)
            если слот == пусто:
                слот = ген.парам_ищи(имя)
            если слот != пусто:
                ст *Узел = ген.реш_тип(слот.тип)
                если ст.знач == ТВ_ФУНК:
                    если ст.б != пусто:
                        верни ст.б
                    верни т_пусто()
        верни т_любой()
    если вид == У_ДИАП:
        ген_ош("диапазон допустим в «для», «выбор» и «в»", выр.строка)
    верни т_любой()

функ _это_сравн(оп стр) лог:
    верни (стр_равны(оп, "==") или стр_равны(оп, "!=") или стр_равны(оп, "<") или
       стр_равны(оп, "<=") или стр_равны(оп, ">") или стр_равны(оп, ">="))

функ _усл_сравн(оп стр, знак лог) стр:
    если стр_равны(оп, "=="):
        верни "УСТРАВНО"
    если стр_равны(оп, "!="):
        верни "УСТНЕРАВНО"
    если знак:
        если стр_равны(оп, "<"):
            верни "УСТМЕНЬШЕ"
        если стр_равны(оп, "<="):
            верни "УСТМЕНРАВ"
        если стр_равны(оп, ">"):
            верни "УСТБОЛЬШЕ"
        верни "УСТБОЛРАВ"
    если стр_равны(оп, "<"):
        верни "УСТНИЖЕ"
    если стр_равны(оп, "<="):
        верни "УСТНИЖРАВ"
    если стр_равны(оп, ">"):
        верни "УСТВЫШЕ"
    верни "УСТВЫШРАВ"

# --- выражения --------------------------------------------------------------------

функ (ген *Ген) выр(выр *Узел) *Узел:
    вид нат.верх = выр.вид
    если вид == У_ЧИСЛО:
        если выр.знач2 != 0:
            ген.пиши(_склей2("ПЕР АКК, ", без_в_стр(выр.знач)))
        иначе:
            ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(выр.знач как цел.верх)))
        верни т_цел64()
    если вид == У_СТР:
        номер нат.верх = ген.стр_интерн(выр.текст)
        ген.пиши(_склей3("АДР АКК, [стр_", _цел_стр(номер как цел.верх), "]"))
        верни т_стр()
    если вид == У_БУЛ:
        ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(выр.знач как цел.верх)))
        верни т_бул()
    если вид == У_ПУСТО:
        ген.пиши("ПЕР АКК, 0")
        верни т_указ(т_пусто())
    если вид == У_ИМЯ:
        верни ген.выр_имя(выр)
    если вид == У_ПРИВЕД:
        тип_привед *Узел = ген.тип_приведения(выр)
        ген.выр(выр.а)
        верни тип_привед
    если вид == У_РАЗМЕР:
        если выр.знач2 == 1:
            ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(ген.размер(выр.а) как цел.верх)))
        иначе:
            ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(ген.размер(ген.тип_выр(выр.а)) как цел.верх)))
        верни т_без64()
    если вид == У_НОВЫЙ:
        разм нат.верх = ген.размер(выр.а)
        ген.нужны_стд = ген.нужны_стд | 1
        ген.пиши(_склей2("ПЕР СЧТ, ", _цел_стр(разм как цел.верх)))
        ген.пад_и_вызов("стд_выдели")
        верни т_указ(выр.а)
    если вид == У_АДРЕС:
        ген.адрес(выр.а, 2)
        верни т_указ(ген.тип_выр(выр.а))
    если вид == У_РАЗЫМ:
        тип_уз *Узел = ген.реш_тип(ген.выр(выр.а))
        если тип_уз.знач != ТВ_УКАЗ:
            ген_ош("разыменование не-указателя", выр.строка)
        ген.загрузить("[АКК]", тип_уз.а)
        верни тип_уз.а
    если вид == У_ПОЛЕ:
        # модульное имя «модуль.функ» / «модуль.КОНСТ»
        мф *ГФунк = ген.мод_функ(выр)
        если мф != пусто:
            ген.пиши(_склей3("АДР АКК, [", мф.асм, "]"))
            мтп *Список = список_новый()
            для инд в 0..мф.парамы.длина:
                мпрм *Узел = список_получи(мф.парамы, инд) как *Узел
                список_добавь(мтп, мпрм.а как нат.верх)
            верни т_функ(мтп, мф.возвр)
        мк *ГКонст = ген.мод_конст(выр)
        если мк != пусто:
            если мк.большое:
                ген.пиши(_склей2("ПЕР АКК, ", без_в_стр(мк.знач как нат.верх)))
            иначе:
                ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(мк.знач)))
            верни т_цел64()
        тип_уз = ген.поле_адрес(выр, 0)
        ген.загрузить("[АКК]", тип_уз)
        верни тип_уз
    если вид == У_ИНДЕКС:
        тип_уз = ген.индекс_адрес(выр, 0)
        ген.загрузить("[АКК]", тип_уз)
        верни тип_уз
    если вид == У_УН:
        верни ген.унар(выр)
    если вид == У_БИН:
        верни ген.бин(выр)
    если вид == У_ВЫЗОВ:
        верни ген.вызов(выр)
    если вид == У_СРЕЗ:
        верни ген.срез_дл(выр)
    если вид == У_ЛИТТИП:
        верни ген.литерал(выр)
    если вид == У_ДИАП:
        ген_ош("диапазон вне контекста итерации", выр.строка)
    ген_ош(_склей2("не поддержан узел ", _цел_стр(выр.вид как цел.верх)), выр.строка)
    верни т_любой()

функ (ген *Ген) выр_имя(выр *Узел) *Узел:
    имя стр = выр.текст
    лок *ГСим = ген.локал_ищи(имя)
    если лок != пусто:
        тип_уз *Узел = ген.реш_тип(лок.тип)
        если тип_уз.знач == ТВ_ИМЯ или тип_уз.знач == ТВ_МАСС:
            ген.пиши(_склей2("АДР АКК, ", _адр_лок(лок.смещ)))
            верни тип_уз
        ген.загрузить(_слот(лок), тип_уз)
        верни тип_уз
    псим *ГСим = ген.парам_ищи(имя)
    если псим != пусто:
        тип_уз = ген.реш_тип(псим.тип)
        если тип_уз.знач == ТВ_ИМЯ или тип_уз.знач == ТВ_МАСС:
            ген.пиши(_склей2("АДР АКК, ", _адр_пар(псим.смещ)))
            верни тип_уз
        ген.загрузить(_слот(псим), тип_уз)
        верни тип_уз
    конста *ГКонст = ген.конст_ищи(имя)
    если конста != пусто:
        если конста.большое:
            ген.пиши(_склей2("ПЕР АКК, ", без_в_стр(конста.знач как нат.верх)))
        иначе:
            ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(конста.знач)))
        верни т_цел64()
    для инд в 0..ген.перечи.длина:
        пе *ГПереч = список_получи(ген.перечи, инд) как *ГПереч
        для инд2 в 0..пе.элементы.длина:
            элем *ГПоле = список_получи(пе.элементы, инд2) как *ГПоле
            если стр_равны(элем.имя, имя):
                ген.пиши(_склей2("ПЕР АКК, ", _цел_стр(элем.смещ как цел.верх)))
                верни т_цел64()
    функц *ГФунк = ген.функ_ищи(имя)
    если функц != пусто:
        ген.пиши(_склей3("АДР АКК, [", функц.асм, "]"))
        тп *Список = список_новый()
        для инд в 0..функц.парамы.длина:
            прм *Узел = список_получи(функц.парамы, инд) как *Узел
            список_добавь(тп, прм.а как нат.верх)
        верни т_функ(тп, функц.возвр)
    ген_ош(_склей2("неизвестное имя ", имя), выр.строка)
    верни т_любой()

# контекст обращения к элементу массива: 0=чтение 1=запись 2=адрес
# (для диагностики границ; 2 также для вложенных индексов и срезов)
функ (ген *Ген) адрес(выр *Узел, конт нат.верх):
    если выр.вид == У_ИМЯ:
        лок *ГСим = ген.локал_ищи(выр.текст)
        если лок != пусто:
            ген.пиши(_склей2("АДР АКК, ", _адр_лок(лок.смещ)))
            верни
        псим *ГСим = ген.парам_ищи(выр.текст)
        если псим != пусто:
            ген.пиши(_склей2("АДР АКК, ", _адр_пар(псим.смещ)))
            верни
        ген_ош(_склей2("нельзя взять адрес ", выр.текст), выр.строка)
    если выр.вид == У_РАЗЫМ:
        ген.выр(выр.а)
        верни
    если выр.вид == У_ПОЛЕ:
        ген.поле_адрес(выр, конт)
        верни
    если выр.вид == У_ИНДЕКС:
        ген.индекс_адрес(выр, конт)
        верни
    ген_ош("выражение не имеет адреса", выр.строка)

# поле стр/срез: данные=0 (*нат.старт), длина=8 (нат.верх)
функ _поле_пары(имя стр, смещ *нат.верх) *Узел:
    если стр_равны(имя, "данные"):
        *смещ = 0
        верни т_указ(т_без8())
    если стр_равны(имя, "длина"):
        *смещ = 8
        верни т_без64()
    верни пусто как *Узел

функ (ген *Ген) поле_адрес(выр *Узел, конт нат.верх) *Узел:
    т_об *Узел = ген.реш_тип(ген.тип_выр(выр.а))
    если выр.а.вид == У_ИМЯ и ген.переч_ищи(выр.а.текст) != пусто:
        ген_ош("элемент перечисления — не адрес", выр.строка)
    если т_об.знач == ТВ_СТР или т_об.знач == ТВ_СРЕЗ:
        смещ нат.верх = 0
        тип_поля *Узел = _поле_пары(выр.текст, &смещ)
        если тип_поля == пусто:
            ген_ош(_склей2("нет поля пары: ", выр.текст), выр.строка)
        ген.выр(выр.а)
        если смещ != 0:
            ген.пиши(_склей2("ДОБ АКК, ", _цел_стр(смещ как цел.верх)))
        верни тип_поля
    если т_об.знач == ТВ_УКАЗ:
        база *Узел = ген.реш_тип(т_об.а)
        если база.знач == ТВ_ИМЯ:
            тип_поля = ген.поле_записи(база.текст, выр.текст, выр.строка)
            смещ2 нат.верх = 0
            тип_поля = ген.поле_записи2(база.текст, выр.текст, выр.строка, &смещ2)
            ген.выр(выр.а)
            если смещ2 != 0:
                ген.пиши(_склей2("ДОБ АКК, ", _цел_стр(смещ2 как цел.верх)))
            верни тип_поля
        если база.знач == ТВ_СТР или база.знач == ТВ_СРЕЗ:
            смещ3 нат.верх = 0
            тип_поля3 *Узел = _поле_пары(выр.текст, &смещ3)
            если тип_поля3 != пусто:
                ген.выр(выр.а)
                если смещ3 != 0:
                    ген.пиши(_склей2("ДОБ АКК, ", _цел_стр(смещ3 как цел.верх)))
                верни тип_поля3
    если т_об.знач == ТВ_ИМЯ:
        смещ4 нат.верх = 0
        тип_поля4 *Узел = ген.поле_записи2(т_об.текст, выр.текст, выр.строка, &смещ4)
        ген.адрес(выр.а, конт)
        если смещ4 != 0:
            ген.пиши(_склей2("ДОБ АКК, ", _цел_стр(смещ4 как цел.верх)))
        верни тип_поля4
    ген_ош(_склей2("поле неприменимо: ", выр.текст), выр.строка)
    верни т_любой()

функ (ген *Ген) поле_записи(имя_з стр, имя_поля стр, строка нат.верх) *Узел:
    зап *ГЗапись = ген.запись_ищи(имя_з)
    если зап == пусто:
        ген_ош(_склей2("неизвестная запись ", имя_з), строка)
    поле *ГПоле = поле_ищи(зап, имя_поля)
    если поле == пусто:
        ген_ош(_склей3("у записи ", имя_з, _склей2(" нет поля ", имя_поля)), строка)
    верни поле.тип

функ (ген *Ген) поле_записи2(имя_з стр, имя_поля стр, строка нат.верх, смещ *нат.верх) *Узел:
    зап *ГЗапись = ген.запись_ищи(имя_з)
    если зап == пусто:
        ген_ош(_склей2("неизвестная запись ", имя_з), строка)
    поле *ГПоле = поле_ищи(зап, имя_поля)
    если поле == пусто:
        ген_ош(_склей3("у записи ", имя_з, _склей2(" нет поля ", имя_поля)), строка)
    *смещ = поле.смещ
    верни поле.тип

# граница массива Т[N]: статическая ошибка для известного индекса в обоих
# режимах; верни да, если индекс доказанно константный и динамическая
# проверка не нужна. конт: 0=чтение 1=запись 2=адрес — для диагностики.
функ (ген *Ген) граница_масс(инд_выр *Узел, длина нат.верх, конт нат.верх,
                             строка нат.верх) лог:
    к *Узел = ген.сверни(инд_выр)
    если к == пусто:
        верни нет
    если к.знач2 != 0 или к.знач >= длина:
        вид_стр стр = "чтении"
        если конт == 1:
            вид_стр = "записи"
        а если конт == 2:
            вид_стр = "взятии адреса"
        ген_ош(_склей3(_склей2("индекс ", _цел_стр(к.знач как цел.верх)),
                   _склей3(" вне границ массива[", _цел_стр(длина как цел.верх),
                       "] при "), вид_стр), строка)
    верни да

# динамическая проверка границы Т[N] в режиме надёжно. АКК уже содержит
# индекс; вызывать до умножения на размер элемента. Знаковый индекс ловится
# на < 0, беззнаковый — только на верхней границе. Сбой → стд_сбой_границы.
функ (ген *Ген) граница_дин(инд_выр *Узел, длина нат.верх, конт нат.верх):
    т_и *Узел = ген.реш_тип(ген.тип_выр(инд_выр))
    сбой стр = ген.новая("гр_сбой")
    ок стр = ген.новая("гр_ок")
    если т_и.знач == ТВ_ЦЕЛ:
        ген.пиши("ПРОВ АКК, АКК")
        ген.пиши(_склей2("МЕНЬШЕ ", сбой))
    ген.пиши(_склей2("СРАВ АКК, ", _цел_стр(длина как цел.верх)))
    ген.пиши(_склей2("ВЫШРАВ ", сбой))
    ген.пиши(_склей2("ПРЫГ ", ок))
    ген.метка(сбой)
    ген.нужны_стд = ген.нужны_стд | 4
    ген.пиши("ПЕР СЧТ, 101")
    ген.пиши(_склей2("ПЕР ДАН, ", _цел_стр(конт как цел.верх)))
    ген.пад_и_вызов("стд_сбой_границы")
    ген.метка(ок)

# индекс среза []Т: константный отрицательный знаковый индекс — статическая
# ошибка в обоих режимах; длина среза известна только в рантайме, поэтому
# верхняя граница проверяется динамически. конт: 0=чтение 1=запись 2=адрес.
функ (ген *Ген) срез_инд_стат(инд_выр *Узел, конт нат.верх, строка нат.верх):
    к *Узел = ген.сверни(инд_выр)
    если к == пусто или к.знач2 == 0:
        верни
    вид_стр стр = "чтении"
    если конт == 1:
        вид_стр = "записи"
    а если конт == 2:
        вид_стр = "взятии адреса"
    ген_ош(_склей3(_склей2("индекс ", _цел_стр(к.знач как цел.верх)),
               " вне границ среза при ", вид_стр), строка)

функ (ген *Ген) индекс_адрес(выр *Узел, конт нат.верх) *Узел:
    т_об *Узел = ген.реш_тип(ген.тип_выр(выр.а))
    если т_об.знач == ТВ_СТР:
        ген.выр(выр.б)
        ген.пиши("ВСТЕК АКК")
        ген.глуб += 1
        ген.выр(выр.а)
        ген.пиши("ПЕР АКК, [АКК]")
        ген.пиши("ИЗСТЕКА СЧТ")
        ген.глуб -= 1
        ген.пиши("ДОБ АКК, СЧТ")
        верни т_сим()
    если т_об.знач == ТВ_СРЕЗ:
        элем *Узел = т_об.а
        разм_эл нат.верх = ген.размер(элем)
        ген.срез_инд_стат(выр.б, конт, выр.строка)
        ген.выр(выр.б)
        ген.пиши("ВСТЕК АКК")
        ген.глуб += 1
        ген.выр(выр.а)
        ген.пиши("ИЗСТЕКА СЧТ")
        ген.глуб -= 1
        если ген.режим == 1:
            # надёжно: СЧТ = индекс, АКК = &срез; длина среза в [АКК+8]
            сбой стр = ген.новая("гр_сбой")
            ок стр = ген.новая("гр_ок")
            т_и *Узел = ген.реш_тип(ген.тип_выр(выр.б))
            если т_и.знач == ТВ_ЦЕЛ:
                ген.пиши("ПРОВ СЧТ, СЧТ")
                ген.пиши(_склей2("МЕНЬШЕ ", сбой))
            ген.пиши("ПЕР ДАН, [АКК+8]")
            ген.пиши("СРАВ СЧТ, ДАН")
            ген.пиши(_склей2("ВЫШРАВ ", сбой))
            ген.пиши(_склей2("ПРЫГ ", ок))
            ген.метка(сбой)
            ген.нужны_стд = ген.нужны_стд | 4
            ген.пиши("ПЕР СЧТ, 101")
            ген.пиши(_склей2("ПЕР ДАН, ", _цел_стр(конт как цел.верх)))
            ген.пад_и_вызов("стд_сбой_границы")
            ген.метка(ок)
        если разм_эл != 1:
            ген.пиши(_склей2("УМН СЧТ, СЧТ, ", _цел_стр(разм_эл как цел.верх)))
        ген.пиши("ПЕР АКК, [АКК]")
        ген.пиши("ДОБ АКК, СЧТ")
        верни элем
    если т_об.знач == ТВ_УКАЗ или т_об.знач == ТВ_МАСС:
        элем = ген.реш_тип(т_об.а)
        разм_эл = ген.размер(элем)
        стат_ок лог = нет
        если т_об.знач == ТВ_МАСС:
            стат_ок = ген.граница_масс(выр.б, т_об.знач2, конт, выр.строка)
        ген.выр(выр.б)
        если т_об.знач == ТВ_МАСС и ген.режим == 1 и не стат_ок:
            ген.граница_дин(выр.б, т_об.знач2, конт)
        если разм_эл != 1:
            ген.пиши(_склей2("УМН АКК, АКК, ", _цел_стр(разм_эл как цел.верх)))
        ген.пиши("ВСТЕК АКК")
        ген.глуб += 1
        если т_об.знач == ТВ_МАСС:
            ген.адрес(выр.а, 2)
        иначе:
            ген.выр(выр.а)
        ген.пиши("ИЗСТЕКА СЧТ")
        ген.глуб -= 1
        ген.пиши("ДОБ АКК, СЧТ")
        верни элем
    ген_ош("индексация не-массива", выр.строка)
    верни т_любой()

функ (ген *Ген) унар(выр *Узел) *Узел:
    если стр_равны(выр.текст, "-"):
        тип_уз *Узел = ген.выр(выр.а)
        ген.пиши("ОТР АКК")
        верни тип_уз
    если стр_равны(выр.текст, "не"):
        ген.требуй_логические_операнды(выр)
        ген.выр(выр.а)
        ген.пиши("ПРОВ АКК, АКК")
        ген.пиши("УСТРАВНО АККБ")
        ген.пиши("БЕЗРАСШ АКК, АККБ")
        верни т_бул()
