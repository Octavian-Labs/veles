функ (ген *Ген) пад_и_вызов(цель стр):
    лишние цел.верх = (ген.глуб * 8) % 16
    пад цел.верх = (16 - лишние) % 16
    если пад != 0:
        ген.пиши(_склей2("ВЫЧ УКС, ", _цел_стр(пад)))
    ген.пиши(_склей2("ВЫЗОВ ", цель))
    если пад != 0:
        ген.пиши(_склей2("ДОБ УКС, ", _цел_стр(пад)))

функ (ген *Ген) метод_ищи(выр *Узел) *ГМетод:
    если выр.а.вид != У_ПОЛЕ:
        верни пусто как *ГМетод
    т_об *Узел = ген.реш_тип(ген.тип_выр(выр.а.а))
    зап стр = ""
    если т_об.знач == ТВ_ИМЯ:
        зап = т_об.текст
    а если т_об.знач == ТВ_УКАЗ:
        база *Узел = ген.реш_тип(т_об.а)
        если база.знач == ТВ_ИМЯ:
            зап = база.текст
    если стр_равны(зап, ""):
        верни пусто как *ГМетод
    верни ген.метод_ищи2(зап, выр.а.текст)

функ (ген *Ген) вызов(выр *Узел) *Узел:
    цель *Узел = выр.а
    если цель.вид == У_ПОЛЕ:
        # модульный вызов «файл.прочти(..)» / «мат.цел.нод(..)»
        мф *ГФунк = ген.мод_функ(цель)
        если мф != пусто:
            верни ген.вызов_ядро(мф.асм, мф.парамы, мф.возвр, выр.дети,
                              выр.строка, пусто как *Узел)
        мет *ГМетод = ген.метод_ищи(выр)
        если мет == пусто:
            ген_ош("поле не является методом", выр.строка)
        т_об *Узел = ген.реш_тип(ген.тип_выр(цель.а))
        приёмник *Узел = цель.а
        если т_об.знач == ТВ_ИМЯ:
            ад *Узел = узел(У_АДРЕС, цель.а.строка)
            ад.а = цель.а
            приёмник = ад
        # аргументы: приёмник + исходные
        арги *Список = список_новый()
        а0 *Узел = узел(У_АРГ, выр.строка)
        а0.а = приёмник
        список_добавь(арги, а0 как нат.верх)
        для инд в 0..выр.дети.длина:
            список_добавь(арги, список_получи(выр.дети, инд))
        верни ген.вызов_ядро(мет.асм, мет.парамы, мет.возвр, арги, выр.строка,
                          пусто как *Узел)
    если цель.вид != У_ИМЯ:
        # косвенный вызов через произвольное выражение
        тип_ф *Узел = ген.реш_тип(ген.тип_выр(цель))
        если тип_ф.знач != ТВ_ФУНК:
            ген_ош("вызов не-функции", выр.строка)
        парамы *Список = список_новый()
        для инд в 0..тип_ф.дети.длина:
            прм *Узел = узел(У_ПАРАМ, выр.строка)
            прм.текст = _склей2("а", _цел_стр(инд как цел.верх))
            прм.а = список_получи(тип_ф.дети, инд) как *Узел
            список_добавь(парамы, прм как нат.верх)
        вз *Узел = тип_ф.б
        если вз == пусто:
            вз = т_пусто()
        верни ген.вызов_ядро("", парамы, вз, выр.дети, выр.строка, цель)
    имя стр = цель.текст
    если стр_равны(имя, "освободи"):
        если выр.дети.длина != 1:
            ген_ош("освободи(указ) — один аргумент", выр.строка)
        ген.нужны_стд = ген.нужны_стд | 2
        арг *Узел = список_получи(выр.дети, 0) как *Узел
        ген.выр(арг.а)
        ген.пиши("ПЕР СЧТ, АКК")
        ген.пад_и_вызов("стд_освободи")
        верни т_пусто()
    если стр_равны(имя, "выдели"):
        если выр.дети.длина != 1:
            ген_ош("выдели(размер) — один аргумент", выр.строка)
        ген.нужны_стд = ген.нужны_стд | 1
        арг = список_получи(выр.дети, 0) как *Узел
        ген.выр(арг.а)
        ген.пиши("ПЕР СЧТ, АКК")
        ген.пад_и_вызов("стд_выдели")
        верни т_указ(т_без8())
    если стр_равны(имя, "новый"):
        ген_ош("новый(Тип) — без аргументов-выражений", выр.строка)
    функц *ГФунк = ген.функ_ищи(имя)
    если функц == пусто:
        слот *ГСим = ген.локал_ищи(имя)
        если слот == пусто:
            слот = ген.парам_ищи(имя)
        если слот != пусто:
            ст *Узел = ген.реш_тип(слот.тип)
            если ст.знач != ТВ_ФУНК:
                ген_ош(_склей2("не функция: ", имя), выр.строка)
            парамы = список_новый()
            для инд в 0..ст.дети.длина:
                прм = узел(У_ПАРАМ, выр.строка)
                прм.текст = _склей2("а", _цел_стр(инд как цел.верх))
                прм.а = список_получи(ст.дети, инд) как *Узел
                список_добавь(парамы, прм как нат.верх)
            вз = ст.б
            если вз == пусто:
                вз = т_пусто()
            верни ген.вызов_ядро("", парамы, вз, выр.дети, выр.строка, цель)
        ген_ош(_склей2("неизвестная функция ", имя), выр.строка)
    верни ген.вызов_ядро(функц.асм, функц.парамы, функц.возвр, выр.дети, выр.строка,
                      пусто как *Узел)

функ (ген *Ген) вызов_ядро(асм_имя стр, парамы *Список, возвр *Узел,
                        арги_исх *Список, строка нат.верх, косв *Узел) *Узел:
    # именованные аргументы -> позиционные
    арги *Список = список_новый()
    для инд в 0..парамы.длина:
        список_добавь(арги, 0)
    для инд в 0..арги_исх.длина:
        ар *Узел = список_получи(арги_исх, инд) как *Узел
        если ар.текст == пусто или стр_равны(ар.текст, ""):
            инд_арг цел.верх = 0 - 1
            для инд2 в 0..арги.длина:
                если список_получи(арги, инд2) == 0:
                    инд_арг = инд2 как цел.верх
                    хватит
            если инд_арг < 0:
                ген_ош("слишком много аргументов", строка)
            арги.данные[инд_арг как нат.верх] = ар.а как нат.верх
        иначе:
            найден цел.верх = 0 - 1
            для инд2 в 0..парамы.длина:
                прм *Узел = список_получи(парамы, инд2) как *Узел
                если стр_равны(прм.текст, ар.текст):
                    найден = инд2 как цел.верх
                    хватит
            если найден < 0:
                ген_ош(_склей2("нет параметра ", ар.текст), строка)
            если список_получи(арги, найден как нат.верх) != 0:
                ген_ош(_склей2("аргумент задан дважды: ", ар.текст), строка)
            арги.данные[найден как нат.верх] = ар.а как нат.верх
    для инд в 0..арги.длина:
        если список_получи(арги, инд) == 0:
            ген_ош("вызов: не хватает аргументов", строка)
    регистров цел.верх = 4
    тень цел.верх = 32
    если ген.цель != 0:
        регистров = 6
        # тень — область под домашние слоты рег-параметров [УКК+16..];
        # без неё пролог вызываемой функции затирал бы локали вызывающего
        тень = 48
    регистров_исп цел.верх = регистров
    если арги.длина < регистров:
        регистров_исп = арги.длина как цел.верх
    стековых цел.верх = (арги.длина как цел.верх) - регистров_исп
    глуб0 цел.верх = ген.глуб
    сумма цел.верх = 8 * ген.глуб + 8 * стековых + тень
    пад цел.верх = (16 - сумма % 16) % 16
    если пад != 0:
        ген.пиши(_склей2("ВЫЧ УКС, ", _цел_стр(пад)))
        ген.глуб += пад / 8
    инд = (арги.длина как цел.верх) - 1
    пока инд >= 0:
        ген.выр(список_получи(арги, инд как нат.верх) как *Узел)
        ген.пиши("ВСТЕК АКК")
        ген.глуб += 1
        инд -= 1
    если косв != пусто:
        ген.выр(косв)
        ген.пиши("ПЕР Р11, АКК")
    для инд2 в 0..регистров_исп:
        рег стр = _арг_рег(ген.цель, инд2)
        прм = список_получи(парамы, инд2) как *Узел
        разм нат.верх = ген.размер(прм.а)
        если разм == 8 или разм == 0:
            ген.пиши(_склей2("ИЗСТЕКА ", рег))
        иначе:
            ген.пиши("ИЗСТЕКА АКК")
            знак лог = т_знаковый(ген.реш_тип(прм.а))
            если разм == 4:
                если знак:
                    ген.пиши(_склей3("ЗНАКРАСШД ", рег, ", АККМ"))
                иначе:
                    ген.пиши(_склей3("ПЕР ", рег, "М, АККМ"))
            а если разм == 2:
                если знак:
                    ген.пиши(_склей3("ЗНАКРАСШ ", рег, ", АККП"))
                иначе:
                    ген.пиши(_склей3("БЕЗРАСШ ", рег, ", АККП"))
            иначе:
                если знак:
                    ген.пиши(_склей3("ЗНАКРАСШ ", рег, ", АККБ"))
                иначе:
                    ген.пиши(_склей3("БЕЗРАСШ ", рег, ", АККБ"))
        ген.глуб -= 1
    если тень != 0:
        ген.пиши(_склей2("ВЫЧ УКС, ", _цел_стр(тень)))
    если косв != пусто:
        ген.пиши("ВЫЗОВ Р11")
    иначе:
        ген.пиши(_склей2("ВЫЗОВ ", асм_имя))
    назад цел.верх = тень + 8 * стековых + пад
    если назад != 0:
        ген.пиши(_склей2("ДОБ УКС, ", _цел_стр(назад)))
    ген.глуб = глуб0
    верни возвр

функ _арг_рег(цель нат.верх, инд нат.верх) стр:
    если цель == 0:
        если инд == 0:
            верни "СЧТ"
        если инд == 1:
            верни "ДАН"
        если инд == 2:
            верни "Р8"
        верни "Р9"
    если инд == 0:
        верни "ПРМ"
    если инд == 1:
        верни "ИСТ"
    если инд == 2:
        верни "ДАН"
    если инд == 3:
        верни "СЧТ"
    если инд == 4:
        верни "Р8"
    верни "Р9"

# --- срезы и литералы --------------------------------------------------------------

функ (ген *Ген) слот_узла(выр *Узел) нат.верх:
    лок *ГСим = ген.локал_ищи(выр.текст2)
    если лок == пусто:
        ген_ош("внутренняя: слот не выделен", выр.строка)
    верни лок.смещ

# статическая проверка создания среза об[a..b]: константные границы
# проверяются в обоих режимах — порядок (нач > кон) и, для массива Т[N],
# верхняя граница (кон > N; для ..= кон >= N, что также ловит переполнение
# кон + 1). верни да, если динамическая проверка не нужна.
функ (ген *Ген) граница_срез(выр *Узел, т_об *Узел, вкл лог) лог:
    к_н *Узел = ген.сверни(выр.б.а)
    к_к *Узел = ген.сверни(выр.б.б)
    если к_н != пусто и к_н.знач2 != 0:
        ген_ош(_склей2("начало среза отрицательно: ",
            _цел_стр(к_н.знач как цел.верх)), выр.строка)
    если к_к != пусто и к_к.знач2 != 0:
        ген_ош(_склей2("конец среза отрицателен: ",
            _цел_стр(к_к.знач как цел.верх)), выр.строка)
    если к_н == пусто или к_к == пусто:
        верни нет
    если к_н.знач > к_к.знач:
        ген_ош(_склей4("срез [", _цел_стр(к_н.знач как цел.верх),
            _склей2("..", _цел_стр(к_к.знач как цел.верх)),
            "]: начало больше конца"), выр.строка)
    если т_об.знач == ТВ_МАСС:
        вне лог = к_к.знач > т_об.знач2
        если вкл:
            вне = к_к.знач >= т_об.знач2
        если вне:
            ген_ош(_склей4(_склей3("срез [", _цел_стр(к_н.знач как цел.верх),
                _склей2("..", _цел_стр(к_к.знач как цел.верх))),
                "] вне границ массива[",
                _цел_стр(т_об.знач2 как цел.верх), "]"), выр.строка)
        верни да
    верни нет

функ (ген *Ген) срез_дл(выр *Узел) *Узел:
    т_об *Узел = ген.реш_тип(ген.тип_выр(выр.а))
    элем *Узел = т_без8()
    разм_эл нат.верх = 1
    если т_об.знач == ТВ_СТР:
        элем = т_сим()
    а если т_об.знач == ТВ_МАСС или т_об.знач == ТВ_СРЕЗ или т_об.знач == ТВ_УКАЗ:
        элем = ген.реш_тип(т_об.а)
        разм_эл = ген.размер(элем)
    иначе:
        ген_ош("срез не-массива", выр.строка)
    смещ нат.верх = ген.слот_узла(выр)
    вкл лог = выр.б.знач2 == 1
    указ_ист лог = т_об.знач == ТВ_УКАЗ
    стат_ок лог = ген.граница_срез(выр, т_об, вкл)
    если ген.режим == 1 и указ_ист:
        ген_пред("срез сырого указателя — длина неизвестна, границы не проверяются",
            выр.строка)
    # начало и конец вычисляются по одному разу; АКК = начало, СЧТ = конец
    ген.выр(выр.б.а)
    ген.пиши("ВСТЕК АКК")
    ген.глуб += 1
    ген.выр(выр.б.б)
    ген.пиши("ПЕР СЧТ, АКК")
    ген.пиши("ИЗСТЕКА АКК")
    ген.глуб -= 1
    дин лог = ген.режим == 1 и не стат_ок и не указ_ист
    сбой_п стр = ""
    сбой_в стр = ""
    ок стр = ""
    глуб_п цел.верх = ген.глуб
    если дин:
        # порядок и знак до вычисления длины: нач < 0, кон < 0, нач > кон;
        # вход с текущей глубиной — метка сбой_п
        сбой_п = ген.новая("ср_сбойп")
        сбой_в = ген.новая("ср_сбойв")
        ок = ген.новая("ср_ок")
        т_н *Узел = ген.реш_тип(ген.тип_выр(выр.б.а))
        т_к *Узел = ген.реш_тип(ген.тип_выр(выр.б.б))
        если т_н.знач == ТВ_ЦЕЛ:
            ген.пиши("ПРОВ АКК, АКК")
            ген.пиши(_склей2("МЕНЬШЕ ", сбой_п))
        если т_к.знач == ТВ_ЦЕЛ:
            ген.пиши("ПРОВ СЧТ, СЧТ")
            ген.пиши(_склей2("МЕНЬШЕ ", сбой_п))
        ген.пиши("СРАВ АКК, СЧТ")
        если т_н.знач == ТВ_ЦЕЛ или т_к.знач == ТВ_ЦЕЛ:
            ген.пиши(_склей2("БОЛЬШЕ ", сбой_п))
        иначе:
            ген.пиши(_склей2("ВЫШЕ ", сбой_п))
    ген.пиши("ВСТЕК АКК")
    ген.глуб += 1
    ген.пиши("ВСТЕК СЧТ")
    ген.глуб += 1
    если т_об.знач == ТВ_МАСС:
        ген.адрес(выр.а, 2)
    иначе:
        ген.выр(выр.а)
        если т_об.знач == ТВ_СРЕЗ или т_об.знач == ТВ_СТР:
            если дин:
                ген.пиши("ПЕР ДАН, [АКК+8]")
            ген.пиши("ПЕР АКК, [АКК]")
    ген.пиши("ИЗСТЕКА СЧТ")
    ген.глуб -= 1
    если дин:
        # верхняя граница: кон > длина (..) или кон >= длина (..=);
        # вход при глубине 1 — метка сбой_в
        если т_об.знач == ТВ_МАСС:
            ген.пиши(_склей2("СРАВ СЧТ, ", _цел_стр(т_об.знач2 как цел.верх)))
        иначе:
            ген.пиши("СРАВ СЧТ, ДАН")
        если вкл:
            ген.пиши(_склей2("ВЫШРАВ ", сбой_в))
        иначе:
            ген.пиши(_склей2("ВЫШЕ ", сбой_в))
        ген.пиши(_склей2("ПРЫГ ", ок))
        ген.нужны_стд = ген.нужны_стд | 4
        # два входа с разной глубиной стека: у каждого свой паддинг вызова
        ген.метка(сбой_в)
        ген.пиши("ПЕР СЧТ, 102")
        ген.пиши("ПЕР ДАН, 0")
        ген.пад_и_вызов("стд_сбой_границы")
        ген.метка(сбой_п)
        глуб_была цел.верх = ген.глуб
        ген.глуб = глуб_п
        ген.пиши("ПЕР СЧТ, 102")
        ген.пиши("ПЕР ДАН, 0")
        ген.пад_и_вызов("стд_сбой_границы")
        ген.глуб = глуб_была
        ген.метка(ок)
    ген.пиши("ИЗСТЕКА ДАН")
    ген.глуб -= 1
    ген.пиши("ВЫЧ СЧТ, ДАН")
    если вкл:
        ген.пиши("УВЕЛ СЧТ")
    ген.пиши(_склей3("ПЕР ", _адр_лок(смещ - 8), ", СЧТ"))
    если разм_эл != 1:
        ген.пиши(_склей2("УМН ДАН, ДАН, ", _цел_стр(разм_эл как цел.верх)))
    ген.пиши("ДОБ АКК, ДАН")
    ген.пиши(_склей3("ПЕР ", _адр_лок(смещ), ", АКК"))
    ген.пиши(_склей2("АДР АКК, ", _адр_лок(смещ)))
    верни т_срез(элем)

функ (ген *Ген) литерал(выр *Узел) *Узел:
    тип_уз *Узел = ген.реш_тип(выр.а)
    смещ нат.верх = ген.слот_узла(выр)
    разм нат.верх = ген.размер(тип_уз)
    цикл стр = ген.новая("лит_ноль")
    ген.пиши(_склей2("ПЕР СЧТ, ", _цел_стр(разм как цел.верх)))
    ген.пиши(_склей2("АДР ПРМ, ", _адр_лок(смещ)))
    ген.метка(цикл)
    ген.пиши("ПЕР БАЙТ[ПРМ], 0")
    ген.пиши("УВЕЛ ПРМ")
    ген.пиши("УМЕН СЧТ")
    ген.пиши(_склей2("НЕНОЛЬ ", цикл))
    если тип_уз.знач == ТВ_ИМЯ:
        зап *ГЗапись = ген.запись_ищи(тип_уз.текст)
        именован лог = нет
        для инд в 0..выр.дети.длина:
            эл *Узел = список_получи(выр.дети, инд) как *Узел
            если эл.текст != пусто и не стр_равны(эл.текст, ""):
                именован = да
        если именован:
            поз нат.верх = 0
            для инд в 0..выр.дети.длина:
                эл = список_получи(выр.дети, инд) как *Узел
                имя_п стр = эл.текст
                если имя_п == пусто или стр_равны(имя_п, ""):
                    пл0 *ГПоле = список_получи(зап.поля, поз) как *ГПоле
                    имя_п = пл0.имя
                пл *ГПоле = поле_ищи(зап, имя_п)
                если пл == пусто:
                    ген_ош(_склей3("у записи ", тип_уз.текст,
                               _склей2(" нет поля ", имя_п)), выр.строка)
                ген.совместим(пл.тип, эл.а, выр.строка)
                ген.выр(эл.а)
                ген.сохранить(_адр_лок(смещ - пл.смещ), пл.тип)
                поз += 1
        иначе:
            для инд в 0..выр.дети.длина:
                если инд >= зап.поля.длина:
                    ген_ош("слишком много полей в литерале", выр.строка)
                пл = список_получи(зап.поля, инд) как *ГПоле
                эл = список_получи(выр.дети, инд) как *Узел
                ген.совместим(пл.тип, эл.а, выр.строка)
                ген.выр(эл.а)
                ген.сохранить(_адр_лок(смещ - пл.смещ), пл.тип)
    а если тип_уз.знач == ТВ_МАСС:
        элем *Узел = ген.реш_тип(тип_уз.а)
        разм_эл нат.верх = ген.размер(элем)
        если выр.дети.длина > тип_уз.знач2:
            ген_ош("слишком много элементов в литерале", выр.строка)
        для инд в 0..выр.дети.длина:
            эл = список_получи(выр.дети, инд) как *Узел
            ген.совместим(элем, эл.а, выр.строка)
            ген.выр(эл.а)
            ген.сохранить(_адр_лок(смещ - инд * разм_эл), элем)
    иначе:
        ген_ош("литерал {..} — только записи и массивы", выр.строка)
    ген.пиши(_склей2("АДР АКК, ", _адр_лок(смещ)))
    верни тип_уз

