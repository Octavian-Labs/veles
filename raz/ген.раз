функ _лок_добавь(порядок *Список, имя стр, т *Узел, выр *Узел):
    л *ГЛок = новый(ГЛок)
    л.имя = имя
    л.тип = т
    л.выр = выр
    список_добавь(порядок, л как без64)

функ _имя_есть(имена *Список, имя стр) бул:
    для i в 0..имена.длина:
        если стр_равны(список_получи(имена, i) как стр, имя):
            верни да
    верни нет

функ (г *Ген) скан_выр(e *Узел, порядок *Список, гл без64):
    # гл — глубина вложенных циклов: обращения внутри цикла весят больше
    если e == пусто:
        верни
    v := e.вид
    если v == У_ЛИТТИП:
        слот := _к2("_лит", _н(г.lbl как цел64))
        г.lbl += 1
        e.текст2 = слот
        _лок_добавь(порядок, слот, г.реш_тип(e.а), пусто как *Узел)
        для i в 0..e.дети.длина:
            эл := список_получи(e.дети, i) как *Узел
            г.скан_выр(эл.а, порядок, гл)
        верни
    если v == У_СРЕЗ:
        слот := _к2("_срез", _н(г.lbl как цел64))
        г.lbl += 1
        e.текст2 = слот
        _лок_добавь(порядок, слот, т_масс(т_без8(), 16), пусто как *Узел)
        г.скан_выр(e.а, порядок, гл)
        г.скан_выр(e.б.а, порядок, гл)
        г.скан_выр(e.б.б, порядок, гл)
        верни
    если v == У_ИМЯ:
        г.счёт_бамп(e.текст, 1 + 4 * гл)
        верни
    если (v == У_ЧИСЛО или v == У_СТР или v == У_БУЛ или
       v == У_ПУСТО или v == У_ТИП):
        верни
    если v == У_АДРЕС и e.а != пусто и e.а.вид == У_ИМЯ:
        # взятие адреса переменной требует реального слота в кадре
        _запрет_добавь(г, e.а.текст)
    # общий обход полей
    г.скан_выр(e.а, порядок, гл)
    г.скан_выр(e.б, порядок, гл)
    г.скан_выр(e.в, порядок, гл)
    г.скан_выр(e.г, порядок, гл)
    если e.дети != пусто:
        для i в 0..e.дети.длина:
            г.скан_выр(список_получи(e.дети, i) как *Узел, порядок, гл)
    если e.дети2 != пусто:
        для i в 0..e.дети2.длина:
            г.скан_выр(список_получи(e.дети2, i) как *Узел, порядок, гл)

функ (г *Ген) скан_тело(тело *Список, порядок *Список, имена *Список,
                        гл без64):
    если тело == пусто:
        верни
    для si в 0..тело.длина:
        s := список_получи(тело, si) как *Узел
        v := s.вид
        если v == У_ОБЪЯВЛ:
            если не _имя_есть(имена, s.текст):
                список_добавь(имена, s.текст как без64)
                _лок_добавь(порядок, s.текст, s.а, s.б)
            г.скан_выр(s.б, порядок, гл)
        а если v == У_КОНСТ:
            к *ГКонст = новый(ГКонст)
            к.имя = s.текст
            к.знач = г.конст(s.а)
            к.большое = г.конст_большое
            список_добавь(г.консты, к как без64)
        а если v == У_ПРИСВ:
            г.скан_выр(s.а, порядок, гл)
            г.скан_выр(s.б, порядок, гл)
        а если v == У_ВЫРОП или v == У_ВЕРНИ или v == У_ОТЛОЖИ:
            г.скан_выр(s.а, порядок, гл)
        а если v == У_ИСКРА:
            # имена в сырой ИСКРЕ должны остаться адресуемыми в кадре
            если s.дети != пусто:
                для i в 0..s.дети.длина:
                    г.искра_запреты((список_получи(s.дети, i) как *Узел).текст)
        а если v == У_ЕСЛИ:
            если s.дети != пусто:
                для i в 0..s.дети.длина:
                    р := список_получи(s.дети, i) как *Узел
                    г.скан_выр(р.а, порядок, гл)
                    г.скан_тело(р.дети, порядок, имена, гл)
            г.скан_тело(s.дети2, порядок, имена, гл)
        а если v == У_ПОКА:
            г.скан_выр(s.а, порядок, гл + 1)
            г.скан_тело(s.дети, порядок, имена, гл + 1)
        а если v == У_ВЕЧНО:
            г.скан_тело(s.дети, порядок, имена, гл + 1)
        а если v == У_ДЛЯ:
            для k в 0..s.дети.длина:
                имя_у := список_получи(s.дети, k) как *Узел
                если не _имя_есть(имена, имя_у.текст):
                    список_добавь(имена, имя_у.текст как без64)
                    если k == 0:
                        _лок_добавь(порядок, имя_у.текст, т_цел64(),
                                    пусто как *Узел)
                    иначе:
                        инд := узел(У_ИНДЕКС, s.строка)
                        инд.а = s.а
                        ч := узел(У_ЧИСЛО, s.строка)
                        инд.б = ч
                        _лок_добавь(порядок, имя_у.текст, пусто как *Узел, инд)
                # переменная цикла пишется и читается на каждой итерации
                г.счёт_бамп(имя_у.текст, 5 + 4 * гл)
            г.скан_выр(s.а, порядок, гл)
            слот := _к2("_предел", _н(г.lbl как цел64))
            г.lbl += 1
            s.текст2 = слот
            _лок_добавь(порядок, слот, т_цел64(), пусто как *Узел)
            г.счёт_бамп(слот, 5 + 4 * гл)
            г.скан_тело(s.дети2, порядок, имена, гл + 1)
        а если v == У_ВЫБОР:
            г.скан_выр(s.а, порядок, гл)
            слот := _к2("_выбор", _н(г.lbl как цел64))
            г.lbl += 1
            s.текст2 = слот
            _лок_добавь(порядок, слот, т_цел64(), пусто как *Узел)
            если s.дети != пусто:
                для i в 0..s.дети.длина:
                    вр := список_получи(s.дети, i) как *Узел
                    если вр.дети != пусто:
                        для j в 0..вр.дети.длина:
                            г.скан_выр(список_получи(вр.дети, j) как *Узел,
                                       порядок, гл)
                    г.скан_тело(вр.дети2, порядок, имена, гл)
            г.скан_тело(s.дети2, порядок, имена, гл)

