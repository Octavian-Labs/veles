открыто функ (ген *Ген) искра_запреты(текст стр):
    # слова-имена в строке сырой ИСКРЫ — те же правила, что в искра_подстановка
    введи раб = текст
    верх смещение = стр_найди(текст, "#")
    если верх >= 0:
        раб = стр_срез(текст, 0, верх как размер)
    поз размер = 0
    пока поз < раб.длина:
        б0 нат.старт = раб.данные[поз]
        если (_слово_нач(б0) и
           (поз == 0 или (не _слово_часть(раб.данные[поз - 1]) и
            раб.данные[поз - 1] != '.'))):
            кон размер = поз + 1
            пока кон < раб.длина и _слово_часть(раб.данные[кон]):
                кон += 1
            после размер = кон
            пока после < раб.длина и (раб.данные[после] == ' ' или раб.данные[после] == 9):
                после += 1
            если после >= раб.длина или раб.данные[после] != ':':
                _запрет_добавь(ген, стр_срез(раб, поз, кон))
            поз = кон
        иначе:
            поз += 1

