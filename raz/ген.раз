открыто функ (ген *Ген) пад_и_вызов(цель стр):
    лишние размер = (ген.глуб * 8) % 16
    пад размер = ((16 - (лишние как цел.верх)) % 16) как размер
    если пад != 0:
        ген.пиши(_склей2("ВЫЧ УКС, ", _цел_стр(пад как цел.верх)))
    ген.пиши(_склей2("ВЫЗОВ ", цель))
    если пад != 0:
        ген.пиши(_склей2("ДОБ УКС, ", _цел_стр(пад как цел.верх)))

открыто функ (ген *Ген) метод_ищи(выр *Узел) *ГМетод:
    если выр.а.вид != У_ПОЛЕ:
        верни пусто как *ГМетод
    т_об *Узел = ген.реш_тип(ген.тип_выр(выр.а.а))
    зап стр = ""
    если т_об.знач == ТВ_ИМЯ:
        зап = т_об.текст
    а если т_об.знач == ТВ_УКАЗ:
        база *Узел = ген.реш_тип(т_об.а)
        если база.знач == ТВ_ИМЯ:
            зап = база.текст
    если стр_равны(зап, ""):
        верни пусто как *ГМетод
    верни ген.метод_ищи2(зап, выр.а.текст)

открыто функ (ген *Ген) вызов(выр *Узел) *Узел:
    цель *Узел = выр.а
    если цель.вид == У_ПОЛЕ:
        # модульный вызов «файл.прочти(..)» / «мат.цел.нод(..)»
        мф *ГФунк = ген.мод_функ(цель)
        если мф != пусто:
            верни ген.вызов_ядро(мф.асм, мф.парамы, мф.возвр, выр.дети,
                              выр.строка, пусто как *Узел)
        мет *ГМетод = ген.метод_ищи(выр)
        если мет == пусто:
            ген_ош("поле не является методом", выр.строка)
        т_об *Узел = ген.реш_тип(ген.тип_выр(цель.а))
        приёмник *Узел = цель.а
        если т_об.знач == ТВ_ИМЯ:
            ад *Узел = узел(У_АДРЕС, цель.а.строка)
            ад.а = цель.а
            приёмник = ад
        # аргументы: приёмник + исходные
        арги *Список = список_новый()
        а0 *Узел = узел(У_АРГ, выр.строка)
        а0.а = приёмник
        список_добавь(арги, а0 как размер)
        для инд в 0..выр.дети.длина:
            список_добавь(арги, список_получи(выр.дети, инд))
        верни ген.вызов_ядро(мет.асм, мет.парамы, мет.возвр, арги, выр.строка,
                          пусто как *Узел)
    если цель.вид != У_ИМЯ:
        # косвенный вызов через произвольное выражение
        тип_ф *Узел = ген.реш_тип(ген.тип_выр(цель))
        если тип_ф.знач != ТВ_ФУНК:
            ген_ош("вызов не-функции", выр.строка)
        парамы *Список = список_новый()
        для инд в 0..тип_ф.дети.длина:
            прм *Узел = узел(У_ПАРАМ, выр.строка)
            прм.текст = _склей2("а", _цел_стр(инд как цел.верх))
            прм.а = список_получи(тип_ф.дети, инд) как *Узел
            список_добавь(парамы, прм как размер)
        вз *Узел = тип_ф.б
        если вз == пусто:
            вз = т_пусто()
        верни ген.вызов_ядро("", парамы, вз, выр.дети, выр.строка, цель)
    имя стр = цель.текст
    если стр_равны(имя, "освободи"):
        если выр.дети.длина != 1:
            ген_ош("освободи(указ) — один аргумент", выр.строка)
        арг *Узел = список_получи(выр.дети, 0) как *Узел
        ген.выр(арг.а)
        ген.пиши("ПЕР СЧТ, АКК")
        если ген.память == 1:
            # проверка: магия/состояние/огранка, отравление, карантин; 104 при сбое
            ген.нужны(32 | 64)
            ген.пиши("ВСТЕК БАЗ")
            ген.глуб += 1
            ген.пиши(_склей2("ПЕР БАЗ, ", _цел_стр(выр.строка как цел.верх)))
            ген.пад_и_вызов("стд_освободи_пров")
            ген.пиши("ИЗСТЕКА БАЗ")
            ген.глуб -= 1
        иначе:
            ген.нужны(2)
            ген.пад_и_вызов("стд_освободи")
        верни т_пусто()
    если стр_равны(имя, "выдели"):
        если выр.дети.длина != 1:
            ген_ош("выдели(размер) — один аргумент", выр.строка)
        ген.нужны(1 | 16)
        хелпер_в стр = "стд_выдели"
        если ген.память == 1:
            хелпер_в = "стд_выдели_пров"
            ген.нужны(32 | 64)
        арг = список_получи(выр.дети, 0) как *Узел
        ген.выр(арг.а)
        ген.пиши("ПЕР СЧТ, АКК")
        ген.пиши("ВСТЕК БАЗ")
        ген.глуб += 1
        ген.пиши(_склей2("ПЕР БАЗ, ", _цел_стр(выр.строка как цел.верх)))
        ген.пад_и_вызов(хелпер_в)
        ген.пиши("ИЗСТЕКА БАЗ")
        ген.глуб -= 1
        верни т_указ(т_без8())
    если стр_равны(имя, "новый"):
        ген_ош("новый(Тип) — без аргументов-выражений", выр.строка)
    функц *ГФунк = ген.функ_ищи(имя)
    если функц == пусто:
        слот *ГСим = ген.локал_ищи(имя)
        если слот == пусто:
            слот = ген.парам_ищи(имя)
        если слот != пусто:
            ст *Узел = ген.реш_тип(слот.тип)
            если ст.знач != ТВ_ФУНК:
                ген_ош(_склей2("не функция: ", имя), выр.строка)
            парамы = список_новый()
            для инд в 0..ст.дети.длина:
                прм = узел(У_ПАРАМ, выр.строка)
                прм.текст = _склей2("а", _цел_стр(инд как цел.верх))
                прм.а = список_получи(ст.дети, инд) как *Узел
                список_добавь(парамы, прм как размер)
            вз = ст.б
            если вз == пусто:
                вз = т_пусто()
            верни ген.вызов_ядро("", парамы, вз, выр.дети, выр.строка, цель)
        ген_ош(_склей2("неизвестная функция ", имя), выр.строка)
    верни ген.вызов_ядро(функц.асм, функц.парамы, функц.возвр, выр.дети, выр.строка,
                      пусто как *Узел)

открыто функ (ген *Ген) вызов_ядро(асм_имя стр, парамы *Список, возвр *Узел,
                        арги_исх *Список, строка размер, косв *Узел) *Узел:
    # именованные аргументы -> позиционные
    арги *Список = список_новый()
    для инд в 0..парамы.длина:
        список_добавь(арги, 0)
    для инд в 0..арги_исх.длина:
        ар *Узел = список_получи(арги_исх, инд) как *Узел
        если ар.текст == пусто или стр_равны(ар.текст, ""):
            инд_арг смещение = 0 - 1
            для инд2 в 0..арги.длина:
                если список_получи(арги, инд2) == 0:
                    инд_арг = инд2 как смещение
                    хватит
            если инд_арг < 0:
                ген_ош("слишком много аргументов", строка)
            арги.данные[инд_арг как размер] = ар.а как размер
        иначе:
            найден смещение = 0 - 1
            для инд2 в 0..парамы.длина:
                прм *Узел = список_получи(парамы, инд2) как *Узел
                если стр_равны(прм.текст, ар.текст):
                    найден = инд2 как смещение
                    хватит
            если найден < 0:
                ген_ош(_склей2("нет параметра ", ар.текст), строка)
            если список_получи(арги, найден как размер) != 0:
                ген_ош(_склей2("аргумент задан дважды: ", ар.текст), строка)
            арги.данные[найден как размер] = ар.а как размер
    для инд в 0..арги.длина:
        если список_получи(арги, инд) == 0:
            ген_ош("вызов: не хватает аргументов", строка)
    # расклад по классам ABI: целые регистры, xmm для вещественных, стек
    цел_цель *Список = список_новый()
    плав_цель *Список = список_новый()
    стек_цель *Список = список_новый()
    плав_рег размер = ген.расклад_арг(парамы, арги.длина, цел_цель, плав_цель,
        стек_цель)
    тень размер = 32
    если ген.цель != 0:
        # домашние слоты целых рег-параметров + слоты плав-параметров в xmm;
        # без неё пролог вызываемой функции затирал бы локали вызывающего
        тень = (48 + 8 * плав_рег) как размер
    стековых размер = 0
    для инд в 0..арги.длина:
        если (список_получи(стек_цель, инд) как смещение) >= 0:
            стековых += 1
    глуб0 размер = ген.глуб
    арг_байтов размер = арги.длина * 8
    для инд в 0..парамы.длина:
        прм_в *Узел = список_получи(парамы, инд) как *Узел
        если _это_век(ген.реш_тип(прм_в.а)):
            арг_байтов += 8
    всего_байт размер = (8 * ген.глуб + арг_байтов + тень + 8 * стековых) как размер
    пад размер = ((16 - ((всего_байт % 16) как цел.верх)) % 16) как размер
    если пад != 0:
        ген.пиши(_склей2("ВЫЧ УКС, ", _цел_стр(пад как цел.верх)))
        ген.глуб += пад / 8
    # аргументы слева направо складываются на стек: смещение i-го слота
    # от вершины — в арг_байт (вектор занимает 16 байт); вещественный и
    # векторный результаты ПЛАВ0 кладутся побитно
    арг_байт *Список = список_новый()
    набег размер = 0
    для инд в 0..арги.длина:
        прм0 *Узел = список_получи(парамы, инд) как *Узел
        прм_т *Узел = ген.реш_тип(прм0.а)
        арг_у *Узел = список_получи(арги, инд) как *Узел
        если _это_вещ(прм_т):
            # литерал принимает уровень параметра; чужой уровень — только «как»
            ат *Узел = ген.реш_тип(ген.тип_выр(арг_у))
            если не _это_вещ(ат):
                ген_ош(_склей2("вещественному параметру нужен вещественный аргумент, получено ",
                    ген.имя_типа(ат)), строка)
            если _пометь_лит(арг_у, прм_т.знач2):
                ат = прм_т
            если ат.знач2 != прм_т.знач2:
                ген_ош(_склей3("несовместимые вещественные уровни: требуется ",
                    ген.имя_типа(прм_т),
                    _склей2(", получено ", ген.имя_типа(ат))), строка)
        а если _это_век(прм_т):
            ат = ген.реш_тип(ген.тип_выр(арг_у))
            если не т_равны(прм_т, ат):
                ген_ош(_склей3("векторному параметру нужен ",
                    ген.имя_типа(прм_т),
                    _склей2(", получено ", ген.имя_типа(ат))), строка)
        ген.выр(арг_у)
        если _это_вещ(прм_т):
            ген.пиши("ВЫЧ УКС, 8")
            ген.пиши(_склей4("ПЕРВ", _вещ_суф(прм_т), " ",
                _склей3(_вещ_раз(прм_т), "[УКС]", ", ПЛАВ0")))
            набег += 8
            ген.глуб += 1
        а если _это_век(прм_т):
            ген.пиши("ВЫЧ УКС, 16")
            ген.пиши(_склей2(_век_под(ген.век_эл(прм_т)),
                " ОКВАД[УКС], ПЛАВ0"))
            набег += 16
            ген.глуб += 2
        иначе:
            ген.пиши("ВСТЕК АКК")
            набег += 8
            ген.глуб += 1
        список_добавь(арг_байт, набег)
    если косв != пусто:
        ген.выр(косв)
        ген.пиши("ПЕР Р11, АКК")
    # резерв под тень и стековые аргументы; сложенные значения лежат выше
    резерв размер = тень + 8 * стековых
    если резерв != 0:
        ген.пиши(_склей2("ВЫЧ УКС, ", _цел_стр(резерв как цел.верх)))
        ген.глуб += резерв / 8
    для инд в 0..арги.длина:
        сз смещение = список_получи(стек_цель, инд) как смещение
        если сз >= 0:
            # i-й лежит на [резерв + набег - арг_байт[i]]; вектор — 16 байт
            ист0 размер = (резерв + набег -
                (список_получи(арг_байт, инд) как размер)) как размер
            прм_с *Узел = список_получи(парамы, инд) как *Узел
            прм_с = ген.реш_тип(прм_с.а)
            если _это_век(прм_с):
                под0 стр = _век_под(ген.век_эл(прм_с))
                ген.пиши(_склей3(под0, " ПЛАВ0, ОКВАД", _слот_укс(ист0)))
                ген.пиши(_склей3(под0, " ОКВАД",
                    _склей2(_слот_укс(тень + 8 * (сз как размер)), ", ПЛАВ0")))
            иначе:
                ген.пиши(_склей2("ПЕР АКК, ", _слот_укс(ист0)))
                ген.пиши(_склей3("ПЕР ", _слот_укс(тень + 8 * (сз как размер)),
                    ", АКК"))
    для инд в 0..арги.длина:
        ист размер = (резерв + набег -
            (список_получи(арг_байт, инд) как размер)) как размер
        пз смещение = список_получи(плав_цель, инд) как смещение
        если пз >= 0:
            прм_п *Узел = список_получи(парамы, инд) как *Узел
            прм_п = ген.реш_тип(прм_п.а)
            если _это_век(прм_п):
                ген.пиши(_склей3(_век_под(ген.век_эл(прм_п)), " ",
                    _склей3(_арг_плав(пз как размер), ", ОКВАД",
                    _слот_укс(ист))))
            иначе:
                ген.пиши(_склей4("ПЕРВ", _вещ_суф(прм_п), " ",
                    _склей4(_арг_плав(пз как размер), ", ", _вещ_раз(прм_п),
                    _слот_укс(ист))))
            следующий
        цз смещение = список_получи(цел_цель, инд) как смещение
        если цз < 0:
            следующий
        рег стр = _арг_рег(ген.цель, цз как размер)
        прм = список_получи(парамы, инд) как *Узел
        разм размер = ген.размер(прм.а)
        если разм == 8 или разм == 0:
            ген.пиши(_склей2(_склей3("ПЕР ", рег, ", "), _слот_укс(ист)))
        иначе:
            ген.пиши(_склей2("ПЕР АКК, ", _слот_укс(ист)))
            знак лог = т_знаковый(ген.реш_тип(прм.а))
            если разм == 4:
                если знак:
                    ген.пиши(_склей3("ЗНАКРАСШД ", рег, ", АККМ"))
                иначе:
                    ген.пиши(_склей3("ПЕР ", рег, "М, АККМ"))
            а если разм == 2:
                если знак:
                    ген.пиши(_склей3("ЗНАКРАСШ ", рег, ", АККП"))
                иначе:
                    ген.пиши(_склей3("БЕЗРАСШ ", рег, ", АККП"))
            иначе:
                если знак:
                    ген.пиши(_склей3("ЗНАКРАСШ ", рег, ", АККБ"))
                иначе:
                    ген.пиши(_склей3("БЕЗРАСШ ", рег, ", АККБ"))
    если косв != пусто:
        ген.пиши("ВЫЗОВ Р11")
    иначе:
        ген.пиши(_склей2("ВЫЗОВ ", асм_имя))
    назад размер = резерв + набег + пад
    если назад != 0:
        ген.пиши(_склей2("ДОБ УКС, ", _цел_стр(назад как цел.верх)))
    ген.глуб = глуб0
    верни возвр

открыто функ _арг_рег(цель нат.верх, инд размер) стр:
    если цель == 0:
        если инд == 0:
            верни "СЧТ"
        если инд == 1:
            верни "ДАН"
        если инд == 2:
            верни "Р8"
        верни "Р9"
    если инд == 0:
        верни "ПРМ"
    если инд == 1:
        верни "ИСТ"
    если инд == 2:
        верни "ДАН"
    если инд == 3:
        верни "СЧТ"
    если инд == 4:
        верни "Р8"
    верни "Р9"

открыто функ _арг_плав(инд размер) стр:
    # xmm-регистр вещественного аргумента (xmm0..xmm7)
    верни _склей2("ПЛАВ", _цел_стр(инд как цел.верх))

открыто функ _слот_укс(смещ размер) стр:
    верни _склей3("[УКС+", _цел_стр(смещ как цел.верх), "]")

открыто функ (ген *Ген) расклад_арг(парамы *Список, колво размер,
             цел_цель *Список, плав_цель *Список, стек_цель *Список) размер:
    # Расклад аргументов по классам ABI. Для каждого: индекс целого регистра
    # (_арг_рег), индекс xmm (_арг_плав) или номер стекового слота; -1 — «не туда».
    #   Windows: позиция i < 4 → цел_i или ПЛАВi, дальше стек.
    #   SysV: целые — ПРМ/ИСТ/ДАН/СЧТ/Р8/Р9, вещественные — ПЛАВ0..7, дальше стек.
    # Возвращает число вещественных аргументов в xmm — размер добавочной тени SysV.
    регистров размер = 4
    если ген.цель != 0:
        регистров = 6
    ци размер = 0
    пи размер = 0
    си размер = 0
    для инд в 0..колво:
        прм *Узел = список_получи(парамы, инд) как *Узел
        прм_т *Узел = ген.реш_тип(прм.а)
        плав лог = _это_вещ(прм_т) или _это_век(прм_т)
        вектор лог = _это_век(прм_т)
        цз смещение = 0 - 1
        пз смещение = 0 - 1
        сз смещение = 0 - 1
        если ген.цель == 0:
            если (инд как цел.верх) < (регистров как цел.верх):
                если плав:
                    пз = инд как смещение
                иначе:
                    цз = инд как смещение
            иначе:
                сз = си как смещение
                си += 1
                если вектор:
                    си += 1
        а если плав:
            если пи < 8:
                пз = пи как смещение
                пи += 1
            иначе:
                сз = си как смещение
                си += 1
                если вектор:
                    си += 1
        иначе:
            если ци < регистров:
                цз = ци как смещение
                ци += 1
            иначе:
                сз = си как смещение
                си += 1
        список_добавь(цел_цель, цз как размер)
        список_добавь(плав_цель, пз как размер)
        список_добавь(стек_цель, сз как размер)
    верни пи

