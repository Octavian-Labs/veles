            сим.смещ = (16 + 8 * (регистров + (пз как размер))) как смещение
        иначе:
            сим.смещ = (16 + 8 * инд) как смещение
        список_добавь(ген.парамы, сим как размер)
    # скан тела: локали, скрытые слоты, веса имён и запреты на регистры
    порядок *Список = список_новый()
    имена *Список = список_новый()
    ген.скан_тело(функ.дети2, порядок, имена, 0)
    смещ смещение = 8
    для инд в 0..порядок.длина:
        ло *ГЛок = список_получи(порядок, инд) как *ГЛок
        тип_уз *Узел = ло.тип
        если тип_уз == пусто:
            если ло.выр != пусто:
                тип_уз = ген.тип_выр(ло.выр)
            иначе:
                тип_уз = т_цел64()
        тип_уз = ген.реш_тип(тип_уз)
        разм размер = (ген.размер(тип_уз) + 7) / 8 * 8
        если разм < 8:
            разм = 8
        сим = новый(ГСим)
        сим.имя = ло.имя
        сим.тип = тип_уз
        сим.смещ = смещ + разм - 8
        список_добавь(ген.локалы, сим как размер)
        смещ += разм как смещение
    # домашние 16-байтные слоты век-параметров — после обычных локалей
    для инд в 0..параметров:
        пар2 *Узел = список_получи(парамы, инд) как *Узел
        если не _это_век(ген.реш_тип(пар2.а)):
            следующий
        сим2 *ГСим = ген.парам_ищи(пар2.текст)
        сим2.смещ = смещ + 16 - 8
        смещ += 16
    локалов размер = (смещ - 8) как размер
    ген.фрейм = (локалов + 15) / 16 * 16
    ген.выход_м = _склей3("м_", ген.фимя, "_выход")
    # регистровые переменные: самые горячие скаляры по 8 байт без взятия
    # адреса и без упоминания в искра-блоках — в сохраняемых регистрах
    канд *Список = список_новый()
    для инд в 0..ген.парамы.длина:
        сим = список_получи(ген.парамы, инд) как *ГСим
        если ген.годен_рег(сим):
            список_добавь(канд, сим как размер)
    для инд в 0..ген.локалы.длина:
        сим = список_получи(ген.локалы, инд) как *ГСим
        если ген.годен_рег(сим):
            список_добавь(канд, сим как размер)
    для инд в 0..5:
        лучший *ГСим = пусто как *ГСим
        лс размер = 0
        для инд2 в 0..канд.длина:
            сим = список_получи(канд, инд2) как *ГСим
            вес размер = ген.счёт_найди(сим.имя)
            если сим.рег == 0 и вес > лс:
                лучший = сим
                лс = вес
        если лучший == пусто:
            хватит
        лучший.рег = (инд + 1) как размер
        ген.рег_локов += 1
    # пролог
    ген.метка(имя_асм)
    ген.пиши("ВСТЕК УКК")
    ген.пиши("ПЕР УКК, УКС")
    если ген.фрейм != 0:
        ген.пиши(_склей2("ВЫЧ УКС, ", _цел_стр(ген.фрейм как цел.верх)))
        если ген.цель == 0 и ген.фрейм > 4096:
            # зонд стека Windows: сторожевая страница растёт только при
            # касании каждой страницы по порядку сверху вниз
            зонд размер = 4096
            пока зонд < ген.фрейм:
                ген.пиши(_склей3("ПРОВ БАЙТ[УКК-", _цел_стр(зонд как цел.верх), "], 0"))
                зонд += 4096
    для инд в 0..ген.рег_локов:
        ген.пиши(_склей2("ВСТЕК ", _рег_лок(инд)))
    ген.глуб += ген.рег_локов
    # домашнее сохранение регистровых параметров (целые и xmm)
    для инд в 0..параметров:
        пар = список_получи(парамы, инд) как *Узел
        сим = ген.парам_ищи(пар.текст)
        пз2 смещение = список_получи(плав_цель, инд) как смещение
        если _это_век(ген.реш_тип(пар.а)):
            # вектор: дом — локальный слот; из xmm или копия со стека
            под стр = _век_под(ген.век_эл(ген.реш_тип(пар.а)))
            если пз2 >= 0:
                ген.пиши(_склей4(под, " ОКВАД", _адр_лок(сим.смещ),
                    _склей2(", ", _арг_плав(пз2 как размер))))
            иначе:
                сз0 смещение = список_получи(стек_цель, инд) как смещение
                ист0 смещение = (16 + 8 * (регистров + плав_дома +
                    (сз0 как размер))) как смещение
                ген.пиши(_склей3("ПЕРЦВ ПЛАВ0, ОКВАД", _адр_пар(ист0), ""))
                ген.пиши(_склей3(под, " ОКВАД",
                    _склей2(_адр_лок(сим.смещ), ", ПЛАВ0")))
            следующий
        если пз2 >= 0:
            пар_т *Узел = ген.реш_тип(пар.а)
            ген.пиши(_склей4("ПЕРВ", _вещ_суф(пар_т), " ",
                _склей4(_вещ_раз(пар_т), _адр_пар(сим.смещ), ", ",
                _арг_плав(пз2 как размер))))
            следующий
        цз2 смещение = список_получи(цел_цель, инд) как смещение
        если цз2 < 0:
            следующий
        рег стр = _арг_рег(ген.цель, цз2 как размер)
        разм = ген.размер(пар.а)
        если разм > 8:
            разм = 8
        если разм == 0:
            разм = 8
        регимя стр = рег
        если разм == 4:
            регимя = _склей2(рег, "М")
        а если разм == 2:
            регимя = _склей2(рег, "П")
        а если разм == 1:
            регимя = _склей2(рег, "Б")
        если сим.рег > 0:
            ген.пиши(_склей4("ПЕР ", _рег_лок(сим.рег - 1), ", ", регимя))
        иначе:
            ген.пиши(_склей3(_склей2("ПЕР ", _адр_пар(сим.смещ)), ", ", регимя))
    # стековые параметры, попавшие в регистры — снимаем сразу
    для инд_п в 0..параметров:
        если (список_получи(стек_цель, инд_п) как смещение) < 0:
            следующий
        п2 *Узел = список_получи(парамы, инд_п) как *Узел
        с2 *ГСим = ген.парам_ищи(п2.текст)
        если с2.рег > 0:
            ген.пиши(_склей4("ПЕР ", _рег_лок(с2.рег - 1), ", ", _адр_пар(с2.смещ)))
    # тело
    если функ.дети2 != пусто:
        для инд в 0..функ.дети2.длина:
            ген.оп(список_получи(функ.дети2, инд) как *Узел)
    # эпилог
    ген.метка(ген.выход_м)
    # отложи исполняется после «верни» — спасаем результат из АКК/ПЛАВ0,
    # иначе отложенные вызовы затрут возвращаемое значение
    возвр_т *Узел = ген.реш_тип(ген.возвр)
    вещ_возвр лог = _это_вещ(возвр_т)
    век_возвр лог = _это_век(возвр_т)
    если ген.отложи.длина > 0:
        если вещ_возвр:
            ген.пиши("ВЫЧ УКС, 8")
            ген.пиши(_склей4("ПЕРВ", _вещ_суф(возвр_т), " ",
                _склей3(_вещ_раз(возвр_т), "[УКС]", ", ПЛАВ0")))
            ген.глуб += 1
        а если век_возвр:
            ген.пиши("ВЫЧ УКС, 16")
            ген.пиши(_склей2(_век_под(ген.век_эл(возвр_т)),
                " ОКВАД[УКС], ПЛАВ0"))
            ген.глуб += 2
        иначе:
            ген.пиши("ВСТЕК АКК")
            ген.глуб += 1
    инд_о цел.верх = (ген.отложи.длина как цел.верх) - 1
    пока инд_о >= 0:
        ген.выр(список_получи(ген.отложи, инд_о как размер) как *Узел)
        инд_о -= 1
    если ген.отложи.длина > 0:
        если вещ_возвр:
            ген.пиши(_склей4("ПЕРВ", _вещ_суф(возвр_т), " ПЛАВ0, ",
                _склей2(_вещ_раз(возвр_т), "[УКС]")))
            ген.пиши("ДОБ УКС, 8")
        а если век_возвр:
            ген.пиши(_склей2(_век_под(ген.век_эл(возвр_т)),
                " ПЛАВ0, ОКВАД[УКС]"))
            ген.пиши("ДОБ УКС, 16")
        иначе:
            ген.пиши("ИЗСТЕКА АКК")
        ген.глуб -= 1
    инд_р смещение = ген.рег_локов как смещение
    пока инд_р > 0:
        инд_р -= 1
        ген.пиши(_склей2("ИЗСТЕКА ", _рег_лок(инд_р как размер)))
    ген.глуб -= ген.рег_локов
    ген.пиши("ПОКИНЬ")
    ген.пиши("ВОЗВРАТ")

