открыто функ (ген *Ген) литерал(выр *Узел) *Узел:
    тип_уз *Узел = ген.реш_тип(выр.а)
    смещ смещение = ген.слот_узла(выр)
    разм размер = ген.размер(тип_уз)
    цикл стр = ген.новая("лит_ноль")
    ген.пиши(_склей2("ПЕР СЧТ, ", _цел_стр(разм как цел.верх)))
    ген.пиши(_склей2("АДР ПРМ, ", _адр_лок(смещ)))
    ген.метка(цикл)
    ген.пиши("ПЕР БАЙТ[ПРМ], 0")
    ген.пиши("УВЕЛ ПРМ")
    ген.пиши("УМЕН СЧТ")
    ген.пиши(_склей2("НЕНОЛЬ ", цикл))
    если тип_уз.знач == ТВ_ИМЯ:
        зап *ГЗапись = ген.запись_ищи(тип_уз.текст)
        именован лог = нет
        для инд в 0..выр.дети.длина:
            эл *Узел = список_получи(выр.дети, инд) как *Узел
            если эл.текст != пусто и не стр_равны(эл.текст, ""):
                именован = да
        если именован:
            поз размер = 0
            для инд в 0..выр.дети.длина:
                эл = список_получи(выр.дети, инд) как *Узел
                имя_п стр = эл.текст
                если имя_п == пусто или стр_равны(имя_п, ""):
                    пл0 *ГПоле = список_получи(зап.поля, поз) как *ГПоле
                    имя_п = пл0.имя
                пл *ГПоле = поле_ищи(зап, имя_п)
                если пл == пусто:
                    ген_ош(_склей3("у записи ", тип_уз.текст,
                               _склей2(" нет поля ", имя_п)), выр.строка)
                ген.совместим(пл.тип, эл.а, выр.строка)
                ген.выр(эл.а)
                ген.сохранить(_адр_лок(смещ - пл.смещ), пл.тип)
                поз += 1
        иначе:
            для инд в 0..выр.дети.длина:
                если инд >= зап.поля.длина:
                    ген_ош("слишком много полей в литерале", выр.строка)
                пл = список_получи(зап.поля, инд) как *ГПоле
                эл = список_получи(выр.дети, инд) как *Узел
                ген.совместим(пл.тип, эл.а, выр.строка)
                ген.выр(эл.а)
                ген.сохранить(_адр_лок(смещ - пл.смещ), пл.тип)
    а если тип_уз.знач == ТВ_МАСС:
        элем *Узел = ген.реш_тип(тип_уз.а)
        разм_эл размер = ген.размер(элем)
        если выр.дети.длина > тип_уз.знач2:
            ген_ош("слишком много элементов в литерале", выр.строка)
        для инд в 0..выр.дети.длина:
            эл = список_получи(выр.дети, инд) как *Узел
            ген.совместим(элем, эл.а, выр.строка)
            ген.выр(эл.а)
            ген.сохранить(_адр_лок(смещ - инд * разм_эл), элем)
    а если тип_уз.знач == ТВ_ВЕК:
        элем = ген.реш_тип(тип_уз.а)
        разм_эл = ген.размер(элем)
        если выр.дети.длина != тип_уз.знач2:
            ген_ош(_склей3("векторному литералу нужно ровно ",
                _цел_стр(тип_уз.знач2 как цел.верх), " лейнов"), выр.строка)
        для инд в 0..выр.дети.длина:
            эл = список_получи(выр.дети, инд) как *Узел
            ген.совместим(элем, эл.а, выр.строка)
            ген.выр(эл.а)
            ген.сохранить(_адр_лок(смещ - инд * разм_эл), элем)
        ген.загрузить(_адр_лок(смещ), тип_уз)
        верни тип_уз
    иначе:
        ген_ош("литерал {..} — только записи, массивы и векторы", выр.строка)
    ген.пиши(_склей2("АДР АКК, ", _адр_лок(смещ)))
    верни тип_уз

