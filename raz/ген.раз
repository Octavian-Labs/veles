# ген — генератор текста ИСКРЫ (.иск) из AST РАЗУМА.
# Выражение оставляет результат в АКК; локали/парамы адресуются через УКК. Windows: СЧТ/ДАН/Р8/Р9 + тень 32Б; Linux SysV:
# ПРМ/ИСТ/ДАН/СЧТ/Р8/Р9.

взять основа
взять узлы
взять опт

конст ТВ_ЛЮБОЙ = 12   # внутренний тип «вывести самому»

# --- записи таблиц символов -----------------------------------------------------

запись ГСим:            # локал/параметр: имя -> (смещение, тип)
    имя стр
    смещ нат.верх
    тип *Узел
    рег нат.верх           # 0 — в кадре; 1..5 — индекс сохраняемого регистра
    парам лог           # это параметр (слот [УКК+..]), иначе локал [УКК-..]

запись ГСчёт:           # вес обращений к имени внутри текущей функции
    имя стр
    колво нат.верх

запись ГПоле:           # поле записи / элемент перечисления
    имя стр
    смещ нат.верх          # смещение поля или значение элемента переча
    тип *Узел

запись ГЗапись:
    имя стр
    разм нат.верх
    поля *Список        # ГПоле

запись ГКонст:
    имя стр
    знач цел.верх
    большое лог     # значение >= 2^63 из литерала — печатаем беззнаково

запись ГСин:
    имя стр
    тип *Узел

запись ГПереч:
    имя стр
    элементы *Список    # ГПоле (смещ = значение)

запись ГФунк:
    имя стр             # исходное имя
    асм стр             # имя метки в ИСКРЕ
    парамы *Список      # У_ПАРАМ
    возвр *Узел
    внеш нат.верх

запись ГМетод:
    запись стр          # имя записи-приёмника
    имя стр
    асм стр
    парамы *Список
    возвр *Узел

запись ГИмп:
    длл стр
    имена *Список       # стр

запись ГЦикл:
    шаг стр
    кон стр

запись ГМод:            # модульный префикс из «взять»: ключ -> префикс имён
    ключ стр            # «сист.файл» (полный путь) или «файл» (открытое имя)
    преф стр            # лист пути — префикс манглированных имён («файл»)

запись ГЛок:            # элемент «порядок» при скане тела
    имя стр
    тип *Узел           # может быть пусто — выводится из выр
    выр *Узел           # может быть пусто

запись Ген:
    код *Буфер
    данные *Буфер
    записи *Список
    синонимы *Список
    консты *Список
    перечи *Список
    функции *Список
    методы *Список
    импорты *Список
    модули *Список      # ГМод — зарегистрированные пути «взять»
    нужны_стд нат.верх     # биты: 1=выдели 2=освободи 4=сбой_границы
    стр_сч нат.верх
    мет_сч нат.верх
    конст_большое лог   # последняя конст >= 2^63 из литерала
    глуб цел.верх          # выданные ВСТЕК (в восьмибайтовках)
    цель нат.верх          # 0=windows 1=linux 2=macos
    опт нат.верх           # уровень оптимизации: 0=нет, 1=пипхол
    режим нат.верх         # ось безопасности: 1=надёжно (умолчание), 0=быстро
    есть_главная нат.верх
    # контекст текущей функции
    локалы *Список      # ГСим
    парамы *Список      # ГСим
    циклы *Список       # ГЦикл
    отложи *Список      # *Узел
    счёты *Список       # ГСчёт — веса обращений к именам
    запреты *Список     # стр — имена, которым нельзя в регистр (адрес/искра)
    рег_локов нат.верх     # сколько регистров занято локалями (префикс _рег_лок)
    фрейм нат.верх
    выход_м стр
    возвр *Узел
    фимя стр            # имя текущей функции — контекст меток м_<фимя>_*_N
    пред_сказано лог    # предупреждение про «:=» уже выдано

функ ген_новый(цель нат.верх, опт нат.верх, режим нат.верх) *Ген:
    ген *Ген = новый(Ген)
    ген.код = буф_новый()
    ген.данные = буф_новый()
    ген.записи = список_новый()
    ген.синонимы = список_новый()
    ген.консты = список_новый()
    ген.перечи = список_новый()
    ген.функции = список_новый()
    ген.методы = список_новый()
    ген.импорты = список_новый()
    ген.модули = список_новый()
    ген.нужны_стд = 0
    ген.стр_сч = 0
    ген.мет_сч = 0
    ген.глуб = 0
    ген.цель = цель
    ген.опт = опт
    ген.режим = режим
    ген.есть_главная = 0
    ген.локалы = список_новый()
    ген.парамы = список_новый()
    ген.циклы = список_новый()
    ген.отложи = список_новый()
    ген.счёты = список_новый()
    ген.запреты = список_новый()
    ген.рег_локов = 0
    ген.фрейм = 0
    ген.выход_м = ""
    ген.возвр = пусто как *Узел
    ген.фимя = ""
    ген.пред_сказано = нет
    верни ген

функ ген_ош(текст стр, строка нат.верх):
    печать("разум.ген: строка ")
    печатьцел(строка как цел.верх)
    печать(": ")
    печатьстр(текст)
    выход(1)

функ ген_пред(текст стр, строка нат.верх):
    печать_ош(_склей3(_склей2("разум.ген: строка ",
        _цел_стр(строка как цел.верх)),
        ": предупреждение: ", текст))

# --- конструкторы типов ---------------------------------------------------------

функ т_нов(вид нат.верх) *Узел:
    уз *Узел = узел(У_ТИП, 0)
    уз.знач = вид
    верни уз

функ т_пусто() *Узел:
    верни т_нов(ТВ_ПУСТО)

функ т_цел64() *Узел:
    уз *Узел = т_нов(ТВ_ЦЕЛ)
    уз.текст = "цел64"
    верни уз

функ т_без64() *Узел:
    уз *Узел = т_нов(ТВ_БЕЗ)
    уз.текст = "без64"
    верни уз

функ т_без8() *Узел:
    уз *Узел = т_нов(ТВ_БЕЗ)
    уз.текст = "без8"
    верни уз

функ т_бул() *Узел:
    верни т_нов(ТВ_БУЛ)

функ т_сим() *Узел:
    верни т_нов(ТВ_СИМ)

функ т_стр() *Узел:
    верни т_нов(ТВ_СТР)

функ т_любой() *Узел:
    верни т_нов(ТВ_ЛЮБОЙ)

функ т_указ(база *Узел) *Узел:
    уз *Узел = т_нов(ТВ_УКАЗ)
    уз.а = база
    верни уз

функ т_срез(база *Узел) *Узел:
    уз *Узел = т_нов(ТВ_СРЕЗ)
    уз.а = база
    верни уз

функ т_масс(база *Узел, дл нат.верх) *Узел:
    уз *Узел = т_нов(ТВ_МАСС)
    уз.а = база
    уз.знач2 = дл
    верни уз

функ т_запись(имя стр) *Узел:
    уз *Узел = т_нов(ТВ_ИМЯ)
    уз.текст = имя
    верни уз

функ т_функ(парамы *Список, возвр *Узел) *Узел:
    уз *Узел = т_нов(ТВ_ФУНК)
    уз.дети = парамы
    уз.б = возвр
    верни уз

функ т_знаковый(тип_уз *Узел) лог:
    верни тип_уз.знач == ТВ_ЦЕЛ

функ т_равны(лев *Узел, прав *Узел) лог:
    если лев == пусто или прав == пусто:
        верни лев == прав
    если лев.знач != прав.знач:
        верни нет
    если лев.знач == ТВ_ИМЯ:
        верни стр_равны(лев.текст, прав.текст)
    если лев.знач == ТВ_УКАЗ или лев.знач == ТВ_СРЕЗ:
        верни т_равны(лев.а, прав.а)
    если лев.знач == ТВ_МАСС:
        верни лев.знач2 == прав.знач2 и т_равны(лев.а, прав.а)
    верни да

функ _имя_целого(текст стр, знаковый лог) стр:
    уровень стр = ""
    если стр_равны(текст, "цел8") или стр_равны(текст, "без8"):
        уровень = "старт"
    а если стр_равны(текст, "цел16") или стр_равны(текст, "без16"):
        уровень = "шаг"
    а если стр_равны(текст, "цел32") или стр_равны(текст, "без32"):
        уровень = "рост"
    а если стр_равны(текст, "цел64") или стр_равны(текст, "без64"):
        уровень = "верх"
    а если стр_равны(текст, "цел128") или стр_равны(текст, "без128"):
        уровень = "пик"
    если знаковый:
        верни _склей2("цел.", уровень)
    верни _склей2("нат.", уровень)

функ (ген *Ген) имя_типа(тип_уз *Узел) стр:
    тип_уз = ген.реш_тип(тип_уз)
    если тип_уз == пусто:
        верни "пусто"
    вид нат.верх = тип_уз.знач
    если вид == ТВ_ЦЕЛ:
        верни _имя_целого(тип_уз.текст, да)
    если вид == ТВ_БЕЗ:
        верни _имя_целого(тип_уз.текст, нет)
    если вид == ТВ_БУЛ:
        верни "лог"
    если вид == ТВ_СИМ:
        верни "сим"
    если вид == ТВ_СТР:
        верни "стр"
    если вид == ТВ_ПУСТО:
        верни "пусто"
    если вид == ТВ_УКАЗ:
        верни _склей2("*", ген.имя_типа(тип_уз.а))
    если вид == ТВ_СРЕЗ:
        верни _склей2("[]", ген.имя_типа(тип_уз.а))
    если вид == ТВ_МАСС:
        верни _склей3(ген.имя_типа(тип_уз.а), "[",
            _склей2(_цел_стр(тип_уз.знач2 как цел.верх), "]"))
    если вид == ТВ_ИМЯ:
        верни тип_уз.текст
    если вид == ТВ_ФУНК:
        верни "функ"
    верни "неизвестный тип"

# --- строки-помощники -----------------------------------------------------------

функ _цел_стр(число цел.верх) стр:
    верни цел_в_стр(число)

функ _адр_лок(смещ нат.верх) стр:
    верни стр_склей(стр_склей("[УКК-", _цел_стр(смещ как цел.верх)), "]")

функ _адр_пар(смещ нат.верх) стр:
    верни стр_склей(стр_склей("[УКК+", _цел_стр(смещ как цел.верх)), "]")

# сохраняемые регистры для горячих локалей и параметров (обе ABI)
функ _рег_лок(инд нат.верх) стр:
    если инд == 0:
        верни "БАЗ"
    если инд == 1:
        верни "Р12"
    если инд == 2:
        верни "Р13"
    если инд == 3:
        верни "Р14"
    верни "Р15"

функ _слот(сим *ГСим) стр:
    # операнд переменной: регистр, если размещена, иначе [УКК±смещ]
    если сим.рег > 0:
        верни _рег_лок(сим.рег - 1)
    если сим.парам:
        верни _адр_пар(сим.смещ)
    верни _адр_лок(сим.смещ)

функ _слот_кв(сим *ГСим) стр:
    # то же с префиксом КВАД для памяти (УВЕЛ/УМЕН/ПЕР КВАД[...])
    если сим.рег > 0:
        верни _рег_лок(сим.рег - 1)
    если сим.парам:
        верни _склей2("КВАД", _адр_пар(сим.смещ))
    верни _склей2("КВАД", _адр_лок(сим.смещ))

функ _склей2(ч1 стр, ч2 стр) стр:
    верни стр_склей(ч1, ч2)

функ _склей3(ч1 стр, ч2 стр, ч3 стр) стр:
    верни стр_склей(стр_склей(ч1, ч2), ч3)

функ _склей4(ч1 стр, ч2 стр, ч3 стр, ч4 стр) стр:
    верни стр_склей(стр_склей(ч1, ч2), стр_склей(ч3, ч4))

