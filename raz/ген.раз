функ (г *Ген) пад_и_вызов(цель стр):
    лишние := (г.глуб * 8) % 16
    пад := (16 - лишние) % 16
    если пад != 0:
        г.е(_к2("ВЫЧ УКС, ", _н(пад)))
    г.е(_к2("ВЫЗОВ ", цель))
    если пад != 0:
        г.е(_к2("ДОБ УКС, ", _н(пад)))

функ (г *Ген) метод_ищи(e *Узел) *ГМетод:
    если e.а.вид != У_ПОЛЕ:
        верни пусто как *ГМетод
    т_об := г.реш_тип(г.тип_выр(e.а.а))
    зап := ""
    если т_об.знач == ТВ_ИМЯ:
        зап = т_об.текст
    а если т_об.знач == ТВ_УКАЗ:
        б := г.реш_тип(т_об.а)
        если б.знач == ТВ_ИМЯ:
            зап = б.текст
    если стр_равны(зап, ""):
        верни пусто как *ГМетод
    верни г.метод_ищи2(зап, e.а.текст)

функ (г *Ген) вызов(e *Узел) *Узел:
    цель := e.а
    если цель.вид == У_ПОЛЕ:
        м := г.метод_ищи(e)
        если м == пусто:
            ген_ош("поле не является методом", e.строка)
        т_об := г.реш_тип(г.тип_выр(цель.а))
        приёмник := цель.а
        если т_об.знач == ТВ_ИМЯ:
            ад := узел(У_АДРЕС, цель.а.строка)
            ад.а = цель.а
            приёмник = ад
        # аргументы: приёмник + исходные
        арги := список_новый()
        а0 := узел(У_АРГ, e.строка)
        а0.а = приёмник
        список_добавь(арги, а0 как без64)
        для i в 0..e.дети.длина:
            список_добавь(арги, список_получи(e.дети, i))
        верни г.вызов_ядро(м.асм, м.парамы, м.возвр, арги, e.строка,
                          пусто как *Узел)
    если цель.вид != У_ИМЯ:
        # косвенный вызов через произвольное выражение
        ft := г.реш_тип(г.тип_выр(цель))
        если ft.знач != ТВ_ФУНК:
            ген_ош("вызов не-функции", e.строка)
        парамы := список_новый()
        для i в 0..ft.дети.длина:
            прм := узел(У_ПАРАМ, e.строка)
            прм.текст = _к2("а", _н(i как цел64))
            прм.а = список_получи(ft.дети, i) как *Узел
            список_добавь(парамы, прм как без64)
        вз := ft.б
        если вз == пусто:
            вз = т_пусто()
        верни г.вызов_ядро("", парамы, вз, e.дети, e.строка, цель)
    имя := цель.текст
    если стр_равны(имя, "освободи"):
        если e.дети.длина != 1:
            ген_ош("освободи(указ) — один аргумент", e.строка)
        г.нужны_стд = г.нужны_стд | 2
        арг := список_получи(e.дети, 0) как *Узел
        г.выр(арг.а)
        г.е("ПЕР СЧТ, АКК")
        г.пад_и_вызов("стд_освободи")
        верни т_пусто()
    если стр_равны(имя, "выдели"):
        если e.дети.длина != 1:
            ген_ош("выдели(размер) — один аргумент", e.строка)
        г.нужны_стд = г.нужны_стд | 1
        арг := список_получи(e.дети, 0) как *Узел
        г.выр(арг.а)
        г.е("ПЕР СЧТ, АКК")
        г.пад_и_вызов("стд_выдели")
        верни т_указ(т_без8())
    если стр_равны(имя, "новый"):
        ген_ош("новый(Тип) — без аргументов-выражений", e.строка)
    ф := г.функ_ищи(имя)
    если ф == пусто:
        слот := г.локал_ищи(имя)
        если слот == пусто:
            слот = г.парам_ищи(имя)
        если слот != пусто:
            ст := г.реш_тип(слот.тип)
            если ст.знач != ТВ_ФУНК:
                ген_ош(_к2("не функция: ", имя), e.строка)
            парамы := список_новый()
            для i в 0..ст.дети.длина:
                прм := узел(У_ПАРАМ, e.строка)
                прм.текст = _к2("а", _н(i как цел64))
                прм.а = список_получи(ст.дети, i) как *Узел
                список_добавь(парамы, прм как без64)
            вз := ст.б
            если вз == пусто:
                вз = т_пусто()
            верни г.вызов_ядро("", парамы, вз, e.дети, e.строка, цель)
        ген_ош(_к2("неизвестная функция ", имя), e.строка)
    верни г.вызов_ядро(ф.асм, ф.парамы, ф.возвр, e.дети, e.строка,
                      пусто как *Узел)

функ (г *Ген) вызов_ядро(асм_имя стр, парамы *Список, возвр *Узел,
                        арги_исх *Список, строка без64, косв *Узел) *Узел:
    # именованные аргументы -> позиционные
    арги := список_новый()
    для i в 0..парамы.длина:
        список_добавь(арги, 0)
    для i в 0..арги_исх.длина:
        ар := список_получи(арги_исх, i) как *Узел
        если ар.текст == пусто или стр_равны(ар.текст, ""):
            idx := 0 - 1
            для k в 0..арги.длина:
                если список_получи(арги, k) == 0:
                    idx = k как цел64
                    хватит
            если idx < 0:
                ген_ош("слишком много аргументов", строка)
            арги.данные[idx как без64] = ар.а как без64
        иначе:
            найден := 0 - 1
            для k в 0..парамы.длина:
                прм := список_получи(парамы, k) как *Узел
                если стр_равны(прм.текст, ар.текст):
                    найден = k как цел64
                    хватит
            если найден < 0:
                ген_ош(_к2("нет параметра ", ар.текст), строка)
            если список_получи(арги, найден как без64) != 0:
                ген_ош(_к2("аргумент задан дважды: ", ар.текст), строка)
            арги.данные[найден как без64] = ар.а как без64
    для i в 0..арги.длина:
        если список_получи(арги, i) == 0:
            ген_ош("вызов: не хватает аргументов", строка)
    nreg := 4
    тень := 32
    если г.цель == 1:
        nreg = 6
        # тень — область под домашние слоты рег-параметров [УКК+16..];
        # без неё пролог callee затирал бы локали вызывающего
        тень = 48
    nreg_исп := nreg
    если арги.длина < nreg:
        nreg_исп = арги.длина как цел64
    стековых := (арги.длина как цел64) - nreg_исп
    глуб0 := г.глуб
    сумма := 8 * г.глуб + 8 * стековых + тень
    пад := (16 - сумма % 16) % 16
    если пад != 0:
        г.е(_к2("ВЫЧ УКС, ", _н(пад)))
        г.глуб += пад / 8
    i := (арги.длина как цел64) - 1
    пока i >= 0:
        г.выр(список_получи(арги, i как без64) как *Узел)
        г.е("ВСТЕК АКК")
        г.глуб += 1
        i -= 1
    если косв != пусто:
        г.выр(косв)
        г.е("ПЕР Р11, АКК")
    для k в 0..nreg_исп:
        рег := _арг_рег(г.цель, k)
        прм := список_получи(парамы, k) как *Узел
        sz := г.размер(прм.а)
        если sz == 8 или sz == 0:
            г.е(_к2("ИЗСТЕКА ", рег))
        иначе:
            г.е("ИЗСТЕКА АКК")
            знак := т_знаковый(г.реш_тип(прм.а))
            если sz == 4:
                если знак:
                    г.е(_к3("ЗНАКРАСШД ", рег, ", АККМ"))
                иначе:
                    г.е(_к3("ПЕР ", рег, "М, АККМ"))
            а если sz == 2:
                если знак:
                    г.е(_к3("ЗНАКРАСШ ", рег, ", АККП"))
                иначе:
                    г.е(_к3("БЕЗРАСШ ", рег, ", АККП"))
            иначе:
                если знак:
                    г.е(_к3("ЗНАКРАСШ ", рег, ", АККБ"))
                иначе:
                    г.е(_к3("БЕЗРАСШ ", рег, ", АККБ"))
        г.глуб -= 1
    если тень != 0:
        г.е(_к2("ВЫЧ УКС, ", _н(тень)))
    если косв != пусто:
        г.е("ВЫЗОВ Р11")
    иначе:
        г.е(_к2("ВЫЗОВ ", асм_имя))
    назад := тень + 8 * стековых + пад
    если назад != 0:
        г.е(_к2("ДОБ УКС, ", _н(назад)))
    г.глуб = глуб0
    верни возвр

функ _арг_рег(цель без64, i без64) стр:
    если цель == 0:
        если i == 0:
            верни "СЧТ"
        если i == 1:
            верни "ДАН"
        если i == 2:
            верни "Р8"
        верни "Р9"
    если i == 0:
        верни "ПРМ"
    если i == 1:
        верни "ИСТ"
    если i == 2:
        верни "ДАН"
    если i == 3:
        верни "СЧТ"
    если i == 4:
        верни "Р8"
    верни "Р9"

