открыто функ (ген *Ген) кэш_рег(км *КэшМодуль, мод стр):
    # повторить регистрацию объявлений модуля по интерфейсным строкам .рми
    ген.нужны_стд = ген.нужны_стд | км.нужны
    для инд в 0..км.интерфейс.длина:
        строка стр = список_получи(км.интерфейс, инд) как стр
        слова *Список = _слова(строка)
        если слова.длина < 2:
            следующий
        вид стр = список_получи(слова, 0) как стр
        если стр_равны(вид, "запись"):
            зап *ГЗапись = новый(ГЗапись)
            зап.имя = список_получи(слова, 1) как стр
            зап.отк = стр_число(список_получи(слова, 2) как стр) как нат.верх
            зап.разм = стр_число(список_получи(слова, 3) как стр) как размер
            зап.поля = список_новый()
            зап.мод = мод
            для инд2 в 4..слова.длина:
                части *Список = _части(список_получи(слова, инд2) как стр, '=')
                пл *ГПоле = новый(ГПоле)
                пл.имя = список_получи(части, 0) как стр
                пл.тип = _тип_из_стр(список_получи(части, 1) как стр)
                пл.смещ = стр_число(список_получи(части, 2) как стр) как смещение
                список_добавь(зап.поля, пл как размер)
            список_добавь(ген.записи, зап как размер)
        а если стр_равны(вид, "конст"):
            конста *ГКонст = новый(ГКонст)
            конста.имя = список_получи(слова, 1) как стр
            конста.отк = стр_число(список_получи(слова, 2) как стр) как нат.верх
            конста.знач = стр_число(список_получи(слова, 3) как стр)
            конста.большое = (слова.длина > 4 и
                стр_число(список_получи(слова, 4) как стр) != 0)
            конста.мод = мод
            список_добавь(ген.консты, конста как размер)
        а если стр_равны(вид, "син"):
            син *ГСин = новый(ГСин)
            син.имя = список_получи(слова, 1) как стр
            син.отк = стр_число(список_получи(слова, 2) как стр) как нат.верх
            син.тип = _тип_из_стр(список_получи(слова, 3) как стр)
            син.мод = мод
            список_добавь(ген.синонимы, син как размер)
        а если стр_равны(вид, "переч"):
            переч *ГПереч = новый(ГПереч)
            переч.имя = список_получи(слова, 1) как стр
            переч.отк = стр_число(список_получи(слова, 2) как стр) как нат.верх
            переч.элементы = список_новый()
            переч.мод = мод
            для инд2 в 3..слова.длина:
                части = _части(список_получи(слова, инд2) как стр, '=')
                пл = новый(ГПоле)
                пл.имя = список_получи(части, 0) как стр
                пл.смещ = стр_число(список_получи(части, 1) как стр) как смещение
                список_добавь(переч.элементы, пл как размер)
            список_добавь(ген.перечи, переч как размер)
        а если стр_равны(вид, "функ"):
            # функ имя отк асм внеш длл возвр парам=тип ...
            функц *ГФунк = новый(ГФунк)
            функц.имя = список_получи(слова, 1) как стр
            функц.отк = стр_число(список_получи(слова, 2) как стр) как нат.верх
            функц.асм = список_получи(слова, 3) как стр
            функц.внеш = стр_число(список_получи(слова, 4) как стр) как нат.верх
            длл стр = список_получи(слова, 5) как стр
            функц.возвр = _тип_из_стр(список_получи(слова, 6) как стр)
            функц.мод = мод
            функц.парамы = список_новый()
            для инд2 в 7..слова.длина:
                части = _части(список_получи(слова, инд2) как стр, '=')
                прм *Узел = узел(У_ПАРАМ, 0)
                прм.текст = список_получи(части, 0) как стр
                прм.а = _тип_из_стр(список_получи(части, 1) как стр)
                список_добавь(функц.парамы, прм как размер)
            если функц.внеш != 0:
                ген.имп_добавь(длл, функц.имя)
            список_добавь(ген.функции, функц как размер)
        а если стр_равны(вид, "метод"):
            # метод запись имя отк асм возвр парам=тип ...
            мет *ГМетод = новый(ГМетод)
            мет.запись = список_получи(слова, 1) как стр
            мет.имя = список_получи(слова, 2) как стр
            мет.отк = стр_число(список_получи(слова, 3) как стр) как нат.верх
            мет.асм = список_получи(слова, 4) как стр
            мет.возвр = _тип_из_стр(список_получи(слова, 5) как стр)
            мет.мод = мод
            мет.парамы = список_новый()
            для инд2 в 6..слова.длина:
                части = _части(список_получи(слова, инд2) как стр, '=')
                прм = узел(У_ПАРАМ, 0)
                прм.текст = список_получи(части, 0) как стр
                прм.а = _тип_из_стр(список_получи(части, 1) как стр)
                список_добавь(мет.парамы, прм как размер)
            список_добавь(ген.методы, мет как размер)
            функц2 *ГФунк = новый(ГФунк)
            функц2.имя = _склей3(мет.запись, ".", мет.имя)
            функц2.асм = мет.асм
            функц2.парамы = мет.парамы
            функц2.возвр = мет.возвр
            функц2.внеш = 0
            функц2.мод = мод
            функц2.отк = мет.отк
            список_добавь(ген.функции, функц2 как размер)

открыто функ (ген *Ген) рми_интерфейс(мод стр) *Список:
    # сериализация зарегистрированных объявлений модуля в строки .рми
    строки *Список = список_новый()
    для инд в 0..ген.записи.длина:
        зап *ГЗапись = список_получи(ген.записи, инд) как *ГЗапись
        если не стр_равны(зап.мод, мод):
            следующий
        т стр = _склей4("запись ", зап.имя, " ",
                _цел_стр(зап.отк как цел.верх))
        т = _склей3(т, " ", _цел_стр(зап.разм как цел.верх))
        для инд2 в 0..зап.поля.длина:
            пл *ГПоле = список_получи(зап.поля, инд2) как *ГПоле
            т = _склей4(т, " ", пл.имя,
                _склей3("=", тип_стр(пл.тип),
                    _склей2("=", _цел_стр(пл.смещ))))
        список_добавь(строки, т как размер)
    для инд в 0..ген.консты.длина:
        конста *ГКонст = список_получи(ген.консты, инд) как *ГКонст
        если не стр_равны(конста.мод, мод):
            следующий
        большое цел.верх = 0
        если конста.большое:
            большое = 1
        список_добавь(строки, _склей4("конст ", конста.имя, " ",
            _склей4(_цел_стр(конста.отк как цел.верх), " ",
                _цел_стр(конста.знач),
                _склей2(" ", _цел_стр(большое)))) как размер)
    для инд в 0..ген.синонимы.длина:
        син *ГСин = список_получи(ген.синонимы, инд) как *ГСин
        если не стр_равны(син.мод, мод):
            следующий
        список_добавь(строки, _склей4("син ", син.имя, " ",
            _склей3(_цел_стр(син.отк как цел.верх), " ",
                тип_стр(син.тип))) как размер)
    для инд в 0..ген.перечи.длина:
        переч *ГПереч = список_получи(ген.перечи, инд) как *ГПереч
        если не стр_равны(переч.мод, мод):
            следующий
        т = _склей4("переч ", переч.имя, " ",
            _цел_стр(переч.отк как цел.верх))
        для инд2 в 0..переч.элементы.длина:
            пл = список_получи(переч.элементы, инд2) как *ГПоле
            т = _склей4(т, " ", пл.имя,
                _склей2("=", _цел_стр(пл.смещ)))
        список_добавь(строки, т как размер)
    для инд в 0..ген.методы.длина:
        мет *ГМетод = список_получи(ген.методы, инд) как *ГМетод
        если не стр_равны(мет.мод, мод):
            следующий
        т = _склей4("метод ", мет.запись, " ", мет.имя)
        т = _склей4(т, " ", _цел_стр(мет.отк как цел.верх), " ")
        т = _склей3(т, мет.асм, _склей2(" ", тип_стр(мет.возвр)))
        для инд2 в 0..мет.парамы.длина:
            прм *Узел = список_получи(мет.парамы, инд2) как *Узел
            т = _склей4(т, " ", прм.текст, _склей2("=", тип_стр(прм.а)))
        список_добавь(строки, т как размер)
    для инд в 0..ген.функции.длина:
        функц *ГФунк = список_получи(ген.функции, инд) как *ГФунк
        если не стр_равны(функц.мод, мод):
            следующий
        если функц.внеш == 0 и стр_найди(функц.имя, ".") >= 0:
            следующий       # точечная копия метода — уже в строке «метод»
        длл стр = "-"
        т = _склей4("функ ", функц.имя, " ",
            _цел_стр(функц.отк как цел.верх))
        т = _склей4(т, " ", функц.асм, " ")
        т = _склей3(т, _цел_стр(функц.внеш как цел.верх), " ")
        если функц.внеш != 0 и функц.длл != пусто:
            длл = функц.длл
        т = _склей2(т, длл)
        т = _склей2(т, _склей2(" ", тип_стр(функц.возвр)))
        для инд2 в 0..функц.парамы.длина:
            прм = список_получи(функц.парамы, инд2) как *Узел
            т = _склей4(т, " ", прм.текст, _склей2("=", тип_стр(прм.а)))
        список_добавь(строки, т как размер)
    верни строки

открыто функ (ген *Ген) рми_пиши(мб *ГМодБуф, суффикс стр):
    # записать .рми для свежесобранного модуля
    если не ген.кэш_вкл или мб.км != пусто или стр_равны(мб.мод, ген.корень):
        верни
    интерфейс *Список = ген.рми_интерфейс(мб.мод)
    зависим *Список = список_новый()
    для инд в 0..ген.зависим.длина:
        зав *КЗавис = список_получи(ген.зависим, инд) как *КЗавис
        если стр_равны(зав.владелец, мб.мод):
            список_добавь(зависим, зав как размер)
    хеш нат.верх = 0
    для инд в 0..ген.хеши.длина:
        кх *КХеш = список_получи(ген.хеши, инд) как *КХеш
        если стр_равны(кх.мод, мб.мод):
            хеш = кх.хеш
    главная нат.верх = 0
    для инд в 0..ген.функции.длина:
        функц *ГФунк = список_получи(ген.функции, инд) как *ГФунк
        если стр_равны(функц.мод, мб.мод) и стр_равны(функц.имя, "главная"):
            главная = 1
    текст стр = рми_собери(мб.мод, суффикс, ген.режим, ген.память, ген.опт,
        хеш, мб.нужны, главная, зависим, интерфейс,
        буф_стр(мб.код), буф_стр(мб.данные))
    файл_запиши(рми_путь(мб.мод, суффикс), текст)

открыто функ (ген *Ген) генерируй(прог *Узел) стр:
    # проход 0: реестр модулей из «взять» (загрузчик кладёт пути в дети2)
    если прог.дети2 != пусто:
        для инд в 0..прог.дети2.длина:
            мп стр = список_получи(прог.дети2, инд) как стр
            мл стр = _лист_пути(мп)
            ген.мод_рег(мп, мл)
            ген.мод_рег(мл, мл)
    # проход 1: типы и сигнатуры; маркер У_РМИ подменяет объявления модуля
    для инд в 0..прог.дети.длина:
        объяв *Узел = список_получи(прог.дети, инд) как *Узел
        вид нат.верх = объяв.вид
        ген.мод_тек = объяв.мод
        ген.стр_тек = объяв.строка
        если вид == У_РМИ:
            км *КэшМодуль = объяв.знач как *КэшМодуль
            мбуф *ГМодБуф = ген.мбуф_сейчас(объяв.мод)
            мбуф.км = км
            ген.кэш_рег(км, объяв.мод)
            следующий
        ген.мбуф_сейчас(объяв.мод)
        если вид == У_ЗАПИСЬ:
            ген.объяви_запись(объяв)
        а если вид == У_ТИПСИН:
            син *ГСин = новый(ГСин)
            син.имя = объяв.текст
            син.тип = объяв.а
            син.мод = объяв.мод
            син.отк = объяв.отк
            список_добавь(ген.синонимы, син как размер)
        а если вид == У_КОНСТ:
            конста *ГКонст = новый(ГКонст)
            конста.имя = объяв.текст
            конста.знач = ген.конст(объяв.а)
            конста.большое = ген.конст_большое
            конста.мод = объяв.мод
            конста.отк = объяв.отк
            список_добавь(ген.консты, конста как размер)
        а если вид == У_ПЕРЕЧ:
            переч *ГПереч = новый(ГПереч)
            переч.имя = объяв.текст
            переч.мод = объяв.мод
            переч.отк = объяв.отк
            переч.элементы = список_новый()
            для инд2 в 0..объяв.дети.длина:
                элем *Узел = список_получи(объяв.дети, инд2) как *Узел
                пл *ГПоле = новый(ГПоле)
                пл.имя = элем.текст
                пл.смещ = элем.знач как смещение
                список_добавь(переч.элементы, пл как размер)
            список_добавь(ген.перечи, переч как размер)
        а если вид == У_ВНЕШ:
            ген.имп_добавь(объяв.текст2, объяв.текст)
            функц *ГФунк = новый(ГФунк)
            функц.имя = объяв.текст
            функц.асм = объяв.текст
            функц.парамы = объяв.дети
            функц.возвр = объяв.а
            функц.внеш = 1
            функц.длл = объяв.текст2
            функц.мод = объяв.мод
            функц.отк = объяв.отк
            список_добавь(ген.функции, функц как размер)
        а если вид == У_ФУНК:
            если объяв.в != пусто:
                тип_пр *Узел = ген.реш_тип(объяв.в.а)
                имя_записи стр = ""
                если тип_пр.знач == ТВ_УКАЗ:
                    бр *Узел = ген.реш_тип(тип_пр.а)
                    если бр.знач != ТВ_ИМЯ:
                        ген_ош("приёмник метода — запись или *запись",
                               объяв.строка)
                    имя_записи = бр.текст
                а если тип_пр.знач == ТВ_ИМЯ:
                    имя_записи = тип_пр.текст
                иначе:
                    ген_ош("приёмник метода — запись или *запись", объяв.строка)
                парамы *Список = список_новый()
                прм0 *Узел = узел(У_ПАРАМ, объяв.строка)
                прм0.текст = объяв.в.текст
                прм0.а = т_указ(т_запись(имя_записи))
                список_добавь(парамы, прм0 как размер)
                для инд2 в 0..объяв.дети.длина:
                    список_добавь(парамы, список_получи(объяв.дети, инд2))
                мет *ГМетод = новый(ГМетод)
                мет.запись = имя_записи
                мет.имя = объяв.текст
                мет.асм = _склей4("ф_", имя_записи, "_", объяв.текст)
                мет.парамы = парамы
                мет.возвр = объяв.а
                мет.мод = объяв.мод
                мет.отк = объяв.отк
                список_добавь(ген.методы, мет как размер)
                функц = новый(ГФунк)
                функц.имя = _склей3(имя_записи, ".", объяв.текст)
                функц.асм = мет.асм
                функц.парамы = парамы
                функц.возвр = объяв.а
                функц.внеш = 0
                функц.мод = объяв.мод
                функц.отк = объяв.отк
                список_добавь(ген.функции, функц как размер)
            иначе:
                функц = новый(ГФунк)
                функц.имя = объяв.текст
                функц.асм = _склей2("ф_", _асм_имя(объяв.текст))
                функц.парамы = объяв.дети
                функц.возвр = объяв.а
                функц.внеш = 0
                функц.мод = объяв.мод
                функц.отк = объяв.отк
                список_добавь(ген.функции, функц как размер)
    # автоматический импорт завершения
    если ген.цель == 0:
        ген.имп_добавь("kernel32", "ExitProcess")
    # проход 2: код функций — каждая в фрагмент своего модуля
    для инд в 0..прог.дети.длина:
        объяв = список_получи(прог.дети, инд) как *Узел
        если объяв.вид == У_ФУНК:
            если стр_равны(объяв.текст, "главная"):
                ген.есть_главная = 1
            ген.мбуф_сейчас(объяв.мод)
            ген.функ_(объяв)
    если ген.цель == 0 и (ген.нужны_стд & 3) != 0:
        ген.имп_добавь("kernel32", "GetProcessHeap")
    если ген.цель == 0 и (ген.нужны_стд & 1) != 0:
        ген.имп_добавь("kernel32", "HeapAlloc")
    если ген.цель == 0 и (ген.нужны_стд & 2) != 0:
        ген.имп_добавь("kernel32", "HeapFree")
    если ген.цель == 0 и (ген.нужны_стд & 124) != 0:
        ген.имп_добавь("kernel32", "GetStdHandle")
        ген.имп_добавь("kernel32", "WriteFile")
    # стд-помощники и старт — общие, идут во фрагмент корневого модуля
    ген.мбуф_сейчас(ген.корень)
    ген.стд_хелперы()
    если ген.есть_главная != 0:
        ген.старт()
    иначе:
        ген_ош("программе нужна функция «главная»", 0)
    # сборка текста: фрагменты модулей склеиваются в порядке обхода
    суффикс стр = "windows"
    если ген.цель == 1:
        суффикс = "linux"
    а если ген.цель == 2:
        суффикс = "macos"
    вых *Буфер = буф_новый()
    если ген.цель == 1:
        буф_добавь(вых, ";цель linux\n")
    а если ген.цель == 2:
        буф_добавь(вых, ";цель macos\n")
    если ген.режим == 0:
        буф_добавь(вых, ";режим быстро\n")
    иначе:
        буф_добавь(вых, ";режим надёжно\n")
    если ген.память == 1:
        буф_добавь(вых, ";память проверка\n")
    буф_добавь(вых, _склей2(";версия ", стр_склей(
        без_в_стр(ВЕРСИЯ_КАНОНА как нат.верх), "\n")))
    буф_добавь(вых, "; сгенерировано компилятором РАЗУМ\nСЕКЦИЯ код\n")
    для инд в 0..ген.импорты.длина:
        имп *ГИмп = список_получи(ген.импорты, инд) как *ГИмп
        буф_добавь(вых, _склей3("ИМПОРТ \"", имп.длл, "\" "))
        для инд2 в 0..имп.имена.длина:
            если инд2 > 0:
                буф_добавь(вых, ", ")
            буф_добавь(вых, список_получи(имп.имена, инд2) как стр)
        буф_сим(вых, 10)
    если ген.есть_главная != 0:
        буф_добавь(вых, "ВХОД старт\n")
    для инд в 0..ген.модбуфы.длина:
        мб *ГМодБуф = список_получи(ген.модбуфы, инд) как *ГМодБуф
        если мб.км != пусто:
            буф_добавь(вых, мб.км.код)          # фрагмент уже оптимизирован при создании .рми
        иначе:
            текст_к стр = буф_стр(мб.код)
            если ген.опт > 0:
                текст_к = опт_код(текст_к)
            буф_добавь(вых, текст_к)
            мб.код = буф_новый()                 # в .рми пойдёт именно этот текст
            буф_добавь(мб.код, текст_к)
    есть_данные лог = нет
    если ген.цель == 2:
        есть_данные = да                         # гл_аргв ниже
    для инд в 0..ген.модбуфы.длина:
        мб = список_получи(ген.модбуфы, инд) как *ГМодБуф
        если (мб.км != пусто и мб.км.данные.длина > 0) или мб.данные.длина > 0:
            есть_данные = да
    если есть_данные:
        буф_добавь(вых, "СЕКЦИЯ данные\n")
        если ген.цель == 2:
            буф_добавь(вых, "гл_аргв: КВАД 0, 0\n")
        для инд в 0..ген.модбуфы.длина:
            мб = список_получи(ген.модбуфы, инд) как *ГМодБуф
            если мб.км != пусто:
                буф_добавь(вых, мб.км.данные)
            иначе:
                текст_д стр = буф_стр(мб.данные)   # буф_стр отсоединяет данные
                буф_добавь(вых, текст_д)
                мб.данные = буф_новый()             # в .рми пойдёт именно этот текст
                буф_добавь(мб.данные, текст_д)
    # записать .рми свежесобранных модулей — в кэш идёт текст из выхода
    для инд в 0..ген.модбуфы.длина:
        мб = список_получи(ген.модбуфы, инд) как *ГМодБуф
        ген.рми_пиши(мб, суффикс)
    верни буф_стр(вых)
