функ (ген *Ген) счёт_бамп(имя стр, вес нат.верх):
    для инд в 0..ген.счёты.длина:
        счёт *ГСчёт = список_получи(ген.счёты, инд) как *ГСчёт
        если стр_равны(счёт.имя, имя):
            счёт.колво += вес
            верни
    счёт = новый(ГСчёт)
