открыто функ (ген *Ген) мод_канд(имена *Список) *Список:
    # кандидаты манглированных имён для цепочки «a.b.c»
    канд *Список = список_новый()
    дл размер = имена.длина
    инд смещение = (дл как смещение) - 1
    пока инд >= 1:
        мод *ГМод = ген.мод_ищи(_склей(имена, 0, инд как размер, "."))
        если мод != пусто:
            список_добавь(канд, стр_склей(стр_склей(мод.преф, "_"),
                _склей(имена, инд как размер, дл, "_")) как размер)
            список_добавь(канд, _склей(имена, инд как размер, дл, "_") как размер)
        инд -= 1
    список_добавь(канд, _склей(имена, 0, дл, "_") как размер)
    если дл == 2:
        если ген.мод_ищи(список_получи(имена, 0) как стр) != пусто:
            список_добавь(канд, список_получи(имена, 1))
    верни канд

