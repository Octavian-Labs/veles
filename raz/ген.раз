открыто функ (ген *Ген) требуй_лог(выр *Узел):
    тип_уз *Узел = ген.реш_тип(ген.тип_выр(выр))
    если тип_уз.знач != ТВ_БУЛ:
        ген_ош(_склей2("условие должно иметь тип лог, получено ",
            ген.имя_типа(тип_уз)), выр.строка)

открыто функ (ген *Ген) требуй_логические_операнды(выр *Узел):
    лев *Узел = ген.реш_тип(ген.тип_выр(выр.а))
    если стр_равны(выр.текст, "не"):
        если лев.знач != ТВ_БУЛ:
            ген_ош(_склей2("оператор «не» требует лог, получено ",
                ген.имя_типа(лев)), выр.строка)
        верни
    прав *Узел = ген.реш_тип(ген.тип_выр(выр.б))
    если лев.знач != ТВ_БУЛ или прав.знач != ТВ_БУЛ:
        ген_ош(_склей3("оператор «", выр.текст,
            _склей3("» требует лог, получено ", ген.имя_типа(лев),
                _склей2(" и ", ген.имя_типа(прав)))), выр.строка)

открыто функ (ген *Ген) тип_приведения(выр *Узел) *Узел:
    цель *Узел = ген.реш_тип(выр.б)
    исходный *Узел = ген.реш_тип(ген.тип_выр(выр.а))
    если цель.знач == ТВ_БУЛ и исходный.знач != ТВ_БУЛ:
        ген_ош(_склей2("приведение к лог требует исходный тип лог, получено ",
            ген.имя_типа(исходный)), выр.строка)
    если _это_вещ(цель) и не _это_вещ(исходный):
        если исходный.знач != ТВ_ЦЕЛ и исходный.знач != ТВ_БЕЗ:
            ген_ош(_склей2("к вещественному типу приводятся только целые, получено ",
                ген.имя_типа(исходный)), выр.строка)
    если _это_вещ(исходный) и не _это_вещ(цель):
        если цель.знач != ТВ_ЦЕЛ и цель.знач != ТВ_БЕЗ:
            ген_ош(_склей2("вещественный тип приводится только к целым, требуется ",
                ген.имя_типа(цель)), выр.строка)
    верни цель

# пометить все вещественные литералы дерева заданным уровнем;
# да — выражение целиком состоит из литералов (унарные/бинарные над ними)
открыто функ _пометь_лит(выр *Узел, ур нат.верх) лог:
    если выр.вид == У_ВЕЩ:
        выр.знач2 = ур
        верни да
    если выр.вид == У_УН:
        верни _пометь_лит(выр.а, ур)
    если выр.вид == У_БИН:
        верни _пометь_лит(выр.а, ур) и _пометь_лит(выр.б, ур)
    верни нет

открыто функ (ген *Ген) совместим(цель *Узел, выр *Узел, строка размер):
    цель = ген.реш_тип(цель)
    ст *Узел = ген.реш_тип(ген.тип_выр(выр))
    если цель.знач == ТВ_ЛЮБОЙ или ст.знач == ТВ_ЛЮБОЙ:
        верни
    # имя-константа раскрывается в литерал
    если выр.вид == У_ИМЯ:
        конста *ГКонст = ген.конст_ищи(выр.текст)
        если конста != пусто:
            ну *Узел = узел(У_ЧИСЛО, выр.строка)
            ну.знач = конста.знач как нат.верх
            ну.знач2 = конста.большое как нат.верх
            выр = ну
    если (выр.вид == У_ЧИСЛО и
       (цель.знач == ТВ_ЦЕЛ или цель.знач == ТВ_БЕЗ или цель.знач == ТВ_СИМ)):
        знач цел.верх = выр.знач как цел.верх
        бит цел.верх = (ген.размер(цель) * 8) как цел.верх
        ок лог = нет
        если бит >= 64:
            если т_знаковый(цель):
                ок = да
            иначе:
                ок = знач >= 0
        а если т_знаковый(цель):
            ок = (0 - (1 << (бит - 1))) <= знач и знач < (1 << (бит - 1))
        иначе:
            ок = 0 <= знач и знач < (1 << бит)
        если не ок:
            ген_ош(_склей2("литерал не влезает в тип: ", _цел_стр(знач)), строка)
        верни
    # вещественные: литерал принимает уровень цели; смешение уровней — только «как»
    если цель.знач == ТВ_ВЕЩ и ст.знач == ТВ_ВЕЩ:
        если _пометь_лит(выр, цель.знач2):
            верни
        если цель.знач2 != ст.знач2:
            ген_ош(_склей3("несовместимые вещественные уровни: требуется ",
                ген.имя_типа(цель),
                _склей2(", получено ", ген.имя_типа(ст))), строка)
        верни
    если цель.знач == ТВ_УКАЗ и ст.знач == ТВ_УКАЗ:
        бц *Узел = ген.реш_тип(цель.а)
        бс *Узел = ген.реш_тип(ст.а)
        если бц.знач == ТВ_ПУСТО или бс.знач == ТВ_ПУСТО:
            верни
        если (бц.знач != бс.знач или
           (бц.знач == ТВ_ИМЯ и не стр_равны(бц.текст, бс.текст))):
            ген_ош("несовместимые указатели", строка)
        верни
    если цель.знач == ТВ_ФУНК и ст.знач == ТВ_ФУНК:
        верни
    если цель.знач != ст.знач:
        ген_ош(_склей3("несовместимые типы: требуется ", ген.имя_типа(цель),
                   _склей2(", получено ", ген.имя_типа(ст))), строка)
    если цель.знач == ТВ_ИМЯ и не стр_равны(цель.текст, ст.текст):
        ген_ош("разные записи", строка)
    если ((цель.знач == ТВ_СРЕЗ или цель.знач == ТВ_МАСС или
       цель.знач == ТВ_ВЕК) и не т_равны(цель.а, ст.а)):
        ген_ош("несовместимые базовые типы", строка)

