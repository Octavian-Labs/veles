открыто функ тип_стр(тип_уз *Узел) стр:
    # канонический текст типа для .рми — разбирается разбери_тип обратно
    если тип_уз == пусто:
        верни "-"
    вид нат.верх = тип_уз.знач
    если вид == ТВ_ЦЕЛ или вид == ТВ_БЕЗ:
        верни тип_уз.текст
    если вид == ТВ_ВЕЩ:
        верни тип_уз.текст
    если вид == ТВ_БУЛ:
        верни "лог"
    если вид == ТВ_СИМ:
        верни "сим"
    если вид == ТВ_СТР:
        верни "стр"
    если вид == ТВ_ПУСТО:
        верни "пусто"
    если вид == ТВ_УКАЗ:
        верни _склей2("*", тип_стр(тип_уз.а))
    если вид == ТВ_СРЕЗ:
        верни _склей2("[]", тип_стр(тип_уз.а))
    если вид == ТВ_МАСС:
        верни _склей3(тип_стр(тип_уз.а),
            _склей2("[", _цел_стр(тип_уз.знач2 как цел.верх)), "]")
    если вид == ТВ_ВЕК:
        # компактная форма без пробелов: «век4:вещ32»
        верни _склей3("век", _цел_стр(тип_уз.знач2 как цел.верх),
            _склей2(":", тип_стр(тип_уз.а)))
    если вид == ТВ_ИМЯ:
        верни тип_уз.текст
    если вид == ТВ_ФУНК:
        т стр = "функ("
        если тип_уз.дети != пусто:
            для инд в 0..тип_уз.дети.длина:
                если инд > 0:
                    т = _склей2(т, ",")
                т = _склей2(т, тип_стр(список_получи(тип_уз.дети, инд) как *Узел))
        т = _склей2(т, ")")
        если тип_уз.б == пусто:
            верни _склей2(т, ":")
        верни _склей2(т, тип_стр(тип_уз.б))
    верни "цел64"    # служебный ТВ_ЛЮБОЙ в интерфейс не попадает

открыто функ _тип_из_стр(текст стр) *Узел:
    если стр_равны(текст, "-"):
        верни пусто как *Узел
    верни разбери_тип(текст)

открыто функ _части(слово стр, разд нат.старт) *Список:
    # разрезать слово по байту-разделителю (поля «имя=тип=смещ»)
    части *Список = список_новый()
    нач размер = 0
    поз размер = 0
    пока поз <= слово.длина:
        если поз == слово.длина или слово.данные[поз] == разд:
            список_добавь(части, стр_срез(слово, нач, поз) как размер)
            нач = поз + 1
        поз += 1
    верни части

открыто функ т_знаковый(тип_уз *Узел) лог:
    верни тип_уз.знач == ТВ_ЦЕЛ

открыто функ т_равны(лев *Узел, прав *Узел) лог:
    если лев == пусто или прав == пусто:
        верни лев == прав
    если лев.знач != прав.знач:
        верни нет
    если лев.знач == ТВ_ИМЯ:
        верни стр_равны(лев.текст, прав.текст)
    если лев.знач == ТВ_ВЕЩ:
        верни лев.знач2 == прав.знач2
    если лев.знач == ТВ_УКАЗ или лев.знач == ТВ_СРЕЗ:
        верни т_равны(лев.а, прав.а)
    если лев.знач == ТВ_МАСС:
        верни лев.знач2 == прав.знач2 и т_равны(лев.а, прав.а)
    если лев.знач == ТВ_ВЕК:
        верни лев.знач2 == прав.знач2 и т_равны(лев.а, прав.а)
    верни да

открыто функ _имя_целого(текст стр, знаковый лог) стр:
    уровень стр = ""
    если стр_равны(текст, "цел8") или стр_равны(текст, "без8"):
        уровень = "старт"
    а если стр_равны(текст, "цел16") или стр_равны(текст, "без16"):
        уровень = "шаг"
    а если стр_равны(текст, "цел32") или стр_равны(текст, "без32"):
        уровень = "рост"
    а если стр_равны(текст, "цел64") или стр_равны(текст, "без64"):
        уровень = "верх"
    а если стр_равны(текст, "цел128") или стр_равны(текст, "без128"):
        уровень = "пик"
    если знаковый:
        верни _склей2("цел.", уровень)
    верни _склей2("нат.", уровень)

открыто функ (ген *Ген) имя_типа(тип_уз *Узел) стр:
    тип_уз = ген.реш_тип(тип_уз)
    если тип_уз == пусто:
        верни "пусто"
    вид нат.верх = тип_уз.знач
    если вид == ТВ_ЦЕЛ:
        если стр_равны(тип_уз.текст, "смещение"):
            верни "смещение"
        верни _имя_целого(тип_уз.текст, да)
    если вид == ТВ_БЕЗ:
        если стр_равны(тип_уз.текст, "размер"):
            верни "размер"
        верни _имя_целого(тип_уз.текст, нет)
    если вид == ТВ_ВЕЩ:
        если тип_уз.знач2 == 32:
            верни "вещ.рост"
        верни "вещ.верх"
    если вид == ТВ_БУЛ:
        верни "лог"
    если вид == ТВ_СИМ:
        верни "сим"
    если вид == ТВ_СТР:
        верни "стр"
    если вид == ТВ_ПУСТО:
        верни "пусто"
    если вид == ТВ_УКАЗ:
        верни _склей2("*", ген.имя_типа(тип_уз.а))
    если вид == ТВ_СРЕЗ:
        верни _склей2("[]", ген.имя_типа(тип_уз.а))
    если вид == ТВ_МАСС:
        верни _склей3(ген.имя_типа(тип_уз.а), "[",
            _склей2(_цел_стр(тип_уз.знач2 как цел.верх), "]"))
    если вид == ТВ_ВЕК:
        верни _склей4("век ", ген.имя_типа(тип_уз.а), " х ",
            _цел_стр(тип_уз.знач2 как цел.верх))
    если вид == ТВ_ИМЯ:
        верни тип_уз.текст
    если вид == ТВ_ФУНК:
        верни "функ"
    верни "неизвестный тип"

