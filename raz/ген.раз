открыто функ (ген *Ген) стр_интерн(текст стр) стр:
    # метки стр_<фимя>_<номер>/стрд_<фимя>_<номер> уникальны глобально —
    # фрагменты модулей (.рми) можно склеивать без перенумерации
    номер размер = ген.стр_сч
    ген.стр_сч += 1
    хвост стр = _склей3(ген.фимя, "_", _цел_стр(номер как цел.верх))
    части *Список = список_новый()
    буф *Буфер = буф_новый()
    для поз в 0..текст.длина:
        байт нат.старт = текст.данные[поз]
        если байт == 34 или байт == 92 или байт < 32:
            если буф.длина > 0:
                список_добавь(части, _склей3("\"", буф_стр(буф), "\"") как размер)
                буф = буф_новый()
            список_добавь(части, _цел_стр(байт как цел.верх) как размер)
        иначе:
            буф_сим(буф, байт)
    если буф.длина > 0:
        список_добавь(части, _склей3("\"", буф_стр(буф), "\"") как размер)
    список_добавь(части, "0" как размер)
    буф_добавь(ген.данные, _склей3("стрд_", хвост, ": БАЙТ "))
    для инд в 0..части.длина:
        если инд > 0:
            буф_добавь(ген.данные, ", ")
        буф_добавь(ген.данные, список_получи(части, инд) как стр)
    буф_сим(ген.данные, 10)
    буф_добавь(ген.данные, _склей3("стр_", хвост, ": КВАД стрд_"))
    буф_добавь(ген.данные, _склей3(хвост, ", ", _цел_стр(текст.длина как цел.верх)))
    буф_сим(ген.данные, 10)
    верни _склей2("стр_", хвост)

# --- вещественные литералы: decimal → IEEE-754 binary64 ---------------------------
#
# Лексема разбирается в M · 10^E10 (M — нат.верх, до 19 цифр; лишние цифры идут
# в «липкий» бит округления). Значение собирается в 128-битную нормализованную
# мантиссу (вх:вл) с двоичным сдвигом б2: умножение/деление на 10^k (k ≤ 19)
# аппаратными УМНБ/ДЕЛБ. Из верхних 53 бит берётся мантисса f64 с округлением
# к ближайшему чётному.

открыто функ _вещ_умн128(мн нат.верх, вх *нат.верх, вл *нат.верх, лип *нат.верх):
    # (вх:вл) *= мн — произведение хранится по модулю 2^128; биты выше 128
    # (старшая половина вх*мн и перенос сложения) отмечаются в липком
    искра:
        ПЕР Р10, мн
        ПЕР АКК, вл
        ПЕР АКК, [АКК]
        УМНБ Р10            # ДАН:АКК = вл * мн
        ПЕР Р11, ДАН        # перенос в старшую половину
        ПЕР СЧТ, вл
        ПЕР [СЧТ], АКК      # нов_вл = младшие 64 бита вл*мн
        ПЕР АКК, вх
        ПЕР АКК, [АКК]
        УМНБ Р10            # ДАН:АКК = вх * мн
        ПЕР СЧТ, лип
        ИЛИ [СЧТ], ДАН      # старшие биты вх*мн — выше 128, в липкий
        ДОБ АКК, Р11        # нов_вх = младшие(вх*мн) + перенос
        НЕПЕРЕНОС _вумн_р
        ПЕР Р10, 1          # перенос сложения — тоже бит выше 128
        ИЛИ [СЧТ], Р10
        _вумн_р:
        ПЕР СЧТ, вх
        ПЕР [СЧТ], АКК

открыто функ _вещ_дел128(дел нат.верх, вх *нат.верх, вл *нат.верх, лип *нат.верх):
    # (вх:вл) /= дел; остаток — в липкий
    искра:
        ПЕР Р10, дел
        ПЕР АКК, вх
        ПЕР АКК, [АКК]
        ПЕР ДАН, 0
        ДЕЛБ Р10            # АКК = вх/дел, ДАН = остаток < дел
        ПЕР Р11, ДАН
        ПЕР СЧТ, вх
        ПЕР [СЧТ], АКК
        ПЕР АКК, вл
        ПЕР АКК, [АКК]
        ПЕР ДАН, Р11        # ДАН:АКК = остаток:вл — делится без переполнения
        ДЕЛБ Р10
        ПЕР СЧТ, вл
        ПЕР [СЧТ], АКК
        ПЕР СЧТ, лип
        ИЛИ [СЧТ], ДАН

открыто функ _вещ_степень10(к размер) нат.верх:
    мн нат.верх = 1
    для инд в 0..к:
        мн *= 10
    верни мн

открыто функ вещ_биты(текст стр, строка размер, форм нат.верх) нат.верх:
    # decimal-литерал → биты binary64|binary32 (округление к ближайшему чётному)
    # форм = 64: мантисса 53 бита, смещ 1023; форм = 32: мантисса 24, смещ 127
    мбит нат.верх = 53
    емакс цел.верх = 2047
    есмещ цел.верх = 1023
    имя_ур стр = "вещ.верх"
    если форм == 32:
        мбит = 24
        емакс = 255
        есмещ = 127
        имя_ур = "вещ.рост"
    поз размер = 0
    м нат.верх = 0
    е10 цел.верх = 0
    лип нат.верх = 0
    предел нат.верх = 1844674407370955161   # (2^64-1-9)/10 — дальше м не влезет
    пока поз < текст.длина и (это_цифра(текст.данные[поз]) или текст.данные[поз] == '_'):
        б нат.старт = текст.данные[поз]
        если б != '_':
            если м > предел:
                е10 += 1
                если б != '0':
                    лип = 1
            иначе:
                м = м * 10 + ((б - '0') как нат.верх)
        поз += 1
    если поз < текст.длина и текст.данные[поз] == '.':
        поз += 1
        пока поз < текст.длина и (это_цифра(текст.данные[поз]) или текст.данные[поз] == '_'):
            б = текст.данные[поз]
            если б != '_':
                если м > предел:
                    если б != '0':
                        лип = 1
                иначе:
                    м = м * 10 + ((б - '0') как нат.верх)
                    е10 -= 1
            поз += 1
    если поз < текст.длина и (текст.данные[поз] == 'e' или текст.данные[поз] == 'E'):
        поз += 1
        эзнак цел.верх = 1
        если поз < текст.длина и текст.данные[поз] == '-':
            эзнак = 0 - 1
            поз += 1
        а если поз < текст.длина и текст.данные[поз] == '+':
            поз += 1
        эзнач цел.верх = 0
        пока поз < текст.длина и (это_цифра(текст.данные[поз]) или текст.данные[поз] == '_'):
            б = текст.данные[поз]
            если б != '_' и эзнач < 1000000:
                эзнач = эзнач * 10 + ((б - '0') как цел.верх)
            поз += 1
        е10 += эзнак * эзнач
    если м == 0:
        верни 0                            # литерал без знака: 0.0
    # значение держится в вл (≤64 бита), б2 — двоичный масштаб:
    # значение = вл * 2^б2. Умножение на 10^шаг даёт точное произведение
    # в (вх:вл), затем ренормализация вправо возвращает верхние 64 бита в вл.
    # Деление масштабирует вл на 2^64 в (вх:вл) — частное сохраняет точность.
    вх нат.верх = 0
    вл нат.верх = м
    б2 цел.верх = 0
    пока е10 > 0:
        шаг цел.верх = е10
        если шаг > 19:
            шаг = 19
        _вещ_умн128(_вещ_степень10(шаг как размер), &вх, &вл, &лип)
        пока вх != 0:
            лип = лип | (вл & 1)
            вл = (вл >> 1) | (вх << 63)
            вх = вх >> 1
            б2 += 1
        е10 -= шаг
    пока е10 < 0:
        шаг = 0 - е10
        если шаг > 19:
            шаг = 19
        # целочисленное деление теряет дробную часть — нормализуем вл влево
        # (старший бит), затем поднимаем на 64 бита в (вх:вл): частное
        # получает ≈124 бита, из которых ренормализация берёт верхние 64
        пока вл != 0 и (вл >> 63) == 0:
            вл = вл << 1
            б2 -= 1
        вх = вл
        вл = 0
        б2 -= 64
        _вещ_дел128(_вещ_степень10(шаг как размер), &вх, &вл, &лип)
        пока вх != 0:
            лип = лип | (вл & 1)
            вл = (вл >> 1) | (вх << 63)
            вх = вх >> 1
            б2 += 1
        е10 += шаг
        если вл == 0:
            е10 = 0                        # значение стало нулём — выходим
    если вл == 0:
        ген_ош(_склей2("вещественный литерал вне диапазона ", имя_ур), строка)
    пока (вл >> 63) == 0:
        вл = вл << 1
        б2 -= 1
    мант нат.верх = вл >> ((64 - мбит) как размер)   # мбит со скрытой единицей
    охрана нат.верх = (вл >> ((63 - мбит) как размер)) & 1
    остаток нат.верх = (вл & (((1 как нат.верх) << ((63 - мбит) как размер)) - 1)) | лип
    если охрана == 1 и (остаток != 0 или (мант & 1) == 1):
        мант += 1
        если мант == ((1 как нат.верх) << (мбит как размер)):
            мант = (1 как нат.верх) << ((мбит - 1) как размер)
            б2 += 1
    эксп цел.верх = б2 + 63 + есмещ        # вл нормализована к 64 битам
    если эксп >= емакс:
        ген_ош(_склей2("вещественный литерал вне диапазона ", имя_ур), строка)
    хран нат.верх = мбит - 1               # хранимых бит мантиссы (52|23)
    если эксп <= 0:
        # денормал: мантисса со скрытой единицей сдвигается вправо на 1-эксп,
        # отброшенные биты округляются к ближайшему чётному; ниже половины
        # младшего денормала значение обращается в ноль
        сдв цел.верх = 1 - эксп
        если сдв > (мбит как цел.верх):
            верни 0
        п_охрана нат.верх = (мант >> ((сдв - 1) как размер)) & 1
        п_остаток нат.верх = (мант & ((1 << ((сдв - 1) как размер)) - 1)) | охрана | остаток
        мант = мант >> (сдв как размер)
        если п_охрана == 1 и (п_остаток != 0 или (мант & 1) == 1):
            мант += 1
        верни мант & ((1 << (хран как размер)) - 1)
    верни ((эксп как нат.верх) << (хран как размер)) | (мант & ((1 << (хран как размер)) - 1))

открыто функ (ген *Ген) вещ_интерн(текст стр, строка размер, форм нат.верх) стр:
    # константа в секции данных: вещ_<фимя>_<n>: КВАД|ДВСЛОВО <биты>
    номер размер = ген.стр_сч
    ген.стр_сч += 1
    биты нат.верх = вещ_биты(текст, строка, форм)
    хвост стр = _склей3(ген.фимя, "_", _цел_стр(номер как цел.верх))
    разд стр = "КВАД"
    если форм == 32:
        разд = "ДВСЛОВО"
    буф_добавь(ген.данные, _склей4("вещ_", хвост, ": ", _склей2(разд, " ")))
    буф_добавь(ген.данные, без_в_стр(биты))
    буф_сим(ген.данные, 10)
    верни _склей2("вещ_", хвост)

