функ (г *Ген) для_(s *Узел):
    если s.а.вид == У_ДИАП:
        имя_у := список_получи(s.дети, 0) как *Узел
        л := г.локал_ищи(имя_у.текст)
        пр := г.локал_ищи(s.текст2)
        вниз бул = нет
        если г.конст_ли(s.а.а) и г.конст_ли(s.а.б):
            вниз = г.конст(s.а.а) > г.конст(s.а.б)
        г.выр(s.а.а)
        г.сохранить(_слот(л), т_цел64())
        г.выр(s.а.б)
        г.сохранить(_слот(пр), т_цел64())
        нач := г.новая("для")
        шаг := г.новая("дляшаг")
        кон := г.новая("длякон")
        ц *ГЦикл = новый(ГЦикл)
        ц.шаг = шаг
        ц.кон = кон
        список_добавь(г.циклы, ц как без64)
        г.метка(нач)
        г.е(_к2("ПЕР АКК, ", _слот(л)))
        г.е(_к2("СРАВ АКК, ", _слот(пр)))
        если вниз:
            если s.а.знач2 == 1:
                г.е(_к2("МЕНЬШЕ ", кон))
            иначе:
                г.е(_к2("МЕНРАВ ", кон))
        иначе:
            если s.а.знач2 == 1:
                г.е(_к2("БОЛЬШЕ ", кон))
            иначе:
                г.е(_к2("БОЛРАВ ", кон))
        если s.дети2 != пусто:
            для j в 0..s.дети2.длина:
                г.оп(список_получи(s.дети2, j) как *Узел)
        г.метка(шаг)
        если вниз:
            г.е(_к2("УМЕН ", _слот_кв(л)))
        иначе:
            г.е(_к2("УВЕЛ ", _слот_кв(л)))
        г.е(_к2("ПРЫГ ", нач))
        г.метка(кон)
        г.циклы.длина -= 1
        верни
    # для по массиву/срезу
    имя_i := список_получи(s.дети, 0) как *Узел
    л_i := г.локал_ищи(имя_i.текст)
    пр := г.локал_ищи(s.текст2)
    т_ит := г.реш_тип(г.тип_выр(s.а))
    если т_ит.знач == ТВ_МАСС:
        г.е(_к2("ПЕР АКК, ", _н(т_ит.знач2 как цел64)))
        г.сохранить(_слот(пр), т_цел64())
    а если т_ит.знач == ТВ_СРЕЗ:
        г.выр(s.а)
        г.е("ПЕР АКК, [АКК+8]")
        г.сохранить(_слот(пр), т_цел64())
    иначе:
        ген_ош("«для в» — по диапазону, массиву или срезу", s.строка)
    г.е("ПЕР АКК, 0")
    г.сохранить(_слот(л_i), т_цел64())
    нач := г.новая("для")
    шаг := г.новая("дляшаг")
    кон := г.новая("длякон")
    ц *ГЦикл = новый(ГЦикл)
    ц.шаг = шаг
    ц.кон = кон
    список_добавь(г.циклы, ц как без64)
    г.метка(нач)
    г.е(_к2("ПЕР АКК, ", _слот(л_i)))
    г.е(_к2("СРАВ АКК, ", _слот(пр)))
    г.е(_к2("БОЛРАВ ", кон))
    если s.дети.длина == 2:
        имя_э := список_получи(s.дети, 1) как *Узел
        л_э := г.локал_ищи(имя_э.текст)
        инд := узел(У_ИНДЕКС, s.строка)
        инд.а = s.а
        инд.б = имя_i
        э := г.индекс_адрес(инд)
        г.загрузить("[АКК]", э)
        г.сохранить(_слот(л_э), г.реш_тип(л_э.тип))
    если s.дети2 != пусто:
        для j в 0..s.дети2.длина:
            г.оп(список_получи(s.дети2, j) как *Узел)
    г.метка(шаг)
    г.е(_к2("УВЕЛ ", _слот_кв(л_i)))
    г.е(_к2("ПРЫГ ", нач))
    г.метка(кон)
    г.циклы.длина -= 1

функ (г *Ген) выбор_(s *Узел):
    сл := г.локал_ищи(s.текст2)
    слот := _слот(сл)
    г.выр(s.а)
    г.сохранить(слот, т_цел64())
    конец := г.новая("выбкон")
    метки := список_новый()
    для i в 0..s.дети.длина:
        список_добавь(метки, г.новая("выбтело") как без64)
    деф := конец
    если s.дети2 != пусто:
        деф = г.новая("выбиначе")
    для i в 0..s.дети.длина:
        вр := список_получи(s.дети, i) как *Узел
        мт := список_получи(метки, i) как стр
        если вр.дети != пусто:
            для j в 0..вр.дети.длина:
                обр := список_получи(вр.дети, j) как *Узел
                если обр.вид == У_ДИАП:
                    ложь := г.новая("выбмимо")
                    г.е(_к2("ПЕР АКК, ", слот))
                    г.е("ВСТЕК АКК")
                    г.глуб += 1
                    г.выр(обр.а)
                    г.е("ПЕР СЧТ, АКК")
                    г.е("ИЗСТЕКА АКК")
                    г.глуб -= 1
                    г.е("СРАВ АКК, СЧТ")
                    г.е(_к2("МЕНЬШЕ ", ложь))
                    г.е(_к2("ПЕР АКК, ", слот))
                    г.е("ВСТЕК АКК")
                    г.глуб += 1
                    г.выр(обр.б)
                    г.е("ПЕР СЧТ, АКК")
                    г.е("ИЗСТЕКА АКК")
                    г.глуб -= 1
                    г.е("СРАВ АКК, СЧТ")
                    если обр.знач2 == 1:
                        г.е(_к2("БОЛЬШЕ ", ложь))
                    иначе:
                        г.е(_к2("БОЛРАВ ", ложь))
                    г.е(_к2("ПРЫГ ", мт))
                    г.метка(ложь)
                иначе:
                    г.выр(обр)
                    г.е(_к2("СРАВ АКК, ", слот))
                    г.е(_к2("РАВНО ", мт))
    г.е(_к2("ПРЫГ ", деф))
    для i в 0..s.дети.длина:
        вр := список_получи(s.дети, i) как *Узел
        мт := список_получи(метки, i) как стр
        г.метка(мт)
        если вр.дети2 != пусто:
            для j в 0..вр.дети2.длина:
                г.оп(список_получи(вр.дети2, j) как *Узел)
        г.е(_к2("ПРЫГ ", конец))
    если s.дети2 != пусто:
        г.метка(деф)
        для j в 0..s.дети2.длина:
            г.оп(список_получи(s.дети2, j) как *Узел)
    г.метка(конец)

