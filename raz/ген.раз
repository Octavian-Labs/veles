функ (ген *Ген) годен_рег(сим *ГСим) лог:
    # в регистр идёт только скаляр размером 8 без взятия адреса/искра-блоков
    если _имя_есть(ген.запреты, сим.имя):
        верни нет
    тип_уз *Узел = ген.реш_тип(сим.тип)
    если тип_уз.знач == ТВ_ИМЯ или тип_уз.знач == ТВ_МАСС:
        верни нет
    верни ген.размер(тип_уз) == 8

функ (ген *Ген) искра_запреты(текст стр):
    # слова-имена в строке сырой ИСКРЫ — те же правила, что в искра_подстановка
    введи раб = текст
    верх цел.верх = стр_найди(текст, "#")
    если верх >= 0:
        раб = стр_срез(текст, 0, верх как нат.верх)
    поз нат.верх = 0
    пока поз < раб.длина:
        б0 нат.старт = раб.данные[поз]
        если (_слово_нач(б0) и
           (поз == 0 или (не _слово_часть(раб.данные[поз - 1]) и
            раб.данные[поз - 1] != '.'))):
            кон нат.верх = поз + 1
            пока кон < раб.длина и _слово_часть(раб.данные[кон]):
                кон += 1
            после нат.верх = кон
            пока после < раб.длина и (раб.данные[после] == ' ' или раб.данные[после] == 9):
                после += 1
            если после >= раб.длина или раб.данные[после] != ':':
                _запрет_добавь(ген, стр_срез(раб, поз, кон))
            поз = кон
        иначе:
            поз += 1

функ (ген *Ген) метод_ищи2(зап стр, имя стр) *ГМетод:
    для инд в 0..ген.методы.длина:
        мет *ГМетод = список_получи(ген.методы, инд) как *ГМетод
        если стр_равны(мет.запись, зап) и стр_равны(мет.имя, имя):
