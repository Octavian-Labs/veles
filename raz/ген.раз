функ _лок_добавь(порядок *Список, имя стр, тип_уз *Узел, выр *Узел):
    лок *ГЛок = новый(ГЛок)
    лок.имя = имя
    лок.тип = тип_уз
    лок.выр = выр
    список_добавь(порядок, лок как нат.верх)

функ _имя_есть(имена *Список, имя стр) лог:
    для инд в 0..имена.длина:
        если стр_равны(список_получи(имена, инд) как стр, имя):
            верни да
    верни нет

функ (ген *Ген) скан_выр(выр *Узел, порядок *Список, гл нат.верх):
    # гл — глубина вложенных циклов: обращения внутри цикла весят больше
    если выр == пусто:
        верни
    вид нат.верх = выр.вид
    если вид == У_ЛИТТИП:
        слот стр = _склей2("_лит", _цел_стр(ген.мет_сч как цел.верх))
        ген.мет_сч += 1
        выр.текст2 = слот
        _лок_добавь(порядок, слот, ген.реш_тип(выр.а), пусто как *Узел)
        для инд в 0..выр.дети.длина:
            эл *Узел = список_получи(выр.дети, инд) как *Узел
            ген.скан_выр(эл.а, порядок, гл)
        верни
    если вид == У_СРЕЗ:
        слот = _склей2("_срез", _цел_стр(ген.мет_сч как цел.верх))
        ген.мет_сч += 1
        выр.текст2 = слот
        _лок_добавь(порядок, слот, т_масс(т_без8(), 16), пусто как *Узел)
        ген.скан_выр(выр.а, порядок, гл)
        ген.скан_выр(выр.б.а, порядок, гл)
        ген.скан_выр(выр.б.б, порядок, гл)
        верни
    если вид == У_ИМЯ:
        ген.счёт_бамп(выр.текст, 1 + 4 * гл)
        верни
    если (вид == У_ЧИСЛО или вид == У_СТР или вид == У_БУЛ или
       вид == У_ПУСТО или вид == У_ТИП):
        верни
    если вид == У_АДРЕС и выр.а != пусто и выр.а.вид == У_ИМЯ:
        # взятие адреса переменной требует реального слота в кадре
        _запрет_добавь(ген, выр.а.текст)
    # общий обход полей
    ген.скан_выр(выр.а, порядок, гл)
    ген.скан_выр(выр.б, порядок, гл)
    ген.скан_выр(выр.в, порядок, гл)
    ген.скан_выр(выр.г, порядок, гл)
    если выр.дети != пусто:
        для инд в 0..выр.дети.длина:
            ген.скан_выр(список_получи(выр.дети, инд) как *Узел, порядок, гл)
    если выр.дети2 != пусто:
        для инд в 0..выр.дети2.длина:
            ген.скан_выр(список_получи(выр.дети2, инд) как *Узел, порядок, гл)

функ (ген *Ген) скан_тело(тело *Список, порядок *Список, имена *Список,
                        гл нат.верх):
    если тело == пусто:
        верни
    для инд в 0..тело.длина:
        оператор *Узел = список_получи(тело, инд) как *Узел
        вид нат.верх = оператор.вид
        если вид == У_ОБЪЯВЛ:
            если _имя_есть(имена, оператор.текст):
                ген_ош(_склей3("повторное объявление имени «", оператор.текст,
                           "»"), оператор.строка)
            список_добавь(имена, оператор.текст как нат.верх)
            _лок_добавь(порядок, оператор.текст, оператор.а, оператор.б)
            если оператор.а == пусто:
                # объявление с выводом типа не может перекрывать видимое имя
                если (ген.парам_ищи(оператор.текст) != пусто или
                      ген.функ_ищи(оператор.текст) != пусто или
                      ген.конст_ищи(оператор.текст) != пусто):
                    ген_ош(_склей3("объявление «", оператор.текст,
                               "» перекрывает видимое имя — переименуйте"), оператор.строка)
                если не ген.пред_сказано и оператор.знач2 == 0:
                    печать_ош(_склей2("разум: предупреждение: «:=» устарело — ",
                                  "объявление теперь «введи имя = выражение»\n"))
                    ген.пред_сказано = да
            ген.скан_выр(оператор.б, порядок, гл)
        а если вид == У_КОНСТ:
            конста *ГКонст = новый(ГКонст)
            конста.имя = оператор.текст
            конста.знач = ген.конст(оператор.а)
            конста.большое = ген.конст_большое
            список_добавь(ген.консты, конста как нат.верх)
        а если вид == У_ПРИСВ:
            ген.скан_выр(оператор.а, порядок, гл)
            ген.скан_выр(оператор.б, порядок, гл)
        а если вид == У_ВЫРОП или вид == У_ВЕРНИ или вид == У_ОТЛОЖИ:
            ген.скан_выр(оператор.а, порядок, гл)
        а если вид == У_ИСКРА:
            # имена в сырой ИСКРЕ должны остаться адресуемыми в кадре
            если оператор.дети != пусто:
                для инд2 в 0..оператор.дети.длина:
                    ген.искра_запреты((список_получи(оператор.дети, инд2) как *Узел).текст)
        а если вид == У_ЕСЛИ:
            если оператор.дети != пусто:
                для инд2 в 0..оператор.дети.длина:
                    рукав *Узел = список_получи(оператор.дети, инд2) как *Узел
                    ген.скан_выр(рукав.а, порядок, гл)
                    ген.скан_тело(рукав.дети, порядок, имена, гл)
            ген.скан_тело(оператор.дети2, порядок, имена, гл)
        а если вид == У_ПОКА:
            ген.скан_выр(оператор.а, порядок, гл + 1)
            ген.скан_тело(оператор.дети, порядок, имена, гл + 1)
        а если вид == У_ВЕЧНО:
            ген.скан_тело(оператор.дети, порядок, имена, гл + 1)
        а если вид == У_ДЛЯ:
            для инд2 в 0..оператор.дети.длина:
                имя_у *Узел = список_получи(оператор.дети, инд2) как *Узел
                если не _имя_есть(имена, имя_у.текст):
                    список_добавь(имена, имя_у.текст как нат.верх)
                    если инд2 == 0:
                        _лок_добавь(порядок, имя_у.текст, т_цел64(),
                                    пусто как *Узел)
                    иначе:
                        инд_у *Узел = узел(У_ИНДЕКС, оператор.строка)
                        инд_у.а = оператор.а
                        числ *Узел = узел(У_ЧИСЛО, оператор.строка)
                        инд_у.б = числ
                        _лок_добавь(порядок, имя_у.текст, пусто как *Узел, инд_у)
                # переменная цикла пишется и читается на каждой итерации
                ген.счёт_бамп(имя_у.текст, 5 + 4 * гл)
            ген.скан_выр(оператор.а, порядок, гл)
            слот стр = _склей2("_предел", _цел_стр(ген.мет_сч как цел.верх))
            ген.мет_сч += 1
            оператор.текст2 = слот
            _лок_добавь(порядок, слот, т_цел64(), пусто как *Узел)
            ген.счёт_бамп(слот, 5 + 4 * гл)
            ген.скан_тело(оператор.дети2, порядок, имена, гл + 1)
        а если вид == У_ВЫБОР:
            ген.скан_выр(оператор.а, порядок, гл)
            слот = _склей2("_выбор", _цел_стр(ген.мет_сч как цел.верх))
            ген.мет_сч += 1
            оператор.текст2 = слот
            _лок_добавь(порядок, слот, т_цел64(), пусто как *Узел)
            если оператор.дети != пусто:
                для инд2 в 0..оператор.дети.длина:
                    вр *Узел = список_получи(оператор.дети, инд2) как *Узел
                    если вр.дети != пусто:
                        для инд3 в 0..вр.дети.длина:
                            ген.скан_выр(список_получи(вр.дети, инд3) как *Узел,
                                       порядок, гл)
                    ген.скан_тело(вр.дети2, порядок, имена, гл)
            ген.скан_тело(оператор.дети2, порядок, имена, гл)

