открыто функ (ген *Ген) искра_подстановка(текст стр) текст:
    # отрезать комментарий '#'
    введи раб = текст
    верх смещение = стр_найди(текст, "#")
    если верх >= 0:
        раб = стр_срез(текст, 0, верх как размер)
    буф *Буфер = буф_новый()
    поз размер = 0
    пока поз < раб.длина:
        б0 нат.старт = раб.данные[поз]
        если (_слово_нач(б0) и
           (поз == 0 или (не _слово_часть(раб.данные[поз - 1]) и
            раб.данные[поз - 1] != '.'))):
            кон размер = поз + 1
            пока кон < раб.длина и _слово_часть(раб.данные[кон]):
                кон += 1
            # не метка «имя:» (после слова допускаются пробелы)
            после размер = кон
            пока после < раб.длина и (раб.данные[после] == ' ' или раб.данные[после] == 9):
                после += 1
            если после < раб.длина и раб.данные[после] == ':':
                для инд3 в поз..кон:
                    буф_сим(буф, раб.данные[инд3])
            иначе:
                слово стр = стр_срез(раб, поз, кон)
                лок *ГСим = ген.локал_ищи(слово)
                псим *ГСим = ген.парам_ищи(слово)
                если лок != пусто:
                    буф_добавь(буф, _слот(лок))
                а если псим != пусто:
                    буф_добавь(буф, _слот(псим))
                иначе:
                    буф_добавь(буф, слово)
            поз = кон
        иначе:
            буф_сим(буф, б0)
            поз += 1
    верни буф_стр(буф)

открыто функ (ген *Ген) объявл(оператор *Узел):
    лок *ГСим = ген.локал_ищи(оператор.текст)
    если лок == пусто:
        ген_ош(_склей2("внутренняя: локаль не выделена ", оператор.текст), оператор.строка)
    смещ смещение = лок.смещ
    тип_уз *Узел = ген.реш_тип(лок.тип)
    если оператор.б == пусто:
        если лок.рег > 0:
            ген.пиши(_склей3("ПЕР ", _рег_лок(лок.рег - 1), ", 0"))
            верни
        разм размер = ген.размер(тип_уз)
        если разм <= 8:
            если разм == 8:
                ген.пиши(_склей3("ПЕР КВАД", _адр_лок(смещ), ", 0"))
            а если разм == 4:
                ген.пиши(_склей3("ПЕР ДВСЛОВО", _адр_лок(смещ), ", 0"))
            а если разм == 2:
                ген.пиши(_склей3("ПЕР СЛОВО", _адр_лок(смещ), ", 0"))
            иначе:
                ген.пиши(_склей3("ПЕР БАЙТ", _адр_лок(смещ), ", 0"))
        иначе:
            цикл стр = ген.новая("обнул_цикл")
            ген.пиши(_склей2("ПЕР СЧТ, ", _цел_стр(разм как цел.верх)))
            ген.пиши(_склей2("АДР ПРМ, ", _адр_лок(смещ)))
            ген.метка(цикл)
            ген.пиши("ПЕР БАЙТ[ПРМ], 0")
            ген.пиши("УВЕЛ ПРМ")
            ген.пиши("УМЕН СЧТ")
            ген.пиши(_склей2("НЕНОЛЬ ", цикл))
        верни
    ген.совместим(тип_уз, оператор.б, оператор.строка)
    тип_знач *Узел = ген.выр(оператор.б)
    если тип_уз.знач == ТВ_ЛЮБОЙ:
        тип_уз = тип_знач
    если (ген.реш_тип(тип_уз).знач == ТВ_ИМЯ или ген.реш_тип(тип_уз).знач == ТВ_МАСС или
       ген.реш_тип(ген.тип_выр(оператор.б)).знач == ТВ_ИМЯ или
       ген.реш_тип(ген.тип_выр(оператор.б)).знач == ТВ_МАСС):
        разм = ген.размер(тип_уз)
        ген.пиши("ВСТЕК АКК")
        ген.глуб += 1
        ген.пиши(_склей2("АДР АКК, ", _адр_лок(смещ)))
        ген.пиши("ПЕР ПРМ, АКК")
        ген.пиши("ИЗСТЕКА ИСТ")
        ген.глуб -= 1
        цикл = ген.новая("коп_цикл")
        ген.пиши(_склей2("ПЕР СЧТ, ", _цел_стр(разм как цел.верх)))
        ген.метка(цикл)
        ген.пиши("ПЕР АККБ, БАЙТ[ИСТ]")
        ген.пиши("ПЕР БАЙТ[ПРМ], АККБ")
        ген.пиши("УВЕЛ ИСТ")
        ген.пиши("УВЕЛ ПРМ")
        ген.пиши("УМЕН СЧТ")
        ген.пиши(_склей2("НЕНОЛЬ ", цикл))
        верни
    ген.сохранить(_слот(лок), тип_уз)

открыто функ (ген *Ген) присв(оператор *Узел):
    # регистровая переменная: запись напрямую, без адреса и стека
    если оператор.а.вид == У_ИМЯ:
        сл *ГСим = ген.локал_ищи(оператор.а.текст)
        если сл == пусто:
            сл = ген.парам_ищи(оператор.а.текст)
        если сл != пусто и сл.рег > 0:
            рг стр = _рег_лок(сл.рег - 1)
            тип_уз *Узел = ген.тип_выр(оператор.а)
            ген.совместим(тип_уз, оператор.б, оператор.строка)
            ген.выр(оператор.б)
            если стр_равны(оператор.текст, "="):
                ген.пиши(_склей3("ПЕР ", рг, ", АКК"))
                верни
            оп стр = стр_срез(оператор.текст, 0, 1)
            если стр_равны(оп, "+"):
                ген.пиши(_склей3("ДОБ ", рг, ", АКК"))
                верни
            если стр_равны(оп, "-"):
                ген.пиши(_склей3("ВЫЧ ", рг, ", АКК"))
                верни
            если стр_равны(оп, "&"):
                ген.пиши(_склей3("И ", рг, ", АКК"))
                верни
            если стр_равны(оп, "|"):
                ген.пиши(_склей3("ИЛИ ", рг, ", АКК"))
                верни
            если стр_равны(оп, "^"):
                ген.пиши(_склей3("ИИЛИ ", рг, ", АКК"))
                верни
            если стр_равны(оп, "*"):
                ген.пиши(_склей3("УМН ", рг, ", АКК"))
                верни
            # / и %: делитель в СЧТ, делимое в АКК, ДАН свободен
            ген.пиши("ПЕР СЧТ, АКК")
            ген.пиши(_склей2("ПЕР АКК, ", рг))
            ген.пиши("РАСШ")
            ген.пиши("ДЕЛ СЧТ")
            если стр_равны(оп, "%"):
                ген.пиши("ПЕР АКК, ДАН")
            ген.пиши(_склей3("ПЕР ", рг, ", АКК"))
            верни
    если оператор.а.вид == У_ИМЯ:
        если (ген.локал_ищи(оператор.а.текст) == пусто и
              ген.парам_ищи(оператор.а.текст) == пусто):
            ген_ош(_склей3("имя «", оператор.а.текст,
                       "» не объявлено — объявление: «имя тип = значение»"),
                   оператор.строка)
        иначе:
            # статический слот локала/параметра: операция прямо по
            # [УКК±смещ] — без АДР/ВСТЕК/ИЗСТЕКА вокруг правой части
            сл0 *ГСим = ген.локал_ищи(оператор.а.текст)
            если сл0 == пусто:
                сл0 = ген.парам_ищи(оператор.а.текст)
            если сл0.рег == 0:
                верни ген.присв_слот(оператор, _слот(сл0))
    ген.адрес(оператор.а, 1)
    тип_уз = ген.тип_выр(оператор.а)
    ген.совместим(тип_уз, оператор.б, оператор.строка)
    ген.пиши("ВСТЕК АКК")
    ген.глуб += 1
    ген.выр(оператор.б)
    тип_в *Узел = ген.реш_тип(тип_уз)
    если _это_вещ(тип_в):
        суф стр = _вещ_суф(тип_в)
        разд стр = _вещ_раз(тип_в)
        ген.пиши("ИЗСТЕКА ДАН")              # адрес назначения
        ген.глуб -= 1
        если стр_равны(оператор.текст, "="):
            ген.пиши(_склей4("ПЕРВ", суф, " ", _склей3(разд, "[ДАН]", ", ПЛАВ0")))
            верни
        # б уже в ПЛАВ0; старое значение цели — в ПЛАВ1, результат обратно
        ген.пиши(_склей4("ПЕРВ", суф, " ПЛАВ1, ", _склей2(разд, "[ДАН]")))
        оп = стр_срез(оператор.текст, 0, 1)
        если стр_равны(оп, "+"):
            ген.пиши(_склей3("ДОБВ", суф, " ПЛАВ1, ПЛАВ0"))
        а если стр_равны(оп, "-"):
            ген.пиши(_склей3("ВЫЧВ", суф, " ПЛАВ1, ПЛАВ0"))
        а если стр_равны(оп, "*"):
            ген.пиши(_склей3("УМНВ", суф, " ПЛАВ1, ПЛАВ0"))
        а если стр_равны(оп, "/"):
            ген.пиши(_склей3("ДЕЛВ", суф, " ПЛАВ1, ПЛАВ0"))
        иначе:
            ген_ош(_склей3("составное присваивание не для ",
                ген.имя_типа(тип_в),
                _склей2(": ", оператор.текст)), оператор.строка)
        ген.пиши(_склей4("ПЕРВ", суф, " ", _склей3(разд, "[ДАН]", ", ПЛАВ1")))
        верни
    если _это_век(тип_в):
        элем_к *Узел = ген.век_эл(тип_в)
        под стр = _век_под(элем_к)
        ген.пиши("ИЗСТЕКА ДАН")              # адрес назначения
        ген.глуб -= 1
        если стр_равны(оператор.текст, "="):
            ген.пиши(_склей3(под, " ОКВАД[ДАН], ПЛАВ0", ""))
            верни
        # б уже в ПЛАВ0; старое значение цели — в ПЛАВ1, результат обратно
        ген.пиши(_склей3(под, " ПЛАВ1, ОКВАД[ДАН]", ""))
        оп = стр_срез(оператор.текст, 0, 1)
        ген.век_оп(оп, элем_к, "ПЛАВ1", "ПЛАВ0", оператор.строка)
        ген.пиши(_склей3(под, " ОКВАД[ДАН], ПЛАВ1", ""))
        верни
    если стр_равны(оператор.текст, "="):
        ген.пиши("ПЕР СЧТ, АКК")
        ген.пиши("ИЗСТЕКА ДАН")
        ген.глуб -= 1
        разм размер = ген.размер(тип_уз)
        если разм > 8:
            разм = 8
        если разм == 8:
            ген.пиши("ПЕР [ДАН], СЧТ")
        а если разм == 4:
            ген.пиши("ПЕР [ДАН], СЧТМ")
        а если разм == 2:
            ген.пиши("ПЕР [ДАН], СЧТП")
        иначе:
            ген.пиши("ПЕР [ДАН], СЧТБ")
        верни
    оп = стр_срез(оператор.текст, 0, 1)
    ген.пиши("ПЕР СЧТ, АКК")
    ген.пиши("ИЗСТЕКА ДАН")
    ген.глуб -= 1
    если стр_равны(оп, "+"):
        ген.пиши("ДОБ [ДАН], СЧТ")
        верни
    если стр_равны(оп, "-"):
        ген.пиши("ВЫЧ [ДАН], СЧТ")
        верни
    если стр_равны(оп, "&"):
        ген.пиши("И [ДАН], СЧТ")
        верни
    если стр_равны(оп, "|"):
        ген.пиши("ИЛИ [ДАН], СЧТ")
        верни
    если стр_равны(оп, "^"):
        ген.пиши("ИИЛИ [ДАН], СЧТ")
        верни
    если стр_равны(оп, "*"):
        ген.пиши("ПЕР АКК, [ДАН]")
        ген.пиши("УМН АКК, СЧТ")
        ген.пиши("ПЕР [ДАН], АКК")
        верни
    если стр_равны(оп, "/") или стр_равны(оп, "%"):
        ген.пиши("ПЕР АКК, [ДАН]")
        ген.пиши("ВСТЕК ДАН")
        ген.глуб += 1
        ген.пиши("РАСШ")
        ген.пиши("ДЕЛ СЧТ")
        если стр_равны(оп, "%"):
            ген.пиши("ПЕР АКК, ДАН")
        ген.пиши("ИЗСТЕКА ДАН")
        ген.глуб -= 1
        ген.пиши("ПЕР [ДАН], АКК")
        верни

# составное/простое присваивание по статическому слоту [УКК±смещ]:
# правая часть вычисляется без сохранения адреса в стеке
открыто функ (ген *Ген) присв_слот(оператор *Узел, слот стр):
    тип_уз *Узел = ген.тип_выр(оператор.а)
    ген.совместим(тип_уз, оператор.б, оператор.строка)
    ген.выр(оператор.б)
    тип_в *Узел = ген.реш_тип(тип_уз)
    если _это_вещ(тип_в):
        суф стр = _вещ_суф(тип_в)
        разд стр = _вещ_раз(тип_в)
        если стр_равны(оператор.текст, "="):
            ген.пиши(_склей4("ПЕРВ", суф, " ", _склей3(разд, слот, ", ПЛАВ0")))
            верни
        # б уже в ПЛАВ0; старое значение цели — в ПЛАВ1, результат обратно
        ген.пиши(_склей4("ПЕРВ", суф, " ПЛАВ1, ", _склей2(разд, слот)))
        оп стр = стр_срез(оператор.текст, 0, 1)
        если стр_равны(оп, "+"):
            ген.пиши(_склей3("ДОБВ", суф, " ПЛАВ1, ПЛАВ0"))
        а если стр_равны(оп, "-"):
            ген.пиши(_склей3("ВЫЧВ", суф, " ПЛАВ1, ПЛАВ0"))
        а если стр_равны(оп, "*"):
            ген.пиши(_склей3("УМНВ", суф, " ПЛАВ1, ПЛАВ0"))
        а если стр_равны(оп, "/"):
            ген.пиши(_склей3("ДЕЛВ", суф, " ПЛАВ1, ПЛАВ0"))
        иначе:
            ген_ош(_склей3("составное присваивание не для ",
                ген.имя_типа(тип_в),
                _склей2(": ", оператор.текст)), оператор.строка)
        ген.пиши(_склей4("ПЕРВ", суф, " ", _склей3(разд, слот, ", ПЛАВ1")))
        верни
    если _это_век(тип_в):
        элем_к *Узел = ген.век_эл(тип_в)
        под стр = _век_под(элем_к)
        если стр_равны(оператор.текст, "="):
            ген.пиши(_склей4(под, " ОКВАД", слот, ", ПЛАВ0"))
            верни
        ген.пиши(_склей4(под, " ПЛАВ1, ОКВАД", слот, ""))
        оп = стр_срез(оператор.текст, 0, 1)
        ген.век_оп(оп, элем_к, "ПЛАВ1", "ПЛАВ0", оператор.строка)
        ген.пиши(_склей4(под, " ОКВАД", слот, ", ПЛАВ1"))
        верни
    ген.пиши("ПЕР СЧТ, АКК")
    если стр_равны(оператор.текст, "="):
        разм размер = ген.размер(тип_уз)
        если разм > 8:
            разм = 8
        если разм == 8:
            ген.пиши(_склей3("ПЕР ", слот, ", СЧТ"))
        а если разм == 4:
            ген.пиши(_склей3("ПЕР ", слот, ", СЧТМ"))
        а если разм == 2:
            ген.пиши(_склей3("ПЕР ", слот, ", СЧТП"))
        иначе:
            ген.пиши(_склей3("ПЕР ", слот, ", СЧТБ"))
        верни
    оп = стр_срез(оператор.текст, 0, 1)
    если стр_равны(оп, "+"):
        ген.пиши(_склей3("ДОБ ", слот, ", СЧТ"))
        верни
    если стр_равны(оп, "-"):
        ген.пиши(_склей3("ВЫЧ ", слот, ", СЧТ"))
        верни
    если стр_равны(оп, "&"):
        ген.пиши(_склей3("И ", слот, ", СЧТ"))
        верни
    если стр_равны(оп, "|"):
        ген.пиши(_склей3("ИЛИ ", слот, ", СЧТ"))
        верни
    если стр_равны(оп, "^"):
        ген.пиши(_склей3("ИИЛИ ", слот, ", СЧТ"))
        верни
    если стр_равны(оп, "*"):
        ген.пиши(_склей2("ПЕР АКК, ", слот))
        ген.пиши("УМН АКК, СЧТ")
        ген.пиши(_склей3("ПЕР ", слот, ", АКК"))
        верни
    если стр_равны(оп, "/") или стр_равны(оп, "%"):
        ген.пиши(_склей2("ПЕР АКК, ", слот))
        ген.пиши("РАСШ")
        ген.пиши("ДЕЛ СЧТ")
        если стр_равны(оп, "%"):
            ген.пиши("ПЕР АКК, ДАН")
        ген.пиши(_склей3("ПЕР ", слот, ", АКК"))
        верни

# обращение операции сравнения (для перехода «условие ложно»)
открыто функ _усл_обрат(оп стр) стр:
    если стр_равны(оп, "=="):
        верни "!="
    если стр_равны(оп, "!="):
        верни "=="
    если стр_равны(оп, "<"):
        верни ">="
    если стр_равны(оп, "<="):
        верни ">"
    если стр_равны(оп, ">"):
        верни "<="
    верни "<"

# условный переход «сравнение истинно» по флагам СРАВ
открыто функ _усл_пер(оп стр, знак лог) стр:
    если стр_равны(оп, "=="):
        верни "РАВНО"
    если стр_равны(оп, "!="):
        верни "НЕРАВНО"
    если знак:
        если стр_равны(оп, "<"):
            верни "МЕНЬШЕ"
        если стр_равны(оп, "<="):
            верни "МЕНРАВ"
        если стр_равны(оп, ">"):
            верни "БОЛЬШЕ"
        верни "БОЛРАВ"
    если стр_равны(оп, "<"):
        верни "НИЖЕ"
    если стр_равны(оп, "<="):
        верни "НИЖРАВ"
    если стр_равны(оп, ">"):
        верни "ВЫШЕ"
    верни "ВЫШРАВ"

# флаги по сравнению левого операнда (АКК) с правым — для прямого jcc;
# константа справа идёт непосредственным операндом
открыто функ (ген *Ген) сравни_операнды(выр *Узел):
    пкс *Узел = ген.сверни(выр.б)
    если пкс != пусто и _в_имм32(пкс.знач):
        ген.выр(выр.а)
        ген.пиши(_склей2("СРАВ АКК, ", _цел_стр(пкс.знач как цел.верх)))
        верни
    пкл *Узел = ген.сверни(выр.а)
    если (пкл != пусто и _в_имм32(пкл.знач) и
       (стр_равны(выр.текст, "==") или стр_равны(выр.текст, "!="))):
        ген.выр(выр.б)
        ген.пиши(_склей2("СРАВ АКК, ", _цел_стр(пкл.знач как цел.верх)))
        верни
    ген.выр(выр.а)
    ген.пиши("ВСТЕК АКК")
    ген.глуб += 1
    ген.выр(выр.б)
    ген.пиши("ПЕР СЧТ, АКК")
    ген.пиши("ИЗСТЕКА АКК")
    ген.глуб -= 1
    ген.пиши("СРАВ АКК, СЧТ")

# нижняя грань диапазона: «имя >= 0» или «имя > -1»
открыто функ (ген *Ген) _это_низ(уз *Узел) лог:
    если уз == пусто или уз.вид != У_БИН или уз.а == пусто:
        верни нет
    если уз.а.вид != У_ИМЯ:
        верни нет
    если стр_равны(уз.текст, ">="):
        кн *Узел = ген.сверни(уз.б)
        верни кн != пусто и кн.знач == 0
    если стр_равны(уз.текст, ">"):
        кн2 *Узел = ген.сверни(уз.б)
        верни кн2 != пусто и (кн2.знач как цел.верх) == -1
    верни нет

# верхняя грань диапазона: «имя < K» или «имя <= K»
открыто функ _это_верх(уз *Узел) лог:
    если уз == пусто или уз.вид != У_БИН или уз.а == пусто:
        верни нет
    если уз.а.вид != У_ИМЯ:
        верни нет
    верни стр_равны(уз.текст, "<") или стр_равны(уз.текст, "<=")

# «a >= 0 и a < K» (в любом порядке половин): одна беззнаковая
# проверка — без(a) < K. K только константа: переменная могла бы
# быть отрицательной, и тогда свёртка неверна.
открыто функ (ген *Ген) усл_граница(выр *Узел, метка стр, истина лог) лог:
    низ *Узел = пусто
    верх *Узел = пусто
    если ген._это_низ(выр.а) и _это_верх(выр.б):
        низ = выр.а
        верх = выр.б
    а если ген._это_низ(выр.б) и _это_верх(выр.а):
        низ = выр.б
        верх = выр.а
    иначе:
        верни нет
    если не стр_равны(низ.а.текст, верх.а.текст):
        верни нет
    лт_г *Узел = ген.реш_тип(ген.тип_выр(низ.а))
    если _это_вещ(лт_г) или _это_век(лт_г):
        верни нет
    кв *Узел = ген.сверни(верх.б)
    если кв == пусто:
        верни нет
    кз цел.верх = кв.знач как цел.верх
    если кз < 0 или (кз == 0 и стр_равны(верх.текст, "<")):
        # a >= 0 и a < неположительное — условие всегда ложно
        если не истина:
            ген.пиши(_склей2("ПРЫГ ", метка))
        верни да
    если не _в_имм32(кв.знач):
        верни нет
    ген.выр(низ.а)
    ген.пиши(_склей2("СРАВ АКК, ", _цел_стр(кз)))
    оп_г стр = верх.текст
    если не истина:
        оп_г = _усл_обрат(оп_г)
    ген.пиши(_склей3(_усл_пер(оп_г, нет), " ", метка))
    верни да

# переход на метку, когда логическое выражение равно «истина».
# Сравнения эмитят прямой jcc по флагам СРАВ, и/или/не — короткое
# замыкание без материализации лога через УСТcc+БЕЗРАСШ+ПРОВ.
# Вещественные и векторные сравнения — общий путь (семантика NaN/масок).
открыто функ (ген *Ген) усл_прыг(выр *Узел, метка стр, истина лог):
    если выр.вид == У_УН и стр_равны(выр.текст, "не"):
        ген.усл_прыг(выр.а, метка, не истина)
        верни
    если выр.вид == У_БИН:
        оп стр = выр.текст
        если стр_равны(оп, "и"):
            если ген.усл_граница(выр, метка, истина):
                верни
            если истина:
                проп стр = ген.новая("усл_проп")
                ген.усл_прыг(выр.а, проп, нет)
                ген.усл_прыг(выр.б, метка, да)
                ген.метка(проп)
            иначе:
                ген.усл_прыг(выр.а, метка, нет)
                ген.усл_прыг(выр.б, метка, нет)
            верни
        если стр_равны(оп, "или"):
            если истина:
                ген.усл_прыг(выр.а, метка, да)
                ген.усл_прыг(выр.б, метка, да)
            иначе:
                проп = ген.новая("усл_проп")
                ген.усл_прыг(выр.а, проп, да)
                ген.усл_прыг(выр.б, метка, нет)
                ген.метка(проп)
            верни
        если _это_сравн(оп):
            лт *Узел = ген.реш_тип(ген.тип_выр(выр.а))
            пт *Узел = ген.реш_тип(ген.тип_выр(выр.б))
            если (не _это_вещ(лт) и не _это_век(лт) и
               не _это_вещ(пт) и не _это_век(пт)):
                знак лог = т_знаковый(лт) и т_знаковый(пт)
                ген.сравни_операнды(выр)
                оп2 стр = оп
                если не истина:
                    оп2 = _усл_обрат(оп)
                ген.пиши(_склей3(_усл_пер(оп2, знак), " ", метка))
                верни
    ген.выр(выр)
    ген.пиши("ПРОВ АКК, АКК")
    если истина:
        ген.пиши(_склей2("НЕРАВНО ", метка))
    иначе:
        ген.пиши(_склей2("РАВНО ", метка))

открыто функ (ген *Ген) если_(оператор *Узел):
    конец стр = ген.новая("если_конец")
    нр размер = оператор.дети.длина
    для инд в 0..нр:
        рукав *Узел = список_получи(оператор.дети, инд) как *Узел
        след стр = конец
        есть_след лог = инд + 1 < нр или оператор.дети2 != пусто
        если есть_след:
            след = ген.новая("если_след")
        ген.требуй_лог(рукав.а)
        ген.усл_прыг(рукав.а, след, нет)
        если рукав.дети != пусто:
            для инд2 в 0..рукав.дети.длина:
                ген.оп(список_получи(рукав.дети, инд2) как *Узел)
        ген.пиши(_склей2("ПРЫГ ", конец))
        если есть_след:
            ген.метка(след)
    если оператор.дети2 != пусто:
        для инд2 в 0..оператор.дети2.длина:
            ген.оп(список_получи(оператор.дети2, инд2) как *Узел)
    ген.метка(конец)

открыто функ (ген *Ген) пока_(оператор *Узел):
    нач стр = ген.новая("пока_начало")
    кон стр = ген.новая("пока_конец")
    цикл *ГЦикл = новый(ГЦикл)
    цикл.шаг = нач
    цикл.кон = кон
    список_добавь(ген.циклы, цикл как размер)
    ген.метка(нач)
    ген.требуй_лог(оператор.а)
    ген.усл_прыг(оператор.а, кон, нет)
    если оператор.дети != пусто:
        для инд в 0..оператор.дети.длина:
