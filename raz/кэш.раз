# кэш — интерфейсный кэш модулей (.рми).
# Модуль, уже собранный однажды, загружается из «<путь>.<цель>.рми» без
# повторного разбора и генерации: кэш хранит интерфейс (записи, константы,
# синонимы, перечисления, сигнатуры функций и методов, импорты), готовый
# фрагмент кода/данных ИСКРЫ и контрольные сведения. Источник всё равно
# читается — для хеша инвалидации. Кэш действителен, если совпали версия
# формата, цель, режим безопасности, режим памяти, хеш источника и хеши
# всех зависимостей модуля.

взять основа
взять узлы

открыто конст РМИ_ВЕРСИЯ = 1

# запись о зависимости модуля: владелец взял имя → файл путь с хешем
открыто запись КЗавис:
    владелец стр            # норм-путь модуля-владельца
    имя стр                 # точечное имя из «взять»
    путь стр                # норм-путь файла зависимости
    хеш нат.верх            # хеш источника зависимости на момент сборки

# норм-путь модуля → хеш его источника
открыто запись КХеш:
    мод стр
    хеш нат.верх

# загруженный из .рми модуль
открыто запись КэшМодуль:
    мод стр                 # норм-путь модуля
    хеш нат.верх            # хеш его источника
    нужны нат.верх          # дельта битов нужны_стд
    главная нат.верх        # модуль содержит «главная»
    зависим *Список         # КЗавис
    интерфейс *Список       # стр — строки интерфейсных записей
    код стр                 # готовый фрагмент кода ИСКРЫ
    данные стр              # готовый фрагмент данных ИСКРЫ

открыто функ хеш_текста(текст стр) нат.верх:
    # djb2 по байтам: детерминированный хеш для инвалидации кэша
    хеш нат.верх = 5381
    для поз в 0..текст.длина:
        хеш = хеш * 33 + текст.данные[поз] как нат.верх
    верни хеш

открыто функ рми_путь(путь_раз стр, суффикс стр) стр:
    # «биб/стр.раз» → «биб/стр.windows.рми» (суффикс «.раз» — 7 байт UTF-8)
    база стр = путь_раз
    если база.длина > 7 и стр_равны(стр_срез(база, база.длина - 7, база.длина), ".раз"):
        база = стр_срез(база, 0, база.длина - 7)
    верни стр_склей(стр_склей(стр_склей(база, "."), суффикс), ".рми")

открыто функ _строки(текст стр) *Список:
    # разрезать текст на строки по '\n' (хвостовой '\r' снимается)
    строки *Список = список_новый()
    нач размер = 0
    поз размер = 0
    пока поз <= текст.длина:
        если поз == текст.длина или текст.данные[поз] == 10:
            кон размер = поз
            если кон > нач и текст.данные[кон - 1] == 13:
                кон = кон - 1
            список_добавь(строки, стр_срез(текст, нач, кон) как размер)
            нач = поз + 1
        поз += 1
    верни строки

открыто функ _слова(строка стр) *Список:
    # разрезать строку на слова по пробелам и табуляциям
    слова *Список = список_новый()
    поз размер = 0
    пока поз < строка.длина:
        пока поз < строка.длина и (строка.данные[поз] == 32 или строка.данные[поз] == 9):
            поз += 1
        если поз >= строка.длина:
            хватит
        кон размер = поз
        пока кон < строка.длина и строка.данные[кон] != 32 и строка.данные[кон] != 9:
            кон += 1
        список_добавь(слова, стр_срез(строка, поз, кон) как размер)
        поз = кон
    верни слова

открыто функ _секции(строки *Список, с размер, по размер) стр:
    # собрать строки секции обратно в текст с '\n' на конце каждой строки
    буф *Буфер = буф_новый()
    для инд в с..по:
        буф_добавь(буф, список_получи(строки, инд) как стр)
        буф_сим(буф, 10)
    верни буф_стр(буф)

открыто функ рми_прочти(путь_рми стр, мод стр, суффикс стр, режим нат.верх,
                        память нат.верх, опт нат.верх, хеш нат.верх) *КэшМодуль:
    # загрузить и проверить .рми; пусто — кэш отсутствует или недействителен
    текст стр = файл_прочти(путь_рми)
    если текст == пусто:
        верни пусто как *КэшМодуль
    строки *Список = _строки(текст)
    если строки.длина < 6:
        верни пусто как *КэшМодуль
    км *КэшМодуль = новый(КэшМодуль)
    км.мод = мод
    км.хеш = хеш
    км.нужны = 0
    км.главная = 0
    км.зависим = список_новый()
    км.интерфейс = список_новый()
    км.код = ""
    км.данные = ""
    секция нат.верх = 0    # 0=шапка 1=интерфейс 2=код 3=данные
    инд размер = 0
    код_с размер = 0
    дан_с размер = 0
    дан_по размер = 0
    пока инд < строки.длина:
        строка стр = список_получи(строки, инд) как стр
        если стр_равны(строка, "интерфейс"):
            секция = 1
            инд += 1
            следующий
        если стр_равны(строка, "код"):
            секция = 2
            код_с = инд + 1
            инд += 1
            следующий
        если стр_равны(строка, "данные"):
            если секция == 2:
                км.код = _секции(строки, код_с, инд)
            секция = 3
            дан_с = инд + 1
            инд += 1
            следующий
        если стр_равны(строка, "конец"):
            если секция == 3:
                дан_по = инд
                км.данные = _секции(строки, дан_с, дан_по)
            секция = 0
            инд += 1
            хватит
        если секция == 0:
            слова *Список = _слова(строка)
            если слова.длина == 0:
                инд += 1
                следующий
            глава стр = список_получи(слова, 0) как стр
            если стр_равны(глава, ";РМИ"):
                если слова.длина < 2 или стр_число(список_получи(слова, 1) как стр) != РМИ_ВЕРСИЯ:
                    верни пусто как *КэшМодуль
            а если стр_равны(глава, ";цель"):
                если слова.длина < 2 или не стр_равны(список_получи(слова, 1) как стр, суффикс):
                    верни пусто как *КэшМодуль
            а если стр_равны(глава, ";режим"):
                хочет стр = "надёжно"
                если режим == 0:
                    хочет = "быстро"
                если слова.длина < 2 или не стр_равны(список_получи(слова, 1) как стр, хочет):
                    верни пусто как *КэшМодуль
            а если стр_равны(глава, ";память"):
                хочет = "обычно"
                если память == 1:
                    хочет = "проверка"
                если слова.длина < 2 или не стр_равны(список_получи(слова, 1) как стр, хочет):
                    верни пусто как *КэшМодуль
            а если стр_равны(глава, ";опт"):
                если слова.длина < 2 или стр_число(список_получи(слова, 1) как стр) != опт:
                    верни пусто как *КэшМодуль
            а если стр_равны(глава, "модуль"):
                если слова.длина < 2 или не стр_равны(список_получи(слова, 1) как стр, мод):
                    верни пусто как *КэшМодуль
            а если стр_равны(глава, "хеш"):
                если слова.длина < 2 или (стр_число(список_получи(слова, 1) как стр) как нат.верх) != хеш:
                    верни пусто как *КэшМодуль
            а если стр_равны(глава, "нужны"):
                если слова.длина > 1:
                    км.нужны = стр_число(список_получи(слова, 1) как стр) как нат.верх
            а если стр_равны(глава, "главная"):
                если слова.длина > 1:
                    км.главная = стр_число(список_получи(слова, 1) как стр) как нат.верх
            а если стр_равны(глава, "взято"):
                если слова.длина > 3:
                    зав *КЗавис = новый(КЗавис)
                    зав.владелец = мод
                    зав.имя = список_получи(слова, 1) как стр
                    зав.путь = список_получи(слова, 2) как стр
                    зав.хеш = стр_число(список_получи(слова, 3) как стр) как нат.верх
                    список_добавь(км.зависим, зав как размер)
            инд += 1
            следующий
        а если секция == 1:
            если строка.длина > 0:
                список_добавь(км.интерфейс, строка как размер)
            инд += 1
            следующий
        иначе:
            # секции код/данные читаются сплошняком до маркера — пропускаем
            инд += 1
    верни км

открыто функ рми_собери(мод стр, суффикс стр, режим нат.верх, память нат.верх,
                        опт нат.верх, хеш нат.верх, нужны нат.верх,
                        главная нат.верх, зависим *Список, интерфейс *Список,
                        код стр, данные стр) стр:
    # собрать текст .рми из частей (интерфейсные строки готовит ген)
    буф *Буфер = буф_новый()
    буф_добавь(буф, ";РМИ 1\n;цель ")
    буф_добавь(буф, суффикс)
    буф_добавь(буф, "\n;режим ")
    если режим == 0:
        буф_добавь(буф, "быстро")
    иначе:
        буф_добавь(буф, "надёжно")
    буф_добавь(буф, "\n;память ")
    если память == 1:
        буф_добавь(буф, "проверка")
    иначе:
        буф_добавь(буф, "обычно")
    буф_добавь(буф, "\n;опт ")
    буф_добавь(буф, без_в_стр(опт))
    буф_добавь(буф, "\nмодуль ")
    буф_добавь(буф, мод)
    буф_добавь(буф, "\nхеш ")
    буф_добавь(буф, без_в_стр(хеш))
    буф_добавь(буф, "\nнужны ")
    буф_добавь(буф, без_в_стр(нужны))
    буф_добавь(буф, "\nглавная ")
    буф_добавь(буф, без_в_стр(главная))
    буф_сим(буф, 10)
    для инд в 0..зависим.длина:
        зав *КЗавис = список_получи(зависим, инд) как *КЗавис
        буф_добавь(буф, "взято ")
        буф_добавь(буф, зав.имя)
        буф_добавь(буф, " ")
        буф_добавь(буф, зав.путь)
        буф_добавь(буф, " ")
        буф_добавь(буф, без_в_стр(зав.хеш))
        буф_сим(буф, 10)
    буф_добавь(буф, "интерфейс\n")
    для инд в 0..интерфейс.длина:
        буф_добавь(буф, список_получи(интерфейс, инд) как стр)
        буф_сим(буф, 10)
    буф_добавь(буф, "код\n")
    буф_добавь(буф, код)
    буф_добавь(буф, "данные\n")
    буф_добавь(буф, данные)
    буф_добавь(буф, "конец\n")
    верни буф_стр(буф)
