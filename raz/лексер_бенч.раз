# лексер_бенч — замер скорости токенизатора: читает stdin, токенизирует,
# печатает только счётчики (вывод не замыливает замер).
взять основа
взять лексер

функ главная() цел.верх:
    исх := ввод()
    токи *Список = токенизируй(исх)
    печать("байт: ")
    печатьцел(исх.длина как цел.верх)
    печать("  токенов: ")
    печатьцел(токи.длина как цел.верх)
    печатьстр("")
    верни 0
