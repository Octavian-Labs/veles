# лексер_тест — проверка токенизатора на РАЗУМЕ: читает исходник из stdin,
# печатает виды и тексты токенов. Временный файл, не часть компилятора.
взять основа
взять лексер

функ главная() цел64:
    исх := ввод()
    токи *Список = токенизируй(исх)
    для i в 0..токи.длина:
        т *Токен = список_получи(токи, i) как *Токен
        печатьцел(т.вид как цел64)
        печать(":")
        печатьцел(т.знач как цел64)
        печать(":")
        если т.текст == пусто:
            печатьстр("-")
        иначе:
            печатьстр(т.текст)
    верни 0
