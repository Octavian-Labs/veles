# лексер_тест — проверка токенизатора на РАЗУМЕ: читает исходник из stdin,
# печатает виды и тексты токенов. Временный файл, не часть компилятора.
взять основа
взять лексер

функ главная() цел.верх:
    исх стр = ввод()
    токи *Список = токенизируй(исх)
    для инд в 0..токи.длина:
        т *Токен = список_получи(токи, инд) как *Токен
        печатьцел(т.вид как цел.верх)
        печать(":")
        печатьцел(т.знач как цел.верх)
        печать(":")
        если т.текст == пусто:
            печатьстр("-")
        иначе:
            печатьстр(т.текст)
    верни 0
