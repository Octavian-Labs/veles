# разум — самораскрутка: компилятор РАЗУМА, написанный на РАЗУМЕ.
# Использование: разум.exe [-O0|-O1] [--цель windows|linux|macos]
#   [--режим надёжно|быстро] < исход.раз > выход.иск
#   (cwd = каталог исходника или корень проекта — модули «взять»
#   ищутся в ./ и ../биб/).
#   -O0 — без оптимизаций; -O1 — пипхол (по умолчанию).
#   --цель linux|macos — выдаёт .иск с соответствующей прагмой для искры.
#   --режим — ось безопасности: надёжно (по умолчанию) | быстро;
#   независима от -O0/-O1. Неизвестное значение — ошибка компилятора.
#   --память — ось учёта памяти: обычно (по умолчанию) | проверка;
#   проверка ведёт таблицу выделений, огранки, карантин и отчёт об утечках.
#   --файл путь — виртуальный путь stdin-исходника в диагностике
#   (для редакторов; умолчание «./стdin.раз»).
#   разум скрипт.раз [аргументы...] — режим запуска: компилирует файл
#   и сразу исполняет (сборка во временные _запуск.*, код выхода —
#   код скрипта). Слова после пути скрипта идут в argv ребёнка.

взять основа
взять лексер, узлы, парсер, ген, загрузчик
взять процесс

функ _слово_с(текст стр, поз размер) стр:
    # слово из позиции поз: пропуск пробелов/табов, затем до разделителя
    пока поз < текст.длина и (текст.данные[поз] == 32 или текст.данные[поз] == 9):
        поз += 1
    кон размер = поз
    пока кон < текст.длина и текст.данные[кон] != 32 и текст.данные[кон] != 9:
        кон += 1
    верни стр_срез(текст, поз, кон)

функ главная() цел.верх:
    опт нат.верх = 1
    цель нат.верх = 0 как нат.верх
    режим нат.верх = 1               # 1=надёжно (умолчание), 0=быстро
    пам нат.верх = 0                 # 0=обычно (умолчание), 1=проверка
    кэш лог = да                     # интерфейсный кэш .рми (умолчание вкл)
    арг стр = аргументы()
    если арг != пусто:
        если стр_найди(арг, "-O0") >= 0 или стр_найди(арг, "-О0") >= 0:
            опт = 0
        если стр_найди(арг, "linux") >= 0:
            цель = 1
        если стр_найди(арг, "macos") >= 0:
            цель = 2
        поз_р смещение = стр_найди(арг, "--режим")
        если поз_р >= 0:
            знач стр = _слово_с(арг, (поз_р + 12) как размер)
            если стр_равны(знач, "надёжно"):
                режим = 1
            а если стр_равны(знач, "быстро"):
                режим = 0
            иначе:
                печать("разум: неизвестный режим «")
                печать(знач)
                печатьстр("» — ожидается надёжно или быстро")
                верни 2
        поз_п смещение = стр_найди(арг, "--память")
        если поз_п >= 0:
            знач = _слово_с(арг, (поз_п + 14) как размер)
            если стр_равны(знач, "обычно"):
                пам = 0
            а если стр_равны(знач, "проверка"):
                пам = 1
            иначе:
                печать("разум: неизвестная память «")
                печать(знач)
                печатьстр("» — ожидается обычно или проверка")
                верни 2
        поз_к смещение = стр_найди(арг, "--кэш")
        если поз_к >= 0:
            знач = _слово_с(арг, (поз_к + 8) как размер)
            если стр_равны(знач, "вкл"):
                кэш = да
            а если стр_равны(знач, "выкл"):
                кэш = нет
            иначе:
                печать("разум: неизвестный кэш «")
                печать(знач)
                печатьстр("» — ожидается вкл или выкл")
                верни 2
    вирт стр = "./стdin.раз"
    скрипт стр = ""
    арг_дет стр = ""
    если арг != пусто:
        поз_ф смещение = стр_найди(арг, "--файл")
        если поз_ф >= 0:
            вирт = _слово_с(арг, (поз_ф + 10) как размер)
        иначе:
            # режим запуска: первое слово с «.раз» — путь скрипта,
            # хвост строки — аргументы ребёнка
            поз_с смещение = стр_найди(арг, ".раз")
            если поз_с >= 0:
                # конец слова скрипта — ближайший пробел после «.раз»
                # (в UTF-8 «.раз» занимает 7 байт, длину не считаем)
                кон размер = поз_с как размер
                пока кон < арг.длина и арг.данные[кон] != ' ':
                    кон += 1
                нач размер = 0
                для и в 0..(поз_с как цел.верх):
                    если арг.данные[и] == ' ':
                        нач = (и + 1) как размер
                скрипт = стр_срез(арг, нач, кон)
                пока кон < арг.длина и арг.данные[кон] == ' ':
                    кон += 1
                арг_дет = стр_срез(арг, кон, арг.длина)
    исх стр = ""
    если скрипт.длина > 0:
        исх = файл_прочти(скрипт)
        вирт = скрипт
        если исх == пусто:
            печать("разум: скрипт не читается — ")
            печатьстр(скрипт)
            верни 2
    иначе:
        исх = ввод()
    суффикс стр = "windows"
    если цель == 1:
        суффикс = "linux"
    а если цель == 2:
        суффикс = "macos"
    загр *Загр = загр_новый(суффикс, кэш, режим, пам, опт)
    прог *Узел = загр.загрузи_текст(вирт, исх)
    ген *Ген = ген_новый(цель, опт как нат.верх, режим, пам)
    ген.кэш_вкл = кэш
    ген.корень = загр.корень
    ген.хеши = загр.хеши
    ген.зависим = загр.зависим
    вых_иск стр = ген.генерируй(прог)
    если скрипт.длина == 0:
        печать(вых_иск)
        верни 0

    # режим запуска: _запуск.иск -> искра -> _запуск.exe -> прогон
    если не файл_запиши("_запуск.иск", вых_иск):
        печатьстр("разум: _запуск.иск не записан")
        верни 2
    искра_путь стр = "искра.exe"
    если файл_прочти(искра_путь) == пусто:
        искра_путь = "../искра.exe"
        если файл_прочти(искра_путь) == пусто:
            искра_путь = "искра"
    код цел.верх = запусти(искра_путь, "", "_запуск.иск", "_запуск.exe")
    если код != 0:
        печать("разум: искра завершилась с кодом ")
        печатьстр(цел_в_стр(код))
        верни код
    исполняемый("_запуск.exe")
    если не файл_запиши("_запуск_вход.txt", ""):
        верни 2
    код = запусти("./_запуск.exe", арг_дет, "_запуск_вход.txt",
                  "_запуск_вых.txt")
    если код < 0:
        печатьстр("разум: _запуск.exe не запустился")
        верни 2
    вых стр = файл_прочти("_запуск_вых.txt")
    если вых != пусто и вых.длина > 0:
        печать(вых)
    файл_удали("_запуск.иск")
    файл_удали("_запуск.exe")
    файл_удали("_запуск_вход.txt")
    файл_удали("_запуск_вых.txt")
    верни код
