# лексер — токенизация исходника РАЗУМА (версия на самом РАЗУМЕ).
# Часть самораскрутки ВЕЛЕС: raz/ — компилятор РАЗУМА, пишется на РАЗУМЕ.
# Виды токенов: ИМЯ, ЧИСЛО, СТР, ОП,
# НС, ОТСТУП, СНЯТИЕ, КФ. Комментарии '#' и ';' до конца строки.

взять основа, буфер

конст ТК_ИМЯ = 1
конст ТК_ЧИСЛО = 2
конст ТК_СТР = 3
конст ТК_ОП = 4
конст ТК_НС = 5
конст ТК_ОТСТУП = 6
конст ТК_СНЯТИЕ = 7
конст ТК_КФ = 8

запись Токен:
    вид нат.верх
    текст стр        # ИМЯ/СТР/ОП; для остальных — пусто
    знач нат.верх       # ЧИСЛО
    строка размер
    столб размер      # байтовая позиция в строке, 1-начало (0 = нет)

запись Лексер:
    исх стр
    токи *Список
    отступы *Список

функ _тк(вид нат.верх, текст стр, знач нат.верх, строка размер,
         столб размер) *Токен:
    ток *Токен = новый(Токен)
    ток.вид = вид
    ток.текст = текст
    ток.знач = знач
    ток.строка = строка
    ток.столб = столб
    верни ток

функ _ош(текст стр, строка размер, столб размер):
    печать("разум.лексер: строка ")
    печатьцел(строка как цел.верх)
    если столб > 0:
        печать(":")
        печатьцел(столб как цел.верх)
    печать(": ")
    печатьстр(текст)
    выход(1)

функ _имя_нач(байт нат.старт) лог:
    # буква (латиница/кириллица в UTF-8) или подчёркивание
    верни это_буква(байт) или байт == '_'

функ _имя_часть(байт нат.старт) лог:
    верни это_буква(байт) или это_цифра(байт) или байт == '_'

функ _цифра16(байт нат.старт) смещение:
    # значение hex-цифры или -1
    если байт >= '0' и байт <= '9':
        верни (байт - '0') как цел.верх
    если байт >= 'a' и байт <= 'f':
        верни (байт - 'a' + 10) как цел.верх
    если байт >= 'A' и байт <= 'F':
        верни (байт - 'A' + 10) как цел.верх
    верни -1

функ _число(текст стр, строка размер, столб размер) нат.верх:
    # разбор числа: 0x/0b/0o/десятичный, '_' — разделитель
    поз размер = 0
    база нат.верх = 10
    если текст.длина > 2 и текст.данные[0] == '0':
        преф нат.старт = текст.данные[1]
        если преф == 'x' или преф == 'X':
            база = 16
            поз = 2
        а если преф == 'b' или преф == 'B':
            база = 2
            поз = 2
        а если преф == 'o' или преф == 'O':
            база = 8
            поз = 2
    итог нат.верх = 0
    пока поз < текст.длина:
        байт нат.старт = текст.данные[поз]
        если байт != '_':
            цифра смещение = _цифра16(байт)
            если цифра < 0 или (цифра как нат.верх) >= база:
                _ош("неверное число", строка, столб)
            итог = итог * база + (цифра как нат.верх)
        поз += 1
    верни итог

функ _экран(буф *Буфер, исх стр, смещ размер, конец размер, строка размер,
            столб размер) нат.верх:
    # обрабатывает \x: добавляет байт в буфер, возвращает новую позицию
    если смещ + 1 >= конец:
        _ош("оборванная экранизация", строка, столб)
    след_зн нат.старт = исх.данные[смещ + 1]
    если след_зн == 'n':
        буф_сим(буф, 10)
        верни смещ + 2
    если след_зн == 'r':
        буф_сим(буф, 13)
        верни смещ + 2
    если след_зн == 't':
        буф_сим(буф, 9)
        верни смещ + 2
    если след_зн == '0':
        буф_сим(буф, 0)
        верни смещ + 2
    если след_зн == '\\' или след_зн == '"' или след_зн == 39:
        буф_сим(буф, след_зн)
        верни смещ + 2
    если след_зн == 'x' и смещ + 3 < конец:
        старш смещение = _цифра16(исх.данные[смещ + 2])
        младш смещение = _цифра16(исх.данные[смещ + 3])
        если старш < 0 или младш < 0:
            _ош("неверный \\x экран", строка, столб)
        буф_сим(буф, (старш * 16 + младш) как нат.старт)
        верни смещ + 4
    _ош("неизвестная экранизация", строка, столб)
    верни смещ + 1

функ _утф8_код(байты *нат.старт, длина размер) цел.верх:
    # декодирует один кодпоинт UTF-8; -1 при неверной длине/форме
    если длина == 0 или длина > 4:
        верни -1
    байт0 нат.верх = байты[0] как нат.верх
    если длина == 1:
        если байт0 >= 0x80:
            верни -1
        верни байт0 как цел.верх
    если длина == 2:
        если байт0 < 0xC0 или байт0 >= 0xE0:
            верни -1
        верни (((байт0 & 0x1F) << 6) | ((байты[1] как нат.верх) & 0x3F)) как цел.верх
    если длина == 3:
        если байт0 < 0xE0 или байт0 >= 0xF0:
            верни -1
        верни (((байт0 & 0x0F) << 12) | (((байты[1] как нат.верх) & 0x3F) << 6) |
               ((байты[2] как нат.верх) & 0x3F)) как цел.верх
    если байт0 < 0xF0:
        верни -1
    верни (((байт0 & 0x07) << 18) | (((байты[1] как нат.верх) & 0x3F) << 12) |
           (((байты[2] как нат.верх) & 0x3F) << 6) | ((байты[3] как нат.верх) & 0x3F)) как цел.верх

функ _строка_лит(лекс *Лексер, исх стр, смещ размер, конец размер,
                 кав нат.старт, строка размер, столб размер) нат.верх:
    # читает строковый/символьный литерал, возвращает позицию за кавычкой
    буф *Буфер = буф_новый()
    поз размер = смещ
    пока поз < конец и исх.данные[поз] != кав:
        если исх.данные[поз] == '\\':
            поз = _экран(буф, исх, поз, конец, строка, столб + поз - смещ + 1)
        иначе:
            буф_сим(буф, исх.данные[поз])
            поз += 1
    если поз >= конец:
        _ош("незакрытый литерал", строка, столб)
    если кав == 39:
        # символьный литерал — ровно один кодпоинт UTF-8 (1..4 байта)
        код_симв цел.верх = _утф8_код(буф.данные, буф.длина)
        если код_симв < 0:
            _ош("символьный литерал — ровно один символ", строка, столб)
        список_добавь(лекс.токи,
            _тк(ТК_ЧИСЛО, пусто как стр, код_симв как нат.верх,
                строка, столб) как размер)
    иначе:
        список_добавь(лекс.токи,
            _тк(ТК_СТР, буф_стр(буф), 0, строка, столб) как размер)
    буф_свободен(буф)
    верни поз + 1

функ _оп3(байт0 нат.старт, байт1 нат.старт, байт2 нат.старт) нат.верх:
    # трёхсимвольный оператор: '..=' '<<=' '>>=' — иначе 0
    если байт0 == '.' и байт1 == '.' и байт2 == '=':
        верни 3
    если (байт0 == '<' или байт0 == '>') и байт0 == байт1 и байт2 == '=':
        верни 3
    верни 0

функ _оп2(байт0 нат.старт, байт1 нат.старт) нат.верх:
    # двухсимвольный оператор — иначе 0
    если байт0 == '.' и байт1 == '.':
        верни 2
    если байт1 == '=' и (байт0 == ':' или байт0 == '=' или байт0 == '!' или
                      байт0 == '<' или байт0 == '>' или байт0 == '+' или
                      байт0 == '-' или байт0 == '*' или байт0 == '/' или
                      байт0 == '%' или байт0 == '&' или байт0 == '|' или байт0 == '^'):
        верни 2
    если байт0 == '<' и байт1 == '<':
        верни 2
    если байт0 == '>' и байт1 == '>':
        верни 2
    верни 0

функ _байт(исх стр, поз размер, кон размер) нат.старт:
    если поз < кон:
        верни исх.данные[поз]
    верни 0

функ _один_оп(байт нат.старт) лог:
    верни (байт == '+' или байт == '-' или байт == '*' или байт == '/' или байт == '%' или
           байт == '<' или байт == '>' или байт == '=' или байт == '(' или байт == ')' или
           байт == '[' или байт == ']' или байт == '{' или байт == '}' или байт == ',' или
           байт == '.' или байт == ':' или байт == '&' или байт == '|' или байт == '^' или
           байт == '!')

функ _стек_верх(лекс *Лексер) нат.верх:
    верни список_получи(лекс.отступы, лекс.отступы.длина - 1)

функ _токи_строки(лекс *Лексер, исх стр, нач размер, кон размер,
                  строка размер, сдвиг размер) цел.верх:
    # токены одной строки [нач..кон); возвращает дельту глубины скобок
    глубина цел.верх = 0
    поз размер = нач

    пока поз < кон:
        зн нат.старт = исх.данные[поз]
        если зн == ' ':
            поз += 1
            следующий
        если это_цифра(зн):
            край размер = поз
            пока край < кон и (_имя_часть(исх.данные[край]) или
                            исх.данные[край] == '_'):
                край += 1
            текст стр = стр_срез(исх, поз, край)
            список_добавь(лекс.токи,
                _тк(ТК_ЧИСЛО, текст, _число(текст, строка, поз - нач + сдвиг + 1),
                    строка, поз - нач + сдвиг + 1) как размер)
            поз = край
            следующий
        если зн == '"' или зн == 39:
            поз = _строка_лит(лекс, исх, поз + 1, кон, зн, строка, поз - нач + сдвиг + 1)
            следующий
        если _имя_нач(зн):
            край = поз
            пока край < кон и _имя_часть(исх.данные[край]):
                край += 1
            список_добавь(лекс.токи,
                _тк(ТК_ИМЯ, стр_срез(исх, поз, край), 0, строка,
                    поз - нач + сдвиг + 1) как размер)
            поз = край
            следующий
        нужно3 нат.верх = _оп3(зн, _байт(исх, поз + 1, кон), _байт(исх, поз + 2, кон))
        если нужно3 == 3:
            список_добавь(лекс.токи,
                _тк(ТК_ОП, стр_срез(исх, поз, поз + 3), 0, строка,
                    поз - нач + сдвиг + 1) как размер)
            поз += 3
            следующий
        нужно2 нат.верх = _оп2(зн, _байт(исх, поз + 1, кон))
        если нужно2 == 2:
            список_добавь(лекс.токи,
                _тк(ТК_ОП, стр_срез(исх, поз, поз + 2), 0, строка,
                    поз - нач + сдвиг + 1) как размер)
            поз += 2
            следующий
        если _один_оп(зн):
            если зн == '(' или зн == '[' или зн == '{':
                глубина += 1
            если зн == ')' или зн == ']' или зн == '}':
                глубина -= 1
            список_добавь(лекс.токи,
                _тк(ТК_ОП, стр_срез(исх, поз, поз + 1), 0, строка,
                    поз - нач + сдвиг + 1) как размер)
            поз += 1
            следующий
        _ош("неожиданный символ", строка, поз - нач + сдвиг + 1)
    верни глубина

функ токенизируй(исх стр) *Список:
    # разбирает исходник построчно; возвращает список *Токен
    лекс *Лексер = новый(Лексер)
    лекс.исх = исх
    лекс.токи = список_новый()
    лекс.отступы = список_новый()
    список_добавь(лекс.отступы, 0)
    глубина цел.верх = 0
    строка размер = 1
    нач размер = 0
    поз размер = 0
    пока поз <= исх.длина:
        если поз == исх.длина или исх.данные[поз] == 10:
            кон размер = поз
            если кон > нач и исх.данные[кон - 1] == 13:
                кон -= 1
            # обрезка комментария: '#' или ';' вне строк
            поз2 размер = нач
            пока поз2 < кон:
                зн нат.старт = исх.данные[поз2]
                если зн == '"' или зн == 39:
                    поз2 += 1
                    пока поз2 < кон и исх.данные[поз2] != зн:
                        если исх.данные[поз2] == '\\':
                            поз2 += 1
                        поз2 += 1
                а если зн == '#' или зн == ';':
                    кон = поз2
                поз2 += 1
            # пустая строка?
            пустая лог = да
            поз2 = нач
            пока поз2 < кон:
                если исх.данные[поз2] != ' ':
                    пустая = нет
                поз2 += 1
            если не пустая:
                # отступ
                колво размер = 0
                поз2 = нач
                пока поз2 < кон и исх.данные[поз2] == ' ':
                    колво += 1
                    поз2 += 1
                если поз2 < кон и исх.данные[поз2] == 9:
                    _ош("табуляция в отступе — используйте пробелы", строка, колво + 1)
                если глубина == 0:
                    верх размер = _стек_верх(лекс)
                    если колво > верх:
                        список_добавь(лекс.отступы, колво)
                        список_добавь(лекс.токи,
                            _тк(ТК_ОТСТУП, пусто как стр, колво,
                                строка, колво + 1) как размер)
                    иначе:
                        пока колво < _стек_верх(лекс):
                            лекс.отступы.длина -= 1
                            список_добавь(лекс.токи,
                                _тк(ТК_СНЯТИЕ, пусто как стр, колво,
                                    строка, колво + 1) как размер)
                        если колво != _стек_верх(лекс):
                            _ош("неконсистентный отступ", строка, колво + 1)
                глубина += _токи_строки(лекс, исх, нач + колво, кон, строка, колво)
                если глубина == 0:
                    список_добавь(лекс.токи,
                        _тк(ТК_НС, пусто как стр, 0, строка,
                            кон - нач + 1) как размер)
            нач = поз + 1
            строка += 1
        поз += 1
    список_добавь(лекс.токи, _тк(ТК_НС, пусто как стр, 0, строка, 0) как размер)
    пока лекс.отступы.длина > 1:
        лекс.отступы.длина -= 1
        список_добавь(лекс.токи,
            _тк(ТК_СНЯТИЕ, пусто как стр, 0, строка, 0) как размер)
    список_добавь(лекс.токи, _тк(ТК_КФ, пусто как стр, 0, строка, 0) как размер)
    верни лекс.токи
