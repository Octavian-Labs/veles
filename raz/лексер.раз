# лексер — токенизация исходника РАЗУМА (версия на самом РАЗУМЕ).
# Часть самораскрутки ВЕЛЕС: raz/ — компилятор РАЗУМА, пишется на РАЗУМЕ.
# Виды токенов: ИМЯ, ЧИСЛО, СТР, ОП,
# НС, ОТСТУП, СНЯТИЕ, КФ. Комментарии '#' и ';' до конца строки.

взять основа, буфер

конст ТК_ИМЯ = 1
конст ТК_ЧИСЛО = 2
конст ТК_СТР = 3
конст ТК_ОП = 4
конст ТК_НС = 5
конст ТК_ОТСТУП = 6
конст ТК_СНЯТИЕ = 7
конст ТК_КФ = 8

запись Токен:
    вид нат.верх
    текст стр        # ИМЯ/СТР/ОП; для остальных — пусто
    знач нат.верх       # ЧИСЛО
    строка нат.верх
    столб нат.верх      # байтовая позиция в строке, 1-начало (0 = нет)

запись Лексер:
    исх стр
    токи *Список
    отступы *Список

функ _тк(вид нат.верх, текст стр, знач нат.верх, строка нат.верх,
         столб нат.верх) *Токен:
    т *Токен = новый(Токен)
    т.вид = вид
    т.текст = текст
    т.знач = знач
    т.строка = строка
    т.столб = столб
    верни т

функ _ош(текст стр, строка нат.верх, столб нат.верх):
    печать("разум.лексер: строка ")
    печатьцел(строка как цел.верх)
    если столб > 0:
        печать(":")
        печатьцел(столб как цел.верх)
    печать(": ")
    печатьстр(текст)
    выход(1)

функ _имя_нач(б нат.старт) лог:
    # буква (латиница/кириллица в UTF-8) или подчёркивание
    верни это_буква(б) или б == '_'

функ _имя_часть(б нат.старт) лог:
    верни это_буква(б) или это_цифра(б) или б == '_'

функ _цифра16(б нат.старт) цел.верх:
    # значение hex-цифры или -1
    если б >= '0' и б <= '9':
        верни (б - '0') как цел.верх
    если б >= 'a' и б <= 'f':
        верни (б - 'a' + 10) как цел.верх
    если б >= 'A' и б <= 'F':
        верни (б - 'A' + 10) как цел.верх
    верни -1

функ _число(текст стр, строка нат.верх, столб нат.верх) нат.верх:
    # разбор числа: 0x/0b/0o/десятичный, '_' — разделитель
    поз нат.верх = 0
    база нат.верх = 10
    если текст.длина > 2 и текст.данные[0] == '0':
        в нат.старт = текст.данные[1]
        если в == 'x' или в == 'X':
            база = 16
            поз = 2
        а если в == 'b' или в == 'B':
            база = 2
            поз = 2
        а если в == 'o' или в == 'O':
            база = 8
            поз = 2
    ч нат.верх = 0
    пока поз < текст.длина:
        б нат.старт = текст.данные[поз]
        если б != '_':
            ц цел.верх = _цифра16(б)
            если ц < 0 или (ц как нат.верх) >= база:
                _ош("неверное число", строка, столб)
            ч = ч * база + (ц как нат.верх)
        поз += 1
    верни ч

функ _экран(б *Буфер, исх стр, k нат.верх, конец нат.верх, строка нат.верх,
            столб нат.верх) нат.верх:
    # обрабатывает \x: добавляет байт в буфер, возвращает новую позицию
    если k + 1 >= конец:
        _ош("оборванная экранизация", строка, столб)
    e нат.старт = исх.данные[k + 1]
    если e == 'n':
        буф_сим(б, 10)
        верни k + 2
    если e == 'r':
        буф_сим(б, 13)
        верни k + 2
    если e == 't':
        буф_сим(б, 9)
        верни k + 2
    если e == '0':
        буф_сим(б, 0)
        верни k + 2
    если e == '\\' или e == '"' или e == 39:
        буф_сим(б, e)
        верни k + 2
    если e == 'x' и k + 3 < конец:
        ст цел.верх = _цифра16(исх.данные[k + 2])
        мл цел.верх = _цифра16(исх.данные[k + 3])
        если ст < 0 или мл < 0:
            _ош("неверный \\x экран", строка, столб)
        буф_сим(б, (ст * 16 + мл) как нат.старт)
        верни k + 4
    _ош("неизвестная экранизация", строка, столб)
    верни k + 1

функ _утф8_код(д *нат.старт, дл нат.верх) цел.верх:
    # декодирует один кодпоинт UTF-8; -1 при неверной длине/форме
    если дл == 0 или дл > 4:
        верни -1
    б0 нат.верх = д[0] как нат.верх
    если дл == 1:
        если б0 >= 0x80:
            верни -1
        верни б0 как цел.верх
    если дл == 2:
        если б0 < 0xC0 или б0 >= 0xE0:
            верни -1
        верни (((б0 & 0x1F) << 6) | ((д[1] как нат.верх) & 0x3F)) как цел.верх
    если дл == 3:
        если б0 < 0xE0 или б0 >= 0xF0:
            верни -1
        верни (((б0 & 0x0F) << 12) | (((д[1] как нат.верх) & 0x3F) << 6) |
               ((д[2] как нат.верх) & 0x3F)) как цел.верх
    если б0 < 0xF0:
        верни -1
    верни (((б0 & 0x07) << 18) | (((д[1] как нат.верх) & 0x3F) << 12) |
           (((д[2] как нат.верх) & 0x3F) << 6) | ((д[3] как нат.верх) & 0x3F)) как цел.верх

функ _строка_лит(л *Лексер, исх стр, k нат.верх, конец нат.верх,
                 кав нат.старт, строка нат.верх, столб нат.верх) нат.верх:
    # читает строковый/символьный литерал, возвращает позицию за кавычкой
    б *Буфер = буф_новый()
    поз нат.верх = k
    пока поз < конец и исх.данные[поз] != кав:
        если исх.данные[поз] == '\\':
            поз = _экран(б, исх, поз, конец, строка, столб + поз - k + 1)
        иначе:
            буф_сим(б, исх.данные[поз])
            поз += 1
    если поз >= конец:
        _ош("незакрытый литерал", строка, столб)
    если кав == 39:
        # символьный литерал — ровно один кодпоинт UTF-8 (1..4 байта)
        cp цел.верх = _утф8_код(б.данные, б.длина)
        если cp < 0:
            _ош("символьный литерал — ровно один символ", строка, столб)
        список_добавь(л.токи,
            _тк(ТК_ЧИСЛО, пусто как стр, cp как нат.верх,
                строка, столб) как нат.верх)
    иначе:
        список_добавь(л.токи,
            _тк(ТК_СТР, буф_стр(б), 0, строка, столб) как нат.верх)
    буф_свободен(б)
    верни поз + 1

функ _оп3(б0 нат.старт, б1 нат.старт, б2 нат.старт) нат.верх:
    # трёхсимвольный оператор: '..=' '<<=' '>>=' — иначе 0
    если б0 == '.' и б1 == '.' и б2 == '=':
        верни 3
    если (б0 == '<' или б0 == '>') и б0 == б1 и б2 == '=':
        верни 3
    верни 0

функ _оп2(б0 нат.старт, б1 нат.старт) нат.верх:
    # двухсимвольный оператор — иначе 0
    если б0 == '.' и б1 == '.':
        верни 2
    если б1 == '=' и (б0 == ':' или б0 == '=' или б0 == '!' или
                      б0 == '<' или б0 == '>' или б0 == '+' или
                      б0 == '-' или б0 == '*' или б0 == '/' или
                      б0 == '%' или б0 == '&' или б0 == '|' или б0 == '^'):
        верни 2
    если б0 == '<' и б1 == '<':
        верни 2
    если б0 == '>' и б1 == '>':
        верни 2
    верни 0

функ _байт(исх стр, i нат.верх, кон нат.верх) нат.старт:
    если i < кон:
        верни исх.данные[i]
    верни 0

функ _один_оп(б нат.старт) лог:
    верни (б == '+' или б == '-' или б == '*' или б == '/' или б == '%' или
           б == '<' или б == '>' или б == '=' или б == '(' или б == ')' или
           б == '[' или б == ']' или б == '{' или б == '}' или б == ',' или
           б == '.' или б == ':' или б == '&' или б == '|' или б == '^' или
           б == '!')

функ _стек_верх(л *Лексер) нат.верх:
    верни список_получи(л.отступы, л.отступы.длина - 1)

функ _токи_строки(л *Лексер, исх стр, нач нат.верх, кон нат.верх,
                  строка нат.верх, сдвиг нат.верх) цел.верх:
    # токены одной строки [нач..кон); возвращает дельту глубины скобок
    глуб цел.верх = 0
    поз нат.верх = нач

    пока поз < кон:
        ch нат.старт = исх.данные[поз]
        если ch == ' ':
            поз += 1
            следующий
        если это_цифра(ch):
            край нат.верх = поз
            пока край < кон и (_имя_часть(исх.данные[край]) или
                            исх.данные[край] == '_'):
                край += 1
            текст стр = стр_срез(исх, поз, край)
            список_добавь(л.токи,
                _тк(ТК_ЧИСЛО, текст, _число(текст, строка, поз - нач + сдвиг + 1),
                    строка, поз - нач + сдвиг + 1) как нат.верх)
            поз = край
            следующий
        если ch == '"' или ch == 39:
            поз = _строка_лит(л, исх, поз + 1, кон, ch, строка, поз - нач + сдвиг + 1)
            следующий
        если _имя_нач(ch):
            край = поз
            пока край < кон и _имя_часть(исх.данные[край]):
                край += 1
            список_добавь(л.токи,
                _тк(ТК_ИМЯ, стр_срез(исх, поз, край), 0, строка,
                    поз - нач + сдвиг + 1) как нат.верх)
            поз = край
            следующий
        n3 нат.верх = _оп3(ch, _байт(исх, поз + 1, кон), _байт(исх, поз + 2, кон))
        если n3 == 3:
            список_добавь(л.токи,
                _тк(ТК_ОП, стр_срез(исх, поз, поз + 3), 0, строка,
                    поз - нач + сдвиг + 1) как нат.верх)
            поз += 3
            следующий
        n2 нат.верх = _оп2(ch, _байт(исх, поз + 1, кон))
        если n2 == 2:
            список_добавь(л.токи,
                _тк(ТК_ОП, стр_срез(исх, поз, поз + 2), 0, строка,
                    поз - нач + сдвиг + 1) как нат.верх)
            поз += 2
            следующий
        если _один_оп(ch):
            если ch == '(' или ch == '[' или ch == '{':
                глуб += 1
            если ch == ')' или ch == ']' или ch == '}':
                глуб -= 1
            список_добавь(л.токи,
                _тк(ТК_ОП, стр_срез(исх, поз, поз + 1), 0, строка,
                    поз - нач + сдвиг + 1) как нат.верх)
            поз += 1
            следующий
        _ош("неожиданный символ", строка, поз - нач + сдвиг + 1)
    верни глуб

функ токенизируй(исх стр) *Список:
    # разбирает исходник построчно; возвращает список *Токен
    л *Лексер = новый(Лексер)
    л.исх = исх
    л.токи = список_новый()
    л.отступы = список_новый()
    список_добавь(л.отступы, 0)
    глубина цел.верх = 0
    строка нат.верх = 1
    нач нат.верх = 0
    поз нат.верх = 0
    пока поз <= исх.длина:
        если поз == исх.длина или исх.данные[поз] == 10:
            кон нат.верх = поз
            если кон > нач и исх.данные[кон - 1] == 13:
                кон -= 1
            # обрезка комментария: '#' или ';' вне строк
            поз2 нат.верх = нач
            пока поз2 < кон:
                c нат.старт = исх.данные[поз2]
                если c == '"' или c == 39:
                    поз2 += 1
                    пока поз2 < кон и исх.данные[поз2] != c:
                        если исх.данные[поз2] == '\\':
                            поз2 += 1
                        поз2 += 1
                а если c == '#' или c == ';':
                    кон = поз2
                поз2 += 1
            # пустая строка?
            пустая лог = да
            поз2 = нач
            пока поз2 < кон:
                если исх.данные[поз2] != ' ':
                    пустая = нет
                поз2 += 1
            если не пустая:
                # отступ
                колво нат.верх = 0
                поз2 = нач
                пока поз2 < кон и исх.данные[поз2] == ' ':
                    колво += 1
                    поз2 += 1
                если поз2 < кон и исх.данные[поз2] == 9:
                    _ош("табуляция в отступе — используйте пробелы", строка, колво + 1)
                если глубина == 0:
                    верх нат.верх = _стек_верх(л)
                    если колво > верх:
                        список_добавь(л.отступы, колво)
                        список_добавь(л.токи,
                            _тк(ТК_ОТСТУП, пусто как стр, колво,
                                строка, колво + 1) как нат.верх)
                    иначе:
                        пока колво < _стек_верх(л):
                            л.отступы.длина -= 1
                            список_добавь(л.токи,
                                _тк(ТК_СНЯТИЕ, пусто как стр, колво,
                                    строка, колво + 1) как нат.верх)
                        если колво != _стек_верх(л):
                            _ош("неконсистентный отступ", строка, колво + 1)
                глубина += _токи_строки(л, исх, нач + колво, кон, строка, колво)
                если глубина == 0:
                    список_добавь(л.токи,
                        _тк(ТК_НС, пусто как стр, 0, строка,
                            кон - нач + 1) как нат.верх)
            нач = поз + 1
            строка += 1
        поз += 1
    список_добавь(л.токи, _тк(ТК_НС, пусто как стр, 0, строка, 0) как нат.верх)
    пока л.отступы.длина > 1:
        л.отступы.длина -= 1
        список_добавь(л.токи,
            _тк(ТК_СНЯТИЕ, пусто как стр, 0, строка, 0) как нат.верх)
    список_добавь(л.токи, _тк(ТК_КФ, пусто как стр, 0, строка, 0) как нат.верх)
    верни л.токи
