# лексер — токенизация исходника РАЗУМА (версия на самом РАЗУМЕ).
# Часть самораскрутки ВЕЛЕС: raz/ — компилятор РАЗУМА, пишется на РАЗУМЕ.
# Виды токенов: ИМЯ, ЧИСЛО, СТР, ОП,
# НС, ОТСТУП, СНЯТИЕ, КФ. Комментарии '#' и ';' до конца строки.

взять основа, буфер

конст ТК_ИМЯ = 1
конст ТК_ЧИСЛО = 2
конст ТК_СТР = 3
конст ТК_ОП = 4
конст ТК_НС = 5
конст ТК_ОТСТУП = 6
конст ТК_СНЯТИЕ = 7
конст ТК_КФ = 8

запись Токен:
    вид без64
    текст стр        # ИМЯ/СТР/ОП; для остальных — пусто
    знач без64       # ЧИСЛО
    строка без64
    столб без64      # байтовая позиция в строке, 1-начало (0 = нет)

запись Лексер:
    исх стр
    токи *Список
    отступы *Список

функ _тк(вид без64, текст стр, знач без64, строка без64,
         столб без64) *Токен:
    т *Токен = новый(Токен)
    т.вид = вид
    т.текст = текст
    т.знач = знач
    т.строка = строка
    т.столб = столб
    верни т

функ _ош(текст стр, строка без64, столб без64):
    печать("разум.лексер: строка ")
    печатьцел(строка как цел64)
    если столб > 0:
        печать(":")
        печатьцел(столб как цел64)
    печать(": ")
    печатьстр(текст)
    выход(1)

функ _имя_нач(б без8) бул:
    # буква (латиница/кириллица в UTF-8) или подчёркивание
    верни это_буква(б) или б == '_'

функ _имя_часть(б без8) бул:
    верни это_буква(б) или это_цифра(б) или б == '_'

функ _цифра16(б без8) цел64:
    # значение hex-цифры или -1
    если б >= '0' и б <= '9':
        верни (б - '0') как цел64
    если б >= 'a' и б <= 'f':
        верни (б - 'a' + 10) как цел64
    если б >= 'A' и б <= 'F':
        верни (б - 'A' + 10) как цел64
    верни -1

функ _число(текст стр, строка без64, столб без64) без64:
    # разбор числа: 0x/0b/0o/десятичный, '_' — разделитель
    i без64 = 0
    база без64 = 10
    если текст.длина > 2 и текст.данные[0] == '0':
        в := текст.данные[1]
        если в == 'x' или в == 'X':
            база = 16
            i = 2
        а если в == 'b' или в == 'B':
            база = 2
            i = 2
        а если в == 'o' или в == 'O':
            база = 8
            i = 2
    ч без64 = 0
    пока i < текст.длина:
        б := текст.данные[i]
        если б != '_':
            ц := _цифра16(б)
            если ц < 0 или (ц как без64) >= база:
                _ош("неверное число", строка, столб)
            ч = ч * база + (ц как без64)
        i += 1
    верни ч

функ _экран(б *Буфер, исх стр, k без64, конец без64, строка без64,
            столб без64) без64:
    # обрабатывает \x: добавляет байт в буфер, возвращает новую позицию
    если k + 1 >= конец:
        _ош("оборванная экранизация", строка, столб)
    e := исх.данные[k + 1]
    если e == 'n':
        буф_сим(б, 10)
        верни k + 2
    если e == 'r':
        буф_сим(б, 13)
        верни k + 2
    если e == 't':
        буф_сим(б, 9)
        верни k + 2
    если e == '0':
        буф_сим(б, 0)
        верни k + 2
    если e == '\\' или e == '"' или e == 39:
        буф_сим(б, e)
        верни k + 2
    если e == 'x' и k + 3 < конец:
        ст := _цифра16(исх.данные[k + 2])
        мл := _цифра16(исх.данные[k + 3])
        если ст < 0 или мл < 0:
            _ош("неверный \\x экран", строка, столб)
        буф_сим(б, (ст * 16 + мл) как без8)
        верни k + 4
    _ош("неизвестная экранизация", строка, столб)
    верни k + 1

функ _утф8_код(д *без8, дл без64) цел64:
    # декодирует один кодпоинт UTF-8; -1 при неверной длине/форме
    если дл == 0 или дл > 4:
        верни -1
    б0 := д[0] как без64
    если дл == 1:
        если б0 >= 0x80:
            верни -1
        верни б0 как цел64
    если дл == 2:
        если б0 < 0xC0 или б0 >= 0xE0:
            верни -1
        верни (((б0 & 0x1F) << 6) | ((д[1] как без64) & 0x3F)) как цел64
    если дл == 3:
        если б0 < 0xE0 или б0 >= 0xF0:
            верни -1
        верни (((б0 & 0x0F) << 12) | (((д[1] как без64) & 0x3F) << 6) |
               ((д[2] как без64) & 0x3F)) как цел64
    если б0 < 0xF0:
        верни -1
    верни (((б0 & 0x07) << 18) | (((д[1] как без64) & 0x3F) << 12) |
           (((д[2] как без64) & 0x3F) << 6) | ((д[3] как без64) & 0x3F)) как цел64

функ _строка_лит(л *Лексер, исх стр, k без64, конец без64,
                 кав без8, строка без64, столб без64) без64:
    # читает строковый/символьный литерал, возвращает позицию за кавычкой
    б *Буфер = буф_новый()
    j := k
    пока j < конец и исх.данные[j] != кав:
        если исх.данные[j] == '\\':
            j = _экран(б, исх, j, конец, строка, столб + j - k + 1)
        иначе:
            буф_сим(б, исх.данные[j])
            j += 1
    если j >= конец:
        _ош("незакрытый литерал", строка, столб)
    если кав == 39:
        # символьный литерал — ровно один кодпоинт UTF-8 (1..4 байта)
        cp := _утф8_код(б.данные, б.длина)
        если cp < 0:
            _ош("символьный литерал — ровно один символ", строка, столб)
        список_добавь(л.токи,
            _тк(ТК_ЧИСЛО, пусто как стр, cp как без64,
                строка, столб) как без64)
    иначе:
        список_добавь(л.токи,
            _тк(ТК_СТР, буф_стр(б), 0, строка, столб) как без64)
    буф_свободен(б)
    верни j + 1

функ _оп3(б0 без8, б1 без8, б2 без8) без64:
    # трёхсимвольный оператор: '..=' '<<=' '>>=' — иначе 0
    если б0 == '.' и б1 == '.' и б2 == '=':
        верни 3
    если (б0 == '<' или б0 == '>') и б0 == б1 и б2 == '=':
        верни 3
    верни 0

функ _оп2(б0 без8, б1 без8) без64:
    # двухсимвольный оператор — иначе 0
    если б0 == '.' и б1 == '.':
        верни 2
    если б1 == '=' и (б0 == ':' или б0 == '=' или б0 == '!' или
                      б0 == '<' или б0 == '>' или б0 == '+' или
                      б0 == '-' или б0 == '*' или б0 == '/' или
                      б0 == '%' или б0 == '&' или б0 == '|' или б0 == '^'):
        верни 2
    если б0 == '<' и б1 == '<':
        верни 2
    если б0 == '>' и б1 == '>':
        верни 2
    верни 0

функ _байт(исх стр, i без64, кон без64) без8:
    если i < кон:
        верни исх.данные[i]
    верни 0

функ _один_оп(б без8) бул:
    верни (б == '+' или б == '-' или б == '*' или б == '/' или б == '%' или
           б == '<' или б == '>' или б == '=' или б == '(' или б == ')' или
           б == '[' или б == ']' или б == '{' или б == '}' или б == ',' или
           б == '.' или б == ':' или б == '&' или б == '|' или б == '^' или
           б == '!')

функ _стек_верх(л *Лексер) без64:
    верни список_получи(л.отступы, л.отступы.длина - 1)

функ _токи_строки(л *Лексер, исх стр, нач без64, кон без64,
                  строка без64, сдвиг без64) цел64:
    # токены одной строки [нач..кон); возвращает дельту глубины скобок
    глуб цел64 = 0
    j := нач

    пока j < кон:
        ch := исх.данные[j]
        если ch == ' ':
            j += 1
            следующий
        если это_цифра(ch):
            k := j
            пока k < кон и (_имя_часть(исх.данные[k]) или
                            исх.данные[k] == '_'):
                k += 1
            текст := стр_срез(исх, j, k)
            список_добавь(л.токи,
                _тк(ТК_ЧИСЛО, текст, _число(текст, строка, j - нач + сдвиг + 1),
                    строка, j - нач + сдвиг + 1) как без64)
            j = k
            следующий
        если ch == '"' или ch == 39:
            j = _строка_лит(л, исх, j + 1, кон, ch, строка, j - нач + сдвиг + 1)
            следующий
        если _имя_нач(ch):
            k := j
            пока k < кон и _имя_часть(исх.данные[k]):
                k += 1
            список_добавь(л.токи,
                _тк(ТК_ИМЯ, стр_срез(исх, j, k), 0, строка,
                    j - нач + сдвиг + 1) как без64)
            j = k
            следующий
        n3 := _оп3(ch, _байт(исх, j + 1, кон), _байт(исх, j + 2, кон))
        если n3 == 3:
            список_добавь(л.токи,
                _тк(ТК_ОП, стр_срез(исх, j, j + 3), 0, строка,
                    j - нач + сдвиг + 1) как без64)
            j += 3
            следующий
        n2 := _оп2(ch, _байт(исх, j + 1, кон))
        если n2 == 2:
            список_добавь(л.токи,
                _тк(ТК_ОП, стр_срез(исх, j, j + 2), 0, строка,
                    j - нач + сдвиг + 1) как без64)
            j += 2
            следующий
        если _один_оп(ch):
            если ch == '(' или ch == '[' или ch == '{':
                глуб += 1
            если ch == ')' или ch == ']' или ch == '}':
                глуб -= 1
            список_добавь(л.токи,
                _тк(ТК_ОП, стр_срез(исх, j, j + 1), 0, строка,
                    j - нач + сдвиг + 1) как без64)
            j += 1
            следующий
        _ош("неожиданный символ", строка, j - нач + сдвиг + 1)
    верни глуб

функ токенизируй(исх стр) *Список:
    # разбирает исходник построчно; возвращает список *Токен
    л *Лексер = новый(Лексер)
    л.исх = исх
    л.токи = список_новый()
    л.отступы = список_новый()
    список_добавь(л.отступы, 0)
    глубина цел64 = 0
    строка без64 = 1
    нач без64 = 0
    i без64 = 0
    пока i <= исх.длина:
        если i == исх.длина или исх.данные[i] == 10:
            кон := i
            если кон > нач и исх.данные[кон - 1] == 13:
                кон -= 1
            # обрезка комментария: '#' или ';' вне строк
            к := нач
            пока к < кон:
                c := исх.данные[к]
                если c == '"' или c == 39:
                    к += 1
                    пока к < кон и исх.данные[к] != c:
                        если исх.данные[к] == '\\':
                            к += 1
                        к += 1
                а если c == '#' или c == ';':
                    кон = к
                к += 1
            # пустая строка?
            пустая := да
            к = нач
            пока к < кон:
                если исх.данные[к] != ' ':
                    пустая = нет
                к += 1
            если не пустая:
                # отступ
                колво без64 = 0
                к = нач
                пока к < кон и исх.данные[к] == ' ':
                    колво += 1
                    к += 1
                если к < кон и исх.данные[к] == 9:
                    _ош("табуляция в отступе — используйте пробелы", строка, колво + 1)
                если глубина == 0:
                    верх := _стек_верх(л)
                    если колво > верх:
                        список_добавь(л.отступы, колво)
                        список_добавь(л.токи,
                            _тк(ТК_ОТСТУП, пусто как стр, колво,
                                строка, колво + 1) как без64)
                    иначе:
                        пока колво < _стек_верх(л):
                            л.отступы.длина -= 1
                            список_добавь(л.токи,
                                _тк(ТК_СНЯТИЕ, пусто как стр, колво,
                                    строка, колво + 1) как без64)
                        если колво != _стек_верх(л):
                            _ош("неконсистентный отступ", строка, колво + 1)
                глубина += _токи_строки(л, исх, нач + колво, кон, строка, колво)
                если глубина == 0:
                    список_добавь(л.токи,
                        _тк(ТК_НС, пусто как стр, 0, строка,
                            кон - нач + 1) как без64)
            нач = i + 1
            строка += 1
        i += 1
    список_добавь(л.токи, _тк(ТК_НС, пусто как стр, 0, строка, 0) как без64)
    пока л.отступы.длина > 1:
        л.отступы.длина -= 1
        список_добавь(л.токи,
            _тк(ТК_СНЯТИЕ, пусто как стр, 0, строка, 0) как без64)
    список_добавь(л.токи, _тк(ТК_КФ, пусто как стр, 0, строка, 0) как без64)
    верни л.токи
