функ (п *Парсер) искра_(строка без64) *Узел:
    # блок искра: — сырой текст ИСКРЫ из исходника по номерам строк
    п.далее()
    п.жди(":")
    если п.ток().вид != ТК_НС:
        п_ош("искра: требуется отступный блок", строка)
    п.пропусти_нс()
    п.жди_вид(ТК_ОТСТУП)
    мин без64 = 0
    макс без64 = 0
    пока п.ток().вид != ТК_СНЯТИЕ и п.ток().вид != ТК_КФ:
        нс := п.ток().строка
        если мин == 0 или нс < мин:
            мин = нс
        если нс > макс:
            макс = нс
        пока п.ток().вид != ТК_НС и п.ток().вид != ТК_КФ:
            п.i += 1
        если п.ток().вид == ТК_НС:
            п.i += 1
    если п.ток().вид == ТК_СНЯТИЕ:
        п.далее()
    у := узел(У_ИСКРА, строка)
    у.дети = список_новый()
    если мин == 0:
        верни у
    # сырые строки мин..макс, общий отступ срезаем
    мин_отступ без64 = 1000000
    но := мин
    пока но <= макс:
        сыр := _линия(п.исх, но)
        если _непустая(сыр):
            отс := _отступ(сыр)
            если отс < мин_отступ:
                мин_отступ = отс
        но += 1
    но = мин
    пока но <= макс:
        сыр := _линия(п.исх, но)
        если _непустая(сыр):
            э := узел(У_СТР, но)
            э.текст = стр_срез(сыр, мин_отступ, сыр.длина)
            у_добавь(у, э)
        иначе:
            э := узел(У_СТР, но)
            э.текст = стр_срез(п.исх, 0, 0)
            у_добавь(у, э)
        но += 1
    верни у

функ _линия(исх стр, но без64) стр:
    # сырая строка №но (1-нумерация), без \n и \r
    нач без64 = 0
    н без64 = 1
    i без64 = 0
    пока i < исх.длина:
        если исх.данные[i] == 10:
            если н == но:
                верни стр_срез(исх, нач, i)
            н += 1
            нач = i + 1
        i += 1
    если н == но:
        кон := исх.длина
        если кон > нач и исх.данные[кон - 1] == 13:
            кон -= 1
        верни стр_срез(исх, нач, кон)
    верни стр_срез(исх, 0, 0)

функ _непустая(с стр) бул:
    i без64 = 0
    пока i < с.длина:
        если с.данные[i] != ' ' и с.данные[i] != 13:
            верни да
        i += 1
    верни нет

функ _отступ(с стр) без64:
    i без64 = 0
    пока i < с.длина и с.данные[i] == ' ':
        i += 1
    верни i

