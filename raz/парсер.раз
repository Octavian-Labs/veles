открыто функ (парс *Парсер) блок() *Список:
    парс.жди(":")
    тело *Список = список_новый()
    если парс.ток().вид != ТК_НС:
        список_добавь(тело, парс.оператор() как размер)
        верни тело
    парс.пропусти_нс()
    если парс.ток().вид != ТК_ОТСТУП:
        п_ожидал("отступный блок", парс.ток())
    парс.далее()
    пока парс.ток().вид != ТК_СНЯТИЕ и парс.ток().вид != ТК_КФ:
        если парс.ток().вид == ТК_НС:
            парс.далее()
            следующий
        список_добавь(тело, парс.оператор() как размер)
    если парс.ток().вид == ТК_СНЯТИЕ:
        парс.далее()
    верни тело

