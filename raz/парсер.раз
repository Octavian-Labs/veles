        рез = узел(У_ТИПСИН, строка)
        рез.текст = парс.жди_имя()
        парс.жди("=")
        рез.а = парс.тип()
        парс.конец_строки()
        верни рез
    если парс.это("запись"):
        парс.далее()
        рез = узел(У_ЗАПИСЬ, строка)
        рез.текст = парс.жди_имя()
        рез.дети = парс.поля_записи()
