конст ОП_РАВНО = 1
конст ОП_НЕРАВНО = 2
конст ОП_МЕНЬШЕ = 3
конст ОП_МЕНРАВ = 4
конст ОП_БОЛЬШЕ = 5
конст ОП_БОЛРАВ = 6

функ _код_сравн(текст стр) без64:
    если стр_равны(текст, "=="):
        верни ОП_РАВНО
    если стр_равны(текст, "!="):
        верни ОП_НЕРАВНО
    если стр_равны(текст, "<"):
        верни ОП_МЕНЬШЕ
    если стр_равны(текст, "<="):
        верни ОП_МЕНРАВ
    если стр_равны(текст, ">"):
        верни ОП_БОЛЬШЕ
    если стр_равны(текст, ">="):
        верни ОП_БОЛРАВ
    верни 0

функ (п *Парсер) сравн() *Узел:
    e := п.бит_или()
    вечно:
        т := п.ток()
        если т.вид == ТК_ОП и _код_сравн(т.текст) != 0:
            оп := п.далее().текст
            e = у_бин(оп, e, п.бит_или(), т.строка)
            следующий
        если т.вид == ТК_ИМЯ и (стр_равны(т.текст, "в") или
           (стр_равны(т.текст, "не") и _след_в(п))):
            строка := т.строка
            neg := стр_равны(т.текст, "не")
            п.далее()
            если neg:
                п.далее()
            a := п.бит_или()
            если п.это_оп("..") или п.это_оп("..="):
                вкл := п.далее().текст
                диап := узел(У_ДИАП, строка)
                диап.а = a
                диап.б = п.бит_или()
                если стр_равны(вкл, "..="):
                    диап.знач2 = 1
                e = у_бин("в", e, диап, строка)
                если neg:
                    н := узел(У_УН, строка)
                    н.текст = "не"
                    н.а = e
                    e = н
            иначе:
                п_ош("«в» требует диапазон a..b", строка)
            следующий
        хватит
    верни e

функ _след_в(п *Парсер) бул:
    n := п.ток1(1)
    верни n.вид == ТК_ИМЯ и стр_равны(n.текст, "в")

