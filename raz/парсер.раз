открыто функ (парс *Парсер) параметры() *Список:
    # имя {, имя} тип — последний идентификатор группы является типом
    парс.жди("(")
    список *Список = список_новый()
    пока не парс.это(")"):
        имена *Список = список_новый()
        список_добавь(имена, у_имя(парс.жди_имя(), парс.ток().строка) как размер)
        тип *Узел = пусто как *Узел
        пока парс.это_оп(","):
            след1 *Токен = парс.ток1(1)
            след2 *Токен = парс.ток1(2)
            если (след1.вид == ТК_ИМЯ и след2.вид == ТК_ОП и
                стр_равны(след2.текст, ",")):
                парс.далее()
                список_добавь(имена,
                    у_имя(парс.жди_имя(), парс.ток().строка) как размер)
                следующий
            если след1.вид == ТК_ИМЯ и (след2.вид == ТК_ИМЯ или
               (след2.вид == ТК_ОП и
                (стр_равны(след2.текст, "*") или стр_равны(след2.текст, "[")))):
                парс.далее()
                список_добавь(имена,
                    у_имя(парс.жди_имя(), парс.ток().строка) как размер)
                следующий
            парс.далее()
            тип = парс.тип()
            хватит
        если тип == пусто:
            # тип идёт сразу за именем: «а цел.верх»
            ток_типа *Токен = парс.ток()
            если ток_типа.вид != ТК_ИМЯ и не (ток_типа.вид == ТК_ОП и
               (стр_равны(ток_типа.текст, "*") или стр_равны(ток_типа.текст, "["))):
                п_ош("параметру не указан тип", ток_типа.строка, ток_типа.столб)
            тип = парс.тип()
        для инд в 0..имена.длина:
            имя *Узел = список_получи(имена, инд) как *Узел
            парам *Узел = узел(У_ПАРАМ, имя.строка)
            парам.текст = имя.текст
            парам.а = тип
            список_добавь(список, парам как размер)
        если парс.это_оп(","):
            парс.далее()
        иначе:
            хватит
    парс.жди(")")
    верни список

