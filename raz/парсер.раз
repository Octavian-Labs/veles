открыто функ _код_сравн(текст стр) нат.верх:
    если стр_равны(текст, "=="):
        верни ОП_РАВНО
    если стр_равны(текст, "!="):
        верни ОП_НЕРАВНО
    если стр_равны(текст, "<"):
        верни ОП_МЕНЬШЕ
    если стр_равны(текст, "<="):
        верни ОП_МЕНРАВ
    если стр_равны(текст, ">"):
        верни ОП_БОЛЬШЕ
    если стр_равны(текст, ">="):
        верни ОП_БОЛРАВ
    верни 0

открыто функ (парс *Парсер) сравн() *Узел:
    выр *Узел = парс.бит_или()
    вечно:
        ток *Токен = парс.ток()
        если ток.вид == ТК_ОП и _код_сравн(ток.текст) != 0:
            оп стр = парс.далее().текст
            выр = у_бин(оп, выр, парс.бит_или(), ток.строка)
            следующий
        если ток.вид == ТК_ИМЯ и (стр_равны(ток.текст, "в") или
           (стр_равны(ток.текст, "не") и _след_в(парс))):
            строка размер = ток.строка
            отриц лог = стр_равны(ток.текст, "не")
            парс.далее()
            если отриц:
                парс.далее()
            подвыр *Узел = парс.бит_или()
            если парс.это_оп("..") или парс.это_оп("..="):
                оп_диап стр = парс.далее().текст
                диап *Узел = узел(У_ДИАП, строка)
                диап.а = подвыр
                диап.б = парс.бит_или()
                если стр_равны(оп_диап, "..="):
                    диап.знач2 = 1
                выр = у_бин("в", выр, диап, строка)
                если отриц:
                    отрицание *Узел = узел(У_УН, строка)
                    отрицание.текст = "не"
                    отрицание.а = выр
                    выр = отрицание
            иначе:
                п_ош("«в» требует диапазон a..b", строка, 0)
            следующий
        хватит
    верни выр

