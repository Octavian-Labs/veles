        рез = узел(У_ПЕРЕЧ, строка)
        рез.текст = парс.жди_имя()
        парс.жди(":")
        парс.пропусти_нс()
        парс.жди_вид(ТК_ОТСТУП)
        рез.дети = список_новый()
        номер размер = 0
        пока парс.ток().вид != ТК_СНЯТИЕ и парс.ток().вид != ТК_КФ:
