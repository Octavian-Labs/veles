открыто функ (парс *Парсер) атом() *Узел:
    ток *Токен = парс.ток()
    если ток.вид == ТК_ВЕЩ:
        парс.далее()
        рв *Узел = узел(У_ВЕЩ, ток.строка)
        рв.текст = ток.текст
        верни рв
    если ток.вид == ТК_ЧИСЛО:
        парс.далее()
        рез *Узел = узел(У_ЧИСЛО, ток.строка)
        рез.знач = ток.знач
        рез.знач2 = ток.знач >> 63   # литерал >= 2^63 — печатаем беззнаково
        верни рез
    если ток.вид == ТК_СТР:
        парс.далее()
        рез = узел(У_СТР, ток.строка)
        рез.текст = ток.текст
        верни рез
    если ток.вид == ТК_ИМЯ:
        если стр_равны(ток.текст, "да"):
            парс.далее()
            рез = узел(У_БУЛ, ток.строка)
            рез.знач = 1
            верни рез
        если стр_равны(ток.текст, "нет"):
            парс.далее()
            рез = узел(У_БУЛ, ток.строка)
            верни рез
        если стр_равны(ток.текст, "пусто"):
            парс.далее()
            верни узел(У_ПУСТО, ток.строка)
        если стр_равны(ток.текст, "новый"):
            парс.далее()
            парс.жди("(")
            рез = узел(У_НОВЫЙ, ток.строка)
            рез.а = парс.тип()
            парс.жди(")")
            верни рез
        если стр_равны(ток.текст, "век"):
            # векторный литерал «век <элемент> х N{...}»
            тв *Узел = парс.тип()
            если тв.знач != ТВ_ВЕК:
                п_ош("«век» в выражении — только «век <элемент> х N{...}»",
                    ток.строка, ток.столб)
            если не парс.это_оп("{"):
                п_ожидал("«{...}» — лейны векторного литерала", парс.ток())
            парс.далее()
            рез = узел(У_ЛИТТИП, ток.строка)
            рез.а = тв
            рез.дети = список_новый()
            если не парс.это_оп("}"):
                вечно:
                    арг *Узел = узел(У_АРГ, парс.ток().строка)
                    арг.текст = пусто как стр
                    арг.а = парс.выражение()
                    у_добавь(рез, арг)
                    если не парс.это_оп(","):
                        хватит
                    парс.далее()
            парс.жди("}")
            верни рез
        если стр_равны(ток.текст, "размер"):
            парс.далее()
            парс.жди("(")
            # пробуем тип, иначе — выражение
            сохр размер = парс.поз
            рез = узел(У_РАЗМЕР, ток.строка)
            проба *Узел = _пробуй_тип(парс)
            если проба != пусто и парс.это_оп(")"):
                парс.далее()
                рез.а = проба
                рез.знач2 = 1
                верни рез
            парс.поз = сохр
            рез.а = парс.выражение()
            парс.жди(")")
            верни рез
        если стр_равны(ток.текст, "повтор"):
            # повтор(выр) — только когда следом '('; иначе обычное имя
            сл_п *Токен = парс.ток1(1)
            если сл_п.вид == ТК_ОП и стр_равны(сл_п.текст, "("):
                парс.далее()
                парс.жди("(")
                рез = узел(У_ПОВТОР, ток.строка)
                рез.а = парс.выражение()
                парс.жди(")")
                верни рез
        если стр_равны(ток.текст, "сумма"):
            # сумма(век) — только когда следом '('; иначе обычное имя
            сл_с *Токен = парс.ток1(1)
            если сл_с.вид == ТК_ОП и стр_равны(сл_с.текст, "("):
                парс.далее()
                парс.жди("(")
                рез = узел(У_СУММА, ток.строка)
                рез.а = парс.выражение()
                парс.жди(")")
                верни рез
    если парс.это_оп("("):
        парс.далее()
        выр *Узел = парс.выражение()
        парс.жди(")")
        верни выр
    если ток.вид == ТК_ИМЯ:
        парс.далее()
        верни у_имя(ток.текст, ток.строка)
    п_ош(стр_склей("неожиданный токен: ", _получено(ток)), ток.строка, ток.столб)
    верни пусто как *Узел

