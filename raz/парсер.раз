открыто функ (парс *Парсер) программа() *Узел:
    прог *Узел = узел(У_ПРОГ, 0)
    прог.дети = список_новый()
    парс.пропусти_нс()
    пока парс.ток().вид != ТК_КФ:
        у_добавь(прог, парс.объявление())
        парс.пропусти_нс()
    верни прог

открыто функ (парс *Парсер) объявление() *Узел:
    # видимость: «открыто»/«скрыто» перед объявлением; умолчание — скрыто
    ток *Токен = парс.ток()
    отк нат.верх = 0
    если стр_равны(ток.текст, "открыто"):
        парс.далее()
        отк = 1
    а если стр_равны(ток.текст, "скрыто"):
        парс.далее()
        отк = 2
    рез *Узел = парс.объявление_ядро()
    если рез != пусто и отк != 0:
        если рез.вид == У_ВЗЯТЬ:
            п_ош("«открыто»/«скрыто» применимо к объявлениям, а не к «взять»",
                ток.строка, ток.столб)
        рез.отк = отк
    верни рез

открыто функ (парс *Парсер) объявление_ядро() *Узел:
    ток *Токен = парс.ток()
    строка размер = ток.строка
    если парс.это("взять"):
        парс.далее()
        рез *Узел = узел(У_ВЗЯТЬ, строка)
        рез.дети = список_новый()
        у_добавь(рез, у_имя(парс.путь_модуля(), строка))
        пока парс.это_оп(","):
            парс.далее()
            у_добавь(рез, у_имя(парс.путь_модуля(), строка))
        парс.конец_строки()
        верни рез
    если парс.это("внеш"):
        парс.далее()
        длл *Токен = парс.ток()
