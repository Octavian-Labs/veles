открыто функ _версия_исх(исх стр) размер:
    # прагма первой строки «;версия N»; 0 — отметки нет
    лин стр = _линия(исх, 1)
    поз размер = 0
    пока поз < лин.длина и (лин.данные[поз] == ' ' или лин.данные[поз] == 9):
        поз += 1
    если поз >= лин.длина или лин.данные[поз] != ';':
        верни 0
    поз += 1
    пока поз < лин.длина и (лин.данные[поз] == ' ' или лин.данные[поз] == 9):
        поз += 1
    слово стр = "версия"
    если поз + слово.длина > лин.длина:
        верни 0
    если не стр_равны(стр_срез(лин, поз, поз + слово.длина), слово):
        верни 0
    поз += слово.длина
    пока поз < лин.длина и (лин.данные[поз] == ' ' или лин.данные[поз] == 9):
        поз += 1
    нач размер = поз
    пока поз < лин.длина и лин.данные[поз] >= '0' и лин.данные[поз] <= '9':
        поз += 1
    если поз == нач:
        п_ош("прагма «;версия» требует номер: «;версия N»", 1, 0)
    верн размер = стр_число(стр_срез(лин, нач, поз)) как размер
    если верн == 0:
        п_ош("«;версия 0» недопустима — нумерация канона с 1", 1, 0)
    верни верн

открыто функ разбери_ф(исх стр, путь стр) *Узел:
