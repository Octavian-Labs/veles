открыто функ (парс *Парсер) постфикс_выр() *Узел:
    выр *Узел = парс.атом()
    вечно:
        ток *Токен = парс.ток()
        если парс.это_оп("."):
            парс.далее()
            рез *Узел = узел(У_ПОЛЕ, ток.строка)
            рез.а = выр
            рез.текст = парс.жди_имя()
            выр = рез
            следующий
        если парс.это_оп("["):
            парс.далее()
            инд *Узел = парс.выражение()
            если парс.это_оп("..") или парс.это_оп("..="):
                оп_диап стр = парс.далее().текст
                диап *Узел = узел(У_ДИАП, ток.строка)
                диап.а = инд
                диап.б = парс.выражение()
                если стр_равны(оп_диап, "..="):
                    диап.знач2 = 1
                парс.жди("]")
                рез = узел(У_СРЕЗ, ток.строка)
                рез.а = выр
                рез.б = диап
                выр = рез
                следующий
            парс.жди("]")
            рез = узел(У_ИНДЕКС, ток.строка)
            рез.а = выр
            рез.б = инд
            выр = рез
            следующий
        если парс.это_оп("{"):
            # литерал записи/массива: Имя{...} или Имя[N]{...}
            парс.далее()
            рез = узел(У_ЛИТТИП, ток.строка)
            рез.дети = список_новый()
            если не парс.это_оп("}"):
                вечно:
                    арг *Узел = узел(У_АРГ, парс.ток().строка)
                    арг.текст = пусто как стр
                    если парс.ток().вид == ТК_ИМЯ:
                        след *Токен = парс.ток1(1)
                        если след.вид == ТК_ОП и стр_равны(след.текст, ":"):
                            арг.текст = парс.далее().текст
                            парс.далее()
                    арг.а = парс.выражение()
                    у_добавь(рез, арг)
                    если не парс.это_оп(","):
                        хватит
                    парс.далее()
            парс.жди("}")
            рез.а = парс.тип_из_атома(выр, ток.строка)
            выр = рез
            следующий
        если парс.это_оп("("):
            парс.далее()
            рез = узел(У_ВЫЗОВ, ток.строка)
            рез.а = выр
            рез.дети = список_новый()
            если не парс.это_оп(")"):
                вечно:
                    арг = узел(У_АРГ, парс.ток().строка)
                    арг.текст = пусто как стр
                    если парс.ток().вид == ТК_ИМЯ:
                        след = парс.ток1(1)
                        если след.вид == ТК_ОП и стр_равны(след.текст, "="):
                            арг.текст = парс.далее().текст
                            парс.далее()
                    арг.а = парс.выражение()
                    у_добавь(рез, арг)
                    если не парс.это_оп(","):
                        хватит
                    парс.далее()
            парс.жди(")")
            выр = рез
            следующий
        хватит
    верни выр

