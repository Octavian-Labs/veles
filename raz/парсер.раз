функ (п *Парсер) постфикс_выр() *Узел:
    e := п.атом()
    вечно:
        т := п.ток()
        если п.это_оп("."):
            п.далее()
            у := узел(У_ПОЛЕ, т.строка)
            у.а = e
            у.текст = п.жди_имя()
            e = у
            следующий
        если п.это_оп("["):
            п.далее()
            инд := п.выражение()
            если п.это_оп("..") или п.это_оп("..="):
                вкл := п.далее().текст
                диап := узел(У_ДИАП, т.строка)
                диап.а = инд
                диап.б = п.выражение()
                если стр_равны(вкл, "..="):
                    диап.знач2 = 1
                п.жди("]")
                у := узел(У_СРЕЗ, т.строка)
                у.а = e
                у.б = диап
                e = у
                следующий
            п.жди("]")
            у := узел(У_ИНДЕКС, т.строка)
            у.а = e
            у.б = инд
            e = у
            следующий
        если п.это_оп("{"):
            # литерал записи/массива: Имя{...} или Имя[N]{...}
            п.далее()
            у := узел(У_ЛИТТИП, т.строка)
            у.дети = список_новый()
            если не п.это_оп("}"):
                вечно:
                    арг := узел(У_АРГ, п.ток().строка)
                    арг.текст = пусто как стр
                    если п.ток().вид == ТК_ИМЯ:
                        n := п.ток1(1)
                        если n.вид == ТК_ОП и стр_равны(n.текст, ":"):
                            арг.текст = п.далее().текст
                            п.далее()
                    арг.а = п.выражение()
                    у_добавь(у, арг)
                    если не п.это_оп(","):
                        хватит
                    п.далее()
            п.жди("}")
            у.а = п.тип_из_атома(e, т.строка)
            e = у
            следующий
        если п.это_оп("("):
            п.далее()
            у := узел(У_ВЫЗОВ, т.строка)
            у.а = e
            у.дети = список_новый()
            если не п.это_оп(")"):
                вечно:
                    арг := узел(У_АРГ, п.ток().строка)
                    арг.текст = пусто как стр
                    если п.ток().вид == ТК_ИМЯ:
                        n := п.ток1(1)
                        если n.вид == ТК_ОП и стр_равны(n.текст, "="):
                            арг.текст = п.далее().текст
                            п.далее()
                    арг.а = п.выражение()
                    у_добавь(у, арг)
                    если не п.это_оп(","):
                        хватит
                    п.далее()
            п.жди(")")
            e = у
            следующий
        хватит
    верни e

функ (п *Парсер) тип_из_атома(e *Узел, строка без64) *Узел:
    # атом-имя → тип для литерала: Точка{..} или Тип[N]{..}
    у := узел(У_ТИП, строка)
    если e.вид == У_ИМЯ:
        у.знач = ТВ_ИМЯ
        у.текст = e.текст
        верни у
    если e.вид == У_ИНДЕКС и e.а.вид == У_ИМЯ:
        база := узел(У_ТИП, строка)
        база.знач = ТВ_ИМЯ
        база.текст = e.а.текст
        у.знач = ТВ_МАСС
        у.а = база
        если e.б.вид == У_ЧИСЛО:
            у.знач2 = e.б.знач
        иначе:
            п_ош("длина массива — число", строка)
        верни у
    п_ош("литерал ожидает тип: Точка{..} или Тип[N]{..}", строка)
    верни у

функ (п *Парсер) атом() *Узел:
    т := п.ток()
    если т.вид == ТК_ЧИСЛО:
        п.далее()
        у := узел(У_ЧИСЛО, т.строка)
        у.знач = т.знач
        верни у
    если т.вид == ТК_СТР:
        п.далее()
        у := узел(У_СТР, т.строка)
        у.текст = т.текст
        верни у
    если т.вид == ТК_ИМЯ:
        если стр_равны(т.текст, "да"):
            п.далее()
            у := узел(У_БУЛ, т.строка)
            у.знач = 1
            верни у
        если стр_равны(т.текст, "нет"):
            п.далее()
            у := узел(У_БУЛ, т.строка)
            верни у
        если стр_равны(т.текст, "пусто"):
            п.далее()
            верни узел(У_ПУСТО, т.строка)
        если стр_равны(т.текст, "новый"):
            п.далее()
            п.жди("(")
            у := узел(У_НОВЫЙ, т.строка)
            у.а = п.тип()
            п.жди(")")
            верни у
        если стр_равны(т.текст, "размер"):
            п.далее()
            п.жди("(")
            # пробуем тип, иначе — выражение
            save := п.i
            у := узел(У_РАЗМЕР, т.строка)
            ок := _пробуй_тип(п)
            если ок != пусто и п.это_оп(")"):
                п.далее()
                у.а = ок
                у.знач2 = 1
                верни у
            п.i = save
            у.а = п.выражение()
            п.жди(")")
            верни у
    если п.это_оп("("):
        п.далее()
        e := п.выражение()
        п.жди(")")
        верни e
    если т.вид == ТК_ИМЯ:
        п.далее()
        верни у_имя(т.текст, т.строка)
    п_ош("неожиданный токен", т.строка)
    верни пусто как *Узел

функ _пробуй_тип(п *Парсер) *Узел:
    # размер(Тип): попытка разбора типа; при неудаче — пусто и откат нет
    # (вызывающий сам восстанавливает позицию)
    верни п.тип()

функ разбери(исх стр) *Узел:
    п *Парсер = новый(Парсер)
    п.т = токенизируй(исх)
    п.i = 0
    п.исх = исх
    верни п.программа()
