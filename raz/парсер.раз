        рез = узел(У_ВНЕШ, строка)
        рез.текст2 = длл.текст
        парс.жди("функ")
        рез.текст = парс.жди_имя()
        рез.дети = парс.параметры()
        рез.а = парс.тип_возврата()
        парс.конец_строки()
