        верни рез
    # сырые строки мин..макс, общий отступ срезаем
    мин_отступ размер = 1000000
    ном размер = мин
    пока ном <= макс:
        сырая стр = _линия(парс.исх, ном)
        если _непустая(сырая):
            отступ размер = _отступ(сырая)
            если отступ < мин_отступ:
                мин_отступ = отступ
        ном += 1
    ном = мин
    пока ном <= макс:
        сырая = _линия(парс.исх, ном)
        если _непустая(сырая):
            элем *Узел = узел(У_СТР, ном)
            элем.текст = стр_срез(сырая, мин_отступ, сырая.длина)
            у_добавь(рез, элем)
        иначе:
            элем = узел(У_СТР, ном)
            элем.текст = стр_срез(парс.исх, 0, 0)
            у_добавь(рез, элем)
        ном += 1
    верни рез

открыто функ _линия(исх стр, нужная размер) стр:
    # сырая строка №но (1-нумерация), без \n и \r
    нач размер = 0
    ном размер = 1
    поз размер = 0
    пока поз < исх.длина:
        если исх.данные[поз] == 10:
            если ном == нужная:
                верни стр_срез(исх, нач, поз)
            ном += 1
            нач = поз + 1
        поз += 1
    если ном == нужная:
        кон размер = исх.длина
        если кон > нач и исх.данные[кон - 1] == 13:
            кон -= 1
        верни стр_срез(исх, нач, кон)
    верни стр_срез(исх, 0, 0)

открыто функ _непустая(текст стр) лог:
    поз размер = 0
    пока поз < текст.длина:
        если текст.данные[поз] != ' ' и текст.данные[поз] != 13:
            верни да
        поз += 1
    верни нет

открыто функ _отступ(текст стр) размер:
    поз размер = 0
    пока поз < текст.длина и текст.данные[поз] == ' ':
        поз += 1
    верни поз

