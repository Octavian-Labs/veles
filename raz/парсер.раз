открыто функ _прим_имя(имя стр, преф стр) лог:
    # «цел.верх»/«нат.старт»: префикс + хвост из одних цифр (UTF-8, «цел» = 6 байт)
    если имя.длина <= преф.длина:
        верни нет
    если не стр_равны(стр_срез(имя, 0, преф.длина), преф):
        верни нет
    для поз в преф.длина..имя.длина:
        если не это_цифра(имя.данные[поз]):
            верни нет
    верни да

открыто функ _пред(парс *Парсер, текст стр, строка размер):
    # предупреждение устаревания в stderr, один раз на конструкцию в файле
    если парс.тихо:
        верни
    вед стр = "разум: предупреждение: "
    если парс.путь.длина > 0:
        вед = стр_склей(вед, стр_склей(парс.путь, ":"))
    вед = стр_склей(вед, стр_склей("строка ", без_в_стр(строка)))
    печать_ош(стр_склей(стр_склей(вед, ": "), стр_склей(текст, "\n")))

открыто функ _уровень_имя(биты размер) стр:
    если биты == 8:
        верни "старт"
    а если биты == 16:
        верни "шаг"
    а если биты == 32:
        верни "рост"
    а если биты == 64:
        верни "верх"
    верни "пик"

открыто функ _тип_имя(парс *Парсер, имя стр, строка размер) *Узел:
    # именованный тип: примитивы, псевдонимы стр/лог/сим/пусто, иначе запись
    рез *Узел = узел(У_ТИП, строка)
    рез.текст = имя
    если стр_равны(имя, "бул") или стр_равны(имя, "лог"):
        если стр_равны(имя, "бул") и не парс.пред_бул:
            _пред(парс, "«бул» устарело — пишите «лог»", строка)
            парс.пред_бул = да
        рез.знач = ТВ_БУЛ
    а если стр_равны(имя, "сим"):
        рез.знач = ТВ_СИМ
    а если стр_равны(имя, "пусто"):
        рез.знач = ТВ_ПУСТО
    а если стр_равны(имя, "стр"):
        рез.знач = ТВ_СТР
    а если стр_равны(имя, "размер"):
        # машинное слово цели для размеров/длин/индексов; x86-64 → без64
        рез.знач = ТВ_БЕЗ
        рез.знач2 = 64
    а если стр_равны(имя, "смещение"):
        # машинное слово со знаком для смещений и «позиция или -1»
        рез.знач = ТВ_ЦЕЛ
        рез.знач2 = 64
    а если _прим_имя(имя, "вещ"):
        # машинное имя вещественного типа (интерфейс .рми): вещ32/вещ64
        биты2 размер = стр_число(стр_срез(имя, 6, имя.длина)) как размер
        если биты2 != 32 и биты2 != 64:
            п_ош(стр_склей("неизвестный вещественный тип: ", имя), строка, 0)
        рез.знач = ТВ_ВЕЩ
        рез.знач2 = биты2
    а если _прим_имя(имя, "цел") или _прим_имя(имя, "без"):
        рез.знач = ТВ_БЕЗ
        если _прим_имя(имя, "цел"):
            рез.знач = ТВ_ЦЕЛ
        биты размер = стр_число(стр_срез(имя, 6, имя.длина)) как размер
        рез.знач2 = биты
        если не парс.пред_плос:
            сем стр = "нат"
            если _прим_имя(имя, "цел"):
                сем = "цел"
            _пред(парс, стр_склей(стр_склей("плоский тип «", имя),
                стр_склей(стр_склей("» устарел — пишите «", сем),
                стр_склей(стр_склей(".", _уровень_имя(биты)), "»"))), строка)
            парс.пред_плос = да
    иначе:
        рез.знач = ТВ_ИМЯ
    верни рез

открыто функ _уровень_биты(уровень стр) размер:
    если стр_равны(уровень, "старт"):
        верни 8
    если стр_равны(уровень, "шаг"):
        верни 16
    если стр_равны(уровень, "рост"):
        верни 32
    если стр_равны(уровень, "верх"):
        верни 64
    если стр_равны(уровень, "пик"):
        верни 128
    верни 0

открыто функ _тип_уровень(семейство стр, уровень стр, строка размер, столб размер) *Узел:
    # составной тип семейства: «цел.верх», «нат.рост», «вещ.верх»
    биты размер = _уровень_биты(уровень)
    если биты == 0:
        п_ош(стр_склей("неизвестный уровень типа: ", уровень),
            строка, столб)
    если стр_равны(семейство, "вещ"):
        если биты != 32 и биты != 64:
            п_ош("пока реализованы только «вещ.рост» (f32) и «вещ.верх» (f64)",
                строка, столб)
        рв *Узел = узел(У_ТИП, строка)
        рв.знач = ТВ_ВЕЩ
        рв.знач2 = биты
        рв.текст = стр_склей("вещ", без_в_стр(биты как нат.верх))
        верни рв
    если биты == 128:
        п_ош("уровень «пик» (128 бит) пока не поддержан", строка, столб)
    рез *Узел = узел(У_ТИП, строка)
    рез.знач2 = биты
    суффикс стр = стр_склей("", без_в_стр(биты))
    если стр_равны(семейство, "цел"):
        рез.знач = ТВ_ЦЕЛ
        рез.текст = стр_склей("цел", суффикс)
    иначе:
        рез.знач = ТВ_БЕЗ
        рез.текст = стр_склей("без", суффикс)
    верни рез

открыто функ _это_семейство(имя стр) лог:
    верни (стр_равны(имя, "цел") или стр_равны(имя, "нат") или
       стр_равны(имя, "вещ"))

открыто функ (парс *Парсер) тип() *Узел:
    строка размер = парс.ток().строка
    если парс.это_оп("*"):
        парс.далее()
        рез *Узел = узел(У_ТИП, строка)
        рез.знач = ТВ_УКАЗ
        рез.а = парс.тип()
        верни рез
    если парс.это_оп("["):
        парс.далее()
        парс.жди("]")
        рез = узел(У_ТИП, строка)
        рез.знач = ТВ_СРЕЗ
        рез.а = парс.тип()
        верни рез
    если парс.это("функ"):
        парс.далее()
        парс.жди("(")
        рез = узел(У_ТИП, строка)
        рез.знач = ТВ_ФУНК
        рез.дети = список_новый()
        если не парс.это(")"):
            вечно:
                у_добавь(рез, парс.тип())
                если не парс.это(","):
                    хватит
                парс.далее()
        парс.жди(")")
        если парс.это(":"):
            рез.б = пусто как *Узел
        иначе:
            рез.б = парс.тип()
        верни рез
    ток *Токен = парс.ток()
    если ток.вид != ТК_ИМЯ:
        п_ожидал("тип", ток)
    парс.далее()
    если стр_равны(ток.текст, "век"):
        # век <элемент> х N — вектор фиксированной ширины (SIMD)
        рез = узел(У_ТИП, строка)
        рез.знач = ТВ_ВЕК
        рез.а = парс.тип()
        если не (парс.ток().вид == ТК_ИМЯ и стр_равны(парс.ток().текст, "х")):
            п_ожидал("«х» и число лейнов: «век вещ.рост х 4»", парс.ток())
        парс.далее()
        ток_лейнов *Токен = парс.ток()
        если ток_лейнов.вид != ТК_ЧИСЛО:
            п_ош("число лейнов вектора — число",
                ток_лейнов.строка, ток_лейнов.столб)
        парс.далее()
        рез.знач2 = ток_лейнов.знач
        рез.текст = "век"
    а если _век_компакт(ток.текст) и парс.тихо:
        # компактная форма интерфейса .рми: «век4:вещ32»
        рез = узел(У_ТИП, строка)
        рез.знач = ТВ_ВЕК
        рез.текст = "век"
        рез.знач2 = (стр_число(стр_срез(ток.текст, 6,
            ток.текст.длина))) как нат.верх
        если не парс.это_оп(":"):
            п_ожидал("«:» после числа лейнов: «век4:вещ32»", парс.ток())
        парс.далее()
        рез.а = парс.тип()
    а если _это_семейство(ток.текст):
        если парс.это_оп("."):
            парс.далее()
            ток_уров *Токен = парс.ток()
            если ток_уров.вид != ТК_ИМЯ:
                п_ожидал("уровень типа (старт|шаг|рост|верх|пик)", ток_уров)
            парс.далее()
            рез = _тип_уровень(ток.текст, ток_уров.текст, ток.строка, ток.столб)
        иначе:
            п_ош(стр_склей(ток.текст,
                " — семейство типов: нужен уровень, например «цел.верх»"),
                ток.строка, ток.столб)
            рез = _тип_имя(парс, ток.текст, ток.строка)
    иначе:
        рез = _тип_имя(парс, ток.текст, ток.строка)
    # постфиксные [N] и []
    пока парс.это_оп("["):
        парс.далее()
        если парс.это_оп("]"):
            парс.далее()
            нов_уз *Узел = узел(У_ТИП, строка)
            нов_уз.знач = ТВ_СРЕЗ
            нов_уз.а = рез
            рез = нов_уз
        иначе:
            ток_длина *Токен = парс.ток()
            если ток_длина.вид != ТК_ЧИСЛО:
                п_ош("длина массива — число", ток_длина.строка, ток_длина.столб)
            парс.далее()
            парс.жди("]")
            нов_уз = узел(У_ТИП, строка)
            нов_уз.знач = ТВ_МАСС
            нов_уз.а = рез
            нов_уз.знач2 = ток_длина.знач
            рез = нов_уз
    верни рез

