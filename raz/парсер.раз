открыто функ (парс *Парсер) оператор() *Узел:
    ток *Токен = парс.ток()
    строка размер = ток.строка
    если ток.вид == ТК_ИМЯ:
        имя стр = ток.текст
        если стр_равны(имя, "верни"):
            парс.далее()
            вид нат.верх = парс.ток().вид
            рез *Узел = узел(У_ВЕРНИ, строка)
            если вид == ТК_НС или вид == ТК_СНЯТИЕ или вид == ТК_КФ:
                рез.а = пусто как *Узел
            иначе:
                рез.а = парс.выражение()
            верни парс.постфикс(рез)
        если стр_равны(имя, "хватит"):
            парс.далее()
            верни парс.постфикс(узел(У_ХВАТИТ, строка))
        если стр_равны(имя, "следующий"):
            парс.далее()
            верни парс.постфикс(узел(У_СЛЕДУЮЩИЙ, строка))
        если стр_равны(имя, "отложи"):
            парс.далее()
            рез = узел(У_ОТЛОЖИ, строка)
            рез.а = парс.выражение()
            верни парс.постфикс(рез)
        если стр_равны(имя, "если"):
            верни парс.если_(строка)
        если стр_равны(имя, "пока"):
            парс.далее()
            рез = узел(У_ПОКА, строка)
            рез.а = парс.выражение()
            рез.дети = парс.блок()
            верни рез
        если стр_равны(имя, "вечно"):
            парс.далее()
            рез = узел(У_ВЕЧНО, строка)
            рез.дети = парс.блок()
            верни рез
        если стр_равны(имя, "для"):
            верни парс.для_(строка)
        если стр_равны(имя, "выбор"):
            верни парс.выбор_(строка)
        если стр_равны(имя, "искра"):
            верни парс.искра_(строка)
        если стр_равны(имя, "конст"):
            парс.далее()
            рез = узел(У_КОНСТ, строка)
            рез.текст = парс.жди_имя()
            парс.жди("=")
            рез.а = парс.выражение()
            верни рез
        если стр_равны(имя, "введи"):
            # «введи имя = выражение» — объявление с выводом типа
            парс.далее()
            рез = узел(У_ОБЪЯВЛ, строка)
            рез.текст = парс.жди_имя()
            парс.жди("=")
            рез.а = пусто как *Узел
            рез.б = парс.выражение()
            рез.знач2 = 1            # введи — вывод типа, не устаревшее «:=»
            верни парс.постфикс(рез)
    # объявление / присваивание / выражение
    след1 *Токен = парс.ток1(1)
    если ток.вид == ТК_ИМЯ и след1.вид == ТК_ОП и стр_равны(след1.текст, ":="):
        парс.далее()
        парс.далее()
        рез = узел(У_ОБЪЯВЛ, строка)
        рез.текст = ток.текст
        рез.а = пусто как *Узел
        рез.б = парс.выражение()
        верни парс.постфикс(рез)
    если ток.вид == ТК_ИМЯ и парс.тип_после_имени():
        рез = узел(У_ОБЪЯВЛ, строка)
        рез.текст = ток.текст
        парс.далее()
        рез.а = парс.тип()
        если парс.это_оп("="):
            парс.далее()
            рез.б = парс.выражение()
        верни парс.постфикс(рез)
    выр *Узел = парс.выражение()
    ток2 *Токен = парс.ток()
    если _оп_присв(ток2):
        оп стр = парс.далее().текст
        рез = узел(У_ПРИСВ, строка)
        рез.а = выр
        рез.б = парс.выражение()
        рез.текст = оп
        верни парс.постфикс(рез)
    рез = узел(У_ВЫРОП, строка)
    рез.а = выр
    верни парс.постфикс(рез)

открыто функ (парс *Парсер) тип_после_имени() лог:
    # «ИМЯ тип ...» — объявление с явным типом
    ток *Токен = парс.ток1(1)
    если ток.вид == ТК_ИМЯ:
        текст стр = ток.текст
        если (стр_равны(текст, "бул") или стр_равны(текст, "лог") или
            стр_равны(текст, "сим") или стр_равны(текст, "пусто") или
            стр_равны(текст, "стр") или стр_равны(текст, "функ") или
            стр_равны(текст, "век")):
            верни да
        если _это_семейство(текст):
            # составной тип «цел.верх»: после семейства — точка и уровень
            след2 *Токен = парс.ток1(2)
            если след2.вид == ТК_ОП и стр_равны(след2.текст, "."):
                след3 *Токен = парс.ток1(3)
                верни след3.вид == ТК_ИМЯ
            верни (след2.вид == ТК_ОП и (стр_равны(след2.текст, "=") или
                   стр_равны(след2.текст, "["))) или след2.вид == ТК_НС
        если (стр_равны(текст, "цел8") или стр_равны(текст, "цел16") или
            стр_равны(текст, "цел32") или стр_равны(текст, "цел64") или
            стр_равны(текст, "без8") или стр_равны(текст, "без16") или
            стр_равны(текст, "без32") или стр_равны(текст, "без64") или
            стр_равны(текст, "вещ64")):
            верни да
        # имя записи: за ним =, [ или конец строки
        ток2 *Токен = парс.ток1(2)
        верни (ток2.вид == ТК_ОП и (стр_равны(ток2.текст, "=") или
               стр_равны(ток2.текст, "["))) или ток2.вид == ТК_НС
    если ток.вид == ТК_ОП и (стр_равны(ток.текст, "*") или
       стр_равны(ток.текст, "[")):
        если стр_равны(ток.текст, "["):
            ток2 = парс.ток1(2)
            верни ток2.вид == ТК_ОП и стр_равны(ток2.текст, "]")
        верни да
    верни нет

