# парсер — рекурсивный спуск по грамматике РАЗУМА (версия на самом РАЗУМЕ).
# Порт src/razum/parser.py: отступные блоки, группы параметров как в Go,
# постфиксные если/пока, блок искра: вырезает сырой текст из исходника.

взять основа
взять лексер, узлы

запись Парсер:
    т *Список       # токены
    i без64
    исх стр         # исходник — нужен для искра:-блоков

функ п_ош(текст стр, строка без64):
    печать("разум.парсер: строка ")
    печатьцел(строка как цел64)
    печать(": ")
    печатьстр(текст)
    выход(1)

функ (п *Парсер) ток() *Токен:
    если п.i < п.т.длина:
        верни список_получи(п.т, п.i) как *Токен
    верни список_получи(п.т, п.т.длина - 1) как *Токен

функ (п *Парсер) ток1(k без64) *Токен:
    если п.i + k < п.т.длина:
        верни список_получи(п.т, п.i + k) как *Токен
    верни список_получи(п.т, п.т.длина - 1) как *Токен

функ (п *Парсер) это(знач стр) бул:
    т := п.ток()
    верни (т.вид == ТК_ОП или т.вид == ТК_ИМЯ) и стр_равны(т.текст, знач)

функ (п *Парсер) это_оп(знач стр) бул:
    т := п.ток()
    верни т.вид == ТК_ОП и стр_равны(т.текст, знач)

функ (п *Парсер) далее() *Токен:
    т := п.ток()
    п.i += 1
    верни т

функ (п *Парсер) жди(знач стр):
    т := п.ток()
    если не ((т.вид == ТК_ОП или т.вид == ТК_ИМЯ) и стр_равны(т.текст, знач)):
        п_ош(стр_склей(стр_склей("ожидалось '", знач), "'"), т.строка)
    п.i += 1

функ (п *Парсер) жди_имя() стр:
    т := п.ток()
    если т.вид != ТК_ИМЯ:
        п_ош("ожидалось имя", т.строка)
    п.i += 1
    верни т.текст

функ (п *Парсер) жди_вид(вид без64):
    т := п.ток()
    если т.вид != вид:
        п_ош("неожиданный вид токена", т.строка)
    п.i += 1

функ (п *Парсер) пропусти_нс():
    пока п.ток().вид == ТК_НС:
        п.i += 1

функ (п *Парсер) конец_строки():
    в := п.ток().вид
    если в != ТК_НС и в != ТК_КФ и в != ТК_СНЯТИЕ:
        п_ош("лишний текст в конце строки", п.ток().строка)

# --- типы ---------------------------------------------------------------------

функ (п *Парсер) тип() *Узел:
    строка := п.ток().строка
    если п.это_оп("*"):
        п.далее()
        у := узел(У_ТИП, строка)
        у.знач = ТВ_УКАЗ
        у.а = п.тип()
        верни у
    если п.это_оп("["):
        п.далее()
        п.жди("]")
        у := узел(У_ТИП, строка)
        у.знач = ТВ_СРЕЗ
        у.а = п.тип()
        верни у
    если п.это("функ"):
        п.далее()
        п.жди("(")
        у := узел(У_ТИП, строка)
        у.знач = ТВ_ФУНК
        у.дети = список_новый()
        если не п.это(")"):
            вечно:
                у_добавь(у, п.тип())
                если не п.это(","):
                    хватит
                п.далее()
        п.жди(")")
        если п.это(":"):
            у.б = пусто как *Узел
        иначе:
            у.б = п.тип()
        верни у
    т := п.ток()
    если т.вид != ТК_ИМЯ:
        п_ош("ожидался тип", т.строка)
    п.далее()
    у := узел(У_ТИП, т.строка)
    имя := т.текст
    если стр_равны(имя, "бул"):
        у.знач = ТВ_БУЛ
    а если стр_равны(имя, "сим"):
        у.знач = ТВ_СИМ
    а если стр_равны(имя, "пусто"):
        у.знач = ТВ_ПУСТО
    а если стр_равны(имя, "стр"):
        у.знач = ТВ_СТР
    а если (имя.длина >= 4 и имя.данные[0] == 'ц' и имя.данные[1] == 'е'
            и имя.данные[2] == 'л'):
        у.знач = ТВ_ЦЕЛ
        у.текст = имя
    а если (имя.длина >= 4 и имя.данные[0] == 'б' и имя.данные[1] == 'е'
            и имя.данные[2] == 'з'):
        у.знач = ТВ_БЕЗ
        у.текст = имя
    иначе:
        у.знач = ТВ_ИМЯ
        у.текст = имя
    # постфиксные [N] и []
    пока п.это_оп("["):
        п.далее()
        если п.это_оп("]"):
            п.далее()
            ну := узел(У_ТИП, строка)
            ну.знач = ТВ_СРЕЗ
            ну.а = у
            у = ну
        иначе:
            n := п.ток()
            если n.вид != ТК_ЧИСЛО:
                п_ош("длина массива — число", n.строка)
            п.далее()
            п.жди("]")
            ну := узел(У_ТИП, строка)
            ну.знач = ТВ_МАСС
            ну.а = у
            ну.знач2 = n.знач
            у = ну
    верни у

функ (п *Парсер) тип_возврата() *Узел:
    если п.это_оп(":"):
        верни пусто как *Узел
    верни п.тип()

# --- блоки --------------------------------------------------------------------

функ (п *Парсер) блок() *Список:
    п.жди(":")
    тело := список_новый()
    если п.ток().вид != ТК_НС:
        список_добавь(тело, п.оператор() как без64)
        верни тело
    п.пропусти_нс()
    если п.ток().вид != ТК_ОТСТУП:
        п_ош("ожидался отступный блок", п.ток().строка)
    п.далее()
    пока п.ток().вид != ТК_СНЯТИЕ и п.ток().вид != ТК_КФ:
        если п.ток().вид == ТК_НС:
            п.далее()
            следующий
        список_добавь(тело, п.оператор() как без64)
    если п.ток().вид == ТК_СНЯТИЕ:
        п.далее()
    верни тело

# --- верхний уровень ------------------------------------------------------------

функ (п *Парсер) программа() *Узел:
    прог := узел(У_ПРОГ, 0)
    прог.дети = список_новый()
    п.пропусти_нс()
    пока п.ток().вид != ТК_КФ:
        у_добавь(прог, п.объявление())
        п.пропусти_нс()
    верни прог

функ (п *Парсер) объявление() *Узел:
    т := п.ток()
    строка := т.строка
    если п.это("взять"):
        п.далее()
        у := узел(У_ВЗЯТЬ, строка)
        у.дети = список_новый()
        у_добавь(у, у_имя(п.жди_имя(), строка))
        пока п.это_оп(","):
            п.далее()
            у_добавь(у, у_имя(п.жди_имя(), строка))
        п.конец_строки()
        верни у
    если п.это("внеш"):
        п.далее()
        длл := п.ток()
        если длл.вид != ТК_СТР:
            п_ош("внеш: ожидалась строка с именем DLL", длл.строка)
        п.далее()
        у := узел(У_ВНЕШ, строка)
        у.текст2 = длл.текст
        п.жди("функ")
        у.текст = п.жди_имя()
        у.дети = п.параметры()
        у.а = п.тип_возврата()
        п.конец_строки()
        верни у
    если п.это("функ"):
        п.далее()
        у := узел(У_ФУНК, строка)
        у.в = пусто как *Узел
        если п.это_оп("("):
            # метод: функ (т Точка) имя(...)
            п.далее()
            прм := узел(У_ПАРАМ, строка)
            прм.текст = п.жди_имя()
            прм.а = п.тип()
            п.жди(")")
            у.в = прм
        у.текст = п.жди_имя()
        у.дети = п.параметры()
        у.а = п.тип_возврата()
        у.дети2 = п.блок()
        верни у
    если п.это("конст"):
        п.далее()
        у := узел(У_КОНСТ, строка)
        у.текст = п.жди_имя()
        п.жди("=")
        у.а = п.выражение()
        п.конец_строки()
        верни у
    если п.это("тип"):
        п.далее()
        у := узел(У_ТИПСИН, строка)
        у.текст = п.жди_имя()
        п.жди("=")
        у.а = п.тип()
        п.конец_строки()
        верни у
    если п.это("запись"):
        п.далее()
        у := узел(У_ЗАПИСЬ, строка)
        у.текст = п.жди_имя()
        у.дети = п.поля_записи()
        верни у
    если п.это("переч"):
        п.далее()
        у := узел(У_ПЕРЕЧ, строка)
        у.текст = п.жди_имя()
        п.жди(":")
        п.пропусти_нс()
        п.жди_вид(ТК_ОТСТУП)
        у.дети = список_новый()
        номер без64 = 0
        пока п.ток().вид != ТК_СНЯТИЕ и п.ток().вид != ТК_КФ:
            если п.ток().вид == ТК_НС:
                п.далее()
                следующий
            э := у_имя(п.жди_имя(), п.ток().строка)
            э.знач = номер
            номер += 1
            у_добавь(у, э)
            п.конец_строки()
        если п.ток().вид == ТК_СНЯТИЕ:
            п.далее()
        верни у
    п_ош("ожидалось объявление", строка)
    верни пусто как *Узел

функ (п *Парсер) параметры() *Список:
    # имя {, имя} тип — последний идентификатор группы является типом
    п.жди("(")
    список := список_новый()
    пока не п.это(")"):
        имена := список_новый()
        список_добавь(имена, у_имя(п.жди_имя(), п.ток().строка) как без64)
        тип := пусто как *Узел
        пока п.это_оп(","):
            nxt := п.ток1(1)
            nxt2 := п.ток1(2)
            если (nxt.вид == ТК_ИМЯ и nxt2.вид == ТК_ОП и
                стр_равны(nxt2.текст, ",")):
                п.далее()
                список_добавь(имена,
                    у_имя(п.жди_имя(), п.ток().строка) как без64)
                следующий
            если nxt.вид == ТК_ИМЯ и (nxt2.вид == ТК_ИМЯ или
               (nxt2.вид == ТК_ОП и
                (стр_равны(nxt2.текст, "*") или стр_равны(nxt2.текст, "[")))):
                п.далее()
                список_добавь(имена,
                    у_имя(п.жди_имя(), п.ток().строка) как без64)
                следующий
            п.далее()
            тип = п.тип()
            хватит
        если тип == пусто:
            # тип идёт сразу за именем: «а цел64»
            tt := п.ток()
            если tt.вид != ТК_ИМЯ и не (tt.вид == ТК_ОП и
               (стр_равны(tt.текст, "*") или стр_равны(tt.текст, "["))):
                п_ош("параметру не указан тип", tt.строка)
            тип = п.тип()
        для i в 0..имена.длина:
            имя := список_получи(имена, i) как *Узел
            прм := узел(У_ПАРАМ, имя.строка)
            прм.текст = имя.текст
            прм.а = тип
            список_добавь(список, прм как без64)
        если п.это_оп(","):
            п.далее()
        иначе:
            хватит
    п.жди(")")
    верни список

функ (п *Парсер) поля_записи() *Список:
    п.жди(":")
    п.пропусти_нс()
    п.жди_вид(ТК_ОТСТУП)
    поля := список_новый()
    пока п.ток().вид != ТК_СНЯТИЕ и п.ток().вид != ТК_КФ:
        если п.ток().вид == ТК_НС:
            п.далее()
            следующий
        пл := узел(У_ПАРАМ, п.ток().строка)
        пл.текст = п.жди_имя()
        пл.а = п.тип()
        список_добавь(поля, пл как без64)
        п.конец_строки()
    если п.ток().вид == ТК_СНЯТИЕ:
        п.далее()
    верни поля

# --- операторы ------------------------------------------------------------------

функ (п *Парсер) оператор() *Узел:
    т := п.ток()
    строка := т.строка
    если т.вид == ТК_ИМЯ:
        v := т.текст
        если стр_равны(v, "верни"):
            п.далее()
            в := п.ток().вид
            у := узел(У_ВЕРНИ, строка)
            если в == ТК_НС или в == ТК_СНЯТИЕ или в == ТК_КФ:
                у.а = пусто как *Узел
            иначе:
                у.а = п.выражение()
            верни п.постфикс(у)
        если стр_равны(v, "хватит"):
            п.далее()
            верни п.постфикс(узел(У_ХВАТИТ, строка))
        если стр_равны(v, "следующий"):
            п.далее()
            верни п.постфикс(узел(У_СЛЕДУЮЩИЙ, строка))
        если стр_равны(v, "отложи"):
            п.далее()
            у := узел(У_ОТЛОЖИ, строка)
            у.а = п.выражение()
            верни п.постфикс(у)
        если стр_равны(v, "если"):
            верни п.если_(строка)
        если стр_равны(v, "пока"):
            п.далее()
            у := узел(У_ПОКА, строка)
            у.а = п.выражение()
            у.дети = п.блок()
            верни у
        если стр_равны(v, "вечно"):
            п.далее()
            у := узел(У_ВЕЧНО, строка)
            у.дети = п.блок()
            верни у
        если стр_равны(v, "для"):
            верни п.для_(строка)
        если стр_равны(v, "выбор"):
            верни п.выбор_(строка)
        если стр_равны(v, "искра"):
            верни п.искра_(строка)
        если стр_равны(v, "конст"):
            п.далее()
            у := узел(У_КОНСТ, строка)
            у.текст = п.жди_имя()
            п.жди("=")
            у.а = п.выражение()
            верни у
    # объявление / присваивание / выражение
    n1 := п.ток1(1)
    если т.вид == ТК_ИМЯ и n1.вид == ТК_ОП и стр_равны(n1.текст, ":="):
        п.далее()
        п.далее()
        у := узел(У_ОБЪЯВЛ, строка)
        у.текст = т.текст
        у.а = пусто как *Узел
        у.б = п.выражение()
        верни п.постфикс(у)
    если т.вид == ТК_ИМЯ и п.тип_после_имени():
        у := узел(У_ОБЪЯВЛ, строка)
        у.текст = т.текст
        п.далее()
        у.а = п.тип()
        если п.это_оп("="):
            п.далее()
            у.б = п.выражение()
        верни п.постфикс(у)
    выр := п.выражение()
    если п.ток().вид == ТК_ОП и (стр_равны(п.ток().текст, "=") или
       стр_равны(п.ток().текст, "+=") или стр_равны(п.ток().текст, "-=") или
       стр_равны(п.ток().текст, "*=") или стр_равны(п.ток().текст, "/=") или
       стр_равны(п.ток().текст, "%=") или стр_равны(п.ток().текст, "&=") или
       стр_равны(п.ток().текст, "|=") или стр_равны(п.ток().текст, "^=")):
        оп := п.далее().текст
        у := узел(У_ПРИСВ, строка)
        у.а = выр
        у.б = п.выражение()
        у.текст = оп
        верни п.постфикс(у)
    у := узел(У_ВЫРОП, строка)
    у.а = выр
    верни п.постфикс(у)

функ (п *Парсер) тип_после_имени() бул:
    # «ИМЯ тип ...» — объявление с явным типом
    т := п.ток1(1)
    если т.вид == ТК_ИМЯ:
        s := т.текст
        если (стр_равны(s, "бул") или стр_равны(s, "сим") или
            стр_равны(s, "пусто") или стр_равны(s, "стр") или
            стр_равны(s, "функ")):
            верни да
        если s.длина >= 4 и ((s.данные[0] == 'ц' и s.данные[1] == 'е' и
           s.данные[2] == 'л') или (s.данные[0] == 'б' и s.данные[1] == 'е'
           и s.данные[2] == 'з')):
            верни да
        # имя записи: за ним =, [ или конец строки
        n2 := п.ток1(2)
        верни (n2.вид == ТК_ОП и (стр_равны(n2.текст, "=") или
               стр_равны(n2.текст, "["))) или n2.вид == ТК_НС
    если т.вид == ТК_ОП и (стр_равны(т.текст, "*") или
       стр_равны(т.текст, "[")):
        если стр_равны(т.текст, "["):
            n2 := п.ток1(2)
            верни n2.вид == ТК_ОП и стр_равны(n2.текст, "]")
        верни да
    верни нет

функ (п *Парсер) постфикс(с *Узел) *Узел:
    # постфиксные 'если'/'пока' после простого оператора
    если п.это("если"):
        строка := п.далее().строка
        рук := узел(У_РУКАВ, строка)
        рук.а = п.выражение()
        рук.дети = список_новый()
        у_добавь(рук, с)
        у := узел(У_ЕСЛИ, строка)
        у.дети = список_новый()
        у_добавь(у, рук)
        верни у
    если п.это("пока"):
        строка := п.далее().строка
        у := узел(У_ПОКА, строка)
        у.а = п.выражение()
        у.дети = список_новый()
        у_добавь(у, с)
        верни у
    верни с

функ (п *Парсер) если_(строка без64) *Узел:
    п.далее()
    у := узел(У_ЕСЛИ, строка)
    у.дети = список_новый()
    рук := узел(У_РУКАВ, строка)
    рук.а = п.выражение()
    рук.дети = п.блок()
    у_добавь(у, рук)
    вечно:
        п.пропусти_нс()
        если п.это("а"):
            n := п.ток1(1)
            если n.вид == ТК_ИМЯ и стр_равны(n.текст, "если"):
                п.далее()
                п.далее()
                р2 := узел(У_РУКАВ, строка)
                р2.а = п.выражение()
                р2.дети = п.блок()
                у_добавь(у, р2)
                следующий
        если п.это("иначе"):
            п.далее()
            у.дети2 = п.блок()
        хватит
    верни у

