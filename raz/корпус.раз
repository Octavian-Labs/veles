# корпус — генератор корпуса ошибок для «мозга редактора» (версия 2).
# Берёт корректные .раз-файлы и делает мутации восьми видов:
#   удалить токен, заменить ключевым словом, дублировать, обмен с
#   соседним, вставить ключевое слово, укоротить идентификатор,
#   удалить строку, заменить именем из того же файла.
# Каждый мутант прогоняется через разум; корпус.tsv содержит метку
# ошибки (фаза, строка, столб, сообщение, код) И пару для ремонта:
# операция «заменить мутант[поз .. поз+дл) на нов» восстанавливает
# исходник (нов экранирован: \\ \n \t).
#
# Запуск: корпус.exe [цели.txt | файл.раз] [N]
#   без аргументов — встроенный список модулей raz/, по 200 мутантов;
#   цели.txt — файл со списком путей .раз по одному на строку;
#   файл.раз — один файл.
# cwd = каталог для резолва «взять» (обычно raz/).

взять основа, лексер, сист.файл, процесс

запись Конт:
    тсв *Буфер
    зерно *нат.верх
    гид цел.верх
    ошибок цел.верх
    чистых цел.верх
    старты *Список
    ключи *Список
    имена *Список

функ _случ(зерно *нат.верх) нат.верх:
    зерно[0] = зерно[0] * 6364136223846793005 + 1442695040888963407
    верни зерно[0] >> 33

функ _слово(арг стр, ном цел.верх) стр:
    # слово ном из конца командной строки
    поз смещение = (арг.длина - 1) как смещение
    пока поз >= 0 и арг.данные[поз как размер] == ' ':
        поз -= 1
    для ит в 0..ном:
        пока поз >= 0 и арг.данные[поз как размер] != ' ':
            поз -= 1
        пока поз >= 0 и арг.данные[поз как размер] == ' ':
            поз -= 1
    кон смещение = поз
    пока поз >= 0 и арг.данные[поз как размер] != ' ':
        поз -= 1
    верни стр_срез(арг, (поз + 1) как размер, (кон + 1) как размер)

# экранирование поля TSV: \ -> \\, перевод -> \n, таб -> \t
функ _эск(текст стр) стр:
    буф *Буфер = буф_новый()
    для и в 0..текст.длина:
        б нат.старт = текст.данные[и]
        если б == 92:
            буф_добавь(буф, "\\\\")
        а если б == 10:
            буф_добавь(буф, "\\n")
        а если б == 9:
            буф_добавь(буф, "\\t")
        иначе:
            буф_сим(буф, б)
    верни буф_стр(буф)

# одна мутация исходника: возвращает мутант, заполняет вид_имя,
# поз/дл/нов — операцию ремонта «заменить [поз,поз+дл) на нов»
функ _мутант(кт *Конт, исх стр, токи *Список, канд *Список,
             вид_имя *стр, поз *размер, дл *размер, нов *стр) стр:
    ик нат.верх = список_получи(канд,
        (_случ(кт.зерно) % (канд.длина как нат.верх)) как размер)
    мтк *Токен = список_получи(токи, ик) как *Токен
    вид нат.верх = _случ(кт.зерно) % 8
    нач размер = (список_получи(кт.старты, мтк.строка - 1) как размер)
    офс размер = нач + мтк.столб - 1
    кон размер = офс + мтк.текст.длина
    вид_имя[0] = "удалить"
    если вид == 0:
        # удалить токен
        поз[0] = офс
        дл[0] = 0
        нов[0] = мтк.текст
        верни стр_склей(стр_срез(исх, 0, офс), стр_срез(исх, кон, исх.длина))
    если вид == 1:
        # заменить случайным ключевым словом
        вид_имя[0] = "заменить"
        слово стр = список_получи(кт.ключи,
            (_случ(кт.зерно) % (кт.ключи.длина как нат.верх)) как размер) как стр
        поз[0] = офс
        дл[0] = слово.длина
        нов[0] = мтк.текст
        верни стр_склей(стр_склей(стр_срез(исх, 0, офс), слово),
                  стр_срез(исх, кон, исх.длина))
    если вид == 2:
        # дублировать токен
        вид_имя[0] = "дублировать"
        поз[0] = офс
        дл[0] = мтк.текст.длина * 2
        нов[0] = мтк.текст
        верни стр_склей(стр_склей(стр_срез(исх, 0, кон), мтк.текст),
                  стр_срез(исх, кон, исх.длина))
    если вид == 3:
        # обмен с соседним кандидатом
        вид_имя[0] = "обмен"
        ик2 нат.верх = список_получи(канд,
            (_случ(кт.зерно) % (канд.длина как нат.верх)) как размер)
        тк2 *Токен = список_получи(токи, ик2) как *Токен
        нач2 размер = (список_получи(кт.старты, тк2.строка - 1) как размер)
        офс2 размер = нач2 + тк2.столб - 1
        кон2 размер = офс2 + тк2.текст.длина
        если офс2 == офс:
            # тот же токен — тождественная операция (чистый мутант)
            поз[0] = офс
            дл[0] = мтк.текст.длина
            нов[0] = мтк.текст
            верни исх
        если офс2 < офс:
            тк3 *Токен = мтк
            мтк = тк2
            тк2 = тк3
            тр размер = офс
            офс = офс2
            офс2 = тр
            тр = кон
            кон = кон2
            кон2 = тр
        поз[0] = офс
        дл[0] = кон2 - офс
        нов[0] = стр_склей(стр_склей(мтк.текст,
            стр_срез(исх, кон, офс2)), тк2.текст)
        верни стр_склей(стр_склей(стр_срез(исх, 0, офс), тк2.текст),
            стр_склей(стр_склей(стр_срез(исх, кон, офс2), мтк.текст),
                стр_срез(исх, кон2, исх.длина)))
    если вид == 4:
        # вставить ключевое слово перед токеном
        вид_имя[0] = "вставить"
        слово = список_получи(кт.ключи,
            (_случ(кт.зерно) % (кт.ключи.длина как нат.верх)) как размер) как стр
        поз[0] = офс
        дл[0] = слово.длина + 1
        нов[0] = ""
        верни стр_склей(стр_склей(стр_склей(стр_срез(исх, 0, офс), слово), " "),
                  стр_срез(исх, офс, исх.длина))
    если вид == 5:
        # укоротить идентификатор на последний кодпоинт (опечатка)
        вид_имя[0] = "укоротить"
        если мтк.вид != ТК_ИМЯ или мтк.текст.длина < 3:
            поз[0] = офс
            дл[0] = 0
            нов[0] = мтк.текст
            верни стр_склей(стр_срез(исх, 0, офс), стр_срез(исх, кон, исх.длина))
        рубеж размер = мтк.текст.длина - 1
        пока рубеж > 0 и (мтк.текст.данные[рубеж] & 0xC0) == 0x80:
            рубеж -= 1
        если рубеж == 0:
            рубеж = 1
        корот стр = стр_срез(мтк.текст, 0, рубеж)
        поз[0] = офс
        дл[0] = корот.длина
        нов[0] = мтк.текст
        верни стр_склей(стр_склей(стр_срез(исх, 0, офс), корот),
                  стр_срез(исх, кон, исх.длина))
    если вид == 6:
        # удалить строку целиком
        вид_имя[0] = "строка"
        стр_кон размер = исх.длина
        если (мтк.строка как размер) < кт.старты.длина:
            стр_кон = (список_получи(кт.старты, мтк.строка) как размер)
        поз[0] = нач
        дл[0] = 0
        нов[0] = стр_срез(исх, нач, стр_кон)
        верни стр_склей(стр_срез(исх, 0, нач), стр_срез(исх, стр_кон, исх.длина))
    # заменить именем другого кандидата того же файла (неверное имя)
    вид_имя[0] = "имя"
    если кт.имена.длина > 0:
        слово = список_получи(кт.имена,
            (_случ(кт.зерно) % (кт.имена.длина как нат.верх)) как размер) как стр
        поз[0] = офс
        дл[0] = слово.длина
        нов[0] = мтк.текст
        верни стр_склей(стр_склей(стр_срез(исх, 0, офс), слово),
                  стр_срез(исх, кон, исх.длина))
    поз[0] = офс
    дл[0] = 0
    нов[0] = мтк.текст
    верни стр_склей(стр_срез(исх, 0, офс), стр_срез(исх, кон, исх.длина))

# прогон одного файла: колво мутантов, строки в общий TSV
функ _файл(кт *Конт, цель стр, колво цел.верх):
    исх стр = файл_прочти(цель)
    если исх == пусто:
        печать("корпус: не читается ")
        печатьстр(цель)
        верни
    токи *Список = токенизируй_ф(исх, цель)
    # начала строк — для перевода (строка, столб) в байтовый офс
    кт.старты = список_новый()
    список_добавь(кт.старты, 0)
    для инд в 0..исх.длина:
        если исх.данные[инд] == 10:
            список_добавь(кт.старты, (инд + 1) как размер)
    # мутабельные токены: ИМЯ и ОП с текстом; имена — для вида «имя»
    канд *Список = список_новый()
    кт.имена = список_новый()
    для инд в 0..токи.длина:
        тк *Токен = список_получи(токи, инд) как *Токен
        если (тк.вид == ТК_ИМЯ или тк.вид == ТК_ОП) и тк.текст.длина > 0:
            список_добавь(канд, инд как размер)
        если тк.вид == ТК_ИМЯ и тк.текст.длина >= 4:
            список_добавь(кт.имена, тк.текст как размер)
    если канд.длина == 0:
        печать("корпус: нет токенов в ")
        печатьстр(цель)
        верни
    для итог в 0..колво:
        вид_имя стр = ""
        поз размер = 0
        дл размер = 0
        нов стр = ""
        мут стр = _мутант(кт, исх, токи, канд, &вид_имя, &поз, &дл, &нов)
        имя_м стр = стр_склей("корпус_мут_",
            стр_склей(цел_в_стр(кт.гид), ".раз"))
        файл_запиши(имя_м, мут)
        имя_о стр = стр_склей("корпус_вых_",
            стр_склей(цел_в_стр(кт.гид), ".txt"))
        код цел.верх = запусти_слей("./разум.exe",
            стр_склей("--файл ", стр_склей(имя_м, " --кэш выкл")),
            имя_м, имя_о)
        # разбор первой строки «разум.<фаза>: ...»
        вых стр = файл_прочти(имя_о)
        фаза стр = "нет"
        линия цел.верх = 0
        столбец цел.верх = 0
        сооб стр = "компилируется"
        если код == -1:
            фаза = "запуск"
            сооб = "сбой_запуска"
        а если вых != пусто:
            позд смещение = стр_найди(вых, "разум.")
            если позд >= 0:
                хвост стр = стр_срез(вых, позд как размер, вых.длина)
                конл смещение = стр_найди(хвост, "\n")
                если конл > 0:
                    хвост = стр_срез(хвост, 0, конл как размер)
                д2 смещение = стр_найди(хвост, ":")
                если д2 > 0:
                    # «разум.» в UTF-8 — 11 байт
                    фаза = стр_срез(хвост, 11, д2 как размер)
                пс смещение = стр_найди(хвост, "строка ")
                если пс >= 0:
                    # «строка » в UTF-8 — 13 байт
                    чис стр = стр_срез(хвост, (пс + 13) как размер, хвост.длина)
                    линия = стр_число(чис)
                    д3 смещение = стр_найди(чис, ":")
                    если д3 >= 0:
                        хв2 стр = стр_срез(чис, (д3 + 1) как размер, чис.длина)
                        столбец = стр_число(хв2)
                        д4 смещение = стр_найди(хв2, ":")
                        если д4 >= 0:
                            сооб = стр_срез(хв2, (д4 + 2) как размер, хв2.длина)
                    если столбец == 0:
                        д4 = стр_найди(чис, ":")
                        если д4 >= 0:
                            сооб = стр_срез(чис, (д4 + 2) как размер, чис.длина)
        если код != 0:
            кт.ошибок += 1
        иначе:
            кт.чистых += 1
        буф_добавь(кт.тсв, цел_в_стр(кт.гид))
        буф_сим(кт.тсв, 9)
        буф_добавь(кт.тсв, цель)
        буф_сим(кт.тсв, 9)
        буф_добавь(кт.тсв, вид_имя)
        буф_сим(кт.тсв, 9)
        буф_добавь(кт.тсв, цел_в_стр(поз как цел.верх))
        буф_сим(кт.тсв, 9)
        буф_добавь(кт.тсв, цел_в_стр(дл как цел.верх))
        буф_сим(кт.тсв, 9)
        буф_добавь(кт.тсв, _эск(нов))
        буф_сим(кт.тсв, 9)
        буф_добавь(кт.тсв, фаза)
        буф_сим(кт.тсв, 9)
        буф_добавь(кт.тсв, цел_в_стр(линия))
        буф_сим(кт.тсв, 9)
        буф_добавь(кт.тсв, цел_в_стр(столбец))
        буф_сим(кт.тсв, 9)
        буф_добавь(кт.тсв, сооб)
        буф_сим(кт.тсв, 9)
        буф_добавь(кт.тсв, цел_в_стр(код))
        буф_сим(кт.тсв, 10)
        кт.гид += 1
    печать("  ")
    печать(цель)
    печать(": мутантов ")
    печатьстр(цел_в_стр(колво))

