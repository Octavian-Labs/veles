    поз смещение = (арг.длина - 1) как смещение
    пока поз >= 0 и арг.данные[поз как размер] == ' ':
        поз -= 1
    для ит в 0..ном:
        пока поз >= 0 и арг.данные[поз как размер] != ' ':
            поз -= 1
        пока поз >= 0 и арг.данные[поз как размер] == ' ':
            поз -= 1
    кон смещение = поз
    пока поз >= 0 и арг.данные[поз как размер] != ' ':
        поз -= 1
    верни стр_срез(арг, (поз + 1) как размер, (кон + 1) как размер)

