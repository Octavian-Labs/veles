# fwd: выход[б] = сигм(смещ[б] + сум_и w[и*нб+б] * вх[и]); сетка = нб
функ гслой(ок *Окл, яд нат.верх, бв нат.верх, ба нат.верх,
           вх_б нат.верх, вхо цел.верх, вео цел.верх, смо цел.верх,
           выо цел.верх, вхов цел.верх, нб цел.верх) лог:
    окл_арг_буй(яд, 0, вх_б)
    окл_арг_цел32(яд, 1, вхо как цел.рост)
    окл_арг_буй(яд, 2, бв)
    окл_арг_цел32(яд, 3, вео как цел.рост)
    окл_арг_цел32(яд, 4, смо как цел.рост)
    окл_арг_буй(яд, 5, ба)
    окл_арг_цел32(яд, 6, выо как цел.рост)
    окл_арг_цел32(яд, 7, вхов как цел.рост)
    окл_арг_цел32(яд, 8, нб как цел.рост)
    верни окл_поставь(ок, яд, нб как размер)

# d3: дельта выходного слоя; сетка = 3 блока
функ гд3(ок *Окл, яд нат.верх, ба нат.верх, бд нат.верх,
         выо цел.верх, до цел.верх, цб цел.верх) лог:
    окл_арг_буй(яд, 0, ба)
    окл_арг_цел32(яд, 1, выо как цел.рост)
    окл_арг_цел32(яд, 2, до как цел.рост)
    окл_арг_буй(яд, 3, бд)
    окл_арг_цел32(яд, 4, цб как цел.рост)
    верни окл_поставь(ок, яд, 3 как размер)

# bwd: д_вх[и] = (сум_б w[и*нб+б]·д_вых[б]) * ш[и]*(1-ш[и]); сетка = число входов
функ гназ(ок *Окл, яд нат.верх, бв нат.верх, ба нат.верх,
          вео цел.верх, до цел.верх, шо цел.верх, выо цел.верх,
          вхов цел.верх, нб цел.верх) лог:
    окл_арг_буй(яд, 0, бв)
    окл_арг_цел32(яд, 1, вео как цел.рост)
    окл_арг_буй(яд, 2, ба)
    окл_арг_цел32(яд, 3, до как цел.рост)
    окл_арг_цел32(яд, 4, шо как цел.рост)
    окл_арг_цел32(яд, 5, выо как цел.рост)
    окл_арг_цел32(яд, 6, вхов как цел.рост)
    окл_арг_цел32(яд, 7, нб как цел.рост)
    верни окл_поставь(ок, яд, вхов как размер)

# updw: w[и*нб+б] -= (скор*вх[и]) * д[б]; сетка = вхов*нб
функ гобв(ок *Окл, яд нат.верх, бв нат.верх, ба нат.верх,
          вх_б нат.верх, вео цел.верх, вхо цел.верх, до цел.верх,
          скор вещ.рост, вхов цел.верх, нб цел.верх) лог:
    окл_арг_буй(яд, 0, бв)
    окл_арг_цел32(яд, 1, вео как цел.рост)
    окл_арг_буй(яд, 2, вх_б)
    окл_арг_цел32(яд, 3, вхо как цел.рост)
    окл_арг_буй(яд, 4, ба)
    окл_арг_цел32(яд, 5, до как цел.рост)
    окл_арг_вещ(яд, 6, скор)
    окл_арг_цел32(яд, 7, нб как цел.рост)
    верни окл_поставь(ок, яд, (вхов*нб) как размер)

# updb: б[б] -= скор * д[б]; сетка = нб
функ гобб(ок *Окл, яд нат.верх, бв нат.верх, ба нат.верх,
          смо цел.верх, до цел.верх, скор вещ.рост, нб цел.верх) лог:
    окл_арг_буй(яд, 0, бв)
    окл_арг_цел32(яд, 1, смо как цел.рост)
    окл_арг_буй(яд, 2, ба)
    окл_арг_цел32(яд, 3, до как цел.рост)
    окл_арг_вещ(яд, 4, скор)
    верни окл_поставь(ок, яд, нб как размер)

# argm: флаг[с] = argmax(вых) — прогноз класса; сетка = 1
функ гарг(ок *Окл, яд нат.верх, ба нат.верх, бф нат.верх,
          выо цел.верх, с цел.верх) лог:
    окл_арг_буй(яд, 0, ба)
    окл_арг_цел32(яд, 1, выо как цел.рост)
    окл_арг_буй(яд, 2, бф)
    окл_арг_цел32(яд, 3, с как цел.рост)
    верни окл_поставь(ок, яд, 1 как размер)

открыто функ главная() цел.верх:
    # --- смещения в арене весов (float4) ---
    о_в1 цел.верх = 0
