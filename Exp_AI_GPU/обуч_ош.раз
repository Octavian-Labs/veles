# обуч_ош — этап E «мозга редактора»: классификатор вида ошибки на корпусе-2.
# Данные: raz/корпус.tsv + raz/корпус_мут_<ид>.раз (генератор raz/корпус.раз).
# Признаки (4096): 2048 бинов байтовых триграмм + 2048 бинов хешей слов
# строки кода и текста диагностики. Классы 9: 8 видов мутаций + «чисто».
# Сеть та же, что _ш5м: 4096 -> 1152 -> 288 -> 12 (9 классов, 3 блока f4),
# сигмоида, MSE-дельта, SGD — ядра и порядок сумм повторяют обуч_ш5м.
# Запуск из raz/ (там корпус.tsv и мутанты): ../Exp_AI_GPU/обуч_ош.exe

взять основа
взять окно
взять окл

# === разбор корпуса и признаки =================================================

функ случ(з *нат.верх) нат.верх:
    з[0] = з[0] * 6364136223846793005 + 1442695040888963407
    верни з[0] >> 33

функ случ01(з *нат.верх) вещ.рост:
    верни ((случ(з) как вещ.верх) / 2147483648.0) как вещ.рост

функ случ32(з *нат.верх, м вещ.рост) вещ.рост:
    верни (случ01(з) * 2.0 - 1.0) * м

функ эксп4(х век вещ.рост х 4) век вещ.рост х 4:
    у век вещ.рост х 4 = х * повтор((1.0 / 64.0) как вещ.рост)
    член век вещ.рост х 4 = у
    сум век вещ.рост х 4 = повтор(1.0 как вещ.рост) + у
    для к в 2..12:
        член = член * у * повтор(1.0 / (к как вещ.рост))
        сум += член
    для и в 0..6:
        сум = сум * сум
    верни сум

функ сигм4(х век вещ.рост х 4) век вещ.рост х 4:
    ед век вещ.рост х 4 = повтор(1.0 как вещ.рост)
    верни ед / (ед + эксп4(повтор(0.0 как вещ.рост) - х))

# поле TSV под номером (0 — первое); таб = 9
функ поле(с стр, ном цел.верх) стр:
    сч цел.верх = 0
    нач размер = 0
    для и в 0..с.длина:
        если с.данные[и] == 9:
            если сч == ном:
                верни стр_срез(с, нач, и как размер)
            сч += 1
            нач = (и + 1) как размер
    если сч == ном:
        верни стр_срез(с, нач, с.длина)
    верни ""

функ в_цел(с стр) цел.верх:
    р цел.верх = 0
    для и в 0..с.длина:
        б нат.старт = с.данные[и]
        если б >= '0' и б <= '9':
            р = р * 10 + ((б - '0') как цел.верх)
    верни р

# 1-based строка файла; 0/вне диапазона — пусто
функ строка_н(исх стр, ном цел.верх) стр:
    сч цел.верх = 1
    нач размер = 0
    для и в 0..исх.длина:
        если исх.данные[и] == 10:
            если сч == ном:
                верни стр_срез(исх, нач, и как размер)
            сч += 1
            нач = (и + 1) как размер
    если сч == ном:
        верни стр_срез(исх, нач, исх.длина)
    верни ""

# строка, содержащая байтовый офсет поз (для «чистых» строк корпуса)
функ строка_поз(исх стр, поз цел.верх) стр:
    нач размер = 0
    кон размер = исх.длина
    для и в 0..исх.длина:
        если исх.данные[и] == 10:
            если (и как цел.верх) < поз:
                нач = (и + 1) как размер
            иначе:
                кон = и как размер
                хватит
    верни стр_срез(исх, нач, кон)

функ кл_вида(вид стр) цел.верх:
    если стр_равны(вид, "удалить"): верни 0
    если стр_равны(вид, "обмен"): верни 1
    если стр_равны(вид, "дублировать"): верни 2
    если стр_равны(вид, "имя"): верни 3
    если стр_равны(вид, "вставить"): верни 4
    если стр_равны(вид, "укоротить"): верни 5
    если стр_равны(вид, "строка"): верни 6
    если стр_равны(вид, "заменить"): верни 7
    верни 8

# кодирование текста в 4096 бинарных признаков:
# 0..2047 — байтовые триграммы, 2048..4095 — хеши слов (FNV)
функ кодируй(текст стр, вх *вещ.рост, база цел.верх):
    для и в 0..4096:
        вх[база + и] = 0.0
    для и в 2..текст.длина:
        т нат.верх = ((текст.данные[и-2] как нат.верх) * 65536 +
                      (текст.данные[и-1] как нат.верх) * 256 +
                      (текст.данные[и] как нат.верх))
        бин цел.верх = ((т * 2654435761) % 2048) как цел.верх
        вх[база + бин] = 1.0
    х нат.верх = 0xcbf29ce4842223
    дл цел.верх = 0
    в_слове лог = нет
    для и в 0..текст.длина:
        б нат.старт = текст.данные[и]
        лич лог = (б == '_' или б >= 128 или (б >= '0' и б <= '9') или
            (б >= 'a' и б <= 'z') или (б >= 'A' и б <= 'Z'))
        если лич:
            х = (х * 1099511628211) + (б как нат.верх)
            дл += 1
            в_слове = да
        а если в_слове:
            вх[база + 2048 + ((х % 2048) как цел.верх)] = 1.0
            вх[база + (дл % 64)] = 1.0
            х = 0xcbf29ce4842223
            дл = 0
            в_слове = нет
    если в_слове:
        вх[база + 2048 + ((х % 2048) как цел.верх)] = 1.0
        вх[база + (дл % 64)] = 1.0

# === CPU-эталон (аренные указатели, как _ш5м) ==================================

функ ар(м *век вещ.рост х 4, офс цел.верх) *век вещ.рост х 4:
    верни ((м как *нат.старт) + офс*16) как *век вещ.рост х 4

функ слой1_прямой(вх *вещ.рост, база цел.верх,
                    веса *век вещ.рост х 4, смещения *век вещ.рост х 4,
                    выход *век вещ.рост х 4):
    для блок в 0..288:
        выход[блок] = смещения[блок]
    для вход_инд в 0..4096:
        вход вещ.рост = вх[база + вход_инд]
        если вход != 0.0:
            вход4 век вещ.рост х 4 = повтор(вход)
            для блок в 0..288:
                выход[блок] += веса[вход_инд*288 + блок] * вход4

функ слой1_обнови(вх *вещ.рост, база цел.верх,
                   веса *век вещ.рост х 4, дельта *век вещ.рост х 4,
                   скорость вещ.рост):
    скор4 век вещ.рост х 4 = повтор(скорость)
    для вход_инд в 0..4096:
        вход вещ.рост = вх[база + вход_инд]
        если вход != 0.0:
            шаг4 век вещ.рост х 4 = повтор(скорость * вход)
            для блок в 0..288:
                веса[вход_инд*288 + блок] -= шаг4 * дельта[блок]

# прямой проход и дельты одного примера на CPU: стадии пишутся в массивы,
# возвращает 1 при верном прогнозе; веса не меняются
функ этапы_цпу(вхм *вещ.рост, бс цел.верх, кл цел.верх, цв *век вещ.рост х 4,
               веса *век вещ.рост х 4, о_в1 цел.верх, о_б1 цел.верх,
               о_в2 цел.верх, о_б2 цел.верх, о_в3 цел.верх, о_б3 цел.верх,
               ш1 *век вещ.рост х 4, ш2 *век вещ.рост х 4, вых *век вещ.рост х 4,
               д3в *век вещ.рост х 4, д2в *век вещ.рост х 4,
               д1в *век вещ.рост х 4) цел.верх:
    ш1п вещ.рост[1152]
    ш2п вещ.рост[288]
    д1 вещ.рост[1152]
    д2 вещ.рост[288]
    ед4 век вещ.рост х 4 = повтор(1.0 как вещ.рост)
    верно цел.верх = 0

    слой1_прямой(вхм, бс, ар(веса, о_в1), ар(веса, о_б1), ш1)
    для б в 0..288:
        ш1[б] = сигм4(ш1[б])
        для л в 0..4:
            ш1п[б*4 + л] = ш1[б][л]
    для б в 0..72:
        ш2[б] = ар(веса, о_б2)[б]
    для и в 0..1152:
        вход4 век вещ.рост х 4 = повтор(ш1п[и])
        для б в 0..72:
            ш2[б] += ар(веса, о_в2)[и*72 + б] * вход4
    для б в 0..72:
        ш2[б] = сигм4(ш2[б])
        для л в 0..4:
            ш2п[б*4 + л] = ш2[б][л]
    луч цел.верх = 0
    лучз вещ.рост = -1.0
    для б в 0..3:
        а век вещ.рост х 4 = ар(веса, о_б3)[б]
        для и в 0..288:
            а += ар(веса, о_в3)[и*3 + б] * повтор(ш2п[и])
        вых[б] = сигм4(а)
        для л в 0..4:
            если б*4 + л < 9 и вых[б][л] > лучз:
                лучз = вых[б][л]
                луч = б*4 + л
    если луч == кл:
        верно = 1

    для б в 0..3:
        д3в[б] = (вых[б] - цв[б]) * вых[б] * (ед4 - вых[б])
    для и в 0..288:
        сум вещ.рост = сумма(ар(веса, о_в3)[и*3]*д3в[0] +
            ар(веса, о_в3)[и*3+1]*д3в[1] + ар(веса, о_в3)[и*3+2]*д3в[2])
        д2[и] = сум * ш2п[и] * (1.0 - ш2п[и])
    для б в 0..72:
        д2в[б] = век вещ.рост х 4{д2[б*4], д2[б*4+1], д2[б*4+2], д2[б*4+3]}
    для и в 0..1152:
        сум = 0.0
        для б в 0..72:
            сум += сумма(ар(веса, о_в2)[и*72 + б] * д2в[б])
        д1[и] = сум * ш1п[и] * (1.0 - ш1п[и])
    для б в 0..288:
        д1в[б] = век вещ.рост х 4{д1[б*4], д1[б*4+1], д1[б*4+2], д1[б*4+3]}
    верни верно

# обновления веса одного примера на CPU по готовым дельтам
функ обнови_цпу(вхм *вещ.рост, бс цел.верх,
                веса *век вещ.рост х 4, о_в1 цел.верх, о_б1 цел.верх,
                о_в2 цел.верх, о_б2 цел.верх, о_в3 цел.верх, о_б3 цел.верх,
                ш2 *век вещ.рост х 4, ш1 *век вещ.рост х 4,
                д3в *век вещ.рост х 4, д2в *век вещ.рост х 4,
                д1в *век вещ.рост х 4, скор вещ.рост):
    ш1п вещ.рост[1152]
    ш2п вещ.рост[288]
    для б в 0..288:
        для л в 0..4:
            ш1п[б*4 + л] = ш1[б][л]
    для б в 0..72:
        для л в 0..4:
            ш2п[б*4 + л] = ш2[б][л]
    скв век вещ.рост х 4 = повтор(скор)
    для и в 0..288:
        ши век вещ.рост х 4 = повтор(скор * ш2п[и])
        для б в 0..3:
            ар(веса, о_в3)[и*3 + б] -= ши * д3в[б]
    для б в 0..3:
        ар(веса, о_б3)[б] -= скв * д3в[б]
    для и в 0..1152:
        ши = повтор(скор * ш1п[и])
        для б в 0..72:
            ар(веса, о_в2)[и*72 + б] -= ши * д2в[б]
    для б в 0..72:
        ар(веса, о_б2)[б] -= скв * д2в[б]
    слой1_обнови(вхм, бс, ар(веса, о_в1), д1в, скор)
    для б в 0..288:
        ар(веса, о_б1)[б] -= скв * д1в[б]

# один шаг обучения на CPU: возвращает 1, если прогноз верный
функ шаг_цпу(вхм *вещ.рост, бс цел.верх, кл цел.верх, цв *век вещ.рост х 4,
             веса *век вещ.рост х 4, о_в1 цел.верх, о_б1 цел.верх,
             о_в2 цел.верх, о_б2 цел.верх, о_в3 цел.верх, о_б3 цел.верх,
             скор вещ.рост) цел.верх:
    ш1 век вещ.рост х 4[288]
    ш2 век вещ.рост х 4[72]
    вых век вещ.рост х 4[3]
    д2в век вещ.рост х 4[72]
    д1в век вещ.рост х 4[288]
    д3в век вещ.рост х 4[3]
    верно цел.верх = этапы_цпу(вхм, бс, кл, цв, веса, о_в1, о_б1,
        о_в2, о_б2, о_в3, о_б3, &ш1[0], &ш2[0], &вых[0], &д3в[0], &д2в[0], &д1в[0])
    обнови_цпу(вхм, бс, веса, о_в1, о_б1, о_в2, о_б2, о_в3, о_б3,
               &ш2[0], &ш1[0], &д3в[0], &д2в[0], &д1в[0], скор)
    верни верно

# === служебное =================================================================

функ печать_вещ(знач вещ.рост):
    если знач < 0.0:
        печать("-")
        знач = 0.0 - знач
    целая цел.верх = знач как цел.верх
    дробь цел.верх = ((знач - (целая как вещ.рост)) * 1000.0 + 0.5) как цел.верх
    если дробь >= 1000:
        целая += 1
        дробь = 0
    печать(цел_в_стр(целая))
    печать(".")
    если дробь < 10:
        печать("00")
    а если дробь < 100:
        печать("0")
    печать(цел_в_стр(дробь))

# побитовая сверка float4-арен: различия по 32-битным словам + макс |d|
функ сверьб(имя стр, а *век вещ.рост х 4, б *век вещ.рост х 4,
            веков цел.верх) цел.верх:
    биты_а *нат.рост = а как *нат.рост
    биты_б *нат.рост = б как *нат.рост
    плоск_а *вещ.рост = а как *вещ.рост
    плоск_б *вещ.рост = б как *вещ.рост
    разл цел.верх = 0
    макс_ош вещ.рост = 0.0
    для и в 0..веков*4:
        если биты_а[и] != биты_б[и]:
            разл += 1
            д вещ.рост = плоск_а[и] - плоск_б[и]
            если д < 0.0:
                д = 0.0 - д
            если д > макс_ош:
                макс_ош = д
    печать("  ")
    печать(имя)
    печать(" разл ")
    печать(цел_в_стр(разл))
    печать(" макс ")
    печать_вещ(макс_ош)
    печатьстр("")
    верни разл

