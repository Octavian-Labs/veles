# ош_инф — инференс классификатора вида ошибки (обуч_ош) на CPU.
# Прямой проход той же сети 4096 -> 1152 -> 288 -> 12 над бинарными
# признаками «строка кода + текст диагностики»; веса читаются из
# ош_веса.bin, который пишет обуч_ош.exe в конце обучения.
#
# stdin: две строки — строка кода, затем сообщение компилятора.
# аргумент: путь к файлу весов (*.bin), умолчание «ош_веса.bin» в cwd.
# stdout: «вид <имя>» и «оценки <9 чисел>» — разбирается расширением.
# Предназначен для редактора: один пример — миллисекунды, GPU не нужен.

взять основа

функ эксп4(х век вещ.рост х 4) век вещ.рост х 4:
    у век вещ.рост х 4 = х * повтор((1.0 / 64.0) как вещ.рост)
    член век вещ.рост х 4 = у
    сум век вещ.рост х 4 = повтор(1.0 как вещ.рост) + у
    для к в 2..12:
        член = член * у * повтор(1.0 / (к как вещ.рост))
        сум += член
    для и в 0..6:
        сум = сум * сум
    верни сум

функ сигм4(х век вещ.рост х 4) век вещ.рост х 4:
    ед век вещ.рост х 4 = повтор(1.0 как вещ.рост)
    верни ед / (ед + эксп4(повтор(0.0 как вещ.рост) - х))

функ имя_кл(кл цел.верх) стр:
    если кл == 0: верни "удалить"
    если кл == 1: верни "обмен"
    если кл == 2: верни "дублировать"
    если кл == 3: верни "имя"
    если кл == 4: верни "вставить"
    если кл == 5: верни "укоротить"
    если кл == 6: верни "строка"
    если кл == 7: верни "заменить"
    верни "чисто"

# то же кодирование, что в обуч_ош: триграммы -> 0..2047, слова -> 2048..4095
функ кодируй(текст стр, вх *вещ.рост):
    для и в 0..4096:
        вх[и] = 0.0
    для и в 2..текст.длина:
        т нат.верх = ((текст.данные[и-2] как нат.верх) * 65536 +
                      (текст.данные[и-1] как нат.верх) * 256 +
                      (текст.данные[и] как нат.верх))
        бин цел.верх = ((т * 2654435761) % 2048) как цел.верх
        вх[бин] = 1.0
    х нат.верх = 0xcbf29ce4842223
    дл цел.верх = 0
    в_слове лог = нет
    для и в 0..текст.длина:
        б нат.старт = текст.данные[и]
        лич лог = (б == '_' или б >= 128 или (б >= '0' и б <= '9') или
            (б >= 'a' и б <= 'z') или (б >= 'A' и б <= 'Z'))
        если лич:
            х = (х * 1099511628211) + (б как нат.верх)
            дл += 1
            в_слове = да
        а если в_слове:
            вх[2048 + ((х % 2048) как цел.верх)] = 1.0
            вх[(дл % 64) как размер] = 1.0
            х = 0xcbf29ce4842223
            дл = 0
            в_слове = нет
    если в_слове:
        вх[2048 + ((х % 2048) как цел.верх)] = 1.0
        вх[(дл % 64) как размер] = 1.0

функ ар(м *век вещ.рост х 4, офс цел.верх) *век вещ.рост х 4:
    верни ((м как *нат.старт) + офс*16) как *век вещ.рост х 4

функ печать_вещ(знач вещ.рост):
    если знач < 0.0:
        печать("-")
        знач = 0.0 - знач
    целая цел.верх = знач как цел.верх
    дробь цел.верх = ((знач - (целая как вещ.рост)) * 1000.0 + 0.5) как цел.верх
    если дробь >= 1000:
        целая += 1
        дробь = 0
    печать(цел_в_стр(целая))
    печать(".")
    если дробь < 10:
        печать("00")
    а если дробь < 100:
        печать("0")
    печать(цел_в_стр(дробь))

# первая строка стр: до первого '\n'
функ строка_1(с стр) стр:
    для и в 0..с.длина:
        если с.данные[и] == 10:
            верни стр_срез(с, 0, и как размер)
    верни с

# вторая строка стр: после первого '\n' до второго или конца
функ строка_2(с стр) стр:
    для и в 0..с.длина:
        если с.данные[и] == 10:
            нач размер = (и + 1) как размер
            для ж в (и+1)..с.длина:
                если с.данные[ж] == 10:
                    верни стр_срез(с, нач, ж как размер)
            верни стр_срез(с, нач, с.длина)
    верни ""

открыто функ главная() цел.верх:
    # раскладка арены весов — как в обуч_ош
    о_в1 цел.верх = 0
    о_б1 цел.верх = о_в1 + 1179648
    о_в2 цел.верх = о_б1 + 288
    о_б2 цел.верх = о_в2 + 82944
    о_в3 цел.верх = о_б2 + 72
    о_б3 цел.верх = о_в3 + 864
    веса_всего цел.верх = о_б3 + 3

    путь стр = "ош_веса.bin"
    арг стр = аргументы()
    поз смещение = стр_найди(арг, ".bin")
    если поз >= 0:
        кон размер = (поз + 4) как размер
        нач размер = 0
        для и в 0..(кон как цел.верх):
            если арг.данные[и] == ' ':
                нач = (и + 1) как размер
        путь = стр_срез(арг, нач, кон)

    сырой стр = файл_прочти(путь)
    если сырой == пусто или сырой.длина != ((веса_всего * 16) как размер):
        печатьстр(стр_склей("ош_инф: веса не читаются или чужой размер — ", путь))
        верни 2
    веса *век вещ.рост х 4 = сырой.данные как *век вещ.рост х 4

    входной стр = ввод()
    лин стр = строка_1(входной)
    сооб стр = строка_2(входной)
    если лин.длина == 0 и сооб.длина == 0:
        печатьстр("ош_инф: stdin пуст — нужны «строка\\nсообщение\\n»")
        верни 2

    вх вещ.рост[4096]
    кодируй(стр_склей(стр_склей(лин, " "), сооб), &вх[0])

    ш1 век вещ.рост х 4[288]
    ш2 век вещ.рост х 4[72]
    вых век вещ.рост х 4[3]
    ш1п вещ.рост[1152]
    ш2п вещ.рост[288]

    # слой 1: 4096 -> 288 блоков, пропуск нулевых входов (как в обуч_ош)
    для б в 0..288:
        ш1[б] = ар(веса, о_б1)[б]
    для и в 0..4096:
        если вх[и] != 0.0:
            для б в 0..288:
                ш1[б] += ар(веса, о_в1)[и*288 + б]
    для б в 0..288:
        ш1[б] = сигм4(ш1[б])
        для л в 0..4:
            ш1п[б*4 + л] = ш1[б][л]

    # слой 2: 1152 -> 72 блока
    для б в 0..72:
        ш2[б] = ар(веса, о_б2)[б]
    для и в 0..1152:
        для б в 0..72:
            ш2[б] += ар(веса, о_в2)[и*72 + б] * повтор(ш1п[и])
    для б в 0..72:
        ш2[б] = сигм4(ш2[б])
        для л в 0..4:
            ш2п[б*4 + л] = ш2[б][л]

    # выход: 288 -> 3 блока (12 лейнов, классы 0..8)
    луч цел.верх = 8
    лучз вещ.рост = -1.0
    для б в 0..3:
        а век вещ.рост х 4 = ар(веса, о_б3)[б]
        для и в 0..288:
            а += ар(веса, о_в3)[и*3 + б] * повтор(ш2п[и])
        вых[б] = сигм4(а)
        для л в 0..4:
            если б*4 + л < 9 и вых[б][л] > лучз:
                лучз = вых[б][л]
                луч = б*4 + л

    печать("вид ")
    печатьстр(имя_кл(луч))
    печать("оценки ")
    для б в 0..3:
        для л в 0..4:
            если б*4 + л < 9:
                печать_вещ(вых[б][л])
                печать(" ")
    печатьстр("")
    верни 0
