# === генерация (копии _сегм30м) ==============================================

функ случ(зерно *нат.верх) нат.верх:
    зерно[0] = зерно[0] * 6364136223846793005 + 1442695040888963407
    верни зерно[0] >> 33

функ случ01(зерно *нат.верх) вещ.рост:
    верни ((случ(зерно) как вещ.верх) / 2147483648.0) как вещ.рост

функ модуль(знач вещ.рост) вещ.рост:
    если знач < 0.0:
        верни 0.0 - знач
    верни знач

функ ген_сцену(зерно *нат.верх, вход *вещ.рост, маски *вещ.рост):
    для индекс в 0..4096:
        вход[индекс] = 0.0
    для индекс в 0..16384:
        маски[индекс] = 0.0
    объектов цел.верх = 1 + (случ(зерно) % 4) как цел.верх
    для объект в 0..объектов:
        класс цел.верх = (случ(зерно) % 4) как цел.верх
        центр_х вещ.рост = 0.2 + случ01(зерно) * 0.6
        центр_у вещ.рост = 0.2 + случ01(зерно) * 0.6
        размер_ф вещ.рост = 0.10 + случ01(зерно) * 0.18
        толщина вещ.рост = 0.035 + случ01(зерно) * 0.045
        яркость вещ.рост = 0.2 + (класс как вещ.рост) * 0.2
        для ряд в 0..64:
            у вещ.рост = (ряд как вещ.рост) / 63.0
            для столбец в 0..64:
                х вещ.рост = (столбец как вещ.рост) / 63.0
                разн_х вещ.рост = х - центр_х
                разн_у вещ.рост = у - центр_у
                абс_х вещ.рост = модуль(разн_х)
                абс_у вещ.рост = модуль(разн_у)
                внутри лог = нет
                если класс == 0:
                    внутри = разн_х*разн_х + разн_у*разн_у <= размер_ф*размер_ф
                а если класс == 1:
                    внутри = абс_х <= размер_ф и абс_у <= размер_ф
                а если класс == 2:
                    внутри = абс_х <= толщина и абс_у <= размер_ф
                    если абс_у <= толщина и абс_х <= размер_ф:
                        внутри = да
                иначе:
                    дальность вещ.рост = разн_х*разн_х + разн_у*разн_у
                    внешний вещ.рост = размер_ф*размер_ф
                    внутренний вещ.рост = (размер_ф-толщина)*(размер_ф-толщина)
                    внутри = дальность <= внешний и дальность >= внутренний
                если внутри:
                    индекс = ряд*64 + столбец
                    маски[класс*4096 + индекс] = 1.0
                    вход[индекс] = яркость
    для индекс в 0..4096:
        шум вещ.рост = (случ01(зерно) * 2.0 - 1.0) * 0.08
        значение вещ.рост = вход[индекс] + шум
        если значение < 0.0:
            значение = 0.0
        если значение > 1.0:
            значение = 1.0
        вход[индекс] = значение

функ случ_веса(зерно *нат.верх, массив *век вещ.рост х 4,
                длина цел.верх, размах вещ.рост):
    для индекс в 0..длина:
        а вещ.рост = (случ01(зерно)*2.0 - 1.0) * размах
        б вещ.рост = (случ01(зерно)*2.0 - 1.0) * размах
        в вещ.рост = (случ01(зерно)*2.0 - 1.0) * размах
        г вещ.рост = (случ01(зерно)*2.0 - 1.0) * размах
        массив[индекс] = век вещ.рост х 4{а, б, в, г}

функ заполни4(массив *век вещ.рост х 4, длина цел.верх, значение вещ.рост):
    для индекс в 0..длина:
        массив[индекс] = повтор(значение)

# === CPU-эталон (копии _сегм30м) =============================================

функ релу4(вход век вещ.рост х 4) век вещ.рост х 4:
    верни макс(вход, повтор(0.0))

функ свертка_1_32(вход *вещ.рост, веса *век вещ.рост х 4,
                    смещения *век вещ.рост х 4,
                    выход *век вещ.рост х 4):
    для ряд в 0..64:
        ряд64 цел.верх = ряд*64
        для столбец в 0..64:
            пвых цел.верх = (ряд64 + столбец)*8
            для блок в 0..8:
                накоп век вещ.рост х 4 = смещения[блок]
                для ядро_у в 0..3:
                    вход_у цел.верх = ряд + ядро_у - 1
                    если вход_у >= 0 и вход_у < 64:
                        вх_осн цел.верх = вход_у*64 + столбец - 1
                        вес_осн цел.верх = ядро_у*24 + блок
                        для ядро_х в 0..3:
                            вход_х цел.верх = столбец + ядро_х - 1
                            если вход_х >= 0 и вход_х < 64:
                                накоп += веса[вес_осн + ядро_х*8] * повтор(вход[вх_осн + ядро_х])
                выход[пвых + блок] = релу4(накоп)

функ макс4(лев век вещ.рост х 4, прав век вещ.рост х 4) век вещ.рост х 4:
    верни макс(лев, прав)

функ макс_пул2(вход *век вещ.рост х 4, ширина цел.верх,
                высота цел.верх, блоков цел.верх,
                выход *век вещ.рост х 4):
    вых_шир цел.верх = ширина / 2
    шб цел.верх = ширина * блоков
    для ряд в 0..высота/2:
        ряд2шб цел.верх = ряд*2 * шб
        вых_ряд цел.верх = ряд * вых_шир
        для столбец в 0..ширина/2:
            ст2б цел.верх = столбец*2 * блоков
            для блок в 0..блоков:
                база0 цел.верх = ряд2шб + ст2б + блок
                база1 цел.верх = база0 + шб
                верх век вещ.рост х 4 = макс4(вход[база0], вход[база0 + блоков])
                низ век вещ.рост х 4 = макс4(вход[база1], вход[база1 + блоков])
                выход[(вых_ряд + столбец)*блоков + блок] = макс4(верх, низ)

функ свертка_пак(вход *век вещ.рост х 4, ширина цел.верх, высота цел.верх,
                   вход_блоков цел.верх, выход_блоков цел.верх,
                   веса *век вещ.рост х 4, смещения *век вещ.рост х 4,
                   выход *век вещ.рост х 4):
    для ряд в 0..высота:
        рядш цел.верх = ряд*ширина
        для столбец в 0..ширина:
            пвых цел.верх = (рядш + столбец)*выход_блоков
            для выход_блок в 0..выход_блоков:
                накоп век вещ.рост х 4 = смещения[выход_блок]
                для ядро_у в 0..3:
                    вход_у цел.верх = ряд + ядро_у - 1
                    если вход_у >= 0 и вход_у < высота:
                        для ядро_х в 0..3:
                            вход_х цел.верх = столбец + ядро_х - 1
                            если вход_х >= 0 и вход_х < ширина:
                                вх_осн цел.верх = (вход_у*ширина + вход_х)*вход_блоков
                                вес_осн цел.верх = (ядро_у*3 + ядро_х)*вход_блоков*4*выход_блоков + выход_блок
                                для вход_блок в 0..вход_блоков:
                                    значение4 век вещ.рост х 4 = вход[вх_осн + вход_блок]
                                    вес_вх цел.верх = вес_осн + вход_блок*4*выход_блоков
                                    для лейн в 0..4:
                                        накоп += веса[вес_вх + лейн*выход_блоков] * повтор(значение4[лейн])
                выход[пвых + выход_блок] = релу4(накоп)

функ вверх2(вход *век вещ.рост х 4, ширина цел.верх, высота цел.верх,
             вход_блоков цел.верх, выход_блоков цел.верх,
             веса *век вещ.рост х 4, смещения *век вещ.рост х 4,
             выход *век вещ.рост х 4):
    вых_шир цел.верх = ширина * 2
    для ряд в 0..высота:
        рядш цел.верх = ряд*ширина
        для столбец в 0..ширина:
            вх_осн цел.верх = (рядш + столбец)*вход_блоков
            для часть_у в 0..2:
                вых_ряд цел.верх = ряд*2 + часть_у
                для часть_х в 0..2:
                    часть цел.верх = часть_у*2 + часть_х
                    вес_осн цел.верх = часть*вход_блоков*4*выход_блоков
                    вых_осн цел.верх = (вых_ряд*вых_шир + столбец*2 + часть_х)*выход_блоков
                    для выход_блок в 0..выход_блоков:
                        накоп век вещ.рост х 4 = смещения[выход_блок]
                        вес_вых цел.верх = вес_осн + выход_блок
                        для вход_блок в 0..вход_блоков:
                            значение4 век вещ.рост х 4 = вход[вх_осн + вход_блок]
                            вес_вх цел.верх = вес_вых + вход_блок*4*выход_блоков
                            для лейн в 0..4:
                                накоп += веса[вес_вх + лейн*выход_блоков] * повтор(значение4[лейн])
                        выход[вых_осн + выход_блок] = релу4(накоп)

функ соедини(лев *век вещ.рост х 4, левых цел.верх,
              прав *век вещ.рост х 4, правых цел.верх,
              пикселей цел.верх, выход *век вещ.рост х 4):
    всего цел.верх = левых + правых
    для пиксель в 0..пикселей:
        пв цел.верх = пиксель*всего
        пл цел.верх = пиксель*левых
        пп цел.верх = пиксель*правых
        для блок в 0..левых:
            выход[пв + блок] = лев[пл + блок]
        для блок в 0..правых:
            выход[пв + левых + блок] = прав[пп + блок]

функ эксп4(вход век вещ.рост х 4) век вещ.рост х 4:
    у век вещ.рост х 4 = вход * повтор((1.0 / 64.0) как вещ.рост)
    член век вещ.рост х 4 = у
    итог век вещ.рост х 4 = повтор(1.0 как вещ.рост) + у
    для порядок в 2..12:
        член = член * у * повтор(1.0 / (порядок как вещ.рост))
        итог += член
    для степень в 0..6:
        итог = итог * итог
    верни итог

функ сигм4(вход век вещ.рост х 4) век вещ.рост х 4:
    один век вещ.рост х 4 = повтор(1.0 как вещ.рост)
    верни один / (один + эксп4(повтор(0.0 как вещ.рост) - вход))

функ выход_масок(вход *век вещ.рост х 4, пикселей цел.верх,
                  вход_блоков цел.верх, веса *век вещ.рост х 4,
                  смещение век вещ.рост х 4,
                  выход *век вещ.рост х 4):
    для пиксель в 0..пикселей:
        накоп век вещ.рост х 4 = смещение
        пвх цел.верх = пиксель*вход_блоков
        для блок в 0..вход_блоков:
            значение4 век вещ.рост х 4 = вход[пвх + блок]
            для лейн в 0..4:
                накоп += веса[блок*4 + лейн] * повтор(значение4[лейн])
        выход[пиксель] = сигм4(накоп)

