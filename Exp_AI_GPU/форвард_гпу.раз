функ печать_вещ(знач вещ.рост):
    если знач < 0.0:
        печать("-")
        знач = 0.0 - знач
    целая цел.верх = знач как цел.верх
    дробь цел.верх = ((знач - (целая как вещ.рост)) * 1000.0 + 0.5) как цел.верх
    если дробь >= 1000:
        целая += 1
        дробь = 0
    печать(цел_в_стр(целая))
    печать(".")
    если дробь < 10:
        печать("00")
    а если дробь < 100:
        печать("0")
    печать(цел_в_стр(дробь))

# послойная сверка: эталон против прочитанной с GPU арены (плоские float)
функ сверь(имя стр, цпу *век вещ.рост х 4, гпу *век вещ.рост х 4,
           веков цел.верх) вещ.рост:
    а *вещ.рост = цпу как *вещ.рост
    б *вещ.рост = гпу как *вещ.рост
    макс_ош вещ.рост = 0.0
    для и в 0..веков*4:
        д вещ.рост = а[и] - б[и]
        если д < 0.0:
            д = 0.0 - д
        если д > макс_ош:
            макс_ош = д
    печать("  ")
    печать(имя)
    печать(" макс_ош ")
    печать_вещ(макс_ош)
    печатьстр("")
    верни макс_ош

