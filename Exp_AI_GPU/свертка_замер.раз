# свертка_замер — этап 1 Exp_AI_GPU: свёртка 3×3 на GPU против CPU.
# Та же математика, что свертка_пак из _сегм30м.раз (вход и выход —
# пиксели по float4-блокам, веса [кран][вх_блок*4][лейн][вых_блок]).
# Четыре формы из реальной сети; сверка выхода и замер времени.

взять основа
взять окно
взять окл

открыто конст ИТЕРАЦИЙ = 50

функ _случ(семя *нат.верх) нат.верх:
    семя[0] = семя[0] * 1103515245 + 12345
    верни (семя[0] >> 16) & 0x7FFF

# детерминированное значение в [-1, 1)
функ _случ_вещ(семя *нат.верх) вещ.рост:
    верни ((((_случ(семя) % 2000) как цел.верх) - 1000) как вещ.рост) * 0.001

функ релу4(вход век вещ.рост х 4) век вещ.рост х 4:
    верни макс(вход, повтор(0.0))

функ печать_вещ(знач вещ.рост):
    если знач < 0.0:
        печать("-")
        знач = 0.0 - знач
    целая цел.верх = знач как цел.верх
    дробь цел.верх = ((знач - (целая как вещ.рост)) * 1000.0 + 0.5) как цел.верх
    если дробь >= 1000:
        целая += 1
        дробь = 0
    печать(цел_в_стр(целая))
    печать(".")
    если дробь < 10:
        печать("00")
    а если дробь < 100:
        печать("0")
    печать(цел_в_стр(дробь))

# эталонная CPU-версия — копия свертка_пак из _сегм30м.раз
функ свертка_пак(вход *век вещ.рост х 4, ширина цел.верх, высота цел.верх,
                   вход_блоков цел.верх, выход_блоков цел.верх,
                   веса *век вещ.рост х 4, смещения *век вещ.рост х 4,
                   выход *век вещ.рост х 4):
    для ряд в 0..высота:
        рядш цел.верх = ряд*ширина
        для столбец в 0..ширина:
            пвых цел.верх = (рядш + столбец)*выход_блоков
            для выход_блок в 0..выход_блоков:
                накоп век вещ.рост х 4 = смещения[выход_блок]
                для ядро_у в 0..3:
                    вход_у цел.верх = ряд + ядро_у - 1
                    если вход_у >= 0 и вход_у < высота:
                        для ядро_х в 0..3:
                            вход_х цел.верх = столбец + ядро_х - 1
                            если вход_х >= 0 и вход_х < ширина:
                                вх_осн цел.верх = (вход_у*ширина + вход_х)*вход_блоков
                                вес_осн цел.верх = (ядро_у*3 + ядро_х)*вход_блоков*4*выход_блоков + выход_блок
                                для вход_блок в 0..вход_блоков:
                                    значение4 век вещ.рост х 4 = вход[вх_осн + вход_блок]
                                    вес_вх цел.верх = вес_осн + вход_блок*4*выход_блоков
                                    для лейн в 0..4:
                                        накоп += веса[вес_вх + лейн*выход_блоков] * повтор(значение4[лейн])
                выход[пвых + выход_блок] = релу4(накоп)

# одна форма: инициализация → замер CPU → замер GPU → сверка
функ замер(ок *Окл, прог нат.верх, шир цел.верх, выс цел.верх,
           вхб цел.верх, выхб цел.верх) лог:
    пикселей цел.верх = шир * выс
    вх_разм размер = (пикселей * вхб * 16) как размер
    вых_разм размер = (пикселей * выхб * 16) как размер
    вес_разм размер = (9 * вхб * 4 * выхб * 16) как размер
    см_разм размер = (выхб * 16) как размер
    вход *век вещ.рост х 4 = выдели(вх_разм) как *век вещ.рост х 4
    веса *век вещ.рост х 4 = выдели(вес_разм) как *век вещ.рост х 4
    смещ *век вещ.рост х 4 = выдели(см_разм) как *век вещ.рост х 4
    вых_проц *век вещ.рост х 4 = выдели(вых_разм) как *век вещ.рост х 4
    вых_гпу *век вещ.рост х 4 = выдели(вых_разм) как *век вещ.рост х 4
    семя нат.верх = 7
    вхф *вещ.рост = вход как *вещ.рост
    весф *вещ.рост = веса как *вещ.рост
    смф *вещ.рост = смещ как *вещ.рост
    для и в 0..пикселей * вхб * 4:
        вхф[и] = _случ_вещ(&семя)
    для и в 0..9 * вхб * 4 * выхб * 4:
        весф[и] = _случ_вещ(&семя)
    для и в 0..выхб * 4:
        смф[и] = _случ_вещ(&семя)
    # --- CPU ---
    н0 нат.верх = время_мс()
    для и в 0..ИТЕРАЦИЙ:
        свертка_пак(вход, шир, выс, вхб, выхб, веса, смещ, вых_проц)
    проц_мс нат.верх = время_мс() - н0
    # --- GPU ---
    бвх нат.верх = окл_буфер(ок, ОКЛ_ЧТ, вх_разм)
    бвес нат.верх = окл_буфер(ок, ОКЛ_ЧТ, вес_разм)
    бсм нат.верх = окл_буфер(ок, ОКЛ_ЧТ, см_разм)
    бвых нат.верх = окл_буфер(ок, ОКЛ_ЗП, вых_разм)
    ядро нат.верх = окл_ядро(прог, "conv")
    если (бвх == 0 или бвес == 0 или бсм == 0 или бвых == 0 или ядро == 0):
        верни нет
    окл_запиши(ок, бвх, вход как *нат.старт, вх_разм)
    окл_запиши(ок, бвес, веса как *нат.старт, вес_разм)
    окл_запиши(ок, бсм, смещ как *нат.старт, см_разм)
    окл_арг_буй(ядро, 0, бвх)
    окл_арг_цел32(ядро, 1, шир как цел.рост)
    окл_арг_цел32(ядро, 2, выс как цел.рост)
    окл_арг_цел32(ядро, 3, вхб как цел.рост)
    окл_арг_цел32(ядро, 4, выхб как цел.рост)
    окл_арг_буй(ядро, 5, бвес)
    окл_арг_буй(ядро, 6, бсм)
    окл_арг_буй(ядро, 7, бвых)
    н0 = время_мс()
    для и в 0..ИТЕРАЦИЙ:
        если не окл_запусти2(ок, ядро, пикселей как размер, выхб как размер):
            верни нет
    гпу_мс нат.верх = время_мс() - н0
    если не окл_прочти(ок, бвых, вых_гпу как *нат.старт, вых_разм):
        верни нет
    # --- сверка (плоским указателем — [лейн] у загруженного вектора ненадёжен) ---
    макс_ош вещ.рост = 0.0
    впф *вещ.рост = вых_проц как *вещ.рост
    вгф *вещ.рост = вых_гпу как *вещ.рост
    для и в 0..пикселей * выхб * 4:
        д вещ.рост = впф[и] - вгф[и]
        если д < 0.0:
            д = 0.0 - д
        если д > макс_ош:
            макс_ош = д
    печать(цел_в_стр(шир))
    печать("x")
    печать(цел_в_стр(выс))
    печать(" ")
    печать(цел_в_стр(вхб))
    печать("->")
    печать(цел_в_стр(выхб))
    печать("   проц ")
    печать(цел_в_стр(проц_мс как цел.верх))
    печать(" мс   гпу ")
    печать(цел_в_стр(гпу_мс как цел.верх))
    печать(" мс   x")
    печать_вещ((проц_мс как вещ.рост) / ((гпу_мс + 1) как вещ.рост))
    печать("   макс_ош ")
    печать_вещ(макс_ош)
    печатьстр("")
    окл_освободи_буфер(бвх)
    окл_освободи_буфер(бвес)
    окл_освободи_буфер(бсм)
    окл_освободи_буфер(бвых)
    окл_освободи_ядро(ядро)
    освободи(вход)
    освободи(веса)
    освободи(смещ)
    освободи(вых_проц)
    освободи(вых_гпу)
    верни макс_ош < 0.001

функ главная() цел.верх:
    ок *Окл = окл_начни()
    если ок == пусто:
        верни 1
    печатьстр(стр_склей("GPU: ", окл_имя_устройства(ок)))
    исх стр = "__kernel void conv(__global const float4* in, int w, int h, int ib, int ob, __global const float4* wt, __global const float4* bias, __global float4* out){ int px = get_global_id(0); int bn = get_global_id(1); int row = px / w; int col = px - row * w; float4 acc = bias[bn]; int w4 = ib * 4 * ob; for (int ky = 0; ky < 3; ky++){ int iy = row + ky - 1; if (iy < 0 || iy >= h) continue; for (int kx = 0; kx < 3; kx++){ int ix = col + kx - 1; if (ix < 0 || ix >= w) continue; int vbase = (iy * w + ix) * ib; int wbase = (ky * 3 + kx) * w4 + bn; for (int b = 0; b < ib; b++){ float4 v = in[vbase + b]; int wv = wbase + b * 4 * ob; acc += wt[wv] * v.x + wt[wv + ob] * v.y + wt[wv + 2 * ob] * v.z + wt[wv + 3 * ob] * v.w; } } } out[px * ob + bn] = fmax(acc, (float4)0.0f); }"
    прог нат.верх = окл_программа(ок, исх)
    если прог == 0:
        верни 2
    печатьстр("форма (шир x выс вхб->выхб)   проц    гпу    ускорение  расхождение")
    если не замер(ок, прог, 64, 64, 8, 8):
        верни 3
    если не замер(ок, прог, 32, 32, 32, 16):
        верни 4
    если не замер(ок, прог, 16, 16, 64, 32):
        верни 5
    если не замер(ок, прог, 4, 4, 256, 256):
        верни 6
    окл_освободи_прог(прог)
    окл_конец(ок)
    печатьстр("замер завершён")
    верни 0
