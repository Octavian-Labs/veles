# обуч_ш5м — этап 3 Exp_AI_GPU: полное обучение _ш5м на GPU.
# Та же сеть (4096 -> 1152 -> 288 -> 8, сигмоида, MSE-дельта, SGD),
# те же данные (зерно 987654321) и те же стартовые веса, что у CPU-эталона.
# CPU обучает свою копию весов, GPU — свою; порядок сумм в ядрах повторяет
# порядок ЦП (попарная сумма лейнов как у «сумма», FP_CONTRACT OFF),
# поэтому итоговые веса должны совпасть бит в бит.

взять основа
взять окно
взять окл

# === генерация (копии _ш5м) ===================================================

функ случ(з *нат.верх) нат.верх:
    з[0] = з[0] * 6364136223846793005 + 1442695040888963407
    верни з[0] >> 33

функ случ01(з *нат.верх) вещ.рост:
    верни ((случ(з) как вещ.верх) / 2147483648.0) как вещ.рост

функ случ32(з *нат.верх, м вещ.рост) вещ.рост:
    верни (случ01(з) * 2.0 - 1.0) * м

функ эксп4(х век вещ.рост х 4) век вещ.рост х 4:
    у век вещ.рост х 4 = х * повтор((1.0 / 64.0) как вещ.рост)
    член век вещ.рост х 4 = у
    сум век вещ.рост х 4 = повтор(1.0 как вещ.рост) + у
    для к в 2..12:
        член = член * у * повтор(1.0 / (к как вещ.рост))
        сум += член
    для и в 0..6:
        сум = сум * сум
    верни сум

функ сигм4(х век вещ.рост х 4) век вещ.рост х 4:
    ед век вещ.рост х 4 = повтор(1.0 как вещ.рост)
    верни ед / (ед + эксп4(повтор(0.0 как вещ.рост) - х))

функ ген_фигуру(кл цел.верх, з *нат.верх, пик *вещ.рост):
    сх вещ.рост = случ32(з, 0.25)
    су вещ.рост = случ32(з, 0.25)
    р вещ.рост = 0.45 + случ01(з) * 0.3
    т вещ.рост = 0.09 + случ01(з) * 0.1
    шаг цел.верх = 4 + (случ(з) % 6) как цел.верх
    для ряд в 0..64:
        у вещ.рост = ((ряд - 32) как вещ.рост) / 32.0
        для кол в 0..64:
            х вещ.рост = ((кол - 32) как вещ.рост) / 32.0
            дх вещ.рост = х - сх
            ду вещ.рост = у - су
            д2 вещ.рост = дх*дх + ду*ду
            бит вещ.рост = 0.0
            если кл == 0:
                если д2 < р*р: бит = 1.0
            а если кл == 1:
                р2 вещ.рост = (р + 0.12) * (р + 0.12)
                если д2 > р*р и д2 < р2: бит = 1.0
            а если кл == 2:
                если дх < р и дх > 0.0-р и ду < р и ду > 0.0-р: бит = 1.0
            а если кл == 3:
                ах вещ.рост = дх
                ау вещ.рост = ду
                если ах < 0.0: ах = 0.0 - ах
                если ау < 0.0: ау = 0.0 - ау
                мх вещ.рост = ах
                если ау > ах: мх = ау
                если мх > р и мх < р + 0.09: бит = 1.0
            а если кл == 4:
                если (дх > 0.0-т и дх < т) или (ду > 0.0-т и ду < т): бит = 1.0
            а если кл == 5:
                дг1 вещ.рост = х - у
                дг2 вещ.рост = х + у
                если дг1 < 0.0: дг1 = 0.0 - дг1
                если дг2 < 0.0: дг2 = 0.0 - дг2
                если дг1 < т или дг2 < т: бит = 1.0
            а если кл == 6:
                если (ряд / шаг) % 2 == 0: бит = 1.0
            иначе:
                если (кол / шаг) % 2 == 0: бит = 1.0
            если случ(з) < 60:
                бит = 1.0 - бит
            пик[ряд*64 + кол] = бит

# === CPU-эталон (копии _ш5м, аренные указатели) ================================

функ ар(м *век вещ.рост х 4, офс цел.верх) *век вещ.рост х 4:
    верни ((м как *нат.старт) + офс*16) как *век вещ.рост х 4

функ слой1_прямой(вх *вещ.рост, база цел.верх,
                    веса *век вещ.рост х 4, смещения *век вещ.рост х 4,
                    выход *век вещ.рост х 4):
    для блок в 0..288:
        выход[блок] = смещения[блок]
    для вход_инд в 0..4096:
        вход вещ.рост = вх[база + вход_инд]
        если вход == 1.0:
            для блок в 0..288:
                выход[блок] += веса[вход_инд*288 + блок]
        а если вход != 0.0:
            вход4 век вещ.рост х 4 = повтор(вход)
            для блок в 0..288:
                выход[блок] += веса[вход_инд*288 + блок] * вход4

функ слой1_обнови(вх *вещ.рост, база цел.верх,
                   веса *век вещ.рост х 4, дельта *век вещ.рост х 4,
                   скорость вещ.рост):
    скор4 век вещ.рост х 4 = повтор(скорость)
    для вход_инд в 0..4096:
        вход вещ.рост = вх[база + вход_инд]
        если вход == 1.0:
            для блок в 0..288:
                веса[вход_инд*288 + блок] -= скор4 * дельта[блок]
        а если вход != 0.0:
            шаг4 век вещ.рост х 4 = повтор(скорость * вход)
            для блок в 0..288:
                веса[вход_инд*288 + блок] -= шаг4 * дельта[блок]

# прямой проход и дельты одного примера на CPU: стадии пишутся в массивы,
# возвращает 1 при верном прогнозе; веса не меняются
функ этапы_цпу(вхм *вещ.рост, бс цел.верх, кл цел.верх, цв *век вещ.рост х 4,
               веса *век вещ.рост х 4, о_в1 цел.верх, о_б1 цел.верх,
               о_в2 цел.верх, о_б2 цел.верх, о_в3 цел.верх, о_б3 цел.верх,
               ш1 *век вещ.рост х 4, ш2 *век вещ.рост х 4, вых *век вещ.рост х 4,
               д3в *век вещ.рост х 4, д2в *век вещ.рост х 4,
               д1в *век вещ.рост х 4) цел.верх:
    ш1п вещ.рост[1152]
    ш2п вещ.рост[288]
    д1 вещ.рост[1152]
    д2 вещ.рост[288]
    ед4 век вещ.рост х 4 = повтор(1.0 как вещ.рост)
    верно цел.верх = 0

    # прямой проход
    слой1_прямой(вхм, бс, ар(веса, о_в1), ар(веса, о_б1), ш1)
    для б в 0..288:
        ш1[б] = сигм4(ш1[б])
        для л в 0..4:
            ш1п[б*4 + л] = ш1[б][л]
    для б в 0..72:
        ш2[б] = ар(веса, о_б2)[б]
    для и в 0..1152:
        вход4 век вещ.рост х 4 = повтор(ш1п[и])
        для б в 0..72:
            ш2[б] += ар(веса, о_в2)[и*72 + б] * вход4
    для б в 0..72:
        ш2[б] = сигм4(ш2[б])
        для л в 0..4:
            ш2п[б*4 + л] = ш2[б][л]
    луч цел.верх = 0
    лучз вещ.рост = -1.0
    для б в 0..2:
        а век вещ.рост х 4 = ар(веса, о_б3)[б]
        для и в 0..288:
            а += ар(веса, о_в3)[и*2 + б] * повтор(ш2п[и])
        вых[б] = сигм4(а)
        для л в 0..4:
            если вых[б][л] > лучз:
                лучз = вых[б][л]
                луч = б*4 + л
    если луч == кл:
        верно = 1

    # дельты
    для б в 0..2:
        д3в[б] = (вых[б] - цв[б]) * вых[б] * (ед4 - вых[б])
    для и в 0..288:
        сум вещ.рост = сумма(ар(веса, о_в3)[и*2]*д3в[0] + ар(веса, о_в3)[и*2+1]*д3в[1])
        д2[и] = сум * ш2п[и] * (1.0 - ш2п[и])
    для б в 0..72:
        д2в[б] = век вещ.рост х 4{д2[б*4], д2[б*4+1], д2[б*4+2], д2[б*4+3]}
    для и в 0..1152:
        сум = 0.0
        для б в 0..72:
            сум += сумма(ар(веса, о_в2)[и*72 + б] * д2в[б])
        д1[и] = сум * ш1п[и] * (1.0 - ш1п[и])
    для б в 0..288:
        д1в[б] = век вещ.рост х 4{д1[б*4], д1[б*4+1], д1[б*4+2], д1[б*4+3]}
    верни верно

# обновления веса одного примера на CPU по готовым дельтам
функ обнови_цпу(вхм *вещ.рост, бс цел.верх,
                веса *век вещ.рост х 4, о_в1 цел.верх, о_б1 цел.верх,
                о_в2 цел.верх, о_б2 цел.верх, о_в3 цел.верх, о_б3 цел.верх,
                ш2 *век вещ.рост х 4, ш1 *век вещ.рост х 4,
                д3в *век вещ.рост х 4, д2в *век вещ.рост х 4,
                д1в *век вещ.рост х 4, скор вещ.рост):
    ш1п вещ.рост[1152]
    ш2п вещ.рост[288]
    для б в 0..288:
        для л в 0..4:
            ш1п[б*4 + л] = ш1[б][л]
    для б в 0..72:
        для л в 0..4:
            ш2п[б*4 + л] = ш2[б][л]
    скв век вещ.рост х 4 = повтор(скор)
    для и в 0..288:
        ши век вещ.рост х 4 = повтор(скор * ш2п[и])
        для б в 0..2:
            ар(веса, о_в3)[и*2 + б] -= ши * д3в[б]
    для б в 0..2:
        ар(веса, о_б3)[б] -= скв * д3в[б]
    для и в 0..1152:
        ши = повтор(скор * ш1п[и])
        для б в 0..72:
            ар(веса, о_в2)[и*72 + б] -= ши * д2в[б]
    для б в 0..72:
        ар(веса, о_б2)[б] -= скв * д2в[б]
    слой1_обнови(вхм, бс, ар(веса, о_в1), д1в, скор)
    для б в 0..288:
        ар(веса, о_б1)[б] -= скв * д1в[б]

# один шаг обучения на CPU: возвращает 1, если прогноз верный
функ шаг_цпу(вхм *вещ.рост, бс цел.верх, кл цел.верх, цв *век вещ.рост х 4,
             веса *век вещ.рост х 4, о_в1 цел.верх, о_б1 цел.верх,
             о_в2 цел.верх, о_б2 цел.верх, о_в3 цел.верх, о_б3 цел.верх,
             скор вещ.рост) цел.верх:
    ш1 век вещ.рост х 4[288]
    ш2 век вещ.рост х 4[72]
    вых век вещ.рост х 4[2]
    д2в век вещ.рост х 4[72]
    д1в век вещ.рост х 4[288]
    д3в век вещ.рост х 4[2]
    верно цел.верх = этапы_цпу(вхм, бс, кл, цв, веса, о_в1, о_б1,
        о_в2, о_б2, о_в3, о_б3, &ш1[0], &ш2[0], &вых[0], &д3в[0], &д2в[0], &д1в[0])
    обнови_цпу(вхм, бс, веса, о_в1, о_б1, о_в2, о_б2, о_в3, о_б3,
               &ш2[0], &ш1[0], &д3в[0], &д2в[0], &д1в[0], скор)
    верни верно

# === служебное =================================================================

функ печать_вещ(знач вещ.рост):
    если знач < 0.0:
        печать("-")
        знач = 0.0 - знач
    целая цел.верх = знач как цел.верх
    дробь цел.верх = ((знач - (целая как вещ.рост)) * 1000.0 + 0.5) как цел.верх
    если дробь >= 1000:
        целая += 1
        дробь = 0
    печать(цел_в_стр(целая))
    печать(".")
    если дробь < 10:
        печать("00")
    а если дробь < 100:
        печать("0")
    печать(цел_в_стр(дробь))

# побитовая сверка float4-арен: различия по 32-битным словам + макс |d|
функ сверьб(имя стр, а *век вещ.рост х 4, б *век вещ.рост х 4,
            веков цел.верх) цел.верх:
    биты_а *нат.рост = а как *нат.рост
    биты_б *нат.рост = б как *нат.рост
    плоск_а *вещ.рост = а как *вещ.рост
    плоск_б *вещ.рост = б как *вещ.рост
    разл цел.верх = 0
    макс_ош вещ.рост = 0.0
    для и в 0..веков*4:
        если биты_а[и] != биты_б[и]:
            разл += 1
            д вещ.рост = плоск_а[и] - плоск_б[и]
            если д < 0.0:
                д = 0.0 - д
            если д > макс_ош:
                макс_ош = д
    печать("  ")
    печать(имя)
    печать(" разл ")
    печать(цел_в_стр(разл))
    печать(" макс ")
    печать_вещ(макс_ош)
    печатьстр("")
    верни разл

