    верни тензф[офс*4 + п*бл*4 + к]

# тепловая палитра 0..1: тёмно-синий → бирюза → жёлтый
функ цвет_тепло(зн вещ.рост) нат.рост:
    если зн < 0.0:
        зн = 0.0
    если зн > 1.0:
        зн = 1.0
    кр нат.старт = 0
    зл нат.старт = 0
    сн нат.старт = 0
    если зн < 0.5:
        т вещ.рост = зн * 2.0
        кр = (10.0 + т*10.0) как нат.старт
        зл = (15.0 + т*180.0) как нат.старт
        сн = (35.0 + т*170.0) как нат.старт
    иначе:
        т2 вещ.рост = (зн - 0.5) * 2.0
        кр = (20.0 + т2*235.0) как нат.старт
        зл = (195.0 + т2*40.0) как нат.старт
        сн = (205.0 - т2*130.0) как нат.старт
    верни цвет(кр, зл, сн)

