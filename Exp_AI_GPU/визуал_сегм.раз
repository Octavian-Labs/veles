            бл цел.верх, к цел.верх, пх цел.верх, пу цел.верх,
            разм цел.верх):
    для тя в 0..разм:
        ся цел.верх = тя * ш / разм
        для тх в 0..разм:
            сх цел.верх = тх * ш / разм
            зн вещ.рост = канал(тензф, офс, бл, ся*ш + сх, к)
            холст_точка(х, пх + тх, пу + тя, цвет_тепло(зн))

# узел: подпись + ряд из 8 плиток каналов
функ узел_рисуй(х *Холст, у *Уй, тензф *вещ.рост, о *цел.верх,
                н цел.верх, пх цел.верх, пу цел.верх, готов лог,
                выбран лог, миг лог):
    ш цел.верх = узел_ш(н)
    бл цел.верх = узел_бл(н)
    каналов цел.верх = бл * 4
    если н == 22:
        каналов = 4
    показ цел.верх = 8
    если каналов < 8:
        показ = каналов
    цт нат.рост = цвет(150, 160, 180)
    если не готов:
        цт = цвет(70, 76, 92)
    уй_текст(х, у, пх, пу - 13, узел_имя(н), 1, цт)
    для т в 0..показ:
        если готов:
            плитка(х, тензф, о[н], ш, бл, т * (каналов / показ),
                   пх + т*13, пу, 11)
        иначе:
            холст_прямоуг_залей(х, пх + т*13, пу, 11, 11, цвет(18, 22, 30))
        холст_прямоуг(х, пх + т*13, пу, 11, 11, цвет(45, 52, 66))
    если выбран:
        холст_прямоуг(х, пх - 3, пу - 3, показ*13 + 6, 17, цвет(255, 210, 80))
    а если миг:
        холст_прямоуг(х, пх - 3, пу - 3, показ*13 + 6, 17, цвет(90, 220, 255))

