# таблица шагов: вид(0 conv1,1 conv,2 pool,3 up2,4 cat,5 outm),
# вхо/выо — офс тензоров, вео/смо — офс весов/смещ (для cat вео=офс второго
# входа), ш/в — размер входа, вб/выб — блоков входа/выхода (cat: лн/рн)
функ шаг_гпу(ок *Окл, н цел.верх, бт нат.верх, бв нат.верх,
             яд_св1 нат.верх, яд_св нат.верх, яд_пул нат.верх,
             яд_вв нат.верх, яд_со нат.верх, яд_вых нат.верх,
             твид *цел.верх, твхо *цел.верх, твыо *цел.верх,
             твео *цел.верх, тсмо *цел.верх, тш *цел.верх,
             тв *цел.верх, твб *цел.верх, твыб *цел.верх) лог:
    в цел.верх = твид[н]
    если в == 0:
        верни гсверт1(ок, яд_св1, бт, бв, твхо[н], твео[н], тсмо[н], твыо[н])
    если в == 1:
        верни гсверт(ок, яд_св, бт, бв, твхо[н], тш[н], тв[н], твб[н],
                     твыб[н], твео[н], тсмо[н], твыо[н])
    если в == 2:
        верни гпул(ок, яд_пул, бт, твхо[н], тш[н], тв[н], твб[н], твыо[н])
    если в == 3:
        верни гвверх(ок, яд_вв, бт, бв, твхо[н], тш[н], тв[н], твб[н],
                     твыб[н], твео[н], тсмо[н], твыо[н])
    если в == 4:
        верни гсоед(ок, яд_со, бт, твхо[н], твб[н], твео[н], твыб[н],
                    твыо[н], тш[н])
    верни гвых(ок, яд_вых, бт, бв, твхо[н], твб[н], твео[н], тсмо[н],
               твыо[н], тш[н])

