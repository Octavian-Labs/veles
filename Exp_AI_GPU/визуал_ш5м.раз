            о.клавиша = 0
        # --- управление: мышь ---
        нажал лог = о.мышь_левая и не мышь_была
        мышь_была = о.мышь_левая
        мх цел.верх = о.мышь_х
        му цел.верх = о.мышь_у
        если нажал:
            если уй_зона(мх, му, 24, 8, 92, 24):
                пауза = не пауза
            а если уй_зона(мх, му, 124, 8, 70, 24):
