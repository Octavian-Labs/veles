# вертикальная позиция узла инд из колво в полосе 600 по центру ЦЕНТР_У
функ узел_у(инд цел.верх, колво цел.верх) цел.верх:
    шагн цел.верх = 600 / колво
    если шагн > 26:
        шагн = 26
    верни ЦЕНТР_У - ((колво - 1) * шагн) / 2 + инд * шагн

функ цвет_веса(в вещ.рост, шкала вещ.рост) нат.рост:
    я вещ.рост = модуль(в) * шкала
    если я > 1.0:
        я = 1.0
    если в > 0.0:
        верни цвет(0, (120.0 + я*135.0) как нат.старт,
                      (140.0 + я*115.0) как нат.старт)
    верни цвет((140.0 + я*115.0) как нат.старт,
               (60.0 + я*80.0) как нат.старт, 20)

функ нить(х *Холст, х0 цел.верх, у0 цел.верх, х1 цел.верх, у1 цел.верх,
          в вещ.рост, шкала вещ.рост):
    ц нат.рост = цвет_веса(в, шкала)
    холст_линия(х, х0, у0, х1, у1, ц)
    я вещ.рост = модуль(в) * шкала
    если я > 0.35:
        холст_линия(х, х0, у0 + 1, х1, у1 + 1, ц)
    если я > 0.7:
        холст_линия(х, х0, у0 - 1, х1, у1 - 1, ц)

функ узел(х *Холст, пх цел.верх, пу цел.верх, акт вещ.рост):
    если акт < 0.0:
        акт = 0.0
    если акт > 1.0:
        акт = 1.0
    рад цел.верх = 4 + ((акт * 5.0) как цел.верх)
    ц нат.рост = цвет((20.0 + акт*100.0) как нат.старт,
                      (60.0 + акт*170.0) как нат.старт,
                      (140.0 + акт*115.0) как нат.старт)
    холст_круг_залей(х, пх, пу, рад, ц)

# веса: вход и → нейрон н соответствующего слоя
функ вес1(веса *век вещ.рост х 4, и цел.верх, н цел.верх) вещ.рост:
    вещп *вещ.рост = веса как *вещ.рост
    верни вещп[(и*288 + н/4)*4 + н % 4]

функ вес2(веса *век вещ.рост х 4, и цел.верх, н цел.верх) вещ.рост:
    вещп *вещ.рост = веса как *вещ.рост
    верни вещп[(и*72 + н/4)*4 + н % 4]

функ вес3(веса *век вещ.рост х 4, и цел.верх, н цел.верх) вещ.рост:
    вещп *вещ.рост = веса как *вещ.рост
    верни вещп[(и*2 + н/4)*4 + н % 4]

# попадание мыши в узел (радиус ~11)
функ в_узле(мх цел.верх, му цел.верх, пх цел.верх, пу цел.верх) лог:
    дх цел.верх = мх - пх
    ду цел.верх = му - пу
    верни дх*дх + ду*ду <= 121

# карта входных весов выбранного нейрона — «что он видит»
функ карта_весов(х *Холст, пх цел.верх, пу цел.верх, слой цел.верх,
                 нейрон цел.верх, w1т *век вещ.рост х 4,
                 w2т *век вещ.рост х 4, w3т *век вещ.рост х 4):
    если слой == 1:
        # ш1: 4096 входов -> сетка 64x64, клетка 3px
        для и в 0..4096:
            в вещ.рост = вес1(w1т, и, нейрон)
            холст_прямоуг_залей(х, пх + (и % 64)*3, пу + (и / 64)*3, 3, 3,
                                цвет_веса(в, 14.0))
    а если слой == 2:
        # ш2: 1152 входа -> 48x24, клетка 5px
        для и в 0..1152:
            в = вес2(w2т, и, нейрон)
            холст_прямоуг_залей(х, пх + (и % 48)*5, пу + (и / 48)*5, 5, 5,
                                цвет_веса(в, 5.0))
    а если слой == 3:
        # выход: 288 входов -> 24x12, клетка 8px
        для и в 0..288:
            в = вес3(w3т, и, нейрон)
            холст_прямоуг_залей(х, пх + (и % 24)*8, пу + (и / 24)*8, 8, 8,
                                цвет_веса(в, 3.0))

функ главная() цел.верх:
    зерно нат.верх = 987654321
    вхм *вещ.рост = выдели(480 * 4096 * 4) как *вещ.рост
    цель *вещ.рост = выдели(480 * 8 * 4) как *вещ.рост
    пик *вещ.рост = выдели(4096 * 4) как *вещ.рост
    для с в 0..480:
        кл цел.верх = с % 8
