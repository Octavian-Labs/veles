    для и в 0..82944:
        w2т[и] = век вещ.рост х 4{случ32(&зерно, 0.1), случ32(&зерно, 0.1), случ32(&зерно, 0.1), случ32(&зерно, 0.1)}
    для и в 0..576:
        w3т[и] = век вещ.рост х 4{случ32(&зерно, 0.15), случ32(&зерно, 0.15), случ32(&зерно, 0.15), случ32(&зерно, 0.15)}
    для б в 0..288:
        б1[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}
    для б в 0..72:
        б2[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}
    для б в 0..2:
        б3[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}
    ш1 век вещ.рост х 4[288]
    ш2 век вещ.рост х 4[72]
    вых век вещ.рост х 4[2]
    д2в век вещ.рост х 4[72]
    д1в век вещ.рост х 4[288]
    д3в век вещ.рост х 4[2]
    цв век вещ.рост х 4[2]
    ш1п вещ.рост[1152]
    ш2п вещ.рост[288]
    выхп вещ.рост[8]
    д1 вещ.рост[1152]
    д2 вещ.рост[288]
    ист вещ.рост[512]
    кривая вещ.рост[600]
    тепло вещ.рост[512]          # 64 примера x 8 классов — кольцо истории
    ед4 век вещ.рост х 4 = повтор(1.0 как вещ.рост)
    для и в 0..512:
        ист[и] = 0.0
        тепло[и] = 0.0
    для и в 0..600:
        кривая[и] = 0.0
    скор вещ.рост = 0.4
    о *Окно = окно_создай("ВЕЛЕС — среда обучения 5М", 1400, 840)
    если о == пусто:
        верни 1
    х *Холст = холст_новый(1400, 840)
    у *Уй = уй_начни()
    # состояние среды
    прм цел.верх = 0
    эп цел.верх = 0
    верно_эп цел.верх = 0
    ист_инд цел.верх = 0
    заполнено цел.верх = 0
    длина_к цел.верх = 0
    пауза лог = нет
    темп цел.верх = 4            # примеров на кадр: 1/4/16
    шаг_один лог = нет
    мышь_была лог = нет
    выб_слой цел.верх = 0        # 0 нет, 1 ш1, 2 ш2, 3 выход
    выб_инд цел.верх = 0
    лосс вещ.рост = 0.0
    пр цел.верх = 0
    кадров цел.верх = 0
    кпс цел.верх = 0
    ппс цел.верх = 0
    прм_счёт цел.верх = 0
