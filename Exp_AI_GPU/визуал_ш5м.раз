# визуал_ш5м — живая визуализация обучения сети _ш5м (4096→1152→288→8).
# Окно: миниатюра входа, узлы слоёв (размер/яркость = активация),
# нити между слоями (знак и |вес| → цвет и толщина), кривая точности.
# На кадр — 2 обучающих примера; цикл идёт, пока окно живо.

взять основа
взять холст
взять окно

# --- детерминированный генератор (как в _ш5м) ---------------------------------

функ случ(з *нат.верх) нат.верх:
    з[0] = з[0] * 6364136223846793005 + 1442695040888963407
    верни з[0] >> 33

функ случ01(з *нат.верх) вещ.рост:
    верни ((случ(з) как вещ.верх) / 2147483648.0) как вещ.рост

функ случ32(з *нат.верх, м вещ.рост) вещ.рост:
    верни (случ01(з) * 2.0 - 1.0) * м

функ модуль(знач вещ.рост) вещ.рост:
    если знач < 0.0:
        верни 0.0 - знач
    верни знач

функ эксп4(х век вещ.рост х 4) век вещ.рост х 4:
    у век вещ.рост х 4 = х * повтор((1.0 / 64.0) как вещ.рост)
    член век вещ.рост х 4 = у
    сум век вещ.рост х 4 = повтор(1.0 как вещ.рост) + у
    для к в 2..12:
        член = член * у * повтор(1.0 / (к как вещ.рост))
        сум += член
    для и в 0..6:
        сум = сум * сум
    верни сум

функ сигм4(х век вещ.рост х 4) век вещ.рост х 4:
    ед век вещ.рост х 4 = повтор(1.0 как вещ.рост)
    верни ед / (ед + эксп4(повтор(0.0 как вещ.рост) - х))

# --- генерация фигур (копия _ш5м) ----------------------------------------------

функ ген_фигуру(кл цел.верх, з *нат.верх, пик *вещ.рост):
    сх вещ.рост = случ32(з, 0.25)
    су вещ.рост = случ32(з, 0.25)
    р вещ.рост = 0.45 + случ01(з) * 0.3
    т вещ.рост = 0.09 + случ01(з) * 0.1
    шаг цел.верх = 4 + (случ(з) % 6) как цел.верх
    для ряд в 0..64:
        у вещ.рост = ((ряд - 32) как вещ.рост) / 32.0
        для кол в 0..64:
            х вещ.рост = ((кол - 32) как вещ.рост) / 32.0
            дх вещ.рост = х - сх
            ду вещ.рост = у - су
            д2 вещ.рост = дх*дх + ду*ду
            бит вещ.рост = 0.0
            если кл == 0:
                если д2 < р*р: бит = 1.0
            а если кл == 1:
                р2 вещ.рост = (р + 0.12) * (р + 0.12)
                если д2 > р*р и д2 < р2: бит = 1.0
            а если кл == 2:
                если дх < р и дх > 0.0-р и ду < р и ду > 0.0-р: бит = 1.0
            а если кл == 3:
                ах вещ.рост = дх
                ау вещ.рост = ду
                если ах < 0.0: ах = 0.0 - ах
                если ау < 0.0: ау = 0.0 - ау
                мх вещ.рост = ах
                если ау > ах: мх = ау
                если мх > р и мх < р + 0.09: бит = 1.0
            а если кл == 4:
                если (дх > 0.0-т и дх < т) или (ду > 0.0-т и ду < т): бит = 1.0
            а если кл == 5:
                дг1 вещ.рост = х - у
                дг2 вещ.рост = х + у
                если дг1 < 0.0: дг1 = 0.0 - дг1
                если дг2 < 0.0: дг2 = 0.0 - дг2
                если дг1 < т или дг2 < т: бит = 1.0
            а если кл == 6:
                если (ряд / шаг) % 2 == 0: бит = 1.0
            иначе:
                если (кол / шаг) % 2 == 0: бит = 1.0
            если случ(з) < 60:
                бит = 1.0 - бит
            пик[ряд*64 + кол] = бит

# --- слои (копия _ш5м) ----------------------------------------------------------

функ слой1_прямой(вх *вещ.рост, база цел.верх,
                    веса *век вещ.рост х 4, смещения *век вещ.рост х 4,
                    выход *век вещ.рост х 4):
    для блок в 0..288:
        выход[блок] = смещения[блок]
    для вход_инд в 0..4096:
        вход вещ.рост = вх[база + вход_инд]
        если вход == 1.0:
            для блок в 0..288:
                выход[блок] += веса[вход_инд*288 + блок]
        а если вход != 0.0:
            вход4 век вещ.рост х 4 = повтор(вход)
            для блок в 0..288:
                выход[блок] += веса[вход_инд*288 + блок] * вход4

функ слой1_обнови(вх *вещ.рост, база цел.верх,
                   веса *век вещ.рост х 4, дельта *век вещ.рост х 4,
                   скорость вещ.рост):
    скор4 век вещ.рост х 4 = повтор(скорость)
    для вход_инд в 0..4096:
        вход вещ.рост = вх[база + вход_инд]
        если вход == 1.0:
            для блок в 0..288:
                веса[вход_инд*288 + блок] -= скор4 * дельта[блок]
        а если вход != 0.0:
            шаг4 век вещ.рост х 4 = повтор(скорость * вход)
            для блок в 0..288:
                веса[вход_инд*288 + блок] -= шаг4 * дельта[блок]

# --- рисование -------------------------------------------------------------------

# вертикальная позиция узла инд из колво в полосе высотой 560 по центру 380
функ узел_у(инд цел.верх, колво цел.верх) цел.верх:
    шагн цел.верх = 560 / колво
    если шагн > 26:
        шагн = 26
    верни 380 - ((колво - 1) * шагн) / 2 + инд * шагн

# цвет нити по весу: знак → оттенок, |вес|*шкала → яркость
функ цвет_веса(в вещ.рост, шкала вещ.рост) нат.рост:
    я вещ.рост = модуль(в) * шкала
    если я > 1.0:
        я = 1.0
    если в > 0.0:
        верни цвет(0, (120.0 + я*135.0) как нат.старт,
                      (140.0 + я*115.0) как нат.старт)
    верни цвет((140.0 + я*115.0) как нат.старт,
               (60.0 + я*80.0) как нат.старт, 20)

# нить с толщиной по силе веса (1..3 пикселя)
функ нить(х *Холст, х0 цел.верх, у0 цел.верх, х1 цел.верх, у1 цел.верх,
          в вещ.рост, шкала вещ.рост):
    ц нат.рост = цвет_веса(в, шкала)
    холст_линия(х, х0, у0, х1, у1, ц)
    я вещ.рост = модуль(в) * шкала
    если я > 0.35:
        холст_линия(х, х0, у0 + 1, х1, у1 + 1, ц)
    если я > 0.7:
        холст_линия(х, х0, у0 - 1, х1, у1 - 1, ц)

# узел: радиус и цвет по активации 0..1
функ узел(х *Холст, пх цел.верх, пу цел.верх, акт вещ.рост):
    если акт < 0.0:
        акт = 0.0
    если акт > 1.0:
        акт = 1.0
    рад цел.верх = 4 + ((акт * 5.0) как цел.верх)
    ц нат.рост = цвет((20.0 + акт*100.0) как нат.старт,
                      (60.0 + акт*170.0) как нат.старт,
                      (140.0 + акт*115.0) как нат.старт)
    холст_круг_залей(х, пх, пу, рад, ц)

# вес w1т: вход и → нейрон скрытого н (блок н/4, лейн н%4)
функ вес1(веса *век вещ.рост х 4, и цел.верх, н цел.верх) вещ.рост:
    в4 век вещ.рост х 4 = веса[и*288 + н/4]
    верни в4[н % 4]

функ вес2(веса *век вещ.рост х 4, и цел.верх, н цел.верх) вещ.рост:
    в4 век вещ.рост х 4 = веса[и*72 + н/4]
    верни в4[н % 4]

функ вес3(веса *век вещ.рост х 4, и цел.верх, н цел.верх) вещ.рост:
    в4 век вещ.рост х 4 = веса[и*2 + н/4]
    верни в4[н % 4]

функ рисуй(х *Холст, вх *вещ.рост, бс цел.верх, кл цел.верх, пр цел.верх,
           ш1п *вещ.рост, ш2п *вещ.рост, выхп *вещ.рост,
           w1т *век вещ.рост х 4, w2т *век вещ.рост х 4,
           w3т *век вещ.рост х 4,
           кривая *вещ.рост, длина_к цел.верх, точность вещ.рост):
    холст_залей(х, цвет(8, 10, 18))
    # миниатюра входа 64x64 -> 192px
    для ряд в 0..64:
        для кол в 0..64:
            зн вещ.рост = вх[бс + ряд*64 + кол]
            гр нат.старт = (40.0 + зн*200.0) как нат.старт
            холст_прямоуг_залей(х, 24 + кол*3, 90 + ряд*3, 3, 3,
                                цвет(0, гр, ((гр как нат.рост) + 40) как нат.старт))
    холст_прямоуг(х, 23, 89, 194, 194, цвет(60, 80, 120))
    # координаты колонок
    конст Х_ВХ = 300
    конст Х_Ш1 = 560
    конст Х_Ш2 = 800
    конст Х_ВЫХ = 1040
    # нити вход→ш1: 32 группы по 128 входов, 24 видимых нейрона (каждый 48-й)
    для а в 0..32:
        у0 цел.верх = узел_у(а, 32)
        для б в 0..24:
            н1 цел.верх = б * 48
            св вещ.рост = 0.0
            для ч в 0..32:
                св += вес1(w1т, а*128 + ч*4, н1)
            нить(х, Х_ВХ, у0, Х_Ш1, узел_у(б, 24), св / 32.0, 14.0)
    # нити ш1→ш2: 24 -> 18 (каждый 48-й ш1, каждый 16-й ш2)
    для а в 0..24:
        у0 = узел_у(а, 24)
        для б в 0..18:
            нить(х, Х_Ш1, у0, Х_Ш2, узел_у(б, 18),
                 вес2(w2т, а*48, б*16), 4.0)
    # нити ш2→выход: 18 -> 8
    для а в 0..18:
        у0 = узел_у(а, 18)
        для б в 0..8:
            нить(х, Х_Ш2, у0, Х_ВЫХ, узел_у(б, 8),
                 вес3(w3т, а*16, б), 2.0)
    # узлы входа: 32 группы, активация = среднее по группе
    для а в 0..32:
        акт вещ.рост = 0.0
        для ч в 0..128:
            акт += вх[бс + а*128 + ч]
        узел(х, Х_ВХ, узел_у(а, 32), акт / 128.0)
    для б в 0..24:
        узел(х, Х_Ш1, узел_у(б, 24), ш1п[б*48])
    для б в 0..18:
        узел(х, Х_Ш2, узел_у(б, 18), ш2п[б*16])
    для б в 0..8:
        узел(х, Х_ВЫХ, узел_у(б, 8), выхп[б])
        если б == пр:
            холст_круг(х, Х_ВЫХ, узел_у(б, 8), 11, цвет(60, 255, 100))
        если б == кл:
            холст_круг(х, Х_ВЫХ, узел_у(б, 8), 13, ХОЛСТ_БЕЛЫЙ)
    # кривая точности: полоса внизу
    холст_прямоуг(х, 24, 700, 1232, 76, цвет(40, 50, 70))
    для и в 1..длина_к:
        х0 цел.верх = 24 + ((и - 1) * 1232) / 600
        х1 цел.верх = 24 + (и * 1232) / 600
        ку0 цел.верх = 770 - ((кривая[и - 1] * 60.0) как цел.верх)
        ку1 цел.верх = 770 - ((кривая[и] * 60.0) как цел.верх)
        холст_линия(х, х0, ку0, х1, ку1, цвет(80, 220, 140))
    # индикатор текущей точности
    ширт цел.верх = (точность * 200.0) как цел.верх
    холст_прямоуг_залей(х, 24, 660, ширт, 10, цвет(80, 200, 130))
    холст_прямоуг(х, 24, 660, 200, 10, цвет(60, 80, 120))

функ главная() цел.верх:
    зерно нат.верх = 987654321
    # датасет: 8 классов x 60 фигур = 480 примеров
    вхм *вещ.рост = выдели(480 * 4096 * 4) как *вещ.рост
    цель *вещ.рост = выдели(480 * 8 * 4) как *вещ.рост
    пик *вещ.рост = выдели(4096 * 4) как *вещ.рост
    для с в 0..480:
        кл цел.верх = с % 8
        ген_фигуру(кл, &зерно, пик)
        для и в 0..4096:
            вхм[с*4096 + и] = пик[и]
        для ж в 0..8:
            цель[с*8 + ж] = 0.0
        цель[с*8 + кл] = 1.0
    # веса — та же инициализация, что в _ш5м
    w1т *век вещ.рост х 4 = выдели(1179648 * 16) как *век вещ.рост х 4
    б1 *век вещ.рост х 4 = выдели(288 * 16) как *век вещ.рост х 4
    w2т *век вещ.рост х 4 = выдели(82944 * 16) как *век вещ.рост х 4
    б2 *век вещ.рост х 4 = выдели(72 * 16) как *век вещ.рост х 4
    w3т *век вещ.рост х 4 = выдели(576 * 16) как *век вещ.рост х 4
    б3 *век вещ.рост х 4 = выдели(2 * 16) как *век вещ.рост х 4
    для и в 0..1179648:
        w1т[и] = век вещ.рост х 4{случ32(&зерно, 0.03), случ32(&зерно, 0.03), случ32(&зерно, 0.03), случ32(&зерно, 0.03)}
    для и в 0..82944:
        w2т[и] = век вещ.рост х 4{случ32(&зерно, 0.1), случ32(&зерно, 0.1), случ32(&зерно, 0.1), случ32(&зерно, 0.1)}
    для и в 0..576:
        w3т[и] = век вещ.рост х 4{случ32(&зерно, 0.15), случ32(&зерно, 0.15), случ32(&зерно, 0.15), случ32(&зерно, 0.15)}
    для б в 0..288:
        б1[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}
    для б в 0..72:
        б2[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}
    для б в 0..2:
        б3[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}
    ш1 век вещ.рост х 4[288]
    ш2 век вещ.рост х 4[72]
    вых век вещ.рост х 4[2]
    д2в век вещ.рост х 4[72]
    д1в век вещ.рост х 4[288]
    д3в век вещ.рост х 4[2]
    цв век вещ.рост х 4[2]
    ш1п вещ.рост[1152]
    ш2п вещ.рост[288]
    выхп вещ.рост[8]
    д1 вещ.рост[1152]
    д2 вещ.рост[288]
    ист вещ.рост[512]
    кривая вещ.рост[600]
    ед4 век вещ.рост х 4 = повтор(1.0 как вещ.рост)
    для и в 0..512:
        ист[и] = 0.0
    для и в 0..600:
        кривая[и] = 0.0
    скор вещ.рост = 0.4
    о *Окно = окно_создай("ВЕЛЕС — обучение сети 5М живьём", 1280, 800)
    если о == пусто:
        верни 1
    х *Холст = холст_новый(1280, 800)
    прм цел.верх = 0
    эп цел.верх = 0
    верно_эп цел.верх = 0
    ист_инд цел.верх = 0
    заполнено цел.верх = 0
    длина_к цел.верх = 0
    печатьстр("визуализация обучения запущена (закройте окно для выхода)")
    пока о.живо:
        окно_опрос(о)
        если не о.живо:
            хватит
        для шаг в 0..2:
            бс цел.верх = прм * 4096
            кл = прм % 8
            для б в 0..2:
                цв[б] = век вещ.рост х 4{цель[прм*8 + б*4], цель[прм*8 + б*4 + 1],
                    цель[прм*8 + б*4 + 2], цель[прм*8 + б*4 + 3]}
            # прямой проход
            слой1_прямой(вхм, бс, w1т, б1, &ш1[0])
            для б в 0..288:
                ш1[б] = сигм4(ш1[б])
                для л в 0..4:
                    ш1п[б*4 + л] = ш1[б][л]
            для б в 0..72:
                ш2[б] = б2[б]
            для и в 0..1152:
                вход4 век вещ.рост х 4 = повтор(ш1п[и])
                для б в 0..72:
                    ш2[б] += w2т[и*72 + б] * вход4
            для б в 0..72:
                ш2[б] = сигм4(ш2[б])
                для л в 0..4:
                    ш2п[б*4 + л] = ш2[б][л]
            луч цел.верх = 0
            лучз вещ.рост = -1.0
            для б в 0..2:
                а век вещ.рост х 4 = б3[б]
                для и в 0..288:
                    а += w3т[и*2 + б] * повтор(ш2п[и])
                вых[б] = сигм4(а)
                для л в 0..4:
                    выхп[б*4 + л] = вых[б][л]
                    если вых[б][л] > лучз:
                        лучз = вых[б][л]
                        луч = б*4 + л
            если луч == кл:
                верно_эп += 1
                ист[ист_инд] = 1.0
            иначе:
                ист[ист_инд] = 0.0
            ист_инд = (ист_инд + 1) % 512
            если заполнено < 512:
                заполнено += 1
            # дельты
            для б в 0..2:
                д3в[б] = (вых[б] - цв[б]) * вых[б] * (ед4 - вых[б])
            для и в 0..288:
                сум вещ.рост = сумма(w3т[и*2]*д3в[0] + w3т[и*2+1]*д3в[1])
                д2[и] = сум * ш2п[и] * (1.0 - ш2п[и])
            для б в 0..72:
                д2в[б] = век вещ.рост х 4{д2[б*4], д2[б*4+1], д2[б*4+2], д2[б*4+3]}
            для и в 0..1152:
                сум = 0.0
                для б в 0..72:
                    сум += сумма(w2т[и*72 + б] * д2в[б])
                д1[и] = сум * ш1п[и] * (1.0 - ш1п[и])
            для б в 0..288:
                д1в[б] = век вещ.рост х 4{д1[б*4], д1[б*4+1], д1[б*4+2], д1[б*4+3]}
            # обновления
            скв век вещ.рост х 4 = повтор(скор)
            для и в 0..288:
                ши век вещ.рост х 4 = повтор(скор * ш2п[и])
                для б в 0..2:
                    w3т[и*2 + б] -= ши * д3в[б]
            для б в 0..2:
                б3[б] -= скв * д3в[б]
            для и в 0..1152:
                ши = повтор(скор * ш1п[и])
                для б в 0..72:
                    w2т[и*72 + б] -= ши * д2в[б]
            для б в 0..72:
                б2[б] -= скв * д2в[б]
            слой1_обнови(вхм, бс, w1т, &д1в[0], скор)
            для б в 0..288:
                б1[б] -= скв * д1в[б]
            прм += 1
            если прм == 480:
                печать("эпоха ")
                печать(цел_в_стр(эп))
                печать(": точность ")
                печать(цел_в_стр(верно_эп))
                печатьстр(" / 480")
                прм = 0
                эп += 1
                верно_эп = 0
        # точность по скользящему окну
        сум_ист вещ.рост = 0.0
        для и в 0..заполнено:
            сум_ист += ист[и]
        точность вещ.рост = сум_ист / (заполнено как вещ.рост)
        если длина_к < 600:
            кривая[длина_к] = точность
            длина_к += 1
        иначе:
            для и в 0..599:
                кривая[и] = кривая[и + 1]
            кривая[599] = точность
        бс = прм * 4096
        если бс >= 480 * 4096:
