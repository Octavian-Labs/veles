            а если уй_зона(мх, му, 202, 8, 46, 24):
                темп = 1
            а если уй_зона(мх, му, 252, 8, 46, 24):
                темп = 4
            а если уй_зона(мх, му, 302, 8, 52, 24):
                темп = 16
            а если уй_зона(мх, му, 362, 8, 90, 24):
                # сброс весов в исходное состояние того же зерна
                зерно = 987654321
                для и в 0..1179648:
                    w1т[и] = век вещ.рост х 4{случ32(&зерно, 0.03), случ32(&зерно, 0.03), случ32(&зерно, 0.03), случ32(&зерно, 0.03)}
                для и в 0..82944:
                    w2т[и] = век вещ.рост х 4{случ32(&зерно, 0.1), случ32(&зерно, 0.1), случ32(&зерно, 0.1), случ32(&зерно, 0.1)}
                для и в 0..576:
                    w3т[и] = век вещ.рост х 4{случ32(&зерно, 0.15), случ32(&зерно, 0.15), случ32(&зерно, 0.15), случ32(&зерно, 0.15)}
                для б в 0..288:
                    б1[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}
                для б в 0..72:
                    б2[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}
                для б в 0..2:
                    б3[б] = век вещ.рост х 4{0.0, 0.0, 0.0, 0.0}
                прм = 0
                эп = 0
                верно_эп = 0
                прм_счёт = 0
                лосс = 0.0
                точность = 0.0
                выб_слой = 0
                выб_инд = 0
                заполнено = 0
                длина_к = 0
                для и в 0..512:
