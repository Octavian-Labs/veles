            иначе:
                # выбор нейрона кликом
                выб_слой = 0
                для б в 0..24:
                    если в_узле(мх, му, Х_Ш1, узел_у(б, 24)):
                        выб_слой = 1
                        выб_инд = б * 48
                для б в 0..18:
                    если в_узле(мх, му, Х_Ш2, узел_у(б, 18)):
                        выб_слой = 2
                        выб_инд = б * 16
                для б в 0..8:
                    если в_узле(мх, му, Х_ВЫХ, узел_у(б, 8)):
                        выб_слой = 3
                        выб_инд = б
        # --- обучение ---
        шагов цел.верх = темп
        если шаг_один:
            шагов = 1
            шаг_один = нет
            пауза = да
        если пауза:
            шагов = 0
        для шаг в 0..шагов:
            бс цел.верх = прм * 4096
            кл = прм % 8
            для б в 0..2:
                цв[б] = век вещ.рост х 4{цель[прм*8 + б*4], цель[прм*8 + б*4 + 1],
                    цель[прм*8 + б*4 + 2], цель[прм*8 + б*4 + 3]}
            слой1_прямой(вхм, бс, w1т, б1, &ш1[0])
            для б в 0..288:
                ш1[б] = сигм4(ш1[б])
                для л в 0..4:
                    ш1п[б*4 + л] = ш1[б][л]
            для б в 0..72:
                ш2[б] = б2[б]
            для и в 0..1152:
                вход4 век вещ.рост х 4 = повтор(ш1п[и])
                для б в 0..72:
                    ш2[б] += w2т[и*72 + б] * вход4
            для б в 0..72:
                ш2[б] = сигм4(ш2[б])
                для л в 0..4:
                    ш2п[б*4 + л] = ш2[б][л]
            луч цел.верх = 0
            лучз вещ.рост = -1.0
            для б в 0..2:
                ак4 век вещ.рост х 4 = б3[б]
                для и в 0..288:
                    ак4 += w3т[и*2 + б] * повтор(ш2п[и])
                вых[б] = сигм4(ак4)
                для л в 0..4:
                    выхп[б*4 + л] = вых[б][л]
                    если вых[б][л] > лучз:
                        лучз = вых[б][л]
                        луч = б*4 + л
            пр = луч
            лосс = 0.0
            для ж в 0..8:
                дц вещ.рост = выхп[ж] - цель[прм*8 + ж]
                лосс += дц * дц
            лосс = лосс / 8.0
            # запись выхода в кольцо вероятностей
            для ж в 0..8:
                тепло[(прм % 64)*8 + ж] = выхп[ж]
            если луч == кл:
                верно_эп += 1
                ист[ист_инд] = 1.0
            иначе:
                ист[ист_инд] = 0.0
            ист_инд = (ист_инд + 1) % 512
            если заполнено < 512:
                заполнено += 1
            для б в 0..2:
                д3в[б] = (вых[б] - цв[б]) * вых[б] * (ед4 - вых[б])
            для и в 0..288:
