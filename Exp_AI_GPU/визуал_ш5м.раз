        рисуй(х, вхм, бс, прм % 8, луч, &ш1п[0], &ш2п[0], &выхп[0],
              w1т, w2т, w3т, &кривая[0], длина_к, точность)
        окно_покажи(о, х)
        окно_спи(1)
    холст_свободен(х)
    окно_закрой(о)
    печатьстр("визуализация завершена")
