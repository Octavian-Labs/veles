# каталог — перечисление файлов Windows для утилиты ИЩИ.

взять основа

внеш "kernel32" функ FindFirstFileW(маска *нат.шаг, данные *нат.старт) нат.верх
внеш "kernel32" функ FindNextFileW(поиск нат.верх, данные *нат.старт) цел.рост
внеш "kernel32" функ FindClose(поиск нат.верх) цел.рост
внеш "kernel32" функ GetFileAttributesW(путь *нат.шаг) нат.рост

конст КАТАЛОГ = 0x10
конст ССЫЛКА = 0x400
конст НЕВЕРНЫЕ_АТРИБУТЫ = 0xFFFFFFFF
конст НЕВЕРНЫЙ_ПОИСК = 0xFFFFFFFFFFFFFFFF

функ _шир_в_стр(шир *нат.шаг) стр:
    длина цел.рост = WideCharToMultiByte(65001, 0, шир, -1,
                                         пусто, 0, пусто, пусто)
    если длина <= 0:
        верни пусто как стр
    байты *нат.старт = выдели(длина как нат.верх)
    WideCharToMultiByte(65001, 0, шир, -1, байты, длина, пусто, пусто)
    верни стр_собери(байты, (длина - 1) как нат.верх)

функ _соедини(каталог стр, имя стр) стр:
    если каталог.длина == 0:
        верни имя
    конец нат.старт = каталог.данные[каталог.длина - 1]
    если конец == '\\' или конец == '/':
        верни стр_склей(каталог, имя)
    верни стр_склей(стр_склей(каталог, "\\"), имя)

функ _перечисли(путь стр, рекурсивно лог, файлы *Список) лог:
    атрибуты нат.рост = GetFileAttributesW(стр_в_шир(путь))
    если атрибуты == НЕВЕРНЫЕ_АТРИБУТЫ:
        верни нет
    если (атрибуты & КАТАЛОГ) == 0:
        список_добавь(файлы, путь как нат.верх)
        верни да

    маска стр = _соедини(путь, "*")
    данные *нат.старт = выдели(640)
    поиск нат.верх = FindFirstFileW(стр_в_шир(маска), данные)
    если поиск == НЕВЕРНЫЙ_ПОИСК:
        верни нет

    продолжать лог = да
    пока продолжать:
        поля *нат.рост = данные как *нат.рост
        свойства нат.рост = поля[0]
        имя_шир *нат.шаг = (данные + 44) как *нат.шаг
        имя стр = _шир_в_стр(имя_шир)
        если не стр_равны(имя, ".") и не стр_равны(имя, ".."):
            полный стр = _соедини(путь, имя)
            если (свойства & КАТАЛОГ) != 0:
                если рекурсивно и (свойства & ССЫЛКА) == 0:
                    _перечисли(полный, рекурсивно, файлы)
            иначе:
                список_добавь(файлы, полный как нат.верх)
        продолжать = FindNextFileW(поиск, данные) != 0
    FindClose(поиск)
    верни да

функ каталог_собери(путь стр, рекурсивно лог, файлы *Список) лог:
    верни _перечисли(путь, рекурсивно, файлы)
