# ИЩИ — поиск текста UTF-8 по файлам и каталогам.
# Коды выхода: 0 — найдено, 1 — совпадений нет, 2 — ошибка.

взять основа, каталог

запись Настройки:
    образец стр
    без_регистра лог
    только_имена лог
    рекурсивно лог
    двоичные лог
    итог лог
    расширение стр
    пути *Список

запись Результат:
    совпадения нат.верх
    файлы нат.верх
    ошибки нат.верх

функ _разделитель(байт нат.старт) лог:
    верни байт == 0 или байт == 32 или байт == 9

функ _аргументы_разбери(команда стр) *Список:
    # Windows даёт одну строку, Linux/macOS — NUL-разделённый argv.
    слова *Список = список_новый()
    поз нат.верх = 0
    пока поз < команда.длина:
        пока поз < команда.длина и _разделитель(команда.данные[поз]):
            поз += 1
        если поз >= команда.длина:
            хватит
        буфер *Буфер = буф_новый()
        кавычки лог = нет
        пока поз < команда.длина:
            байт нат.старт = команда.данные[поз]
            если байт == 34:
                кавычки = не кавычки
                поз += 1
            а если не кавычки и _разделитель(байт):
                хватит
            иначе:
                буф_сим(буфер, байт)
                поз += 1
        список_добавь(слова, буф_стр(буфер) как нат.верх)
    верни слова

функ _помощь():
    печатьстр("ИЩИ — поиск текста UTF-8")
    печатьстр("")
    печатьстр("использование:")
    печатьстр("  ищи [параметры] <образец> [путь ...]")
    печатьстр("")
    печатьстр("параметры:")
    печатьстр("  -н, --без-регистра   не учитывать регистр (ASCII + кириллица)")
    печатьстр("  -л, --только-имена   печатать только имена найденных файлов")
    печатьстр("  --без-рекурсии       не входить во вложенные каталоги")
    печатьстр("  --расш <.раз>        искать только файлы с расширением")
    печатьстр("  --двоичные           не пропускать файлы с нулевыми байтами")
    печатьстр("  --итог               напечатать итоговые счётчики")
    печатьстр("  -п, --помощь         эта справка")
    печатьстр("")
    печатьстр("если путь не указан, используется текущий каталог")

функ _настройки(слова *Список, ошибка *нат.верх, справка *нат.верх) *Настройки:
    настройки *Настройки = новый(Настройки)
    настройки.образец = пусто как стр
    настройки.без_регистра = нет
    настройки.только_имена = нет
    настройки.рекурсивно = да
    настройки.двоичные = нет
    настройки.итог = нет
    настройки.расширение = пусто как стр
    настройки.пути = список_новый()
    конец_параметров лог = нет
    индекс нат.верх = 1                  # argv[0] — сама программа
    пока индекс < слова.длина:
        слово стр = список_получи(слова, индекс) как стр
        если не конец_параметров и стр_равны(слово, "--"):
            конец_параметров = да
        а если не конец_параметров и (стр_равны(слово, "-п") или
                                     стр_равны(слово, "--помощь")):
            справка[0] = 1
        а если не конец_параметров и (стр_равны(слово, "-н") или
                                     стр_равны(слово, "--без-регистра")):
            настройки.без_регистра = да
        а если не конец_параметров и (стр_равны(слово, "-л") или
                                     стр_равны(слово, "--только-имена")):
            настройки.только_имена = да
        а если не конец_параметров и стр_равны(слово, "--без-рекурсии"):
            настройки.рекурсивно = нет
        а если не конец_параметров и стр_равны(слово, "--двоичные"):
            настройки.двоичные = да
        а если не конец_параметров и стр_равны(слово, "--итог"):
            настройки.итог = да
        а если не конец_параметров и стр_равны(слово, "--расш"):
            индекс += 1
            если индекс >= слова.длина:
                печать_ош("ищи: после --расш требуется расширение\n")
                ошибка[0] = 1
                верни настройки
            настройки.расширение = список_получи(слова, индекс) как стр
        а если не конец_параметров и стр_начинается(слово, "-"):
            печать_ош("ищи: неизвестный параметр «")
            печать_ош(слово)
            печать_ош("»\n")
            ошибка[0] = 1
            верни настройки
        а если настройки.образец == пусто:
            настройки.образец = слово
        иначе:
            список_добавь(настройки.пути, слово как нат.верх)
        индекс += 1
    если настройки.пути.длина == 0:
        список_добавь(настройки.пути, "." как нат.верх)
    верни настройки

функ _оканчивается(строка стр, окончание стр) лог:
    если окончание == пусто или окончание.длина == 0:
        верни да
    если строка.длина < окончание.длина:
        верни нет
    хвост стр = стр_срез(строка, строка.длина - окончание.длина, строка.длина)
    верни стр_равны_нр(хвост, окончание)

функ _двоичный(данные стр) лог:
    предел нат.верх = данные.длина
    если предел > 8192:
        предел = 8192
    для поз в 0..предел:
        если данные.данные[поз] == 0:
            верни да
    верни нет

функ _столбец(строка стр, байтовая_поз нат.верх) нат.верх:
    # Пользовательский столбец — номер кодовой точки UTF-8, начиная с 1.
    столбец нат.верх = 1
    для поз в 0..байтовая_поз:
        если (строка.данные[поз] & 0xC0) != 0x80:
            столбец += 1
    верни столбец

функ _покажи(путь стр, номер нат.верх, столбец нат.верх, строка стр):
    печать(путь)
    печать(":")
    печатьцел(номер как цел.верх)
    печать(":")
    печатьцел(столбец как цел.верх)
    печать(": ")
    печатьстр(строка)

функ _ищи_файл(путь стр, настройки *Настройки, результат *Результат):
    если не _оканчивается(путь, настройки.расширение):
        верни
    данные стр = файл_прочти(путь)
    если данные == пусто:
        печать_ош("ищи: не прочитать «")
        печать_ош(путь)
        печать_ош("»\n")
        результат.ошибки += 1
        верни
    если не настройки.двоичные и _двоичный(данные):
        верни
    результат.файлы += 1
    просмотр стр = данные
    образец стр = настройки.образец
    если настройки.без_регистра:
        просмотр = стр_вниз(данные)
        образец = стр_вниз(образец)

    начало нат.верх = 0
    номер нат.верх = 1
    пока начало <= данные.длина:
        конец нат.верх = начало
        пока конец < данные.длина и данные.данные[конец] != 10:
            конец += 1
        видимый_конец нат.верх = конец
        если видимый_конец > начало и данные.данные[видимый_конец - 1] == 13:
            видимый_конец -= 1
        исходная_строка стр = стр_срез(данные, начало, видимый_конец)
        строка_поиска стр = стр_срез(просмотр, начало, видимый_конец)
        позиция цел.верх = стр_найди(строка_поиска, образец)
        если позиция >= 0:
            результат.совпадения += 1
            если настройки.только_имена:
                печатьстр(путь)
                верни
            столбец нат.верх = _столбец(исходная_строка, позиция как нат.верх)
            _покажи(путь, номер, столбец, исходная_строка)
        если конец >= данные.длина:
            хватит
        начало = конец + 1
        номер += 1

функ главная() цел.верх:
    слова *Список = _аргументы_разбери(аргументы())
    ошибка нат.верх = 0
    справка нат.верх = 0
    настройки *Настройки = _настройки(слова, &ошибка, &справка)
    если справка != 0:
        _помощь()
        верни 0
    если ошибка != 0:
        верни 2
    если настройки.образец == пусто или настройки.образец.длина == 0:
        печать_ош("ищи: не указан непустой образец поиска\n")
        печать_ош("ищи: используйте --помощь\n")
        верни 2

    результат *Результат = новый(Результат)
    результат.совпадения = 0
    результат.файлы = 0
    результат.ошибки = 0
    файлы *Список = список_новый()
    для индекс в 0..настройки.пути.длина:
        путь стр = список_получи(настройки.пути, индекс) как стр
        если не каталог_собери(путь, настройки.рекурсивно, файлы):
            печать_ош("ищи: путь не найден или недоступен «")
            печать_ош(путь)
            печать_ош("»\n")
            результат.ошибки += 1
    для индекс2 в 0..файлы.длина:
        _ищи_файл(список_получи(файлы, индекс2) как стр, настройки, результат)

    если настройки.итог:
        печать("ищи: файлов ")
        печатьцел(результат.файлы как цел.верх)
        печать(", совпадений ")
        печатьцел(результат.совпадения как цел.верх)
        печать(", ошибок ")
        печатьцел(результат.ошибки как цел.верх)
        печатьстр("")
    если результат.ошибки != 0:
        верни 2
    если результат.совпадения == 0:
        верни 1
    верни 0
