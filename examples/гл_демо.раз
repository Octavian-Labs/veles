# гл_демо — окно с OpenGL-контекстом: треугольник fixed-pipeline,
# строки версии/рендерера и косвенный вызов через wglGetProcAddress.
# Локальная демонстрация библиотеки «гл» (Windows); в прогон не входит.

взять основа
взять холст
взять окно
взять гл

функ главная() цел.верх:
    о *Окно = окно_создай("ВЕЛЕС — OpenGL", 400, 300)
    если о == пусто:
        верни 1
    г *Гл = гл_начни(о)
    если г == пусто:
        окно_закрой(о)
        верни 2
    печатьстр(стр_склей("GL версия: ", гл_версия()))
    печатьстр(стр_склей("GL рендерер: ", гл_произв()))
    # современный путь: адрес функции → тип «функ» → косвенный вызов
    # (glGenBuffers — не экспорт opengl32, доступна только через wglGetProcAddress)
    гген функ(цел.рост, *нат.рост) пусто = гл_функ("glGenBuffers") как функ(цел.рост, *нат.рост) пусто
    если (гген как нат.верх) == 0:
        верни 3
    ид нат.рост = 0
    гген(1, &ид)
    печатьстр(стр_склей("glGenBuffers → ид ", цел_в_стр(ид как цел.верх)))
    если ид == 0:
        верни 4
    нач нат.верх = время_мс()
    пока о.живо и время_мс() - нач < 8000:
        окно_опрос(о)
        гл_порт(0, 0, 400, 300)
        гл_фон(0.08, 0.08, 0.15)
        гл_очисть(ГЛ_ЦВЕТ | ГЛ_ГЛУБИНА)
        гл_матрица(ГЛ_ПРОЕКЦИЯ)
        гл_единица()
        гл_орто(-200.0, 200.0, -150.0, 150.0, -1.0, 1.0)
        гл_матрица(ГЛ_МОДЕЛЬ)
        гл_единица()
        угол вещ.рост = (((время_мс() - нач) % 3600) как вещ.рост) / 10.0
        гл_поворот(угол, 0.0, 0.0, 1.0)
        гл_начало(ГЛ_ТРЕУГ)
        гл_цвет(ХОЛСТ_КРАСНЫЙ)
        гл_вершина2(0.0, -110.0)
        гл_цвет(ХОЛСТ_ЗЕЛЁНЫЙ)
        гл_вершина2(-110.0, 80.0)
        гл_цвет(ХОЛСТ_СИНИЙ)
        гл_вершина2(110.0, 80.0)
        гл_окончание()
        гл_обмен(г)
        окно_спи(16)
    печатьстр(стр_склей("glGetError = ", цел_в_стр(гл_ошибка() как цел.верх)))
    гл_конец(г)
    окно_закрой(о)
    печатьстр("гл демо завершено")
    верни 0
