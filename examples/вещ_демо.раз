# литералы, арифметика, циклы на вещественных, функции с xmm-параметрами,
# явные приведения как, ручная печать с дробной частью.

взять основа

# печать вещественного числа: знак, целая часть, дробная часть
# (встроенная печать вещ — этап вещ-рост; здесь — ручной разбор)
функ печать_вещ(х вещ.верх, цифр цел.верх):
    если х < 0.0:
        печать("-")
        х = 0.0 - х
    целая цел.верх = х как цел.верх          # усечение вещ -> цел
    печать(цел_в_стр(целая))
    печать(".")
    дроб вещ.верх = х - (целая как вещ.верх)
    для и в 0..цифр:
        дроб = дроб * 10.0
        д цел.верх = дроб как цел.верх
        печать(цел_в_стр(д))
        дроб = дроб - (д как вещ.верх)

функ отчёт(что стр, х вещ.верх):
    печать(что)
    печать_вещ(х, 4)
    печатьстр("")

# квадратный корень методом Ньютона: х = (х + а/х) / 2 до сходимости
функ корень(а вещ.верх) вещ.верх:
    х вещ.верх = а
    дельта вещ.верх = х * х - а
    пока дельта > 1e-10 или дельта < -1e-10:
        х = (х + а / х) / 2.0
        дельта = х * х - а
    верни х

# сложный процент: вклад, ставка в %, лет
функ вклад(сумма вещ.верх, ставка вещ.верх, лет цел.верх) вещ.верх:
    итог вещ.верх = сумма
    для год в 0..лет:
        итог = итог + итог * ставка / 100.0
    верни итог

открыто функ главная() цел.верх:
    пи вещ.верх = 3.141592653589793

    # геометрия: окружность и круг радиуса 2.5
    рад вещ.верх = 2.5
    отчёт("длина окружности 2пr: ", 2.0 * пи * рад)     # 15.7079...
    отчёт("площадь круга пr^2:   ", пи * рад * рад)     # 19.6349...

    # гипотенуза треугольника 3-4 — Ньютонов цикл на вещ
    отчёт("гипотенуза 3-4:       ", корень(3.0*3.0 + 4.0*4.0))  # 5.0
    отчёт("корень из 2:          ", корень(2.0))         # 1.4142...

    # финансы: 1000 под 7.5% на 10 лет
    отчёт("вклад через 10 лет:   ", вклад(1000.0, 7.5, 10))     # ~2061.03

    # смешанные типы: целые и вещественные вместе через как
    стороны цел.верх = 7
    отчёт("площадь 7-угольника*: ", (стороны как вещ.верх) * 2.5 * 2.5)

    верни 0
