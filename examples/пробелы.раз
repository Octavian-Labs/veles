# Проверка новых возможностей РАЗУМА: методы, косвенные вызовы,
# литералы записей/массивов, срезы, искра с доступом к локалам.

запись Точка:
    икс цел.верх
    игрек цел.верх

функ (точка *Точка) норма2() цел.верх:
    верни точка.икс * точка.икс + точка.игрек * точка.игрек

функ (точка Точка) сумма() цел.верх:
    верни точка.икс + точка.игрек

функ удвоить(арг цел.верх) цел.верх:
    верни арг * 2

функ главная() цел.верх:
    # литерал записи + методы
    точка Точка = Точка{икс: 3, игрек: 4}
    рез цел.верх = точка.норма2()  # 25
    указ *Точка = &точка
    рез = рез + указ.норма2()       # +25 = 50
    рез = рез + точка.сумма()        # +7  = 57

    # косвенный вызов через переменную-функцию
    операция функ(цел.верх) цел.верх = удвоить
    рез = рез + операция(1)             # +2  = 59

    # литерал массива + срез
    числа нат.старт[5] = нат.старт[5]{10, 20, 30, 40, 50}
    введи срез = числа[1..4]   # {данные: числа+1, длина: 3}
    рез = рез + срез.длина         # +3  = 62
    рез = рез + срез[0]            # +20 = 82 (ср[0] = числа[1])

    # искра видит локальные переменные
    искра:
        ПЕР АКК, рез
        ВЫЧ АКК, 30
        ПЕР рез, АКК           # 82 - 30 = 52
    верни рез
