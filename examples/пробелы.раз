# Проверка новых возможностей РАЗУМА: методы, косвенные вызовы,
# литералы записей/массивов, срезы, искра с доступом к локалам.

запись Точка:
    х цел64
    у цел64

функ (т *Точка) норма2() цел64:
    верни т.х * т.х + т.у * т.у

функ (т Точка) сумма() цел64:
    верни т.х + т.у

функ удвоить(а цел64) цел64:
    верни а * 2

функ главная() цел64:
    # литерал записи + методы
    т Точка = Точка{х: 3, у: 4}
    н := т.норма2()          # 25
    п *Точка = &т
    н = н + п.норма2()       # +25 = 50
    н = н + т.сумма()        # +7  = 57

    # косвенный вызов через переменную-функцию
    ф функ(цел64) цел64 = удвоить
    н = н + ф(1)             # +2  = 59

    # литерал массива + срез
    arr без8[5] = без8[5]{10, 20, 30, 40, 50}
    ср := arr[1..4]          # {данные: arr+1, длина: 3}
    н = н + ср.длина         # +3  = 62
    н = н + ср[0]            # +20 = 82 (ср[0] = arr[1])

    # искра видит локальные переменные
    искра:
        ПЕР АКК, н
        ВЫЧ АКК, 30
        ПЕР н, АКК           # 82 - 30 = 52
    верни н
