;цель linux
; ============================================================
; привет_linux.иск — «Привет, мир!» на русском ассемблере ИСКРА
; Цель: Linux x86-64 (ELF64), системные вызовы ядра
; Сборка:  искра.exe < привет_linux.иск > привет   (ELF по прагме)
; ============================================================

СЕКЦИЯ данные
сообщение:  БАЙТ "Привет, мир!", 10
длина       РАВНО $ - сообщение

СЕКЦИЯ код
ВХОД старт
старт:
    ПЕР АККМ, 1              ; sys_write = 1
    ПЕР ПРММ, 1              ; файловый дескриптор stdout
    АДР ИСТ, [сообщение]     ; адрес строки
    ПЕР ДАНМ, длина          ; длина строки
    СИСВЫЗОВ
    ПЕР АККМ, 60             ; sys_exit = 60
    ИИЛИ ПРММ, ПРММ          ; код выхода = 0
    СИСВЫЗОВ
