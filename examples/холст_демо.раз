;версия 1
# холст_демо — проверка программного холста без окон: рисует примитивы
# и сверяет пиксели; код выхода 42 при успехе.

взять основа
взять холст

функ главная() цел.верх:
    х *Холст = холст_новый(16, 16)
    если х.ширина != 16 или х.высота != 16:
        верни 1
    если холст_возьми(х, 0, 0) != ХОЛСТ_ЧЁРНЫЙ:
        верни 2
    # точка и отсечение
    холст_точка(х, 3, 4, ХОЛСТ_КРАСНЫЙ)
    если холст_возьми(х, 3, 4) != ХОЛСТ_КРАСНЫЙ:
        верни 3
    холст_точка(х, -5, 0, ХОЛСТ_БЕЛЫЙ)
    холст_точка(х, 0, 99, ХОЛСТ_БЕЛЫЙ)
    если холст_возьми(х, -5, 0) != ХОЛСТ_ПУСТОЙ:
        верни 4
    # диагональная линия
    холст_линия(х, 0, 0, 15, 15, ХОЛСТ_ЗЕЛЁНЫЙ)
    если холст_возьми(х, 7, 7) != ХОЛСТ_ЗЕЛЁНЫЙ:
        верни 5
    # горизонтальная линия справа налево
    холст_линия(х, 10, 12, 2, 12, ХОЛСТ_ЖЁЛТЫЙ)
    если холст_возьми(х, 6, 12) != ХОЛСТ_ЖЁЛТЫЙ:
        верни 6
    # залитый прямоугольник
    холст_залей(х, ХОЛСТ_СИНИЙ)
    холст_прямоуг_залей(х, 2, 2, 4, 4, ХОЛСТ_БЕЛЫЙ)
    если холст_возьми(х, 3, 3) != ХОЛСТ_БЕЛЫЙ:
        верни 7
    если холст_возьми(х, 1, 1) != ХОЛСТ_СИНИЙ:
        верни 8
    если холст_возьми(х, 6, 3) != ХОЛСТ_СИНИЙ:
        верни 9
    # залитый круг: центр закрашен, углы нет
    холст_залей(х, ХОЛСТ_ЧЁРНЫЙ)
    холст_круг_залей(х, 8, 8, 4, ХОЛСТ_КРАСНЫЙ)
    если холст_возьми(х, 8, 8) != ХОЛСТ_КРАСНЫЙ:
        верни 10
    если холст_возьми(х, 8, 12) != ХОЛСТ_КРАСНЫЙ:
        верни 11
    если холст_возьми(х, 0, 0) != ХОЛСТ_ЧЁРНЫЙ:
        верни 12
    # контур круга: точки на радиусе
    холст_залей(х, ХОЛСТ_ЧЁРНЫЙ)
    холст_круг(х, 8, 8, 4, ХОЛСТ_ЗЕЛЁНЫЙ)
    если холст_возьми(х, 8, 8) != ХОЛСТ_ЧЁРНЫЙ:
        верни 13
    # блит с отсечением: источник 4x4 левее края
    малый *Холст = холст_новый(4, 4)
    холст_залей(малый, ХОЛСТ_ЖЁЛТЫЙ)
    холст_залей(х, ХОЛСТ_ЧЁРНЫЙ)
    холст_вставь(х, малый, -2, 0)
    если холст_возьми(х, 0, 0) != ХОЛСТ_ЖЁЛТЫЙ:
        верни 14
    если холст_возьми(х, 1, 3) != ХОЛСТ_ЖЁЛТЫЙ:
        верни 15
    если холст_возьми(х, 2, 0) != ХОЛСТ_ЧЁРНЫЙ:
        верни 16
    # ppm: заголовок + по три байта на пиксель
    ppm стр = холст_в_ppm(малый)
    если ppm.длина != 4 * 4 * 3 + 11:
        верни 17
    # состав цвета
    если цвет_кр(ХОЛСТ_ЖЁЛТЫЙ) != 255 или цвет_син(ХОЛСТ_ЖЁЛТЫЙ) != 0:
        верни 18
    если цвет(1, 2, 3) != 0xFF010203:
        верни 19
    холст_свободен(малый)
    холст_свободен(х)
    печатьстр("холст ок")
    верни 42
