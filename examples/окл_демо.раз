# окл_демо — вычисление на GPU через OpenCL: ядро удваивает массив float,
# результат читается обратно и сверяется. Без GPU — вежливый пропуск.
# Локальная демонстрация библиотеки «окл» (Windows); в прогон не входит.

взять основа
взять окл

функ главная() цел.верх:
    ок *Окл = окл_начни()
    если ок == пусто:
        печатьстр("окл: устройство OpenCL не найдено — пропуск")
        верни 0
    печатьстр(стр_склей("Платформа: ", окл_имя_платформы(ок)))
    печатьстр(стр_склей("Устройство: ", окл_имя_устройства(ок)))
    исх стр = "__kernel void dbl(__global float* a){ int i = get_global_id(0); a[i] = a[i] * 2.0f; }"
    прог нат.верх = окл_программа(ок, исх)
    если прог == 0:
        верни 2
    ядро нат.верх = окл_ядро(прог, "dbl")
    если ядро == 0:
        верни 3
    колво размер = 64
    данные *вещ.рост = выдели(колво * 4) как *вещ.рост
    для и в 0..колво:
        данные[и] = (и + 1) как вещ.рост
    буф нат.верх = окл_буфер(ок, ОКЛ_ЧТ_ЗП, колво * 4)
    если буф == 0:
        верни 4
    если не окл_запиши(ок, буф, данные как *нат.старт, колво * 4):
        верни 5
    если не окл_арг_буй(ядро, 0, буф):
        верни 6
    если не окл_запусти(ок, ядро, колво):
        верни 7
    заполни(данные как *нат.старт, 0, колво * 4)
    если не окл_прочти(ок, буф, данные как *нат.старт, колво * 4):
        верни 8
    для и в 0..колво:
        ожид вещ.рост = ((и + 1) * 2) как вещ.рост
        если данные[и] != ожид:
            печатьстр(стр_склей("неверно на ", цел_в_стр(и как цел.верх)))
            верни 9
    окл_освободи_буфер(буф)
    окл_освободи_ядро(ядро)
    окл_освободи_прог(прог)
    освободи(данные)
    окл_конец(ок)
    печатьстр("окл демо: 64 значения удвоены на GPU верно")
    верни 0
