# _демо.раз — пример «скриптового» запуска: разум _демо.раз

взять основа

открыто функ главная() цел.верх:
    печатьстр("=== ВЕЛЕС: скриптовый режим ===")
    печать("argv: ")
    печатьстр(аргументы())

    # векторная арифметика (SSE float4) — прямо в скрипте
    а век вещ.рост х 4 = век вещ.рост х 4{1.5, 2.0, 2.5, 3.0}
    б век вещ.рост х 4 = повтор(2.0 как вещ.рост)
    печать("а*б сумма = ")
    печать_вещ(сумма(а * б))
    печатьстр("")

    # простые числа до 50 — обычный цикл
    печать("простые < 50: ")
    для н в 2..50:
        простое лог = да
        для д в 2..н:
            если д*д > н:
                хватит
            если н % д == 0:
                простое = нет
                хватит
        если простое:
            печать(цел_в_стр(н))
            печать(" ")
    печатьстр("")
    верни 0

функ печать_вещ(знач вещ.рост):
    целая цел.верх = знач как цел.верх
    дробь цел.верх = ((знач - (целая как вещ.рост)) * 100.0 + 0.5) как цел.верх
    печать(цел_в_стр(целая))
    печать(".")
    если дробь < 10:
        печать("0")
    печать(цел_в_стр(дробь))
