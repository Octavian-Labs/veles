# простые — бенчмарк: количество простых чисел до N.
# Перебор делителей до sqrt(n) — чистая арифметика, без ввода-вывода в цикле.
взять основа

функ простое(n цел.верх) лог:
    если n < 2:
        верни нет
    если n % 2 == 0:
        верни n == 2
    д := 3
    пока д * д <= n:
        если n % д == 0:
            верни нет
        д += 2
    верни да

функ главная() цел.верх:
    N цел.верх = 2000000
    к := 0
    для i в 2..=N:
        если простое(i):
            к += 1
    печать("простых до ")
    печатьцел(N)
    печать(": ")
    печатьцел(к)
    печатьстр("")
    верни 0
