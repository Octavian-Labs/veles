# простые — бенчмарк: количество простых чисел до N.
# Перебор делителей до sqrt(n) — чистая арифметика, без ввода-вывода в цикле.
взять основа

функ простое(число цел.верх) лог:
    если число < 2:
        верни нет
    если число % 2 == 0:
        верни число == 2
    дел цел.верх = 3
    пока дел * дел <= число:
        если число % дел == 0:
            верни нет
        дел += 2
    верни да

функ главная() цел.верх:
    предел цел.верх = 2000000
    колво цел.верх = 0
    для ном в 2..=предел:
        если простое(ном):
            колво += 1
    печать("простых до ")
    печатьцел(предел)
    печать(": ")
    печатьцел(колво)
