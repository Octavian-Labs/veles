; ============================================================
; привет.асм — «Привет, мир!» на русском ассемблере РАСМ
; Цель: Windows x86-64 (PE64), вызовы WinAPI из kernel32.dll
; Сборка:  python -m asm_rus привет.асм -o привет.exe
; ============================================================

ИМПОРТ "kernel32.dll" GetStdHandle, WriteFile, ExitProcess

СЕКЦИЯ данные
сообщение:  БАЙТ "Привет, мир!", 13, 10
длина       РАВНО $ - сообщение
записано:   ДВСЛОВО 0

СЕКЦИЯ код
ВХОД старт
старт:
    ВЫЧ УКС, 40              ; теневое пространство + выравнивание стека
    ПЕР СЧТМ, -11            ; STD_OUTPUT_HANDLE = -11
    ВЫЗОВ GetStdHandle       ; АКК = дескриптор консоли
    ПЕР СЧТ, АКК             ; арг 1: дескриптор
    АДР ДАН, [сообщение]     ; арг 2: буфер
    ПЕР Р8М, длина           ; арг 3: сколько байт писать
    АДР Р9, [записано]       ; арг 4: куда положить счётчик
    ПЕР КВАД [УКС+32], 0     ; арг 5: lpOverlapped = NULL
    ВЫЗОВ WriteFile
    ИИЛИ СЧТМ, СЧТМ          ; код выхода = 0
    ВЫЗОВ ExitProcess
