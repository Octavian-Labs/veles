;версия 1
# частицы_демо — 8192 частицы на GPU (OpenCL): гравитация и отскоки
# от стен ядром на float4; позиции читаются и рисуются холстом в окно.
# Локальная демонстрация «окл» + «окно» + «холст» (Windows).

взять основа
взять холст
взять окно
взять окл

открыто конст ЧАСТИЦЫ_КОЛВО = 8192
открыто конст ЧАСТИЦЫ_ШИР = 640
открыто конст ЧАСТИЦЫ_ВЫС = 480

# линейный конгруэнтный генератор — случайность без внешних библиотек
функ _случ(семя *нат.верх) нат.верх:
    семя[0] = семя[0] * 1103515245 + 12345
    верни (семя[0] >> 16) & 0x7FFF

функ главная() цел.верх:
    о *Окно = окно_создай("ВЕЛЕС — частицы на OpenCL", 640, 480)
    если о == пусто:
        верни 1
    ок *Окл = окл_начни()
    если ок == пусто:
        окно_закрой(о)
        верни 2
    печатьстр(стр_склей("GPU: ", окл_имя_устройства(ок)))
    исх стр = "__kernel void step(__global float4* p, float dt, float w, float h){ int i = get_global_id(0); float4 v = p[i]; v.w += 900.0f * dt; v.x += v.z * dt; v.y += v.w * dt; if (v.x < 0.0f) { v.x = 0.0f; v.z = -v.z * 0.85f; } if (v.x > w) { v.x = w; v.z = -v.z * 0.85f; } if (v.y > h) { v.y = h; v.w = -v.w * 0.85f; v.z *= 0.97f; } if (v.y < 0.0f) { v.y = 0.0f; v.w = -v.w * 0.85f; } p[i] = v; }"
    прог нат.верх = окл_программа(ок, исх)
    если прог == 0:
        верни 3
    ядро нат.верх = окл_ядро(прог, "step")
    если ядро == 0:
        верни 4
    # начальное состояние: x,y внутри экрана, vx,vy случайные
    семя нат.верх = 42
    данные *вещ.рост = выдели(ЧАСТИЦЫ_КОЛВО * 16) как *вещ.рост
    для и в 0..ЧАСТИЦЫ_КОЛВО:
        данные[и * 4] = (_случ(&семя) % 640) как вещ.рост
        данные[и * 4 + 1] = (_случ(&семя) % 240) как вещ.рост
        данные[и * 4 + 2] = (((_случ(&семя) % 400) как цел.верх) - 200) как вещ.рост
        данные[и * 4 + 3] = (((_случ(&семя) % 300) как цел.верх) - 250) как вещ.рост
    буф нат.верх = окл_буфер(ок, ОКЛ_ЧТ_ЗП, ЧАСТИЦЫ_КОЛВО * 16)
    если буф == 0:
        верни 5
    если не окл_запиши(ок, буф, данные как *нат.старт, ЧАСТИЦЫ_КОЛВО * 16):
        верни 6
    если не окл_арг_буй(ядро, 0, буф):
        верни 7
    если не окл_арг_вещ(ядро, 1, 0.016):
        верни 8
    если не окл_арг_вещ(ядро, 2, 640.0):
        верни 9
    если не окл_арг_вещ(ядро, 3, 480.0):
        верни 10
    х *Холст = холст_новый(640, 480)
    нач нат.верх = время_мс()
    кадров нат.верх = 0
    пока о.живо и время_мс() - нач < 12000:
        окно_опрос(о)
        если не окл_запусти(ок, ядро, ЧАСТИЦЫ_КОЛВО):
            верни 11
        если не окл_прочти(ок, буф, данные как *нат.старт, ЧАСТИЦЫ_КОЛВО * 16):
            верни 12
        холст_залей(х, цвет(10, 10, 25))
        для и в 0..ЧАСТИЦЫ_КОЛВО:
            пх цел.верх = данные[и * 4] как цел.верх
            пу цел.верх = данные[и * 4 + 1] как цел.верх
            скх цел.верх = данные[и * 4 + 2] как цел.верх
            ску цел.верх = данные[и * 4 + 3] как цел.верх
            если скх < 0:
                скх = -скх
            если ску < 0:
                ску = -ску
            яркость цел.верх = (скх + ску) / 6
            если яркость > 255:
                яркость = 255
            холст_точка(х, пх, пу, цвет(яркость как нат.старт, 128,
                (255 - яркость) как нат.старт))
        окно_покажи(о, х)
        кадров += 1
    печатьстр(стр_склей("кадров: ", цел_в_стр(кадров как цел.верх)))
    окл_освободи_буфер(буф)
    окл_освободи_ядро(ядро)
    окл_освободи_прог(прог)
    освободи(данные)
    окл_конец(ок)
    холст_свободен(х)
    окно_закрой(о)
    печатьстр("частицы демо завершено")
    верни 0
