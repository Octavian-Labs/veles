;версия 1
# окно_демо — окно с холстом: градиентный фон, фигуры, ~3 секунды кадров.
# Локальная демонстрация библиотеки «окно» (Windows); в прогон не входит.

взять основа
взять холст
взять окно

функ главная() цел.верх:
    о *Окно = окно_создай("ВЕЛЕС — окно и холст", 320, 200)
    если о == пусто:
        верни 1
    х *Холст = холст_новый(320, 200)
    для ряд в 0..200:
        для кол в 0..320:
            холст_точка(х, кол, ряд,
                цвет((кол * 255 / 320) как нат.старт,
                     (ряд * 255 / 200) как нат.старт, 128))
    холст_круг_залей(х, 160, 100, 40, ХОЛСТ_ЖЁЛТЫЙ)
    холст_круг(х, 160, 100, 52, ХОЛСТ_БЕЛЫЙ)
    холст_линия(х, 0, 0, 319, 199, ХОЛСТ_КРАСНЫЙ)
    холст_линия(х, 319, 0, 0, 199, ХОЛСТ_КРАСНЫЙ)
    холст_прямоуг(х, 20, 150, 60, 30, ХОЛСТ_ЗЕЛЁНЫЙ)
    нач нат.верх = время_мс()
    пока о.живо и время_мс() - нач < 6000:
        окно_опрос(о)
        окно_покажи(о, х)
        окно_спи(16)
    окно_закрой(о)
    холст_свободен(х)
    печатьстр("окно демо завершено")
    верни 0
