# бенч — набор микробенчмарков РАЗУМА с внутренним таймером.
# Меряет: арифметику, вызовы, память, строки, список.
# Запуск: разум.exe < бенч.раз > бенч.иск; искра.exe < бенч.иск > бенч.exe

взять основа

внеш "kernel32" функ QueryPerformanceCounter(сч *цел.верх) цел.рост
внеш "kernel32" функ QueryPerformanceFrequency(част *цел.верх) цел.рост

функ тик() цел.верх:
    счёт цел.верх = 0
    QueryPerformanceCounter(&счёт)
    верни счёт

функ частота() цел.верх:
    част цел.верх = 0
    QueryPerformanceFrequency(&част)
    верни част

# арифметика в плотном цикле
функ б_ариф() цел.верх:
    сум цел.верх = 0
    для инд в 0..10000000:
        сум = (сум + инд * 3) % 1000003
    верни сум

# вызов маленькой функции в цикле
функ _плюс1(арг цел.верх) цел.верх:
    верни арг + 1

функ б_вызов() цел.верх:
    сум цел.верх = 0
    для инд в 0..1000000:
        сум = сум + _плюс1(инд)
    верни сум

# копирование памяти
функ б_память() цел.верх:
    буф1 *нат.старт = выдели(1000000)
    буф2 *нат.старт = выдели(1000000)
    для инд в 0..1000000:
        буф1[инд] = (инд % 251) как нат.старт
    для повтор в 0..10:
        скопируй(буф2, буф1, 1000000)
    сум цел.верх = 0
    для инд в 0..1000000:
        сум = сум + буф2[инд]
    освободи(буф1)
    освободи(буф2)
    верни сум

# работа со строками
функ б_строки() цел.верх:
    сум цел.верх = 0
    строка стр = "бенчмарк-строка"
    для инд в 0..100000:
        сум = сум + строка.длина как цел.верх
        сум = сум + стр_найди("простая строка для поиска", "поиск")
    верни сум

# список: добавление и обход
функ б_список() цел.верх:
    список *Список = список_новый()
    для инд в 0..100000:
        список_добавь(список, (инд * 7) как нат.верх)
    сум цел.верх = 0
    для инд в 0..список.длина:
        сум = сум + (список_получи(список, инд) как цел.верх)
    верни сум

функ прогони(имя стр, замер функ() цел.верх, част цел.верх):
    т0 цел.верх = тик()
    рез цел.верх = замер()
    т1 цел.верх = тик()
    мс цел.верх = (т1 - т0) * 1000 / част
    печать(имя)
    печать(": ")
    печатьцел(мс)
    печать(" мс (рез: ")
    печатьцел(рез)
    печать(")\n")

функ главная() цел.верх:
    част цел.верх = частота()
    печать("бенч ВЕЛЕС\n")
    прогони("арифметика", б_ариф, част)
    прогони("вызовы    ", б_вызов, част)
    прогони("память    ", б_память, част)
    прогони("строки    ", б_строки, част)
    прогони("список    ", б_список, част)
    верни 0
