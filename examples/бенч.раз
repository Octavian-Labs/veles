# бенч — набор микробенчмарков РАЗУМА с внутренним таймером.
# Меряет: арифметику, вызовы, память, строки, список.
# Запуск: разум.exe < бенч.раз > бенч.иск; искра.exe < бенч.иск > бенч.exe

взять основа

внеш "kernel32" функ QueryPerformanceCounter(сч *цел64) цел32
внеш "kernel32" функ QueryPerformanceFrequency(част *цел64) цел32

функ тик() цел64:
    с цел64 = 0
    QueryPerformanceCounter(&с)
    верни с

функ частота() цел64:
    ч цел64 = 0
    QueryPerformanceFrequency(&ч)
    верни ч

# арифметика в плотном цикле
функ б_ариф() цел64:
    сум := 0
    для i в 0..10000000:
        сум = (сум + i * 3) % 1000003
    верни сум

# вызов маленькой функции в цикле
функ _плюс1(х цел64) цел64:
    верни х + 1

функ б_вызов() цел64:
    сум := 0
    для i в 0..1000000:
        сум = сум + _плюс1(i)
    верни сум

# копирование памяти
функ б_память() цел64:
    а := выдели(1000000)
    б := выдели(1000000)
    для i в 0..1000000:
        а[i] = (i % 251) как без8
    для k в 0..10:
        скопируй(б, а, 1000000)
    сум := 0
    для i в 0..1000000:
        сум = сум + б[i]
    освободи(а)
    освободи(б)
    верни сум

# работа со строками
функ б_строки() цел64:
    сум := 0
    с := "бенчмарк-строка"
    для i в 0..100000:
        сум = сум + с.длина как цел64
        сум = сум + стр_найди("простая строка для поиска", "поиск")
    верни сум

# список: добавление и обход
функ б_список() цел64:
    сп := список_новый()
    для i в 0..100000:
        список_добавь(сп, (i * 7) как без64)
    сум := 0
    для i в 0..сп.длина:
        сум = сум + (список_получи(сп, i) как цел64)
    верни сум

функ прогони(имя стр, ф функ() цел64, част цел64):
    т0 := тик()
    р := ф()
    т1 := тик()
    мс := (т1 - т0) * 1000 / част
    печать(имя)
    печать(": ")
    печатьцел(мс)
    печать(" мс (рез: ")
    печатьцел(р)
    печать(")\n")

функ главная() цел64:
    част := частота()
    печать("бенч ВЕЛЕС\n")
    прогони("арифметика", б_ариф, част)
    прогони("вызовы    ", б_вызов, част)
    прогони("память    ", б_память, част)
    прогони("строки    ", б_строки, част)
    прогони("список    ", б_список, част)
    верни 0
