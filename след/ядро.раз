# ядро — состояние отладчика СЛЕД: запуск, события, точки, шаги, наблюдение.
# Работает поверх Win32 Debug API (ипп.раз).

взять основа
взять ипп

# Причины остановки (поле Отлад.причина):
конст ПР_ШАГ = 1            # завершён пошаговый заход
конст ПР_ТОЧКА = 2          # сработала точка останова
конст ПР_НАБЛЮД = 3         # сработала аппаратная точка наблюдения
конст ПР_ВЫХОД = 4          # процесс завершился
конст ПР_ИСКЛ = 5           # постороннее исключение
конст ПР_СОЗДАН = 6         # процесс создан

запись Точка:
    адр нат.верх
    байт нат.верх              # оригинальный байт под 0xCC
    вкл нат.верх               # 0/1

запись Сим:
    имя стр
    адр нат.верх

запись Отлад:
    жив нат.верх               # 0/1 — процесс жив и под отладкой
    хпроц нат.верх
    хпоток нат.верх            # хендл основного потока
    пид нат.верх
    тид нат.верх               # поток последнего события
    база нат.верх              # lpBaseOfImage
    вход нат.верх              # VA точки входа
    соб *нат.старт               # DEBUG_EVENT
    кон *нат.старт               # CONTEXT (выравнивание 16)
    потоки *Список          # пары нат.верх: [тид, хпоток]
    точки *Список           # *Точка
    симы *Список            # *Сим
    перевооруж нат.верх        # адрес точки для возврата 0xCC после шага
    прод_стат нат.верх         # статус для следующего продолжения
    стоп_код нат.верх          # код выхода процесса
    причина нат.верх           # ПР_*
    прич_адр нат.верх          # адрес точки/исключения
    прич_код нат.верх          # код исключения
    цель стр                # путь к exe цели (для «карта»)
    карта_полна нат.верх       # 0 — прологов и меток разное число

функ отлад_новый() *Отлад:
    о *Отлад = новый(Отлад)
    о.жив = 0
    о.хпроц = 0
    о.хпоток = 0
    о.пид = 0
    о.тид = 0
    о.база = 0
    о.вход = 0
    о.соб = выдели(СОБ_РАЗМЕР)
    ксыр := выдели(КОН_РАЗМЕР + 16) как нат.верх
    к := ксыр + 15
    к = к - (к % 16)            # CONTEXT требует выравнивания 16
    о.кон = к как *нат.старт
    о.потоки = список_новый()
    о.точки = список_новый()
    о.симы = список_новый()
    о.перевооруж = 0
    о.прод_стат = ПРОД_ОК
    о.стоп_код = 0
    о.причина = 0
    о.прич_адр = 0
    о.прич_код = 0
    о.цель = пусто как стр
    о.карта_полна = 1
    верни о

# --- доступ к полям события и контекста -------------------------------------

функ соб_у32(соб *нат.старт, инд нат.верх) нат.верх:
    п *нат.рост = соб как *нат.рост
    верни п[инд] как нат.верх

функ соб_у64(соб *нат.старт, инд нат.верх) нат.верх:
    п *нат.верх = соб как *нат.верх
    верни п[инд]

функ кон_рег(о *Отлад, инд нат.верх) нат.верх:
    п *нат.верх = о.кон как *нат.верх
    верни п[инд]

функ кон_уст(о *Отлад, инд нат.верх, v нат.верх):
    п *нат.верх = о.кон как *нат.верх
    п[инд] = v

функ кон_ефлаги(о *Отлад) нат.верх:
    п *нат.рост = о.кон как *нат.рост
    верни п[К_ЕФЛАГИ] как нат.верх

# --- процесс ------------------------------------------------------------------

функ от_пуск(о *Отлад, путь стр) лог:
    пшир *нат.шаг = стр_в_шир(путь)
    си *нат.старт = выдели(128)
    заполни(си, 0, 128)
    п *нат.рост = си как *нат.рост
    п[0] = СТАРТИНФО_РАЗМЕР
    пи *нат.старт = выдели(24)
    заполни(пи, 0, 24)
    ок := CreateProcessW(пшир, пусто, пусто, пусто, 0,
                         ОТЛ_ФЛАГ как нат.рост, пусто, пусто, си, пи)
    если ок == 0:
        верни нет
    п64 *нат.верх = пи как *нат.верх
    п32 *нат.рост = пи как *нат.рост
    о.хпроц = п64[0]
    о.хпоток = п64[1]
    о.пид = п32[4] как нат.верх
    о.тид = п32[5] как нат.верх
    список_добавь(о.потоки, о.тид)
    список_добавь(о.потоки, о.хпоток)
    о.жив = 1
    о.прод_стат = ПРОД_ОК
    верни да

функ _хпоток(о *Отлад, тид нат.верх) нат.верх:
    # хендл потока по его tid (пары в списке); иначе — основной
    n := о.потоки.длина / 2
    для i в 0..n:
        если список_получи(о.потоки, i * 2) == тид:
            верни список_получи(о.потоки, i * 2 + 1)
    верни о.хпоток

функ кон_прочти(о *Отлад) лог:
    п *нат.рост = о.кон как *нат.рост
    п[К_ФЛАГИ] = КОН_ФЛАГИ как нат.рост
    верни GetThreadContext(_хпоток(о, о.тид), о.кон) != 0

функ кон_запиши(о *Отлад) лог:
    верни SetThreadContext(_хпоток(о, о.тид), о.кон) != 0

функ от_читай(о *Отлад, адр нат.верх, буф *нат.старт, n нат.верх) нат.верх:
    проч нат.верх = 0
    ок := ReadProcessMemory(о.хпроц, адр, буф, n, &проч)
    если ок == 0:
        верни 0
    верни проч

функ от_пиши(о *Отлад, адр нат.верх, буф *нат.старт, n нат.верх) лог:
    зап нат.верх = 0
    ок := WriteProcessMemory(о.хпроц, адр, буф, n, &зап)
    FlushInstructionCache(о.хпроц, адр, n)
    верни ок != 0 и зап == n

# --- точки останова (int3) ----------------------------------------------------

функ точка_найди(о *Отлад, адр нат.верх) цел.верх:
    для i в 0..о.точки.длина:
        т *Точка = список_получи(о.точки, i) как *Точка
        если т.вкл != 0 и т.адр == адр:
            верни i как цел.верх
    верни -1

функ точка_пост(о *Отлад, адр нат.верх) лог:
    если точка_найди(о, адр) >= 0:
        верни да
    б нат.старт = 0
    если от_читай(о, адр, &б, 1) != 1:
        верни нет
    з нат.старт = БАЙТ_ТОЧКИ как нат.старт
    если не от_пиши(о, адр, &з, 1):
        верни нет
    т *Точка = новый(Точка)
    т.адр = адр
    т.байт = б как нат.верх
    т.вкл = 1
    список_добавь(о.точки, т как нат.верх)
    верни да

функ точка_сними(о *Отлад, адр нат.верх) лог:
    i := точка_найди(о, адр)
    если i < 0:
        верни нет
    т *Точка = список_получи(о.точки, i как нат.верх) как *Точка
    б нат.старт = т.байт как нат.старт
    от_пиши(о, т.адр, &б, 1)
    т.вкл = 0
    если о.перевооруж == т.адр:
        о.перевооруж = 0        # не вернём 0xCC в снятую точку после шага
    верни да

# --- аппаратная точка наблюдения (DR0) ----------------------------------------

функ наблюд_пост(о *Отлад, адр нат.верх) лог:
    # DR0 = адрес; Dr7: L0=1, RW0=01 (запись), LEN0=10 (8 байт)
    если не кон_прочти(о):
        верни нет
    кон_уст(о, К_ДР0, адр)
    кон_уст(о, К_ДР7, 0x00090001)
    верни кон_запиши(о)

функ наблюд_сними(о *Отлад) лог:
    если не кон_прочти(о):
        верни нет
    кон_уст(о, К_ДР0, 0)
    кон_уст(о, К_ДР7, 0)
    верни кон_запиши(о)

# --- цикл событий ---------------------------------------------------------------

функ _прод(о *Отлад, стат нат.верх):
    ContinueDebugEvent(соб_у32(о.соб, 1) как нат.рост,
                       соб_у32(о.соб, 2) как нат.рост, стат как нат.рост)

функ от_продолжи(о *Отлад):
    # продолжение со статусом, выставленным обработчиком исключения
    _прод(о, о.прод_стат)
    о.прод_стат = ПРОД_ОК

функ _на_создание(о *Отлад):
    # CREATE_PROCESS_DEBUG_EVENT: хендлы, база образа
    о.хпроц = соб_у64(о.соб, 3)
    о.хпоток = соб_у64(о.соб, 4)
    о.база = соб_у64(о.соб, 5)
    CloseHandle(соб_у64(о.соб, 2))          # hFile
    о.тид = соб_у32(о.соб, 2)
    # пара tid->хендл могла уже быть из PROCESS_INFORMATION — обновим
    n := о.потоки.длина / 2
    для i в 0..n:
        если список_получи(о.потоки, i * 2) == о.тид:
            о.потоки.данные[i * 2 + 1] = о.хпоток
            _прод(о, ПРОД_ОК)
            верни
    список_добавь(о.потоки, о.тид)
    список_добавь(о.потоки, о.хпоток)
    _прод(о, ПРОД_ОК)

функ _прочее_событие(о *Отлад, код нат.верх) лог:
    # обработка событий без остановки; нет — если процесс завершился
    если код == СОБ_ПРОЦ:
        _на_создание(о)
        верни да
    если код == СОБ_ПОТОК:
        список_добавь(о.потоки, соб_у32(о.соб, 2))
        список_добавь(о.потоки, соб_у64(о.соб, 2))
        _прод(о, ПРОД_ОК)
        верни да
    если код == СОБ_ПОТОК_ВЫХ:
        _прод(о, ПРОД_ОК)
        верни да
    если код == СОБ_ДЛЛ:
        CloseHandle(соб_у64(о.соб, 2))      # hFile dll
        _прод(о, ПРОД_ОК)
        верни да
    если код == СОБ_ДЛЛ_ВЫХ или код == СОБ_СТРОКА:
        _прод(о, ПРОД_ОК)
        верни да
    если код == СОБ_ПРОЦ_ВЫХ:
        о.стоп_код = соб_у32(о.соб, 4)      # dwExitCode
        о.жив = 0
        _прод(о, ПРОД_ОК)
        о.причина = ПР_ВЫХОД
        верни нет
    _прод(о, ПРОД_ОК)
    верни да

функ от_исключение(о *Отлад) нат.верх:
    # возвращает ПР_* >0 — останов; 0 — событие проглочено
    код := соб_у32(о.соб, 4)                # ExceptionCode
    адр := соб_у64(о.соб, 4)                # ExceptionAddress
    если код == ИСКЛ_ТОЧКА:
        # ExceptionAddress = адрес байта 0xCC; сч уже за ним
        i := точка_найди(о, адр)
        если i < 0:
            i = точка_найди(о, адр - 1)     # на всякий — вариант с +1
        если i >= 0:
            т *Точка = список_получи(о.точки, i как нат.верх) как *Точка
            б нат.старт = т.байт как нат.старт
            от_пиши(о, т.адр, &б, 1)        # вернуть исходный байт
            кон_прочти(о)
            кон_уст(о, К_СЧ, т.адр)
            кон_запиши(о)
            о.перевооруж = т.адр            # после шага вернуть 0xCC
            о.прич_адр = т.адр
            о.причина = ПР_ТОЧКА
            верни ПР_ТОЧКА
        # чужой int3 (точка загрузчика ОС, ПРЕРЫВ в коде) — пропускаем
        _прод(о, ПРОД_ОК)
        верни 0
    если код == ИСКЛ_ШАГ:
        # сначала вернуть 0xCC отложенной точки — иначе сработавшая
        # на этом шаге точка наблюдения оставит её снятой
        если о.перевооруж != 0:
            з нат.старт = БАЙТ_ТОЧКИ как нат.старт
            от_пиши(о, о.перевооруж, &з, 1)
            о.перевооруж = 0
        кон_прочти(о)
        др6 := кон_рег(о, К_ДР6)
        если др6 & 0xF != 0:
            кон_уст(о, К_ДР6, 0)
            кон_запиши(о)
            о.причина = ПР_НАБЛЮД
            верни ПР_НАБЛЮД
        о.причина = ПР_ШАГ
        верни ПР_ШАГ
    о.прич_код = код
    о.прич_адр = адр
    о.причина = ПР_ИСКЛ
    о.прод_стат = ПРОД_НЕОБР
    верни ПР_ИСКЛ

функ от_жди(о *Отлад) нат.верх:
    ок := WaitForDebugEvent(о.соб, ЖДИ_ВЕЧНО как нат.рост)
    если ок == 0:
        верни 0
    о.тид = соб_у32(о.соб, 2)
    верни соб_у32(о.соб, 0)

функ от_событие(о *Отлад) нат.верх:
    # крутит цикл ожидания до останова; возвращает ПР_*
    вечно:
        код := от_жди(о)
        если код == 0:
            о.жив = 0
            о.причина = ПР_ВЫХОД
            верни ПР_ВЫХОД
        если код == СОБ_ИСКЛ:
            р := от_исключение(о)
            если р != 0:
                верни р
        иначе:
            если не _прочее_событие(о, код):
                верни ПР_ВЫХОД

функ от_шаг_раз(о *Отлад) нат.верх:
    # одиночный шаг: TF + продолжение + ожидание
    кон_прочти(о)
    п *нат.рост = о.кон как *нат.рост
    п[К_ЕФЛАГИ] = (кон_ефлаги(о) | ФЛАГ_ШАГ) как нат.рост
    кон_запиши(о)
    от_продолжи(о)
    верни от_событие(о)

функ от_шаг(о *Отлад, n нат.верх) нат.верх:
    для i в 0..n:
        р := от_шаг_раз(о)
        если р != ПР_ШАГ:
            верни р
    верни ПР_ШАГ

функ от_иди(о *Отлад) нат.верх:
    # после точки сначала шаг через восстановленный байт
    если о.перевооруж != 0:
        р0 := от_шаг_раз(о)
        если р0 != ПР_ШАГ:
            верни р0
    от_продолжи(о)
    верни от_событие(о)

функ от_до(о *Отлад, адр нат.верх) нат.верх:
    была := точка_найди(о, адр) >= 0
    если не была:
        если не точка_пост(о, адр):
            печатьстр("след: не ставится точка по адресу")
            верни 0
    р := от_иди(о)
    если не была и р == ПР_ТОЧКА и о.прич_адр == адр:
        точка_сними(о, адр)
    верни р

функ от_возврат(о *Отлад) нат.верх:
    # «выйти из функции»: читаем адрес возврата по [УКС] и бежим до него
    если не кон_прочти(о):
        верни 0
    укс := кон_рег(о, К_УКС)
    буф *нат.старт = выдели(8)
    если от_читай(о, укс, буф, 8) != 8:
        верни 0
    п *нат.верх = буф как *нат.верх
    верни от_до(о, п[0])

функ от_стоп(о *Отлад):
    если о.жив != 0:
        TerminateProcess(о.хпроц, 0)
        о.жив = 0

функ от_отцепи(о *Отлад) лог:
    # отпустить процесс: снять все точки и отцепиться
    если о.жив == 0:
        верни нет
    для i в 0..о.точки.длина:
        т *Точка = список_получи(о.точки, i) как *Точка
        если т.вкл != 0:
            б нат.старт = т.байт как нат.старт
            от_пиши(о, т.адр, &б, 1)
            т.вкл = 0
    о.перевооруж = 0
    ок := DebugActiveProcessStop(о.пид как нат.рост)
    о.жив = 0
    верни ок != 0
