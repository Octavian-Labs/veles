# ядро — состояние отладчика СЛЕД: запуск, события, точки, шаги, наблюдение.
# Работает поверх Win32 Debug API (ипп.раз).

взять основа
взять ипп

# Причины остановки (поле Отлад.причина):
конст ПР_ШАГ = 1            # завершён пошаговый заход
конст ПР_ТОЧКА = 2          # сработала точка останова
конст ПР_НАБЛЮД = 3         # сработала аппаратная точка наблюдения
конст ПР_ВЫХОД = 4          # процесс завершился
конст ПР_ИСКЛ = 5           # постороннее исключение
конст ПР_СОЗДАН = 6         # процесс создан

запись Точка:
    адр нат.верх
    байт нат.верх              # оригинальный байт под 0xCC
    вкл нат.верх               # 0/1

запись Сим:
    имя стр
    адр нат.верх

запись Отлад:
    жив нат.верх               # 0/1 — процесс жив и под отладкой
    х_проц нат.верх          # хендл процесса
    х_поток нат.верх          # хендл основного потока
    ид_проц нат.верх          # id процесса
    ид_потока нат.верх        # id потока последнего события
    база нат.верх              # lpBaseOfImage
    вход нат.верх              # VA точки входа
    соб *нат.старт               # DEBUG_EVENT
    кон *нат.старт               # CONTEXT (выравнивание 16)
    потоки *Список          # пары нат.верх: [ид_потока, х_поток]
    точки *Список           # *Точка
    симы *Список            # *Сим
    перевооруж нат.верх        # адрес точки для возврата 0xCC после шага
    прод_стат нат.верх         # статус для следующего продолжения
    стоп_код нат.верх          # код выхода процесса
    причина нат.верх           # ПР_*
    прич_адр нат.верх          # адрес точки/исключения
    прич_код нат.верх          # код исключения
    цель стр                # путь к exe цели (для «карта»)
    карта_полна нат.верх       # 0 — прологов и меток разное число

функ отлад_новый() *Отлад:
    отл *Отлад = новый(Отлад)
    отл.жив = 0
    отл.х_проц = 0
    отл.х_поток = 0
    отл.ид_проц = 0
    отл.ид_потока = 0
    отл.база = 0
    отл.вход = 0
    отл.соб = выдели(СОБ_РАЗМЕР)
    кон_сырой нат.верх = выдели(КОН_РАЗМЕР + 16) как нат.верх
    кон_выр нат.верх = кон_сырой + 15
    кон_выр = кон_выр - (кон_выр % 16)            # CONTEXT требует выравнивания 16
    отл.кон = кон_выр как *нат.старт
    отл.потоки = список_новый()
    отл.точки = список_новый()
    отл.симы = список_новый()
    отл.перевооруж = 0
    отл.прод_стат = ПРОД_ОК
    отл.стоп_код = 0
    отл.причина = 0
    отл.прич_адр = 0
    отл.прич_код = 0
    отл.цель = пусто как стр
    отл.карта_полна = 1
    верни отл

# --- доступ к полям события и контекста -------------------------------------

функ соб_у32(соб *нат.старт, инд нат.верх) нат.верх:
    поля *нат.рост = соб как *нат.рост
    верни поля[инд] как нат.верх

функ соб_у64(соб *нат.старт, инд нат.верх) нат.верх:
    поля *нат.верх = соб как *нат.верх
    верни поля[инд]

функ кон_рег(отл *Отлад, инд нат.верх) нат.верх:
    поля *нат.верх = отл.кон как *нат.верх
    верни поля[инд]

функ кон_уст(отл *Отлад, инд нат.верх, знач нат.верх):
    поля *нат.верх = отл.кон как *нат.верх
    поля[инд] = знач

функ кон_ефлаги(отл *Отлад) нат.верх:
    поля *нат.рост = отл.кон как *нат.рост
    верни поля[К_ЕФЛАГИ] как нат.верх

# --- процесс ------------------------------------------------------------------

функ от_пуск(отл *Отлад, путь стр) лог:
    путь_шир *нат.шаг = стр_в_шир(путь)
    запуск *нат.старт = выдели(128)
    заполни(запуск, 0, 128)
    поля *нат.рост = запуск как *нат.рост
    поля[0] = СТАРТИНФО_РАЗМЕР
    инфо_проц *нат.старт = выдели(24)
    заполни(инфо_проц, 0, 24)
    успех цел.рост = CreateProcessW(путь_шир, пусто, пусто, пусто, 0,
                         ОТЛ_ФЛАГ как нат.рост, пусто, пусто, запуск, инфо_проц)
    если успех == 0:
        верни нет
    инфо64 *нат.верх = инфо_проц как *нат.верх
    инфо32 *нат.рост = инфо_проц как *нат.рост
    отл.х_проц = инфо64[0]
    отл.х_поток = инфо64[1]
    отл.ид_проц = инфо32[4] как нат.верх
    отл.ид_потока = инфо32[5] как нат.верх
    список_добавь(отл.потоки, отл.ид_потока)
    список_добавь(отл.потоки, отл.х_поток)
    отл.жив = 1
    отл.прод_стат = ПРОД_ОК
    верни да

функ _х_поток(отл *Отлад, ид_потока нат.верх) нат.верх:
    # хендл потока по его id (пары в списке); иначе — основной
    пар нат.верх = отл.потоки.длина / 2
    для инд в 0..пар:
        если список_получи(отл.потоки, инд * 2) == ид_потока:
            верни список_получи(отл.потоки, инд * 2 + 1)
    верни отл.х_поток

функ кон_прочти(отл *Отлад) лог:
    поля *нат.рост = отл.кон как *нат.рост
    поля[К_ФЛАГИ] = КОН_ФЛАГИ как нат.рост
    верни GetThreadContext(_х_поток(отл, отл.ид_потока), отл.кон) != 0

функ кон_запиши(отл *Отлад) лог:
    верни SetThreadContext(_х_поток(отл, отл.ид_потока), отл.кон) != 0

функ от_читай(отл *Отлад, адр нат.верх, буф *нат.старт, длина нат.верх) нат.верх:
    прочитано нат.верх = 0
    успех цел.рост = ReadProcessMemory(отл.х_проц, адр, буф, длина, &прочитано)
    если успех == 0:
        верни 0
    верни прочитано

функ от_пиши(отл *Отлад, адр нат.верх, буф *нат.старт, длина нат.верх) лог:
    записано нат.верх = 0
    успех цел.рост = WriteProcessMemory(отл.х_проц, адр, буф, длина, &записано)
    FlushInstructionCache(отл.х_проц, адр, длина)
    верни успех != 0 и записано == длина

# --- точки останова (int3) ----------------------------------------------------

функ точка_найди(отл *Отлад, адр нат.верх) цел.верх:
    для инд в 0..отл.точки.длина:
        точ *Точка = список_получи(отл.точки, инд) как *Точка
        если точ.вкл != 0 и точ.адр == адр:
            верни инд как цел.верх
    верни -1

функ точка_пост(отл *Отлад, адр нат.верх) лог:
    если точка_найди(отл, адр) >= 0:
        верни да
    байт нат.старт = 0
    если от_читай(отл, адр, &байт, 1) != 1:
        верни нет
    стоп нат.старт = БАЙТ_ТОЧКИ как нат.старт
    если не от_пиши(отл, адр, &стоп, 1):
        верни нет
    точ *Точка = новый(Точка)
    точ.адр = адр
    точ.байт = байт как нат.верх
    точ.вкл = 1
    список_добавь(отл.точки, точ как нат.верх)
    верни да

функ точка_сними(отл *Отлад, адр нат.верх) лог:
    инд цел.верх = точка_найди(отл, адр)
    если инд < 0:
        верни нет
    точ *Точка = список_получи(отл.точки, инд как нат.верх) как *Точка
    байт нат.старт = точ.байт как нат.старт
    от_пиши(отл, точ.адр, &байт, 1)
    точ.вкл = 0
    если отл.перевооруж == точ.адр:
        отл.перевооруж = 0        # не вернём 0xCC в снятую точку после шага
    верни да

# --- аппаратная точка наблюдения (DR0) ----------------------------------------

функ наблюд_пост(отл *Отлад, адр нат.верх) лог:
    # DR0 = адрес; Dr7: L0=1, RW0=01 (запись), LEN0=10 (8 байт)
    если не кон_прочти(отл):
        верни нет
    кон_уст(отл, К_ДР0, адр)
    кон_уст(отл, К_ДР7, 0x00090001)
    верни кон_запиши(отл)

функ наблюд_сними(отл *Отлад) лог:
    если не кон_прочти(отл):
        верни нет
    кон_уст(отл, К_ДР0, 0)
    кон_уст(отл, К_ДР7, 0)
    верни кон_запиши(отл)

# --- цикл событий ---------------------------------------------------------------

функ _прод(отл *Отлад, стат нат.верх):
    ContinueDebugEvent(соб_у32(отл.соб, 1) как нат.рост,
                       соб_у32(отл.соб, 2) как нат.рост, стат как нат.рост)

функ от_продолжи(отл *Отлад):
    # продолжение со статусом, выставленным обработчиком исключения
    _прод(отл, отл.прод_стат)
    отл.прод_стат = ПРОД_ОК

функ _на_создание(отл *Отлад):
    # CREATE_PROCESS_DEBUG_EVENT: хендлы, база образа
    отл.х_проц = соб_у64(отл.соб, 3)
    отл.х_поток = соб_у64(отл.соб, 4)
    отл.база = соб_у64(отл.соб, 5)
    CloseHandle(соб_у64(отл.соб, 2))          # hFile
    отл.ид_потока = соб_у32(отл.соб, 2)
    # пара tid->хендл могла уже быть из PROCESS_INFORMATION — обновим
    пар нат.верх = отл.потоки.длина / 2
    для инд в 0..пар:
        если список_получи(отл.потоки, инд * 2) == отл.ид_потока:
            отл.потоки.данные[инд * 2 + 1] = отл.х_поток
            _прод(отл, ПРОД_ОК)
            верни
    список_добавь(отл.потоки, отл.ид_потока)
    список_добавь(отл.потоки, отл.х_поток)
    _прод(отл, ПРОД_ОК)

функ _прочее_событие(отл *Отлад, код нат.верх) лог:
    # обработка событий без остановки; нет — если процесс завершился
    если код == СОБ_ПРОЦ:
        _на_создание(отл)
        верни да
    если код == СОБ_ПОТОК:
        список_добавь(отл.потоки, соб_у32(отл.соб, 2))
        список_добавь(отл.потоки, соб_у64(отл.соб, 2))
        _прод(отл, ПРОД_ОК)
        верни да
    если код == СОБ_ПОТОК_ВЫХ:
        _прод(отл, ПРОД_ОК)
        верни да
    если код == СОБ_ДЛЛ:
        CloseHandle(соб_у64(отл.соб, 2))      # hFile dll
        _прод(отл, ПРОД_ОК)
        верни да
    если код == СОБ_ДЛЛ_ВЫХ или код == СОБ_СТРОКА:
        _прод(отл, ПРОД_ОК)
        верни да
    если код == СОБ_ПРОЦ_ВЫХ:
        отл.стоп_код = соб_у32(отл.соб, 4)      # dwExitCode
        отл.жив = 0
        _прод(отл, ПРОД_ОК)
        отл.причина = ПР_ВЫХОД
        верни нет
    _прод(отл, ПРОД_ОК)
    верни да

функ от_исключение(отл *Отлад) нат.верх:
    # возвращает ПР_* >0 — останов; 0 — событие проглочено
    код нат.верх = соб_у32(отл.соб, 4)        # ExceptionCode
    адр нат.верх = соб_у64(отл.соб, 4)        # ExceptionAddress
    если код == ИСКЛ_ТОЧКА:
        # ExceptionAddress = адрес байта 0xCC; сч уже за ним
        инд цел.верх = точка_найди(отл, адр)
        если инд < 0:
            инд = точка_найди(отл, адр - 1)   # на всякий — вариант с +1
        если инд >= 0:
            точ *Точка = список_получи(отл.точки, инд как нат.верх) как *Точка
            байт нат.старт = точ.байт как нат.старт
            от_пиши(отл, точ.адр, &байт, 1)        # вернуть исходный байт
            кон_прочти(отл)
            кон_уст(отл, К_СЧ, точ.адр)
            кон_запиши(отл)
            отл.перевооруж = точ.адр            # после шага вернуть 0xCC
            отл.прич_адр = точ.адр
            отл.причина = ПР_ТОЧКА
            верни ПР_ТОЧКА
        # чужой int3 (точка загрузчика ОС, ПРЕРЫВ в коде) — пропускаем
        _прод(отл, ПРОД_ОК)
        верни 0
    если код == ИСКЛ_ШАГ:
        # сначала вернуть 0xCC отложенной точки — иначе сработавшая
        # на этом шаге точка наблюдения оставит её снятой
        если отл.перевооруж != 0:
            стоп нат.старт = БАЙТ_ТОЧКИ как нат.старт
            от_пиши(отл, отл.перевооруж, &стоп, 1)
            отл.перевооруж = 0
        кон_прочти(отл)
        др6 нат.верх = кон_рег(отл, К_ДР6)
        если др6 & 0xF != 0:
            кон_уст(отл, К_ДР6, 0)
            кон_запиши(отл)
            отл.причина = ПР_НАБЛЮД
            верни ПР_НАБЛЮД
        отл.причина = ПР_ШАГ
        верни ПР_ШАГ
    отл.прич_код = код
    отл.прич_адр = адр
    отл.причина = ПР_ИСКЛ
    отл.прод_стат = ПРОД_НЕОБР
    верни ПР_ИСКЛ

функ от_жди(отл *Отлад) нат.верх:
    успех цел.рост = WaitForDebugEvent(отл.соб, ЖДИ_ВЕЧНО как нат.рост)
    если успех == 0:
        верни 0
    отл.ид_потока = соб_у32(отл.соб, 2)
    верни соб_у32(отл.соб, 0)

функ от_событие(отл *Отлад) нат.верх:
    # крутит цикл ожидания до останова; возвращает ПР_*
    вечно:
        код нат.верх = от_жди(отл)
        если код == 0:
            отл.жив = 0
            отл.причина = ПР_ВЫХОД
            верни ПР_ВЫХОД
        если код == СОБ_ИСКЛ:
            прич нат.верх = от_исключение(отл)
            если прич != 0:
                верни прич
        иначе:
            если не _прочее_событие(отл, код):
                верни ПР_ВЫХОД

функ от_шаг_раз(отл *Отлад) нат.верх:
    # одиночный шаг: TF + продолжение + ожидание
    кон_прочти(отл)
    поля *нат.рост = отл.кон как *нат.рост
    поля[К_ЕФЛАГИ] = (кон_ефлаги(отл) | ФЛАГ_ШАГ) как нат.рост
    кон_запиши(отл)
    от_продолжи(отл)
    верни от_событие(отл)

функ от_шаг(отл *Отлад, раз нат.верх) нат.верх:
    для инд в 0..раз:
        прич нат.верх = от_шаг_раз(отл)
        если прич != ПР_ШАГ:
            верни прич
    верни ПР_ШАГ

функ от_иди(отл *Отлад) нат.верх:
    # после точки сначала шаг через восстановленный байт
    если отл.перевооруж != 0:
        прич0 нат.верх = от_шаг_раз(отл)
        если прич0 != ПР_ШАГ:
            верни прич0
    от_продолжи(отл)
    верни от_событие(отл)

функ от_до(отл *Отлад, адр нат.верх) нат.верх:
    была лог = точка_найди(отл, адр) >= 0
    если не была:
        если не точка_пост(отл, адр):
            печатьстр("след: не ставится точка по адресу")
            верни 0
    прич нат.верх = от_иди(отл)
    если не была и прич == ПР_ТОЧКА и отл.прич_адр == адр:
        точка_сними(отл, адр)
    верни прич

функ от_возврат(отл *Отлад) нат.верх:
    # «выйти из функции»: читаем адрес возврата по [УКС] и бежим до него
    если не кон_прочти(отл):
        верни 0
    укс нат.верх = кон_рег(отл, К_УКС)
    буф *нат.старт = выдели(8)
    если от_читай(отл, укс, буф, 8) != 8:
        верни 0
    поля *нат.верх = буф как *нат.верх
    верни от_до(отл, поля[0])

функ от_стоп(отл *Отлад):
    если отл.жив != 0:
        TerminateProcess(отл.х_проц, 0)
        отл.жив = 0

функ от_отцепи(отл *Отлад) лог:
    # отпустить процесс: снять все точки и отцепиться
    если отл.жив == 0:
        верни нет
    для инд в 0..отл.точки.длина:
        точ *Точка = список_получи(отл.точки, инд) как *Точка
        если точ.вкл != 0:
            байт нат.старт = точ.байт как нат.старт
            от_пиши(отл, точ.адр, &байт, 1)
            точ.вкл = 0
    отл.перевооруж = 0
    успех цел.рост = DebugActiveProcessStop(отл.ид_проц как нат.рост)
    отл.жив = 0
    верни успех != 0
