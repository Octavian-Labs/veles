# ядро — состояние отладчика СЛЕД: запуск, события, точки, шаги, наблюдение.
# Работает поверх Win32 Debug API (апи.раз).

взять основа
взять апи

# Причины остановки (поле Отлад.причина):
конст ПР_ШАГ = 1            # завершён пошаговый заход
конст ПР_ТОЧКА = 2          # сработала точка останова
конст ПР_НАБЛЮД = 3         # сработала аппаратная точка наблюдения
конст ПР_ВЫХОД = 4          # процесс завершился
конст ПР_ИСКЛ = 5           # постороннее исключение
конст ПР_СОЗДАН = 6         # процесс создан

запись Точка:
    адр без64
    байт без64              # оригинальный байт под 0xCC
    вкл без64               # 0/1

запись Сим:
    имя стр
    адр без64

запись Отлад:
    жив без64               # 0/1 — процесс жив и под отладкой
    хпроц без64
    хпоток без64            # хендл основного потока
    пид без64
    тид без64               # поток последнего события
    база без64              # lpBaseOfImage
    вход без64              # VA точки входа
    соб *без8               # DEBUG_EVENT
    кон *без8               # CONTEXT (выравнивание 16)
    потоки *Список          # пары без64: [тид, хпоток]
    точки *Список           # *Точка
    симы *Список            # *Сим
    перевооруж без64        # адрес точки для возврата 0xCC после шага
    прод_стат без64         # статус для следующего продолжения
    стоп_код без64          # код выхода процесса
    причина без64           # ПР_*
    прич_адр без64          # адрес точки/исключения
    прич_код без64          # код исключения
    цель стр                # путь к exe цели (для «карта»)
    карта_полна без64       # 0 — прологов и меток разное число

функ отлад_новый() *Отлад:
    о *Отлад = новый(Отлад)
    о.жив = 0
    о.хпроц = 0
    о.хпоток = 0
    о.пид = 0
    о.тид = 0
    о.база = 0
    о.вход = 0
    о.соб = выдели(СОБ_РАЗМЕР)
    ксыр := выдели(КОН_РАЗМЕР + 16) как без64
    к := ксыр + 15
    к = к - (к % 16)            # CONTEXT требует выравнивания 16
    о.кон = к как *без8
    о.потоки = список_новый()
    о.точки = список_новый()
    о.симы = список_новый()
    о.перевооруж = 0
    о.прод_стат = ПРОД_ОК
    о.стоп_код = 0
    о.причина = 0
    о.прич_адр = 0
    о.прич_код = 0
    о.цель = пусто как стр
    о.карта_полна = 1
    верни о

# --- доступ к полям события и контекста -------------------------------------

функ соб_у32(соб *без8, инд без64) без64:
    п *без32 = соб как *без32
    верни п[инд] как без64

функ соб_у64(соб *без8, инд без64) без64:
    п *без64 = соб как *без64
    верни п[инд]

функ кон_рег(о *Отлад, инд без64) без64:
    п *без64 = о.кон как *без64
    верни п[инд]

функ кон_уст(о *Отлад, инд без64, v без64):
    п *без64 = о.кон как *без64
    п[инд] = v

функ кон_ефлаги(о *Отлад) без64:
    п *без32 = о.кон как *без32
    верни п[К_ЕФЛАГИ] как без64

# --- процесс ------------------------------------------------------------------

функ от_пуск(о *Отлад, путь стр) бул:
    пшир *без16 = стр_в_шир(путь)
    си *без8 = выдели(128)
    заполни(си, 0, 128)
    п *без32 = си как *без32
    п[0] = СТАРТИНФО_РАЗМЕР
    пи *без8 = выдели(24)
    заполни(пи, 0, 24)
    ок := CreateProcessW(пшир, пусто, пусто, пусто, 0,
                         ОТЛ_ФЛАГ как без32, пусто, пусто, си, пи)
    если ок == 0:
        верни нет
    п64 *без64 = пи как *без64
    п32 *без32 = пи как *без32
    о.хпроц = п64[0]
    о.хпоток = п64[1]
    о.пид = п32[4] как без64
    о.тид = п32[5] как без64
    список_добавь(о.потоки, о.тид)
    список_добавь(о.потоки, о.хпоток)
    о.жив = 1
    о.прод_стат = ПРОД_ОК
    верни да

функ _хпоток(о *Отлад, тид без64) без64:
    # хендл потока по его tid (пары в списке); иначе — основной
    n := о.потоки.длина / 2
    для i в 0..n:
        если список_получи(о.потоки, i * 2) == тид:
            верни список_получи(о.потоки, i * 2 + 1)
    верни о.хпоток

функ кон_прочти(о *Отлад) бул:
    п *без32 = о.кон как *без32
    п[К_ФЛАГИ] = КОН_ФЛАГИ как без32
    верни GetThreadContext(_хпоток(о, о.тид), о.кон) != 0

функ кон_запиши(о *Отлад) бул:
    верни SetThreadContext(_хпоток(о, о.тид), о.кон) != 0

функ от_читай(о *Отлад, адр без64, буф *без8, n без64) без64:
    проч без64 = 0
    ок := ReadProcessMemory(о.хпроц, адр, буф, n, &проч)
    если ок == 0:
        верни 0
    верни проч

функ от_пиши(о *Отлад, адр без64, буф *без8, n без64) бул:
    зап без64 = 0
    ок := WriteProcessMemory(о.хпроц, адр, буф, n, &зап)
    FlushInstructionCache(о.хпроц, адр, n)
    верни ок != 0 и зап == n

# --- точки останова (int3) ----------------------------------------------------

функ точка_найди(о *Отлад, адр без64) цел64:
    для i в 0..о.точки.длина:
        т *Точка = список_получи(о.точки, i) как *Точка
        если т.вкл != 0 и т.адр == адр:
            верни i как цел64
    верни -1

функ точка_пост(о *Отлад, адр без64) бул:
    если точка_найди(о, адр) >= 0:
        верни да
    б без8 = 0
    если от_читай(о, адр, &б, 1) != 1:
        верни нет
    з без8 = БАЙТ_ТОЧКИ как без8
    если не от_пиши(о, адр, &з, 1):
        верни нет
    т *Точка = новый(Точка)
    т.адр = адр
    т.байт = б как без64
    т.вкл = 1
    список_добавь(о.точки, т как без64)
    верни да

функ точка_сними(о *Отлад, адр без64) бул:
    i := точка_найди(о, адр)
    если i < 0:
        верни нет
    т *Точка = список_получи(о.точки, i как без64) как *Точка
    б без8 = т.байт как без8
    от_пиши(о, т.адр, &б, 1)
    т.вкл = 0
    если о.перевооруж == т.адр:
        о.перевооруж = 0        # не вернём 0xCC в снятую точку после шага
    верни да

# --- аппаратная точка наблюдения (DR0) ----------------------------------------

функ наблюд_пост(о *Отлад, адр без64) бул:
    # DR0 = адрес; Dr7: L0=1, RW0=01 (запись), LEN0=10 (8 байт)
    если не кон_прочти(о):
        верни нет
    кон_уст(о, К_ДР0, адр)
    кон_уст(о, К_ДР7, 0x00090001)
    верни кон_запиши(о)

функ наблюд_сними(о *Отлад) бул:
    если не кон_прочти(о):
        верни нет
    кон_уст(о, К_ДР0, 0)
    кон_уст(о, К_ДР7, 0)
    верни кон_запиши(о)

# --- цикл событий ---------------------------------------------------------------

функ _прод(о *Отлад, стат без64):
    ContinueDebugEvent(соб_у32(о.соб, 1) как без32,
                       соб_у32(о.соб, 2) как без32, стат как без32)

функ от_продолжи(о *Отлад):
    # продолжение со статусом, выставленным обработчиком исключения
    _прод(о, о.прод_стат)
    о.прод_стат = ПРОД_ОК

функ _на_создание(о *Отлад):
    # CREATE_PROCESS_DEBUG_EVENT: хендлы, база образа
    о.хпроц = соб_у64(о.соб, 3)
    о.хпоток = соб_у64(о.соб, 4)
    о.база = соб_у64(о.соб, 5)
    CloseHandle(соб_у64(о.соб, 2))          # hFile
    о.тид = соб_у32(о.соб, 2)
    # пара tid->хендл могла уже быть из PROCESS_INFORMATION — обновим
    n := о.потоки.длина / 2
    для i в 0..n:
        если список_получи(о.потоки, i * 2) == о.тид:
            о.потоки.данные[i * 2 + 1] = о.хпоток
            _прод(о, ПРОД_ОК)
            верни
    список_добавь(о.потоки, о.тид)
    список_добавь(о.потоки, о.хпоток)
    _прод(о, ПРОД_ОК)

функ _прочее_событие(о *Отлад, код без64) бул:
    # обработка событий без остановки; нет — если процесс завершился
    если код == СОБ_ПРОЦ:
        _на_создание(о)
        верни да
    если код == СОБ_ПОТОК:
        список_добавь(о.потоки, соб_у32(о.соб, 2))
        список_добавь(о.потоки, соб_у64(о.соб, 2))
        _прод(о, ПРОД_ОК)
        верни да
    если код == СОБ_ПОТОК_ВЫХ:
        _прод(о, ПРОД_ОК)
        верни да
    если код == СОБ_ДЛЛ:
        CloseHandle(соб_у64(о.соб, 2))      # hFile dll
        _прод(о, ПРОД_ОК)
        верни да
    если код == СОБ_ДЛЛ_ВЫХ или код == СОБ_СТРОКА:
        _прод(о, ПРОД_ОК)
        верни да
    если код == СОБ_ПРОЦ_ВЫХ:
        о.стоп_код = соб_у32(о.соб, 4)      # dwExitCode
        о.жив = 0
        _прод(о, ПРОД_ОК)
        о.причина = ПР_ВЫХОД
        верни нет
    _прод(о, ПРОД_ОК)
    верни да

функ от_исключение(о *Отлад) без64:
    # возвращает ПР_* >0 — останов; 0 — событие проглочено
    код := соб_у32(о.соб, 4)                # ExceptionCode
    адр := соб_у64(о.соб, 4)                # ExceptionAddress
    если код == ИСКЛ_ТОЧКА:
        # ExceptionAddress = адрес байта 0xCC; сч уже за ним
        i := точка_найди(о, адр)
        если i < 0:
            i = точка_найди(о, адр - 1)     # на всякий — вариант с +1
        если i >= 0:
            т *Точка = список_получи(о.точки, i как без64) как *Точка
            б без8 = т.байт как без8
            от_пиши(о, т.адр, &б, 1)        # вернуть исходный байт
            кон_прочти(о)
            кон_уст(о, К_СЧ, т.адр)
            кон_запиши(о)
            о.перевооруж = т.адр            # после шага вернуть 0xCC
            о.прич_адр = т.адр
            о.причина = ПР_ТОЧКА
            верни ПР_ТОЧКА
        # чужой int3 (точка загрузчика ОС, ПРЕРЫВ в коде) — пропускаем
        _прод(о, ПРОД_ОК)
        верни 0
    если код == ИСКЛ_ШАГ:
        # сначала вернуть 0xCC отложенной точки — иначе сработавшая
        # на этом шаге точка наблюдения оставит её снятой
        если о.перевооруж != 0:
            з без8 = БАЙТ_ТОЧКИ как без8
            от_пиши(о, о.перевооруж, &з, 1)
            о.перевооруж = 0
        кон_прочти(о)
        др6 := кон_рег(о, К_ДР6)
        если др6 & 0xF != 0:
            кон_уст(о, К_ДР6, 0)
            кон_запиши(о)
            о.причина = ПР_НАБЛЮД
            верни ПР_НАБЛЮД
        о.причина = ПР_ШАГ
        верни ПР_ШАГ
    о.прич_код = код
    о.прич_адр = адр
    о.причина = ПР_ИСКЛ
    о.прод_стат = ПРОД_НЕОБР
    верни ПР_ИСКЛ

функ от_жди(о *Отлад) без64:
    ок := WaitForDebugEvent(о.соб, ЖДИ_ВЕЧНО как без32)
    если ок == 0:
        верни 0
    о.тид = соб_у32(о.соб, 2)
    верни соб_у32(о.соб, 0)

функ от_событие(о *Отлад) без64:
    # крутит цикл ожидания до останова; возвращает ПР_*
    вечно:
        код := от_жди(о)
        если код == 0:
            о.жив = 0
            о.причина = ПР_ВЫХОД
            верни ПР_ВЫХОД
        если код == СОБ_ИСКЛ:
            р := от_исключение(о)
            если р != 0:
                верни р
        иначе:
            если не _прочее_событие(о, код):
                верни ПР_ВЫХОД

функ от_шаг_раз(о *Отлад) без64:
    # одиночный шаг: TF + продолжение + ожидание
    кон_прочти(о)
    п *без32 = о.кон как *без32
    п[К_ЕФЛАГИ] = (кон_ефлаги(о) | ФЛАГ_ШАГ) как без32
    кон_запиши(о)
    от_продолжи(о)
    верни от_событие(о)

функ от_шаг(о *Отлад, n без64) без64:
    для i в 0..n:
        р := от_шаг_раз(о)
        если р != ПР_ШАГ:
            верни р
    верни ПР_ШАГ

функ от_иди(о *Отлад) без64:
    # после точки сначала шаг через восстановленный байт
    если о.перевооруж != 0:
        р0 := от_шаг_раз(о)
        если р0 != ПР_ШАГ:
            верни р0
    от_продолжи(о)
    верни от_событие(о)

функ от_до(о *Отлад, адр без64) без64:
    была := точка_найди(о, адр) >= 0
    если не была:
        если не точка_пост(о, адр):
            печатьстр("след: не ставится точка по адресу")
            верни 0
    р := от_иди(о)
    если не была и р == ПР_ТОЧКА и о.прич_адр == адр:
        точка_сними(о, адр)
    верни р

функ от_возврат(о *Отлад) без64:
    # «выйти из функции»: читаем адрес возврата по [УКС] и бежим до него
    если не кон_прочти(о):
        верни 0
    укс := кон_рег(о, К_УКС)
    буф *без8 = выдели(8)
    если от_читай(о, укс, буф, 8) != 8:
        верни 0
    п *без64 = буф как *без64
    верни от_до(о, п[0])

функ от_стоп(о *Отлад):
    если о.жив != 0:
        TerminateProcess(о.хпроц, 0)
        о.жив = 0

функ от_отцепи(о *Отлад) бул:
    # отпустить процесс: снять все точки и отцепиться
    если о.жив == 0:
        верни нет
    для i в 0..о.точки.длина:
        т *Точка = список_получи(о.точки, i) как *Точка
        если т.вкл != 0:
            б без8 = т.байт как без8
            от_пиши(о, т.адр, &б, 1)
            т.вкл = 0
    о.перевооруж = 0
    ок := DebugActiveProcessStop(о.пид как без32)
    о.жив = 0
    верни ок != 0
