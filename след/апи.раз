# апи — обёртки Win32 Debug API и раскладка структур CONTEXT/DEBUG_EVENT (x64).
# Часть отладчика СЛЕД экосистемы ВЕЛЕС. Только Windows.

# --- флаги создания и продолжения -----------------------------------------
конст ОТЛ_ФЛАГ = 2              # DEBUG_ONLY_THIS_PROCESS
конст ЖДИ_ВЕЧНО = 0xFFFFFFFF    # INFINITE
конст ПРОД_ОК = 0x00010002      # DBG_CONTINUE
конст ПРОД_НЕОБР = 0x80010001   # DBG_EXCEPTION_NOT_HANDLED

# --- коды отладочных событий ----------------------------------------------
конст СОБ_ИСКЛ = 1              # EXCEPTION_DEBUG_EVENT
конст СОБ_ПОТОК = 2             # CREATE_THREAD_DEBUG_EVENT
конст СОБ_ПРОЦ = 3              # CREATE_PROCESS_DEBUG_EVENT
конст СОБ_ПОТОК_ВЫХ = 4         # EXIT_THREAD_DEBUG_EVENT
конст СОБ_ПРОЦ_ВЫХ = 5          # EXIT_PROCESS_DEBUG_EVENT
конст СОБ_ДЛЛ = 6               # LOAD_DLL_DEBUG_EVENT
конст СОБ_ДЛЛ_ВЫХ = 7           # UNLOAD_DLL_DEBUG_EVENT
конст СОБ_СТРОКА = 8            # OUTPUT_DEBUG_STRING_EVENT
конст СОБ_РИП = 9               # RIP_EVENT

# --- коды исключений --------------------------------------------------------
конст ИСКЛ_ТОЧКА = 0x80000003   # EXCEPTION_BREAKPOINT (int3)
конст ИСКЛ_ШАГ = 0x80000004     # EXCEPTION_SINGLE_STEP (TF / DR)
конст ИСКЛ_ДОСТУП = 0xC0000005  # EXCEPTION_ACCESS_VIOLATION

# --- прочее -----------------------------------------------------------------
конст КОН_ФЛАГИ = 0x0010001B    # CONTEXT_FULL | CONTEXT_DEBUG_REGISTERS
конст ФЛАГ_ШАГ = 0x100          # TF в EFlags
конст БАЙТ_ТОЧКИ = 0xCC         # int3
конст СТАРТИНФО_РАЗМЕР = 104    # sizeof(STARTUPINFOW) на x64
конст СОБ_РАЗМЕР = 192          # DEBUG_EVENT (176) + запас
конст КОН_РАЗМЕР = 1280         # CONTEXT (1232) + запас под выравнивание

# Индексы без64-ячеек в CONTEXT (байтовое смещение / 8):
конст К_ДР0 = 9                 # Dr0 @0x48 — адрес аппаратной точки
конст К_ДР6 = 13                # Dr6 @0x68 — статус отладки
конст К_ДР7 = 14                # Dr7 @0x70 — управление DR
конст К_АКК = 15                # Rax @0x78
конст К_СЧТ = 16                # Rcx
конст К_ДАН = 17                # Rdx
конст К_БАЗ = 18                # Rbx
конст К_УКС = 19                # Rsp
конст К_УКК = 20                # Rbp
конст К_ИСТ = 21                # Rsi
конст К_ПРМ = 22                # Rdi
конст К_Р8 = 23
конст К_Р9 = 24
конст К_Р10 = 25
конст К_Р11 = 26
конст К_Р12 = 27
конст К_Р13 = 28
конст К_Р14 = 29
конст К_Р15 = 30
конст К_СЧ = 31                 # Rip @0xF8
# Индексы без32-ячеек:
конст К_ФЛАГИ = 12              # ContextFlags @0x30
конст К_ЕФЛАГИ = 17             # EFlags @0x44

# --- Win32 ------------------------------------------------------------------
внеш "kernel32" функ CreateProcessW(прил *без16, кстр *без16,
    па *пусто, та *пусто, наслед цел32, флаги без32,
    среда *пусто, кат *без16, си *без8, пи *без8) цел32
внеш "kernel32" функ WaitForDebugEvent(соб *без8, мс без32) цел32
внеш "kernel32" функ ContinueDebugEvent(пид без32, тид без32,
                                        стат без32) цел32
внеш "kernel32" функ GetThreadContext(поток без64, кон *без8) цел32
внеш "kernel32" функ SetThreadContext(поток без64, кон *без8) цел32
внеш "kernel32" функ ReadProcessMemory(проц без64, адр без64,
                                       буф *без8, n без64, проч *без64) цел32
внеш "kernel32" функ WriteProcessMemory(проц без64, адр без64,
                                        буф *без8, n без64, зап *без64) цел32
внеш "kernel32" функ FlushInstructionCache(проц без64, адр без64,
                                           n без64) цел32
внеш "kernel32" функ TerminateProcess(проц без64, код без32) цел32
внеш "kernel32" функ DebugActiveProcessStop(пид без32) цел32
внеш "kernel32" функ OpenThread(доступ без32, наслед цел32, тид без32) без64
внеш "kernel32" функ GetLastError() без32
внеш "kernel32" функ GetStdHandle(деск без32) без64
внеш "kernel32" функ ReadFile(хендл без64, буф *без8, колво без32,
                              прочитано *без32, овер *пусто) цел32
