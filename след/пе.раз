# пе — разбор PE64: точка входа, секции, эвристическая карта символов.
# Карта строится сопоставлением меток .иск, за которыми следует пролог
# «ВСТЕК УКК / ПЕР УКК, УКС», с байтами 55 48 8B EC в секции .text.
# Эвристика годится для кода, сгенерированного РАЗУМОМ.

взять основа
взять ипп, ядро

функ _р16(д *нат.старт, о нат.верх) нат.верх:
    верни (д[о] как нат.верх) | ((д[о + 1] как нат.верх) << 8)

функ _р32(д *нат.старт, о нат.верх) нат.верх:
    верни _р16(д, о) | (_р16(д, о + 2) << 16)

функ пе_вход_рва(дан стр) нат.верх:
    # RVA точки входа; 0 — не PE32+
    если дан == пусто или дан.длина < 0x40:
        верни 0
    д *нат.старт = дан.данные
    пе нат.верх = _р32(д, 0x3C)
    если пе + 0x58 > дан.длина:
        верни 0
    если _р32(д, пе) != 0x00004550:     # 'PE\0\0'
        верни 0
    если _р16(д, пе + 24) != 0x20B:     # только PE32+
        верни 0
    верни _р32(д, пе + 24 + 0x10)       # AddressOfEntryPoint

функ _пе_секция(дан стр, имя *нат.старт, имя_дл нат.верх) *Список:
    # [raw_смещ, raw_разм, va] секции по имени; пусто — не нашли
    д *нат.старт = дан.данные
    пе нат.верх = _р32(д, 0x3C)
    nсек нат.верх = _р16(д, пе + 6)
    опт нат.верх = _р16(д, пе + 20)
    сек нат.верх = пе + 24 + опт
    для инд в 0..nсек:
        с нат.верх = сек + инд * 40
        если с + 40 > дан.длина:
            верни пусто как *Список
        совп нат.верх = 1
        для инд2 в 0..имя_дл:
            если д[с + инд2] != имя[инд2]:
                совп = 0
        если совп != 0:
            р *Список = список_новый()
            список_добавь(р, _р32(д, с + 20))   # PointerToRawData
            список_добавь(р, _р32(д, с + 16))   # SizeOfRawData
            список_добавь(р, _р32(д, с + 12))   # VirtualAddress
            верни р
    верни пусто как *Список

функ пе_текст(дан стр) *Список:
    # [raw_смещ, raw_разм, va] секции ".text"
    имя *нат.старт = выдели(8)
    имя[0] = 0x2E    # '.'
    имя[1] = 't'
    имя[2] = 'e'
    имя[3] = 'x'
    имя[4] = 't'
    имя[5] = 0
    верни _пе_секция(дан, имя, 6)

# --- символы -------------------------------------------------------------------

функ сим_добавь(о *Отлад, имя стр, адр нат.верх):
    с *Сим = новый(Сим)
    с.имя = имя
    с.адр = адр
    список_добавь(о.симы, с как нат.верх)

функ сим_адр(о *Отлад, имя стр) нат.верх:
    # адрес по имени; 0 — не найден
    для инд в 0..о.симы.длина:
        с *Сим = список_получи(о.симы, инд) как *Сим
        если стр_равны(с.имя, имя):
            верни с.адр
    верни 0

функ сим_имя(о *Отлад, адр нат.верх) стр:
    # ближайший символ снизу в пределах 0x1000; "имя+0xсмещ" или пусто
    лучшая нат.верх = 0
    лимя стр = пусто как стр
    для инд в 0..о.симы.длина:
        с *Сим = список_получи(о.симы, инд) как *Сим
        если с.адр <= адр и с.адр > лучшая:
            лучшая = с.адр
            лимя = с.имя
    если лучшая == 0 или адр - лучшая > 0x1000:
        верни пусто как стр
    если адр == лучшая:
        верни лимя
    верни стр_склей(стр_склей(лимя, "+0x"), шест(адр - лучшая))

функ _метка_ли(иск стр, i нат.верх) нат.верх:
    # длина метки на строке i (имя заканчивается ':'); 0 — не метка
    поз нат.верх = i
    пока поз < иск.длина:
        б нат.старт = иск.данные[поз]
        если б == 58:                       # ':'
            верни поз - i
        если б == 10 или б == 32 или б == 9 или б == 59:
            верни 0                         # конец строки/пробел/';' — не метка
        поз += 1
    верни 0

функ _кон_стр(иск стр, i нат.верх) нат.верх:
    # индекс байта '\n' либо конец данных, начиная с i
    поз нат.верх = i
    пока поз < иск.длина и иск.данные[поз] != 10:
        поз += 1
    верни поз

функ _непробел(иск стр, i нат.верх) нат.верх:
    # первый байт не ' '/'\t' начиная с i ('\n' и конец данных тоже стоп)
    поз нат.верх = i
    пока поз < иск.длина и (иск.данные[поз] == 32 или иск.данные[поз] == 9):
        поз += 1
    верни поз

функ _нач_с(иск стр, i нат.верх, об стр) лог:
    # в позиции i начинается образец об
    если i + об.длина > иск.длина:
        верни нет
    верни равна_память(иск.данные + i, об.данные, об.длина)

функ _строка_это(иск стр, i нат.верх, об стр) лог:
    # строка с i = «отступ + об» (дальше конец строки, пробел или ';')
    поз нат.верх = _непробел(иск, i)
    если не _нач_с(иск, поз, об):
        верни нет
    поз += об.длина
    если поз >= иск.длина:
        верни да
    б нат.старт = иск.данные[поз]
    верни б == 10 или б == 13 или б == 32 или б == 9 или б == 59

функ _непустая_стр(иск стр, i нат.верх) нат.верх:
    # начало следующей непустой строки после строки с i; иск.длина — нет её
    поз нат.верх = _кон_стр(иск, i)
    пока поз < иск.длина:
        поз += 1                            # перешли '\n'
        поз = _непробел(иск, поз)
        если поз >= иск.длина:
            верни поз
        б нат.старт = иск.данные[поз]
        если б != 10 и б != 13:
            верни поз
    верни поз

функ _пролог_ли(иск стр, i нат.верх) лог:
    # после метки на строке i идёт пролог «ВСТЕК УКК / ПЕР УКК, УКС»
    а нат.верх = _непустая_стр(иск, i)
    если а >= иск.длина или не _строка_это(иск, а, "ВСТЕК УКК"):
        верни нет
    б нат.верх = _непустая_стр(иск, а)
    верни б < иск.длина и _строка_это(иск, б, "ПЕР УКК, УКС")

функ карта_строй(о *Отлад, путь_иск стр, путь_ехе стр) нат.верх:
    # возвращает число найденных символов
    иск стр = файл_прочти(путь_иск)
    ехе стр = файл_прочти(путь_ехе)
    если иск == пусто или ехе == пусто:
        верни 0
    т *Список = пе_текст(ехе)
    если т == пусто:
        верни 0
    raw нат.верх = список_получи(т, 0)
    rawsz нат.верх = список_получи(т, 1)
    ва нат.верх = список_получи(т, 2)
    д *нат.старт = ехе.данные
    # имена меток, за которыми идёт пролог функции, в порядке следования
    имена *Список = список_новый()
    поз нат.верх = 0
    пока поз < иск.длина:
        б нат.старт = иск.данные[поз]
        если б != 32 и б != 9 и б != 10 и б != 13:
            дл нат.верх = _метка_ли(иск, поз)
            если дл > 0 и _пролог_ли(иск, поз):
                имя стр = стр_срез(иск, поз, поз + дл)
                список_добавь(имена, имя как нат.верх)
            пока поз < иск.длина и иск.данные[поз] != 10:
                поз += 1
        поз += 1
    # прологи 55 48 8B EC (ВСТЕК УКК; ПЕР УКК, УКС) в .text;
    # валидный пролог стоит в начале секции либо сразу за концом функции
    hits *Список = список_новый()
    смещ нат.верх = 0
    пока смещ + 4 <= rawsz:
        если (д[raw + смещ] == 0x55 и д[raw + смещ + 1] == 0x48 и
              д[raw + смещ + 2] == 0x8B и д[raw + смещ + 3] == 0xEC):
            введи ок = (смещ == 0)
            если смещ > 0:
                пб нат.старт = д[raw + смещ - 1]
                если (пб == 0xC3 или пб == 0xC9 или пб == 0xCC или
                      пб == 0x90):
                    ок = 1
            если ок != 0:
                список_добавь(hits, о.база + ва + смещ)
        смещ += 1
    n нат.верх = имена.длина
    если hits.длина != имена.длина:
        о.карта_полна = 0
    если hits.длина < n:
        n = hits.длина
    для инд в 0..n:
        сим_добавь(о, список_получи(имена, инд) как стр,
                   список_получи(hits, инд))
    если о.вход != 0:
        сим_добавь(о, "старт", о.вход)
    верни n
