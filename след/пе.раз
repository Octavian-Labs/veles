# пе — разбор PE64: точка входа, секции, эвристическая карта символов.
# Карта строится сопоставлением меток .иск, за которыми следует пролог
# «ВСТЕК УКК / ПЕР УКК, УКС», с байтами 55 48 8B EC в секции .text.
# Эвристика годится для кода, сгенерированного РАЗУМОМ.

взять основа
взять ипп, ядро

открыто функ _р16(д *нат.старт, смещ размер) нат.верх:
    верни (д[смещ] как нат.верх) | ((д[смещ + 1] как нат.верх) << 8)

открыто функ _р32(д *нат.старт, смещ размер) нат.верх:
    верни _р16(д, смещ) | (_р16(д, смещ + 2) << 16)

открыто функ пе_вход_рва(дан стр) размер:
    # RVA точки входа; 0 — не PE32+
    если дан == пусто или дан.длина < 0x40:
        верни 0
    д *нат.старт = дан.данные
    пе размер = _р32(д, 0x3C)
    если пе + 0x58 > дан.длина:
        верни 0
    если _р32(д, пе) != 0x00004550:     # 'PE\0\0'
        верни 0
    если _р16(д, пе + 24) != 0x20B:     # только PE32+
        верни 0
    верни _р32(д, пе + 24 + 0x10)       # AddressOfEntryPoint

открыто функ _пе_секция(дан стр, имя *нат.старт, имя_дл размер) *Список:
    # [raw_смещ, raw_разм, va] секции по имени; пусто — не нашли
    д *нат.старт = дан.данные
    пе размер = _р32(д, 0x3C)
    секций размер = _р16(д, пе + 6)
    разм_опт размер = _р16(д, пе + 20)
    сек размер = пе + 24 + разм_опт
    для инд в 0..секций:
        смещ_сек размер = сек + инд * 40
        если смещ_сек + 40 > дан.длина:
            верни пусто как *Список
        совп размер = 1
        для инд2 в 0..имя_дл:
            если д[смещ_сек + инд2] != имя[инд2]:
                совп = 0
        если совп != 0:
            рез *Список = список_новый()
            список_добавь(рез, _р32(д, смещ_сек + 20))   # PointerToRawData
            список_добавь(рез, _р32(д, смещ_сек + 16))   # SizeOfRawData
            список_добавь(рез, _р32(д, смещ_сек + 12))   # VirtualAddress
            верни рез
    верни пусто как *Список

открыто функ пе_текст(дан стр) *Список:
    # [raw_смещ, raw_разм, va] секции ".text"
    имя *нат.старт = выдели(8)
    имя[0] = 0x2E    # '.'
    имя[1] = 't'
    имя[2] = 'e'
    имя[3] = 'x'
    имя[4] = 't'
    имя[5] = 0
    верни _пе_секция(дан, имя, 6)

# --- символы -------------------------------------------------------------------

открыто функ сим_добавь(отл *Отлад, имя стр, адр размер):
    сим *Сим = новый(Сим)
    сим.имя = имя
    сим.адр = адр
    список_добавь(отл.симы, сим как размер)

открыто функ сим_адр(отл *Отлад, имя стр) размер:
    # адрес по имени; 0 — не найден
    для инд в 0..отл.симы.длина:
        сим *Сим = список_получи(отл.симы, инд) как *Сим
        если стр_равны(сим.имя, имя):
            верни сим.адр
    верни 0

открыто функ сим_имя(отл *Отлад, адр размер) стр:
    # ближайший символ снизу в пределах 0x1000; "имя+0xсмещ" или пусто
    лучшая размер = 0
    лучшее_имя стр = пусто как стр
    для инд в 0..отл.симы.длина:
        сим *Сим = список_получи(отл.симы, инд) как *Сим
        если сим.адр <= адр и сим.адр > лучшая:
            лучшая = сим.адр
            лучшее_имя = сим.имя
    если лучшая == 0 или адр - лучшая > 0x1000:
        верни пусто как стр
    если адр == лучшая:
        верни лучшее_имя
    верни стр_склей(стр_склей(лучшее_имя, "+0x"), шест(адр - лучшая))

открыто функ _метка_ли(иск стр, инд размер) размер:
    # длина метки на строке i (имя заканчивается ':'); 0 — не метка
    поз размер = инд
    пока поз < иск.длина:
        байт нат.старт = иск.данные[поз]
        если байт == 58:                       # ':'
            верни поз - инд
        если байт == 10 или байт == 32 или байт == 9 или байт == 59:
            верни 0                         # конец строки/пробел/';' — не метка
        поз += 1
    верни 0

открыто функ _кон_стр(иск стр, инд размер) размер:
    # индекс байта '\n' либо конец данных, начиная с i
    поз размер = инд
    пока поз < иск.длина и иск.данные[поз] != 10:
        поз += 1
    верни поз

открыто функ _непробел(иск стр, инд размер) размер:
    # первый байт не ' '/'\t' начиная с i ('\n' и конец данных тоже стоп)
    поз размер = инд
    пока поз < иск.длина и (иск.данные[поз] == 32 или иск.данные[поз] == 9):
        поз += 1
    верни поз

открыто функ _нач_с(иск стр, инд размер, об стр) лог:
    # в позиции i начинается образец об
    если инд + об.длина > иск.длина:
        верни нет
    верни равна_память(иск.данные + инд, об.данные, об.длина)

открыто функ _строка_это(иск стр, инд размер, об стр) лог:
    # строка с i = «отступ + об» (дальше конец строки, пробел или ';')
    поз размер = _непробел(иск, инд)
    если не _нач_с(иск, поз, об):
        верни нет
    поз += об.длина
    если поз >= иск.длина:
        верни да
    байт нат.старт = иск.данные[поз]
    верни байт == 10 или байт == 13 или байт == 32 или байт == 9 или байт == 59

открыто функ _непустая_стр(иск стр, инд размер) размер:
    # начало следующей непустой строки после строки с i; иск.длина — нет её
    поз размер = _кон_стр(иск, инд)
    пока поз < иск.длина:
        поз += 1                            # перешли '\n'
        поз = _непробел(иск, поз)
        если поз >= иск.длина:
            верни поз
        байт нат.старт = иск.данные[поз]
        если байт != 10 и байт != 13:
            верни поз
    верни поз

открыто функ _пролог_ли(иск стр, инд размер) лог:
    # после метки на строке i идёт пролог «ВСТЕК УКК / ПЕР УКК, УКС»
    поз_встек размер = _непустая_стр(иск, инд)
    если поз_встек >= иск.длина или не _строка_это(иск, поз_встек, "ВСТЕК УКК"):
        верни нет
    поз_пер размер = _непустая_стр(иск, поз_встек)
    верни поз_пер < иск.длина и _строка_это(иск, поз_пер, "ПЕР УКК, УКС")

открыто функ карта_строй(отл *Отлад, путь_иск стр, путь_ехе стр) размер:
    # возвращает число найденных символов
    иск стр = файл_прочти(путь_иск)
    ехе стр = файл_прочти(путь_ехе)
    если иск == пусто или ехе == пусто:
        верни 0
    тройка *Список = пе_текст(ехе)
    если тройка == пусто:
        верни 0
    сыр_смещ размер = список_получи(тройка, 0)
    сыр_разм размер = список_получи(тройка, 1)
    ва размер = список_получи(тройка, 2)
    д *нат.старт = ехе.данные
    # имена меток, за которыми идёт пролог функции, в порядке следования
    имена *Список = список_новый()
    поз размер = 0
    пока поз < иск.длина:
        байт нат.старт = иск.данные[поз]
        если байт != 32 и байт != 9 и байт != 10 и байт != 13:
            дл размер = _метка_ли(иск, поз)
            если дл > 0 и _пролог_ли(иск, поз):
                имя стр = стр_срез(иск, поз, поз + дл)
                список_добавь(имена, имя как размер)
            пока поз < иск.длина и иск.данные[поз] != 10:
                поз += 1
        поз += 1
    # прологи 55 48 8B EC (ВСТЕК УКК; ПЕР УКК, УКС) в .text;
    # валидный пролог стоит в начале секции либо сразу за концом функции
    найдено *Список = список_новый()
    смещ размер = 0
    пока смещ + 4 <= сыр_разм:
        если (д[сыр_смещ + смещ] == 0x55 и д[сыр_смещ + смещ + 1] == 0x48 и
              д[сыр_смещ + смещ + 2] == 0x8B и д[сыр_смещ + смещ + 3] == 0xEC):
            введи ок = (смещ == 0)
            если смещ > 0:
                пред_байт нат.старт = д[сыр_смещ + смещ - 1]
                если (пред_байт == 0xC3 или пред_байт == 0xC9 или пред_байт == 0xCC или
                      пред_байт == 0x90):
                    ок = да
            если ок != 0:
                список_добавь(найдено, отл.база + ва + смещ)
        смещ += 1
    колво размер = имена.длина
    если найдено.длина != имена.длина:
        отл.карта_полна = 0
    если найдено.длина < колво:
        колво = найдено.длина
    для инд в 0..колво:
        сим_добавь(отл, список_получи(имена, инд) как стр,
                   список_получи(найдено, инд))
    если отл.вход != 0:
        сим_добавь(отл, "старт", отл.вход)
    верни колво
