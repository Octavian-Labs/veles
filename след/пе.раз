# пе — разбор PE64: точка входа, секции, эвристическая карта символов.
# Карта строится сопоставлением меток .иск, за которыми следует пролог
# «ВСТЕК УКК / ПЕР УКК, УКС», с байтами 55 48 8B EC в секции .text.
# Эвристика годится для кода, сгенерированного РАЗУМОМ.

взять основа
взять апи, ядро

функ _р16(д *без8, о без64) без64:
    верни (д[о] как без64) | ((д[о + 1] как без64) << 8)

функ _р32(д *без8, о без64) без64:
    верни _р16(д, о) | (_р16(д, о + 2) << 16)

функ пе_вход_рва(дан стр) без64:
    # RVA точки входа; 0 — не PE32+
    если дан == пусто или дан.длина < 0x40:
        верни 0
    д *без8 = дан.данные
    пе := _р32(д, 0x3C)
    если пе + 0x58 > дан.длина:
        верни 0
    если _р32(д, пе) != 0x00004550:     # 'PE\0\0'
        верни 0
    если _р16(д, пе + 24) != 0x20B:     # только PE32+
        верни 0
    верни _р32(д, пе + 24 + 0x10)       # AddressOfEntryPoint

функ _пе_секция(дан стр, имя *без8, имя_дл без64) *Список:
    # [raw_смещ, raw_разм, va] секции по имени; пусто — не нашли
    д *без8 = дан.данные
    пе := _р32(д, 0x3C)
    nсек := _р16(д, пе + 6)
    опт := _р16(д, пе + 20)
    сек := пе + 24 + опт
    для i в 0..nсек:
        с := сек + i * 40
        если с + 40 > дан.длина:
            верни пусто как *Список
        совп := 1
        для j в 0..имя_дл:
            если д[с + j] != имя[j]:
                совп = 0
        если совп != 0:
            р *Список = список_новый()
            список_добавь(р, _р32(д, с + 20))   # PointerToRawData
            список_добавь(р, _р32(д, с + 16))   # SizeOfRawData
            список_добавь(р, _р32(д, с + 12))   # VirtualAddress
            верни р
    верни пусто как *Список

функ пе_текст(дан стр) *Список:
    # [raw_смещ, raw_разм, va] секции ".text"
    имя *без8 = выдели(8)
    имя[0] = 0x2E    # '.'
    имя[1] = 't'
    имя[2] = 'e'
    имя[3] = 'x'
    имя[4] = 't'
    имя[5] = 0
    верни _пе_секция(дан, имя, 6)

# --- символы -------------------------------------------------------------------

функ сим_добавь(о *Отлад, имя стр, адр без64):
    с *Сим = новый(Сим)
    с.имя = имя
    с.адр = адр
    список_добавь(о.симы, с как без64)

функ сим_адр(о *Отлад, имя стр) без64:
    # адрес по имени; 0 — не найден
    для i в 0..о.симы.длина:
        с *Сим = список_получи(о.симы, i) как *Сим
        если стр_равны(с.имя, имя):
            верни с.адр
    верни 0

функ сим_имя(о *Отлад, адр без64) стр:
    # ближайший символ снизу в пределах 0x1000; "имя+0xсмещ" или пусто
    лучшая без64 = 0
    лимя стр = пусто как стр
    для i в 0..о.симы.длина:
        с *Сим = список_получи(о.симы, i) как *Сим
        если с.адр <= адр и с.адр > лучшая:
            лучшая = с.адр
            лимя = с.имя
    если лучшая == 0 или адр - лучшая > 0x1000:
        верни пусто как стр
    если адр == лучшая:
        верни лимя
    верни стр_склей(стр_склей(лимя, "+0x"), шест(адр - лучшая))

функ _метка_ли(иск стр, i без64) без64:
    # длина метки на строке i (имя заканчивается ':'); 0 — не метка
    j := i
    пока j < иск.длина:
        б := иск.данные[j]
        если б == 58:                       # ':'
            верни j - i
        если б == 10 или б == 32 или б == 9 или б == 59:
            верни 0                         # конец строки/пробел/';' — не метка
        j += 1
    верни 0

функ _кон_стр(иск стр, i без64) без64:
    # индекс байта '\n' либо конец данных, начиная с i
    j := i
    пока j < иск.длина и иск.данные[j] != 10:
        j += 1
    верни j

функ _непробел(иск стр, i без64) без64:
    # первый байт не ' '/'\t' начиная с i ('\n' и конец данных тоже стоп)
    j := i
    пока j < иск.длина и (иск.данные[j] == 32 или иск.данные[j] == 9):
        j += 1
    верни j

функ _нач_с(иск стр, i без64, об стр) бул:
    # в позиции i начинается образец об
    если i + об.длина > иск.длина:
        верни нет
    верни равна_память(иск.данные + i, об.данные, об.длина)

функ _строка_это(иск стр, i без64, об стр) бул:
    # строка с i = «отступ + об» (дальше конец строки, пробел или ';')
    j := _непробел(иск, i)
    если не _нач_с(иск, j, об):
        верни нет
    j += об.длина
    если j >= иск.длина:
        верни да
    б := иск.данные[j]
    верни б == 10 или б == 13 или б == 32 или б == 9 или б == 59

функ _непустая_стр(иск стр, i без64) без64:
    # начало следующей непустой строки после строки с i; иск.длина — нет её
    j := _кон_стр(иск, i)
    пока j < иск.длина:
        j += 1                              # перешли '\n'
        j = _непробел(иск, j)
        если j >= иск.длина:
            верни j
        б := иск.данные[j]
        если б != 10 и б != 13:
            верни j
    верни j

функ _пролог_ли(иск стр, i без64) бул:
    # после метки на строке i идёт пролог «ВСТЕК УКК / ПЕР УКК, УКС»
    а := _непустая_стр(иск, i)
    если а >= иск.длина или не _строка_это(иск, а, "ВСТЕК УКК"):
        верни нет
    б := _непустая_стр(иск, а)
    верни б < иск.длина и _строка_это(иск, б, "ПЕР УКК, УКС")

функ карта_строй(о *Отлад, путь_иск стр, путь_ехе стр) без64:
    # возвращает число найденных символов
    иск := файл_прочти(путь_иск)
    ехе := файл_прочти(путь_ехе)
    если иск == пусто или ехе == пусто:
        верни 0
    т := пе_текст(ехе)
    если т == пусто:
        верни 0
    raw := список_получи(т, 0)
    rawsz := список_получи(т, 1)
    ва := список_получи(т, 2)
    д *без8 = ехе.данные
    # имена меток, за которыми идёт пролог функции, в порядке следования
    имена *Список = список_новый()
    i без64 = 0
    пока i < иск.длина:
        б := иск.данные[i]
        если б != 32 и б != 9 и б != 10 и б != 13:
            дл := _метка_ли(иск, i)
            если дл > 0 и _пролог_ли(иск, i):
                имя := стр_срез(иск, i, i + дл)
                список_добавь(имена, имя как без64)
            пока i < иск.длина и иск.данные[i] != 10:
                i += 1
        i += 1
    # прологи 55 48 8B EC (ВСТЕК УКК; ПЕР УКК, УКС) в .text;
    # валидный пролог стоит в начале секции либо сразу за концом функции
    hits *Список = список_новый()
    k без64 = 0
    пока k + 4 <= rawsz:
        если (д[raw + k] == 0x55 и д[raw + k + 1] == 0x48 и
              д[raw + k + 2] == 0x8B и д[raw + k + 3] == 0xEC):
            ок := (k == 0)
            если k > 0:
                пб := д[raw + k - 1]
                если (пб == 0xC3 или пб == 0xC9 или пб == 0xCC или
                      пб == 0x90):
                    ок = 1
            если ок != 0:
                список_добавь(hits, о.база + ва + k)
        k += 1
    n := имена.длина
    если hits.длина != имена.длина:
        о.карта_полна = 0
    если hits.длина < n:
        n = hits.длина
    для m в 0..n:
        сим_добавь(о, список_получи(имена, m) как стр,
                   список_получи(hits, m))
    если о.вход != 0:
        сим_добавь(о, "старт", о.вход)
    верни n
