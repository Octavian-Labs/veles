# ипп — обёртки Win32 Debug API (интерфейс прикладного программирования) и раскладка структур CONTEXT/DEBUG_EVENT (x64).
# Часть отладчика СЛЕД экосистемы ВЕЛЕС. Только Windows.

# --- флаги создания и продолжения -----------------------------------------
открыто конст ОТЛ_ФЛАГ = 2              # DEBUG_ONLY_THIS_PROCESS
открыто конст ЖДИ_ВЕЧНО = 0xFFFFFFFF    # INFINITE
открыто конст ПРОД_ОК = 0x00010002      # DBG_CONTINUE
открыто конст ПРОД_НЕОБР = 0x80010001   # DBG_EXCEPTION_NOT_HANDLED

# --- коды отладочных событий ----------------------------------------------
открыто конст СОБ_ИСКЛ = 1              # EXCEPTION_DEBUG_EVENT
открыто конст СОБ_ПОТОК = 2             # CREATE_THREAD_DEBUG_EVENT
открыто конст СОБ_ПРОЦ = 3              # CREATE_PROCESS_DEBUG_EVENT
открыто конст СОБ_ПОТОК_ВЫХ = 4         # EXIT_THREAD_DEBUG_EVENT
открыто конст СОБ_ПРОЦ_ВЫХ = 5          # EXIT_PROCESS_DEBUG_EVENT
открыто конст СОБ_ДЛЛ = 6               # LOAD_DLL_DEBUG_EVENT
открыто конст СОБ_ДЛЛ_ВЫХ = 7           # UNLOAD_DLL_DEBUG_EVENT
открыто конст СОБ_СТРОКА = 8            # OUTPUT_DEBUG_STRING_EVENT
открыто конст СОБ_РИП = 9               # RIP_EVENT

# --- коды исключений --------------------------------------------------------
открыто конст ИСКЛ_ТОЧКА = 0x80000003   # EXCEPTION_BREAKPOINT (int3)
открыто конст ИСКЛ_ШАГ = 0x80000004     # EXCEPTION_SINGLE_STEP (TF / DR)
открыто конст ИСКЛ_ДОСТУП = 0xC0000005  # EXCEPTION_ACCESS_VIOLATION

# --- прочее -----------------------------------------------------------------
открыто конст КОН_ФЛАГИ = 0x0010001B    # CONTEXT_FULL | CONTEXT_DEBUG_REGISTERS
открыто конст ФЛАГ_ШАГ = 0x100          # TF в EFlags
открыто конст БАЙТ_ТОЧКИ = 0xCC         # int3
открыто конст СТАРТИНФО_РАЗМЕР = 104    # sizeof(STARTUPINFOW) на x64
открыто конст СОБ_РАЗМЕР = 192          # DEBUG_EVENT (176) + запас
открыто конст КОН_РАЗМЕР = 1280         # CONTEXT (1232) + запас под выравнивание

# Индексы нат.верх-ячеек в CONTEXT (байтовое смещение / 8):
открыто конст К_ДР0 = 9                 # Dr0 @0x48 — адрес аппаратной точки
открыто конст К_ДР6 = 13                # Dr6 @0x68 — статус отладки
открыто конст К_ДР7 = 14                # Dr7 @0x70 — управление DR
открыто конст К_АКК = 15                # Rax @0x78
открыто конст К_СЧТ = 16                # Rcx
открыто конст К_ДАН = 17                # Rdx
открыто конст К_БАЗ = 18                # Rbx
открыто конст К_УКС = 19                # Rsp
открыто конст К_УКК = 20                # Rbp
открыто конст К_ИСТ = 21                # Rsi
открыто конст К_ПРМ = 22                # Rdi
открыто конст К_Р8 = 23
открыто конст К_Р9 = 24
открыто конст К_Р10 = 25
открыто конст К_Р11 = 26
открыто конст К_Р12 = 27
открыто конст К_Р13 = 28
открыто конст К_Р14 = 29
открыто конст К_Р15 = 30
открыто конст К_СЧ = 31                 # Rip @0xF8
# Индексы нат.рост-ячеек:
открыто конст К_ФЛАГИ = 12              # ContextFlags @0x30
открыто конст К_ЕФЛАГИ = 17             # EFlags @0x44

