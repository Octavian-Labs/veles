функ _регимя(инд нат.верх) стр:
    если инд == К_АКК: верни "АКК"
    если инд == К_СЧТ: верни "СЧТ"
    если инд == К_ДАН: верни "ДАН"
    если инд == К_БАЗ: верни "БАЗ"
    если инд == К_УКС: верни "УКС"
    если инд == К_УКК: верни "УКК"
    если инд == К_ИСТ: верни "ИСТ"
    если инд == К_ПРМ: верни "ПРМ"
    если инд == К_Р8:  верни "Р8"
    если инд == К_Р9:  верни "Р9"
    если инд == К_Р10: верни "Р10"
    если инд == К_Р11: верни "Р11"
    если инд == К_Р12: верни "Р12"
    если инд == К_Р13: верни "Р13"
    если инд == К_Р14: верни "Р14"
    если инд == К_Р15: верни "Р15"
    если инд == К_СЧ:  верни "СЧ"
    верни "?"

функ дамп_реги(о *Отлад):
    если не кон_прочти(о):
        печатьстр("контекст не читается")
        верни
    для ном в 0..17:
        введи инд = К_АКК + ном
        печать(_регимя(инд))
        печать("=")
        печать(шест(кон_рег(о, инд)))
        если ном % 4 == 3:
            печатьстр("")
        иначе:
            печать("  ")
    печать("ФЛАГИ=")
    печать(шест(кон_ефлаги(о)))
    печатьстр("")

функ _байты_печать(о *Отлад, адр нат.верх, n нат.верх):
    буф *нат.старт = выдели(n)
    m нат.верх = от_читай(о, адр, буф, n)
    для инд в 0..m:
        печать(стр_срез(шест(буф[инд] как нат.верх), 14, 16))
        печать(" ")
    если m < n:
        печать("..")

функ покажи_место(о *Отлад):
    # строка «сч=... <символ> | байты» после останова
    кон_прочти(о)
    рип нат.верх = кон_рег(о, К_СЧ)
    печать("сч=")
    печать(шест(рип))
    им стр = сим_имя(о, рип)
    если им != пусто:
        печать("  <")
        печать(им)
        печать(">")
    печать("  | ")
    _байты_печать(о, рип, 8)
    печатьстр("")

функ покажи_останов(о *Отлад, р нат.верх):
    если р == 0:
        верни
    если р == ПР_ВЫХОД:
        печать("процесс завершён, код ")
        печатьцел(о.стоп_код как цел.верх)
        печатьстр("")
        верни
    если р == ПР_ТОЧКА:
        инд цел.верх = точка_найди(о, о.прич_адр)
        если инд < 0:
            печать("временная точка по 0x")
        иначе:
            печать("точка #")
            печатьцел(инд)
            печать(" по 0x")
        печать(шест8(о.прич_адр))
        печатьстр("")
    а если р == ПР_НАБЛЮД:
        печатьстр("аппаратная точка наблюдения — запись перехвачена")
    а если р == ПР_ШАГ:
        печатьстр("шаг:")
    а если р == ПР_ИСКЛ:
        печать("исключение 0x")
        печать(шест8(о.прич_код))
        печать(" по 0x")
        печать(шест8(о.прич_адр))
        печатьстр("")
    покажи_место(о)

функ дамп_пам(о *Отлад, адр нат.верх, n нат.верх):
    буф *нат.старт = выдели(n)
    m нат.верх = от_читай(о, адр, буф, n)
    если m == 0:
        печать("память по 0x")
        печать(шест8(адр))
        печатьстр(" не читается")
        верни
    байт нат.верх = 0
    пока байт < m:
        если байт % 16 == 0:
            печать("0x")
            печать(шест(адр + байт))
            печать(": ")
        печать(стр_срез(шест(буф[байт] как нат.верх), 14, 16))
        печать(" ")
        если байт % 16 == 15 или байт + 1 == m:
            # ascii-колонка для пройденных байт строки
            печать(" |")
            инд2 нат.верх = байт - (байт % 16)
            пока инд2 <= байт:
                если буф[инд2] >= 32 и буф[инд2] <= 126:
                    печать(стр_собери(буф + инд2, 1))
                иначе:
                    печать(".")
                инд2 += 1
            печатьстр("")
        байт += 1

функ дамп_стек(о *Отлад, n нат.верх):
    кон_прочти(о)
    укс нат.верх = кон_рег(о, К_УКС)
    буф *нат.старт = выдели(n * 8)
    m нат.верх = от_читай(о, укс, буф, n * 8)
    п *нат.верх = буф как *нат.верх
    для инд в 0..(m / 8):
        печать("[укс+0x")
        печать(шест8(инд * 8))
        печать("] 0x")
        печать(шест(п[инд]))
        им стр = сим_имя(о, п[инд])
        если им != пусто:
            печать("  <")
            печать(им)
            печать(">")
        печатьстр("")

