функ ввод_строку() стр:
    # одна строка stdin (по '\n'); пусто — EOF. Работает и с консолью,
    # и с каналом: читаем побайтно, '\r' пропускаем.
    х_ввод нат.верх = GetStdHandle(0xFFFFFFF6) # STD_INPUT_HANDLE
    буф *нат.старт = выдели(4096)
    дл размер = 0
    конец_ф размер = 0
    вечно:
        прочитано нат.рост = 0
        ок цел.рост = ReadFile(х_ввод, буф + дл, 1, &прочитано, пусто)
        если ок == 0 или прочитано == 0:
            конец_ф = 1
            хватит
        байт нат.старт = буф[дл]
        если байт == 10:
            хватит
        если байт != 13:
            дл += 1
        если дл >= 4095:
            хватит
    если дл == 0 и конец_ф != 0:
        верни пусто как стр
    верни стр_собери(буф, дл)

функ слова(строка стр) *Список:
    слова *Список = список_новый()
    поз размер = 0
    пока поз < строка.длина:
        пока поз < строка.длина и (строка.данные[поз] == 32 или строка.данные[поз] == 9):
            поз += 1
        если поз >= строка.длина:
            хватит
        инд2 размер = поз
        пока инд2 < строка.длина и строка.данные[инд2] != 32 и строка.данные[инд2] != 9:
            инд2 += 1
        список_добавь(слова, стр_срез(строка, поз, инд2) как нат.верх)
        поз = инд2
    верни слова

