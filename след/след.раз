функ команда(отл *Отлад, строка стр) лог:
    # нет — выход из цикла
    слова *Список = слова(строка)
    если слова.длина == 0:
        верни да
    код стр = список_получи(слова, 0) как стр
    арг1 стр = _арг1(слова)
    если стр_равны(код, "выход") или стр_равны(код, "к"):
        верни нет
