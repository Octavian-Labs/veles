функ пуск_и_вход(отл *Отлад, путь стр):
    если отл.жив != 0:
        от_стоп(отл)
    если не от_пуск(отл, путь):
        печать("след: не запустить «")
        печать(путь)
        печать("», ошибка ")
        печатьцел(GetLastError() как цел.верх)
        печатьстр("")
        верни
    отл.цель = путь
    # ждём событие создания, чтобы узнать базу образа
    вечно:
        код нат.верх = от_жди(отл)
        если код == 0:
            печатьстр("след: нет событий — процесс не стартовал")
            верни
        если код == СОБ_ПРОЦ:
            _на_создание(отл)
            хватит
        иначе:
            _прочее_событие(отл, код)
    пе_файл стр = файл_прочти(путь)
    рва размер = пе_вход_рва(пе_файл)
    отл.вход = отл.база + рва
    печать("процесс ")
    печатьцел(отл.ид_проц как цел.верх)
    печать(", база 0x")
    печать(шест8(отл.база))
    печать(", вход 0x")
    печать(шест8(отл.вход))
    печатьстр("")
    # автоматическая точка на входе — программа встаёт на первой инструкции
    если точка_пост(отл, отл.вход):
        рез нат.верх = от_событие(отл)
        покажи_останов(отл, рез)
    иначе:
        печатьстр("след: точку на входе поставить не удалось")

