    если стр_равны(код, "инфо"):
        печать("пид=")
        печатьцел(отл.ид_проц как цел.верх)
        печать(" база=0x")
        печать(шест8(отл.база))
        печать(" вход=0x")
        печать(шест8(отл.вход))
        печать(" точек=")
        точек размер = 0
        для инд в 0..отл.точки.длина:
            точка *Точка = список_получи(отл.точки, инд) как *Точка
            если точка.вкл != 0:
                точек += 1
        печатьцел(точек как цел.верх)
        печать(" символов=")
        печатьцел(отл.симы.длина как цел.верх)
        печать(" жив=")
        печатьцел(отл.жив как цел.верх)
        печатьстр("")
        верни да
    если стр_равны(код, "карта"):
        если арг1 == пусто или отл.цель == пусто:
            печатьстр("карта <файл.иск> — после «пуск» цели")
            верни да
        колво размер = карта_строй(отл, арг1, отл.цель)
        печать("символов: ")
        печатьцел(колво как цел.верх)
        если отл.карта_полна == 0:
            печать(" (прологов и меток разное число — карта частичная)")
        печатьстр("")
        верни да
    если стр_равны(код, "символы"):
        для инд в 0..отл.симы.длина:
            сим *Сим = список_получи(отл.симы, инд) как *Сим
            печать("0x")
            печать(шест(сим.адр))
            печать("  ")
            печатьстр(сим.имя)
        верни да
    если _нет_процесса(отл):
