функ пуск_и_вход(о *Отлад, путь стр):
    если о.жив != 0:
        от_стоп(о)
    если не от_пуск(о, путь):
        печать("след: не запустить «")
        печать(путь)
        печать("», ошибка ")
        печатьцел(GetLastError() как цел.верх)
        печатьстр("")
        верни
    о.цель = путь
    # ждём событие создания, чтобы узнать базу образа
    вечно:
        код нат.верх = от_жди(о)
        если код == 0:
            печатьстр("след: нет событий — процесс не стартовал")
            верни
        если код == СОБ_ПРОЦ:
            _на_создание(о)
            хватит
        иначе:
            _прочее_событие(о, код)
    пе_ф стр = файл_прочти(путь)
    рва нат.верх = пе_вход_рва(пе_ф)
    о.вход = о.база + рва
    печать("процесс ")
    печатьцел(о.пид как цел.верх)
    печать(", база 0x")
    печать(шест8(о.база))
    печать(", вход 0x")
    печать(шест8(о.вход))
    печатьстр("")
    # автоматическая точка на входе — программа встаёт на первой инструкции
    если точка_пост(о, о.вход):
        р нат.верх = от_событие(о)
        покажи_останов(о, р)
    иначе:
        печатьстр("след: точку на входе поставить не удалось")

