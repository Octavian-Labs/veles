функ _нет_процесса(о *Отлад) лог:
    если о.жив == 0:
        печатьстр("нет процесса — сначала «пуск <exe>»")
        верни да
    верни нет

функ _арг1(сл *Список) стр:
    если сл.длина < 2:
        верни пусто как стр
    верни список_получи(сл, 1) как стр

функ команда(о *Отлад, строка стр) лог:
    # нет — выход из цикла
    сл *Список = слова(строка)
    если сл.длина == 0:
        верни да
    к стр = список_получи(сл, 0) как стр
    а1 стр = _арг1(сл)
    если стр_равны(к, "выход") или стр_равны(к, "к"):
        верни нет
    если стр_равны(к, "пом") или стр_равны(к, "?"):
        помощь()
        верни да
    если стр_равны(к, "пуск"):
        если а1 == пусто:
            печатьстр("пуск <файл.exe>")
        иначе:
            пуск_и_вход(о, а1)
        верни да
    если стр_равны(к, "инфо"):
        печать("пид=")
        печатьцел(о.пид как цел.верх)
        печать(" база=0x")
        печать(шест8(о.база))
        печать(" вход=0x")
        печать(шест8(о.вход))
        печать(" точек=")
        нт нат.верх = 0
        для инд в 0..о.точки.длина:
            т *Точка = список_получи(о.точки, инд) как *Точка
            если т.вкл != 0:
                нт += 1
        печатьцел(нт как цел.верх)
        печать(" символов=")
        печатьцел(о.симы.длина как цел.верх)
        печать(" жив=")
        печатьцел(о.жив как цел.верх)
        печатьстр("")
        верни да
    если стр_равны(к, "карта"):
        если а1 == пусто или о.цель == пусто:
            печатьстр("карта <файл.иск> — после «пуск» цели")
            верни да
        n нат.верх = карта_строй(о, а1, о.цель)
        печать("символов: ")
        печатьцел(n как цел.верх)
        если о.карта_полна == 0:
            печать(" (прологов и меток разное число — карта частичная)")
        печатьстр("")
        верни да
    если стр_равны(к, "символы"):
        для инд в 0..о.симы.длина:
            с *Сим = список_получи(о.симы, инд) как *Сим
            печать("0x")
            печать(шест(с.адр))
            печать("  ")
            печатьстр(с.имя)
        верни да
    если _нет_процесса(о):
        верни да
    # дальше — только при живом процессе
    если стр_равны(к, "вход"):
        если точка_пост(о, о.вход):
            печать("точка на входе 0x")
            печатьстр(шест8(о.вход))
        иначе:
            печатьстр("не ставится")
        верни да
    если стр_равны(к, "б") или стр_равны(к, "точка"):
        если а1 == пусто:
            печатьстр("б <адрес|символ|регистр>")
        иначе:
            ок нат.верх = 0
            адр нат.верх = адр_разбери(о, а1, &ок)
            если ок == 0:
                печать("не понять «")
                печать(а1)
                печатьстр("» — ни адрес, ни символ, ни регистр")
            а если точка_пост(о, адр):
                печать("точка #")
                печатьцел(точка_найди(о, адр))
                печать(" по 0x")
                печатьстр(шест8(адр))
            иначе:
                печатьстр("не ставится — адрес не читается")
