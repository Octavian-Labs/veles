функ дамп_реги(отл *Отлад):
    если не кон_прочти(отл):
        печатьстр("контекст не читается")
        верни
    для ном в 0..17:
        введи инд = К_АКК + ном
        печать(_регимя(инд))
        печать("=")
        печать(шест(кон_рег(отл, инд)))
        если ном % 4 == 3:
            печатьстр("")
        иначе:
            печать("  ")
    печать("ФЛАГИ=")
    печать(шест(кон_ефлаги(отл)))
    печатьстр("")

функ _байты_печать(отл *Отлад, адр размер, колво размер):
    буф *нат.старт = выдели(колво)
    прочитано размер = от_читай(отл, адр, буф, колво)
    для инд в 0..прочитано:
        печать(стр_срез(шест(буф[инд] как нат.верх), 14, 16))
        печать(" ")
    если прочитано < колво:
        печать("..")

функ покажи_место(отл *Отлад):
    # строка «сч=... <символ> | байты» после останова
    кон_прочти(отл)
    рип нат.верх = кон_рег(отл, К_СЧ)
    печать("сч=")
    печать(шест(рип))
    имя стр = сим_имя(отл, рип)
    если имя != пусто:
        печать("  <")
        печать(имя)
        печать(">")
    печать("  | ")
    _байты_печать(отл, рип, 8)
    печатьстр("")

функ покажи_останов(отл *Отлад, рез нат.верх):
    если рез == 0:
        верни
    если рез == ПР_ВЫХОД:
        печать("процесс завершён, код ")
        печатьцел(отл.стоп_код как цел.верх)
        печатьстр("")
        верни
    если рез == ПР_ТОЧКА:
        инд смещение = точка_найди(отл, отл.прич_адр)
        если инд < 0:
            печать("временная точка по 0x")
        иначе:
            печать("точка #")
            печатьцел(инд)
            печать(" по 0x")
        печать(шест8(отл.прич_адр))
        печатьстр("")
    а если рез == ПР_НАБЛЮД:
        печатьстр("аппаратная точка наблюдения — запись перехвачена")
    а если рез == ПР_ШАГ:
        печатьстр("шаг:")
    а если рез == ПР_ИСКЛ:
        печать("исключение 0x")
        печать(шест8(отл.прич_код))
        печать(" по 0x")
        печать(шест8(отл.прич_адр))
        печатьстр("")
    покажи_место(отл)

функ дамп_пам(отл *Отлад, адр размер, колво размер):
    буф *нат.старт = выдели(колво)
    прочитано размер = от_читай(отл, адр, буф, колво)
    если прочитано == 0:
        печать("память по 0x")
        печать(шест8(адр))
        печатьстр(" не читается")
        верни
    байт нат.верх = 0
    пока байт < прочитано:
        если байт % 16 == 0:
            печать("0x")
            печать(шест(адр + байт))
            печать(": ")
        печать(стр_срез(шест(буф[байт] как нат.верх), 14, 16))
        печать(" ")
        если байт % 16 == 15 или байт + 1 == прочитано:
            # ascii-колонка для пройденных байт строки
            печать(" |")
            инд2 размер = байт - (байт % 16)
            пока инд2 <= байт:
                если буф[инд2] >= 32 и буф[инд2] <= 126:
                    печать(стр_собери(буф + инд2, 1))
                иначе:
                    печать(".")
                инд2 += 1
            печатьстр("")
        байт += 1

функ дамп_стек(отл *Отлад, колво размер):
    кон_прочти(отл)
    укс нат.верх = кон_рег(отл, К_УКС)
    буф *нат.старт = выдели(колво * 8)
    прочитано размер = от_читай(отл, укс, буф, колво * 8)
    ячейки *нат.верх = буф как *нат.верх
    для инд в 0..(прочитано / 8):
        печать("[укс+0x")
        печать(шест8(инд * 8))
        печать("] 0x")
        печать(шест(ячейки[инд]))
        имя стр = сим_имя(отл, ячейки[инд])
        если имя != пусто:
            печать("  <")
            печать(имя)
            печать(">")
        печатьстр("")

