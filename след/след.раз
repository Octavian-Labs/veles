# след — машинный отладчик экосистемы ВЕЛЕС (Windows x64).
# Отлаживает любой PE64, произведённый ИСКРОЙ: программы на РАЗУМЕ и на
# чистой ИСКРЕ — включая сам компилятор разум.exe и ассемблер искра.exe.
#
#   след.exe [цель.exe]        — команды читаются со stdin, вывод на stdout
#
# Команды (см. также «пом» внутри):
#   пуск ф.exe   вход            б/точка А   сними N|А   точки
#   иди          шаг [n]         до А        возврат     наблюд А  наблюд-
#   реги         уст Р V         пам А [n]   стек [n]    карта ф.иск
#   символы      инфо            стоп        отцепи      выход
#   А — адрес: 0xHEX | имя символа | регистр (укс, акк, сч ...)

взять основа
взять ипп, ядро, пе

# --- числа и адреса ------------------------------------------------------------

функ шест(ч нат.верх) стр:
    # 16 шестнадцатеричных цифр, нижний регистр
    буф *нат.старт = выдели(16)
    для инд в 0..16:
        д нат.верх = (ч >> ((15 - инд) * 4)) & 0xF
        если д < 10:
            буф[инд] = (48 + д) как нат.старт
        иначе:
            буф[инд] = (87 + д) как нат.старт
    верни стр_собери(буф, 16)

функ шест8(ч нат.верх) стр:
    # без ведущих нулей, минимум одна цифра
    с стр = шест(ч)
    поз нат.верх = 0
    пока поз + 1 < с.длина и с.данные[поз] == 48:
        поз += 1
    верни стр_срез(с, поз, с.длина)

функ шест_число(с стр) нат.верх:
    # разбор hex; префикс 0x опционален
    поз нат.верх = 0
    если (с.длина >= 2 и с.данные[0] == 48 и
          (с.данные[1] == 'x' или с.данные[1] == 'X')):
        поз = 2
    ч нат.верх = 0
    пока поз < с.длина:
        б нат.старт = с.данные[поз]
        д нат.верх = 0
        если б >= 48 и б <= 57:
            д = (б - 48) как нат.верх
        а если б >= 97 и б <= 102:
            д = (б - 87) как нат.верх
        а если б >= 65 и б <= 70:
            д = (б - 55) как нат.верх
        иначе:
            хватит
        ч = ч * 16 + д
        поз += 1
    верни ч

функ _шест_ли(с стр) лог:
    # строка целиком — шестнадцатеричное число (префикс 0x допустим)
    поз нат.верх = 0
    если (с.длина >= 2 и с.данные[0] == 48 и
          (с.данные[1] == 'x' или с.данные[1] == 'X')):
        поз = 2
    если поз >= с.длина:
        верни нет
    пока поз < с.длина:
        б нат.старт = с.данные[поз]
        если не ((б >= 48 и б <= 57) или (б >= 97 и б <= 102) или
                 (б >= 65 и б <= 70)):
            верни нет
        поз += 1
    верни да

функ число(с стр) нат.верх:
    # счётчики: 0x... — hex, иначе десятичное
    если (с.длина >= 2 и с.данные[0] == 48 и
          (с.данные[1] == 'x' или с.данные[1] == 'X')):
        верни шест_число(с)
    верни стр_число(с) как нат.верх

функ рег_инд(имя стр) цел.верх:
    # индекс регистра в CONTEXT по русскому имени; -1 — нет такого
    если стр_равны(имя, "акк"):  верни К_АКК как цел.верх
    если стр_равны(имя, "счт"):  верни К_СЧТ как цел.верх
    если стр_равны(имя, "дан"):  верни К_ДАН как цел.верх
    если стр_равны(имя, "баз"):  верни К_БАЗ как цел.верх
    если стр_равны(имя, "укс"):  верни К_УКС как цел.верх
    если стр_равны(имя, "укк"):  верни К_УКК как цел.верх
    если стр_равны(имя, "ист"):  верни К_ИСТ как цел.верх
    если стр_равны(имя, "прм"):  верни К_ПРМ как цел.верх
    если стр_равны(имя, "р8"):   верни К_Р8 как цел.верх
    если стр_равны(имя, "р9"):   верни К_Р9 как цел.верх
    если стр_равны(имя, "р10"):  верни К_Р10 как цел.верх
    если стр_равны(имя, "р11"):  верни К_Р11 как цел.верх
    если стр_равны(имя, "р12"):  верни К_Р12 как цел.верх
    если стр_равны(имя, "р13"):  верни К_Р13 как цел.верх
    если стр_равны(имя, "р14"):  верни К_Р14 как цел.верх
    если стр_равны(имя, "р15"):  верни К_Р15 как цел.верх
    если стр_равны(имя, "сч"):   верни К_СЧ как цел.верх
    верни -1

функ адр_разбери(о *Отлад, с стр, ок *нат.верх) нат.верх:
    # адрес: регистр | символ | база+0x.. | база-0x.. | 0xHEX | HEX
    # ок[0] = 0 — разобрать не удалось (не регистр, не символ, не число)
    ок[0] = 1
    разд цел.верх = -1
    для поз в 1..с.длина:
        б нат.старт = с.данные[поз]
        если б == 43 или б == 45:               # '+' или '-'
            разд = поз как цел.верх
            хватит
    баз стр = с
    добавка нат.верх = 0
    если разд >= 0:
        баз = стр_срез(с, 0, разд как нат.верх)
        суф стр = стр_срез(с, (разд + 1) как нат.верх, с.длина)
        если не _шест_ли(суф):
            ок[0] = 0
            верни 0
        добавка = шест_число(суф)
        если с.данные[разд как нат.верх] == 45:
            добавка = (0 как нат.верх) - добавка   # отрицание mod 2^64
    ri цел.верх = рег_инд(баз)
    если ri >= 0:
        кон_прочти(о)
        верни кон_рег(о, ri как нат.верх) + добавка
    sa нат.верх = сим_адр(о, баз)
    если sa != 0:
        верни sa + добавка
    если не _шест_ли(баз):
        ок[0] = 0
        верни 0
    верни шест_число(баз) + добавка

# --- ввод ----------------------------------------------------------------------

функ ввод_строку() стр:
    # одна строка stdin (по '\n'); пусто — EOF. Работает и с консолью,
    # и с каналом: читаем побайтно, '\r' пропускаем.
    х нат.верх = GetStdHandle(0xFFFFFFF6) # STD_INPUT_HANDLE
    буф *нат.старт = выдели(4096)
    n нат.верх = 0
    eof нат.верх = 0
    вечно:
        проч нат.рост = 0
        ок цел.рост = ReadFile(х, буф + n, 1, &проч, пусто)
        если ок == 0 или проч == 0:
            eof = 1
            хватит
        б нат.старт = буф[n]
        если б == 10:
            хватит
        если б != 13:
            n += 1
        если n >= 4095:
            хватит
    если n == 0 и eof != 0:
        верни пусто как стр
    верни стр_собери(буф, n)

функ слова(с стр) *Список:
    сл *Список = список_новый()
    поз нат.верх = 0
    пока поз < с.длина:
        пока поз < с.длина и (с.данные[поз] == 32 или с.данные[поз] == 9):
            поз += 1
        если поз >= с.длина:
            хватит
        инд2 нат.верх = поз
        пока инд2 < с.длина и с.данные[инд2] != 32 и с.данные[инд2] != 9:
            инд2 += 1
        список_добавь(сл, стр_срез(с, поз, инд2) как нат.верх)
        поз = инд2
    верни сл

