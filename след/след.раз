# --- числа и адреса ------------------------------------------------------------

открыто функ шест(число нат.верх) стр:
    # 16 шестнадцатеричных цифр, нижний регистр
    буф *нат.старт = выдели(16)
    для инд в 0..16:
        д нат.верх = (число >> ((15 - инд) * 4)) & 0xF
        если д < 10:
            буф[инд] = (48 + д) как нат.старт
        иначе:
            буф[инд] = (87 + д) как нат.старт
    верни стр_собери(буф, 16)

функ шест8(число нат.верх) стр:
    # без ведущих нулей, минимум одна цифра
    строка стр = шест(число)
    поз размер = 0
    пока поз + 1 < строка.длина и строка.данные[поз] == 48:
        поз += 1
    верни стр_срез(строка, поз, строка.длина)

функ шест_число(строка стр) нат.верх:
    # разбор hex; префикс 0x опционален
    поз размер = 0
    если (строка.длина >= 2 и строка.данные[0] == 48 и
          (строка.данные[1] == 'x' или строка.данные[1] == 'X')):
        поз = 2
    число нат.верх = 0
    пока поз < строка.длина:
        байт нат.старт = строка.данные[поз]
        д нат.верх = 0
        если байт >= 48 и байт <= 57:
            д = (байт - 48) как нат.верх
        а если байт >= 97 и байт <= 102:
            д = (байт - 87) как нат.верх
        а если байт >= 65 и байт <= 70:
            д = (байт - 55) как нат.верх
        иначе:
            хватит
        число = число * 16 + д
        поз += 1
    верни число

функ _шест_ли(строка стр) лог:
    # строка целиком — шестнадцатеричное число (префикс 0x допустим)
    поз размер = 0
    если (строка.длина >= 2 и строка.данные[0] == 48 и
          (строка.данные[1] == 'x' или строка.данные[1] == 'X')):
        поз = 2
    если поз >= строка.длина:
        верни нет
    пока поз < строка.длина:
        байт нат.старт = строка.данные[поз]
        если не ((байт >= 48 и байт <= 57) или (байт >= 97 и байт <= 102) или
                 (байт >= 65 и байт <= 70)):
            верни нет
        поз += 1
    верни да

функ число(строка стр) нат.верх:
    # счётчики: 0x... — hex, иначе десятичное
    если (строка.длина >= 2 и строка.данные[0] == 48 и
          (строка.данные[1] == 'x' или строка.данные[1] == 'X')):
        верни шест_число(строка)
    верни стр_число(строка) как нат.верх

функ рег_инд(имя стр) смещение:
    # индекс регистра в CONTEXT по русскому имени; -1 — нет такого
    если стр_равны(имя, "акк"):  верни К_АКК как смещение
    если стр_равны(имя, "счт"):  верни К_СЧТ как смещение
    если стр_равны(имя, "дан"):  верни К_ДАН как смещение
    если стр_равны(имя, "баз"):  верни К_БАЗ как смещение
    если стр_равны(имя, "укс"):  верни К_УКС как смещение
    если стр_равны(имя, "укк"):  верни К_УКК как смещение
    если стр_равны(имя, "ист"):  верни К_ИСТ как смещение
    если стр_равны(имя, "прм"):  верни К_ПРМ как смещение
    если стр_равны(имя, "р8"):   верни К_Р8 как смещение
    если стр_равны(имя, "р9"):   верни К_Р9 как смещение
    если стр_равны(имя, "р10"):  верни К_Р10 как смещение
    если стр_равны(имя, "р11"):  верни К_Р11 как смещение
    если стр_равны(имя, "р12"):  верни К_Р12 как смещение
    если стр_равны(имя, "р13"):  верни К_Р13 как смещение
    если стр_равны(имя, "р14"):  верни К_Р14 как смещение
    если стр_равны(имя, "р15"):  верни К_Р15 как смещение
    если стр_равны(имя, "сч"):   верни К_СЧ как смещение
    верни -1

функ адр_разбери(отл *Отлад, строка стр, ок *нат.верх) размер:
    # адрес: регистр | символ | база+0x.. | база-0x.. | 0xHEX | HEX
    # ок[0] = 0 — разобрать не удалось (не регистр, не символ, не число)
    ок[0] = 1
    разд смещение = -1
    для поз в 1..строка.длина:
        байт нат.старт = строка.данные[поз]
        если байт == 43 или байт == 45:               # '+' или '-'
            разд = поз как смещение
            хватит
    баз стр = строка
    добавка нат.верх = 0
    если разд >= 0:
        баз = стр_срез(строка, 0, разд как размер)
        суффикс стр = стр_срез(строка, (разд + 1) как размер, строка.длина)
        если не _шест_ли(суффикс):
            ок[0] = 0
            верни 0
        добавка = шест_число(суффикс)
        если строка.данные[разд как размер] == 45:
            добавка = (0 как нат.верх) - добавка   # отрицание mod 2^64
    инд_рег смещение = рег_инд(баз)
    если инд_рег >= 0:
        кон_прочти(отл)
        верни кон_рег(отл, инд_рег как размер) + добавка
    адр_сим размер = сим_адр(отл, баз)
    если адр_сим != 0:
        верни адр_сим + добавка
    если не _шест_ли(баз):
        ок[0] = 0
        верни 0
    верни шест_число(баз) + добавка

